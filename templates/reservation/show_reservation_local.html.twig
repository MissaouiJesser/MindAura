{# templates/reservation/show_reservation_local.html.twig #}
{% extends 'base_backoffice.html.twig' %}

{% block title %}Réservation #{{ reservation.idReservation }}{% endblock %}
{% block page_label %}Détail Réservation{% endblock %}

{% block content %}

<div class="page-header">
  <div style="display:flex;align-items:center;gap:14px">
    <a href="{{ path('reservation_local_index') }}" style="width:36px;height:36px;border-radius:10px;background:#fff;border:1.5px solid var(--border);display:grid;place-items:center;text-decoration:none;transition:all .2s;flex-shrink:0"
       onmouseover="this.style.borderColor='var(--green-light)'" onmouseout="this.style.borderColor='var(--border)'">
      <svg style="width:16px;height:16px;color:var(--text-sec)" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M13 5l-6 5 6 5" stroke-linecap="round"/></svg>
    </a>
    <div>
      <div class="page-title">{{ reservation.prenomCl }} {{ reservation.nomCl }}</div>
      <div class="page-sub">Réservation #{{ reservation.idReservation }}{% if reservation.local %} — {{ reservation.local.nomLocal }}{% endif %}</div>
    </div>
  </div>
  <div class="page-actions">
    <a href="{{ path('reservation_local_edit', {id: reservation.idReservation}) }}" class="btn-primary">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14.7 4.3a1 1 0 011.4 1.4L6.4 15.4 3 16.7l1.3-3.4 10-10z" stroke-linecap="round"/></svg>
      Modifier
    </a>
  </div>
</div>

<div style="display:grid;grid-template-columns:1fr 320px;gap:20px;align-items:start">

  <div style="display:flex;flex-direction:column;gap:16px">

    {# ── Informations principales ── #}
    <div style="background:#fff;border-radius:16px;padding:24px;box-shadow:var(--shadow-card);animation:fadeUp .4s cubic-bezier(.22,1,.36,1) .07s both">
      <div style="font-size:.78rem;font-weight:700;color:var(--text-sec);text-transform:uppercase;letter-spacing:.9px;margin-bottom:18px">Informations</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">

        {# Client #}
        <div style="padding:14px 16px;border-radius:12px;background:#EDE9FE">
          <div style="font-size:.73rem;font-weight:600;color:#7C3AED;opacity:.75;margin-bottom:4px;text-transform:uppercase;letter-spacing:.6px">Nom client</div>
          <div style="font-size:.92rem;font-weight:700;color:#7C3AED">{{ reservation.prenomCl }} {{ reservation.nomCl }}</div>
        </div>

        {# Local #}
        <div style="padding:14px 16px;border-radius:12px;background:var(--green-pale)">
          <div style="font-size:.73rem;font-weight:600;color:var(--green);opacity:.75;margin-bottom:4px;text-transform:uppercase;letter-spacing:.6px">Local</div>
          {% if reservation.local %}
            <a href="{{ path('locaux_psychiatrie_show', {id: reservation.local.idLocal}) }}" style="font-size:.88rem;font-weight:700;color:var(--green);text-decoration:none;display:flex;align-items:center;gap:5px">
              <svg style="width:13px;height:13px" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 18V8l7-5 7 5v10H3z" stroke-linecap="round"/></svg>
              {{ reservation.local.nomLocal }}
            </a>
          {% else %}
            <div style="font-size:.88rem;font-weight:700;color:var(--green)">—</div>
          {% endif %}
        </div>

        {# Salle #}
        <div style="padding:14px 16px;border-radius:12px;background:#F0F4F8">
          <div style="font-size:.73rem;font-weight:600;color:#374151;opacity:.75;margin-bottom:4px;text-transform:uppercase;letter-spacing:.6px">Salle</div>
          <div style="font-size:.92rem;font-weight:700;color:#374151">
            {{ reservation.salle ? reservation.salle.nomSalle : '—' }}
          </div>
        </div>

        {# Date #}
        <div style="padding:14px 16px;border-radius:12px;background:#E0F2F1">
          <div style="font-size:.73rem;font-weight:600;color:#00897B;opacity:.75;margin-bottom:4px;text-transform:uppercase;letter-spacing:.6px">Date</div>
          <div style="font-size:.92rem;font-weight:700;color:#00897B">
            {{ reservation.dateReservation ? reservation.dateReservation|date('d/m/Y') : '—' }}
          </div>
        </div>

        {# Prix #}
        <div style="padding:14px 16px;border-radius:12px;background:#FFF3E0">
          <div style="font-size:.73rem;font-weight:600;color:#E65100;opacity:.75;margin-bottom:4px;text-transform:uppercase;letter-spacing:.6px">Prix</div>
          <div style="font-size:.92rem;font-weight:700;color:#E65100">
            {{ reservation.prixReservation ? reservation.prixReservation ~ ' TND' : '—' }}
          </div>
        </div>

        {# Horaires — pleine largeur #}
        <div style="grid-column:1/-1;padding:14px 16px;border-radius:12px;background:var(--bg)">
          <div style="font-size:.73rem;font-weight:600;color:var(--text-sec);margin-bottom:8px;text-transform:uppercase;letter-spacing:.6px">Horaires</div>
          <div style="display:flex;align-items:center;gap:16px">
            <div>
              <div style="font-size:.72rem;color:var(--text-sec);margin-bottom:2px">Début</div>
              <div style="font-size:1rem;font-weight:700;color:var(--text)">
                {{ reservation.heureDebutReservation ? reservation.heureDebutReservation|date('H:i') : '—' }}
              </div>
            </div>
            <svg style="width:20px;height:20px;color:var(--text-sec)" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 10h12M12 6l4 4-4 4" stroke-linecap="round"/></svg>
            <div>
              <div style="font-size:.72rem;color:var(--text-sec);margin-bottom:2px">Fin</div>
              <div style="font-size:1rem;font-weight:700;color:var(--text)">
                {{ reservation.heureFinReservation ? reservation.heureFinReservation|date('H:i') : '—' }}
              </div>
            </div>
          </div>
        </div>

        {# Motif — pleine largeur #}
        {% if reservation.motifReservation %}
        <div style="grid-column:1/-1;padding:14px 16px;border-radius:12px;background:var(--bg)">
          <div style="font-size:.73rem;font-weight:600;color:var(--text-sec);margin-bottom:6px;text-transform:uppercase;letter-spacing:.6px">Motif</div>
          <p style="font-size:.87rem;line-height:1.6;color:var(--text);margin:0">{{ reservation.motifReservation }}</p>
        </div>
        {% endif %}

      </div>
    </div>

  </div>

  {# ── Panneau latéral ── #}
  <div style="display:flex;flex-direction:column;gap:16px">

    {# Statut #}
    <div style="background:#fff;border-radius:16px;padding:20px;box-shadow:var(--shadow-card);animation:fadeUp .4s cubic-bezier(.22,1,.36,1) .05s both">
      <div style="font-size:.78rem;font-weight:700;color:var(--text-sec);text-transform:uppercase;letter-spacing:.9px;margin-bottom:14px">Statut</div>
      {% if reservation.statusReservation == 'Confirmée' %}
        <div style="padding:14px;border-radius:12px;background:#D8F3DC;display:flex;align-items:center;gap:10px">
          <div style="width:10px;height:10px;border-radius:50%;background:#52B788;flex-shrink:0"></div>
          <div style="font-size:.9rem;font-weight:700;color:#1B4332">Confirmée</div>
        </div>
      {% elseif reservation.statusReservation == 'En attente' %}
        <div style="padding:14px;border-radius:12px;background:#FFF3E0;display:flex;align-items:center;gap:10px">
          <div style="width:10px;height:10px;border-radius:50%;background:#F59E0B;flex-shrink:0"></div>
          <div style="font-size:.9rem;font-weight:700;color:#D97706">En attente</div>
        </div>
      {% elseif reservation.statusReservation == 'Annulée' %}
        <div style="padding:14px;border-radius:12px;background:#FEF2F2;display:flex;align-items:center;gap:10px">
          <div style="width:10px;height:10px;border-radius:50%;background:#EF4444;flex-shrink:0"></div>
          <div style="font-size:.9rem;font-weight:700;color:#991B1B">Annulée</div>
        </div>
      {% else %}
        <div style="padding:14px;border-radius:12px;background:var(--bg);display:flex;align-items:center;gap:10px">
          <div style="width:10px;height:10px;border-radius:50%;background:#9CA3AF;flex-shrink:0"></div>
          <div style="font-size:.9rem;font-weight:700;color:var(--text-sec)">{{ reservation.statusReservation }}</div>
        </div>
      {% endif %}
    </div>

    {# Actions #}
    <div style="background:#fff;border-radius:16px;padding:20px;box-shadow:var(--shadow-card);display:flex;flex-direction:column;gap:10px;animation:fadeUp .4s cubic-bezier(.22,1,.36,1) .1s both">
      <div style="font-size:.78rem;font-weight:700;color:var(--text-sec);text-transform:uppercase;letter-spacing:.9px;margin-bottom:4px">Actions</div>

      {# Modifier #}
      <a href="{{ path('reservation_local_edit', {id: reservation.idReservation}) }}"
        style="display:flex;align-items:center;justify-content:center;gap:8px;padding:10px;border-radius:12px;background:var(--green);color:#fff;font-family:Outfit,sans-serif;font-size:.87rem;font-weight:600;text-decoration:none;transition:all .2s"
        onmouseover="this.style.background='var(--green-mid)'" onmouseout="this.style.background='var(--green)'">
        <svg style="width:15px;height:15px" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14.7 4.3a1 1 0 011.4 1.4L6.4 15.4 3 16.7l1.3-3.4 10-10z" stroke-linecap="round"/></svg>
        Modifier cette réservation
      </a>

      {# ── EXPORT PDF IA ─────────────────────────────────────────────── #}
      <a href="{{ path('reservation_local_pdf', {id: reservation.idReservation}) }}"
         id="btn-pdf"
         target="_blank"
         style="display:flex;align-items:center;justify-content:center;gap:8px;padding:10px;border-radius:12px;background:#EDE9FE;color:#7C3AED;font-family:Outfit,sans-serif;font-size:.87rem;font-weight:600;text-decoration:none;border:1.5px solid #C4B5FD;transition:all .2s"
         onmouseover="this.style.background='#7C3AED';this.style.color='#fff';this.style.borderColor='#7C3AED'"
         onmouseout="this.style.background='#EDE9FE';this.style.color='#7C3AED';this.style.borderColor='#C4B5FD'"
         onclick="handlePdfClick(this)">
        <svg style="width:15px;height:15px;flex-shrink:0" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M4 4h8l4 4v8a1 1 0 01-1 1H5a1 1 0 01-1-1V5a1 1 0 011-1z" stroke-linecap="round"/>
          <path d="M14 4v4h-4" stroke-linecap="round"/>
          <path d="M7 13h6M7 10h3" stroke-linecap="round"/>
        </svg>
        <span id="btn-pdf-label">Exporter PDF IA</span>
        <span style="background:#7C3AED;color:#fff;font-size:8px;font-weight:700;padding:2px 6px;border-radius:99px;text-transform:uppercase;letter-spacing:.5px;flex-shrink:0">IA</span>
      </a>

      {# Retour à la liste #}
      <a href="{{ path('reservation_local_index') }}"
        style="display:flex;align-items:center;justify-content:center;gap:8px;padding:10px;border-radius:12px;background:var(--bg);color:var(--text-sec);font-family:Outfit,sans-serif;font-size:.87rem;font-weight:600;text-decoration:none;border:1.5px solid var(--border);transition:all .2s"
        onmouseover="this.style.borderColor='var(--green-light)';this.style.color='var(--green)'"
        onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--text-sec)'">
        Retour à la liste
      </a>

      {# Supprimer #}
      <div style="border-top:1px solid var(--border);padding-top:10px;margin-top:2px">
        <form method="post" action="{{ path('reservation_local_delete', {id: reservation.idReservation}) }}" onsubmit="return confirm('Supprimer définitivement cette réservation ?')">
          <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reservation.idReservation) }}">
          <button type="submit" style="width:100%;padding:10px;border-radius:12px;background:#FEF2F2;color:#EF4444;font-family:Outfit,sans-serif;font-size:.87rem;font-weight:600;border:1.5px solid #FECACA;cursor:pointer;transition:all .2s"
            onmouseover="this.style.background='#EF4444';this.style.color='#fff'"
            onmouseout="this.style.background='#FEF2F2';this.style.color='#EF4444'">
            Supprimer cette réservation
          </button>
        </form>
      </div>
    </div>

  </div>
</div>

<script>
function handlePdfClick(btn) {
    const label = document.getElementById('btn-pdf-label');
    const original = label.textContent;

    label.textContent = 'Génération en cours...';
    btn.style.pointerEvents = 'none';
    btn.style.opacity = '0.7';

    setTimeout(() => {
        label.textContent = original;
        btn.style.pointerEvents = 'auto';
        btn.style.opacity = '1';
    }, 6000);
}
</script>

{% endblock %}
