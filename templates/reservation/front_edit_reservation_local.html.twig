        📋 Réservation #{{ reservation.idReservation }}
        {% if reservation.statusReservation == 'Confirmée' %}
          &nbsp;·&nbsp; ✅ Confirmée
        {% elseif reservation.statusReservation == 'En attente' %}
          &nbsp;·&nbsp; ⏳ En attente
        {% elseif reservation.statusReservation == 'Annulée' %}
          &nbsp;·&nbsp; ❌ Annulée
        {% else %}
          &nbsp;·&nbsp; {{ reservation.statusReservation }}
        {% endif %}
      </div>
    </div>
    <div class="hero-banner-right">
      <a href="{{ path('reservation_local_front_index') }}" class="hero-back-btn">
        <svg viewBox="0 0 16 16"><path d="M10 12L6 8l4-4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Retour à mes réservations
      </a>
    </div>
  </div>

