          {% for error in form.local.vars.errors %}<div class="alert">{{ error.message }}</div>{% endfor %}
        </div>

        <div class="field-block">
          <label class="field-label">{{ form_label(form.prenomCl) }}</label>
          {{ form_widget(form.prenomCl, {attr: {readonly:'readonly', style:'border-radius:14px;border:1.5px dashed var(--border);padding:13px 14px;font-family:Outfit,system-ui,sans-serif;background:#F5FAF6;color:var(--g1);font-weight:600;width:100%;'}}) }}
          <span class="form-note">Prénom chargé depuis votre profil.</span>
        </div>

        <div class="field-block">
          <label class="field-label">{{ form_label(form.nomCl) }}</label>
          {{ form_widget(form.nomCl, {attr: {readonly:'readonly', style:'border-radius:14px;border:1.5px dashed var(--border);padding:13px 14px;font-family:Outfit,system-ui,sans-serif;background:#F5FAF6;color:var(--g1);font-weight:600;width:100%;'}}) }}
          <span class="form-note">Nom chargé depuis votre profil.</span>
        </div>

        <div class="field-block field-full">
          <label class="field-label">{{ form_label(form.dateReservation) }}</label>
          {{ form_widget(form.dateReservation, {attr: {style:'border-radius:14px;border:1.5px solid var(--border);padding:13px 14px;font-family:Outfit,system-ui,sans-serif;background:var(--bg);width:100%;'}}) }}
          {% for error in form.dateReservation.vars.errors %}<div class="alert">{{ error.message }}</div>{% endfor %}
        </div>

        <div class="field-block">
