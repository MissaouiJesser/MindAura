          <span class="form-note">Calculé automatiquement selon la durée.</span>
        </div>

        <div class="field-block field-full">
          <label class="field-label">{{ form_label(form.motifReservation) }}</label>
          {{ form_widget(form.motifReservation, {attr: {style:'border-radius:14px;border:1.5px solid var(--border);padding:13px 14px;font-family:Outfit,system-ui,sans-serif;background:var(--bg);width:100%;min-height:90px;resize:vertical;'}}) }}
          {% for error in form.motifReservation.vars.errors %}<div class="alert">{{ error.message }}</div>{% endfor %}
        </div>

        <div class="field-block field-full">
          <label class="field-label">{{ form_label(form.statusReservation) }}</label>
          {{ form_widget(form.statusReservation, {attr: {style:'border-radius:14px;border:1.5px solid var(--border);padding:13px 14px;font-family:Outfit,system-ui,sans-serif;background:var(--bg);width:100%;cursor:pointer;'}}) }}
