<script>
  /* Navbar scroll shadow */
  const nav = document.getElementById('main-nav');
  window.addEventListener('scroll', () => nav.classList.toggle('scrolled', window.scrollY > 20));

  /* User pill dropdown */
  (function() {
    var pillBtn  = document.getElementById('userPillBtn');
    var dropdown = document.getElementById('userDropdown');
    var wrapper  = document.getElementById('userPillWrapper');
    if (!pillBtn || !dropdown) return;
    pillBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      var open = dropdown.classList.toggle('open');
      pillBtn.setAttribute('aria-expanded', open);
    });
    document.addEventListener('click', function(e) {
      if (!wrapper.contains(e.target)) {
        dropdown.classList.remove('open');
        pillBtn.setAttribute('aria-expanded', 'false');
      }
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        dropdown.classList.remove('open');
        pillBtn.setAttribute('aria-expanded', 'false');
      }
    });
  })();

  /* Prix automatique selon durée */
  (function () {
    const debut = document.querySelector('[id$="_heureDebutReservation"]');
    const fin   = document.querySelector('[id$="_heureFinReservation"]');
    const prix  = document.querySelector('[id$="_prixReservation"]');
    if (!debut || !fin || !prix) return;

    const PRIX_BASE    = 80;
    const PRIX_TRANCHE = 20;

    function updatePrice() {
      const a = debut.value;
      const b = fin.value;
      if (!a || !b) { prix.value = ''; return; }
      const [h1, m1] = a.split(':').map(Number);
      const [h2, m2] = b.split(':').map(Number);
      const mins = (h2 * 60 + m2) - (h1 * 60 + m1);
      if (mins <= 0) { prix.value = ''; return; }
      let total = PRIX_BASE;
      if (mins > 60) {
        total += Math.ceil((mins - 60) / 30) * PRIX_TRANCHE;
      }
      prix.value = total.toFixed(2);
    }

    debut.addEventListener('change', updatePrice);
    fin.addEventListener('change', updatePrice);
  })();

  /* Toast flash */
  function showToast(msg) {
    var t = document.getElementById('toast');
    document.getElementById('toast-msg').textContent = msg;
    t.classList.add('show');
    setTimeout(function () { t.classList.remove('show'); }, 4000);
  }
  {% for msg in app.flashes('success') %}
    showToast('{{ msg }}');
  {% endfor %}
</script>
</body>
</html>
