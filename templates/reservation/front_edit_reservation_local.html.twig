    <a href="{{ path('reservation_local_front_index') }}">Mes réservations</a>
    <span class="breadcrumb-sep">›</span>
    <span>Modifier la réservation #{{ reservation.idReservation }}</span>
  </nav>

  {# Hero Banner #}
  <div class="hero-banner">
    <div class="hero-banner-left">
      <h1>✏️ Modifier ma réservation</h1>
      <p>Mise à jour de votre réservation — <strong style="color:rgba(255,255,255,.95)">{{ reservation.prenomCl }} {{ reservation.nomCl }}</strong></p>
