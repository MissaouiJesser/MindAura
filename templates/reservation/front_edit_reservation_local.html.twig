{# templates/reservation/front_edit_reservation_local.html.twig
   ─ FRONT OFFICE : Modifier une réservation
   ─ Route : reservation_local_front_edit
#}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Modifier la réservation — MindAura</title>
  <link rel="icon" type="image/png" href="{{ asset('images/logo.png') }}"/>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;1,400&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --g1: #1B4332; --g2: #2D6A4F; --g3: #52B788;
      --g-pale: #D8F3DC; --g-hover: #E8F5EE;
      --violet: #7B5EA7; --vio-pale: #EDE9F6;
      --red: #DC2626; --red-pale: #FEF2F2;
      --amber: #D97706; --amber-pale: #FFFBEB;
      --bg: #F0F4F8; --white: #FFFFFF;
      --text: #1A1A2E; --text-sec: #5A6475; --border: #D5DCE6;
      --radius-xl: 24px; --radius-lg: 18px; --radius-md: 12px;
      --ease: cubic-bezier(.22,1,.36,1);
      --shadow: 0 18px 50px rgba(27,67,50,.08);
    }
    html { scroll-behavior: smooth; }
    body { min-height: 100vh; font-family: 'Outfit', sans-serif; background: linear-gradient(180deg, #F7FBF8 0%, #E9F2ED 100%); color: var(--text); overflow-x: hidden; line-height: 1.6; }

    /* ══ NAVBAR ══ */
    .nav { position: sticky; top: 0; z-index: 999; background: rgba(255,255,255,.93); backdrop-filter: blur(18px) saturate(150%); border-bottom: 1px solid rgba(27,67,50,.09); padding: 0 48px; display: flex; align-items: center; gap: 20px; height: 68px; transition: box-shadow .3s; }
    .nav.scrolled { box-shadow: 0 4px 24px rgba(27,67,50,.11); }
    .nav-brand { display: flex; align-items: center; gap: 11px; text-decoration: none; flex-shrink: 0; }
    .nav-brand-icon { width: 42px; height: 42px; border-radius: 12px; background: var(--g1); display: grid; place-items: center; box-shadow: 0 4px 14px rgba(27,67,50,.28); transition: transform .3s var(--ease); overflow: hidden; }
    .nav-brand:hover .nav-brand-icon { transform: rotate(-6deg) scale(1.05); }
    .nav-brand-name { font-family: 'Playfair Display', serif; font-size: 1.22rem; font-weight: 700; color: var(--text); line-height: 1.1; }
    .nav-brand-sub  { font-size: .59rem; color: var(--text-sec); letter-spacing: 1.2px; text-transform: uppercase; font-weight: 600; }
    .nav-links { flex: 1; display: flex; align-items: center; gap: 2px; justify-content: center; }
    .nav-link { padding: 7px 17px; border-radius: 99px; font-size: .87rem; font-weight: 500; color: var(--text-sec); text-decoration: none; transition: all .25s var(--ease); }
    .nav-link:hover  { background: var(--g-hover); color: var(--g1); }
    .nav-link.active { background: var(--g-pale); color: var(--g1); font-weight: 700; }
    .nav-right { display: flex; align-items: center; gap: 10px; }
    .nav-user-pill-wrapper { position: relative; }
    .nav-user-pill { display: flex; align-items: center; gap: 9px; padding: 5px 14px 5px 5px; border-radius: 99px; background: var(--bg); border: 1.5px solid rgba(27,67,50,.13); cursor: pointer; font-family: 'Outfit', sans-serif; transition: all .25s var(--ease); }
    .nav-user-pill:hover, .nav-user-pill[aria-expanded="true"] { background: var(--g-hover); border-color: var(--g3); box-shadow: 0 0 0 3px rgba(82,183,136,.12); }
    .nav-avatar { width: 32px; height: 32px; border-radius: 50%; background: var(--g-pale); border: 2px solid var(--g3); display: grid; place-items: center; font-size: .77rem; font-weight: 700; color: var(--g1); overflow: hidden; flex-shrink: 0; }
    .nav-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .nav-user-name  { font-size: .83rem; font-weight: 600; color: var(--text); }
    .nav-role-badge { font-size: .7rem; color: var(--text-sec); background: var(--g-pale); padding: 2px 8px; border-radius: 99px; font-weight: 600; }
    .pill-chevron { width: 14px; height: 14px; stroke: var(--text-sec); transition: transform .3s var(--ease); margin-left: 2px; fill: none; stroke-width: 2; }
    .nav-user-pill[aria-expanded="true"] .pill-chevron { transform: rotate(180deg); }
    .user-dropdown { position: absolute; top: calc(100% + 10px); right: 0; width: 290px; background: var(--white); border: 1.5px solid var(--border); border-radius: var(--radius-lg); box-shadow: 0 20px 48px rgba(27,67,50,.14), 0 4px 12px rgba(27,67,50,.07); z-index: 1000; opacity: 0; visibility: hidden; transform: translateY(-8px) scale(.97); transform-origin: top right; transition: opacity .22s var(--ease), transform .22s var(--ease), visibility .22s; overflow: hidden; }
    .user-dropdown.open { opacity: 1; visibility: visible; transform: translateY(0) scale(1); }
    .dropdown-header { display: flex; align-items: center; gap: 12px; padding: 16px 18px 14px; background: linear-gradient(135deg, var(--g-pale) 0%, rgba(255,255,255,0) 100%); }
    .dropdown-avatar { width: 44px; height: 44px; border-radius: 50%; background: linear-gradient(135deg, var(--g2), var(--g3)); border: 2.5px solid var(--g3); display: grid; place-items: center; font-size: .9rem; font-weight: 700; color: #fff; overflow: hidden; flex-shrink: 0; box-shadow: 0 3px 10px rgba(27,67,50,.2); }
    .dropdown-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .dropdown-user-name  { font-size: .9rem; font-weight: 700; color: var(--text); line-height: 1.2; }
    .dropdown-user-email { font-size: .74rem; color: var(--text-sec); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 180px; }
    .dropdown-divider    { height: 1px; background: var(--border); margin: 4px 0; }
    .dropdown-item { display: flex; align-items: center; gap: 12px; padding: 11px 18px; text-decoration: none; color: var(--text); transition: background .18s var(--ease); }
    .dropdown-item:hover { background: var(--g-hover); }
    .dropdown-item-icon { width: 36px; height: 36px; border-radius: 10px; flex-shrink: 0; background: var(--g-pale); display: grid; place-items: center; transition: transform .2s var(--ease); }
    .dropdown-item-icon svg { width: 17px; height: 17px; stroke: var(--g1); fill: none; stroke-width: 1.8; }
    .dropdown-item:hover .dropdown-item-icon { transform: scale(1.08); }
    .dropdown-item-icon--violet { background: var(--vio-pale); }
    .dropdown-item-icon--violet svg { stroke: var(--violet); }
    .dropdown-item-icon--red { background: #FEF2F2; }
    .dropdown-item-icon--red svg { stroke: var(--red); }
    .dropdown-item-text { flex: 1; display: flex; flex-direction: column; gap: 1px; }
    .dropdown-item-label { font-size: .87rem; font-weight: 600; }
    .dropdown-item-sub   { font-size: .73rem; color: var(--text-sec); }
    .dropdown-item-arrow { width: 14px; height: 14px; fill: none; stroke: var(--border); stroke-width: 2; transition: stroke .2s, transform .2s var(--ease); }
    .dropdown-item:hover .dropdown-item-arrow { stroke: var(--g3); transform: translateX(3px); }
    .dropdown-item--danger .dropdown-item-label { color: var(--red); }
    .dropdown-item--danger:hover { background: #FEF2F2; }

    /* PAGE */
    .page-shell { max-width: 1220px; margin: 0 auto; padding: 40px 48px 0; }

    /* BREADCRUMB */
    .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: .82rem; color: var(--text-sec); margin-bottom: 28px; }
    .breadcrumb a { color: var(--g2); text-decoration: none; font-weight: 600; }
    .breadcrumb a:hover { color: var(--g1); }
    .breadcrumb-sep { color: var(--border); }

    /* HERO BANNER */
    .hero-banner {
      background: linear-gradient(135deg, var(--g1) 0%, #2D6A4F 60%, #1a5c3a 100%);
      border-radius: var(--radius-xl); padding: 36px 40px;
      display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap;
      margin-bottom: 32px; position: relative; overflow: hidden;
    }
    .hero-banner::before { content:''; position:absolute; top:-60px; right:-60px; width:240px; height:240px; border-radius:50%; background:rgba(255,255,255,.05); }
    .hero-banner::after  { content:''; position:absolute; bottom:-40px; left:30%; width:160px; height:160px; border-radius:50%; background:rgba(82,183,136,.1); }
    .hero-banner-left { position:relative; z-index:1; }
    .hero-banner-left h1 { font-family: 'Playfair Display', serif; font-size: clamp(1.5rem,2.5vw,2rem); color: #fff; margin-bottom: 8px; line-height: 1.15; }
    .hero-banner-left p  { font-size: .9rem; color: rgba(255,255,255,.72); max-width: 480px; }
    .hero-id-badge { display: inline-flex; align-items: center; gap: 6px; margin-top: 12px; background: rgba(255,255,255,.15); border: 1px solid rgba(255,255,255,.2); border-radius: 99px; padding: 4px 14px; font-size: .78rem; font-weight: 700; color: rgba(255,255,255,.9); }
    .hero-banner-right { position:relative; z-index:1; }
    .hero-back-btn { display: inline-flex; align-items: center; gap: 8px; padding: 11px 22px; border-radius: 99px; background: rgba(255,255,255,.15); border: 1.5px solid rgba(255,255,255,.3); color: #fff; font-size: .87rem; font-weight: 700; text-decoration: none; transition: all .25s; }
    .hero-back-btn:hover { background: rgba(255,255,255,.25); }
    .hero-back-btn svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2.2; }

    /* PANEL */
    .panel { display: grid; grid-template-columns: 1.5fr 0.9fr; gap: 28px; }
    .panel-card { background: white; border-radius: var(--radius-xl); box-shadow: var(--shadow); border: 1px solid rgba(15,23,42,.06); padding: 36px; }
    .section-title { display: flex; align-items: center; gap: 12px; font-family: 'Playfair Display', serif; font-size: 1.35rem; margin-bottom: 10px; color: var(--g1); }
    .section-subtitle { margin-bottom: 28px; color: var(--text-sec); line-height: 1.75; font-size: .9rem; }

    .field-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
    .field-full { grid-column: 1/-1; }
    .field-block { display: grid; gap: 7px; }
    .field-label { font-size: .8rem; font-weight: 700; color: var(--text-sec); text-transform: uppercase; letter-spacing: .5px; }
    .field-block input,
    .field-block select,
    .field-block textarea {
      width: 100%; border-radius: 14px; border: 1.5px solid var(--border);
      background: var(--bg); padding: 13px 16px; font-size: .95rem;
      color: var(--text); outline: none; font-family: 'Outfit', sans-serif;
      transition: all .2s var(--ease);
    }
    .field-block input:focus,
    .field-block select:focus,
    .field-block textarea:focus { border-color: var(--g2); box-shadow: 0 0 0 4px rgba(82,183,136,.12); background: #fff; }
    .field-block input[readonly] { background: #F5FAF6; color: var(--g1); font-weight: 600; border-style: dashed; }
    .form-note { font-size: .78rem; color: var(--text-sec); display: flex; align-items: center; gap: 5px; }
    .form-note::before { content: 'ℹ️'; }
    .alert { padding: 16px 18px; border-radius: 14px; background: #FEF7F2; border: 1px solid #FBCBBB; color: #7C2D12; margin-bottom: 18px; font-size: .88rem; }

    /* ACTIONS */
    .actions { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 28px; }
    .btn-primary { display: inline-flex; align-items: center; justify-content: center; gap: 9px; padding: 14px 28px; border-radius: 14px; border: none; background: var(--g1); color: white; font-size: .95rem; font-weight: 700; cursor: pointer; font-family: 'Outfit', sans-serif; transition: all .25s var(--ease); }
    .btn-primary:hover { background: var(--g2); transform: translateY(-2px); box-shadow: 0 10px 28px rgba(27,67,50,.25); }
    .btn-secondary { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 14px 24px; border-radius: 14px; border: 1.5px solid var(--border); background: #fff; color: var(--text); font-size: .95rem; font-weight: 700; text-decoration: none; font-family: 'Outfit', sans-serif; transition: all .25s var(--ease); }
    .btn-secondary:hover { background: var(--g-pale); border-color: var(--g3); color: var(--g1); }
    .btn-danger { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 14px 24px; border-radius: 14px; border: 1.5px solid #FECACA; background: var(--red-pale); color: var(--red); font-size: .95rem; font-weight: 700; cursor: pointer; font-family: 'Outfit', sans-serif; transition: all .25s var(--ease); }
    .btn-danger:hover { background: var(--red); color: #fff; border-color: var(--red); }

    /* RECAP SIDEBAR */
    .recap-item { border-radius: 16px; padding: 16px 18px; margin-bottom: 12px; }
    .recap-item:last-child { margin-bottom: 0; }
    .recap-label { font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .7px; color: var(--text-sec); margin-bottom: 4px; }
    .recap-value { font-size: .95rem; font-weight: 700; color: var(--g1); }

    /* STATUS CHIP */
    .status-chip { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 99px; font-size: .78rem; font-weight: 700; }
    .status-confirmed { background: #D8F3DC; color: #1B4332; }
    .status-pending   { background: var(--amber-pale); color: var(--amber); }
    .status-cancelled { background: var(--red-pale); color: var(--red); }
    .status-other     { background: #E2E8F0; color: #475569; }

    /* FLASH */
    .flash-zone { max-width: 1220px; margin: 20px auto 0; padding: 0 48px; }
    .flash { display: flex; align-items: center; gap: 12px; padding: 14px 20px; border-radius: var(--radius-md); font-size: .9rem; font-weight: 600; margin-bottom: 10px; }
    .flash-success { background: var(--g-pale); color: var(--g1); border: 1px solid rgba(82,183,136,.3); }
    .flash-danger  { background: var(--red-pale); color: var(--red); border: 1px solid rgba(220,38,38,.2); }

    /* FOOTER */
    .footer { background: var(--g1); padding: 60px 48px 30px; margin-top: 60px; }
    .footer-inner { max-width: 1200px; margin: 0 auto; }
    .footer-top { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 44px; margin-bottom: 50px; }
    .footer-brand-name { font-family: 'Playfair Display', serif; font-size: 1.38rem; color: #fff; }
    .footer-brand-sub  { font-size: .59rem; color: rgba(255,255,255,.45); letter-spacing: 1.1px; text-transform: uppercase; font-weight: 600; }
    .footer-tagline    { font-size: .85rem; color: rgba(255,255,255,.52); line-height: 1.72; margin-top: 14px; max-width: 265px; }
    .footer-socials { display: flex; gap: 9px; margin-top: 20px; }
    .f-social { width: 36px; height: 36px; border-radius: 9px; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.12); display: grid; place-items: center; text-decoration: none; transition: all .25s; }
    .f-social:hover { background: var(--g2); border-color: var(--g2); }
    .f-social svg { width: 16px; height: 16px; stroke: rgba(255,255,255,.65); fill: none; stroke-width: 1.8; }
    .footer-col-title { font-size: .73rem; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: rgba(255,255,255,.9); margin-bottom: 16px; }
    .footer-link { display: block; font-size: .84rem; color: rgba(255,255,255,.52); text-decoration: none; padding: 4px 0; transition: color .22s; }
    .footer-link:hover { color: #fff; }
    .footer-bottom { border-top: 1px solid rgba(255,255,255,.1); padding-top: 26px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; }
    .footer-copy  { font-size: .78rem; color: rgba(255,255,255,.37); }
    .footer-heart { font-size: .72rem; color: rgba(255,255,255,.37); }
    .footer-heart span { color: var(--g3); }

    /* TOAST */
    .toast { position: fixed; bottom: 30px; right: 30px; z-index: 9999; background: var(--g1); color: #fff; padding: 14px 22px; border-radius: 13px; font-size: .88rem; font-weight: 600; box-shadow: 0 8px 28px rgba(27,67,50,.32); display: flex; align-items: center; gap: 10px; transform: translateY(80px); opacity: 0; transition: all .4s var(--ease); pointer-events: none; }
    .toast.show { transform: none; opacity: 1; }

    @media(max-width:1024px) { .footer-top { grid-template-columns: 1fr 1fr; } .panel { grid-template-columns: 1fr; } }
    @media(max-width:768px) { .nav { padding: 0 20px; } .nav-links { display: none; } .page-shell { padding: 24px 20px 0; } .footer { padding: 50px 24px 24px; } .footer-top { grid-template-columns: 1fr; gap: 28px; } .hero-banner { padding: 28px 24px; } .flash-zone { padding: 0 20px; } }
    @media(max-width:640px) { .field-grid { grid-template-columns: 1fr; } .field-full { grid-column: 1; } }
  </style>
</head>
<body>

{# ══ Variables rôle ══ #}
{% set user      = app.user %}
{% set roleRaw   = user.roleUtilisateur %}
{% set roleSlug  = roleRaw|replace({'ROLE_': ''})|lower %}
{% set roleLabel = {'patient':'Patient','medecin':'Médecin','coach':'Coach','psychologue':'Psychologue','user':'Utilisateur','admin':'Admin'}[roleSlug] ?? (roleSlug|capitalize) %}
{% set roleEmoji = {'patient':'🧠','medecin':'🩺','coach':'💪','psychologue':'🧘','user':'👤','admin':'🛡️'}[roleSlug] ?? '👤' %}

{# ══ NAVBAR ══ #}
<nav class="nav" id="main-nav">
  <a href="{{ path('app_home') }}" class="nav-brand">
    <div class="nav-brand-icon">
      <img src="{{ asset('images/logo.png') }}" alt="MindAura Logo" style="width:100%;height:100%;object-fit:contain;border-radius:12px;">
    </div>
    <div>
      <div class="nav-brand-name">MindAura</div>
      <div class="nav-brand-sub">Bien-être &amp; Sérénité</div>
    </div>
  </a>

  <div class="nav-links">
    <a href="{{ path('locaux_psychiatrie_front_locaux_index') }}" class="nav-link">Locaux</a>
    <a href="{{ path('salle_front_salles_index') }}"              class="nav-link">Salles</a>
    <a href="{{ path('reservation_local_front_index') }}"         class="nav-link active">Mes réservations</a>
  </div>

  <div class="nav-right">
    <div class="nav-user-pill-wrapper" id="userPillWrapper">
      <button class="nav-user-pill" id="userPillBtn" type="button" aria-haspopup="true" aria-expanded="false">
        <div class="nav-avatar">
          {% if user.photoProfilUtilisateur is defined and user.photoProfilUtilisateur != 'default.png' %}
            <img src="{{ asset('avatars/' ~ user.photoProfilUtilisateur) }}" alt="avatar"/>
          {% else %}
            {{ user.prenomUtilisateur|first|upper }}{{ user.nomUtilisateur|first|upper }}
          {% endif %}
        </div>
        <span class="nav-user-name">{{ user.prenomUtilisateur }}</span>
        <span class="nav-role-badge">{{ roleEmoji }} {{ roleLabel }}</span>
        <svg class="pill-chevron" viewBox="0 0 16 16" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 6l4 4 4-4"/>
        </svg>
      </button>

      <div class="user-dropdown" id="userDropdown" role="menu">
        <div class="dropdown-header">
          <div class="dropdown-avatar">
            {% if user.photoProfilUtilisateur is defined and user.photoProfilUtilisateur != 'default.png' %}
              <img src="{{ asset('avatars/' ~ user.photoProfilUtilisateur) }}" alt="avatar"/>
            {% else %}
              {{ user.prenomUtilisateur|first|upper }}{{ user.nomUtilisateur|first|upper }}
            {% endif %}
          </div>
          <div>
            <div class="dropdown-user-name">{{ user.prenomUtilisateur }} {{ user.nomUtilisateur }}</div>
            <div class="dropdown-user-email">{{ user.emailUtilisateur }}</div>
          </div>
        </div>
        <div class="dropdown-divider"></div>
        <a href="{{ path('app_profil') }}" class="dropdown-item" role="menuitem">
          <span class="dropdown-item-icon">
            <svg viewBox="0 0 20 20"><circle cx="10" cy="7" r="3.5"/><path d="M3 17c0-3.3 3.1-6 7-6s7 2.7 7 6" stroke-linecap="round"/></svg>
          </span>
          <span class="dropdown-item-text">
            <span class="dropdown-item-label">Mon profil</span>
            <span class="dropdown-item-sub">Modifier mes informations</span>
          </span>
          <svg class="dropdown-item-arrow" viewBox="0 0 16 16"><path d="M6 3l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="{{ path('reservation_local_front_index') }}" class="dropdown-item" role="menuitem">
          <span class="dropdown-item-icon dropdown-item-icon--violet">
            <svg viewBox="0 0 20 20"><rect x="3" y="4" width="14" height="13" rx="2"/><path d="M3 8h14" stroke-linecap="round"/></svg>
          </span>
          <span class="dropdown-item-text">
            <span class="dropdown-item-label">Mes réservations</span>
            <span class="dropdown-item-sub">Gérer mes réservations</span>
          </span>
          <svg class="dropdown-item-arrow" viewBox="0 0 16 16"><path d="M6 3l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <div class="dropdown-divider"></div>
        <a href="{{ path('app_logout') }}" class="dropdown-item dropdown-item--danger" role="menuitem">
          <span class="dropdown-item-icon dropdown-item-icon--red">
            <svg viewBox="0 0 20 20"><path d="M13 15l4-5-4-5M17 10H7" stroke-linecap="round" stroke-linejoin="round"/><path d="M7 4H5a1 1 0 00-1 1v10a1 1 0 001 1h2" stroke-linecap="round"/></svg>
          </span>
          <span class="dropdown-item-text">
            <span class="dropdown-item-label">Déconnexion</span>
            <span class="dropdown-item-sub">Fermer la session</span>
          </span>
        </a>
      </div>
    </div>
  </div>
</nav>

{# ══ FLASH MESSAGES ══ #}
<div class="flash-zone">
  {% for msg in app.flashes('success') %}
    <div class="flash flash-success">✅ {{ msg }}</div>
  {% endfor %}
  {% for msg in app.flashes('error') %}
    <div class="flash flash-danger">❌ {{ msg }}</div>
  {% endfor %}
</div>

{# ══ PAGE SHELL ══ #}
<div class="page-shell">

  {# Breadcrumb #}
