          Annuler
        </a>
      </div>

      {{ form_end(form) }}
    </section>

    {# Sidebar récapitulatif #}
    <aside class="panel-card">
      <div class="section-title">📄 Récapitulatif actuel</div>

      <div class="recap-item" style="background:#F0F8F2;">
        <div class="recap-label">Client</div>
        <div class="recap-value">{{ reservation.prenomCl }} {{ reservation.nomCl }}</div>
      </div>

      {% if reservation.local %}
      <div class="recap-item" style="background:#EBF4FF;">
        <div class="recap-label">Local</div>
        <div class="recap-value">🏥 {{ reservation.local.nomLocal }}</div>
      </div>
      {% endif %}

      {% if reservation.salle %}
      <div class="recap-item" style="background:#EBF4FF;">
        <div class="recap-label">Salle</div>
        <div class="recap-value">🚪 {{ reservation.salle.nomSalle }}</div>
      </div>
      {% endif %}

      <div class="recap-item" style="background:#F5F3FF;">
        <div class="recap-label">Date</div>
        <div class="recap-value">{{ reservation.dateReservation ? reservation.dateReservation|date('d/m/Y') : '—' }}</div>
      </div>

      <div class="recap-item" style="background:#F5F3FF;">
        <div class="recap-label">Horaires</div>
        <div class="recap-value">
          {{ reservation.heureDebutReservation ? reservation.heureDebutReservation|date('H:i') : '—' }}
          → {{ reservation.heureFinReservation ? reservation.heureFinReservation|date('H:i') : '—' }}
        </div>
      </div>

      {% if reservation.prixReservation %}
      <div class="recap-item" style="background:#F0FFF4;">
        <div class="recap-label">Prix actuel</div>
        <div class="recap-value" style="font-size:1.15rem;color:#1B4332;">{{ reservation.prixReservation }} TND</div>
      </div>
      {% endif %}

      <div class="recap-item" style="background:#F8FAFC;">
        <div class="recap-label">Statut actuel</div>
        <div style="margin-top:6px">
          {% if reservation.statusReservation == 'Confirmée' %}
            <span class="status-chip status-confirmed">● Confirmée</span>
          {% elseif reservation.statusReservation == 'En attente' %}
            <span class="status-chip status-pending">● En attente</span>
          {% elseif reservation.statusReservation == 'Annulée' %}
            <span class="status-chip status-cancelled">● Annulée</span>
          {% else %}
            <span class="status-chip status-other">{{ reservation.statusReservation }}</span>
          {% endif %}
        </div>
      </div>

      <div style="margin-top:18px;background:#EFFAF4;border-radius:18px;padding:16px;">
        <strong style="font-size:.85rem;color:var(--g1);">💡 Astuce :</strong><br>
        <span style="font-size:.83rem;color:var(--text-sec);line-height:1.6;">Modifiez les horaires pour recalculer automatiquement le prix de votre réservation.</span>
      </div>
    </aside>

  </div>

</div>{# /page-shell #}

