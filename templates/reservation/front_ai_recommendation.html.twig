<script>
const nav = document.getElementById('main-nav');
window.addEventListener('scroll', () => nav.classList.toggle('scrolled', window.scrollY > 20));

const TYPE_LABELS   = { individuelle: 'Séance individuelle', groupe: 'Séance de groupe', consultation: 'Consultation médicale', therapie: 'Thérapie cognitive', relaxation: 'Relaxation / Méditation' };
const BRUIT_LABELS  = { faible: 'Calme', moyen: 'Modéré', eleve: 'Dynamique' };
const CONFORT_LABELS= { eleve: 'Élevé', moyen: 'Moyen', faible: 'Basique' };

function setStep(n) {
  [1,2,3,4].forEach(i => {
    const el = document.getElementById('step-' + i);
    if (!el) return;
    el.classList.remove('done','active');
    if (i < n)  el.classList.add('done');
    if (i === n) el.classList.add('active');
  });
}

function scoreColor(s) {
  if (s >= 80) return '#16a34a';
  if (s >= 60) return '#D97706';
  return '#DC2626';
}

function dimColor(pct) {
  if (pct >= .8) return '#52B788';
  if (pct >= .5) return '#D97706';
  return '#EF4444';
}

// ── Explication via /api/explain-room (OpenRouter côté serveur — clé sécurisée) ──
async function genererExplication(salle, criteria) {
  try {
    const resp = await fetch('/api/explain-room', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ salle: salle, criteria: criteria })
    });
    const data = await resp.json();
    // Log pour debug — à retirer en production
    console.log(`[IA explain] salle="${salle.nom}" status=${resp.status}`, data);
    if (data.debug) console.warn(`[IA explain] debug: ${data.debug}`);
    return data.explication || "Cette salle présente un excellent profil pour votre séance selon nos critères d'analyse.";
  } catch (err) {
    console.error('[IA explain] Erreur fetch:', err);
    return "Cette salle présente un excellent profil pour votre séance selon nos critères d'analyse.";
  }
}

function renderCard(salle, delay) {
  const score   = salle.score;
  const isBest  = salle.is_best;
  const details = salle.score_details ?? {};
  const dimType    = details.type_score     ?? 0;
  const dimCap     = details.capacite_score ?? 0;
  const dimBruit   = details.bruit_score    ?? 0;
  const dimConfort = details.confort_score  ?? 0;
  // Détermination du chemin image — supporte plusieurs conventions Symfony
  function buildImgSrc(image) {
    if (!image) return null;
    // Si l'image contient déjà un slash ou commence par http, on la prend telle quelle
    if (image.startsWith('http') || image.startsWith('/')) return image;
    // Chemins courants Symfony pour les uploads de salles
    const candidates = [
      `/uploads/salles/${image}`,
      `/uploads/images_salles/${image}`,
      `/uploads/${image}`,
      `/images/salles/${image}`,
      `/public/uploads/salles/${image}`,
    ];
    return candidates[0]; // On prend le premier ; l'onerror enchaîne les suivants
  }

  function buildImgHTML(salle) {
    if (!salle.image) {
      return `<div class="reco-image-placeholder" style="background:linear-gradient(135deg,var(--g-pale),var(--vio-pale))">🏥</div>`;
    }
    // Liste des chemins à essayer en cascade
    const paths = salle.image.startsWith('http') || salle.image.startsWith('/')
      ? [salle.image]
      : [
          `/uploads/salles/${salle.image}`,
          `/uploads/images_salles/${salle.image}`,
          `/uploads/${salle.image}`,
          `/images/salles/${salle.image}`,
        ];
    const pathsJson = JSON.stringify(paths);
    return `<img
        src="${paths[0]}"
        alt="${salle.nom}"
        loading="lazy"
        data-fallbacks='${pathsJson}'
        data-fallback-index="0"
        onerror="
          const fb = JSON.parse(this.dataset.fallbacks);
          let idx = parseInt(this.dataset.fallbackIndex) + 1;
          if (idx < fb.length) {
            this.dataset.fallbackIndex = idx;
            this.src = fb[idx];
          } else {
            this.style.display='none';
            this.nextElementSibling.style.display='grid';
          }
        "
      ><div class="reco-image-placeholder" style="display:none;background:linear-gradient(135deg,var(--g-pale),var(--vio-pale))">🏥</div>`;
  }

  const imgHTML = buildImgHTML(salle);
  return `
    <div class="reco-card ${isBest ? 'best' : ''}" style="animation-delay:${delay}ms">
      <div class="reco-image-zone">
        ${imgHTML}
        <div class="reco-rank-badge rank-${salle.rank}">${salle.rank===1?'🥇':salle.rank===2?'🥈':'🥉'}</div>
        ${isBest ? '<div class="best-tag"><span class="best-tag-dot"></span>IA Recommande</div>' : ''}
      </div>
      <div class="reco-body">
        <div>
          <div class="reco-name">${salle.nom}</div>
          <div class="reco-local">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 1.5A4.5 4.5 0 0 1 12.5 6c0 3.5-4.5 8.5-4.5 8.5S3.5 9.5 3.5 6A4.5 4.5 0 0 1 8 1.5z"/><circle cx="8" cy="6" r="1.5"/></svg>
            ${salle.local_nom ?? '—'}, ${salle.local_ville ?? ''}
          </div>
        </div>
        <div class="score-bar-zone">
          <div class="score-bar-top">
            <span class="score-bar-label">Score de compatibilité</span>
            <span><span class="score-num">${score}</span><span class="score-denom">/100</span></span>
          </div>
          <div class="score-bar-track">
            <div class="score-bar-fill" style="width:${score}%"></div>
          </div>
        </div>
        <div class="score-breakdown">
          <div class="score-dim">
            <div class="score-dim-label">Type séance</div>
            <div class="score-dim-val">${dimType}<span class="score-dim-max">/30</span></div>
            <div class="score-dim-pip"><div class="score-dim-pip-fill" style="width:${(dimType/30)*100}%;background:${dimColor(dimType/30)}"></div></div>
          </div>
          <div class="score-dim">
            <div class="score-dim-label">Capacité</div>
            <div class="score-dim-val">${dimCap}<span class="score-dim-max">/25</span></div>
            <div class="score-dim-pip"><div class="score-dim-pip-fill" style="width:${(dimCap/25)*100}%;background:${dimColor(dimCap/25)}"></div></div>
          </div>
          <div class="score-dim">
            <div class="score-dim-label">Bruit</div>
            <div class="score-dim-val">${dimBruit}<span class="score-dim-max">/25</span></div>
            <div class="score-dim-pip"><div class="score-dim-pip-fill" style="width:${(dimBruit/25)*100}%;background:${dimColor(dimBruit/25)}"></div></div>
          </div>
          <div class="score-dim">
            <div class="score-dim-label">Confort</div>
            <div class="score-dim-val">${dimConfort}<span class="score-dim-max">/20</span></div>
            <div class="score-dim-pip"><div class="score-dim-pip-fill" style="width:${(dimConfort/20)*100}%;background:${dimColor(dimConfort/20)}"></div></div>
          </div>
        </div>
        <div class="reco-chips">
          <span class="chip green">👥 ${salle.capacite} pers.</span>
          <span class="chip violet">🏢 ${salle.type}</span>
          ${salle.etage ? `<span class="chip gold">📍 ${salle.etage}</span>` : ''}
          ${salle.disponibilite === 'Disponible' ? '<span class="chip green">✅ Disponible</span>' : '<span class="chip" style="background:#fee2e2;color:#dc2626">🔒 Indisponible</span>'}
        </div>
        <div class="ai-explain">
          <div class="ai-explain-label"><span class="ai-explain-pulse"></span>Analyse IA OpenRouter</div>
          <div class="ai-explain-text ai-explain-loading" id="explain-text-${salle.id}">Génération de l'explication en cours…</div>
        </div>
      </div>
      <div class="reco-footer">
        <div class="reco-cta">
          <a href="/reservations/front/new?salle=${salle.id}${salle.local_id ? '&local='+salle.local_id : ''}" class="btn-book">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="3" width="12" height="12" rx="2"/><path d="M10 1v4M6 1v4M2 7h12"/></svg>
            Réserver cette salle
          </a>
          <a href="/salle/front/${salle.id}" class="btn-detail" title="Voir le détail">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </div>`;
}

async function lancerAnalyseIA() {
  const criteria = {
    type_seance: document.getElementById('cr-type').value,
    capacite:    parseInt(document.getElementById('cr-capacite').value) || 1,
    bruit:       document.getElementById('cr-bruit').value,
    confort:     document.getElementById('cr-confort').value,
  };
  const localId = document.getElementById('cr-local').value;

  document.getElementById('analyze-btn').classList.add('loading');
  document.getElementById('results-zone').classList.remove('visible');
  document.getElementById('loading-zone').classList.add('visible');
  [1,2,3,4].forEach(i => { const el = document.getElementById('step-'+i); if (el) el.classList.remove('done','active'); });

  setStep(1);
  await new Promise(r => setTimeout(r, 600));

  let params = `type=${criteria.type_seance}&capacite=${criteria.capacite}&bruit=${criteria.bruit}&confort=${criteria.confort}`;
  if (localId) params += `&local=${localId}`;

  let apiData;
  try {
    const resp = await fetch(`/api/recommend-room?${params}`);
    apiData = await resp.json();
  } catch {
    document.getElementById('loading-zone').classList.remove('visible');
    document.getElementById('analyze-btn').classList.remove('loading');
    alert('Erreur de connexion. Veuillez réessayer.');
    return;
  }

  setStep(2);
  await new Promise(r => setTimeout(r, 700));

  if (!apiData.success || !apiData.recommendations?.length) {
    document.getElementById('loading-zone').classList.remove('visible');
    document.getElementById('analyze-btn').classList.remove('loading');
    document.getElementById('results-zone').classList.add('visible');
    document.getElementById('reco-grid').innerHTML = `
      <div class="empty-state" style="grid-column:1/-1">
        <div class="empty-icon">🔍</div>
        <div class="empty-title">Aucune salle correspondante</div>
        <div class="empty-sub">${apiData.message ?? "Essayez d'élargir vos critères ou de changer de local."}</div>
      </div>`;
    document.getElementById('score-summary').innerHTML = '';
    return;
  }

  const recos = apiData.recommendations;
  // DEBUG — à retirer en production
  console.log('🏥 API recommend-room — première salle reçue :', recos[0]);
  console.log('🖼️ Champ image :', recos[0]?.image, '| Clés disponibles :', Object.keys(recos[0] ?? {}));
  setStep(3);

  document.getElementById('reco-grid').innerHTML = recos.map((s, i) => renderCard(s, i * 80)).join('');
  document.getElementById('score-summary').innerHTML = `
    <div class="score-sum-item"><div class="score-sum-label">Salles analysées</div><div class="score-sum-val">${apiData.total_analysed} <span class="score-sum-unit">salles</span></div></div>
    <div class="score-sum-divider"></div>
    <div class="score-sum-item"><div class="score-sum-label">Type de séance</div><div class="score-sum-val" style="font-size:1rem;">${TYPE_LABELS[criteria.type_seance] ?? criteria.type_seance}</div></div>
    <div class="score-sum-divider"></div>
    <div class="score-sum-item"><div class="score-sum-label">Meilleur score</div><div class="score-sum-val" style="color:${scoreColor(recos[0].score)}">${recos[0].score} <span class="score-sum-unit">/100</span></div></div>
    <div class="score-sum-divider"></div>
    <div class="score-sum-item"><div class="score-sum-label">Salle #1 recommandée</div><div class="score-sum-val" style="font-size:.95rem;">${recos[0].nom}</div></div>`;
  document.getElementById('results-meta').textContent = `${recos.length} recommandation(s) parmi ${apiData.total_analysed} salle(s) analysées · ${new Date().toLocaleTimeString('fr-FR', {hour:'2-digit',minute:'2-digit'})}`;
  document.getElementById('results-badge').innerHTML  = `✅ ${apiData.total_analysed} salles analysées`;

  setStep(4);
  await new Promise(r => setTimeout(r, 400));
  document.getElementById('loading-zone').classList.remove('visible');
  document.getElementById('analyze-btn').classList.remove('loading');
  document.getElementById('results-zone').classList.add('visible');

  requestAnimationFrame(() => {
    document.querySelectorAll('.score-bar-fill').forEach(bar => { const w = bar.style.width; bar.style.width='0%'; setTimeout(()=>{ bar.style.width=w; }, 50); });
    document.querySelectorAll('.score-dim-pip-fill').forEach(pip => { const w = pip.style.width; pip.style.width='0%'; setTimeout(()=>{ pip.style.width=w; }, 80); });
  });

  await Promise.all(recos.map(async salle => {
    const explication = await genererExplication(salle, criteria);
    const el = document.getElementById('explain-text-' + salle.id);
    if (el) { el.classList.remove('ai-explain-loading'); el.textContent = explication; }
  }));

  document.getElementById('results-zone').scrollIntoView({ behavior: 'smooth', block: 'start' });
}
</script>
</body>
</html>
