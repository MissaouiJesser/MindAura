    </div>
  </div>
</div>

{# ══ FOOTER ══ #}
<footer class="footer">
  <div class="footer-bottom">
    <div class="footer-copy">&copy; 2026 MindAura — Tous droits réservés.</div>
    <div class="footer-heart">Fait avec <span>&hearts;</span> par MindAura</div>
  </div>
</footer>

{# ── Données JSON injectées par Twig ── #}
<script>
const CALENDAR_EVENTS = {{ cal_events|json_encode|raw }};
</script>

<script>
/* ══ FullCalendar init ════════════════════════════════════════════ */
let calendar;
let activeFilter = 'all';

const STATUS_COLORS = {
  'En attente': '#D97706',
  'Confirmée':  '#059669',
  'Annulée':    '#DC2626',
  'Terminée':   '#6366F1',
};

document.addEventListener('DOMContentLoaded', () => {

  /* ── Initialisation FullCalendar ── */
  const calEl = document.getElementById('fullcalendar');
  calendar = new FullCalendar.Calendar(calEl, {
    locale:         'fr',
    initialView:    'dayGridMonth',
    headerToolbar: {
      left:   'prev,next today',
      center: 'title',
      right:  '',           // on gère la vue manuellement avec nos boutons
    },
    buttonText: {
      today:    "Aujourd'hui",
      month:    'Mois',
      week:     'Semaine',
      day:      'Jour',
      list:     'Liste',
    },
    firstDay:        1,          // Lundi en premier
    events:          CALENDAR_EVENTS,
    dayMaxEvents:    3,          // "+N more" après 3 événements par jour
    nowIndicator:    true,
    height:          'auto',
    slotMinTime:     '07:00:00',
    slotMaxTime:     '22:00:00',
    slotLabelFormat: { hour: '2-digit', minute: '2-digit', hour12: false },

    /* Tooltip au survol */
    eventMouseEnter(info) {
      const p = info.event.extendedProps;
      info.el.setAttribute('title',
        `${p.local} • ${p.date} • ${p.debut}–${p.fin}\n${p.status}`
      );
    },

    /* Clic sur un événement → ouvre la modale */
    eventClick(info) {
      openModal(info.event);
    },

    /* Rendu personnalisé de l'événement (vue grille) */
    eventContent(arg) {
      const status = arg.event.extendedProps.status;
      const color  = STATUS_COLORS[status] || '#6B7280';
      const debut  = arg.event.extendedProps.debut;
      return {
        html: `
          <div style="display:flex;align-items:center;gap:5px;padding:2px 6px;overflow:hidden;">
            <span style="width:6px;height:6px;border-radius:50%;background:${color};flex-shrink:0;"></span>
            <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
              ${debut !== '—' ? debut + ' · ' : ''}${arg.event.title}
            </span>
          </div>
        `
      };
    },
  });

  calendar.render();
  buildUpcomingList();

  /* ── Navbar scroll ── */
  const nav = document.getElementById('main-nav');
  window.addEventListener('scroll', () => nav.classList.toggle('scrolled', window.scrollY > 20));
});

/* ── Changer de vue calendrier ── */
function switchView(view, btn) {
  calendar.changeView(view);
  document.querySelectorAll('.cal-view-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
}

/* ── Filtrer par statut ── */
function filterByStatus(status, el) {
  activeFilter = status;

  // Reset toutes les chips & items légende
  document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
  if (el && el.classList.contains('filter-chip')) el.classList.add('active');

  // Classes à afficher
  const classMap = {
    all:       null,
    attente:   'ev-attente',
    confirmee: 'ev-confirmee',
    annulee:   'ev-annulee',
    terminee:  'ev-terminee',
  };

  calendar.getEvents().forEach(ev => {
    const cls = ev.classNames[0];
    const show = (status === 'all') || (cls === classMap[status]);
    if (show) { ev.setProp('display', 'auto'); }
    else       { ev.setProp('display', 'none'); }
  });
}

/* ── Ouvrir la modale de détail ── */
function openModal(event) {
  const p      = event.extendedProps;
  const status = p.status;
  const color  = STATUS_COLORS[status] || '#6B7280';
  const slug   = statusSlug(status);

  document.getElementById('modal-title').textContent    = event.title;
  document.getElementById('modal-subtitle').textContent = `Réservation · ${p.date}`;
  document.getElementById('modal-date').textContent     = p.date;
  document.getElementById('modal-horaire').textContent  = `${p.debut} → ${p.fin}`;
  document.getElementById('modal-local').textContent    = p.local;
  document.getElementById('modal-salle').textContent    = p.salle;
  document.getElementById('modal-motif').textContent    = p.motif;
  document.getElementById('modal-prix').textContent     = p.prix !== '—' ? p.prix + ' TND' : '—';
  document.getElementById('modal-patient').textContent  = p.nomCl;
  document.getElementById('modal-status-bar').style.background = color;
  document.getElementById('modal-status-badge').innerHTML =
    `<span class="modal-status-badge ${slug}">${statusEmoji(status)} ${status}</span>`;
  document.getElementById('modal-btn-edit').href = p.editUrl;
  document.getElementById('modal-btn-show').href = p.showUrl;

  document.getElementById('modal-overlay').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function closeModal() {
  document.getElementById('modal-overlay').classList.remove('open');
  document.body.style.overflow = '';
}

// Fermer si clic en dehors
document.getElementById('modal-overlay').addEventListener('click', e => {
  if (e.target === e.currentTarget) closeModal();
});
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

/* ── Mini liste "à venir" ── */
function buildUpcomingList() {
  const today = new Date(); today.setHours(0,0,0,0);
  const future = CALENDAR_EVENTS
    .filter(ev => {
      if (!ev.start) return false;
      const d = new Date(ev.start); d.setHours(0,0,0,0);
      return d >= today && ev.extendedProps.status !== 'Annulée';
    })
    .sort((a, b) => new Date(a.start) - new Date(b.start))
    .slice(0, 8);

  const container = document.getElementById('upcoming-list');
  if (future.length === 0) {
    container.innerHTML = `<div class="upcoming-empty"><div class="upcoming-empty-icon">📅</div><p>Aucune réservation à venir</p></div>`;
    return;
  }

  const days = ['Dim','Lun','Mar','Mer','Jeu','Ven','Sam'];
  container.innerHTML = future.map(ev => {
    const d    = new Date(ev.start);
    const num  = String(d.getDate()).padStart(2,'0');
    const day  = days[d.getDay()];
    const slug = statusSlug(ev.extendedProps.status);
    return `
      <div class="upcoming-item" onclick="calendar.gotoDate('${ev.start.substring(0,10)}'); calendar.changeView('timeGridDay'); document.querySelectorAll('.cal-view-btn').forEach(b=>b.classList.remove('active')); document.querySelector('[data-view=timeGridDay]').classList.add('active');">
        <div class="upcoming-day-badge">
          <span class="upcoming-day-num">${num}</span>
          <span class="upcoming-day-name">${day}</span>
        </div>
        <div class="upcoming-info">
          <div class="upcoming-info-name">${ev.title}</div>
          <div class="upcoming-info-meta">
            <span class="upcoming-dot ${slug}"></span>
            ${ev.extendedProps.debut !== '—' ? ev.extendedProps.debut + ' · ' : ''}
            ${ev.extendedProps.status}
          </div>
        </div>
      </div>`;
  }).join('');
}

/* ── Helpers ── */
function statusSlug(s) {
  const m = {'En attente':'attente','Confirmée':'confirmee','Annulée':'annulee','Terminée':'terminee'};
  return m[s] || 'attente';
}
function statusEmoji(s) {
  const m = {'En attente':'⏳','Confirmée':'✅','Annulée':'❌','Terminée':'✔️'};
  return m[s] || '';
}
</script>
