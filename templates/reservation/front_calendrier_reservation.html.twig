          <span class="legend-label">En attente</span>
          <span class="legend-count">{{ cnt_attente }}</span>
        </div>
        <div class="legend-item" onclick="filterByStatus('confirmee', this)">
          <span class="legend-dot confirmee"></span>
          <span class="legend-label">Confirmée</span>
          <span class="legend-count">{{ cnt_confirm }}</span>
        </div>
        <div class="legend-item" onclick="filterByStatus('annulee', this)">
          <span class="legend-dot annulee"></span>
          <span class="legend-label">Annulée</span>
          <span class="legend-count">{{ cnt_annulee }}</span>
        </div>
        <div class="legend-item" onclick="filterByStatus('terminee', this)">
          <span class="legend-dot terminee"></span>
          <span class="legend-label">Terminée</span>
          <span class="legend-count">{{ cnt_terminee }}</span>
        </div>
      </div>
    </div>

    {# Filtres rapides #}
    <div class="filter-card">
      <span class="filter-title">Filtres rapides</span>
      <div class="filter-chips">
        <button class="filter-chip active"       data-filter="all"       onclick="filterByStatus('all', this)">Tous</button>
        <button class="filter-chip"              data-filter="attente"   onclick="filterByStatus('attente', this)">⏳ En attente</button>
        <button class="filter-chip"              data-filter="confirmee" onclick="filterByStatus('confirmee', this)">✅ Confirmée</button>
        <button class="filter-chip"              data-filter="annulee"   onclick="filterByStatus('annulee', this)">❌ Annulée</button>
        <button class="filter-chip"              data-filter="terminee"  onclick="filterByStatus('terminee', this)">✔️ Terminée</button>
      </div>
    </div>

    {# Prochaines réservations ─ mini liste #}
    <div class="upcoming-card">
      <div class="upcoming-header">
        <span class="upcoming-header-title">📋 À venir</span>
      </div>
      <div class="upcoming-list" id="upcoming-list">
        {# filled by JS #}
        <div class="upcoming-empty">
          <div class="upcoming-empty-icon">📅</div>
          <p>Chargement…</p>
        </div>
      </div>
    </div>

  </div>{# /side-panel #}
</div>{# /main-wrap #}

{# ══ MODAL DÉTAIL ══ #}
