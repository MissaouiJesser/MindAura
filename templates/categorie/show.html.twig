{% extends 'base_backoffice.html.twig' %}

{% block title %}Catégorie {{ categorie.nom_categorie }} — Backoffice{% endblock %}
{% block page_label %}Catégorie{% endblock %}

{% block content %}
<style>
  @keyframes fadeUp { from { opacity:0; transform:translateY(14px); } to { opacity:1; transform:none; } }

  .page-hero {
    position:relative;
    background:linear-gradient(135deg,#1B4332 0%,#1A3A5C 55%,#0F2447 100%);
    border-radius:20px; padding:28px 34px; margin-bottom:20px;
    overflow:hidden; animation:fadeUp .4s cubic-bezier(.22,1,.36,1) both;
    box-shadow:0 8px 32px rgba(27,67,50,.22);
  }
  .page-hero::before { content:''; position:absolute; width:280px; height:280px; border-radius:50%; background:rgba(255,255,255,.055); top:-80px; right:-60px; pointer-events:none; }
  .hero-inner { display:flex; align-items:center; gap:20px; position:relative; z-index:1; margin-top:8px; }
  .hero-icon-box { width:58px; height:58px; border-radius:16px; background:rgba(255,255,255,.13); border:1.5px solid rgba(255,255,255,.2); display:grid; place-items:center; flex-shrink:0; }
  .hero-icon-box svg { width:26px; height:26px; color:#fff; }
  .hero-text { flex:1; }
  .hero-title { font-family:'Playfair Display',serif; font-size:1.5rem; font-weight:700; color:#fff; margin-bottom:4px; }
  .hero-sub { font-size:.82rem; color:rgba(255,255,255,.7); display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
  .hero-chip { display:inline-flex; align-items:center; gap:5px; background:rgba(255,255,255,.12); border:1px solid rgba(255,255,255,.2); border-radius:99px; padding:3px 10px; font-size:.73rem; font-weight:600; color:rgba(255,255,255,.9); }
  .actions-group { display:flex; gap:10px; }
  .btn-action-hero { display:inline-flex; align-items:center; gap:9px; padding:12px 22px; border-radius:13px; background:#fff; color:var(--green); font-family:'Outfit',sans-serif; font-size:.87rem; font-weight:700; text-decoration:none; white-space:nowrap; flex-shrink:0; box-shadow:0 4px 18px rgba(0,0,0,.14); transition:transform .2s, box-shadow .2s; }
  .btn-action-hero:hover { transform:translateY(-2px); box-shadow:0 8px 28px rgba(0,0,0,.22); }
  .btn-action-hero.danger { background:#DC2626; color:#fff; }
  .btn-action-hero.danger:hover { background:#B91C1C; }
  .btn-action-hero-icon { width:27px; height:27px; border-radius:8px; background:var(--green-pale); display:grid; place-items:center; flex-shrink:0; }
  .btn-action-hero-icon svg { width:14px; height:14px; color:var(--green); }
  .btn-action-hero.danger .btn-action-hero-icon { background:rgba(255,255,255,.2); }
  .btn-action-hero.danger .btn-action-hero-icon svg { color:#fff; }

  .details-card { background:var(--white); border:1.5px solid var(--border); border-radius:18px; padding:24px; margin-bottom:20px; box-shadow:var(--shadow-card); animation:fadeUp .4s cubic-bezier(.22,1,.36,1) .08s both; }
  .details-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(250px,1fr)); gap:20px; }
  .detail-item { display:flex; flex-direction:column; gap:6px; }
  .detail-label { font-size:.75rem; font-weight:600; color:var(--text-sec); text-transform:uppercase; letter-spacing:.8px; }
  .detail-value { font-size:1rem; font-weight:500; color:var(--text); }

  .reclamations-card { background:var(--white); border:1.5px solid var(--border); border-radius:18px; overflow:hidden; box-shadow:var(--shadow-card); animation:fadeUp .4s cubic-bezier(.22,1,.36,1) .12s both; }
  .card-header { padding:20px 24px; border-bottom:1.5px solid var(--border); background:var(--bg); }
  .card-title { font-size:1.1rem; font-weight:700; color:var(--text); margin:0; }
  .card-subtitle { font-size:.82rem; color:var(--text-sec); margin:4px 0 0; }
  .reclamations-list { padding:0; }
  .reclamation-item { display:flex; align-items:center; justify-content:space-between; padding:16px 24px; border-bottom:1px solid var(--border); transition:background .15s; }
  .reclamation-item:hover { background:var(--green-hover); }
  .reclamation-item:last-child { border-bottom:none; }
  .reclamation-link { text-decoration:none; color:var(--text); font-weight:500; flex:1; }
  .reclamation-link:hover { color:var(--green); }
  .reclamation-date { font-size:.8rem; color:var(--text-sec); }
  .btn-view { display:inline-flex; align-items:center; gap:6px; padding:6px 12px; border-radius:8px; background:#EFF6FF; border:1.5px solid #BFDBFE; color:#1565C0; font-family:'Outfit',sans-serif; font-size:.75rem; font-weight:600; text-decoration:none; transition:all .18s; }
  .btn-view:hover { background:#DBEAFE; }

  .empty-state { text-align:center; padding:56px 20px; }
  .empty-icon { width:60px; height:60px; border-radius:16px; background:var(--green-pale); display:grid; place-items:center; margin:0 auto 16px; }
  .empty-icon svg { width:26px; height:26px; color:var(--green); }
  .empty-title { font-size:1rem; font-weight:700; color:var(--text); margin-bottom:6px; }
</style>

<div class="page-hero">
  <div class="hero-inner">
    <div class="hero-icon-box">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
        <path d="M3 4h14v14H3z" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M3 8h14" stroke-linecap="round"/>
      </svg>
    </div>
    <div class="hero-text">
      <div class="hero-title">{{ categorie.nom_categorie }}</div>
      <div class="hero-sub">
        <span>Détails de la catégorie</span>
        <span class="hero-chip">
          <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 1l5 4v6H1V5z" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {{ categorie.reclamations|length }} réclamation{{ categorie.reclamations|length != 1 ? 's' : '' }}
        </span>
      </div>
    </div>
    <div class="actions-group">
      <a class="btn-action-hero" href="{{ path('categorie_edit', {id: categorie.id_categorie}) }}">
        <div class="btn-action-hero-icon">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2V8a2 2 0 00-2-2h-5m-1 4l-5-5m0 0l5-5m-5 5h5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        Modifier
      </a>
      <button type="button" class="btn-action-hero danger" onclick="if(confirm('Êtes-vous sûr de vouloir supprimer cette catégorie ?')) { fetch('{{ path('categorie_delete', {id: categorie.id_categorie}) }}', {method:'POST'}).then(() => window.location.href='{{ path('categorie_index') }}'); }">
        <div class="btn-action-hero-icon">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        Supprimer
      </button>
    </div>
  </div>
</div>

<div class="details-card">
  <div class="details-grid">
    <div class="detail-item">
      <div class="detail-label">ID</div>
      <div class="detail-value">{{ categorie.id_categorie }}</div>
    </div>
    <div class="detail-item">
      <div class="detail-label">Nom</div>
      <div class="detail-value">{{ categorie.nom_categorie }}</div>
    </div>
    <div class="detail-item">
      <div class="detail-label">Description</div>
      <div class="detail-value">{{ categorie.description }}</div>
    </div>
    <div class="detail-item">
      <div class="detail-label">Date de création</div>
      <div class="detail-value">{{ categorie.date_creation ? categorie.date_creation|date('d/m/Y H:i') : 'N/A' }}</div>
    </div>
  </div>
</div>

<div class="reclamations-card">
  <div class="card-header">
    <h3 class="card-title">Réclamations associées</h3>
    <p class="card-subtitle">Liste des réclamations dans cette catégorie</p>
  </div>
  {% if categorie.reclamations %}
    <div class="reclamations-list">
      {% for reclamation in categorie.reclamations %}
        <div class="reclamation-item">
          <div>
            <a href="{{ path('reclamation_show', {id: reclamation.id_reclamation}) }}" class="reclamation-link">{{ reclamation.sujet_reclamation }}</a>
            <div class="reclamation-date">{{ reclamation.dateCreation_reclamation|date('d/m/Y H:i') }}</div>
          </div>
          <a href="{{ path('reclamation_show', {id: reclamation.id_reclamation}) }}" class="btn-view">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M10 3C5.5 3 2 7 2 10s3.5 7 8 7 8-4 8-7-3.5-7-8-7zm0 5c1.1 0 2 .9 2 2s-.9 2-2 2-2-.9-2-2 .9-2 2-2z" stroke-linecap="round"/></svg>
            Voir
          </a>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <div class="empty-state">
      <div class="empty-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M9 12h6m0 0h-6m6 0V6m0 0V6m0 6v6m0 0v6" stroke-linecap="round"/>
        </svg>
      </div>
      <div class="empty-title">Aucune réclamation</div>
      <p style="font-size:.8rem; color:var(--text-sec); margin-bottom:16px;">Cette catégorie ne contient aucune réclamation pour le moment.</p>
    </div>
  {% endif %}
</div>
{% endblock %}
