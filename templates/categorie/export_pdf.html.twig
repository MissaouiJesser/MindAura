<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <style>
    /* ══ Reset & base ═════════════════════════════════════════════════════ */
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'DejaVu Sans', Arial, sans-serif;
      font-size: 10pt;
      color: #1A1A2E;
      background: #ffffff;
    }

    /* ══ PAGE ═════════════════════════════════════════════════════════════ */
    @page {
      size: A4 portrait;
      margin: 15mm 15mm 15mm 15mm;
    }

    /* ══ HEADER ═══════════════════════════════════════════════════════════ */
    .header {
      background: linear-gradient(135deg, #1B4332 0%, #2D6A4F 55%, #7B5EA7 100%);
      border-radius: 10px;
      padding: 18px 24px;
      margin-bottom: 16px;
      position: relative;
      overflow: hidden;
      color: white;
    }

    .header::after {
      content: '';
      position: absolute;
      width: 120px; height: 120px;
      border-radius: 50%;
      background: rgba(255,255,255,.06);
      top: -30px; right: -20px;
    }

    .header h1 {
      font-size: 18pt;
      font-weight: bold;
      margin-bottom: 8px;
    }

    .header .meta {
      font-size: 9pt;
      opacity: 0.9;
    }

    /* ══ FILTRES ══════════════════════════════════════════════════════════ */
    .filters {
      background: #f8f9fa;
      border: 1px solid #e9ecef;
      border-radius: 8px;
      padding: 12px 16px;
      margin-bottom: 16px;
      font-size: 9pt;
    }

    .filters-title {
      font-weight: bold;
      margin-bottom: 6px;
      color: #1B4332;
    }

    .filter-item {
      display: inline-block;
      margin-right: 16px;
      margin-bottom: 4px;
    }

    .filter-label {
      font-weight: bold;
      margin-right: 6px;
    }

    /* ══ TABLE ════════════════════════════════════════════════════════════ */
    .table-container {
      border: 1px solid #dee2e6;
      border-radius: 8px;
      overflow: hidden;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 9pt;
    }

    thead {
      background: linear-gradient(135deg, #1B4332, #2D6A4F);
      color: white;
    }

    thead th {
      padding: 10px 12px;
      text-align: left;
      font-weight: bold;
      border-bottom: 2px solid #1B4332;
    }

    tbody tr:nth-child(even) {
      background: #f8f9fa;
    }

    tbody td {
      padding: 8px 12px;
      border-bottom: 1px solid #dee2e6;
      vertical-align: top;
    }

    .id-cell {
      font-weight: bold;
      color: #1B4332;
      width: 60px;
    }

    .name-cell {
      font-weight: bold;
      max-width: 200px;
    }

    .desc-cell {
      max-width: 300px;
      line-height: 1.3;
    }

    .date-cell {
      width: 120px;
      font-size: 8.5pt;
      color: #6c757d;
    }

    /* ══ SUMMARY ══════════════════════════════════════════════════════════ */
    .summary {
      margin-top: 16px;
      padding: 12px 16px;
      background: #e8f5e8;
      border: 1px solid #c3e6c3;
      border-radius: 8px;
      font-size: 9pt;
    }

    .summary strong {
      color: #1B4332;
    }
  </style>
</head>
<body>
  <!-- Header -->
  <div class="header">
    <h1>Liste des catégories</h1>
    <div class="meta">
      Exporté le {{ exportedAt|date('d/m/Y à H:i') }}
    </div>
  </div>

  <!-- Filtres actifs -->
  {% if filters.search %}
  <div class="filters">
    <div class="filters-title">Filtres appliqués :</div>
    {% if filters.search %}
    <div class="filter-item">
      <span class="filter-label">Recherche :</span>
      "{{ filters.search }}"
    </div>
    {% endif %}
  </div>
  {% endif %}

  <!-- Table -->
  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Nom de la catégorie</th>
          <th>Description</th>
          <th>Date de création</th>
        </tr>
      </thead>
      <tbody>
        {% for row in rows %}
        <tr>
          <td class="id-cell">{{ row.id }}</td>
          <td class="name-cell">{{ row.nom }}</td>
          <td class="desc-cell">{{ row.description }}</td>
          <td class="date-cell">{{ row.date }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <!-- Summary -->
  <div class="summary">
    <strong>{{ rows|length }}</strong> catégorie{{ rows|length != 1 ? 's' : '' }} au total
  </div>
</body>
</html>