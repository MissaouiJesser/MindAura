<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>MindAura — Authenticator : identifiez votre compte</title>
  <link rel="icon" type="image/png" href="{{ asset('images/logo.png') }}"/>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,700;1,400&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --green:        #1B4332;
      --green-mid:    #2D6A4F;
      --green-light:  #52B788;
      --green-pale:   #D8F3DC;
      --green-xpale:  #EBF7F0;
      --violet:       #7B5EA7;
      --violet-mid:   #9575C6;
      --violet-pale:  rgba(123,94,167,.12);
      --violet-xpale: #EDE9F6;
      --bg:           #F0F4F8;
      --white:        #FFFFFF;
      --text:         #1A1A2E;
      --text-sec:     #5A6475;
      --border:       #D5DCE6;
      --shadow:       0 24px 64px rgba(27,67,50,.18), 0 0 0 1px rgba(255,255,255,.7);
      --radius:       22px;
    }

    html, body {
      height: 100%;
      font-family: 'Outfit', sans-serif;
      background: var(--bg);
      color: var(--text);
      overflow: hidden;
    }

    .bg-canvas {
      position: fixed; inset: 0; z-index: 0;
      background: url("{{ asset('images/background.jpg') }}") center center / cover no-repeat;
    }
    .bg-canvas::before {
      content: '';
      position: absolute; inset: 0;
      background: rgba(0,0,0,0.38);
    }

    .wrapper {
      position: relative; z-index: 1; height: 100vh;
      display: flex; align-items: center; justify-content: center;
      padding: 16px;
    }

    .card {
      width: 100%; max-width: 900px; height: 540px;
      display: flex; border-radius: var(--radius); overflow: hidden;
      box-shadow: var(--shadow);
      animation: cardIn .7s cubic-bezier(.22,1,.36,1) both;
    }
    @keyframes cardIn {
      from { opacity: 0; transform: translateY(30px) scale(.95); }
      to   { opacity: 1; transform: none; }
    }

    /* ══ LEFT PANEL (VIOLET pour distinguer du flux email) ══ */
    .panel-left {
      flex: 0 0 290px;
      background: linear-gradient(160deg, var(--violet) 0%, #5D4888 100%);
      color: var(--white);
      padding: 44px 34px;
      display: flex; flex-direction: column; justify-content: space-between;
      position: relative; overflow: hidden;
    }
    .panel-left::before {
      content: ''; position: absolute; top: -65px; right: -65px;
      width: 240px; height: 240px; border-radius: 50%;
      border: 48px solid rgba(255,255,255,.07);
    }
    .panel-left::after {
      content: ''; position: absolute; bottom: -42px; left: -42px;
      width: 180px; height: 180px; border-radius: 50%;
      border: 32px solid rgba(255,255,255,.05);
    }

    .brand {
      display: flex; flex-direction: column; align-items: center;
      gap: 12px; position: relative; z-index: 2;
    }
    .logo-img {
      width: 130px; height: 130px; object-fit: contain;
      filter: drop-shadow(0 6px 18px rgba(0,0,0,.3));
      transition: transform .35s ease;
    }
    .logo-img:hover { transform: scale(1.06) rotate(-2deg); }
    .brand-name {
      font-family: 'Playfair Display', serif; font-size: 1.45rem; letter-spacing: .5px;
      background: linear-gradient(135deg, #fff 25%, var(--violet-xpale));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }

    .panel-content { position: relative; z-index: 2; text-align: center; }

    .phone-anim {
      width: 68px; height: 68px;
      background: rgba(255,255,255,.12);
      border-radius: 50%; display: flex; align-items: center; justify-content: center;
      margin: 0 auto 16px;
      animation: phonePulse 3s ease-in-out infinite;
    }
    @keyframes phonePulse {
      0%,100% { box-shadow: 0 0 0 0 rgba(255,255,255,.15); }
      50%      { box-shadow: 0 0 0 14px rgba(255,255,255,.0); }
    }
    .phone-anim svg { width: 32px; height: 32px; fill: none; stroke: #fff; stroke-width: 1.8; }

    .panel-tagline {
      font-family: 'Playfair Display', serif; font-size: 1.32rem; line-height: 1.3;
      margin-bottom: 10px;
    }
    .panel-desc { font-size: .83rem; opacity: .7; line-height: 1.65; }

    .panel-bottom { position: relative; z-index: 2; text-align: center; }
    .back-link {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: .8rem; opacity: .6; color: var(--white); text-decoration: none;
      transition: opacity .25s;
    }
    .back-link:hover { opacity: 1; }
    .back-link svg { width: 14px; height: 14px; }

    /* ══ RIGHT PANEL ══ */
    .panel-right {
      flex: 1; background: var(--white);
      display: flex; flex-direction: column; justify-content: center;
      padding: 52px 52px;
      position: relative; overflow: hidden;
    }
    .panel-right::before {
      content: '';
      position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, var(--green) 0%, var(--green-light) 50%, var(--violet) 100%);
    }
    .panel-right::after {
      content: '';
      position: absolute; bottom: -60px; right: -60px;
      width: 200px; height: 200px;
      border-radius: 50%;
      background: radial-gradient(circle, var(--violet-xpale) 0%, transparent 70%);
      pointer-events: none;
    }

    .form-header { margin-bottom: 32px; }
    .form-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.7rem; font-weight: 700;
      color: var(--text); margin-bottom: 6px;
    }
    .form-subtitle { font-size: .875rem; color: var(--text-sec); line-height: 1.55; }

    /* ── FIELD ── */
    .field-wrap { margin-bottom: 22px; }
    .field-label {
      display: block; font-size: .82rem; font-weight: 600;
      color: var(--text); margin-bottom: 7px; letter-spacing: .2px;
    }
    .input-wrap {
      display: flex; align-items: center;
      background: var(--bg); border: 1.5px solid var(--border);
      border-radius: 12px; overflow: hidden;
      transition: border-color .25s, box-shadow .25s;
    }
    .input-wrap:focus-within {
      border-color: var(--violet);
      box-shadow: 0 0 0 3px rgba(123,94,167,.12);
    }
    .input-wrap.is-invalid {
      border-color: #DC2626;
      box-shadow: 0 0 0 3px rgba(220,38,38,.1);
    }
    .input-icon {
      padding: 0 13px; color: var(--text-sec);
      display: flex; align-items: center; flex-shrink: 0;
    }
    .input-icon svg { width: 16px; height: 16px; }
    .input-wrap input {
      flex: 1; border: none; background: transparent;
      padding: 13px 14px 13px 0;
      font-family: 'Outfit', sans-serif; font-size: .9rem; color: var(--text);
      outline: none;
    }
    .input-wrap input::placeholder { color: var(--text-sec); opacity: .65; }

    .field-error {
      font-size: .78rem; color: #DC2626;
      margin-top: 6px; display: none; align-items: center; gap: 4px;
    }
    .field-error.show { display: flex; animation: errIn .25s ease; }
    @keyframes errIn { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }

    /* ── BTN ── */
    .btn-submit {
      width: 100%; padding: 14px;
      background: linear-gradient(135deg, var(--violet) 0%, var(--violet-mid) 100%);
      color: #fff; border: none; border-radius: 12px;
      font-family: 'Outfit', sans-serif; font-size: .95rem; font-weight: 600;
      cursor: pointer; letter-spacing: .3px;
      transition: transform .2s, box-shadow .2s, opacity .2s;
      box-shadow: 0 4px 18px rgba(123,94,167,.28);
      display: flex; align-items: center; justify-content: center; gap: 8px;
      position: relative; overflow: hidden;
    }
    .btn-submit::after {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(135deg, transparent 0%, rgba(255,255,255,.12) 100%);
      opacity: 0; transition: opacity .25s;
    }
    .btn-submit:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(123,94,167,.36); }
    .btn-submit:hover::after { opacity: 1; }
    .btn-submit:active { transform: translateY(0); }
    .btn-submit svg { width: 17px; height: 17px; }

    .btn-submit.loading { opacity: .75; pointer-events: none; }
    .btn-submit.loading .btn-text { opacity: 0; }
    .btn-submit.loading::before {
      content: '';
      position: absolute;
      width: 20px; height: 20px;
      border: 2.5px solid rgba(255,255,255,.4);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin .7s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ── DIVIDER / LINKS ── */
    .divider {
      display: flex; align-items: center; gap: 12px;
      margin: 20px 0;
    }
    .divider-line { flex: 1; height: 1px; background: var(--border); }
    .divider-text { font-size: .75rem; color: var(--text-sec); white-space: nowrap; }

    .login-link-row { text-align: center; }
    .login-link {
      font-size: .84rem; color: var(--text-sec); text-decoration: none;
      display: inline-flex; align-items: center; gap: 5px;
      transition: color .2s;
    }
    .login-link:hover { color: var(--violet); }
    .login-link svg { width: 14px; height: 14px; }

    /* ── ALERT ERROR ── */
    .alert-error {
      background: #FEF2F2; border: 1px solid #FECACA;
      border-radius: 10px; padding: 12px 16px;
      display: flex; align-items: center; gap: 10px;
      margin-bottom: 20px; font-size: .85rem; color: #DC2626;
      animation: errIn .25s ease;
    }
    .alert-error svg { width: 17px; height: 17px; flex-shrink: 0; }

    /* ── STEP INDICATOR ── */
    .step-indicator {
      display: flex; align-items: center; gap: 8px;
      margin-bottom: 26px;
    }
    .step-item {
      display: flex; align-items: center; gap: 6px;
      font-size: .75rem; font-weight: 600;
    }
    .step-dot {
      width: 22px; height: 22px; border-radius: 50%;
      background: var(--bg); border: 1.5px solid var(--border);
      display: flex; align-items: center; justify-content: center;
      font-size: .68rem; color: var(--text-sec);
      transition: all .3s;
    }
    .step-item.active .step-dot {
      background: var(--violet); border-color: var(--violet);
      color: #fff;
    }
    .step-label { color: var(--text-sec); }
    .step-item.active .step-label { color: var(--violet); }
    .step-connector { flex: 1; height: 1px; background: var(--border); }
  </style>
</head>
<body>

<div class="bg-canvas"></div>

<div class="wrapper">
  <div class="card">

    <!-- LEFT PANEL -->
    <div class="panel-left">
      <div class="brand">
        <img src="{{ asset('images/logo.png') }}" alt="MindAura" class="logo-img"/>
        <span class="brand-name">MindAura</span>
      </div>

      <div class="panel-content">
        <div class="phone-anim">
          <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
            <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
            <line x1="12" y1="18" x2="12.01" y2="18"/>
          </svg>
        </div>
        <div class="panel-tagline">Authentification<br/>sans e-mail</div>
        <div class="panel-desc">Votre application Google Authenticator est votre clé de confiance. Indiquez-nous votre adresse et gardez votre téléphone à portée.</div>
      </div>

      <div class="panel-bottom">
        <a href="{{ path('app_forgot_password') }}" class="back-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 5l-7 7 7 7"/>
          </svg>
          Changer de méthode
        </a>
      </div>
    </div>

    <!-- RIGHT PANEL -->
    <div class="panel-right">

      <div class="form-header">
        <div class="step-indicator">
          <div class="step-item active">
            <div class="step-dot">1</div>
            <span class="step-label">Identifier le compte</span>
          </div>
          <div class="step-connector"></div>
          <div class="step-item">
            <div class="step-dot">2</div>
            <span class="step-label">Saisir le code</span>
          </div>
          <div class="step-connector"></div>
          <div class="step-item">
            <div class="step-dot">3</div>
            <span class="step-label">Nouveau mot de passe</span>
          </div>
        </div>
        <div class="form-title">Authenticator · Étape 1/3</div>
        <div class="form-subtitle">Commencez par indiquer l'adresse e-mail liée à votre compte MindAura. Nous vous demanderons ensuite le code de votre application d'authentification.</div>
      </div>

      {% if error %}
        <div class="alert-error">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
          {{ error }}
        </div>
      {% endif %}

      <form method="POST" action="{{ path('app_forgot_password_totp') }}" id="totpEmailForm" novalidate>
        <div class="field-wrap">
          <label for="email" class="field-label">Adresse e-mail du compte</label>
          <div class="input-wrap" id="wrap-email">
            <span class="input-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
            </span>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="votre@email.com"
              autocomplete="email"
              autofocus
              value="{{ app.request.request.get('email', '') }}"
            />
          </div>
          <span class="field-error" id="err-email"></span>
        </div>

        <button type="submit" class="btn-submit" id="submitBtn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-text">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
          <span class="btn-text">Continuer vers le code</span>
        </button>
      </form>

      <div class="divider">
        <div class="divider-line"></div>
        <span class="divider-text">ou</span>
        <div class="divider-line"></div>
      </div>

      <div class="login-link-row">
        <a href="{{ path('app_forgot_password_email') }}" class="login-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
          Préférez-vous recevoir un e-mail ?
        </a>
      </div>

      <div style="margin-top:12px;" class="login-link-row">
        <a href="{{ path('app_login') }}" class="login-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 5l-7 7 7 7"/>
          </svg>
          Retour à la connexion
        </a>
      </div>

    </div>
    <!-- /RIGHT PANEL -->

  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const form      = document.getElementById('totpEmailForm');
  const submitBtn = document.getElementById('submitBtn');
  if (!form) return;

  form.addEventListener('submit', function (e) {
    const emailInput = document.getElementById('email');
    const wrapEmail  = document.getElementById('wrap-email');
    const errEmail   = document.getElementById('err-email');
    const val        = emailInput.value.trim();

    wrapEmail.classList.remove('is-invalid');
    errEmail.textContent = '';
    errEmail.classList.remove('show');

    let ok = true;

    if (!val) {
      wrapEmail.classList.add('is-invalid');
      errEmail.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg> L\'adresse e-mail est obligatoire.';
      errEmail.classList.add('show');
      ok = false;
    } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) {
      wrapEmail.classList.add('is-invalid');
      errEmail.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg> L\'adresse e-mail n\'est pas valide.';
      errEmail.classList.add('show');
      ok = false;
    }

    if (!ok) {
      e.preventDefault();
      return;
    }

    submitBtn.classList.add('loading');
  });
});
</script>
</body>
</html>
