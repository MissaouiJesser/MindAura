<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>MindAura — Nouveau mot de passe</title>
  <link rel="icon" type="image/png" href="{{ asset('images/logo.png') }}"/>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,700;1,400&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --green:        #1B4332;
      --green-mid:    #2D6A4F;
      --green-light:  #52B788;
      --green-pale:   #D8F3DC;
      --green-xpale:  #EBF7F0;
      --violet:       #7B5EA7;
      --bg:           #F0F4F8;
      --white:        #FFFFFF;
      --text:         #1A1A2E;
      --text-sec:     #5A6475;
      --border:       #D5DCE6;
      --shadow:       0 24px 64px rgba(27,67,50,.18), 0 0 0 1px rgba(255,255,255,.7);
      --radius:       22px;
    }
    html, body {
      height: 100%; font-family: 'Outfit', sans-serif;
      background: var(--bg); color: var(--text); overflow: hidden;
    }
    .bg-canvas {
      position: fixed; inset: 0; z-index: 0;
      background: url("{{ asset('images/background.jpg') }}") center center / cover no-repeat;
    }
    .bg-canvas::before { content: ''; position: absolute; inset: 0; background: rgba(0,0,0,0.38); }
    .wrapper {
      position: relative; z-index: 1; height: 100vh;
      display: flex; align-items: center; justify-content: center; padding: 16px;
    }
    .card {
      width: 100%; max-width: 900px; min-height: 560px;
      display: flex; border-radius: var(--radius); overflow: hidden;
      box-shadow: var(--shadow);
      animation: cardIn .7s cubic-bezier(.22,1,.36,1) both;
    }
    @keyframes cardIn {
      from { opacity: 0; transform: translateY(30px) scale(.95); }
      to   { opacity: 1; transform: none; }
    }
    .panel-left {
      flex: 0 0 290px;
      background: linear-gradient(160deg, var(--green) 0%, var(--green-mid) 100%);
      color: var(--white); padding: 44px 34px;
      display: flex; flex-direction: column; justify-content: space-between;
      position: relative; overflow: hidden;
    }
    .panel-left::before {
      content: ''; position: absolute; top: -65px; right: -65px;
      width: 240px; height: 240px; border-radius: 50%;
      border: 48px solid rgba(255,255,255,.07);
    }
    .panel-left::after {
      content: ''; position: absolute; bottom: -42px; left: -42px;
      width: 180px; height: 180px; border-radius: 50%;
      border: 32px solid rgba(255,255,255,.05);
    }
    .brand {
      display: flex; flex-direction: column; align-items: center;
      gap: 12px; position: relative; z-index: 2;
    }
    .logo-img {
      width: 120px; height: 120px; object-fit: contain;
      filter: drop-shadow(0 6px 18px rgba(0,0,0,.3)); transition: transform .35s ease;
    }
    .logo-img:hover { transform: scale(1.06) rotate(-2deg); }
    .brand-name {
      font-family: 'Playfair Display', serif; font-size: 1.45rem;
      background: linear-gradient(135deg, #fff 25%, var(--green-pale));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }
    .panel-content { position: relative; z-index: 2; text-align: center; }
    .shield-anim {
      width: 68px; height: 68px; background: rgba(255,255,255,.12); border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 16px; animation: shieldPulse 3s ease-in-out infinite;
    }
    @keyframes shieldPulse {
      0%,100% { box-shadow: 0 0 0 0 rgba(255,255,255,.15); }
      50%      { box-shadow: 0 0 0 14px rgba(255,255,255,.0); }
    }
    .shield-anim svg { width: 32px; height: 32px; fill: none; stroke: #fff; stroke-width: 1.8; }
    .panel-tagline { font-family: 'Playfair Display', serif; font-size: 1.32rem; line-height: 1.3; margin-bottom: 10px; }
    .panel-desc { font-size: .83rem; opacity: .7; line-height: 1.65; }
    .tips-list { list-style: none; margin-top: 16px; text-align: left; }
    .tips-list li { font-size: .77rem; opacity: .65; padding: 4px 0; display: flex; align-items: center; gap: 7px; }
    .tip-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--green-pale); flex-shrink: 0; }
    .panel-bottom { position: relative; z-index: 2; text-align: center; }
    .back-link {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: .8rem; opacity: .6; color: var(--white); text-decoration: none; transition: opacity .25s;
    }
    .back-link:hover { opacity: 1; }
    .panel-right {
      flex: 1; background: var(--white);
      display: flex; flex-direction: column; justify-content: center;
      padding: 48px 52px; position: relative; overflow: hidden;
    }
    .panel-right::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, var(--green) 0%, var(--green-light) 50%, var(--violet) 100%);
    }
    .panel-right::after {
      content: ''; position: absolute; bottom: -60px; right: -60px;
      width: 200px; height: 200px; border-radius: 50%;
      background: radial-gradient(circle, var(--green-xpale) 0%, transparent 70%);
      pointer-events: none;
    }
    .step-indicator { display: flex; align-items: center; gap: 8px; margin-bottom: 26px; }
    .step-item { display: flex; align-items: center; gap: 6px; font-size: .75rem; font-weight: 600; }
    .step-dot {
      width: 22px; height: 22px; border-radius: 50%;
      background: var(--bg); border: 1.5px solid var(--border);
      display: flex; align-items: center; justify-content: center;
      font-size: .68rem; color: var(--text-sec);
    }
    .step-item.done .step-dot  { background: var(--green-xpale); border-color: var(--green); color: var(--green); }
    .step-item.active .step-dot { background: var(--green); border-color: var(--green); color: #fff; }
    .step-label { color: var(--text-sec); }
    .step-item.done .step-label, .step-item.active .step-label { color: var(--green); }
    .step-connector { flex: 1; height: 1px; background: var(--border); }
    .form-title { font-family: 'Playfair Display', serif; font-size: 1.65rem; font-weight: 700; color: var(--text); margin-bottom: 6px; }
    .form-subtitle { font-size: .875rem; color: var(--text-sec); line-height: 1.55; margin-bottom: 24px; }
    .field-wrap { margin-bottom: 18px; }
    .field-label { display: block; font-size: .82rem; font-weight: 600; color: var(--text); margin-bottom: 7px; }
    .input-wrap {
      display: flex; align-items: center;
      background: var(--bg); border: 1.5px solid var(--border);
      border-radius: 12px; overflow: hidden;
      transition: border-color .25s, box-shadow .25s;
    }
    .input-wrap:focus-within { border-color: var(--green); box-shadow: 0 0 0 3px rgba(27,67,50,.1); }
    .input-wrap.is-invalid   { border-color: #DC2626; box-shadow: 0 0 0 3px rgba(220,38,38,.1); }
    .input-wrap.is-valid     { border-color: var(--green); }
    .input-icon { padding: 0 13px; color: var(--text-sec); display: flex; align-items: center; flex-shrink: 0; }
    .input-icon svg { width: 16px; height: 16px; }
    .input-wrap input {
      flex: 1; border: none; background: transparent; padding: 13px 0;
      font-family: 'Outfit', sans-serif; font-size: .9rem; color: var(--text); outline: none;
    }
    .input-wrap input::placeholder { color: var(--text-sec); opacity: .65; }
    .eye-btn {
      background: none; border: none; cursor: pointer; padding: 0 13px;
      color: var(--text-sec); display: flex; align-items: center; transition: color .2s;
    }
    .eye-btn:hover { color: var(--green); }
    .eye-btn svg { width: 15px; height: 15px; }
    .field-error { font-size: .78rem; color: #DC2626; margin-top: 6px; display: none; align-items: center; gap: 4px; }
    .field-error.show { display: flex; animation: errIn .25s ease; }
    @keyframes errIn { from { opacity:0;transform:translateY(-4px); } to { opacity:1;transform:none; } }
    .strength-bar-wrap { margin-top: 10px; }
    .strength-segs { display: flex; gap: 4px; }
    .strength-seg { flex: 1; height: 4px; border-radius: 99px; background: var(--border); transition: background .3s, transform .3s; }
    .strength-info { display: flex; justify-content: flex-end; margin-top: 5px; }
    .strength-label { font-size: .72rem; color: var(--text-sec); font-weight: 600; transition: color .3s; }
    #confirmMsg { font-size: .78rem; margin-top: 6px; display: none; }
    #confirmMsg.show { display: flex; align-items: center; gap: 4px; }
    .btn-submit {
      width: 100%; padding: 14px; margin-top: 22px;
      background: linear-gradient(135deg, var(--green) 0%, var(--green-mid) 100%);
      color: #fff; border: none; border-radius: 12px;
      font-family: 'Outfit', sans-serif; font-size: .95rem; font-weight: 600;
      cursor: pointer; letter-spacing: .3px; transition: transform .2s, box-shadow .2s;
      box-shadow: 0 4px 18px rgba(27,67,50,.28);
      display: flex; align-items: center; justify-content: center; gap: 8px;
      position: relative; overflow: hidden;
    }
    .btn-submit:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(27,67,50,.36); }
    .btn-submit:active { transform: translateY(0); }
    .btn-submit svg { width: 17px; height: 17px; }
    .btn-submit.loading { opacity: .75; pointer-events: none; }
    .btn-submit.loading .btn-text { opacity: 0; }
    .btn-submit.loading::before {
      content: ''; position: absolute; width: 20px; height: 20px;
      border: 2.5px solid rgba(255,255,255,.4); border-top-color: #fff;
      border-radius: 50%; animation: spin .7s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .success-box { text-align: center; animation: fadeUp .5s ease both; }
    @keyframes fadeUp { from { opacity:0;transform:translateY(18px); } to { opacity:1;transform:none; } }
    .success-icon {
      width: 80px; height: 80px;
      background: linear-gradient(135deg, var(--green-xpale), var(--green-pale));
      border-radius: 50%; display: flex; align-items: center; justify-content: center;
      margin: 0 auto 22px; animation: iconPop .5s .1s cubic-bezier(.34,1.56,.64,1) both;
    }
    @keyframes iconPop { from { transform:scale(0);opacity:0; } to { transform:scale(1);opacity:1; } }
    .success-icon svg { width: 36px; height: 36px; stroke: var(--green); stroke-width: 2.2; fill: none; }
    .success-title { font-family: 'Playfair Display', serif; font-size: 1.45rem; color: var(--text); margin-bottom: 10px; }
    .success-text { font-size: .875rem; color: var(--text-sec); line-height: 1.65; margin-bottom: 28px; }
  </style>
</head>
<body>
<div class="bg-canvas"></div>
<div class="wrapper">
  <div class="card">

    <div class="panel-left">
      <div class="brand">
        <img src="{{ asset('images/logo.png') }}" alt="MindAura" class="logo-img"/>
        <span class="brand-name">MindAura</span>
      </div>
      <div class="panel-content">
        <div class="shield-anim">
          <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <div class="panel-tagline">Sécurisez<br/>votre compte</div>
        <div class="panel-desc">Choisissez un mot de passe robuste pour protéger votre espace bien-être.</div>
        <ul class="tips-list">
          <li><span class="tip-dot"></span>Au moins 8 caractères</li>
          <li><span class="tip-dot"></span>Une lettre majuscule</li>
          <li><span class="tip-dot"></span>Un chiffre</li>
          <li><span class="tip-dot"></span>Évitez les infos personnelles</li>
        </ul>
      </div>
      <div class="panel-bottom">
        <a href="{{ path('app_login') }}" class="back-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
            <path d="M19 12H5M12 5l-7 7 7 7"/>
          </svg>
          Retour à la connexion
        </a>
      </div>
    </div>

    <div class="panel-right">

      {% if success is defined and success %}
        <div class="success-box">
          <div class="success-icon">
            <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          </div>
          <div class="success-title">Mot de passe mis à jour !</div>
          <div class="success-text">
            Votre nouveau mot de passe a été enregistré avec succès.<br/>
            Vous pouvez maintenant vous connecter à votre compte MindAura.
          </div>
          <a href="{{ path('app_login') }}" style="text-decoration:none;">
            <button class="btn-submit" style="max-width:260px;margin:0 auto;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/>
              </svg>
              <span class="btn-text">Se connecter</span>
            </button>
          </a>
        </div>

      {% else %}
        <div class="step-indicator">
          <div class="step-item done">
            <div class="step-dot">✓</div>
            <span class="step-label">E-mail envoyé</span>
          </div>
          <div class="step-connector"></div>
          <div class="step-item done">
            <div class="step-dot">✓</div>
            <span class="step-label">Lien reçu</span>
          </div>
          <div class="step-connector"></div>
          <div class="step-item active">
            <div class="step-dot">3</div>
            <span class="step-label">Nouveau mot de passe</span>
          </div>
        </div>

        <div class="form-title">Nouveau mot de passe</div>
        <div class="form-subtitle">Choisissez un mot de passe sécurisé pour votre compte MindAura.</div>

        <form method="POST" action="{{ path('app_reset_password', {token: token}) }}" id="resetForm" novalidate>

          <div class="field-wrap">
            <label for="password" class="field-label">Nouveau mot de passe</label>
            <div class="input-wrap {% if fieldErrors is defined and fieldErrors.password is defined %}is-invalid{% endif %}" id="wrap-password">
              <span class="input-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
              </span>
              <input type="password" id="password" name="password"
                     placeholder="Minimum 8 caractères" autocomplete="new-password"
                     oninput="checkStrength(this); checkConfirm();"/>
              <button type="button" class="eye-btn" onclick="toggleEye('password', this)">
                <svg id="eyeShow-password" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                </svg>
                <svg id="eyeHide-password" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none">
                  <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                  <line x1="1" y1="1" x2="23" y2="23"/>
                </svg>
              </button>
            </div>
            <div class="strength-bar-wrap">
              <div class="strength-segs">
                <div class="strength-seg" id="seg1"></div>
                <div class="strength-seg" id="seg2"></div>
                <div class="strength-seg" id="seg3"></div>
                <div class="strength-seg" id="seg4"></div>
              </div>
              <div class="strength-info">
                <span class="strength-label" id="strengthLabel">Force</span>
              </div>
            </div>
            <span class="field-error {% if fieldErrors is defined and fieldErrors.password is defined %}show{% endif %}" id="err-password">
              {% if fieldErrors is defined and fieldErrors.password is defined %}{{ fieldErrors.password }}{% endif %}
            </span>
          </div>

          <div class="field-wrap">
            <label for="password_confirm" class="field-label">Confirmer le mot de passe</label>
            <div class="input-wrap {% if fieldErrors is defined and fieldErrors.password_confirm is defined %}is-invalid{% endif %}" id="wrap-confirm">
              <span class="input-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
              </span>
              <input type="password" id="password_confirm" name="password_confirm"
                     placeholder="Répétez le mot de passe" autocomplete="new-password"
                     oninput="checkConfirm()"/>
              <button type="button" class="eye-btn" onclick="toggleEye('password_confirm', this)">
                <svg id="eyeShow-password_confirm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                </svg>
                <svg id="eyeHide-password_confirm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none">
                  <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                  <line x1="1" y1="1" x2="23" y2="23"/>
                </svg>
              </button>
            </div>
            <span id="confirmMsg"></span>
            <span class="field-error {% if fieldErrors is defined and fieldErrors.password_confirm is defined %}show{% endif %}">
              {% if fieldErrors is defined and fieldErrors.password_confirm is defined %}{{ fieldErrors.password_confirm }}{% endif %}
            </span>
          </div>

          <button type="submit" class="btn-submit" id="submitBtn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-text">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            <span class="btn-text">Réinitialiser le mot de passe</span>
          </button>

        </form>
      {% endif %}

    </div>
  </div>
</div>
<script>
function toggleEye(fieldId, btn) {
  const inp = document.getElementById(fieldId);
  const show = document.getElementById('eyeShow-' + fieldId);
  const hide = document.getElementById('eyeHide-' + fieldId);
  if (inp.type === 'password') { inp.type = 'text'; show.style.display='none'; hide.style.display='block'; }
  else { inp.type = 'password'; show.style.display='block'; hide.style.display='none'; }
}
const SEG_C = ['#EF4444','#F97316','#EAB308','#1B4332'];
const SEG_L = ['Faible','Moyen','Bien','Fort'];
function checkStrength(inp) {
  const v = inp.value; let s = 0;
  if (v.length >= 8) s++; if (/[A-Z]/.test(v)) s++; if (/[0-9]/.test(v)) s++; if (/[^A-Za-z0-9]/.test(v)) s++;
  const label = document.getElementById('strengthLabel');
  for (let i=1;i<=4;i++) {
    const seg = document.getElementById('seg'+i);
    seg.style.background = i<=s ? SEG_C[s-1] : '#D5DCE6';
    seg.style.transform  = i<=s ? 'scaleY(1.4)' : 'scaleY(1)';
  }
  if (label) { label.textContent = s>0 ? SEG_L[s-1] : 'Force'; label.style.color = s>0 ? SEG_C[s-1] : 'var(--text-sec)'; }
}
function checkConfirm() {
  const pass=document.getElementById('password').value;
  const confirm=document.getElementById('password_confirm').value;
  const msg=document.getElementById('confirmMsg');
  const wrap=document.getElementById('wrap-confirm');
  if (!confirm) { msg.classList.remove('show'); wrap.classList.remove('is-invalid','is-valid'); return; }
  if (pass===confirm) { msg.textContent='✓ Les mots de passe correspondent'; msg.style.color='var(--green)'; msg.classList.add('show'); wrap.classList.remove('is-invalid'); wrap.classList.add('is-valid'); }
  else { msg.textContent='✗ Ne correspondent pas'; msg.style.color='#DC2626'; msg.classList.add('show'); wrap.classList.add('is-invalid'); wrap.classList.remove('is-valid'); }
}
document.addEventListener('DOMContentLoaded', function () {
  const form = document.getElementById('resetForm');
  if (!form) return;
  form.addEventListener('submit', function (e) {
    const pass=document.getElementById('password').value;
    const confirm=document.getElementById('password_confirm').value;
    const wrapP=document.getElementById('wrap-password');
    const errP=document.getElementById('err-password');
    wrapP.classList.remove('is-invalid');
    if (errP) { errP.textContent=''; errP.classList.remove('show'); }
    let ok=true;
    if (pass.length<8) { wrapP.classList.add('is-invalid'); if(errP){errP.textContent='Au moins 8 caractères requis.';errP.classList.add('show');} ok=false; }
    else if (!/[A-Z]/.test(pass)) { wrapP.classList.add('is-invalid'); if(errP){errP.textContent='Au moins une majuscule requise.';errP.classList.add('show');} ok=false; }
    else if (!/[0-9]/.test(pass)) { wrapP.classList.add('is-invalid'); if(errP){errP.textContent='Au moins un chiffre requis.';errP.classList.add('show');} ok=false; }
    if (ok && pass!==confirm) { document.getElementById('wrap-confirm').classList.add('is-invalid'); ok=false; }
    if (!ok) { e.preventDefault(); return; }
    document.getElementById('submitBtn').classList.add('loading');
  });
});
</script>
</body>
</html>
