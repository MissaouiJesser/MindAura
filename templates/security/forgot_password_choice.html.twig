<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>MindAura — Choisir la méthode de réinitialisation</title>
  <link rel="icon" type="image/png" href="{{ asset('images/logo.png') }}"/>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;1,400&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --green:        #1B4332;
      --green-mid:    #2D6A4F;
      --green-light:  #52B788;
      --green-pale:   #D8F3DC;
      --green-xpale:  #EBF7F0;
      --violet:       #7B5EA7;
      --violet-mid:   #9575C6;
      --violet-light: rgba(123,94,167,.12);
      --violet-xpale: #EDE9F6;
      --bg:           #F0F4F8;
      --white:        #FFFFFF;
      --text:         #1A1A2E;
      --text-sec:     #5A6475;
      --border:       #D5DCE6;
      --shadow:       0 24px 64px rgba(27,67,50,.18), 0 0 0 1px rgba(255,255,255,.7);
      --radius:       22px;
    }

    html, body {
      min-height: 100vh;
      font-family: 'Outfit', sans-serif;
      background: var(--bg);
      color: var(--text);
      overflow-x: hidden;
    }

    /* ── BACKGROUND ── */
    .bg-canvas {
      position: fixed; inset: 0; z-index: 0;
      background: url("{{ asset('images/background.jpg') }}") center center / cover no-repeat;
    }
    .bg-canvas::before {
      content: '';
      position: absolute; inset: 0;
      background: rgba(0,0,0,0.38);
    }

    /* ── WRAPPER ── */
    .wrapper {
      position: relative; z-index: 1; min-height: 100vh;
      display: flex; align-items: center; justify-content: center;
      padding: 24px 16px;
    }

    /* ── CARD ── */
    .card {
      width: 100%; max-width: 960px;
      display: flex; border-radius: var(--radius); overflow: hidden;
      box-shadow: var(--shadow);
      animation: cardIn .7s cubic-bezier(.22,1,.36,1) both;
    }
    @keyframes cardIn {
      from { opacity: 0; transform: translateY(30px) scale(.95); }
      to   { opacity: 1; transform: none; }
    }

    /* ══ LEFT PANEL ══ */
    .panel-left {
      flex: 0 0 300px;
      background: linear-gradient(160deg, var(--green) 0%, var(--green-mid) 100%);
      color: var(--white);
      padding: 44px 34px;
      display: flex; flex-direction: column; justify-content: space-between;
      position: relative; overflow: hidden;
    }
    .panel-left::before {
      content: ''; position: absolute; top: -65px; right: -65px;
      width: 240px; height: 240px; border-radius: 50%;
      border: 48px solid rgba(255,255,255,.07);
    }
    .panel-left::after {
      content: ''; position: absolute; bottom: -42px; left: -42px;
      width: 180px; height: 180px; border-radius: 50%;
      border: 32px solid rgba(255,255,255,.05);
    }

    .brand {
      display: flex; flex-direction: column; align-items: center;
      gap: 12px; position: relative; z-index: 2;
    }
    .logo-img {
      width: 130px; height: 130px; object-fit: contain;
      filter: drop-shadow(0 6px 18px rgba(0,0,0,.3));
      transition: transform .35s ease;
    }
    .logo-img:hover { transform: scale(1.06) rotate(-2deg); }
    .brand-name {
      font-family: 'Playfair Display', serif; font-size: 1.45rem; letter-spacing: .5px;
      background: linear-gradient(135deg, #fff 25%, var(--green-pale));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }

    .panel-content { position: relative; z-index: 2; text-align: center; }

    .shield-anim {
      width: 68px; height: 68px;
      background: rgba(255,255,255,.12);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 16px;
      animation: shieldPulse 3s ease-in-out infinite;
    }
    @keyframes shieldPulse {
      0%,100% { box-shadow: 0 0 0 0 rgba(255,255,255,.15); }
      50%     { box-shadow: 0 0 0 14px rgba(255,255,255,0); }
    }
    .shield-anim svg { width: 34px; height: 34px; fill: none; stroke: #fff; stroke-width: 1.8; }

    .panel-tagline {
      font-family: 'Playfair Display', serif; font-size: 1.32rem; line-height: 1.3;
      margin-bottom: 10px;
    }
    .panel-desc { font-size: .83rem; opacity: .75; line-height: 1.65; }

    .panel-bottom { position: relative; z-index: 2; text-align: center; }
    .back-link {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: .8rem; opacity: .6; color: var(--white); text-decoration: none;
      transition: opacity .25s;
    }
    .back-link:hover { opacity: 1; }
    .back-link svg { width: 14px; height: 14px; }

    /* ══ RIGHT PANEL ══ */
    .panel-right {
      flex: 1; background: var(--white);
      display: flex; flex-direction: column; justify-content: center;
      padding: 48px 48px;
      position: relative; overflow: hidden;
    }
    .panel-right::before {
      content: '';
      position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, var(--green) 0%, var(--green-light) 50%, var(--violet) 100%);
    }
    .panel-right::after {
      content: '';
      position: absolute; bottom: -80px; right: -80px;
      width: 240px; height: 240px; border-radius: 50%;
      background: radial-gradient(circle, var(--green-xpale) 0%, transparent 70%);
      pointer-events: none;
    }

    .form-header { margin-bottom: 28px; position: relative; z-index: 2; }
    .form-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.8rem; font-weight: 700;
      color: var(--text); margin-bottom: 8px;
    }
    .form-subtitle { font-size: .9rem; color: var(--text-sec); line-height: 1.55; }

    /* ── CHOICE CARDS ── */
    .choice-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 16px;
      position: relative; z-index: 2;
      margin-bottom: 22px;
    }

    .choice-card {
      position: relative;
      background: var(--white);
      border: 2px solid var(--border);
      border-radius: 16px;
      padding: 24px 20px 20px;
      cursor: pointer;
      text-decoration: none;
      color: inherit;
      transition: all .3s cubic-bezier(.22,1,.36,1);
      overflow: hidden;
      display: flex; flex-direction: column;
    }

    .choice-card::before {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(135deg, transparent 0%, var(--green-xpale) 100%);
      opacity: 0; transition: opacity .3s;
      z-index: 0;
    }

    .choice-card:hover {
      transform: translateY(-4px);
      border-color: var(--green-light);
      box-shadow: 0 16px 32px rgba(27,67,50,.12);
    }
    .choice-card:hover::before { opacity: 1; }

    .choice-card.violet:hover {
      border-color: var(--violet);
      box-shadow: 0 16px 32px rgba(123,94,167,.18);
    }
    .choice-card.violet::before {
      background: linear-gradient(135deg, transparent 0%, var(--violet-xpale) 100%);
    }

    .choice-icon-wrap {
      width: 56px; height: 56px;
      border-radius: 14px;
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 14px;
      position: relative; z-index: 1;
      transition: transform .3s;
    }
    .choice-card:hover .choice-icon-wrap { transform: scale(1.06) rotate(-3deg); }

    .choice-card.green .choice-icon-wrap {
      background: linear-gradient(135deg, var(--green) 0%, var(--green-mid) 100%);
      box-shadow: 0 8px 20px rgba(27,67,50,.25);
    }
    .choice-card.violet .choice-icon-wrap {
      background: linear-gradient(135deg, var(--violet) 0%, var(--violet-mid) 100%);
      box-shadow: 0 8px 20px rgba(123,94,167,.25);
    }

    .choice-icon-wrap svg {
      width: 28px; height: 28px;
      stroke: #fff; fill: none; stroke-width: 1.8;
    }

    .choice-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.15rem; font-weight: 700;
      color: var(--text); margin-bottom: 6px;
      position: relative; z-index: 1;
    }

    .choice-desc {
      font-size: .8rem; color: var(--text-sec); line-height: 1.55;
      margin-bottom: 14px;
      position: relative; z-index: 1;
      flex-grow: 1;
    }

    .choice-meta {
      display: flex; align-items: center; gap: 6px;
      font-size: .7rem; font-weight: 600; color: var(--text-sec);
      padding-top: 12px;
      border-top: 1px solid var(--border);
      position: relative; z-index: 1;
    }
    .choice-card.green .choice-meta { color: var(--green); }
    .choice-card.violet .choice-meta { color: var(--violet); }
    .choice-meta svg { width: 12px; height: 12px; }

    .choice-badge {
      position: absolute; top: 16px; right: 16px;
      padding: 3px 9px;
      font-size: .65rem; font-weight: 700; letter-spacing: .3px;
      text-transform: uppercase;
      border-radius: 999px;
      z-index: 2;
    }
    .choice-card.green .choice-badge {
      background: var(--green-pale); color: var(--green);
    }
    .choice-card.violet .choice-badge {
      background: var(--violet-xpale); color: var(--violet);
    }

    .choice-arrow {
      position: absolute; bottom: 22px; right: 20px;
      width: 30px; height: 30px;
      border-radius: 50%;
      background: var(--bg);
      display: flex; align-items: center; justify-content: center;
      transition: all .3s;
      z-index: 1;
    }
    .choice-card:hover .choice-arrow {
      background: var(--green-light); transform: translateX(3px);
    }
    .choice-card.violet:hover .choice-arrow { background: var(--violet); }
    .choice-arrow svg { width: 14px; height: 14px; stroke: var(--text-sec); fill: none; stroke-width: 2.2; transition: stroke .3s; }
    .choice-card:hover .choice-arrow svg { stroke: #fff; }

    /* ── INFO BOX ── */
    .info-box {
      display: flex; align-items: flex-start; gap: 10px;
      background: var(--green-xpale);
      border-left: 3px solid var(--green-light);
      padding: 12px 14px;
      border-radius: 8px;
      font-size: .8rem; color: var(--green);
      line-height: 1.55;
      margin-bottom: 20px;
      position: relative; z-index: 2;
    }
    .info-box svg { width: 16px; height: 16px; flex-shrink: 0; margin-top: 1px; fill: none; stroke: var(--green); stroke-width: 2; }

    /* ── LOGIN LINK ── */
    .login-link-row { text-align: center; position: relative; z-index: 2; }
    .login-link {
      font-size: .84rem; color: var(--text-sec); text-decoration: none;
      display: inline-flex; align-items: center; gap: 5px;
      transition: color .2s;
    }
    .login-link:hover { color: var(--green); }
    .login-link svg { width: 14px; height: 14px; }

    /* ── RESPONSIVE ── */
    @media (max-width: 780px) {
      .card { flex-direction: column; max-width: 480px; }
      .panel-left { flex: 0 0 auto; padding: 32px 24px; }
      .panel-right { padding: 36px 28px; }
      .choice-grid { grid-template-columns: 1fr; }
      .logo-img { width: 100px; height: 100px; }
      .shield-anim { width: 56px; height: 56px; margin-bottom: 12px; }
      .panel-tagline { font-size: 1.15rem; }
      .form-title { font-size: 1.5rem; }
    }
  </style>
</head>
<body>

<div class="bg-canvas"></div>

<div class="wrapper">
  <div class="card">

    <!-- LEFT PANEL -->
    <div class="panel-left">
      <div class="brand">
        <img src="{{ asset('images/logo.png') }}" alt="MindAura" class="logo-img"/>
        <span class="brand-name">MindAura</span>
      </div>

      <div class="panel-content">
        <div class="shield-anim">
          <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="M9 12l2 2 4-4"/>
          </svg>
        </div>
        <div class="panel-tagline">Choisissez votre<br/>méthode sécurisée</div>
        <div class="panel-desc">Deux façons simples et sûres de reprendre le contrôle de votre compte. À vous de choisir la plus rapide.</div>
      </div>

      <div class="panel-bottom">
        <a href="{{ path('app_login') }}" class="back-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 5l-7 7 7 7"/>
          </svg>
          Retour à la connexion
        </a>
      </div>
    </div>

    <!-- RIGHT PANEL -->
    <div class="panel-right">

      <div class="form-header">
        <div class="form-title">Mot de passe oublié ?</div>
        <div class="form-subtitle">Choisissez comment vous souhaitez réinitialiser votre mot de passe en toute sécurité.</div>
      </div>

      {% for message in app.flashes('error') %}
        <div class="info-box" style="background:#FEF2F2;border-left-color:#DC2626;color:#DC2626;">
          <svg viewBox="0 0 24 24" stroke="#DC2626"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <div>{{ message }}</div>
        </div>
      {% endfor %}

      <div class="choice-grid">

        <!-- Choice 1: Email -->
        <a href="{{ path('app_forgot_password_email') }}" class="choice-card green">
          <div class="choice-badge">Classique</div>
          <div class="choice-icon-wrap">
            <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </div>
          <div class="choice-title">Lien par e-mail</div>
          <div class="choice-desc">Recevez un lien sécurisé dans votre boîte mail pour créer un nouveau mot de passe.</div>
          <div class="choice-meta">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
            Valable 30 minutes
          </div>
          <div class="choice-arrow">
            <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
        </a>

        <!-- Choice 2: Google Authenticator -->
        <a href="{{ path('app_forgot_password_totp') }}" class="choice-card violet">
          <div class="choice-badge">Rapide</div>
          <div class="choice-icon-wrap">
            <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
              <line x1="12" y1="18" x2="12.01" y2="18"/>
              <path d="M8 7h8M8 11h8M8 14h5" opacity=".6"/>
            </svg>
          </div>
          <div class="choice-title">Google Authenticator</div>
          <div class="choice-desc">Utilisez le code à 6 chiffres de votre application d'authentification à deux facteurs.</div>
          <div class="choice-meta">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            Instantané & sécurisé
          </div>
          <div class="choice-arrow">
            <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
        </a>

      </div>

      <div class="info-box">
        <svg viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="16" x2="12" y2="12"/>
          <line x1="12" y1="8" x2="12.01" y2="8"/>
        </svg>
        <div><strong>Astuce :</strong> si vous avez activé la 2FA lors de votre inscription, la méthode Google Authenticator est la plus rapide — aucun e-mail à attendre.</div>
      </div>

      <div class="login-link-row">
        <a href="{{ path('app_login') }}" class="login-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 5l-7 7 7 7"/>
          </svg>
          Vous vous souvenez ? Retour à la connexion
        </a>
      </div>

    </div>
    <!-- /RIGHT PANEL -->

  </div>
</div>

</body>
</html>
