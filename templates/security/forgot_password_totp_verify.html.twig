<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>MindAura — Saisir le code Authenticator</title>
  <link rel="icon" type="image/png" href="{{ asset('images/logo.png') }}"/>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,700;1,400&family=JetBrains+Mono:wght@600&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --green:        #1B4332;
      --green-mid:    #2D6A4F;
      --green-light:  #52B788;
      --green-pale:   #D8F3DC;
      --green-xpale:  #EBF7F0;
      --violet:       #7B5EA7;
      --violet-mid:   #9575C6;
      --violet-pale:  rgba(123,94,167,.12);
      --violet-xpale: #EDE9F6;
      --bg:           #F0F4F8;
      --white:        #FFFFFF;
      --text:         #1A1A2E;
      --text-sec:     #5A6475;
      --border:       #D5DCE6;
      --shadow:       0 24px 64px rgba(27,67,50,.18), 0 0 0 1px rgba(255,255,255,.7);
      --radius:       22px;
    }

    html, body {
      height: 100%;
      font-family: 'Outfit', sans-serif;
      background: var(--bg);
      color: var(--text);
      overflow: hidden;
    }

    .bg-canvas {
      position: fixed; inset: 0; z-index: 0;
      background: url("{{ asset('images/background.jpg') }}") center center / cover no-repeat;
    }
    .bg-canvas::before {
      content: '';
      position: absolute; inset: 0;
      background: rgba(0,0,0,0.38);
    }

    .wrapper {
      position: relative; z-index: 1; height: 100vh;
      display: flex; align-items: center; justify-content: center;
      padding: 16px;
    }

    .card {
      width: 100%; max-width: 900px; min-height: 540px;
      display: flex; border-radius: var(--radius); overflow: hidden;
      box-shadow: var(--shadow);
      animation: cardIn .7s cubic-bezier(.22,1,.36,1) both;
    }
    @keyframes cardIn {
      from { opacity: 0; transform: translateY(30px) scale(.95); }
      to   { opacity: 1; transform: none; }
    }

    /* ══ LEFT PANEL ══ */
    .panel-left {
      flex: 0 0 290px;
      background: linear-gradient(160deg, var(--violet) 0%, #5D4888 100%);
      color: var(--white);
      padding: 44px 34px;
      display: flex; flex-direction: column; justify-content: space-between;
      position: relative; overflow: hidden;
    }
    .panel-left::before {
      content: ''; position: absolute; top: -65px; right: -65px;
      width: 240px; height: 240px; border-radius: 50%;
      border: 48px solid rgba(255,255,255,.07);
    }
    .panel-left::after {
      content: ''; position: absolute; bottom: -42px; left: -42px;
      width: 180px; height: 180px; border-radius: 50%;
      border: 32px solid rgba(255,255,255,.05);
    }

    .brand {
      display: flex; flex-direction: column; align-items: center;
      gap: 12px; position: relative; z-index: 2;
    }
    .logo-img {
      width: 130px; height: 130px; object-fit: contain;
      filter: drop-shadow(0 6px 18px rgba(0,0,0,.3));
    }
    .brand-name {
      font-family: 'Playfair Display', serif; font-size: 1.45rem; letter-spacing: .5px;
      background: linear-gradient(135deg, #fff 25%, var(--violet-xpale));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }

    .panel-content { position: relative; z-index: 2; text-align: center; }

    /* Icône pulsante : téléphone + code */
    .code-anim {
      width: 68px; height: 68px;
      background: rgba(255,255,255,.12);
      border-radius: 50%; display: flex; align-items: center; justify-content: center;
      margin: 0 auto 16px;
      animation: codePulse 2.2s ease-in-out infinite;
    }
    @keyframes codePulse {
      0%,100% { box-shadow: 0 0 0 0 rgba(255,255,255,.2); }
      50%     { box-shadow: 0 0 0 14px rgba(255,255,255,0); }
    }
    .code-anim svg { width: 32px; height: 32px; fill: none; stroke: #fff; stroke-width: 1.8; }

    .panel-tagline {
      font-family: 'Playfair Display', serif; font-size: 1.32rem; line-height: 1.3;
      margin-bottom: 10px;
    }
    .panel-desc { font-size: .83rem; opacity: .75; line-height: 1.65; }

    /* Timer circulaire TOTP (30s rotation) */
    .totp-timer {
      margin-top: 20px;
      display: flex; align-items: center; gap: 8px;
      justify-content: center;
      font-size: .75rem; opacity: .8;
    }
    .timer-circle {
      width: 26px; height: 26px; position: relative;
    }
    .timer-circle svg {
      width: 100%; height: 100%;
      transform: rotate(-90deg);
    }
    .timer-circle .timer-track {
      fill: none; stroke: rgba(255,255,255,.2); stroke-width: 3;
    }
    .timer-circle .timer-fill {
      fill: none; stroke: #fff; stroke-width: 3;
      stroke-dasharray: 75.4;
      stroke-linecap: round;
      transition: stroke-dashoffset .95s linear;
    }

    .panel-bottom { position: relative; z-index: 2; text-align: center; }
    .back-link {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: .8rem; opacity: .6; color: var(--white); text-decoration: none;
      transition: opacity .25s;
    }
    .back-link:hover { opacity: 1; }
    .back-link svg { width: 14px; height: 14px; }

    /* ══ RIGHT PANEL ══ */
    .panel-right {
      flex: 1; background: var(--white);
      display: flex; flex-direction: column; justify-content: center;
      padding: 42px 52px;
      position: relative; overflow: hidden;
    }
    .panel-right::before {
      content: '';
      position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, var(--green) 0%, var(--green-light) 50%, var(--violet) 100%);
    }
    .panel-right::after {
      content: '';
      position: absolute; bottom: -60px; right: -60px;
      width: 200px; height: 200px;
      border-radius: 50%;
      background: radial-gradient(circle, var(--violet-xpale) 0%, transparent 70%);
      pointer-events: none;
    }

    .form-header { margin-bottom: 24px; }
    .form-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.65rem; font-weight: 700;
      color: var(--text); margin-bottom: 6px;
    }
    .form-subtitle { font-size: .875rem; color: var(--text-sec); line-height: 1.55; }

    .email-badge {
      display: inline-flex; align-items: center; gap: 6px;
      background: var(--green-xpale);
      color: var(--green);
      padding: 5px 12px;
      border-radius: 999px;
      font-size: .75rem; font-weight: 600;
      margin-top: 10px;
    }
    .email-badge svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 2; }

    /* ── STEP INDICATOR ── */
    .step-indicator {
      display: flex; align-items: center; gap: 8px;
      margin-bottom: 20px;
    }
    .step-item {
      display: flex; align-items: center; gap: 6px;
      font-size: .75rem; font-weight: 600;
    }
    .step-dot {
      width: 22px; height: 22px; border-radius: 50%;
      background: var(--bg); border: 1.5px solid var(--border);
      display: flex; align-items: center; justify-content: center;
      font-size: .68rem; color: var(--text-sec);
      transition: all .3s;
    }
    .step-item.done .step-dot {
      background: var(--green); border-color: var(--green); color: #fff;
    }
    .step-item.active .step-dot {
      background: var(--violet); border-color: var(--violet); color: #fff;
    }
    .step-label { color: var(--text-sec); }
    .step-item.active .step-label { color: var(--violet); }
    .step-item.done .step-label { color: var(--green); }
    .step-connector { flex: 1; height: 1px; background: var(--border); }
    .step-connector.done { background: var(--green); }

    /* ── CODE INPUT SEGMENTED ── */
    .code-input-wrap {
      display: flex; gap: 10px; justify-content: center;
      margin: 24px 0 12px;
    }
    .code-digit {
      width: 48px; height: 58px;
      border: 2px solid var(--border);
      border-radius: 12px;
      background: var(--bg);
      font-family: 'JetBrains Mono', monospace;
      font-size: 1.55rem; font-weight: 600;
      text-align: center;
      color: var(--text);
      outline: none;
      transition: all .2s;
      -webkit-appearance: none;
      -moz-appearance: textfield;
    }
    .code-digit::-webkit-outer-spin-button,
    .code-digit::-webkit-inner-spin-button {
      -webkit-appearance: none; margin: 0;
    }
    .code-digit:focus {
      border-color: var(--violet);
      background: #fff;
      box-shadow: 0 0 0 4px rgba(123,94,167,.12);
      transform: translateY(-1px);
    }
    .code-digit.filled {
      border-color: var(--green-light);
      background: var(--green-xpale);
      color: var(--green);
    }
    .code-digit.is-invalid {
      border-color: #DC2626;
      background: #FEF2F2;
      animation: shake .4s ease;
    }
    @keyframes shake {
      0%,100% { transform: translateX(0); }
      25%     { transform: translateX(-6px); }
      75%     { transform: translateX(6px); }
    }

    .code-hint {
      text-align: center; font-size: .78rem; color: var(--text-sec);
      margin-bottom: 20px;
    }

    /* ── BTN ── */
    .btn-submit {
      width: 100%; padding: 14px;
      background: linear-gradient(135deg, var(--violet) 0%, var(--violet-mid) 100%);
      color: #fff; border: none; border-radius: 12px;
      font-family: 'Outfit', sans-serif; font-size: .95rem; font-weight: 600;
      cursor: pointer; letter-spacing: .3px;
      transition: transform .2s, box-shadow .2s, opacity .2s;
      box-shadow: 0 4px 18px rgba(123,94,167,.28);
      display: flex; align-items: center; justify-content: center; gap: 8px;
      position: relative; overflow: hidden;
    }
    .btn-submit::after {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(135deg, transparent 0%, rgba(255,255,255,.12) 100%);
      opacity: 0; transition: opacity .25s;
    }
    .btn-submit:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(123,94,167,.36); }
    .btn-submit:hover::after { opacity: 1; }
    .btn-submit:active { transform: translateY(0); }
    .btn-submit svg { width: 17px; height: 17px; }
    .btn-submit.loading { opacity: .75; pointer-events: none; }
    .btn-submit.loading .btn-text { opacity: 0; }
    .btn-submit.loading::before {
      content: '';
      position: absolute;
      width: 20px; height: 20px;
      border: 2.5px solid rgba(255,255,255,.4);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin .7s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ── ALERT ERROR ── */
    .alert-error {
      background: #FEF2F2; border: 1px solid #FECACA;
      border-radius: 10px; padding: 12px 16px;
      display: flex; align-items: flex-start; gap: 10px;
      margin-bottom: 18px; font-size: .82rem; color: #DC2626;
      line-height: 1.5;
      animation: errIn .25s ease;
    }
    @keyframes errIn { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
    .alert-error svg { width: 17px; height: 17px; flex-shrink: 0; margin-top: 1px; }

    /* ── HELP BOX (troubleshoot) ── */
    .help-toggle {
      margin-top: 14px; text-align: center;
    }
    .help-toggle button {
      background: none; border: none;
      font-family: 'Outfit', sans-serif;
      font-size: .78rem; color: var(--text-sec);
      cursor: pointer;
      text-decoration: underline;
      transition: color .2s;
    }
    .help-toggle button:hover { color: var(--violet); }

    .help-box {
      display: none;
      background: var(--violet-xpale);
      border-left: 3px solid var(--violet);
      border-radius: 8px;
      padding: 14px 16px;
      margin-top: 14px;
      font-size: .78rem; color: var(--text);
      line-height: 1.6;
      animation: errIn .3s ease;
    }
    .help-box.show { display: block; }
    .help-box strong { color: var(--violet); }
    .help-box ol { padding-left: 18px; margin-top: 6px; }
    .help-box li { margin-bottom: 4px; }

    /* ── LINKS ── */
    .divider {
      display: flex; align-items: center; gap: 12px;
      margin: 16px 0;
    }
    .divider-line { flex: 1; height: 1px; background: var(--border); }
    .divider-text { font-size: .75rem; color: var(--text-sec); white-space: nowrap; }

    .login-link-row { text-align: center; }
    .login-link {
      font-size: .82rem; color: var(--text-sec); text-decoration: none;
      display: inline-flex; align-items: center; gap: 5px;
      transition: color .2s;
    }
    .login-link:hover { color: var(--violet); }
    .login-link svg { width: 13px; height: 13px; }
  </style>
</head>
<body>

<div class="bg-canvas"></div>

<div class="wrapper">
  <div class="card">

    <!-- LEFT PANEL -->
    <div class="panel-left">
      <div class="brand">
        <img src="{{ asset('images/logo.png') }}" alt="MindAura" class="logo-img"/>
        <span class="brand-name">MindAura</span>
      </div>

      <div class="panel-content">
        <div class="code-anim">
          <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="5" width="18" height="14" rx="2"/>
            <path d="M7 10h2M11 10h2M15 10h2M7 14h10" opacity=".8"/>
          </svg>
        </div>
        <div class="panel-tagline">Code de<br/>vérification</div>
        <div class="panel-desc">Ouvrez votre application Google Authenticator et saisissez le code à 6 chiffres affiché pour MindAura.</div>

        <div class="totp-timer">
          <div class="timer-circle">
            <svg viewBox="0 0 30 30">
              <circle class="timer-track" cx="15" cy="15" r="12"/>
              <circle id="timerFill" class="timer-fill" cx="15" cy="15" r="12"/>
            </svg>
          </div>
          <span>Le code change toutes les 30 s</span>
        </div>
      </div>

      <div class="panel-bottom">
        <a href="{{ path('app_forgot_password_totp') }}" class="back-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 5l-7 7 7 7"/>
          </svg>
          Changer d'adresse e-mail
        </a>
      </div>
    </div>

    <!-- RIGHT PANEL -->
    <div class="panel-right">

      <div class="form-header">
        <div class="step-indicator">
          <div class="step-item done">
            <div class="step-dot">
              <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" width="12" height="12">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </div>
            <span class="step-label">Compte</span>
          </div>
          <div class="step-connector done"></div>
          <div class="step-item active">
            <div class="step-dot">2</div>
            <span class="step-label">Code</span>
          </div>
          <div class="step-connector"></div>
          <div class="step-item">
            <div class="step-dot">3</div>
            <span class="step-label">Mot de passe</span>
          </div>
        </div>
        <div class="form-title">Saisissez votre code</div>
        <div class="form-subtitle">Entrez le code à 6 chiffres affiché dans votre application d'authentification.</div>
        {% if maskedEmail %}
          <span class="email-badge">
            <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            {{ maskedEmail }}
          </span>
        {% endif %}
      </div>

      {% if error %}
        <div class="alert-error">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
          <div>{{ error }}</div>
        </div>
      {% endif %}

      <form method="POST" action="{{ path('app_forgot_password_totp_verify') }}" id="totpForm" novalidate>
        <!-- Hidden field combiné -->
        <input type="hidden" name="totp_code" id="totp_code"/>

        <div class="code-input-wrap" id="codeWrap">
          <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="code-digit" data-index="0" autofocus/>
          <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="code-digit" data-index="1"/>
          <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="code-digit" data-index="2"/>
          <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="code-digit" data-index="3"/>
          <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="code-digit" data-index="4"/>
          <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="code-digit" data-index="5"/>
        </div>

        <div class="code-hint">
          Astuce : vous pouvez coller directement un code copié depuis votre application.
        </div>

        <button type="submit" class="btn-submit" id="submitBtn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-text">
            <path d="M9 12l2 2 4-4"/>
            <circle cx="12" cy="12" r="10"/>
          </svg>
          <span class="btn-text">Valider le code</span>
        </button>
      </form>

      <div class="help-toggle">
        <button type="button" id="toggleHelp">Le code ne fonctionne pas ?</button>
      </div>

      <div class="help-box" id="helpBox">
        <strong>📱 Synchronisez votre application :</strong>
        <ol>
          <li>Ouvrez <strong>Google Authenticator</strong> sur votre téléphone.</li>
          <li>Appuyez sur le menu ⋮ (en haut à droite) → <strong>Paramètres</strong>.</li>
          <li>Sélectionnez <strong>« Correction du temps pour les codes »</strong>.</li>
          <li>Appuyez sur <strong>« Synchroniser maintenant »</strong>.</li>
          <li>Revenez ici et saisissez un nouveau code.</li>
        </ol>
        <div style="margin-top:10px;">
          Si le problème persiste, utilisez plutôt <a href="{{ path('app_forgot_password_email') }}" style="color:var(--violet);font-weight:600;">la méthode par e-mail</a>.
        </div>
      </div>

      <div class="divider">
        <div class="divider-line"></div>
        <span class="divider-text">ou</span>
        <div class="divider-line"></div>
      </div>

      <div class="login-link-row">
        <a href="{{ path('app_forgot_password') }}" class="login-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 5l-7 7 7 7"/>
          </svg>
          Changer de méthode
        </a>
      </div>

    </div>
    <!-- /RIGHT PANEL -->

  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {

  // ── Gestion des 6 inputs segmentés ────────────────────────────────
  const digits    = document.querySelectorAll('.code-digit');
  const hidden    = document.getElementById('totp_code');
  const form      = document.getElementById('totpForm');
  const submitBtn = document.getElementById('submitBtn');

  function updateHidden() {
    hidden.value = Array.from(digits).map(i => i.value).join('');
  }

  digits.forEach((input, idx) => {

    // Saisie d'un chiffre
    input.addEventListener('input', function (e) {
      // Ne garder que les chiffres
      this.value = this.value.replace(/\D/g, '').slice(0, 1);

      if (this.value) {
        this.classList.add('filled');
        this.classList.remove('is-invalid');
        // Auto-focus le suivant
        if (idx < digits.length - 1) {
          digits[idx + 1].focus();
        }
      } else {
        this.classList.remove('filled');
      }

      updateHidden();

      // Auto-submit quand les 6 chiffres sont remplis
      if (hidden.value.length === 6) {
        setTimeout(() => form.requestSubmit(), 150);
      }
    });

    // Retour arrière : focus précédent si vide
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Backspace' && !this.value && idx > 0) {
        digits[idx - 1].focus();
        digits[idx - 1].value = '';
        digits[idx - 1].classList.remove('filled');
        updateHidden();
      }
      if (e.key === 'ArrowLeft' && idx > 0) {
        digits[idx - 1].focus();
      }
      if (e.key === 'ArrowRight' && idx < digits.length - 1) {
        digits[idx + 1].focus();
      }
    });

    // Paste : répartir dans les 6 cases
    input.addEventListener('paste', function (e) {
      e.preventDefault();
      const pasted = (e.clipboardData || window.clipboardData).getData('text');
      const clean  = pasted.replace(/\D/g, '').slice(0, 6);
      if (!clean) return;

      digits.forEach((d, i) => {
        d.value = clean[i] || '';
        if (clean[i]) {
          d.classList.add('filled');
        } else {
          d.classList.remove('filled');
        }
      });
      updateHidden();

      // Focus la prochaine case vide (ou la dernière)
      const nextEmpty = Array.from(digits).findIndex(d => !d.value);
      digits[nextEmpty === -1 ? digits.length - 1 : nextEmpty].focus();

      if (hidden.value.length === 6) {
        setTimeout(() => form.requestSubmit(), 150);
      }
    });
  });

  // Validation avant submit
  form.addEventListener('submit', function (e) {
    updateHidden();
    if (hidden.value.length !== 6) {
      e.preventDefault();
      digits.forEach(d => { if (!d.value) d.classList.add('is-invalid'); });
      digits[Array.from(digits).findIndex(d => !d.value)].focus();
      return;
    }
    submitBtn.classList.add('loading');
  });

  // ── Timer TOTP 30s ────────────────────────────────────────────────
  const timerFill = document.getElementById('timerFill');
  const CIRC = 2 * Math.PI * 12;
  timerFill.style.strokeDasharray = CIRC;

  function updateTimer() {
    const now       = Math.floor(Date.now() / 1000);
    const remaining = 30 - (now % 30);
    const offset    = CIRC * (1 - remaining / 30);
    timerFill.style.strokeDashoffset = offset;
  }
  updateTimer();
  setInterval(updateTimer, 1000);

  // ── Toggle aide ───────────────────────────────────────────────────
  const toggleBtn = document.getElementById('toggleHelp');
  const helpBox   = document.getElementById('helpBox');
  toggleBtn.addEventListener('click', () => {
    helpBox.classList.toggle('show');
    toggleBtn.textContent = helpBox.classList.contains('show')
      ? 'Masquer l\'aide'
      : 'Le code ne fonctionne pas ?';
  });

  // Si erreur présente, ouvrir automatiquement l'aide
  {% if error %}
    helpBox.classList.add('show');
    toggleBtn.textContent = 'Masquer l\'aide';
  {% endif %}
});
</script>
</body>
</html>
