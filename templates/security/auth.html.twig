<script src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>

<script>
'use strict';

/* ══════════════════════════════════════════════════════════
   TAB SWITCHING
══════════════════════════════════════════════════════════ */
let curTab = '{{ mode is defined and mode == "register" ? "register" : "login" }}';

const TAGS  = { login: 'Bienvenue sur votre espace bien-être', register: "Rejoignez MindAura aujourd'hui" };
const DESCS = { login: 'Connectez-vous pour accéder à votre suivi personnalisé, vos thérapeutes et vos objectifs de développement personnel.', register: 'Créez votre espace personnel et commencez votre parcours bien-être avec des professionnels certifiés.' };

function switchTab(tab) {
  if (tab === curTab && !document.getElementById('paneFaceID').classList.contains('active-face')) return;
  // Hide face panel if visible
  hideFacePanel();
  curTab = tab;
  const pl  = document.getElementById('paneLogin');
  const pr  = document.getElementById('paneRegister');
  const tl  = document.getElementById('tabLogin');
  const tr  = document.getElementById('tabRegister');
  const tag = document.getElementById('panelTagline');
  const dsc = document.getElementById('panelDesc');
  tl.classList.toggle('active', tab === 'login');
  tr.classList.toggle('active', tab === 'register');
  document.getElementById('dot0').classList.toggle('active', tab === 'login');
  document.getElementById('dot1').classList.toggle('active', tab === 'register');
  tag.style.cssText = 'opacity:0;transform:translateY(9px);transition:opacity .38s,transform .38s';
  dsc.style.cssText = 'opacity:0;transform:translateY(9px);transition:opacity .38s .07s,transform .38s .07s';
  setTimeout(() => {
    tag.textContent = TAGS[tab]; dsc.textContent = DESCS[tab];
    tag.style.opacity='1'; tag.style.transform='';
    dsc.style.opacity='1'; dsc.style.transform='';
  }, 190);
  if (tab === 'register') {
    pl.classList.remove('active');        pl.classList.add('slide-out-left');
    pr.classList.remove('slide-out-right'); pr.classList.add('active');
    pr.scrollTop = 0;
  } else {
    pr.classList.remove('active');        pr.classList.add('slide-out-right');
    pl.classList.remove('slide-out-left'); pl.classList.add('active');
    pl.scrollTop = 0;
  }
}

/* ══════════════════════════════════════════════════════════
   ROLE SELECT / PASS TOGGLE / STRENGTH / ETC
══════════════════════════════════════════════════════════ */
function selRole(card) {
  document.querySelectorAll('.role-card').forEach(c => c.classList.remove('selected'));
  card.classList.add('selected');
}
function togglePass(id, btn) {
  const inp = document.getElementById(id);
  const show = btn.querySelector('.eye-show');
  const hide = btn.querySelector('.eye-hide');
  if (inp.type === 'password') { inp.type='text'; show.style.display='none'; hide.style.display='block'; }
  else { inp.type='password'; show.style.display='block'; hide.style.display='none'; }
}
const SEG_C = ['#EF4444','#F97316','#EAB308','#1B4332'];
const SEG_L = ['Faible','Moyen','Bien','Fort'];
function checkStrength(inp) {
  const v=inp.value; let s=0;
  if(v.length>=8) s++; if(/[A-Z]/.test(v)) s++; if(/[0-9]/.test(v)) s++; if(/[^A-Za-z0-9]/.test(v)) s++;
  const label=document.getElementById('strengthLabel');
  for(let i=1;i<=4;i++){const seg=document.getElementById('seg'+i);seg.style.background=i<=s?SEG_C[s-1]:'#D5DCE6';seg.style.transform=i<=s?'scaleY(1.4)':'scaleY(1)';}
  if(label){label.textContent=s>0?SEG_L[s-1]:'Force';label.style.color=s>0?SEG_C[s-1]:'var(--text-sec)';}
}
function checkConfirm() {
  const pass=document.getElementById('regPass').value;
  const confirm=document.getElementById('regPassConfirm').value;
  const msg=document.getElementById('confirmMsg');
  const wrap=document.getElementById('wrap-pass-confirm');
  if(!confirm){msg.classList.remove('show');wrap.classList.remove('is-invalid');return;}
  if(pass===confirm){msg.textContent='✓ Les mots de passe correspondent';msg.style.color='var(--green)';msg.classList.add('show');wrap.classList.remove('is-invalid');}
  else{msg.textContent='✗ Ne correspondent pas';msg.style.color='#DC2626';msg.classList.add('show');wrap.classList.add('is-invalid');}
}
function previewFile(input) {
  const f=input.files[0]; if(!f) return;
  const r=new FileReader();
  r.onload=e=>showPreview(e.target.result);
  r.readAsDataURL(f);
  document.getElementById('avatarFilename').textContent=f.name;
  document.getElementById('camDataInput').value='';
}
function showPreview(src) {
  const img=document.getElementById('avatarImg');
  const ph=document.getElementById('avatarPh');
  img.src=src; img.style.display='block'; ph.style.display='none';
  document.getElementById('avatarPreview').style.borderColor='var(--green)';
}
let camStream=null;
async function toggleCamera() {
  const wrap=document.getElementById('camWrap');
  const btn=document.getElementById('camBtn');
  if(wrap.classList.contains('open')){closeCamera();return;}
  try{
    camStream=await navigator.mediaDevices.getUserMedia({video:{facingMode:'user'},audio:false});
    document.getElementById('camVideo').srcObject=camStream;
    wrap.classList.add('open'); btn.classList.add('cam-on');
  }catch(e){alert('Impossible d\'accéder à la caméra.');}
}
function closeCamera() {
  if(camStream){camStream.getTracks().forEach(t=>t.stop());camStream=null;}
  document.getElementById('camWrap').classList.remove('open');
  document.getElementById('camBtn').classList.remove('cam-on');
  document.getElementById('camVideo').srcObject=null;
}
function snapPhoto() {
  const video=document.getElementById('camVideo');
  const canvas=document.getElementById('camCanvas');
  canvas.width=video.videoWidth||400; canvas.height=video.videoHeight||300;
  canvas.getContext('2d').drawImage(video,0,0);
  const dataUrl=canvas.toDataURL('image/jpeg',0.88);
  document.getElementById('camDataInput').value=dataUrl;
  document.getElementById('fileInput').value='';
  showPreview(dataUrl);
  document.getElementById('avatarFilename').textContent='Photo prise avec la caméra';
  closeCamera();
}

