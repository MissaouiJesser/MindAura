/* ── No-photo upload flow ── */
function showFaceUpload(mode) {
  document.getElementById('faceNoPhoto').classList.remove('visible');
  document.getElementById('faceUploadWrap').classList.add('visible');
  if (mode === 'cam') {
    openFaceCam();
  }
}
function cancelFaceUpload() {
  closeFaceCam();
  document.getElementById('faceUploadWrap').classList.remove('visible');
  document.getElementById('faceNoPhoto').classList.add('visible');
}
async function openFaceCam() {
  try {
    faceCamStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode:'user' }, audio: false });
    document.getElementById('faceCamVideo').srcObject = faceCamStream;
    document.getElementById('faceCamWrap').classList.add('open');
  } catch(e) {
    alert('Impossible d\'accéder à la caméra.');
  }
}
function closeFaceCam() {
  if(faceCamStream){ faceCamStream.getTracks().forEach(t=>t.stop()); faceCamStream=null; }
  const v = document.getElementById('faceCamVideo');
  if(v) v.srcObject=null;
  const wrap = document.getElementById('faceCamWrap');
  if(wrap) wrap.classList.remove('open');
}
function snapFacePhoto() {
  const video  = document.getElementById('faceCamVideo');
  const canvas = document.getElementById('faceCamCanvas');
  canvas.width  = video.videoWidth  || 400;
  canvas.height = video.videoHeight || 300;
  canvas.getContext('2d').drawImage(video,0,0);
  canvas.toBlob(blob => {
    const file = new File([blob], 'face_capture.jpg', { type:'image/jpeg' });
    handleFacePhotoUploadBlob(file, canvas.toDataURL('image/jpeg', 0.9));
  }, 'image/jpeg', 0.9);
  closeFaceCam();
}
function handleFacePhotoUpload(input) {
  const file = input.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = e => handleFacePhotoUploadBlob(file, e.target.result);
  reader.readAsDataURL(file);
}
async function handleFacePhotoUploadBlob(file, dataUrl) {
  uploadedProfileImage = { file, dataUrl };
  // Save it to the server via AJAX
  const formData = new FormData();
  formData.append('photo', file);
  formData.append('_csrf', document.querySelector('#loginForm input[name="_csrf_token"]').value);
  formData.append('email', document.getElementById('loginEmail').value.trim());

  document.getElementById('faceUploadWrap').classList.remove('visible');
  document.getElementById('faceNoPhoto').classList.remove('visible');
  document.getElementById('faceMain').classList.add('visible');
  document.getElementById('faceProfileImg').src = dataUrl;

  setFaceStatus('loading', '', 'Enregistrement de votre photo…', true);

  try {
    const resp = await fetch('/face-save-photo', { method: 'POST', body: formData });
    const data = await resp.json();
    if (!data.success) throw new Error(data.message || 'Erreur');
  } catch(e) {
    setFaceStatus('warning', '⚠️', 'Photo enregistrée localement. La synchronisation sera effectuée à la connexion.', false);
  }

  // Load models + camera
  const [modelsOk, cameraOk] = await Promise.all([loadFaceModels(), startFaceCamera()]);
  if (!modelsOk || !cameraOk) return;

  setFaceStatus('scanning', '', 'Analyse de la photo uploadée…', true);

  // Create image element for face-api
  const img = new Image();
  img.src = dataUrl;
  await new Promise(r => img.onload = r);

  profileDescriptor = null;
  try {
    const detection = await faceapi
      .detectSingleFace(img, new faceapi.TinyFaceDetectorOptions())
      .withFaceLandmarks(true)
      .withFaceDescriptor();
    if (detection) profileDescriptor = detection.descriptor;
  } catch(e) {}

  if (!profileDescriptor) {
    setFaceStatus('warning', '⚠️', 'Aucun visage détecté dans cette photo. Essayez avec une autre image.', false);
    document.getElementById('faceBtnScan').disabled = true;
    return;
  }

  setFaceStatus('', '⏳', 'Photo enregistrée ! Cliquez sur "Scanner" pour vous authentifier.', false);
  document.getElementById('faceBtnScan').disabled = false;
}

