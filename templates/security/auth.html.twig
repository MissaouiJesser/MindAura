<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>MindAura — {% if mode is defined and mode == 'register' %}Inscription{% else %}Connexion{% endif %}</title>
  <link rel="icon" type="image/png" href="{{ asset('images/logo.png') }}"/>
  <link rel="shortcut icon" type="image/png" href="{{ asset('images/logo.png') }}"/>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,700;1,400&display=swap" rel="stylesheet"/>

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --green:        #1B4332;
      --green-mid:    #2D6A4F;
      --green-light:  #52B788;
      --green-pale:   #D8F3DC;
      --green-xpale:  #EBF7F0;
      --violet:       #7B5EA7;
      --violet-light: rgba(123,94,167,.12);
      --bg:           #F0F4F8;
      --white:        #FFFFFF;
      --text:         #1A1A2E;
      --text-sec:     #5A6475;
      --border:       #D5DCE6;
      --hover-row:    #E8F5EE;
      --shadow:       0 24px 64px rgba(27,67,50,.18), 0 0 0 1px rgba(255,255,255,.7);
      --radius:       22px;
      --amber:        #F59E0B;
      --red:          #EF4444;
      --blue:         #3B82F6;
    }

    html, body {
      height: 100%; font-family: 'Outfit', sans-serif;
      background: var(--bg); color: var(--text); overflow: hidden;
    }

    .bg-canvas {
      position: fixed; inset: 0; z-index: 0;
      background: url("{{ asset('images/background.jpg') }}") center center / cover no-repeat;
      overflow: hidden;
    }
    .bg-canvas::before {
      content:''; position:absolute; inset:0;
      background: rgba(0,0,0,0.35);
    }

    .wrapper {
      position:relative; z-index:1; height:100vh;
      display:flex; align-items:center; justify-content:center; padding:16px;
    }
    .card {
      width:100%; max-width:1020px; height:610px;
      display:flex; border-radius:var(--radius); overflow:hidden;
      box-shadow:var(--shadow);
      animation:cardIn .7s cubic-bezier(.22,1,.36,1) both;
    }
    @keyframes cardIn { from{opacity:0;transform:translateY(30px) scale(.95)} to{opacity:1;transform:none} }

    /* ══ LEFT PANEL ══ */
    .panel-left {
      flex:0 0 295px;
      background:linear-gradient(160deg, var(--green) 0%, var(--green-mid) 100%);
      color:var(--white); padding:44px 34px;
      display:flex; flex-direction:column; justify-content:space-between;
      position:relative; overflow:hidden;
    }
    .panel-left::before {
      content:''; position:absolute; top:-65px; right:-65px;
      width:240px;height:240px;border-radius:50%;border:48px solid rgba(255,255,255,.07);
    }
    .panel-left::after {
      content:''; position:absolute; bottom:-42px; left:-42px;
      width:180px;height:180px;border-radius:50%;border:32px solid rgba(255,255,255,.05);
    }
    .ring-mid { position:absolute;top:46%;right:-80px;width:180px;height:180px;border-radius:50%;border:24px solid rgba(255,255,255,.04); }

    .brand {
      display:flex; flex-direction:column; align-items:center;
      gap:11px; position:relative; z-index:2;
    }
    .logo-img {
      width:150px; height:150px; object-fit:contain;
      filter:drop-shadow(0 6px 18px rgba(0,0,0,.3));
      transition:transform .35s ease;
      display:block;
    }
    .logo-img:hover { transform:scale(1.06) rotate(-2deg); }
    .logo-fallback {
      width:100px; height:100px; display:none;
      filter:drop-shadow(0 0 10px rgba(216,243,220,.5));
      animation:logoPulse 3s ease-in-out infinite;
    }
    @keyframes logoPulse {
      0%,100%{filter:drop-shadow(0 0 6px rgba(216,243,220,.4))}
      50%{filter:drop-shadow(0 0 18px rgba(216,243,220,.85))}
    }
    .brand-name {
      font-family:'Playfair Display',serif; font-size:1.5rem; letter-spacing:.5px;
      background:linear-gradient(135deg,#fff 25%,var(--green-pale));
      -webkit-background-clip:text; -webkit-text-fill-color:transparent;
    }

    .panel-content { position:relative;z-index:2; text-align:center; }
    .panel-tagline {
      font-family:'Playfair Display',serif; font-size:1.48rem; line-height:1.28;
      margin-bottom:11px; transition:opacity .42s,transform .42s;
    }
    .panel-desc { font-size:.84rem; opacity:.7; line-height:1.65; transition:opacity .42s .07s,transform .42s .07s; }

    .panel-bottom { position:relative;z-index:2; text-align:center; }
    .panel-steps { display:flex;gap:9px;margin-bottom:14px;justify-content:center; }
    .step-dot {
      height:4px; border-radius:99px;
      background:rgba(255,255,255,.28); cursor:pointer;
      transition:all .42s cubic-bezier(.34,1.56,.64,1);
    }
    .step-dot.active { background:var(--white);width:28px!important; }
    .step-dot:not(.active) { width:10px; }
    .panel-hint { font-size:.73rem;opacity:.45;text-transform:uppercase;letter-spacing:.4px;font-weight:500; }

    /* ══ RIGHT PANEL ══ */
    .panel-right {
      flex:1;
      background: var(--white);
      display:flex; flex-direction:column; overflow:hidden;
      position: relative;
    }
    .panel-right::before {
      content:'';
      position:absolute; top:0; left:0; right:0; height:3px;
      background: linear-gradient(90deg, var(--green) 0%, var(--green-light) 50%, var(--violet) 100%);
      z-index: 10;
    }

    /* ══ TABS ══ */
    .tabs-bar {
      display:flex;
      padding: 0 36px;
      background: var(--white);
      border-bottom: 1.5px solid var(--border);
      flex-shrink:0;
      gap: 4px;
      position: relative;
      z-index: 5;
    }
    .tab-btn {
      flex:1; padding: 16px 8px 14px;
      background:none; border:none;
      font-family:'Outfit',sans-serif; font-size:.875rem; font-weight:600;
      color:var(--text-sec); cursor:pointer;
      position:relative; transition: color .3s;
      display:flex; align-items:center; justify-content:center; gap:8px;
      letter-spacing: .2px;
    }
    .tab-btn::after {
      content:''; position:absolute; bottom:-1.5px; left:16px; right:16px;
      height:3px; border-radius:3px 3px 0 0;
      background: linear-gradient(90deg, var(--green), var(--green-light));
      transform:scaleX(0); transition:transform .38s cubic-bezier(.34,1.56,.64,1);
      transform-origin: left;
    }
    .tab-btn.active { color:var(--green); }
    .tab-btn.active::after { transform:scaleX(1); }
    .tab-icon {
      width:17px; height:17px;
      background: var(--bg); border-radius:8px; padding:3px;
      transition: background .25s, transform .28s, color .25s;
      display: flex; align-items:center; justify-content:center;
      flex-shrink:0;
    }
    .tab-icon svg { width:11px; height:11px; }
    .tab-btn.active .tab-icon { background: var(--green-xpale); color: var(--green); }
    .tab-btn:hover .tab-icon { transform:scale(1.15); }
    .tab-badge {
      font-size:.62rem; font-weight:700; padding:1px 7px; border-radius:99px;
      background: var(--violet-light); color: var(--violet);
      letter-spacing:.3px; text-transform:uppercase;
      opacity:0; transform:scale(.7); transition: opacity .3s, transform .3s;
    }
    .tab-btn.active .tab-badge { opacity:1; transform:scale(1); }

    /* ══ FORMS CONTAINER ══ */
    .forms-wrap { flex:1; position:relative; overflow:hidden; }
    .form-panel {
      position:absolute; inset:0; overflow-y:auto;
      padding: 26px 36px 28px;
      transition:opacity .42s cubic-bezier(.22,1,.36,1), transform .42s cubic-bezier(.22,1,.36,1);
      will-change:transform,opacity;
      scrollbar-width:thin; scrollbar-color:var(--border) transparent;
    }
    .form-panel::-webkit-scrollbar { width:4px; }
    .form-panel::-webkit-scrollbar-thumb { background:var(--border);border-radius:99px; }
    .form-panel::-webkit-scrollbar-track { background:transparent; }
    .form-panel.active          { opacity:1;transform:translateX(0); }
    .form-panel.slide-out-left  { opacity:0;transform:translateX(-52px);pointer-events:none; }
    .form-panel.slide-out-right { opacity:0;transform:translateX(52px);pointer-events:none; }

    /* ══ FORM HEADER ══ */
    .form-header { margin-bottom:18px; }
    .form-title {
      font-family:'Playfair Display',serif; font-size:1.5rem;
      color:var(--text); margin-bottom:4px; line-height:1.2;
      display:flex; align-items:center; gap:9px;
    }
    .form-title-icon {
      width:34px; height:34px; border-radius:10px;
      background: linear-gradient(135deg, var(--green), var(--green-mid));
      display:grid; place-items:center; flex-shrink:0;
      box-shadow: 0 4px 12px rgba(27,67,50,.25);
    }
    .form-title-icon svg { width:16px; height:16px; color:#fff; }
    .form-sub {
      font-size:.83rem; color:var(--text-sec); line-height:1.5;
      display:flex; align-items:center; gap:8px;
    }
    .form-sub-badge {
      display:inline-flex; align-items:center; gap:4px;
      background: var(--violet-light); color: var(--violet);
      font-size:.69rem; font-weight:700; border-radius:99px; padding:2px 9px;
      letter-spacing:.4px; text-transform:uppercase;
      flex-shrink: 0;
    }

    .section-divider {
      display: flex; align-items: center; gap:10px;
      margin: 4px 0 8px;
    }
    .section-divider-line { flex:1; height:1px; background: var(--border); }
    .section-divider-label {
      font-size:.67rem; font-weight:700; letter-spacing:.8px;
      text-transform:uppercase; color:var(--text-sec);
      white-space: nowrap;
    }

    /* ══ ALERTS ══ */
    .alert {
      border-radius:13px; padding:11px 14px; font-size:.82rem;
      display:flex; align-items:flex-start; gap:10px; margin-bottom:14px;
      animation:alertIn .35s cubic-bezier(.22,1,.36,1) both;
      border-left:3px solid transparent;
    }
    @keyframes alertIn { from{opacity:0;transform:translateY(-8px)} to{opacity:1;transform:none} }
    .alert-error {
      background:#FEF2F2; border-color:#EF4444;
      color:#991B1B; border:1px solid #FCA5A5; border-left:3px solid #EF4444;
    }
    .alert-success {
      background:var(--green-xpale); color:var(--green);
      border:1px solid var(--green-pale); border-left:3px solid var(--green-light);
    }
    .alert-oauth {
      background: #FFF7ED;
      border: 1px solid #FED7AA;
      border-left: 3px solid #F97316;
      color: #9A3412;
    }
    .alert svg { flex-shrink:0; margin-top:1px; }

    /* ══ FORM LAYOUT ══ */
    .form-grid { display:flex; flex-direction:column; gap:11px; }
    .row-2 { display:flex; gap:10px; }
    .row-2 .field { flex:1; }
    .field { display:flex; flex-direction:column; gap:4px; }
    .field > label {
      font-size:.71rem; font-weight:700; color: var(--text);
      letter-spacing:.65px; text-transform:uppercase;
      display:flex; align-items:center; gap:5px;
    }
    .label-required { color:#EF4444; font-size:.8rem; }

    /* ══ INPUTS ══ */
    .input-wrap {
      position:relative; display:flex; align-items:center;
      border-radius:12px; overflow:hidden;
      transition: box-shadow .25s;
    }
    .input-wrap:focus-within { box-shadow: 0 0 0 3px rgba(45,106,79,.14); }
    .field-icon {
      position:absolute; left:13px; width:15px; height:15px;
      color:var(--text-sec); pointer-events:none; z-index:1;
      transition:color .25s, transform .25s;
    }
    .input-wrap:focus-within .field-icon { color: var(--green-mid); transform: scale(1.1); }
    .input-wrap input, .input-wrap select {
      width:100%; padding:11px 13px 11px 40px;
      border:1.5px solid var(--border); border-radius:12px;
      font-family:'Outfit',sans-serif; font-size:.875rem;
      color:var(--text); background:var(--bg); outline:none;
      transition:border-color .25s, background .25s;
      -webkit-appearance:none;
    }
    .input-wrap input:focus, .input-wrap select:focus {
      border-color: var(--green-mid); background: var(--white);
    }
    .input-wrap input:hover:not(:focus), .input-wrap select:hover:not(:focus) {
      background:var(--hover-row); border-color: rgba(45,106,79,.4);
    }
    .input-wrap input:not(:placeholder-shown):not(:focus) {
      border-color: rgba(27,67,50,.25); background: var(--white);
    }
    .eye-btn {
      position:absolute; right:9px; background:none; border:none;
      cursor:pointer; color:var(--text-sec);
      width:28px; height:28px; display:grid; place-items:center;
      border-radius:8px; transition:color .2s, background .2s; z-index:2;
    }
    .eye-btn:hover { color:var(--green); background:rgba(27,67,50,.08); }
    .eye-btn svg { width:14px; height:14px; }

    /* ══ AVATAR FIELD ══ */
    .avatar-row { display:flex; align-items:flex-start; gap:14px; }
    .avatar-preview {
      width:58px; height:58px; border-radius:14px; flex-shrink:0;
      border:2px dashed var(--border); overflow:hidden;
      display:grid; place-items:center; background:var(--bg);
      transition:border-color .25s, box-shadow .25s;
    }
    .avatar-preview img { width:100%; height:100%; object-fit:cover; display:none; }
    .avatar-ph svg { width:22px; height:22px; color:var(--text-sec); }
    .avatar-actions { display:flex; flex-direction:column; gap:6px; flex:1; }
    .avatar-btn {
      display:flex; align-items:center; gap:8px; padding:8px 13px;
      border:1.5px solid var(--border); border-radius:10px;
      background:var(--bg); color:var(--text-sec);
      font-family:'Outfit',sans-serif; font-size:.78rem; font-weight:600;
      cursor:pointer; transition:all .22s; text-align:left;
    }
    .avatar-btn svg { width:13px; height:13px; flex-shrink:0; }
    .avatar-btn:hover { border-color:var(--green); color:var(--green); background:var(--green-xpale); }
    .avatar-btn.cam-on { border-color:var(--green); color:var(--green); background:var(--green-xpale); }
    .avatar-filename { font-size:.71rem; color:var(--text-sec); font-style:italic; }
    .cam-wrap {
      display:none; flex-direction:column; gap:9px;
      border:1.5px solid var(--border); border-radius:13px;
      padding:11px; background:var(--bg); margin-top:4px;
    }
    .cam-wrap.open { display:flex; }
    #camVideo { width:100%; border-radius:9px; max-height:240px; object-fit:cover; background:#000; }
    .cam-controls { display:flex; gap:8px; }
    .cam-snap, .cam-cancel {
      flex:1; padding:9px; border:none; border-radius:9px;
      font-family:'Outfit',sans-serif; font-size:.82rem; font-weight:600;
      cursor:pointer; transition:all .2s;
    }
    .cam-snap   { background:var(--green); color:#fff; }
    .cam-snap:hover   { background:var(--green-mid); transform:translateY(-1px); }
    .cam-cancel { background:var(--border); color:var(--text-sec); }
    .cam-cancel:hover { background:#c8d0da; color:var(--text); }

    /* ══ ROLE CARDS ══ */
    .role-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:7px; }
    .role-card {
      border:1.5px solid var(--border); border-radius:12px;
      padding:10px 5px 9px; cursor:pointer; text-align:center;
      background:var(--bg); transition:all .22s; position:relative; overflow:hidden;
    }
    .role-card input[type=radio] { display:none; }
    .role-card:hover { border-color:var(--green-light); background:var(--white); transform:translateY(-2px); box-shadow:0 6px 18px rgba(27,67,50,.12); }
    .role-card.selected { border-color:var(--green); background:rgba(27,67,50,.05); box-shadow:0 0 0 3px rgba(27,67,50,.1); }
    .role-card.selected::after { content:'✓'; position:absolute; top:4px; right:6px; font-size:.58rem; font-weight:900; color:var(--green); }
    .role-icon  { font-size:1.2rem; margin-bottom:4px; display:block; }
    .role-label { font-size:.67rem; font-weight:700; color:var(--text-sec); letter-spacing:.3px; }
    .role-card.selected .role-label { color:var(--green); }

    /* ══ STRENGTH BAR ══ */
    .strength-wrap { display:flex; align-items:center; gap:8px; margin-top:5px; }
    .strength-bar { display:flex; gap:3px; flex:1; }
    .strength-seg { height:3px; flex:1; border-radius:99px; background:var(--border); transition:background .3s, transform .2s; }
    .strength-label { font-size:.67rem; font-weight:700; letter-spacing:.4px; color:var(--text-sec); white-space:nowrap; transition:color .3s; text-transform:uppercase; }

    /* ══ CHECKBOX ══ */
    .check-label { display:flex; align-items:center; gap:9px; cursor:pointer; font-size:.82rem; color:var(--text-sec); transition:color .2s; }
    .check-label:hover { color:var(--text); }
    .check-label input[type=checkbox] { display:none; }
    .check-box { width:19px; height:19px; flex-shrink:0; border:1.5px solid var(--border); border-radius:6px; display:grid; place-items:center; background:var(--bg); transition:all .22s; }
    .check-label input:checked ~ .check-box { background: linear-gradient(135deg, var(--green), var(--green-mid)); border-color:var(--green); box-shadow:0 2px 8px rgba(27,67,50,.3); }
    .check-box svg { display:none; }
    .check-label input:checked ~ .check-box svg { display:block; }

    .options-row { display:flex; align-items:center; justify-content:space-between; font-size:.82rem; }
    .link { color:var(--green); text-decoration:none; font-weight:600; transition:opacity .2s, letter-spacing .2s; display:inline-flex; align-items:center; gap:3px; }
    .link:hover { opacity:.72; letter-spacing:.3px; }
    .link-violet { color:var(--violet); text-decoration:none; font-weight:600; font-size:.81rem; transition:color .2s; display:inline-flex; align-items:center; gap:4px; }
    .link-violet:hover { color:var(--green-mid); }
    .link-violet::after { content:'→'; font-size:.75rem; transition:transform .2s; }
    .link-violet:hover::after { transform:translateX(2px); }

    /* ══ SUBMIT BUTTON ══ */
    .btn-primary {
      width:100%; padding:13px;
      background: linear-gradient(135deg, var(--green) 0%, var(--green-mid) 100%);
      color:var(--white); border:none; border-radius:13px;
      font-family:'Outfit',sans-serif; font-size:.92rem; font-weight:700;
      cursor:pointer; letter-spacing:.4px;
      position:relative; overflow:hidden;
      transition:transform .18s, box-shadow .25s;
      margin-top:4px;
      display:flex; align-items:center; justify-content:center; gap:10px;
    }
    .btn-primary::before {
      content:''; position:absolute; top:0; left:-100%; width:60%; height:100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,.2), transparent);
      transform:skewX(-20deg); transition:left .55s ease;
    }
    .btn-primary:hover { transform:translateY(-2px); box-shadow:0 12px 32px rgba(27,67,50,.35); }
    .btn-primary:hover::before { left:140%; }
    .btn-primary:active { transform:translateY(0); }
    .btn-arrow { width:28px; height:28px; border-radius:8px; background:rgba(255,255,255,.15); display:grid; place-items:center; transition:transform .25s, background .25s; flex-shrink:0; }
    .btn-arrow svg { width:13px; height:13px; }
    .btn-primary:hover .btn-arrow { transform:translateX(4px); background:rgba(255,255,255,.25); }

    .divider { display:flex; align-items:center; gap:10px; color:var(--text-sec); font-size:.74rem; margin:2px 0; letter-spacing:.4px; text-transform:uppercase; font-weight:600; }
    .divider::before,.divider::after { content:''; flex:1; height:1px; background:var(--border); }
    .bottom-link { text-align:center; font-size:.82rem; color:var(--text-sec); }

    /* ══ FIELD ERRORS ══ */
    .field-error { font-size:.71rem; color:#DC2626; margin-top:2px; display:none; align-items:center; gap:4px; animation:alertIn .25s cubic-bezier(.22,1,.36,1) both; }
    .field-error.show { display:flex; }
    .field-error::before { content:'⚠'; font-size:.73rem; }
    .input-wrap.is-invalid input, .input-wrap.is-invalid select { border-color:#FCA5A5 !important; background:#FFF5F5 !important; box-shadow:0 0 0 3px rgba(220,38,38,.08) !important; }
    input, select, textarea { outline:none; }

    .login-info-card {
      background: linear-gradient(135deg, var(--green-xpale), var(--bg));
      border:1px solid var(--green-pale); border-radius:13px;
      padding:12px 14px; display:flex; align-items:flex-start; gap:10px;
      margin-bottom:2px;
      animation: cardIn .5s .2s cubic-bezier(.22,1,.36,1) both;
    }
    .login-info-icon { width:28px; height:28px; border-radius:8px; background:var(--green); display:grid; place-items:center; flex-shrink:0; }
    .login-info-icon svg { width:13px; height:13px; color:#fff; }
    .login-info-text { font-size:.79rem; color:var(--text-sec); line-height:1.5; }
    .login-info-text strong { color:var(--text); font-weight:600; }

    .trust-row { display:flex; align-items:center; gap:10px; justify-content:center; margin-top:4px; }
    .trust-badge { display:flex; align-items:center; gap:4px; font-size:.69rem; color:var(--text-sec); font-weight:500; }
    .trust-badge svg { width:11px; height:11px; color:var(--green-light); }

    /* ══ SOCIAL LOGIN ══ */
    .social-divider { display: flex; align-items: center; gap: 12px; margin: 2px 0 10px; }
    .social-divider-line { flex: 1; height: 1px; background: var(--border); }
    .social-divider-text { font-size: .72rem; font-weight: 700; letter-spacing: .7px; text-transform: uppercase; color: var(--text-sec); white-space: nowrap; padding: 0 2px; }
    .social-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; }
    .btn-social { display: flex; align-items: center; justify-content: center; gap: 9px; padding: 11px 14px; border-radius: 13px; border: 1.5px solid var(--border); background: var(--white); font-family: 'Outfit', sans-serif; font-size: .85rem; font-weight: 600; color: var(--text); cursor: pointer; text-decoration: none; position: relative; overflow: hidden; transition: border-color .22s, box-shadow .22s, transform .18s, background .22s; letter-spacing: .15px; }
    .btn-social::before { content: ''; position: absolute; top: 0; left: -80%; width: 50%; height: 100%; background: linear-gradient(90deg, transparent, rgba(255,255,255,.55), transparent); transform: skewX(-18deg); transition: left .5s ease; pointer-events: none; }
    .btn-social:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(0,0,0,.09); }
    .btn-social:hover::before { left: 130%; }
    .btn-social-google { border-color: rgba(234,67,53,.3); }
    .btn-social-google:hover { border-color: #EA4335; background: rgba(234,67,53,.04); box-shadow: 0 8px 22px rgba(234,67,53,.15); }
    .btn-social-github { border-color: rgba(36,41,47,.25); }
    .btn-social-github:hover { border-color: #24292F; background: rgba(36,41,47,.04); box-shadow: 0 8px 22px rgba(36,41,47,.12); }
    .social-icon { width: 22px; height: 22px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 6px; transition: transform .25s cubic-bezier(.34,1.56,.64,1); }
    .btn-social:hover .social-icon { transform: scale(1.18) rotate(-4deg); }
    .social-icon svg { width: 18px; height: 18px; }
    .social-label { display: flex; flex-direction: column; line-height: 1.1; }
    .social-label-main { font-size: .82rem; font-weight: 700; }
    .social-label-sub  { font-size: .64rem; font-weight: 500; color: var(--text-sec); letter-spacing: .2px; }

    /* ══════════════════════════════════════════
       FACE RECOGNITION PANEL — PRO BIOMETRIC
    ══════════════════════════════════════════ */
    #paneFaceID {
      display: none;
      position: absolute; inset: 0;
      background: #080e14;
      flex-direction: column;
      z-index: 20;
      overflow: hidden;
    }
    #paneFaceID.active-face {
      display: flex;
      animation: faceIn .55s cubic-bezier(.22,1,.36,1) both;
    }
    @keyframes faceIn { from{opacity:0;transform:scale(.96)} to{opacity:1;transform:none} }

    /* Grid lines background */
    #paneFaceID::before {
      content:''; position:absolute; inset:0; z-index:0;
      background-image:
        linear-gradient(rgba(82,183,136,.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(82,183,136,.04) 1px, transparent 1px);
      background-size: 32px 32px;
      pointer-events:none;
    }
    /* Radial glow center */
    #paneFaceID::after {
      content:''; position:absolute; inset:0; z-index:0;
      background: radial-gradient(ellipse 70% 60% at 50% 48%, rgba(45,106,79,.18) 0%, transparent 70%);
      pointer-events:none;
    }

    /* ── TOP BAR ── */
    .face-topbar {
      display: flex; align-items: center; justify-content: space-between;
      padding: 13px 20px 11px;
      border-bottom: 1px solid rgba(82,183,136,.15);
      flex-shrink: 0; position: relative; z-index: 2;
    }
    .face-topbar-title {
      display: flex; align-items: center; gap: 10px;
      font-size: .88rem; font-weight: 700; color: #e2f5eb;
      letter-spacing: .3px;
    }
    .face-topbar-icon-wrap {
      width: 30px; height: 30px; border-radius: 8px;
      background: rgba(82,183,136,.12); border: 1px solid rgba(82,183,136,.25);
      display: grid; place-items: center; flex-shrink: 0;
    }
    .face-topbar-icon-wrap svg { width: 15px; height: 15px; color: var(--green-light); }
    .face-topbar-badge {
      display: flex; align-items: center; gap: 5px;
      background: rgba(82,183,136,.1); color: #52B788;
      border: 1px solid rgba(82,183,136,.25);
      font-size: .64rem; font-weight: 700; letter-spacing: .8px;
      text-transform: uppercase; border-radius: 99px; padding: 3px 10px;
    }
    .face-topbar-badge-dot {
      width: 5px; height: 5px; border-radius: 50%;
      background: #52B788;
      animation: pulse-dot 1.8s ease-in-out infinite;
    }
    @keyframes pulse-dot {
      0%,100%{opacity:1;transform:scale(1)}
      50%{opacity:.35;transform:scale(.6)}
    }
    .face-skip-btn {
      background: transparent; border: 1px solid rgba(255,255,255,.1); border-radius: 8px;
      font-family: 'Outfit', sans-serif; font-size: .72rem; font-weight: 600;
      color: rgba(255,255,255,.4); cursor: pointer; padding: 5px 13px;
      transition: all .22s; letter-spacing: .2px;
    }
    .face-skip-btn:hover { border-color: rgba(82,183,136,.4); color: #52B788; background: rgba(82,183,136,.06); }

    /* ── BODY ── */
    .face-body {
      flex: 1; display: flex; flex-direction: column;
      padding: 14px 20px 16px; gap: 12px; overflow: hidden;
      position: relative; z-index: 2;
    }

    /* ── NO PHOTO STATE ── */
    .face-nophoto {
      display: none;
      flex-direction: column; align-items: center; justify-content: center;
      gap: 16px; flex: 1; text-align: center;
    }
    .face-nophoto.visible { display: flex; }
    .face-nophoto-icon {
      width: 72px; height: 72px; border-radius: 50%;
      background: rgba(245,158,11,.08);
      border: 1.5px solid rgba(245,158,11,.3);
      display: grid; place-items: center;
      box-shadow: 0 0 30px rgba(245,158,11,.1);
    }
    .face-nophoto-icon svg { width: 30px; height: 30px; color: #F59E0B; }
    .face-nophoto h3 { font-size: .95rem; font-weight: 700; color: #e2f5eb; }
    .face-nophoto p { font-size: .8rem; color: rgba(255,255,255,.45); line-height: 1.55; max-width: 250px; }
    .face-nophoto-btns { display: flex; flex-direction: column; gap: 9px; width: 100%; max-width: 270px; }
    .face-nophoto-btn {
      display: flex; align-items: center; justify-content: center; gap: 9px;
      padding: 11px 18px; border-radius: 12px; border: none;
      font-family: 'Outfit', sans-serif; font-size: .84rem; font-weight: 700;
      cursor: pointer; transition: all .22s; position: relative; overflow: hidden;
    }
    .face-nophoto-btn-primary {
      background: linear-gradient(135deg, var(--green), var(--green-mid)); color: #fff;
      box-shadow: 0 4px 18px rgba(27,67,50,.35);
    }
    .face-nophoto-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 26px rgba(27,67,50,.5); }
    .face-nophoto-btn-secondary {
      background: rgba(255,255,255,.05); color: rgba(255,255,255,.6);
      border: 1px solid rgba(255,255,255,.12) !important;
    }
    .face-nophoto-btn-secondary:hover { border-color: rgba(82,183,136,.4) !important; color: #52B788; background: rgba(82,183,136,.07); }

    /* ── UPLOAD WRAP ── */
    .face-upload-wrap { display: none; flex-direction: column; gap: 10px; }
    .face-upload-wrap.visible { display: flex; }
    .face-upload-dropzone {
      border: 1.5px dashed rgba(82,183,136,.3); border-radius: 13px;
      padding: 22px 16px; text-align: center;
      background: rgba(82,183,136,.04); cursor: pointer;
      transition: all .22s;
    }
    .face-upload-dropzone:hover { border-color: rgba(82,183,136,.6); background: rgba(82,183,136,.08); }
    .face-upload-dropzone svg { width: 26px; height: 26px; color: rgba(82,183,136,.6); margin-bottom: 8px; }
    .face-upload-dropzone p { font-size: .79rem; color: rgba(255,255,255,.4); }
    .face-upload-dropzone strong { color: #52B788; }

    .face-cam-wrap {
      display: none; flex-direction: column; gap: 8px;
      border: 1px solid rgba(82,183,136,.2); border-radius: 12px;
      padding: 10px; background: rgba(0,0,0,.3);
    }
    .face-cam-wrap.open { display: flex; }
    #faceCamVideo { width: 100%; border-radius: 8px; max-height: 150px; object-fit: cover; background: #000; }
    /* Mirror only the live video preview, not the canvas used for detection */
    #faceVideo { transform: scaleX(-1); }
    .face-cam-controls { display: flex; gap: 7px; }
    .face-cam-btn {
      flex: 1; padding: 8px; border: none; border-radius: 9px;
      font-family: 'Outfit', sans-serif; font-size: .79rem; font-weight: 600;
      cursor: pointer; transition: all .2s;
    }
    .face-cam-snap { background: var(--green); color: #fff; }
    .face-cam-snap:hover { background: var(--green-mid); }
    .face-cam-cancel { background: rgba(255,255,255,.08); color: rgba(255,255,255,.5); }

    /* ══════════════════════════
       MAIN RECOGNITION AREA
    ══════════════════════════ */
    .face-main { display: none; flex-direction: column; gap: 12px; flex: 1; }
    .face-main.visible { display: flex; }

    /* Two-column layout */
    .face-layout { display: flex; gap: 14px; flex: 1; min-height: 0; }

    /* ── PROFILE SIDE ── */
    .face-profile-side {
      display: flex; flex-direction: column; gap: 8px;
      width: 118px; flex-shrink: 0; align-items: center;
    }
    .face-profile-label {
      font-size: .6rem; font-weight: 700; letter-spacing: .8px;
      text-transform: uppercase; color: rgba(82,183,136,.7); text-align: center;
    }
    .face-profile-img-wrap {
      position: relative;
      width: 118px; height: 118px; border-radius: 18px; overflow: visible;
      flex-shrink: 0;
    }
    .face-profile-img-wrap img {
      width: 100%; height: 100%; object-fit: cover;
      border-radius: 16px; display: block;
      border: 1.5px solid rgba(82,183,136,.2);
    }
    /* Animated outer ring on profile */
    .face-profile-ring {
      position: absolute; inset: -6px; border-radius: 22px;
      border: 1.5px solid rgba(82,183,136,.2);
      pointer-events: none;
      transition: border-color .4s;
    }
    .face-profile-ring-2 {
      position: absolute; inset: -12px; border-radius: 28px;
      border: 1px solid rgba(82,183,136,.08);
      pointer-events: none;
      transition: border-color .4s;
    }
    .face-profile-overlay {
      position: absolute; inset: 0; border-radius: 16px;
      border: 2px solid transparent;
      transition: border-color .5s, box-shadow .5s;
      pointer-events: none;
    }
    .face-profile-overlay.success {
      border-color: #52B788;
      box-shadow: 0 0 0 3px rgba(82,183,136,.2), inset 0 0 22px rgba(82,183,136,.12);
    }
    .face-profile-overlay.success ~ .face-profile-ring { border-color: rgba(82,183,136,.5); animation: ringPulse 1.8s ease-in-out infinite; }
    .face-profile-overlay.fail {
      border-color: var(--red);
      box-shadow: 0 0 0 3px rgba(239,68,68,.2), inset 0 0 22px rgba(239,68,68,.1);
    }
    @keyframes ringPulse {
      0%,100%{transform:scale(1);opacity:.8}
      50%{transform:scale(1.04);opacity:.3}
    }

    /* Biometric landmarks overlay (drawn on canvas) */
    .face-profile-scan-badge {
      position: absolute; bottom: -10px; left: 50%; transform: translateX(-50%);
      background: rgba(8,14,20,.85); border: 1px solid rgba(82,183,136,.3);
      border-radius: 6px; padding: 3px 9px;
      font-size: .58rem; font-weight: 700; letter-spacing: .6px; text-transform: uppercase;
      color: #52B788; white-space: nowrap; z-index: 3;
    }

    /* ── CAMERA SIDE ── */
    .face-cam-side {
      flex: 1; display: flex; flex-direction: column; gap: 8px; min-width: 0;
    }
    .face-cam-label {
      font-size: .6rem; font-weight: 700; letter-spacing: .8px;
      text-transform: uppercase; color: rgba(82,183,136,.7); text-align: center;
    }
    .face-video-container {
      position: relative; flex: 1; min-height: 120px; max-height: 185px;
      border-radius: 16px; overflow: hidden;
      background: #060b10;
      border: 1.5px solid rgba(82,183,136,.18);
      box-shadow: inset 0 0 40px rgba(0,0,0,.5);
    }
    #faceVideo {
      width: 100%; height: 100%; object-fit: cover;
      border-radius: 14px;
      transform: scaleX(-1);
    }
    #faceCanvas {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      pointer-events: none;
      transform: scaleX(-1);
    }

    /* ── SCAN LINE ── */
    .face-scan-line {
      position: absolute; left: 0; right: 0; height: 2px;
      background: linear-gradient(90deg, transparent 0%, rgba(82,183,136,0) 10%, rgba(82,183,136,.9) 50%, rgba(82,183,136,0) 90%, transparent 100%);
      opacity: 0; top: 0; z-index: 4; pointer-events: none;
    }
    .face-scan-line.scanning {
      opacity: 1;
      animation: scanLine 2.2s cubic-bezier(.4,0,.6,1) infinite;
    }
    /* Glow below scan line */
    .face-scan-line::after {
      content:''; position:absolute; top:0; left:0; right:0; height:24px;
      background: linear-gradient(to bottom, rgba(82,183,136,.12), transparent);
      transform: translateY(-2px);
    }
    @keyframes scanLine {
      0%   { top: -2px; opacity: 0; }
      8%   { opacity: 1; }
      92%  { opacity: 1; }
      100% { top: 100%; opacity: 0; }
    }

    /* ── CORNER BRACKETS ── */
    .face-corners {
      position: absolute; inset: 10px; pointer-events: none; z-index: 3;
    }
    .face-corner {
      position: absolute; width: 22px; height: 22px;
      border-color: rgba(82,183,136,.5); border-style: solid;
      border-width: 0; transition: border-color .4s, width .4s, height .4s;
    }
    .face-corners.scanning .face-corner { width: 28px; height: 28px; border-color: rgba(82,183,136,.9); }
    .face-corner.tl { top:0; left:0;  border-top-width:2px; border-left-width:2px; border-radius:4px 0 0 0; }
    .face-corner.tr { top:0; right:0; border-top-width:2px; border-right-width:2px; border-radius:0 4px 0 0; }
    .face-corner.bl { bottom:0; left:0;  border-bottom-width:2px; border-left-width:2px; border-radius:0 0 0 4px; }
    .face-corner.br { bottom:0; right:0; border-bottom-width:2px; border-right-width:2px; border-radius:0 0 4px 0; }
    .face-corners.success .face-corner { border-color: #52B788; width:28px; height:28px; }
    .face-corners.fail    .face-corner { border-color: #EF4444; }

    /* ── HUD DOTS (decorative top-left/top-right indicators) ── */
    .face-hud-tl, .face-hud-tr {
      position: absolute; top: 10px; z-index: 5;
      display: flex; align-items: center; gap: 5px;
      font-size: .56rem; font-weight: 700; letter-spacing: .5px; text-transform: uppercase;
    }
    .face-hud-tl { left: 14px; color: rgba(82,183,136,.65); }
    .face-hud-tr { right: 14px; color: rgba(82,183,136,.65); }
    .face-hud-dot { width: 5px; height: 5px; border-radius: 50%; background: rgba(82,183,136,.6); }
    .face-hud-dot.blink { animation: blinkDot 1.2s ease-in-out infinite; }
    @keyframes blinkDot { 0%,100%{opacity:1} 50%{opacity:.2} }

    /* ── BIOMETRIC GRID POINTS (canvas drawn, but we add a subtle crosshair reticle) ── */
    .face-reticle {
      position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
      width: 56px; height: 56px; border-radius: 50%;
      border: 1px solid rgba(82,183,136,.18);
      pointer-events: none; z-index: 2;
    }
    .face-reticle::before {
      content:''; position:absolute; top:50%; left:0; right:0; height:1px;
      background: rgba(82,183,136,.12); transform: translateY(-50%);
    }
    .face-reticle::after {
      content:''; position:absolute; left:50%; top:0; bottom:0; width:1px;
      background: rgba(82,183,136,.12); transform: translateX(-50%);
    }

    /* ── DATA GRID BELOW VIDEO ── */
    .face-data-grid {
      display: grid; grid-template-columns: 1fr 1fr 1fr;
      gap: 5px; flex-shrink: 0;
    }
    .face-data-cell {
      background: rgba(255,255,255,.03); border: 1px solid rgba(82,183,136,.1);
      border-radius: 8px; padding: 5px 7px; text-align: center;
    }
    .face-data-cell-label {
      font-size: .52rem; font-weight: 700; letter-spacing: .6px; text-transform: uppercase;
      color: rgba(82,183,136,.5); margin-bottom: 2px;
    }
    .face-data-cell-val {
      font-size: .7rem; font-weight: 700; color: rgba(255,255,255,.7);
      font-variant-numeric: tabular-nums;
    }

    /* ── STATUS ROW ── */
    .face-status-row {
      display: flex; align-items: center; gap: 10px;
      padding: 9px 14px;
      border-radius: 11px;
      background: rgba(255,255,255,.04);
      border: 1px solid rgba(255,255,255,.07);
      font-size: .78rem; font-weight: 600;
      transition: all .35s; color: rgba(255,255,255,.6);
      flex-shrink: 0;
    }
    .face-status-row.scanning  { background: rgba(59,130,246,.08); border-color: rgba(59,130,246,.2); color: #93C5FD; }
    .face-status-row.success   { background: rgba(82,183,136,.1); border-color: rgba(82,183,136,.25); color: #52B788; }
    .face-status-row.fail      { background: rgba(239,68,68,.08); border-color: rgba(239,68,68,.2); color: #FCA5A5; }
    .face-status-row.warning   { background: rgba(245,158,11,.08); border-color: rgba(245,158,11,.2); color: #FCD34D; }
    .face-status-row.loading   { background: rgba(139,92,246,.08); border-color: rgba(139,92,246,.2); color: #C4B5FD; }

    .face-status-icon {
      width: 22px; height: 22px; border-radius: 50%;
      display: grid; place-items: center; flex-shrink: 0;
      font-size: .8rem;
    }
    .face-spinner {
      width: 16px; height: 16px; border-radius: 50%;
      border: 2px solid rgba(139,92,246,.2);
      border-top-color: #8B5CF6;
      animation: spin .7s linear infinite;
      flex-shrink: 0;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .face-status-text { flex: 1; }

    /* ── SIMILARITY SCORE ── */
    .face-score-wrap { display: none; align-items: center; gap: 10px; flex-shrink: 0; }
    .face-score-wrap.visible { display: flex; }
    .face-score-label {
      font-size: .58rem; font-weight: 700; letter-spacing: .7px;
      text-transform: uppercase; color: rgba(82,183,136,.6); white-space: nowrap;
    }
    .face-score-bar-bg {
      flex: 1; height: 5px; border-radius: 99px;
      background: rgba(255,255,255,.07); overflow: hidden;
    }
    .face-score-bar-fill {
      height: 100%; border-radius: 99px;
      width: 0%; transition: width 1.1s cubic-bezier(.22,1,.36,1);
      background: linear-gradient(90deg, #EF4444, #F59E0B 40%, #52B788);
    }
    .face-score-val {
      font-size: .72rem; font-weight: 700; color: rgba(255,255,255,.8);
      white-space: nowrap; font-variant-numeric: tabular-nums;
      min-width: 36px; text-align: right;
    }

    /* ── BIOMETRIC DOTS LINE (decorative progress indicator) ── */
    .face-biometric-steps {
      display: flex; align-items: center; gap: 6px;
      justify-content: center; flex-shrink: 0;
    }
    .face-bio-step {
      display: flex; align-items: center; gap: 6px;
      font-size: .6rem; font-weight: 700; letter-spacing: .5px;
      text-transform: uppercase; color: rgba(82,183,136,.35);
      transition: color .4s;
    }
    .face-bio-step.active { color: rgba(82,183,136,.85); }
    .face-bio-step.done { color: rgba(82,183,136,.5); }
    .face-bio-dot {
      width: 5px; height: 5px; border-radius: 50%;
      background: rgba(82,183,136,.2); flex-shrink: 0;
      transition: background .4s, box-shadow .4s;
    }
    .face-bio-step.active .face-bio-dot { background: #52B788; box-shadow: 0 0 8px rgba(82,183,136,.6); }
    .face-bio-step.done .face-bio-dot { background: rgba(82,183,136,.4); }
    .face-bio-line { flex: 1; height: 1px; background: rgba(82,183,136,.1); max-width: 24px; }

    /* ── ACTION BUTTONS ── */
    .face-action-wrap { display: flex; gap: 8px; flex-shrink: 0; }
    .face-btn-scan {
      flex: 1; padding: 12px; border: none; border-radius: 12px;
      background: linear-gradient(135deg, var(--green) 0%, var(--green-mid) 100%);
      color: #fff; font-family: 'Outfit', sans-serif; font-size: .87rem; font-weight: 700;
      cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 9px;
      transition: all .22s; position: relative; overflow: hidden;
      box-shadow: 0 4px 18px rgba(27,67,50,.4), inset 0 1px 0 rgba(255,255,255,.15);
      letter-spacing: .2px;
    }
    .face-btn-scan::before {
      content:''; position:absolute; top:0; left:-80%; width:50%; height:100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,.18), transparent);
      transform: skewX(-20deg); transition: left .5s;
    }
    .face-btn-scan:hover { transform: translateY(-2px); box-shadow: 0 8px 26px rgba(27,67,50,.55); }
    .face-btn-scan:hover::before { left: 130%; }
    .face-btn-scan:disabled { opacity: .45; cursor: not-allowed; transform: none; box-shadow: none; }
    .face-btn-retry {
      padding: 12px 15px; border-radius: 12px;
      border: 1px solid rgba(255,255,255,.1);
      background: rgba(255,255,255,.05); color: rgba(255,255,255,.5);
      font-family: 'Outfit', sans-serif; font-size: .82rem; font-weight: 600;
      cursor: pointer; transition: all .22s; display: none;
    }
    .face-btn-retry.visible { display: flex; align-items: center; gap: 6px; }
    .face-btn-retry:hover { border-color: rgba(82,183,136,.4); color: #52B788; background: rgba(82,183,136,.07); }

    /* ── MODELS LOADING OVERLAY ── */
    .face-loading-overlay {
      display: none; position: absolute; inset: 0;
      background: rgba(6,11,16,.88);
      border-radius: 13px;
      flex-direction: column; align-items: center; justify-content: center;
      gap: 11px; z-index: 5; backdrop-filter: blur(2px);
    }
    .face-loading-overlay.visible { display: flex; }
    .face-loading-spinner {
      width: 34px; height: 34px; border-radius: 50%;
      border: 2.5px solid rgba(82,183,136,.1);
      border-top-color: #52B788;
      animation: spin .85s linear infinite;
    }
    .face-loading-text { font-size: .8rem; color: rgba(82,183,136,.7); font-weight: 600; letter-spacing: .2px; }
    .face-loading-progress {
      width: 130px; height: 3px; background: rgba(82,183,136,.1); border-radius: 99px; overflow: hidden;
    }
    .face-loading-fill {
      height: 100%; background: linear-gradient(90deg, var(--green-mid), var(--green-light));
      border-radius: 99px; width: 0%; transition: width .4s ease;
    }

    /* ══ MOBILE ══ */
    @media (max-width:720px) {
      .panel-left { display:none; }
      .card { max-width:480px; height:100vh; border-radius:0; }
      .tabs-bar,.form-panel { padding-left:18px; padding-right:18px; }
      .role-grid { grid-template-columns:repeat(2,1fr); }
      .row-2 { flex-direction:column; }
      .face-layout { flex-direction: column; }
      .face-profile-side { width: 100%; flex-direction: row; align-items: center; }
      .face-profile-img-wrap { width: 80px; height: 80px; }
      .face-data-grid { grid-template-columns: 1fr 1fr 1fr; }
      .face-biometric-steps { display: none; }
    }
  </style>
</head>
<body>

<div class="bg-canvas"></div>

<div class="wrapper">
  <div class="card">

    <!-- ══ LEFT PANEL ══ -->
    <div class="panel-left">
      <div class="ring-mid"></div>
      <div class="brand">
        <img src="{{ asset('images/logo.png') }}"
             class="logo-img" id="logoImg" alt="MindAura"
             onerror="this.style.display='none';document.getElementById('logoFallback').style.display='block'"/>
        <svg id="logoFallback" class="logo-fallback" viewBox="0 0 72 72" fill="none">
          <circle cx="36" cy="36" r="34" fill="rgba(255,255,255,.1)" stroke="rgba(255,255,255,.25)" stroke-width="1.5"/>
          <path d="M18 46C18 46 22 32 28 29C34 26 34 38 34 38C34 38 34 26 40 29C46 32 50 46 50 46"
                stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="36" cy="20" r="5" fill="rgba(216,243,220,.85)"/>
        </svg>
        <span class="brand-name">MindAura</span>
      </div>
      <div class="panel-content">
        <p class="panel-tagline" id="panelTagline">Bienvenue sur votre espace bien-être</p>
        <p class="panel-desc"   id="panelDesc">Connectez-vous pour accéder à votre suivi personnalisé, vos thérapeutes et vos objectifs de développement personnel.</p>
      </div>
      <div class="panel-bottom">
        <div class="panel-steps">
          <div class="step-dot active" id="dot0" onclick="switchTab('login')"></div>
          <div class="step-dot"        id="dot1" onclick="switchTab('register')"></div>
        </div>
        <p class="panel-hint">Psychologie & développement personnel</p>
      </div>
    </div>

    <!-- ══ RIGHT PANEL ══ -->
    <div class="panel-right">

      <!-- TABS BAR -->
      <div class="tabs-bar">
        <button class="tab-btn active" id="tabLogin" onclick="switchTab('login')">
          <span class="tab-icon">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 10h14M10 4l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          Se connecter
          <span class="tab-badge">Accès</span>
        </button>
        <button class="tab-btn" id="tabRegister" onclick="switchTab('register')">
          <span class="tab-icon">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M10 4v12M4 10h12" stroke-linecap="round"/>
            </svg>
          </span>
          S'inscrire
          <span class="tab-badge">Nouveau</span>
        </button>
      </div>

      <div class="forms-wrap">

        <!-- ══ PANE LOGIN ══ -->
        <div class="form-panel active" id="paneLogin">
          <div class="form-header">
            <h1 class="form-title">
              <span class="form-title-icon">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 10h14M10 4l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              Bon retour 👋
            </h1>
            <p class="form-sub">
              Connectez-vous à votre espace&nbsp;
              <span class="form-sub-badge">MindAura</span>
            </p>
          </div>

          {% if error is defined and error %}
            <div class="alert alert-error">
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none">
                <circle cx="8" cy="8" r="7" stroke="#991B1B" stroke-width="1.5"/>
                <path d="M8 5v4M8 11v.5" stroke="#991B1B" stroke-width="1.6" stroke-linecap="round"/>
              </svg>
              <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
            </div>
          {% endif %}

          {% if app.session.flashbag.has('success') %}
            {% for msg in app.session.flashbag.get('success') %}
              <div class="alert alert-success">
                <svg width="15" height="15" viewBox="0 0 16 16" fill="none">
                  <circle cx="8" cy="8" r="7" stroke="#1B4332" stroke-width="1.5"/>
                  <path d="M5 8l2.5 2.5L11 5" stroke="#1B4332" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>{{ msg }}</span>
              </div>
            {% endfor %}
          {% endif %}

          <div class="login-info-card">
            <div class="login-info-icon">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 12a1 1 0 102 0V9a1 1 0 10-2 0v3zm1-7a1 1 0 100 2 1 1 0 000-2z"/>
                <circle cx="10" cy="10" r="8" stroke-width="1.5"/>
              </svg>
            </div>
            <p class="login-info-text">
              <strong>Espace sécurisé :</strong> utilisez votre adresse e-mail et mot de passe. La reconnaissance faciale est disponible après validation de vos identifiants.
            </p>
          </div>

          {% if app.session.get('oauth_error') %}
            <div class="alert alert-oauth">
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none" style="flex-shrink:0">
                <circle cx="8" cy="8" r="7" stroke="#9A3412" stroke-width="1.5"/>
                <path d="M8 5v4M8 11v.5" stroke="#9A3412" stroke-width="1.6" stroke-linecap="round"/>
              </svg>
              <span>Connexion sociale échouée : {{ app.session.get('oauth_error') }}</span>
            </div>
            {{ app.session.remove('oauth_error') }}
          {% endif %}

          <!-- Hidden form that will be submitted after face ID -->
          <form method="post" action="{{ path('app_login') }}" id="loginForm" style="margin-top:14px">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"/>
            <!-- Hidden field to signal face verification passed -->
            <input type="hidden" name="_face_verified" id="faceVerifiedInput" value="0"/>
            <div class="form-grid">

              <div class="field">
                <label for="loginEmail">Adresse e-mail <span class="label-required">*</span></label>
                <div class="input-wrap" id="wrap-login-email">
                  <svg class="field-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="2" y="4" width="16" height="12" rx="2"/>
                    <path d="M2 7l8 5 8-5" stroke-linecap="round"/>
                  </svg>
                  <input type="text" id="loginEmail" name="_username"
                         value="{{ last_username is defined ? last_username : '' }}"
                         placeholder="vous@exemple.com" autocomplete="email"/>
                </div>
                <span class="field-error" id="err-login-email"></span>
              </div>

              <div class="field">
                <label for="loginPass">Mot de passe <span class="label-required">*</span></label>
                <div class="input-wrap" id="wrap-login-pass">
                  <svg class="field-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="4" y="9" width="12" height="9" rx="2"/>
                    <path d="M7 9V6a3 3 0 016 0v3" stroke-linecap="round"/>
                  </svg>
                  <input type="password" id="loginPass" name="_password"
                         placeholder="••••••••" autocomplete="current-password"/>
                  <button type="button" class="eye-btn" onclick="togglePass('loginPass',this)">
                    <svg class="eye-show" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
                      <path d="M1 10s3.5-6 9-6 9 6 9 6-3.5 6-9 6-9-6-9-6z"/>
                      <circle cx="10" cy="10" r="2.5"/>
                    </svg>
                    <svg class="eye-hide" style="display:none" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
                      <path d="M3 3l14 14M8.5 8.6A2.5 2.5 0 0011.4 11.5M6.3 6.4C4.4 7.5 3 9 3 10s3.5 6 7 6a8 8 0 003.7-.9M10 4c3.5 0 7 3 7 6 0 .7-.2 1.5-.6 2.1"/>
                    </svg>
                  </button>
                </div>
                <span class="field-error" id="err-login-pass"></span>
              </div>

              <div class="options-row">
                <label class="check-label">
                  <input type="checkbox" name="_remember_me"/>
                  <span class="check-box">
                    <svg width="9" height="7" viewBox="0 0 10 8" fill="none">
                      <path d="M1 4L3.5 6.5L9 1" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                  Se souvenir de moi
                </label>
                <a href="{{ path('app_forgot_password') }}" class="link-violet">Mot de passe oublié ?</a>
              </div>

              <!-- This button triggers face ID instead of direct submit -->
              <button type="button" class="btn-primary" id="btnLoginNext" onclick="handleLoginNext()">
                <span>Continuer</span>
                <span class="btn-arrow">
                  <svg viewBox="0 0 20 20" fill="none" stroke="white" stroke-width="2.2">
                    <path d="M4 10h12M11 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </button>

              <div class="trust-row">
                <span class="trust-badge">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M8 2l2 4h4l-3.3 2.4 1.3 4L8 10.3 4 12.4l1.3-4L2 6h4z"/>
                  </svg>
                  SSL sécurisé
                </span>
                <span style="color:var(--border)">·</span>
                <span class="trust-badge">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8">
                    <rect x="3" y="7" width="10" height="7" rx="1.5"/>
                    <path d="M5.5 7V5a2.5 2.5 0 015 0v2" stroke-linecap="round"/>
                  </svg>
                  Données chiffrées
                </span>
                <span style="color:var(--border)">·</span>
                <span class="trust-badge">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8">
                    <circle cx="8" cy="8" r="6"/>
                    <path d="M5.5 8l2 2 3-3" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  RGPD conforme
                </span>
              </div>

              <div class="social-divider">
                <div class="social-divider-line"></div>
                <span class="social-divider-text">ou continuer avec</span>
                <div class="social-divider-line"></div>
              </div>

              <div class="social-grid">
                <a href="{{ path('app_oauth_connect_google') }}"
                   class="btn-social btn-social-google"
                   onclick="this.classList.add('loading')"
                   title="Se connecter avec Google">
                  <span class="social-icon">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                      <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                      <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
                      <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                    </svg>
                  </span>
                  <span class="social-label">
                    <span class="social-label-main">Google</span>
                    <span class="social-label-sub">Connexion rapide</span>
                  </span>
                </a>
                <a href="{{ path('app_oauth_connect_github') }}"
                   class="btn-social btn-social-github"
                   onclick="this.classList.add('loading')"
                   title="Se connecter avec GitHub">
                  <span class="social-icon">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="#24292F">
                      <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                    </svg>
                  </span>
                  <span class="social-label">
                    <span class="social-label-main">GitHub</span>
                    <span class="social-label-sub">Compte développeur</span>
                  </span>
                </a>
              </div>

              <div class="divider">ou</div>
              <p class="bottom-link">
                Pas encore de compte ?
                <a href="#" class="link" onclick="switchTab('register');return false;">S'inscrire gratuitement →</a>
              </p>
            </div>
          </form>
        </div><!-- /paneLogin -->

        <!-- ══ FACE RECOGNITION PANEL ══ -->
        <div id="paneFaceID">

          <!-- Top bar -->
          <div class="face-topbar">
            <div class="face-topbar-title">
              <div class="face-topbar-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 2a5 5 0 100 10A5 5 0 0012 2z"/>
                  <path d="M9 9.5C9.5 10.3 10.7 11 12 11s2.5-.7 3-1.5" stroke-linecap="round"/>
                  <path d="M9 7h.01M15 7h.01" stroke-linecap="round"/>
                  <path d="M2 20c0-3.9 3.6-7 10-7s10 3.1 10 7" stroke-linecap="round"/>
                </svg>
              </div>
              Vérification biométrique
            </div>
            <div style="display:flex;gap:8px;align-items:center">
              <div class="face-topbar-badge" id="faceStatusBadge">
                <div class="face-topbar-badge-dot"></div>
                IA Active
              </div>
              <button class="face-skip-btn" id="btnSkipFace" onclick="skipFaceID()">
                Passer
              </button>
            </div>
          </div>

          <!-- Body -->
          <div class="face-body">

            <!-- State: No profile photo -->
            <div class="face-nophoto" id="faceNoPhoto">
              <div class="face-nophoto-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <circle cx="12" cy="8" r="4"/>
                  <path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8" stroke-linecap="round"/>
                  <path d="M19 4l2 2-2 2M21 6h-4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <h3>Photo de profil requise</h3>
              <p>Votre compte n'a pas encore de photo de profil. Ajoutez-en une pour activer la reconnaissance faciale.</p>
              <div class="face-nophoto-btns">
                <button class="face-nophoto-btn face-nophoto-btn-primary" onclick="showFaceUpload('file')">
                  <svg width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="3" width="16" height="14" rx="2"/>
                    <path d="M4 17l4-5 3 3 2-2.5L18 17M6.5 9a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"/>
                  </svg>
                  Choisir une photo
                </button>
                <button class="face-nophoto-btn face-nophoto-btn-secondary" style="border:1px solid rgba(255,255,255,.12)" onclick="showFaceUpload('cam')">
                  <svg width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M2 7a2 2 0 012-2h1l2-2h6l2 2h1a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V7z"/>
                    <circle cx="10" cy="11" r="2.5"/>
                  </svg>
                  Prendre une photo
                </button>
              </div>
            </div>

            <!-- State: Upload form -->
            <div class="face-upload-wrap" id="faceUploadWrap">
              <div style="font-size:.83rem;font-weight:600;color:rgba(255,255,255,.7);margin-bottom:4px">
                Ajouter votre photo de profil
              </div>
              <input type="file" id="faceUploadInput" accept="image/*" style="display:none" onchange="handleFacePhotoUpload(this)"/>
              <div class="face-upload-dropzone" onclick="document.getElementById('faceUploadInput').click()">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M12 15V3M8 7l4-4 4 4" stroke-linecap="round" stroke-linejoin="round"/>
                  <rect x="3" y="15" width="18" height="6" rx="2"/>
                </svg>
                <p>Cliquez pour sélectionner une image<br/><strong>JPG, PNG, WEBP — max 5 Mo</strong></p>
              </div>
              <div class="face-cam-wrap" id="faceCamWrap">
                <video id="faceCamVideo" autoplay playsinline muted></video>
                <canvas id="faceCamCanvas" style="display:none"></canvas>
                <div class="face-cam-controls">
                  <button class="face-cam-btn face-cam-snap" onclick="snapFacePhoto()">Capturer</button>
                  <button class="face-cam-btn face-cam-cancel" onclick="closeFaceCam()">Annuler</button>
                </div>
              </div>
              <button style="padding:7px;border:none;border-radius:9px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);font-family:'Outfit',sans-serif;font-size:.76rem;font-weight:600;color:rgba(255,255,255,.4);cursor:pointer" onclick="cancelFaceUpload()">
                ← Retour
              </button>
            </div>

            <!-- State: Main recognition UI -->
            <div class="face-main" id="faceMain">

              <!-- Biometric steps indicator -->
              <div class="face-biometric-steps" id="faceBioSteps">
                <div class="face-bio-step active" id="bioStep1">
                  <div class="face-bio-dot"></div>
                  Chargement
                </div>
                <div class="face-bio-line"></div>
                <div class="face-bio-step" id="bioStep2">
                  <div class="face-bio-dot"></div>
                  Détection
                </div>
                <div class="face-bio-line"></div>
                <div class="face-bio-step" id="bioStep3">
                  <div class="face-bio-dot"></div>
                  Analyse
                </div>
                <div class="face-bio-line"></div>
                <div class="face-bio-step" id="bioStep4">
                  <div class="face-bio-dot"></div>
                  Résultat
                </div>
              </div>

              <div class="face-layout">

                <!-- Profile photo -->
                <div class="face-profile-side">
                  <div class="face-profile-label">Référence</div>
                  <div class="face-profile-img-wrap">
                    <img id="faceProfileImg" src="" alt="Photo de profil"/>
                    <div class="face-profile-overlay" id="faceProfileOverlay"></div>
                    <div class="face-profile-ring"></div>
                    <div class="face-profile-ring-2"></div>
                    <div class="face-profile-scan-badge" id="faceProfileBadge">Enregistré</div>
                  </div>
                  <div id="faceProfileStatus" style="font-size:.62rem;color:rgba(82,183,136,.55);text-align:center;margin-top:16px;letter-spacing:.4px;text-transform:uppercase;font-weight:700"></div>
                </div>

                <!-- Live camera -->
                <div class="face-cam-side">
                  <div class="face-cam-label">Caméra en direct</div>
                  <div class="face-video-container" id="faceVideoContainer">
                    <video id="faceVideo" autoplay playsinline muted></video>
                    <canvas id="faceCanvas"></canvas>
                    <div class="face-scan-line" id="faceScanLine"></div>
                    <div class="face-corners" id="faceCorners">
                      <div class="face-corner tl"></div>
                      <div class="face-corner tr"></div>
                      <div class="face-corner bl"></div>
                      <div class="face-corner br"></div>
                    </div>
                    <div class="face-reticle"></div>
                    <!-- HUD labels -->
                    <div class="face-hud-tl"><div class="face-hud-dot blink"></div>LIVE</div>
                    <div class="face-hud-tr" id="faceHudFps">— FPS</div>
                    <!-- Models loading overlay -->
                    <div class="face-loading-overlay" id="faceLoadingOverlay">
                      <div class="face-loading-spinner"></div>
                      <div class="face-loading-text" id="faceLoadingText">Chargement des modèles IA…</div>
                      <div class="face-loading-progress">
                        <div class="face-loading-fill" id="faceLoadingFill"></div>
                      </div>
                    </div>
                  </div>

                  <!-- Live data cells -->
                  <div class="face-data-grid" id="faceDataGrid">
                    <div class="face-data-cell">
                      <div class="face-data-cell-label">Visage</div>
                      <div class="face-data-cell-val" id="faceDataFace">—</div>
                    </div>
                    <div class="face-data-cell">
                      <div class="face-data-cell-label">Points</div>
                      <div class="face-data-cell-val" id="faceDataPts">—</div>
                    </div>
                    <div class="face-data-cell">
                      <div class="face-data-cell-label">Score</div>
                      <div class="face-data-cell-val" id="faceDataScore">—</div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Status row -->
              <div class="face-status-row" id="faceStatusRow">
