const FACE_MODELS_URL = '/face-models';
const SIMILARITY_THRESHOLD = 0.45; // lower = stricter (euclidean distance)
// Convert distance to a 0-100% similarity score
function distanceToScore(dist) {
  // face-api uses euclidean distance; 0.6 is usually considered threshold
  const score = Math.max(0, Math.min(100, Math.round((1 - dist / 0.6) * 100)));
  return score;
}

let faceModelsLoaded  = false;
let faceModelsLoading = false;
let faceStream        = null;
let faceVideo         = null;
let faceCanvas        = null;
let profileDescriptor = null;  // Float32Array from the stored profile photo
let scanAnimFrame     = null;
let faceScanState     = 'idle'; // idle | scanning | success | fail
let faceCamStream     = null;   // for the upload-mode camera
let uploadedProfileImage = null; // used when saving a new profile pic before scan

// Expose the profile photo filename from Twig/PHP via data attribute
// (we'll fetch it via AJAX endpoint — see below)

/* ── UI helpers ── */
function setFaceStatus(type, icon, text, spinnerVisible) {
  const row    = document.getElementById('faceStatusRow');
  const iconEl = document.getElementById('faceStatusIcon');
  const textEl = document.getElementById('faceStatusText');
  const spinner= document.getElementById('faceSpinner');
  row.className = 'face-status-row ' + (type || '');
  iconEl.textContent = icon;
  textEl.textContent = text;
  iconEl.style.display = spinnerVisible ? 'none' : 'flex';
  spinner.style.display = spinnerVisible ? 'block' : 'none';
}

/* ── Biometric step indicator ── */
function setBioStep(step) {
  // step: 1=loading, 2=detection, 3=analysis, 4=result
  for (let i = 1; i <= 4; i++) {
    const el = document.getElementById('bioStep' + i);
    if (!el) continue;
    el.className = 'face-bio-step';
    if (i < step)  el.className += ' done';
    if (i === step) el.className += ' active';
  }
}

/* ── Live data cell updates ── */
function setFaceData(face, pts, score) {
  const f = document.getElementById('faceDataFace');
  const p = document.getElementById('faceDataPts');
  const s = document.getElementById('faceDataScore');
  if (f) f.textContent = face;
  if (p) p.textContent = pts;
  if (s) s.textContent = score;
}

/* ── FPS counter ── */
let _fpsLast = 0; let _fpsCount = 0; let _fpsVal = 0;
function updateFps() {
  _fpsCount++;
  const now = performance.now();
  if (now - _fpsLast >= 1000) {
    _fpsVal = _fpsCount;
    _fpsCount = 0; _fpsLast = now;
    const el = document.getElementById('faceHudFps');
    if (el) el.textContent = _fpsVal + ' FPS';
  }
}
function setLoadingOverlay(visible, text, progress) {
  const overlay = document.getElementById('faceLoadingOverlay');
  const textEl  = document.getElementById('faceLoadingText');
  const fill    = document.getElementById('faceLoadingFill');
  overlay.classList.toggle('visible', visible);
  if(text)     textEl.textContent = text;
  if(progress !== undefined) fill.style.width = progress + '%';
}

/* ── Yield helper: release main thread between heavy operations ── */
function yieldToUI() { return new Promise(r => setTimeout(r, 0)); }

/* ── Load face-api models ── */
async function loadFaceModels() {
  if (faceModelsLoaded) return true;
  if (faceModelsLoading) {
    return new Promise(resolve => {
      const check = setInterval(() => {
        if (faceModelsLoaded) { clearInterval(check); resolve(true); }
      }, 100);
    });
  }
  faceModelsLoading = true;
  setLoadingOverlay(true, 'Chargement du détecteur…', 5);
  await yieldToUI();
  try {
    await faceapi.nets.tinyFaceDetector.loadFromUri(FACE_MODELS_URL);
    setLoadingOverlay(true, 'Chargement des landmarks…', 40);
    await yieldToUI();
    await faceapi.nets.faceLandmark68TinyNet.loadFromUri(FACE_MODELS_URL);
    setLoadingOverlay(true, 'Chargement reconnaissance…', 72);
    await yieldToUI();
    await faceapi.nets.faceRecognitionNet.loadFromUri(FACE_MODELS_URL);
    setLoadingOverlay(true, 'Prêt !', 100);
    await yieldToUI();
    setTimeout(() => setLoadingOverlay(false), 300);
    faceModelsLoaded = true;
    faceModelsLoading = false;
    return true;
  } catch(e) {
    setLoadingOverlay(false);
    faceModelsLoading = false;
    console.error('Face models load error:', e);
    setFaceStatus('fail', '❌', 'Erreur de chargement des modèles IA. Vérifiez votre connexion.', false);
    return false;
  }
}

/* ── Start webcam ── */
async function startFaceCamera() {
  try {
    faceStream = await navigator.mediaDevices.getUserMedia({ video: { width:320, height:240, facingMode:'user' }, audio: false });
    faceVideo  = document.getElementById('faceVideo');
    faceCanvas = document.getElementById('faceCanvas');
    faceVideo.srcObject = faceStream;
    await new Promise(r => faceVideo.onloadedmetadata = r);
    faceVideo.play();
    return true;
  } catch(e) {
    setFaceStatus('fail', '📵', 'Impossible d\'accéder à la caméra. Autorisez l\'accès dans votre navigateur.', false);
    return false;
  }
}

/* ── Stop webcam ── */
function stopFaceCamera() {
  if(faceStream) { faceStream.getTracks().forEach(t=>t.stop()); faceStream=null; }
  if(faceVideo)  { faceVideo.srcObject=null; faceVideo=null; }
  if(scanAnimFrame) { cancelAnimationFrame(scanAnimFrame); scanAnimFrame=null; }
}

/* ── Load profile image descriptor ── */
async function loadProfileDescriptor(imageUrl) {
  try {
    await yieldToUI();
    const img = await faceapi.fetchImage(imageUrl);
    await yieldToUI();
    const detection = await faceapi
      .detectSingleFace(img, new faceapi.TinyFaceDetectorOptions({ inputSize: 128 }))
      .withFaceLandmarks(true)
      .withFaceDescriptor();
    await yieldToUI();
    if (!detection) return null;
    return detection.descriptor;
  } catch(e) {
    return null;
  }
}

/* ── AJAX: verify credentials & get profile photo ── */
async function verifyCredentialsAndGetPhoto(email, password) {
  try {
    const resp = await fetch('/face-verify-credentials', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF': document.querySelector('#loginForm input[name="_csrf_token"]').value },
      body: JSON.stringify({ email, password })
    });
    if (!resp.ok) return null;
    return await resp.json();
  } catch(e) {
    return null;
  }
}

/* ── Handle "Continuer" button click ── */
async function handleLoginNext() {
  if (!validateLoginFields()) return;

  const email    = document.getElementById('loginEmail').value.trim();
  const password = document.getElementById('loginPass').value;

  // Show face panel
  showFacePanel();
  setBioStep(1);

  // Show loading state
  setFaceStatus('loading', '', 'Vérification de vos identifiants…', true);

  // Verify credentials via AJAX
  const result = await verifyCredentialsAndGetPhoto(email, password);

  if (!result || !result.success) {
    // Credentials wrong — go back & show error
    hideFacePanel();
    const wE = document.getElementById('wrap-login-email');
    const eE = document.getElementById('err-login-email');
    wE.classList.add('is-invalid');
    eE.textContent = result ? (result.message || 'Identifiants incorrects.') : 'Erreur de connexion. Réessayez.';
    eE.classList.add('show');
    return;
  }

  // Check if account has a profile photo
  const photoFilename = result.photo;
  const hasRealPhoto  = photoFilename && photoFilename !== 'default.png';

  if (!hasRealPhoto) {
    // Show no-photo state
    document.getElementById('faceNoPhoto').classList.add('visible');
    document.getElementById('faceMain').classList.remove('visible');
    document.getElementById('faceUploadWrap').classList.remove('visible');
    setFaceStatus('warning', '⚠️', 'Aucune photo de profil trouvée pour ce compte.', false);
    return;
  }

  // Has a profile photo — load it
  const photoUrl = '/avatars/' + photoFilename;
  document.getElementById('faceProfileImg').src = photoUrl;

  // Show main recognition UI
  document.getElementById('faceNoPhoto').classList.remove('visible');
  document.getElementById('faceUploadWrap').classList.remove('visible');
  document.getElementById('faceMain').classList.add('visible');

  // Load models + start camera in parallel
  setBioStep(1);
  setFaceStatus('loading', '', 'Chargement de l\'IA faciale…', true);

  const [modelsOk, cameraOk] = await Promise.all([loadFaceModels(), startFaceCamera()]);

  if (!modelsOk || !cameraOk) return;

  // Load profile descriptor
  setBioStep(2);
  setFaceStatus('scanning', '', 'Analyse de la photo de profil…', true);
  profileDescriptor = await loadProfileDescriptor(photoUrl);

  if (!profileDescriptor) {
    setFaceStatus('warning', '⚠️', 'Impossible d\'analyser la photo de profil. Passez cette étape ou mettez à jour votre photo.', false);
    document.getElementById('faceBtnScan').disabled = true;
    return;
  }

  setBioStep(2);
  setFaceData('—', '—', '—');
  setFaceStatus('', '⏳', 'Prêt. Cliquez sur "Scanner" en plaçant votre visage dans la caméra.', false);
  document.getElementById('faceBtnScan').disabled = false;
}

/* ── Draw professional biometric landmarks on canvas ── */
function drawBiometricOverlay(ctx, resized, color) {
  // Draw face bounding box with rounded corner markers
  const box = resized.detection.box;
  const m = 6; // corner marker length
  ctx.strokeStyle = color; ctx.lineWidth = 1.5;

  // Corner brackets instead of full rect
  [[box.x, box.y, 1, 1], [box.x + box.width, box.y, -1, 1],
   [box.x, box.y + box.height, 1, -1], [box.x + box.width, box.y + box.height, -1, -1]
  ].forEach(([cx, cy, dx, dy]) => {
    ctx.beginPath();
    ctx.moveTo(cx + dx * m, cy);
    ctx.lineTo(cx, cy);
    ctx.lineTo(cx, cy + dy * m);
    ctx.stroke();
  });

  // Draw facial landmarks as dots
  if (resized.landmarks) {
    const pts = resized.landmarks.positions;
    pts.forEach((pt, i) => {
      // Color-code different facial regions
      const regions = [
        { end: 17,  c: 'rgba(82,183,136,.55)' },  // jawline
        { end: 22,  c: 'rgba(59,130,246,.7)'  },  // left eyebrow
        { end: 27,  c: 'rgba(59,130,246,.7)'  },  // right eyebrow
        { end: 36,  c: 'rgba(245,158,11,.6)'  },  // nose bridge
        { end: 42,  c: 'rgba(139,92,246,.7)'  },  // left eye
        { end: 48,  c: 'rgba(139,92,246,.7)'  },  // right eye
        { end: 60,  c: 'rgba(236,72,153,.6)'  },  // outer lip
        { end: 68,  c: 'rgba(236,72,153,.5)'  },  // inner lip
      ];
      let regionColor = 'rgba(82,183,136,.5)';
      let cumEnd = 0;
      for (const r of regions) {
        if (i < r.end) { regionColor = r.c; break; }
      }
      ctx.beginPath();
      ctx.arc(pt.x, pt.y, 1.2, 0, Math.PI * 2);
      ctx.fillStyle = regionColor;
      ctx.fill();
    });

    // Draw mesh lines between landmarks (eyes, eyebrows, nose, lips)
    ctx.lineWidth = 0.7;
    const drawLine = (pts, from, to, color) => {
      ctx.strokeStyle = color; ctx.beginPath();
      ctx.moveTo(pts[from].x, pts[from].y);
      ctx.lineTo(pts[to].x, pts[to].y);
      ctx.stroke();
    };
    // Left eyebrow
    for(let i=17;i<21;i++) drawLine(pts,i,i+1,'rgba(59,130,246,.35)');
    // Right eyebrow
    for(let i=22;i<26;i++) drawLine(pts,i,i+1,'rgba(59,130,246,.35)');
    // Nose bridge
    for(let i=27;i<30;i++) drawLine(pts,i,i+1,'rgba(245,158,11,.3)');
    // Left eye
    for(let i=36;i<41;i++) drawLine(pts,i,i+1,'rgba(139,92,246,.4)');
    drawLine(pts,41,36,'rgba(139,92,246,.4)');
    // Right eye
    for(let i=42;i<47;i++) drawLine(pts,i,i+1,'rgba(139,92,246,.4)');
    drawLine(pts,47,42,'rgba(139,92,246,.4)');
    // Outer lips
    for(let i=48;i<59;i++) drawLine(pts,i,i+1,'rgba(236,72,153,.35)');
    drawLine(pts,59,48,'rgba(236,72,153,.35)');
  }

  // Score badge in corner
  ctx.fillStyle = 'rgba(8,14,20,.75)';
  ctx.fillRect(box.x, box.y + box.height + 4, 60, 18);
  ctx.fillStyle = color;
  ctx.font = '700 10px monospace';
  ctx.fillText('SIM: ' + (window._lastScore || '--') + '%', box.x + 4, box.y + box.height + 16);
}

/* ── Perform face scan ── */
async function startFaceScan() {
  if (faceScanState === 'scanning') return;
  faceScanState = 'scanning';

  const scanBtn  = document.getElementById('faceBtnScan');
  const retryBtn = document.getElementById('faceBtnRetry');
  const scanLine = document.getElementById('faceScanLine');
  const corners  = document.getElementById('faceCorners');
  const scoreWrap= document.getElementById('faceScoreWrap');

  scanBtn.disabled = true;
  retryBtn.classList.remove('visible');
  scoreWrap.classList.remove('visible');
  scanLine.classList.add('scanning');
  document.getElementById('faceProfileOverlay').className = 'face-profile-overlay';
  corners.className = 'face-corners scanning';

  setBioStep(3);
  setFaceStatus('scanning', '', 'Détection du visage…', true);
  setFaceData('—', '—', '—');

  // Try multiple frames for reliability — non-blocking loop (prevents page freeze)
  let bestResult = null;
  const maxAttempts = 5;

  for (let attempts = 1; attempts <= maxAttempts; attempts++) {
    // Yield to the browser BEFORE each heavy faceapi inference to unblock the UI
    await yieldToUI();
    await new Promise(r => requestAnimationFrame(r));
    await yieldToUI();

    updateFps();
    setFaceStatus('scanning', '', `Capture ${attempts}/${maxAttempts} — restez immobile…`, true);

    const v = document.getElementById('faceVideo');
    const c = document.getElementById('faceCanvas');
    c.width  = v.videoWidth  || 320;
    c.height = v.videoHeight || 240;
    const ctx = c.getContext('2d');
    ctx.drawImage(v, 0, 0);

    // Yield again right before the heavy inference call
    await yieldToUI();
    const detection = await faceapi
      .detectSingleFace(c, new faceapi.TinyFaceDetectorOptions({ inputSize: 128, scoreThreshold: 0.3 }))
      .withFaceLandmarks(true)
      .withFaceDescriptor();

    await yieldToUI();

    if (detection) {
      const dist  = faceapi.euclideanDistance(profileDescriptor, detection.descriptor);
      const score = distanceToScore(dist);
      window._lastScore = score;
      if (!bestResult || score > bestResult.score) {
        bestResult = { dist, score, detection };
      }
      const lm = detection.landmarks ? detection.landmarks.positions.length : 0;
      setFaceData('1', lm || 68, score + '%');

      const dims = { width: c.width, height: c.height };
      faceapi.matchDimensions(c, dims);
      const resized = faceapi.resizeResults(detection, dims);
      ctx.clearRect(0,0,c.width,c.height);
      ctx.drawImage(v,0,0);
      const color = score >= 60 ? '#52B788' : score >= 40 ? '#F59E0B' : '#EF4444';
      drawBiometricOverlay(ctx, resized, color);

      if (score >= 70) break;
    } else {
      setFaceData('0', '—', '—');
    }

    await new Promise(r => setTimeout(r, 200));
  }

  scanLine.classList.remove('scanning');
  setBioStep(4);

  if (!bestResult) {
    faceScanState = 'fail';
    setFaceStatus('fail', '❌', 'Aucun visage détecté. Assurez-vous d\'être bien éclairé et face à la caméra.', false);
    corners.className = 'face-corners fail';
    document.getElementById('faceProfileOverlay').className = 'face-profile-overlay fail';
    setFaceData('0', '—', '—%');
    retryBtn.classList.add('visible');
    scanBtn.disabled = false;
    return;
  }

  // Show score
  scoreWrap.classList.add('visible');
  document.getElementById('faceScoreVal').textContent = bestResult.score + '%';
  setTimeout(() => { document.getElementById('faceScoreFill').style.width = bestResult.score + '%'; }, 50);
  setFaceData('1', '68', bestResult.score + '%');

  if (bestResult.score >= 30) {
    // SUCCESS
    faceScanState = 'success';
    setFaceStatus('success', '✅', `Identité confirmée — similarité ${bestResult.score}%. Connexion…`, false);
    corners.className = 'face-corners success';
    document.getElementById('faceProfileOverlay').className = 'face-profile-overlay success';
    document.getElementById('faceProfileBadge').textContent = '✓ Vérifié';
    document.getElementById('faceVerifiedInput').value = '1';
    setTimeout(() => { document.getElementById('loginForm').submit(); }, 1200);
  } else {
    // FAIL
    faceScanState = 'fail';
    const msg = `Visage non reconnu (${bestResult.score}%). Ce visage ne correspond pas au compte.`;
    setFaceStatus('fail', '❌', msg, false);
    corners.className = 'face-corners fail';
    document.getElementById('faceProfileOverlay').className = 'face-profile-overlay fail';
    retryBtn.classList.add('visible');
    scanBtn.disabled = false;
  }
}

function retryFaceScan() {
  faceScanState = 'idle';
  document.getElementById('faceScoreWrap').classList.remove('visible');
  document.getElementById('faceScoreFill').style.width = '0%';
  document.getElementById('faceProfileOverlay').className = 'face-profile-overlay';
  document.getElementById('faceCorners').className = 'face-corners';
  document.getElementById('faceBtnRetry').classList.remove('visible');
  document.getElementById('faceProfileBadge').textContent = 'Enregistré';
  setBioStep(2);
  setFaceData('—', '—', '—');
  setFaceStatus('', '⏳', 'Prêt. Cliquez sur "Scanner" en plaçant votre visage dans la caméra.', false);
  // Clear canvas
  const c = document.getElementById('faceCanvas');
  if (c) { const ctx = c.getContext('2d'); ctx.clearRect(0,0,c.width,c.height); }
}

