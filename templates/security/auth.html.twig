function validateLoginFields() {
  let ok=true;
  const email=document.getElementById('loginEmail').value.trim();
  const pass=document.getElementById('loginPass').value;
  const wE=document.getElementById('wrap-login-email'), wP=document.getElementById('wrap-login-pass');
  const eE=document.getElementById('err-login-email'), eP=document.getElementById('err-login-pass');
  [wE,wP].forEach(w=>w.classList.remove('is-invalid'));
  [eE,eP].forEach(s=>{s.textContent='';s.classList.remove('show');});
  if(!email){wE.classList.add('is-invalid');eE.textContent="L'adresse e-mail est obligatoire.";eE.classList.add('show');ok=false;}
  else if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){wE.classList.add('is-invalid');eE.textContent="L'adresse e-mail n'est pas valide.";eE.classList.add('show');ok=false;}
  if(!pass){wP.classList.add('is-invalid');eP.textContent='Le mot de passe est obligatoire.';eP.classList.add('show');ok=false;}
  return ok;
}
function validateRegisterForm(e) {
  let ok=true;
  const fields=[
    {id:'prenom',wrap:'wrap-prenom',test:v=>v.length>=2,msg:'Le prénom doit contenir au moins 2 caractères.'},
    {id:'nom',wrap:'wrap-nom',test:v=>v.length>=2,msg:'Le nom doit contenir au moins 2 caractères.'},
    {id:'regEmail',wrap:'wrap-email',test:v=>/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v),msg:"L'adresse e-mail n'est pas valide."},
    {id:'tel',wrap:'wrap-tel',test:v=>/^\+?[0-9\s\-]{8,20}$/.test(v),msg:'Numéro de téléphone invalide.'},
    {id:'dob',wrap:'wrap-dob',test:v=>v!=='',msg:'La date de naissance est obligatoire.'},
    {id:'regPass',wrap:'wrap-pass',test:v=>v.length>=8,msg:'Au moins 8 caractères requis.'},
  ];
  fields.forEach(f=>{
    const inp=document.getElementById(f.id);
    const wrap=document.getElementById(f.wrap);
    const err=wrap.parentElement.querySelector('.field-error');
    const val=inp.value.trim();
    wrap.classList.remove('is-invalid');
    if(err){err.textContent='';err.classList.remove('show');}
    if(!f.test(val)){wrap.classList.add('is-invalid');if(err){err.textContent=f.msg;err.classList.add('show');}ok=false;}
  });
  const pass=document.getElementById('regPass').value;
  const confirm=document.getElementById('regPassConfirm').value;
  const wrapC=document.getElementById('wrap-pass-confirm');
  const errC=document.getElementById('confirmMsg');
  wrapC.classList.remove('is-invalid'); errC.textContent=''; errC.classList.remove('show');
  if(pass!==confirm){wrapC.classList.add('is-invalid');errC.textContent='Les mots de passe ne correspondent pas.';errC.classList.add('show');ok=false;}
  const terms=document.getElementById('termsCheck');
