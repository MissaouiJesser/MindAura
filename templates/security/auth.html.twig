function hideFacePanel() {
  const panel = document.getElementById('paneFaceID');
  panel.classList.remove('active-face');
  stopFaceCamera();
  closeFaceCam();
  faceScanState    = 'idle';
  profileDescriptor= null;
  window._lastScore = null;
  // Reset states
  document.getElementById('faceNoPhoto').classList.remove('visible');
  document.getElementById('faceMain').classList.remove('visible');
  document.getElementById('faceUploadWrap').classList.remove('visible');
  document.getElementById('faceScoreWrap').classList.remove('visible');
  document.getElementById('faceBtnRetry').classList.remove('visible');
  document.getElementById('faceScoreFill').style.width = '0%';
  document.getElementById('faceProfileOverlay').className = 'face-profile-overlay';
  document.getElementById('faceCorners').className = 'face-corners';
