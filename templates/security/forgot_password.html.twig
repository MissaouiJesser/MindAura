<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>MindAura — Mot de passe oublié</title>
  <link rel="icon" type="image/png" href="{{ asset('images/logo.png') }}"/>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,700;1,400&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --green:        #1B4332;
      --green-mid:    #2D6A4F;
      --green-light:  #52B788;
      --green-pale:   #D8F3DC;
      --green-xpale:  #EBF7F0;
      --violet:       #7B5EA7;
      --violet-light: rgba(123,94,167,.12);
      --bg:           #F0F4F8;
      --white:        #FFFFFF;
      --text:         #1A1A2E;
      --text-sec:     #5A6475;
      --border:       #D5DCE6;
      --shadow:       0 24px 64px rgba(27,67,50,.18), 0 0 0 1px rgba(255,255,255,.7);
      --radius:       22px;
    }

    html, body {
      height: 100%;
      font-family: 'Outfit', sans-serif;
      background: var(--bg);
      color: var(--text);
      overflow: hidden;
    }

    /* ── BACKGROUND ── */
    .bg-canvas {
      position: fixed; inset: 0; z-index: 0;
      background: url("{{ asset('images/background.jpg') }}") center center / cover no-repeat;
    }
    .bg-canvas::before {
      content: '';
      position: absolute; inset: 0;
      background: rgba(0,0,0,0.38);
    }

    /* ── WRAPPER ── */
    .wrapper {
      position: relative; z-index: 1; height: 100vh;
      display: flex; align-items: center; justify-content: center;
      padding: 16px;
    }

    /* ── CARD ── */
    .card {
      width: 100%; max-width: 900px; height: 540px;
      display: flex; border-radius: var(--radius); overflow: hidden;
      box-shadow: var(--shadow);
      animation: cardIn .7s cubic-bezier(.22,1,.36,1) both;
    }
    @keyframes cardIn {
      from { opacity: 0; transform: translateY(30px) scale(.95); }
      to   { opacity: 1; transform: none; }
    }

    /* ══ LEFT PANEL ══ */
    .panel-left {
      flex: 0 0 290px;
      background: linear-gradient(160deg, var(--green) 0%, var(--green-mid) 100%);
      color: var(--white);
      padding: 44px 34px;
      display: flex; flex-direction: column; justify-content: space-between;
      position: relative; overflow: hidden;
    }
    .panel-left::before {
      content: ''; position: absolute; top: -65px; right: -65px;
      width: 240px; height: 240px; border-radius: 50%;
      border: 48px solid rgba(255,255,255,.07);
    }
    .panel-left::after {
      content: ''; position: absolute; bottom: -42px; left: -42px;
      width: 180px; height: 180px; border-radius: 50%;
      border: 32px solid rgba(255,255,255,.05);
    }

    .brand {
      display: flex; flex-direction: column; align-items: center;
      gap: 12px; position: relative; z-index: 2;
    }
    .logo-img {
      width: 130px; height: 130px; object-fit: contain;
      filter: drop-shadow(0 6px 18px rgba(0,0,0,.3));
      transition: transform .35s ease;
    }
    .logo-img:hover { transform: scale(1.06) rotate(-2deg); }
    .brand-name {
      font-family: 'Playfair Display', serif; font-size: 1.45rem; letter-spacing: .5px;
      background: linear-gradient(135deg, #fff 25%, var(--green-pale));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }

    .panel-content { position: relative; z-index: 2; text-align: center; }

    /* animated lock icon */
    .lock-anim {
      width: 68px; height: 68px;
      background: rgba(255,255,255,.12);
      border-radius: 50%; display: flex; align-items: center; justify-content: center;
      margin: 0 auto 16px;
      animation: lockPulse 3s ease-in-out infinite;
    }
    @keyframes lockPulse {
      0%,100% { box-shadow: 0 0 0 0 rgba(255,255,255,.15); }
      50%      { box-shadow: 0 0 0 14px rgba(255,255,255,.0); }
    }
    .lock-anim svg { width: 32px; height: 32px; fill: none; stroke: #fff; stroke-width: 1.8; }

    .panel-tagline {
      font-family: 'Playfair Display', serif; font-size: 1.32rem; line-height: 1.3;
      margin-bottom: 10px;
    }
    .panel-desc { font-size: .83rem; opacity: .7; line-height: 1.65; }

    .panel-bottom { position: relative; z-index: 2; text-align: center; }
    .back-link {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: .8rem; opacity: .6; color: var(--white); text-decoration: none;
      transition: opacity .25s;
    }
    .back-link:hover { opacity: 1; }
    .back-link svg { width: 14px; height: 14px; }

    /* ══ RIGHT PANEL ══ */
    .panel-right {
      flex: 1; background: var(--white);
      display: flex; flex-direction: column;
      justify-content: center;
      padding: 52px 52px;
      position: relative; overflow: hidden;
    }
    .panel-right::before {
      content: '';
      position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, var(--green) 0%, var(--green-light) 50%, var(--violet) 100%);
    }

    /* subtle bg pattern */
    .panel-right::after {
      content: '';
      position: absolute; bottom: -60px; right: -60px;
      width: 200px; height: 200px;
      border-radius: 50%;
      background: radial-gradient(circle, var(--green-xpale) 0%, transparent 70%);
      pointer-events: none;
    }

    .form-header { margin-bottom: 32px; }
    .form-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.7rem; font-weight: 700;
      color: var(--text); margin-bottom: 6px;
    }
    .form-subtitle { font-size: .875rem; color: var(--text-sec); line-height: 1.55; }

    /* ── SUCCESS STATE ── */
    .success-box {
      text-align: center; padding: 12px 0;
      animation: fadeUp .5s ease both;
    }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(18px); }
      to   { opacity: 1; transform: none; }
    }
    .success-icon {
      width: 80px; height: 80px;
      background: linear-gradient(135deg, var(--green-xpale), var(--green-pale));
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 22px;
      animation: iconPop .5s .1s cubic-bezier(.34,1.56,.64,1) both;
    }
    @keyframes iconPop {
      from { transform: scale(0); opacity: 0; }
      to   { transform: scale(1); opacity: 1; }
    }
    .success-icon svg { width: 36px; height: 36px; stroke: var(--green); stroke-width: 2; fill: none; }
    .success-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.45rem; color: var(--text); margin-bottom: 10px;
    }
    .success-text { font-size: .875rem; color: var(--text-sec); line-height: 1.65; margin-bottom: 28px; }
    .success-text strong { color: var(--green); }

    /* ── FIELD ── */
    .field-wrap { margin-bottom: 22px; }
    .field-label {
      display: block; font-size: .82rem; font-weight: 600;
      color: var(--text); margin-bottom: 7px; letter-spacing: .2px;
    }
    .input-wrap {
      display: flex; align-items: center;
      background: var(--bg); border: 1.5px solid var(--border);
      border-radius: 12px; overflow: hidden;
      transition: border-color .25s, box-shadow .25s;
    }
    .input-wrap:focus-within {
      border-color: var(--green);
      box-shadow: 0 0 0 3px rgba(27,67,50,.1);
    }
    .input-wrap.is-invalid {
      border-color: #DC2626;
      box-shadow: 0 0 0 3px rgba(220,38,38,.1);
    }
    .input-icon {
      padding: 0 13px; color: var(--text-sec);
      display: flex; align-items: center; flex-shrink: 0;
    }
    .input-icon svg { width: 16px; height: 16px; }
    .input-wrap input {
      flex: 1; border: none; background: transparent;
      padding: 13px 14px 13px 0;
      font-family: 'Outfit', sans-serif; font-size: .9rem; color: var(--text);
      outline: none;
    }
    .input-wrap input::placeholder { color: var(--text-sec); opacity: .65; }

    .field-error {
      font-size: .78rem; color: #DC2626;
      margin-top: 6px; display: none; align-items: center; gap: 4px;
    }
    .field-error.show { display: flex; animation: errIn .25s ease; }
    @keyframes errIn { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }

    /* ── BTN ── */
    .btn-submit {
      width: 100%; padding: 14px;
      background: linear-gradient(135deg, var(--green) 0%, var(--green-mid) 100%);
      color: #fff; border: none; border-radius: 12px;
      font-family: 'Outfit', sans-serif; font-size: .95rem; font-weight: 600;
      cursor: pointer; letter-spacing: .3px;
      transition: transform .2s, box-shadow .2s, opacity .2s;
      box-shadow: 0 4px 18px rgba(27,67,50,.28);
      display: flex; align-items: center; justify-content: center; gap: 8px;
      position: relative; overflow: hidden;
    }
    .btn-submit::after {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(135deg, transparent 0%, rgba(255,255,255,.12) 100%);
      opacity: 0; transition: opacity .25s;
    }
    .btn-submit:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(27,67,50,.36); }
    .btn-submit:hover::after { opacity: 1; }
    .btn-submit:active { transform: translateY(0); }
    .btn-submit svg { width: 17px; height: 17px; }

    /* loading state */
    .btn-submit.loading { opacity: .75; pointer-events: none; }
    .btn-submit.loading .btn-text { opacity: 0; }
    .btn-submit.loading::before {
      content: '';
      position: absolute;
      width: 20px; height: 20px;
      border: 2.5px solid rgba(255,255,255,.4);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin .7s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ── DIVIDER ── */
    .divider {
      display: flex; align-items: center; gap: 12px;
      margin: 20px 0;
    }
    .divider-line { flex: 1; height: 1px; background: var(--border); }
    .divider-text { font-size: .75rem; color: var(--text-sec); white-space: nowrap; }

    /* ── BACK TO LOGIN LINK ── */
    .login-link-row { text-align: center; }
    .login-link {
      font-size: .84rem; color: var(--text-sec); text-decoration: none;
      display: inline-flex; align-items: center; gap: 5px;
      transition: color .2s;
    }
    .login-link:hover { color: var(--green); }
    .login-link svg { width: 14px; height: 14px; }

    /* ── ALERT ERROR ── */
    .alert-error {
      background: #FEF2F2; border: 1px solid #FECACA;
      border-radius: 10px; padding: 12px 16px;
      display: flex; align-items: center; gap: 10px;
      margin-bottom: 20px; font-size: .85rem; color: #DC2626;
      animation: errIn .25s ease;
    }
    .alert-error svg { width: 17px; height: 17px; flex-shrink: 0; }

    /* ── STEP INDICATOR ── */
    .step-indicator {
      display: flex; align-items: center; gap: 8px;
      margin-bottom: 26px;
    }
    .step-item {
      display: flex; align-items: center; gap: 6px;
      font-size: .75rem; font-weight: 600;
    }
    .step-dot {
      width: 22px; height: 22px; border-radius: 50%;
      background: var(--bg); border: 1.5px solid var(--border);
      display: flex; align-items: center; justify-content: center;
      font-size: .68rem; color: var(--text-sec);
      transition: all .3s;
    }
    .step-item.active .step-dot {
      background: var(--green); border-color: var(--green);
      color: #fff;
    }
    .step-label { color: var(--text-sec); }
    .step-item.active .step-label { color: var(--green); }
    .step-connector { flex: 1; height: 1px; background: var(--border); }
  </style>
</head>
<body>

<div class="bg-canvas"></div>

<div class="wrapper">
  <div class="card">

    <!-- LEFT PANEL -->
    <div class="panel-left">
      <div class="brand">
        <img src="{{ asset('images/logo.png') }}" alt="MindAura" class="logo-img"/>
        <span class="brand-name">MindAura</span>
      </div>

      <div class="panel-content">
        <div class="lock-anim">
          <svg viewBox="0 0 24 24">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
        </div>
        <div class="panel-tagline">Récupérez<br/>votre accès</div>
        <div class="panel-desc">Pas de panique — il suffit de nous indiquer votre adresse e-mail et nous vous enverrons un lien sécurisé.</div>
      </div>

      <div class="panel-bottom">
        <a href="{{ path('app_forgot_password') }}" class="back-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 5l-7 7 7 7"/>
          </svg>
          Changer de méthode
        </a>
      </div>
    </div>

    <!-- RIGHT PANEL -->
    <div class="panel-right">

      {% if sent %}
        <!-- SUCCESS STATE -->
        <div class="success-box">
          <div class="success-icon">
            <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6.29 6.29l.91-.86a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </div>
          <div class="success-title">E-mail envoyé !</div>
          <div class="success-text">
            Si un compte est associé à cette adresse, vous recevrez dans quelques instants un e-mail avec un lien de réinitialisation.<br/><br/>
            <strong>Le lien est valable 30 minutes.</strong> Vérifiez aussi votre dossier spam.
          </div>
          <a href="{{ path('app_login') }}" style="text-decoration:none;">
            <button class="btn-submit" style="max-width:280px;margin:0 auto;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/>
              </svg>
              <span class="btn-text">Retour à la connexion</span>
            </button>
          </a>
        </div>

      {% else %}
        <!-- FORM STATE -->
        <div class="form-header">
          <div class="step-indicator">
            <div class="step-item active">
              <div class="step-dot">1</div>
              <span class="step-label">Saisir l'e-mail</span>
            </div>
            <div class="step-connector"></div>
            <div class="step-item">
              <div class="step-dot">2</div>
              <span class="step-label">Vérifier la boîte</span>
            </div>
            <div class="step-connector"></div>
            <div class="step-item">
              <div class="step-dot">3</div>
              <span class="step-label">Nouveau mot de passe</span>
            </div>
          </div>
          <div class="form-title">E-mail · Étape 1/3</div>
          <div class="form-subtitle">Saisissez l'adresse e-mail associée à votre compte et nous vous enverrons un lien sécurisé pour réinitialiser votre mot de passe.</div>
        </div>

        {% if error %}
          <div class="alert-error">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            {{ error }}
          </div>
        {% endif %}

        <form method="POST" action="{{ path('app_forgot_password_email') }}" id="forgotForm" novalidate>
          <div class="field-wrap">
            <label for="email" class="field-label">Adresse e-mail</label>
            <div class="input-wrap" id="wrap-email">
              <span class="input-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
              </span>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="votre@email.com"
                autocomplete="email"
                autofocus
                value="{{ app.request.request.get('email', '') }}"
              />
            </div>
            <span class="field-error" id="err-email">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
            </span>
          </div>

          <button type="submit" class="btn-submit" id="submitBtn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-text">
              <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
            </svg>
            <span class="btn-text">Envoyer le lien de réinitialisation</span>
          </button>
        </form>

        <div class="divider">
          <div class="divider-line"></div>
          <span class="divider-text">ou</span>
          <div class="divider-line"></div>
        </div>

        <div class="login-link-row">
          <a href="{{ path('app_forgot_password_totp') }}" class="login-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
              <line x1="12" y1="18" x2="12.01" y2="18"/>
            </svg>
            Préférez-vous utiliser Google Authenticator ?
          </a>
        </div>

        <div style="margin-top:12px;" class="login-link-row">
          <a href="{{ path('app_login') }}" class="login-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 12H5M12 5l-7 7 7 7"/>
            </svg>
            Vous vous souvenez ? Retour à la connexion
          </a>
        </div>

        <div style="margin-top:12px;" class="login-link-row">
          <a href="{{ path('app_register') }}" class="login-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/>
            </svg>
            Pas encore de compte ? S'inscrire
          </a>
        </div>
      {% endif %}

    </div>
    <!-- /RIGHT PANEL -->

  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const form      = document.getElementById('forgotForm');
  const submitBtn = document.getElementById('submitBtn');
  if (!form) return;

  form.addEventListener('submit', function (e) {
    const emailInput = document.getElementById('email');
    const wrapEmail  = document.getElementById('wrap-email');
    const errEmail   = document.getElementById('err-email');
    const val        = emailInput.value.trim();

    wrapEmail.classList.remove('is-invalid');
    errEmail.textContent = '';
    errEmail.classList.remove('show');

    let ok = true;

    if (!val) {
      wrapEmail.classList.add('is-invalid');
      errEmail.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg> L\'adresse e-mail est obligatoire.';
      errEmail.classList.add('show');
      ok = false;
    } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) {
      wrapEmail.classList.add('is-invalid');
      errEmail.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg> L\'adresse e-mail n\'est pas valide.';
      errEmail.classList.add('show');
      ok = false;
    }

    if (!ok) {
      e.preventDefault();
      return;
    }

    // Loading state
    submitBtn.classList.add('loading');
  });
});
</script>
</body>
</html>
