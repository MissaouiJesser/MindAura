{% block content %}

{# ── HERO ── #}
<div class="lib-hero">
  <div class="lib-hero-inner">
    <div>
      <div class="lib-hero-label">Centre de connaissance</div>
      <h1 class="lib-hero-title">Bibliothèque de<br><span>ressources</span></h1>
      <p class="lib-hero-subtitle">Explorez notre collection de contenus soigneusement sélectionnés<br>pour accompagner votre croissance.</p>
    </div>
    <div class="lib-hero-stat">
      <div class="stat-item">
        <div class="stat-num">{{ pagination.total ?? ressources|length }}</div>
        <div class="stat-lbl">Ressources</div>
      </div>
      <div class="stat-item">
        <div class="stat-num">4</div>
        <div class="stat-lbl">Formats</div>
      </div>
    </div>
  </div>
</div>

{# ── FILTER PANEL ── #}
<div class="filter-panel">
  <form method="get" action="{{ path('ressources_index') }}" id="filter-form">
    <div class="filter-row">

      <div class="search-wrap">
        <svg class="search-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <circle cx="9" cy="9" r="7"/><line x1="14.5" y1="14.5" x2="19" y2="19"/>
        </svg>
        <input type="text" name="q" placeholder="Rechercher un titre, un tag…"
               value="{{ currentQ }}" autocomplete="off">
      </div>

      <div class="filter-group">
        <label class="filter-label" for="filter-type">Type</label>
        <select name="type" id="filter-type" class="filter-select">
          <option value="">Tous</option>
          {% for label, value in contenuChoices %}
            <option value="{{ value }}" {{ currentType == value ? 'selected' }}>{{ label }}</option>
          {% endfor %}
        </select>
      </div>

      <div class="filter-group">
        <label class="filter-label" for="filter-niveau">Niveau</label>
        <select name="niveau" id="filter-niveau" class="filter-select">
          <option value="">Tous</option>
          {% for label, value in niveauChoices %}
            <option value="{{ value }}" {{ currentNiveau == value ? 'selected' }}>{{ label }}</option>
          {% endfor %}
        </select>
      </div>

      <div class="filter-group">
        <label class="filter-label" for="filter-categorie">Catégorie</label>
        <select name="categorie" id="filter-categorie" class="filter-select">
          <option value="">Toutes</option>
          {% for label, value in categorieChoices %}
            <option value="{{ value }}" {{ currentCategorie == value ? 'selected' }}>{{ label }}</option>
          {% endfor %}
        </select>
      </div>

      <div class="filter-group">
        <label class="filter-label" for="filter-sort">Trier par</label>
        <select name="sort" id="filter-sort" class="filter-select">
          <option value="date_desc"  {{ currentSort == 'date_desc'  ? 'selected' }}>📅 Plus récent</option>
          <option value="date_asc"   {{ currentSort == 'date_asc'   ? 'selected' }}>📅 Plus ancien</option>
          <option value="likes_desc" {{ currentSort == 'likes_desc' ? 'selected' }}>❤️ Plus likés</option>
          <option value="vues_desc"  {{ currentSort == 'vues_desc'  ? 'selected' }}>👁️ Plus vus</option>
          <option value="score_desc" {{ currentSort == 'score_desc' ? 'selected' }}>🔥 Populaires</option>
        </select>
      </div>

      <button type="submit" class="btn-search">
        <svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <circle cx="9" cy="9" r="7"/><line x1="14.5" y1="14.5" x2="19" y2="19"/>
        </svg>
        Rechercher
      </button>

      {% if currentQ or currentType or currentNiveau or currentCategorie %}
        <a href="{{ path('ressources_index') }}" class="btn-reset">✕ Effacer</a>
      {% endif %}

      {% if app.user %}
        <a href="{{ path('ressource_favori_index') }}" class="btn-fav">
          ⭐ Mes favoris
        </a>
      {% endif %}

    </div>
  </form>
</div>

{# ── RESULT BAR ── #}
<div class="result-bar">
  <div class="result-count">
    {% if ressources|length > 0 %}
      <strong>{{ ressources|length }}</strong>
      ressource{{ ressources|length > 1 ? 's' }} trouvée{{ ressources|length > 1 ? 's' }}
      {% if currentQ %}&nbsp;·&nbsp;« <em>{{ currentQ }}</em> »{% endif %}
    {% endif %}
  </div>
  <div class="active-filters">
    {% if currentType %}
      <span class="filter-tag">
        📁 {{ currentType }}
        <a href="{{ path('ressources_index', {q: currentQ, niveau: currentNiveau, categorie: currentCategorie, sort: currentSort}) }}">✕</a>
      </span>
    {% endif %}
    {% if currentNiveau %}
      <span class="filter-tag">
        🎯 {{ currentNiveau }}
        <a href="{{ path('ressources_index', {q: currentQ, type: currentType, categorie: currentCategorie, sort: currentSort}) }}">✕</a>
      </span>
    {% endif %}
    {% if currentCategorie %}
      <span class="filter-tag">
        🏷 {{ currentCategorie }}
        <a href="{{ path('ressources_index', {q: currentQ, type: currentType, niveau: currentNiveau, sort: currentSort}) }}">✕</a>
      </span>
    {% endif %}
  </div>
</div>

{# ── GRILLE ── #}
<div class="resources-grid">
  {% for ressource in ressources %}

    {% set typeSlug = ressource.contenu|lower %}
    {% set thumbBg  = typeSlug == 'article' ? 'thumb-bg-article' :
                     (typeSlug == 'video'   ? 'thumb-bg-video'   :
                     (typeSlug == 'podcast' ? 'thumb-bg-podcast'  :
                     (typeSlug == 'pdf'     ? 'thumb-bg-pdf'      : 'thumb-bg-default'))) %}
    {% set badgeCls = typeSlug == 'article' ? 'badge-article' :
                     (typeSlug == 'video'   ? 'badge-video'   :
                     (typeSlug == 'podcast' ? 'badge-podcast'  :
                     (typeSlug == 'pdf'     ? 'badge-pdf'      : 'badge-default'))) %}
    {% set typeIcon = typeSlug == 'pdf'     ? '📄' :
                     (typeSlug == 'video'   ? '🎬' :
                     (typeSlug == 'podcast' ? '🎙️' :
                     (typeSlug == 'article' ? '📰' : '📘'))) %}

    <div class="resource-card" onclick="window.location='{{ path('ressources_show', {id: ressource.id}) }}'">
      <div class="resource-card-thumb {{ ressource.imageUrl ? '' : thumbBg }}">
        {% if ressource.imageUrl %}
          <img src="{{ ressource.imageUrl }}" alt="{{ ressource.titre }}" loading="lazy"
               onerror="this.style.display='none'; this.closest('.resource-card-thumb').classList.add('{{ thumbBg }}'); document.getElementById('ph-{{ ressource.id }}').style.display='block';">
        {% endif %}
        <div id="ph-{{ ressource.id }}" class="resource-card-thumb-placeholder"
             style="{{ ressource.imageUrl ? 'display:none;' : '' }}">{{ typeIcon }}</div>
        <div class="thumb-overlay"></div>
        <div class="resource-card-badges">
          <span class="badge {{ badgeCls }}">{{ ressource.contenu }}</span>
          {% if ressource.niveau %}
            <span class="badge badge-niveau">{{ ressource.niveau }}</span>
          {% endif %}
        </div>
      </div>

      <div class="resource-card-body">
        <div class="resource-card-title">{{ ressource.titre }}</div>
        <div class="resource-card-excerpt">
          {{ ressource.resume|slice(0, 130) }}{% if ressource.resume|length > 130 %}…{% endif %}
        </div>
        <div class="resource-card-meta">
          <span class="rc-stat">❤️ {{ ressource.likes }}</span>
          <span class="rc-stat">👁 {{ ressource.nbrVues }}</span>
          {% if ressource.dureeLecture %}
            <span class="rc-stat">⏱ {{ ressource.dureeLecture }} min</span>
          {% endif %}
          {% if ressource.categorie %}
            <span class="rc-stat">🏷 {{ ressource.categorie }}</span>
          {% endif %}
        </div>
      </div>

      <div class="resource-card-footer">
        <a href="{{ path('ressources_show', {id: ressource.id}) }}" class="btn-read" onclick="event.stopPropagation()">
          Lire la suite
          <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" y1="10" x2="16" y2="10"/><polyline points="11,5 16,10 11,15"/>
          </svg>
        </a>
        <button class="like-btn like-resource" data-id="{{ ressource.id }}" aria-label="Liker" onclick="event.stopPropagation()">
          ❤️ {{ ressource.likes }}
        </button>
      </div>
    </div>

  {% else %}
    <div class="empty-state">
      <div class="empty-icon">📭</div>
      <div class="empty-title">Aucune ressource trouvée</div>
      <div class="empty-sub">Essayez de modifier vos filtres ou revenez plus tard.</div>
    </div>
  {% endfor %}
</div>

{# ── PAGINATION ── #}
{% if pagination is defined and pagination.pages > 1 %}
  <div class="pagination">
    {% if pagination.current > 1 %}
      <a href="{{ path('ressources_index', {page: pagination.current - 1, q: currentQ, type: currentType, niveau: currentNiveau, categorie: currentCategorie, sort: currentSort}) }}">
        ← Préc.
      </a>
    {% endif %}
    {% for p in 1..pagination.pages %}
      {% if p == 1 or p == pagination.pages or (p >= pagination.current - 2 and p <= pagination.current + 2) %}
        <a href="{{ path('ressources_index', {page: p, q: currentQ, type: currentType, niveau: currentNiveau, categorie: currentCategorie, sort: currentSort}) }}"
           class="{{ p == pagination.current ? 'active' : '' }}">{{ p }}</a>
      {% elseif p == pagination.current - 3 or p == pagination.current + 3 %}
        <span class="pagination-dots">…</span>
      {% endif %}
    {% endfor %}
    {% if pagination.current < pagination.pages %}
      <a href="{{ path('ressources_index', {page: pagination.current + 1, q: currentQ, type: currentType, niveau: currentNiveau, categorie: currentCategorie, sort: currentSort}) }}">
        Suiv. →
      </a>
    {% endif %}
  </div>
{% endif %}

{# ── RECOMMANDATIONS ── 
<section class="reco-section" id="reco-section" style="display:none;">
  <div class="reco-divider">
    <div class="reco-divider-line"></div>
    <div class="reco-header-content">
      <div class="reco-eyebrow">Pour vous</div>
      <div class="reco-title">
        🔥 Recommandé
        <span class="reco-pill">Popularité</span>
      </div>
      <div class="reco-subtitle">Sélectionnées selon les vues et les likes de la communauté</div>
    </div>
    <div class="reco-divider-line"></div>
  </div>#}

  {# Skeletons (affichés pendant le chargement) #}
  <div class="reco-grid" id="reco-skeleton">
    {% for i in 1..3 %}
      <div class="reco-skeleton">
        <div class="skel-thumb"></div>
        <div class="skel-body">
          <div class="skel-line short"></div>
          <div class="skel-line medium"></div>
          <div class="skel-line"></div>
          <div class="skel-line short"></div>
        </div>
      </div>
    {% endfor %}
  </div>

  <div class="reco-grid" id="reco-grid" style="display:none;"></div>
</section>

{# ── SCROLL TOP ── #}
<button class="scroll-top" id="scroll-top" onclick="window.scrollTo({top:0,behavior:'smooth'})" aria-label="Retour en haut">
  <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="5,13 10,8 15,13"/>
  </svg>
</button>

{% endblock %}

