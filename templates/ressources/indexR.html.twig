  /* Reco card 
  .reco-card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--r-md); overflow: hidden;
    display: flex; flex-direction: column;
    transition: transform .28s var(--ease-out), box-shadow .28s, border-color .28s;
    text-decoration: none; color: inherit;
  }
  .reco-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-md);
  }
  .reco-card-thumb {
    height: 146px; position: relative; overflow: hidden; flex-shrink: 0;
  }
  .reco-card-thumb img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform .5s var(--ease-out);
  }
  .reco-card:hover .reco-card-thumb img { transform: scale(1.07); }
  .reco-card-thumb-ph {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    font-size: 38px; opacity: .45;
  }
  .reco-card-body {
    padding: 14px 16px 10px; flex: 1;
    display: flex; flex-direction: column; gap: 6px;
  }
  .reco-badges { display: flex; gap: 5px; flex-wrap: wrap; }
  .reco-badge {
    font-family: var(--font-display);
    font-size: 9.5px; font-weight: 700; padding: 3px 9px;
    border-radius: 20px; text-transform: uppercase; letter-spacing: .3px;
  }
  .reco-badge-type { background: var(--pale); color: var(--forest); }
  .reco-badge-niveau { background: var(--sand); color: var(--ink-2); }
  .reco-card-title {
    font-family: var(--font-display);
    font-size: 13.5px; font-weight: 700; color: var(--ink); line-height: 1.35;
    display: -webkit-box; -webkit-line-clamp: 2;
    -webkit-box-orient: vertical; overflow: hidden;
  }
