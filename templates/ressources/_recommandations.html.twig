{#
  ─────────────────────────────────────────────────────────────────
  _recommandations.html.twig
  Fragment à inclure dans showR.html.twig :

      {% include 'ressources/_recommandations.html.twig' %}

  Variable attendue : recommandations (tableau d'objets Ressources)
  ─────────────────────────────────────────────────────────────────
#}

{% if recommandations is not empty %}
<section class="recommandations-section mt-5 pt-4 border-top" id="recommandations">

    {# ── En-tête ── #}
    <div class="d-flex align-items-center gap-2 mb-4">
        <span class="fs-4">🔥</span>
        <h3 class="h5 fw-semibold mb-0">Ressources populaires dans cette catégorie</h3>
    </div>

    {# ── Grille de cartes ── #}
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        {% for r in recommandations %}
        <div class="col">
            <a href="{{ path('ressources_show', {id: r.id}) }}"
               class="text-decoration-none text-dark h-100">

                <div class="card h-100 border-0 shadow-sm resource-card"
                     style="border-radius: 12px; overflow: hidden; transition: transform .2s, box-shadow .2s;"
                     onmouseenter="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 8px 24px rgba(0,0,0,.12)'"
                     onmouseleave="this.style.transform=''; this.style.boxShadow=''">

                    {# ── Image ── #}
                    {% if r.imageUrl %}
                        <img src="{{ r.imageUrl }}"
                             alt="{{ r.titre }}"
                             class="card-img-top"
                             style="height: 160px; object-fit: cover;">
                    {% else %}
                        {# Placeholder coloré selon catégorie #}
                        <div class="card-img-top d-flex align-items-center justify-content-center"
                             style="height: 160px; background: linear-gradient(135deg, #534AB7, #7F77DD);">
                            <span style="font-size: 2.5rem;">
                                {% if r.contenu == 'Video' %}🎬
                                {% elseif r.contenu == 'Podcast' %}🎙️
                                {% elseif r.contenu == 'PDF' %}📄
                                {% else %}📝{% endif %}
                            </span>
                        </div>
                    {% endif %}

                    <div class="card-body pb-2">

                        {# ── Badges type + niveau ── #}
                        <div class="d-flex gap-2 mb-2 flex-wrap">
                            <span class="badge rounded-pill"
                                  style="background:#534AB7; color:#fff; font-size:.7rem; padding:4px 10px;">
                                {{ r.contenu }}
                            </span>
                            {% if r.niveau %}
                            <span class="badge rounded-pill bg-light text-secondary border"
                                  style="font-size:.7rem; padding:4px 10px;">
                                {{ r.niveau|lower|capitalize }}
                            </span>
                            {% endif %}
                        </div>

                        {# ── Titre ── #}
                        <h6 class="card-title fw-semibold mb-1"
                            style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                            {{ r.titre }}
                        </h6>

                        {# ── Résumé ── #}
                        <p class="card-text text-muted small mb-0"
                           style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; line-height:1.4;">
                            {{ r.resume }}
                        </p>
                    </div>

                    {# ── Footer stats ── #}
                    <div class="card-footer bg-transparent border-0 pt-0 pb-3 px-3">
                        <div class="d-flex align-items-center gap-3" style="font-size:.8rem; color:#888;">

                            {# Vues #}
                            <span title="Vues">
                                <i class="fas fa-eye me-1"></i>
                                {{ r.nbrVues ?? 0 }}
                            </span>

                            {# Likes #}
                            <span title="Likes">
                                <i class="fas fa-heart me-1" style="color:#e05252;"></i>
                                {{ r.likes ?? 0 }}
                            </span>

                            {# Durée #}
                            {% if r.dureeLecture and r.dureeLecture > 0 %}
                            <span class="ms-auto" title="Durée de lecture">
                                <i class="fas fa-clock me-1"></i>
                                {{ r.dureeLecture }} min
                            </span>
                            {% endif %}

                        </div>
                    </div>

                </div>{# /card #}
            </a>
        </div>{# /col #}
        {% endfor %}
    </div>{# /row #}

</section>
{% endif %}

{#
  ─────────────────────────────────────────────────────────────────
  USAGE dans showR.html.twig — ajouter en bas du bloc principal :

  {% include 'ressources/_recommandations.html.twig' %}

  ─────────────────────────────────────────────────────────────────

  OPTION — filtre de tri dans indexR.html.twig :
  Ajouter dans le <select name="sort"> :

  <option value="score_desc" {% if currentSort == 'score_desc' %}selected{% endif %}>
      🔥 Plus populaires
  </option>
  ─────────────────────────────────────────────────────────────────
#}