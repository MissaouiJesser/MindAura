        btn.classList.add('is-favori');
        icon.textContent = '★';
        label.textContent = 'Dans vos favoris';
        btn.dataset.added = 'true';
      }
    });
  btn.addEventListener('click', async () => {
    const res = await fetch('/ressources/favoris/toggle/' + id, {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams({ _token: btn.dataset.csrf })
    });
