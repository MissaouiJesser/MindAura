      const threadDiv = e.currentTarget.closest('.comment-item');
      const form = threadDiv.querySelector('.comment-reply-form');
      if (form) {
        const isVisible = form.style.display === 'block';
        document.querySelectorAll('.comment-reply-form').forEach(f => f.style.display = 'none');
        if (!isVisible) {
          form.style.display = 'block';
          form.querySelector('textarea').focus();
        }
      }
    });
  });

  document.querySelectorAll('.cancel-reply-trigger').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const formDiv = e.currentTarget.closest('.comment-reply-form');
      if (formDiv) {
        formDiv.style.display = 'none';
        formDiv.querySelector('textarea').value = '';
      }
    });
  });

  // Toggle form modifier
  document.querySelectorAll('.edit-btn-trigger').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const threadDiv = e.currentTarget.closest('.comment-item');
      const form = threadDiv.querySelector('.comment-edit-form');
      if (form) {
        const isVisible = form.style.display === 'block';
        document.querySelectorAll('.comment-edit-form').forEach(f => f.style.display = 'none');
        if (!isVisible) {
          form.style.display = 'block';
          form.querySelector('textarea').focus();
        }
      }
    });
  });

  document.querySelectorAll('.cancel-edit-trigger').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const formDiv = e.currentTarget.closest('.comment-edit-form');
      if (formDiv) {
        formDiv.style.display = 'none';
      }
    });
  });

  // Likes AJAX
  document.querySelectorAll('.comment-like-btn').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const cId = btn.dataset.id;
      btn.disabled = true;
      try {
        const res = await fetch(`/commentaires/${cId}/like`, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        const data = await res.json();
        if (data.likes !== undefined) {
          btn.querySelector('.like-count').innerText = data.likes;
          btn.classList.add('liked'); btn.style.transform = 'scale(1.15)'; setTimeout(() => btn.style.transform = '', 200);
        }
      } catch(err) {}
      btn.disabled = false;
    });
  });
})();
