/* ─────────────── Share / Copy link ─────────────── */
(function() {
  const btn = document.getElementById('share-btn');
  if (!btn) return;
  btn.addEventListener('click', async () => {
    const url = window.location.href;
    try {
      if (navigator.share) {
        await navigator.share({ title: document.title, url });
        return;
      }
    } catch(e) { /* fallback */ }
    try {
      await navigator.clipboard.writeText(url);
      btn.classList.add('copied');
      btn.innerHTML = '✅ Lien copié !';
      showToast('Lien copié dans le presse-papiers', 'success');
      setTimeout(() => {
        btn.classList.remove('copied');
        btn.innerHTML = '🔗 Copier le lien';
      }, 2000);
    } catch(e) {
      showToast('Impossible de copier le lien', 'error');
    }
  });
})();

/* ─────────────── Wikipédia + Livres ─────────────── */
(function() {
  const RESSOURCE_ID = {{ ressource.id }};
  function esc(str) { if (!str) return ''; return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  async function load() {
    try {
      const response = await fetch('/wiki/ressource/' + RESSOURCE_ID + '?lang=fr');
      if (!response.ok) throw new Error('Wiki API error');
      const data = await response.json();
      const wikiExtract = data.wikipedia ? (data.wikipedia.resume || data.wikipedia.extrait || '') : '';
      if (data.wikipedia && wikiExtract.length > 40) renderWiki(data.wikipedia);
      else document.getElementById('wiki-section').style.display = 'none';
      if (data.livres && data.livres.length > 0) renderBooks(data.livres);
      else document.getElementById('books-section').style.display = 'none';
    } catch(e) {
      document.getElementById('wiki-section').style.display = 'none';
      document.getElementById('books-section').style.display = 'none';
    }
  }
  function renderWiki(article) {
    const section = document.getElementById('wiki-section');
    const skeleton = document.getElementById('wiki-skeleton');
    const body = document.getElementById('wiki-body');
    document.getElementById('wiki-title').textContent = article.titre || '';
    if (article.description) document.getElementById('wiki-description').textContent = article.description;
    const extrait = article.extrait || article.resume || '';
    const extractEl = document.getElementById('wiki-extract');
    if (extrait.length > 450) extractEl.innerHTML = esc(extrait.substring(0, 450)) + '... <a href="' + esc(article.url || '#') + '" target="_blank">Lire la suite →</a>';
    else extractEl.textContent = extrait;
    const linkEl = document.getElementById('wiki-link');
    if (article.url) linkEl.href = article.url; else linkEl.style.display = 'none';
    if (article.image) {
      const imgWrap = document.getElementById('wiki-img-wrap');
      const img = document.getElementById('wiki-img');
      img.src = article.image; img.alt = article.titre || '';
      img.onerror = () => imgWrap.style.display = 'none';
      imgWrap.style.display = 'block';
    }
    skeleton.style.display = 'none';
    body.style.display = 'flex';
    section.style.display = 'block';
    section.classList.add('reveal', 'is-visible');
  }
  function renderBooks(livres) {
    const section = document.getElementById('books-section');
    const grid = document.getElementById('books-grid');
    const skeleton = document.getElementById('books-skeleton');
    grid.innerHTML = livres.map(book => {
      const url = book.key ? 'https://openlibrary.org' + book.key : 'https://openlibrary.org';
      const titre = esc(book.titre || 'Titre inconnu');
      const auteur = esc(book.auteur || 'Auteur inconnu');
      const annee = book.annee ? `<span class="book-badge">${book.annee}</span>` : '';
      const pages = book.pages ? `<span class="book-badge">${book.pages} p.</span>` : '';
      const note = book.note ? `<span class="book-note">★ ${book.note}</span>` : '';
      const cover = book.couverture
        ? `<img src="${esc(book.couverture)}" alt="${titre}" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"><div class="book-cover-placeholder" style="display:none;">📖</div>`
        : `<div class="book-cover-placeholder">📖</div>`;
      return `<a href="${esc(url)}" target="_blank" rel="noopener noreferrer" class="book-card" title="${titre}"><div class="book-cover-wrap">${cover}</div><div class="book-info"><div class="book-title">${titre}</div><div class="book-author">${auteur}</div><div class="book-meta">${annee}${pages}${note}</div></div></a>`;
    }).join('');
    skeleton.style.display = 'none';
    grid.style.display = 'grid';
    section.style.display = 'block';
    section.classList.add('reveal', 'is-visible');
  }
  document.getElementById('wiki-section').style.display = 'block';
  document.getElementById('books-section').style.display = 'block';
  load();
})();

/* ─────────────── Traduction ─────────────── */
(function () {
  const btnTranslate = document.getElementById('btn-translate');
  const btnReset = document.getElementById('btn-reset');
  const status = document.getElementById('translate-status');
  const titreEl = document.getElementById('ressource-titre');
  const descEl = document.getElementById('ressource-description');
  if (!btnTranslate || !titreEl || !descEl) return;
  const originalTitre = titreEl.innerText.trim();
  const originalDesc = descEl.innerText.trim();
  window._articleReady = false;
  document.addEventListener('articleReady', () => { window._articleReady = true; });
  async function myMemoryTranslate(text, targetLang) {
    if (!text || !text.trim()) return text;
    const chunks = [];
    for (let i = 0; i < text.length; i += 490) chunks.push(text.slice(i, i + 490));
    const translated = [];
    for (const chunk of chunks) {
      const params = new URLSearchParams({ q: chunk, langpair: 'fr|' + targetLang.toLowerCase(), de: 'minyarguesmi87@gmail.com' });
      const res = await fetch('https://api.mymemory.translated.net/get?' + params);
      const data = await res.json();
      if (data.responseStatus !== 200) throw new Error(data.responseDetails || 'Erreur MyMemory');
      translated.push(data.responseData.translatedText);
    }
    return translated.join(' ');
  }
  function fadeSwap(elements, callback) {
    elements.forEach(el => el.style.opacity = '0');
    setTimeout(() => { callback(); elements.forEach(el => el.style.opacity = '1'); }, 220);
  }
  btnTranslate.addEventListener('click', async () => {
    const lang = document.getElementById('lang-select').value;
    const isAr = lang === 'AR';
    btnTranslate.disabled = true; btnTranslate.innerHTML = '⏳ Traduction…';
    btnReset.style.display = 'none'; status.textContent = ''; status.className = 'translate-status';
    try {
      const [newTitre, newDesc] = await Promise.all([myMemoryTranslate(originalTitre, lang), myMemoryTranslate(originalDesc, lang)]);
      fadeSwap([titreEl, descEl], () => {
        titreEl.textContent = newTitre; descEl.textContent = newDesc;
        [titreEl, descEl].forEach(el => { el.style.direction = isAr ? 'rtl' : 'ltr'; el.style.textAlign = isAr ? 'right' : 'left'; });
      });
      if (document.getElementById('article-content')) {
        status.textContent = "Attente du chargement de l'article…";
        await new Promise((resolve, reject) => {
          if (window._articleReady) { resolve(); return; }
          const t = setTimeout(() => reject(new Error('Article non chargé')), 15000);
          document.addEventListener('articleReady', () => { clearTimeout(t); resolve(); }, { once: true });
        });
        const articleBody = document.querySelector('#article-content .article-reader-body');
        const articleTitle = document.querySelector('#article-content .article-reader-title');
        if (articleBody) {
          if (!articleBody.dataset.originalHtml) articleBody.dataset.originalHtml = articleBody.innerHTML;
          if (articleTitle && !articleTitle.dataset.originalText) articleTitle.dataset.originalText = articleTitle.innerText.trim();
          if (articleTitle) { const t = await myMemoryTranslate(articleTitle.innerText.trim(), lang); articleTitle.textContent = t; articleTitle.style.direction = isAr ? 'rtl' : 'ltr'; }
          articleBody.style.opacity = '0.4'; status.textContent = "Traduction de l'article…";
          for (const el of articleBody.querySelectorAll('p,h2,h3,li')) {
            const txt = el.innerText.trim(); if (!txt) continue;
            try { el.textContent = await myMemoryTranslate(txt, lang); el.style.direction = isAr ? 'rtl' : 'ltr'; } catch(e) {}
          }
          articleBody.style.direction = isAr ? 'rtl' : 'ltr'; articleBody.style.opacity = '1';
        }
      }
      const labels = {FR:'Français',EN:'Anglais',AR:'Arabe',DE:'Allemand',ES:'Espagnol',IT:'Italien'};
      status.textContent = '✅ Traduit en ' + (labels[lang] || lang); status.className = 'translate-status ok';
      btnReset.style.display = 'inline-flex';
      showToast('Traduction terminée', 'success');
    } catch(err) {
      status.textContent = '❌ ' + err.message; status.className = 'translate-status err';
      showToast('Erreur de traduction', 'error');
    } finally {
      btnTranslate.disabled = false; btnTranslate.innerHTML = '🌐 Traduire';
    }
  });
  btnReset.addEventListener('click', () => {
    fadeSwap([titreEl, descEl], () => {
      titreEl.textContent = originalTitre; descEl.textContent = originalDesc;
      [titreEl, descEl].forEach(el => { el.style.direction = 'ltr'; el.style.textAlign = 'left'; });
    });
    const articleBody = document.querySelector('#article-content .article-reader-body');
    const articleTitle = document.querySelector('#article-content .article-reader-title');
    if (articleBody && articleBody.dataset.originalHtml) { articleBody.innerHTML = articleBody.dataset.originalHtml; articleBody.style.direction = 'ltr'; articleBody.style.opacity = '1'; }
    if (articleTitle && articleTitle.dataset.originalText) { articleTitle.textContent = articleTitle.dataset.originalText; articleTitle.style.direction = 'ltr'; }
    status.textContent = ''; btnReset.style.display = 'none';
  });
})();

/* ─────────────── Article + Export PDF ─────────────── */
{% if ressource.contenu == 'Article' and ressource.url %}
(function() {
  const container = document.getElementById('article-container');
  if (!container) return;
  const loading = document.getElementById('article-loading');
  const content = document.getElementById('article-content');
  const errorEl = document.getElementById('article-error');
  const articleUrl = container.dataset.url;
  function esc(str) { if (!str) return ''; return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  fetch('/ressources/extract-article', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ url: articleUrl }) })
    .then(r => r.json())
    .then(data => {
      loading.style.display = 'none';
      if (!data.success || !data.content) { showError(data.error || 'Contenu introuvable.'); return; }
      let html = '';
      if (data.partial) html += `<div class="article-warning">⚠️ Certains sites limitent l'accès — affichage partiel.</div>`;
      html += '<div class="article-reader-header">';
      if (data.title) html += `<div class="article-reader-title">${esc(data.title)}</div>`;
      html += '<div class="article-reader-meta">';
      if (data.siteName) html += `<span>🌐 ${esc(data.siteName)}</span>`;
      if (data.author) html += `<span>✍️ ${esc(data.author)}</span>`;
      if (data.publishedAt) { const d = new Date(data.publishedAt); if (!isNaN(d)) html += `<span>📅 ${d.toLocaleDateString('fr-FR')}</span>`; }
      html += '</div></div>';
      if (data.image) html += `<img src="${esc(data.image)}" alt="" class="article-reader-image" onerror="this.style.display='none'">`;
      html += `<div class="article-reader-body">${data.content}</div>`;
      content.innerHTML = html;
      content.style.display = 'block';
      window._articleReady = true;
      document.dispatchEvent(new CustomEvent('articleReady'));
    })
    .catch(err => { loading.style.display = 'none'; showError('Erreur réseau : ' + err.message); });
  function showError(msg) {
    errorEl.style.display = 'block';
    errorEl.innerHTML = `<div class="article-error-box"><div class="error-icon">📭</div><p style="font-weight:600;">${msg}</p></div>`;
  }
})();
(function() {
  const btn = document.getElementById('btn-export-pdf');
  if (!btn) return;
  btn.addEventListener('click', async () => {
    const statusMsg = document.getElementById('export-status-msg');
    const articleBody = document.querySelector('#article-content .article-reader-body');
    const articleTitle = document.querySelector('#article-content .article-reader-title');
    const titreEl = document.getElementById('ressource-titre');
    if (!articleBody) { showToast('Article non encore chargé', 'error'); return; }
    const titre = articleTitle ? articleTitle.innerText.trim() : (titreEl ? titreEl.innerText.trim() : '');
    const contenu = articleBody.innerHTML;
    btn.disabled = true; btn.textContent = '⏳ Génération…'; statusMsg.textContent = '';
    try {
      const response = await fetch('{{ path('ressources_export_pdf_traduit', {id: ressource.id}) }}', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ titre, contenu }) });
      if (!response.ok) throw new Error('Erreur serveur : ' + response.status);
      const blob = await response.blob();
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a'); a.href = url; a.download = 'article-{{ ressource.id }}.pdf';
      document.body.appendChild(a); a.click(); document.body.removeChild(a); URL.revokeObjectURL(url);
      statusMsg.textContent = '✅ PDF téléchargé !'; statusMsg.style.color = 'var(--forest-lt)';
      showToast('PDF téléchargé avec succès', 'success');
    } catch(err) {
      statusMsg.textContent = '❌ ' + err.message; statusMsg.style.color = '#c53030';
      showToast('Erreur lors de l\'export PDF', 'error');
    } finally { btn.disabled = false; btn.textContent = '📄 Exporter en PDF'; }
  });
})();
{% endif %}

/* ─────────────── COMMENTAIRES (Likes JS Seulement) ─────────────── */
(function() {
  // Toggle form réponse
  document.querySelectorAll('.reply-btn-trigger').forEach(btn => {
