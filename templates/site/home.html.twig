              <path d="M10 10 Q10 40 35 40 Q20 40 20 22 Q20 10 35 10 Q20 10 10 10Z" fill="currentColor" opacity=".14"/>
              <path d="M45 10 Q45 40 70 40 Q55 40 55 22 Q55 10 70 10 Q55 10 45 10Z" fill="currentColor" opacity=".14"/>
            </svg>
          </div>
        </div>
      </div>

      {# Contrôles #}
