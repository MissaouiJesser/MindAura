        <button class="quotes-btn" id="quotePrev" title="Citation précédente" aria-label="Précédente">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 5l-5 5 5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>

        <div class="quotes-dots" id="quotesDots"></div>

        <button class="quotes-btn" id="quoteNext" title="Citation suivante" aria-label="Suivante">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
