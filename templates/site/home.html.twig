<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Accueil — MindAura</title>
  <link rel="icon" type="image/png" href="{{ asset('images/logo.png') }}"/>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;1,400&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --g1:          #1B4332;
      --g2:          #2D6A4F;
      --g3:          #52B788;
      --g-pale:      #D8F3DC;
      --g-hover:     #E8F5EE;
      --violet:      #7B5EA7;
      --vio-pale:    #EDE9F6;
      --bg:          #F0F4F8;
      --white:       #FFFFFF;
      --text:        #1A1A2E;
      --text-sec:    #5A6475;
      --border:      #D5DCE6;
      --radius-xl:   20px;
      --radius-lg:   14px;
      --radius-md:   10px;
      --ease:        cubic-bezier(.22,1,.36,1);
      --ease-spring: cubic-bezier(.34,1.56,.64,1);
      --shadow-card: 0 2px 14px rgba(27,67,50,.07), 0 0 0 1px rgba(213,220,230,.5);
      --shadow-hover:0 14px 38px rgba(27,67,50,.18);
      /* Gradient tokens */
      --grad-emerald: linear-gradient(135deg, #1B4332 0%, #2D6A4F 40%, #52B788 100%);
      --grad-aurora:  linear-gradient(135deg, #1B4332 0%, #2D6A4F 35%, #7B5EA7 100%);
      --grad-sage:    linear-gradient(160deg, #D8F3DC 0%, #EDE9F6 100%);
      --grad-glass:   linear-gradient(135deg, rgba(255,255,255,.18) 0%, rgba(255,255,255,.05) 100%);
    }

    html { scroll-behavior: smooth; }
    body {
      font-family: 'Outfit', sans-serif;
      background: var(--bg);
      color: var(--text);
      overflow-x: hidden;
      line-height: 1.6;
    }

    /* ══════════════════════════════════════
       CURSOR GLOW
    ══════════════════════════════════════ */
    .cursor-glow {
      pointer-events: none; position: fixed;
      width: 400px; height: 400px; border-radius: 50%;
      background: radial-gradient(circle, rgba(82,183,136,.07) 0%, transparent 70%);
      transform: translate(-50%,-50%); z-index: 0;
      transition: opacity .4s;
    }

    /* ══════════════════════════════════════
       NAVBAR
    ══════════════════════════════════════ */
    .nav {
      position: sticky; top: 0; z-index: 999;
      background: rgba(255,255,255,.92);
      backdrop-filter: blur(24px) saturate(180%);
      border-bottom: 1px solid rgba(27,67,50,.08);
      padding: 0 48px;
      display: flex; align-items: center; gap: 20px;
      height: 76px;
      transition: box-shadow .35s var(--ease), height .35s var(--ease);
    }
    .nav.scrolled {
      height: 64px;
      box-shadow: 0 4px 32px rgba(27,67,50,.13);
      border-bottom-color: rgba(27,67,50,.12);
    }

    /* ── Logo brand (enlarged, no background) ── */
    .nav-brand {
      display: flex; align-items: center; gap: 13px;
      text-decoration: none; flex-shrink: 0;
    }
    .nav-brand-logo-wrap {
      position: relative;
      width: 56px; height: 56px;
      transition: transform .5s var(--ease-spring);
    }
    .nav.scrolled .nav-brand-logo-wrap { width: 46px; height: 46px; }
    .nav-brand:hover .nav-brand-logo-wrap { transform: rotate(-8deg) scale(1.08); }

    /* Animated halo ring behind logo */
    .nav-brand-logo-wrap::before {
      content: '';
      position: absolute; inset: -4px; border-radius: 50%;
      background: conic-gradient(from 0deg, var(--g3), var(--violet), var(--g3));
      opacity: 0;
      transition: opacity .4s var(--ease);
      animation: spinRing 4s linear infinite;
      z-index: 0;
    }
    .nav-brand-logo-wrap::after {
      content: '';
      position: absolute; inset: 2px; border-radius: 50%;
      background: white; z-index: 1;
    }
    .nav-brand:hover .nav-brand-logo-wrap::before { opacity: .7; }
    @keyframes spinRing { to { transform: rotate(360deg); } }

    .nav-brand-img {
      position: relative; z-index: 2;
      width: 100%; height: 100%;
      object-fit: contain; border-radius: 50%;
      display: block;
      filter: drop-shadow(0 3px 10px rgba(27,67,50,.25));
      transition: filter .35s, transform .35s var(--ease);
    }
    .nav-brand:hover .nav-brand-img {
      filter: drop-shadow(0 6px 18px rgba(27,67,50,.4)) brightness(1.05);
    }

    .nav-brand-text { display: flex; flex-direction: column; }
    .nav-brand-name {
      font-family: 'Playfair Display', serif;
      font-size: 1.32rem; font-weight: 700; color: var(--text);
      line-height: 1.1;
      background: var(--grad-emerald);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      background-clip: text;
      transition: opacity .3s;
    }
    .nav-brand-sub {
      font-size: .58rem; color: var(--text-sec);
      letter-spacing: 1.4px; text-transform: uppercase; font-weight: 600;
    }

    .nav-links { flex: 1; display: flex; align-items: center; gap: 2px; justify-content: center; }
    .nav-link {
      position: relative;
      padding: 8px 18px; border-radius: 99px;
      font-size: .87rem; font-weight: 500; color: var(--text-sec);
      text-decoration: none; transition: all .25s var(--ease);
      overflow: hidden;
    }
    .nav-link::before {
      content: ''; position: absolute; inset: 0; border-radius: 99px;
      background: var(--grad-sage); opacity: 0; transition: opacity .25s;
    }
    .nav-link:hover::before { opacity: 1; }
    .nav-link:hover { color: var(--g1); }
    .nav-link span { position: relative; z-index: 1; }

    .nav-right { display: flex; align-items: center; gap: 10px; }

    /* ── NAV USER PILL → DROPDOWN ── */
    .nav-user-pill-wrapper { position: relative; }
    .nav-user-pill {
      display: flex; align-items: center; gap: 9px;
      padding: 5px 14px 5px 5px; border-radius: 99px;
      background: var(--bg); border: 1.5px solid rgba(27,67,50,.13);
      cursor: pointer; font-family: 'Outfit', sans-serif;
      transition: all .25s var(--ease);
    }
    .nav-user-pill:hover,
    .nav-user-pill[aria-expanded="true"] {
      background: var(--g-hover);
      border-color: var(--g3);
      box-shadow: 0 0 0 4px rgba(82,183,136,.14);
    }
    .nav-avatar {
      width: 32px; height: 32px; border-radius: 50%;
      background: var(--g-pale); border: 2px solid var(--g3);
      display: grid; place-items: center;
      font-size: .77rem; font-weight: 700; color: var(--g1);
      overflow: hidden; flex-shrink: 0;
    }
    .nav-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .nav-user-name { font-size: .83rem; font-weight: 600; color: var(--text); }
    .nav-role-badge {
      font-size: .7rem; color: var(--text-sec);
      background: var(--g-pale); padding: 2px 8px; border-radius: 99px; font-weight: 600;
    }
    .pill-chevron {
      width: 14px; height: 14px; stroke: var(--text-sec);
      transition: transform .3s var(--ease); margin-left: 2px;
      fill: none; stroke-width: 2;
    }
    .nav-user-pill[aria-expanded="true"] .pill-chevron { transform: rotate(180deg); }

    /* Dropdown */
    .user-dropdown {
      position: absolute; top: calc(100% + 10px); right: 0;
      width: 290px;
      background: var(--white);
      border: 1.5px solid var(--border);
      border-radius: var(--radius-lg);
      box-shadow: 0 20px 48px rgba(27,67,50,.14), 0 4px 12px rgba(27,67,50,.07);
      z-index: 1000;
      opacity: 0; visibility: hidden;
      transform: translateY(-8px) scale(.97);
      transform-origin: top right;
      transition: opacity .22s var(--ease), transform .22s var(--ease), visibility .22s;
      overflow: hidden;
    }
    .user-dropdown.open {
      opacity: 1; visibility: visible;
      transform: translateY(0) scale(1);
    }
    .dropdown-header {
      display: flex; align-items: center; gap: 12px;
      padding: 16px 18px 14px;
      background: linear-gradient(135deg, var(--g-pale) 0%, rgba(255,255,255,0) 100%);
    }
    .dropdown-avatar {
      width: 44px; height: 44px; border-radius: 50%;
      background: var(--grad-emerald);
      border: 2.5px solid var(--g3);
      display: grid; place-items: center;
      font-size: .9rem; font-weight: 700; color: #fff;
      overflow: hidden; flex-shrink: 0;
      box-shadow: 0 3px 10px rgba(27,67,50,.2);
    }
    .dropdown-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .dropdown-user-name  { font-size: .9rem; font-weight: 700; color: var(--text); line-height: 1.2; }
    .dropdown-user-email {
      font-size: .74rem; color: var(--text-sec); margin-top: 2px;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 180px;
    }
    .dropdown-divider { height: 1px; background: var(--border); margin: 4px 0; }
    .dropdown-item {
      display: flex; align-items: center; gap: 12px;
      padding: 11px 18px; text-decoration: none; color: var(--text);
      transition: background .18s var(--ease);
    }
    .dropdown-item:hover { background: var(--g-hover); }
    .dropdown-item-icon {
      width: 36px; height: 36px; border-radius: 10px; flex-shrink: 0;
      background: var(--g-pale); display: grid; place-items: center;
      transition: transform .2s var(--ease);
    }
    .dropdown-item-icon svg { width: 17px; height: 17px; stroke: var(--g1); fill: none; stroke-width: 1.8; }
    .dropdown-item:hover .dropdown-item-icon { transform: scale(1.08); }
    .dropdown-item-icon--violet { background: var(--vio-pale); }
    .dropdown-item-icon--violet svg { stroke: var(--violet); }
    .dropdown-item-icon--red { background: #FEF2F2; }
    .dropdown-item-icon--red svg { stroke: #DC2626; }
    .dropdown-item-text { flex: 1; display: flex; flex-direction: column; gap: 1px; }
    .dropdown-item-label { font-size: .87rem; font-weight: 600; }
    .dropdown-item-sub   { font-size: .73rem; color: var(--text-sec); }
    .dropdown-item-arrow {
      width: 14px; height: 14px; fill: none; stroke: var(--border); stroke-width: 2;
      transition: stroke .2s, transform .2s var(--ease);
    }
    .dropdown-item:hover .dropdown-item-arrow { stroke: var(--g3); transform: translateX(3px); }
    .dropdown-item--danger .dropdown-item-label { color: #DC2626; }
    .dropdown-item--danger:hover { background: #FEF2F2; }

    /* ══════════════════════════════════════
       HERO — full-bleed with image parallax
    ══════════════════════════════════════ */
    .hero {
      position: relative; overflow: hidden;
      min-height: 100vh;
      display: flex; flex-direction: column; justify-content: center;
      padding: 120px 48px 100px;
      text-align: center;
    }

    /* Base gradient over image */
    .hero-bg {
      position: absolute; inset: 0; z-index: 0;
      background-image: url("{{ asset('images/background.jpg') }}");
      background-size: cover; background-position: center top;
      background-attachment: fixed; /* parallax */
      transform: scale(1.04); /* avoid edge gaps on parallax */
      transition: transform 0s;
    }
    /* Dark gradient overlay for readability */
    .hero-bg::after {
      content: ''; position: absolute; inset: 0;
      background:
        linear-gradient(180deg, rgba(15,35,25,.72) 0%, rgba(27,67,50,.65) 45%, rgba(15,30,22,.82) 100%),
        radial-gradient(ellipse 70% 50% at 50% 110%, rgba(82,183,136,.3) 0%, transparent 60%);
    }

    .blob {
      position: absolute; border-radius: 50%;
      filter: blur(80px); opacity: .18; pointer-events: none;
      animation: blobFloat 10s ease-in-out infinite; z-index: 1;
    }
    .blob-1 { width: 520px; height: 520px; background: #52B788; top: -140px; left: -110px; }
    .blob-2 { width: 380px; height: 380px; background: #7B5EA7; bottom: -100px; right: -70px; animation-delay: -4s; }
    .blob-3 { width: 260px; height: 260px; background: #95D5B2; top: 40%; left: 60%; animation-delay: -7s; }
    @keyframes blobFloat {
      0%,100% { transform: translate(0,0) scale(1); }
      33%      { transform: translate(28px,-22px) scale(1.07); }
      66%      { transform: translate(-16px,16px) scale(.93); }
    }

    /* Floating particles */
    .particle {
      position: absolute; border-radius: 50%; pointer-events: none; z-index: 1;
      opacity: .35; animation: particleDrift linear infinite;
    }
    @keyframes particleDrift {
      0%   { transform: translateY(0) rotate(0deg); opacity: .35; }
      100% { transform: translateY(-100vh) rotate(360deg); opacity: 0; }
    }

    .hero-inner {
      position: relative; z-index: 2;
      max-width: 820px; margin: 0 auto;
    }

    .hero-badge {
      display: inline-flex; align-items: center; gap: 9px;
      background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.24);
      border-radius: 99px; padding: 7px 20px;
      font-size: .77rem; font-weight: 600; color: rgba(255,255,255,.92);
      margin-bottom: 26px; backdrop-filter: blur(10px);
      animation: fadeUp .6s var(--ease) .05s both;
      box-shadow: 0 4px 20px rgba(0,0,0,.15), inset 0 1px 0 rgba(255,255,255,.12);
    }
    .badge-dot {
      width: 7px; height: 7px; border-radius: 50%;
      background: #52B788; box-shadow: 0 0 10px #52B788, 0 0 20px rgba(82,183,136,.4);
      animation: pulseDot 2s ease-in-out infinite;
    }
    @keyframes pulseDot { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(1.5)} }

    .hero-title {
      font-family: 'Playfair Display', serif;
      font-size: clamp(2.6rem, 6vw, 4.5rem);
      color: #fff; line-height: 1.06; margin-bottom: 24px; letter-spacing: -.5px;
      animation: fadeUp .7s var(--ease) .15s both;
      text-shadow: 0 4px 32px rgba(0,0,0,.35);
    }
    .hero-title em {
      font-style: italic;
      background: linear-gradient(135deg, #95D5B2, #52B788, #b7e4c7);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      background-clip: text;
      background-size: 200%; animation: shimmerText 3s ease infinite;
    }
    @keyframes shimmerText {
      0%   { background-position: 0% 50%; }
      50%  { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    .hero-desc {
      font-size: 1.08rem; color: rgba(255,255,255,.76); line-height: 1.82;
      margin-bottom: 42px;
      animation: fadeUp .7s var(--ease) .25s both;
      text-shadow: 0 1px 8px rgba(0,0,0,.2);
    }
    .hero-actions {
      display: flex; align-items: center; justify-content: center; gap: 16px; flex-wrap: wrap;
      animation: fadeUp .7s var(--ease) .35s both;
    }
    .btn-white {
      display: inline-flex; align-items: center; gap: 8px;
      background: #fff; color: var(--g1); border-radius: 99px;
      padding: 14px 32px; font-family: 'Outfit', sans-serif;
      font-size: .94rem; font-weight: 700; text-decoration: none;
      box-shadow: 0 6px 24px rgba(0,0,0,.22), 0 2px 8px rgba(0,0,0,.1);
      transition: all .3s var(--ease-spring);
      position: relative; overflow: hidden;
    }
    .btn-white::before {
      content: '';
      position: absolute; inset: 0; border-radius: 99px;
      background: var(--grad-sage); opacity: 0; transition: opacity .3s;
    }
    .btn-white:hover { transform: translateY(-4px) scale(1.02); box-shadow: 0 12px 36px rgba(0,0,0,.28); }
    .btn-white:hover::before { opacity: 1; }
    .btn-white span { position: relative; z-index: 1; }
    .btn-glass {
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(255,255,255,.12); border: 1.5px solid rgba(255,255,255,.32);
      color: #fff; border-radius: 99px;
      padding: 13px 30px; font-family: 'Outfit', sans-serif;
      font-size: .94rem; font-weight: 600; text-decoration: none;
      backdrop-filter: blur(12px); transition: all .3s var(--ease);
      box-shadow: 0 4px 16px rgba(0,0,0,.18), inset 0 1px 0 rgba(255,255,255,.12);
    }
    .btn-glass:hover { background: rgba(255,255,255,.22); transform: translateY(-4px); box-shadow: 0 10px 30px rgba(0,0,0,.24); }

    .hero-stats {
      display: flex; align-items: center; justify-content: center; gap: 50px;
      margin-top: 68px; padding-top: 48px;
      border-top: 1px solid rgba(255,255,255,.14);
      flex-wrap: wrap;
      animation: fadeUp .7s var(--ease) .45s both;
    }
    .hero-stat { text-align: center; }
    .hero-stat-num {
      font-family: 'Playfair Display', serif; font-size: 2.4rem;
      font-weight: 700; line-height: 1;
      background: linear-gradient(135deg, #fff 30%, #95D5B2 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .hero-stat-lbl { font-size: .72rem; color: rgba(255,255,255,.55); font-weight: 500; margin-top: 6px; text-transform: uppercase; letter-spacing: .9px; }
    .hero-stat-div { width: 1px; height: 50px; background: linear-gradient(to bottom, transparent, rgba(255,255,255,.2), transparent); }

    @keyframes fadeUp { from{opacity:0;transform:translateY(28px)} to{opacity:1;transform:none} }

    /* ══════════════════════════════════════
       SCROLL INDICATOR
    ══════════════════════════════════════ */
    .scroll-indicator {
      position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%);
      z-index: 2; display: flex; flex-direction: column; align-items: center; gap: 8px;
      animation: fadeUp .7s var(--ease) .9s both, bounce 2.2s ease-in-out 1.5s infinite;
      cursor: pointer;
    }
    .scroll-indicator span { font-size: .67rem; color: rgba(255,255,255,.4); letter-spacing: 1.5px; text-transform: uppercase; }
    .scroll-mouse {
      width: 24px; height: 38px; border: 1.5px solid rgba(255,255,255,.3);
      border-radius: 99px; position: relative; display: flex; justify-content: center;
    }
    .scroll-mouse::after {
      content: ''; width: 3px; height: 8px; background: rgba(255,255,255,.5);
      border-radius: 99px; position: absolute; top: 6px;
      animation: scrollWheel 1.8s ease-in-out infinite;
    }
    @keyframes scrollWheel { 0%,100%{transform:translateY(0);opacity:.6} 50%{transform:translateY(10px);opacity:1} }
    @keyframes bounce { 0%,100%{transform:translateX(-50%) translateY(0)} 50%{transform:translateX(-50%) translateY(-6px)} }

    /* ══════════════════════════════════════
       WAVE
    ══════════════════════════════════════ */
    .wave { display: block; overflow: hidden; line-height: 0; }
    .wave svg { display: block; width: 100%; }

    /* ══════════════════════════════════════
       SECTIONS
    ══════════════════════════════════════ */
    .section      { padding: 96px 48px; position: relative; overflow: hidden; }
    .section-alt  { background: var(--white); }

    /* Subtle section bg texture */
    .section:not(.section-alt) {
      background:
        radial-gradient(ellipse 80% 40% at 20% 110%, rgba(82,183,136,.07) 0%, transparent 60%),
        radial-gradient(ellipse 60% 35% at 80% -10%, rgba(123,94,167,.06) 0%, transparent 55%),
        var(--bg);
    }

    .section-inner { max-width: 1200px; margin: 0 auto; }

    /* Floating section bg shapes */
    .section-shape {
      position: absolute; border-radius: 50%; pointer-events: none; opacity: .06;
      background: var(--g3); filter: blur(80px); z-index: 0;
    }

    .sec-label {
      display: inline-flex; align-items: center; gap: 7px;
      font-size: .71rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
      color: var(--violet); background: var(--vio-pale); border-radius: 99px;
      padding: 5px 14px; margin-bottom: 12px;
    }
    .sec-title {
      font-family: 'Playfair Display', serif;
      font-size: clamp(1.9rem, 3.5vw, 3rem);
      color: var(--text); line-height: 1.16; margin-bottom: 14px; letter-spacing: -.3px;
    }
    .sec-title span {
      font-style: italic;
      background: var(--grad-emerald);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .sec-desc { font-size: .96rem; color: var(--text-sec); line-height: 1.78; max-width: 540px; }
    .sec-center { text-align: center; margin-bottom: 56px; }
    .sec-center .sec-desc { margin: 0 auto; }

    /* ══════════════════════════════════════
       SERVICES
    ══════════════════════════════════════ */
    .grid-3 { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; position: relative; z-index: 1; }

    .svc-card {
      background: var(--white);
      border-radius: var(--radius-xl);
      padding: 34px 30px;
      border: 1.5px solid transparent;
      box-shadow: var(--shadow-card);
      transition: transform .35s var(--ease-spring), box-shadow .35s var(--ease), border-color .35s;
      position: relative; overflow: hidden;
    }
    /* Gradient top bar */
    .svc-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, var(--g1), var(--g3), var(--violet));
      transform: scaleX(0); transform-origin: left; transition: transform .4s var(--ease);
    }
    /* Soft glow bg on hover */
    .svc-card::after {
      content: ''; position: absolute; inset: 0; pointer-events: none;
      background: radial-gradient(ellipse 70% 55% at 50% 110%, rgba(82,183,136,.07) 0%, transparent 65%);
      opacity: 0; transition: opacity .4s;
    }
    .svc-card:hover {
      transform: translateY(-8px) scale(1.01);
      box-shadow: var(--shadow-hover), 0 0 0 1px rgba(82,183,136,.1);
      border-color: rgba(82,183,136,.2);
    }
    .svc-card:hover::before { transform: scaleX(1); }
    .svc-card:hover::after  { opacity: 1; }
    .svc-icon {
      width: 58px; height: 58px; border-radius: 16px;
      display: grid; place-items: center; margin-bottom: 20px; font-size: 1.5rem;
      transition: transform .35s var(--ease-spring);
    }
    .svc-card:hover .svc-icon { transform: scale(1.1) rotate(-5deg); }
    .svc-icon.g  { background: linear-gradient(135deg, #D8F3DC, #b7e4c7); }
    .svc-icon.v  { background: linear-gradient(135deg, #EDE9F6, #d8b4fe60); }
    .svc-icon.t  { background: linear-gradient(135deg, #E0F2F1, #b2dfdb); }
    .svc-icon.o  { background: linear-gradient(135deg, #FFF3E0, #ffe0b2); }
    .svc-title { font-size: 1.05rem; font-weight: 700; color: var(--text); margin-bottom: 10px; }
    .svc-desc  { font-size: .85rem; color: var(--text-sec); line-height: 1.68; }
    .svc-tag {
      display: inline-block; margin-top: 18px;
      background: var(--g-hover); color: var(--g1);
      border-radius: 99px; font-size: .71rem; font-weight: 700; padding: 4px 13px;
      transition: background .25s, color .25s;
    }
    .svc-card:hover .svc-tag { background: var(--g-pale); color: var(--g2); }

    /* ══════════════════════════════════════
       TEAM
    ══════════════════════════════════════ */
    .grid-team {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 28px; position: relative; z-index: 1;
    }
    .team-card {
      background: var(--white);
      border-radius: var(--radius-xl);
      padding: 36px 26px 28px;
      text-align: center;
      box-shadow: var(--shadow-card);
      border: 1.5px solid transparent;
      position: relative; overflow: hidden;
      transition: transform .45s var(--ease-spring), box-shadow .45s var(--ease), border-color .45s;
    }
    .team-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px;
      background: linear-gradient(90deg, var(--g1), var(--g3), var(--violet));
      transform: scaleX(0); transform-origin: left;
      transition: transform .5s var(--ease);
      border-radius: 4px 4px 0 0;
    }
    .team-card::after {
      content: ''; position: absolute; bottom: -60px; right: -60px;
      width: 180px; height: 180px; border-radius: 50%;
      background: radial-gradient(circle, rgba(82,183,136,.1) 0%, transparent 70%);
      transition: transform .5s var(--ease), opacity .5s; opacity: 0;
    }
    .team-card:hover { transform: translateY(-10px) scale(1.01); box-shadow: var(--shadow-hover), 0 0 0 1px rgba(82,183,136,.12); border-color: var(--g-pale); }
    .team-card:hover::before { transform: scaleX(1); }
    .team-card:hover::after  { opacity: 1; transform: scale(1.4); }
    .team-avatar {
      width: 96px; height: 96px; border-radius: 50%; margin: 0 auto 18px;
      background: var(--grad-emerald);
      display: grid; place-items: center; font-size: 2rem;
      border: 3px solid transparent;
      background-clip: padding-box;
      box-shadow: 0 6px 22px rgba(27,67,50,.18), 0 0 0 3px rgba(82,183,136,.2);
      position: relative; overflow: hidden;
      transition: transform .45s var(--ease-spring), box-shadow .45s var(--ease);
    }
    .team-avatar img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; display: block; }
    .team-card:hover .team-avatar { transform: scale(1.08) rotate(-4deg); box-shadow: 0 12px 36px rgba(27,67,50,.3), 0 0 0 4px rgba(82,183,136,.3); }
    .team-avatar-dot {
      position: absolute; bottom: 5px; right: 5px;
      width: 14px; height: 14px; border-radius: 50%;
      background: #22C55E; border: 2.5px solid #fff;
      box-shadow: 0 0 0 0 rgba(34,197,94,.4);
      animation: pulseGreen 2.4s ease-in-out infinite;
    }
    @keyframes pulseGreen { 0%,100%{box-shadow:0 0 0 0 rgba(34,197,94,.4)} 50%{box-shadow:0 0 0 7px rgba(34,197,94,0)} }
    .team-name { font-size: 1.04rem; font-weight: 700; color: var(--text); margin-bottom: 5px; transition: color .3s; }
    .team-card:hover .team-name { color: var(--g1); }
    .team-role {
      display: inline-block; font-size: .72rem; font-weight: 700;
      padding: 4px 14px; border-radius: 99px;
      background: var(--vio-pale); color: var(--violet); margin-bottom: 13px;
      transition: background .3s, color .3s;
    }
    .team-card:hover .team-role { background: var(--g-pale); color: var(--g1); }
    .team-bio { font-size: .83rem; color: var(--text-sec); line-height: 1.68; transition: color .3s; }
    .team-card:hover .team-bio { color: var(--text); }
    .team-socials { display: flex; justify-content: center; gap: 10px; margin-top: 18px; }
    .social-btn {
      width: 36px; height: 36px; border-radius: 10px;
      display: grid; place-items: center; border: 1.5px solid rgba(27,67,50,.1);
      text-decoration: none; transition: all .3s var(--ease-spring);
      position: relative; overflow: hidden;
    }
    .social-btn::before {
      content: ''; position: absolute; inset: 0; opacity: 0;
      transition: opacity .3s; border-radius: inherit;
    }
    .social-btn.instagram::before { background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888); }
    .social-btn.facebook::before  { background: #1877f2; }
    .social-btn:hover::before { opacity: 1; }
    .social-btn:hover { border-color: transparent; transform: translateY(-4px) scale(1.12); box-shadow: 0 8px 20px rgba(0,0,0,.18); }
    .social-btn svg { width: 16px; height: 16px; fill: none; stroke: var(--text-sec); stroke-width: 1.8; transition: stroke .3s; position: relative; z-index: 1; }
    .social-btn:hover svg { stroke: #fff; }

    /* ══════════════════════════════════════
       FAQ
    ══════════════════════════════════════ */
    .faq-layout { display: grid; grid-template-columns: 1fr 1.65fr; gap: 64px; align-items: start; position: relative; z-index: 1; }
    .faq-item {
      background: var(--white); border-radius: var(--radius-lg);
      border: 1.5px solid rgba(27,67,50,.08); margin-bottom: 10px;
      overflow: hidden; transition: border-color .25s, box-shadow .25s, transform .25s var(--ease);
    }
    .faq-item:hover { border-color: var(--g3); box-shadow: 0 4px 20px rgba(27,67,50,.07); transform: translateX(4px); }
    .faq-q {
      width: 100%; padding: 20px 24px; background: none; border: none; cursor: pointer;
      display: flex; align-items: center; justify-content: space-between; gap: 16px;
      font-family: 'Outfit', sans-serif; font-size: .92rem; font-weight: 600; color: var(--text);
      text-align: left; transition: color .25s;
    }
    .faq-q:hover { color: var(--g1); }
    .faq-icon {
      width: 28px; height: 28px; border-radius: 8px; background: var(--bg);
      display: grid; place-items: center; flex-shrink: 0; transition: all .3s var(--ease);
    }
    .faq-icon svg { width: 14px; height: 14px; stroke: var(--text-sec); fill: none; stroke-width: 2; transition: transform .35s var(--ease); }
    .faq-body {
      padding: 0 24px; max-height: 0; overflow: hidden;
      font-size: .87rem; color: var(--text-sec); line-height: 1.72;
      transition: max-height .42s var(--ease), padding .42s var(--ease);
    }
    .faq-item.open .faq-body    { max-height: 220px; padding-bottom: 22px; }
    .faq-item.open .faq-icon    { background: var(--g-pale); }
    .faq-item.open .faq-icon svg { stroke: var(--g1); transform: rotate(45deg); }
    .faq-item.open .faq-q       { color: var(--g1); }

    /* ══════════════════════════════════════
       BUTTONS (shared)
    ══════════════════════════════════════ */
    .btn-solid {
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--grad-emerald); color: #fff; border-radius: 99px;
      padding: 13px 30px; font-family: 'Outfit', sans-serif;
      font-size: .92rem; font-weight: 700; text-decoration: none;
      box-shadow: 0 4px 18px rgba(27,67,50,.28); transition: all .3s var(--ease-spring);
    }
    .btn-solid:hover { transform: translateY(-3px) scale(1.02); box-shadow: 0 10px 28px rgba(27,67,50,.35); }

    /* ══════════════════════════════════════
       MAP
    ══════════════════════════════════════ */
    .map-wrap {
      border-radius: var(--radius-xl); overflow: hidden;
      box-shadow: 0 10px 40px rgba(27,67,50,.13);
      border: 1.5px solid rgba(27,67,50,.08);
      height: 420px; position: relative;
      transition: box-shadow .35s var(--ease), transform .35s var(--ease);
    }
    .map-wrap:hover { box-shadow: 0 18px 52px rgba(27,67,50,.18); transform: translateY(-4px); }
    .map-wrap iframe { width: 100%; height: 100%; border: none; display: block; }
    .map-pin {
      position: absolute; top: 18px; left: 18px;
      background: rgba(255,255,255,.96); backdrop-filter: blur(12px);
      border-radius: 13px; padding: 13px 18px;
      box-shadow: 0 4px 20px rgba(27,67,50,.14);
      border: 1px solid rgba(27,67,50,.08);
    }
    .map-pin-name { font-size: .9rem; font-weight: 700; color: var(--text); }
    .map-pin-addr { font-size: .74rem; color: var(--text-sec); margin-top: 2px; }

    /* ══════════════════════════════════════
       CONTACT
    ══════════════════════════════════════ */
    .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 44px; align-items: start; position: relative; z-index: 1; }
    .contact-form {
      background: var(--white); border-radius: var(--radius-xl);
      padding: 40px; box-shadow: var(--shadow-card);
      border: 1.5px solid rgba(27,67,50,.05);
      transition: box-shadow .35s var(--ease), transform .35s var(--ease);
    }
    .contact-form:hover { box-shadow: var(--shadow-hover); transform: translateY(-3px); }
    .contact-form-title {
      font-family: 'Playfair Display', serif; font-size: 1.3rem;
      color: var(--text); margin-bottom: 24px;
    }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .form-group { margin-bottom: 16px; }
    .form-label { display: block; font-size: .81rem; font-weight: 600; color: var(--text); margin-bottom: 6px; }
    .form-control {
      width: 100%; padding: 12px 16px; border-radius: var(--radius-md);
      border: 1.5px solid rgba(27,67,50,.12); background: var(--bg);
      font-family: 'Outfit', sans-serif; font-size: .9rem; color: var(--text);
      outline: none; transition: border-color .25s, box-shadow .25s, background .25s;
    }
    .form-control:focus { border-color: var(--g2); box-shadow: 0 0 0 4px rgba(45,106,79,.1); background: #fff; }
    .form-control::placeholder { color: var(--text-sec); opacity: .7; }
    textarea.form-control { resize: vertical; min-height: 120px; }
    .btn-send {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      width: 100%; padding: 15px; border-radius: var(--radius-md);
      background: var(--grad-emerald); color: #fff;
      font-family: 'Outfit', sans-serif; font-size: .93rem; font-weight: 700;
      border: none; cursor: pointer;
      box-shadow: 0 4px 18px rgba(27,67,50,.28);
      transition: all .3s var(--ease-spring);
    }
    .btn-send:hover { transform: translateY(-3px); box-shadow: 0 10px 28px rgba(27,67,50,.36); }
    .btn-send svg { width: 17px; height: 17px; stroke: #fff; fill: none; stroke-width: 1.9; }
    .contact-info { display: flex; flex-direction: column; gap: 16px; }
    .contact-item {
      display: flex; align-items: flex-start; gap: 15px;
      background: var(--white); border-radius: var(--radius-lg); padding: 18px 20px;
      box-shadow: var(--shadow-card); border: 1.5px solid transparent;
      transition: all .3s var(--ease);
    }
    .contact-item:hover { border-color: var(--g-pale); transform: translateX(6px); box-shadow: var(--shadow-hover); }
    .contact-icon {
      width: 44px; height: 44px; border-radius: 12px;
      background: linear-gradient(135deg, var(--g-pale), #b7e4c7);
      display: grid; place-items: center; flex-shrink: 0;
      transition: transform .3s var(--ease-spring);
    }
    .contact-item:hover .contact-icon { transform: scale(1.1) rotate(-5deg); }
    .contact-icon svg { width: 20px; height: 20px; stroke: var(--g1); fill: none; stroke-width: 1.8; }
    .citem-title { font-size: .85rem; font-weight: 700; color: var(--text); margin-bottom: 3px; }
    .citem-val   { font-size: .82rem; color: var(--text-sec); line-height: 1.55; }
    .contact-cta {
      background: var(--grad-aurora);
      border-radius: var(--radius-lg); padding: 24px;
      position: relative; overflow: hidden;
    }
    .contact-cta::before {
      content: ''; position: absolute; inset: 0;
      background: url("{{ asset('images/hero-bg.jpg') }}") center/cover no-repeat;
      opacity: .08; mix-blend-mode: overlay;
    }
    .ccta-title { font-size: .87rem; font-weight: 700; color: #fff; margin-bottom: 7px; position: relative; }
    .ccta-desc  { font-size: .81rem; color: rgba(255,255,255,.72); line-height: 1.62; margin-bottom: 16px; position: relative; }
    .btn-call {
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.28);
      color: #fff; border-radius: 99px; padding: 8px 18px;
      font-size: .82rem; font-weight: 600; text-decoration: none;
      transition: all .25s var(--ease); position: relative;
    }
    .btn-call:hover { background: rgba(255,255,255,.28); transform: translateY(-2px); }

    /* ══════════════════════════════════════
       FOOTER
    ══════════════════════════════════════ */
    .footer {
      background:
        linear-gradient(160deg, #0d2118 0%, #1B4332 60%, #162233 100%);
      padding: 64px 48px 32px;
      position: relative; overflow: hidden;
    }
    .footer::before {
      content: ''; position: absolute; inset: 0; pointer-events: none;
      background: radial-gradient(ellipse 70% 50% at 80% 110%, rgba(82,183,136,.12) 0%, transparent 60%),
                  radial-gradient(ellipse 40% 30% at 10% -10%, rgba(123,94,167,.1) 0%, transparent 55%);
    }
    .footer-inner { max-width: 1200px; margin: 0 auto; position: relative; z-index: 1; }
    .footer-top {
      display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 44px;
      margin-bottom: 50px;
    }
    .footer-brand-name { font-family: 'Playfair Display', serif; font-size: 1.38rem; color: #fff; }
    .footer-brand-sub  { font-size: .59rem; color: rgba(255,255,255,.4); letter-spacing: 1.2px; text-transform: uppercase; font-weight: 600; }
    .footer-tagline    { font-size: .85rem; color: rgba(255,255,255,.5); line-height: 1.72; margin-top: 14px; max-width: 265px; }
    .footer-socials { display: flex; gap: 9px; margin-top: 20px; }
    .f-social {
      width: 36px; height: 36px; border-radius: 9px;
      background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.11);
      display: grid; place-items: center; text-decoration: none;
      transition: all .3s var(--ease-spring);
    }
    .f-social:hover { background: var(--g2); border-color: var(--g2); transform: translateY(-3px) scale(1.1); box-shadow: 0 6px 18px rgba(0,0,0,.25); }
    .f-social svg { width: 16px; height: 16px; stroke: rgba(255,255,255,.6); fill: none; stroke-width: 1.8; }
    .footer-col-title {
      font-size: .73rem; font-weight: 700; letter-spacing: 1.2px;
      text-transform: uppercase; color: rgba(255,255,255,.9); margin-bottom: 16px;
    }
    .footer-link {
      display: block; font-size: .84rem; color: rgba(255,255,255,.5);
      text-decoration: none; padding: 4px 0; transition: color .22s, transform .22s;
    }
    .footer-link:hover { color: #fff; transform: translateX(4px); }
    .footer-bottom {
      border-top: 1px solid rgba(255,255,255,.08);
      padding-top: 26px;
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 10px;
    }
    .footer-copy  { font-size: .78rem; color: rgba(255,255,255,.32); }
    .footer-heart { font-size: .72rem; color: rgba(255,255,255,.32); }
    .footer-heart span { color: var(--g3); }

    /* ══════════════════════════════════════
       SCROLL REVEAL
    ══════════════════════════════════════ */
    .sr   { opacity: 0; transform: translateY(36px); transition: opacity .75s var(--ease), transform .75s var(--ease); }
    .sr-l { opacity: 0; transform: translateX(-36px); transition: opacity .75s var(--ease), transform .75s var(--ease); }
    .sr-r { opacity: 0; transform: translateX(36px);  transition: opacity .75s var(--ease), transform .75s var(--ease); }
    .sr.in, .sr-l.in, .sr-r.in { opacity: 1; transform: none; }

    /* Stagger helpers */
    .sr:nth-child(2) { transition-delay: .08s; }
    .sr:nth-child(3) { transition-delay: .16s; }
    .sr:nth-child(4) { transition-delay: .24s; }
    .sr:nth-child(5) { transition-delay: .32s; }
    .sr:nth-child(6) { transition-delay: .40s; }

    /* TOAST */
    .toast {
      position: fixed; bottom: 32px; right: 32px; z-index: 9999;
      background: var(--grad-emerald); color: #fff;
      padding: 14px 24px; border-radius: 14px;
      font-size: .88rem; font-weight: 600;
      box-shadow: 0 10px 32px rgba(27,67,50,.35);
      display: flex; align-items: center; gap: 10px;
      transform: translateY(90px); opacity: 0;
      transition: all .45s var(--ease-spring); pointer-events: none;
    }
    .toast.show { transform: none; opacity: 1; }

    /* RESPONSIVE */
    @media(max-width:1024px) {
      .grid-team { grid-template-columns: repeat(2,1fr); }
      .footer-top { grid-template-columns: 1fr 1fr; }
    }
    @media(max-width:860px) {
      .grid-3 { grid-template-columns: 1fr 1fr; }
      .faq-layout { grid-template-columns: 1fr; gap: 36px; }
      .contact-grid { grid-template-columns: 1fr; }
    }
    @media(max-width:640px) {
      .nav { padding: 0 20px; }
      .nav-links { display: none; }
      .hero { padding: 80px 24px 80px; min-height: auto; }
      .section { padding: 68px 24px; }
      .grid-3, .grid-team { grid-template-columns: 1fr; }
      .form-row { grid-template-columns: 1fr; }
      .footer { padding: 50px 24px 24px; }
      .footer-top { grid-template-columns: 1fr; gap: 28px; }
    }

    /* ══════════════════════════════════════
       PAGE LOAD ANIMATION
    ══════════════════════════════════════ */
    @keyframes pageReveal {
      from { opacity: 0; transform: scale(.99); }
      to   { opacity: 1; transform: none; }
    }
    body { animation: pageReveal .55s var(--ease) both; }

    /* ══════════════════════════════════════
       CITATIONS MOTIVATIONNELLES
    ══════════════════════════════════════ */

    .quotes-section {
      background:
        radial-gradient(ellipse 90% 60% at 50% 50%, rgba(123,94,167,.06) 0%, transparent 65%),
        radial-gradient(ellipse 60% 40% at 10% 80%, rgba(82,183,136,.07) 0%, transparent 55%),
        var(--bg);
      overflow: hidden;
    }

    .quotes-carousel-wrap {
      position: relative;
      max-width: 860px;
      margin: 0 auto;
    }

    /* Decorative orbs */
    .quotes-orb {
      position: absolute;
      border-radius: 50%;
      pointer-events: none;
      z-index: 0;
      filter: blur(70px);
    }
    .quotes-orb-1 {
      width: 340px; height: 340px;
      background: radial-gradient(circle, rgba(123,94,167,.13), transparent 70%);
      top: -80px; left: -100px;
      animation: orbFloat 12s ease-in-out infinite;
    }
    .quotes-orb-2 {
      width: 260px; height: 260px;
      background: radial-gradient(circle, rgba(82,183,136,.11), transparent 70%);
      bottom: -60px; right: -80px;
      animation: orbFloat 15s ease-in-out infinite reverse;
    }
    @keyframes orbFloat {
      0%,100% { transform: translate(0,0); }
      50%      { transform: translate(20px,-25px); }
    }

    /* Stage — the card holding the quote */
    .quotes-stage {
      position: relative; z-index: 1;
      background: var(--white);
      border-radius: 28px;
      border: 1.5px solid rgba(123,94,167,.12);
      box-shadow:
        0 4px 28px rgba(27,67,50,.07),
        0 0 0 1px rgba(255,255,255,.7),
        inset 0 1px 0 rgba(255,255,255,.9);
      padding: 56px 64px 48px;
      min-height: 280px;
      display: flex; align-items: center; justify-content: center;
      overflow: hidden;
      backdrop-filter: blur(8px);
    }
    .quotes-stage::before {
      content: '';
      position: absolute; inset: 0;
      background:
        radial-gradient(ellipse 75% 45% at 50% 0%, rgba(123,94,167,.05) 0%, transparent 60%),
        radial-gradient(ellipse 50% 35% at 100% 100%, rgba(82,183,136,.05) 0%, transparent 55%);
      pointer-events: none;
    }

    /* Quote display */
    .quote-display {
      width: 100%; text-align: center;
      transition: opacity .5s var(--ease), transform .5s var(--ease);
    }
    .quote-display.animating-out {
      opacity: 0 !important;
      transform: translateY(-18px) scale(.97);
    }
    .quote-display.animating-in {
      animation: quoteSlideIn .55s var(--ease) both;
    }
    @keyframes quoteSlideIn {
      from { opacity: 0; transform: translateY(22px) scale(.97); }
      to   { opacity: 1; transform: none; }
    }

    /* Decorative quote marks */
    .quote-ornament-top {
      position: absolute; top: 22px; left: 30px;
      width: 64px; opacity: 1; color: var(--violet);
    }
    .quote-ornament-bottom {
      position: absolute; bottom: 22px; right: 30px;
      width: 52px; opacity: 1; color: var(--g3);
    }

    /* Quote text */
    .quote-text {
      font-family: 'Playfair Display', serif;
      font-style: italic;
      font-size: clamp(1.2rem, 2.4vw, 1.65rem);
      line-height: 1.58;
      color: var(--text);
      margin: 0 0 32px;
      padding: 0 12px;
      letter-spacing: -.01em;
      background: linear-gradient(135deg, var(--text) 30%, var(--violet) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      position: relative; z-index: 1;
    }

    /* Author line */
    .quote-meta { position: relative; z-index: 1; }
    .quote-author-line {
      display: inline-flex; align-items: center; gap: 12px;
      background: linear-gradient(135deg, var(--vio-pale), var(--g-pale));
      border: 1px solid rgba(123,94,167,.12);
      border-radius: 99px; padding: 8px 20px 8px 8px;
      box-shadow: 0 2px 12px rgba(123,94,167,.08);
    }
    .quote-author-avatar {
      width: 38px; height: 38px; border-radius: 50%;
      background: var(--grad-aurora);
      color: #fff; font-size: .85rem; font-weight: 700;
      display: grid; place-items: center; flex-shrink: 0;
      box-shadow: 0 3px 10px rgba(123,94,167,.3);
      letter-spacing: -.5px;
    }
    .quote-author-name {
      font-size: .9rem; font-weight: 700; color: var(--text);
    }
    .quote-author-tag {
      font-size: .72rem; color: var(--violet); font-weight: 600;
      margin-top: 1px;
    }

    /* Skeleton loader */
    .quote-skeleton {
      width: 100%; display: flex; flex-direction: column; align-items: center; gap: 14px;
    }
    .sk-line, .sk-author {
      background: linear-gradient(90deg, rgba(27,67,50,.06) 25%, rgba(27,67,50,.10) 50%, rgba(27,67,50,.06) 75%);
      background-size: 200% 100%;
      animation: skeletonShimmer 1.6s ease-in-out infinite;
      border-radius: 99px;
      height: 18px;
    }
    .sk-wide   { width: 88%; }
    .sk-medium { width: 72%; height: 18px; }
    .sk-narrow { width: 52%; }
    .sk-author { width: 180px; height: 38px; border-radius: 99px; margin-top: 8px; }
    @keyframes skeletonShimmer {
      0%   { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }

    /* Controls */
    .quotes-controls {
      display: flex; align-items: center; justify-content: center; gap: 18px;
      margin-top: 28px; position: relative; z-index: 1;
    }
    .quotes-btn {
      width: 44px; height: 44px; border-radius: 50%;
      background: var(--white); border: 1.5px solid rgba(27,67,50,.1);
      display: grid; place-items: center; cursor: pointer;
      transition: all .28s var(--ease-spring);
      box-shadow: 0 2px 10px rgba(27,67,50,.07);
    }
    .quotes-btn svg { width: 18px; height: 18px; stroke: var(--text-sec); transition: stroke .2s; }
    .quotes-btn:hover {
      background: var(--violet); border-color: var(--violet);
      transform: scale(1.1);
      box-shadow: 0 6px 20px rgba(123,94,167,.3);
    }
    .quotes-btn:hover svg { stroke: #fff; }
    .quotes-btn:disabled { opacity: .4; cursor: default; transform: none; }

    /* Dots */
    .quotes-dots { display: flex; gap: 8px; align-items: center; }
    .q-dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: rgba(27,67,50,.15);
      cursor: pointer;
      transition: all .3s var(--ease-spring);
      border: none; padding: 0;
    }
    .q-dot.active {
      background: var(--violet);
      width: 22px; border-radius: 99px;
      box-shadow: 0 0 10px rgba(123,94,167,.4);
    }
    .q-dot:hover:not(.active) { background: rgba(123,94,167,.4); transform: scale(1.15); }

    /* Footer row */
    .quotes-footer {
      display: flex; align-items: center; justify-content: space-between;
      margin-top: 20px; position: relative; z-index: 1;
      padding: 0 4px;
    }
    .quotes-source-badge {
      display: inline-flex; align-items: center; gap: 5px;
      font-size: .72rem; color: var(--text-sec); font-weight: 600;
      background: rgba(27,67,50,.05); border-radius: 99px; padding: 4px 12px;
      border: 1px solid rgba(27,67,50,.07);
    }
    .quotes-refresh-btn {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: .77rem; font-weight: 700; color: var(--violet);
      background: var(--vio-pale); border: 1px solid rgba(123,94,167,.15);
      border-radius: 99px; padding: 6px 16px; cursor: pointer;
      transition: all .28s var(--ease-spring);
    }
    .quotes-refresh-btn svg { width: 13px; height: 13px; transition: transform .5s var(--ease); }
    .quotes-refresh-btn:hover {
      background: var(--violet); color: #fff; border-color: var(--violet);
      box-shadow: 0 4px 16px rgba(123,94,167,.3);
      transform: translateY(-1px);
    }
    .quotes-refresh-btn.spinning svg {
      animation: spinIcon .6s linear infinite;
    }
    @keyframes spinIcon { to { transform: rotate(360deg); } }

    /* ── Responsive ── */
    @media(max-width: 640px) {
      .quotes-stage { padding: 38px 26px 36px; }
      .quote-text { font-size: 1.12rem; }
      .quote-ornament-top { width: 46px; top: 14px; left: 16px; }
      .quote-ornament-bottom { width: 38px; bottom: 14px; right: 16px; }
      .quotes-footer { flex-direction: column; gap: 10px; }
    }

    /* ════════════════════════════════════════════════════════════════════
       ÉMOTION ANALYZER (feature IA)
    ════════════════════════════════════════════════════════════════════ */
    .emotion-wrap {
      position: relative;
      margin-top: 80px;
      padding: 0 24px;
    }
    .emotion-wrap .sr { opacity: 1; transform: none; }

    .emotion-card {
      max-width: 1100px; margin: 0 auto;
      background: var(--white);
      border-radius: 28px;
      padding: 48px 44px;
      box-shadow: 0 4px 24px rgba(27,67,50,.08), 0 0 0 1px rgba(213,220,230,.4);
      position: relative;
      overflow: hidden;
    }
    .emotion-card::before {
      content: '';
      position: absolute; top: 0; left: 0; right: 0; height: 4px;
      background: linear-gradient(90deg, var(--g1) 0%, var(--g3) 50%, var(--violet) 100%);
    }
    .emotion-card::after {
      content: '';
      position: absolute; top: -120px; right: -120px;
      width: 320px; height: 320px; border-radius: 50%;
      background: radial-gradient(circle, var(--vio-pale) 0%, transparent 70%);
      pointer-events: none;
      z-index: 0;
    }

    .emotion-header {
      text-align: center; margin-bottom: 36px;
      position: relative; z-index: 1;
    }
    .emotion-pill {
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--grad-sage);
      color: var(--g1);
      padding: 8px 18px;
      border-radius: 999px;
      font-size: .78rem; font-weight: 700;
      letter-spacing: .5px; text-transform: uppercase;
      margin-bottom: 14px;
    }
    .emotion-pill svg { width: 15px; height: 15px; }
    .emotion-title {
      font-family: 'Playfair Display', serif;
      font-size: clamp(1.6rem, 3vw, 2.2rem);
      font-weight: 700; color: var(--text);
      margin-bottom: 10px;
    }
    .emotion-title span {
      background: var(--grad-aurora);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .emotion-subtitle {
      font-size: .95rem; color: var(--text-sec);
      max-width: 620px; margin: 0 auto;
      line-height: 1.65;
    }

    .emotion-body {
      position: relative; z-index: 1;
      display: grid;
      grid-template-columns: 1fr;
      gap: 28px;
      transition: all .5s var(--ease);
    }
    .emotion-body.analyzing,
    .emotion-body.has-result { grid-template-columns: 1fr 1fr; }

    .emotion-cam-panel {
      background: linear-gradient(160deg, #0f172a 0%, #1e293b 100%);
      border-radius: 22px;
      padding: 24px;
      position: relative;
      min-height: 400px;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      overflow: hidden;
      border: 1px solid rgba(255,255,255,.08);
    }
    .emotion-cam-panel::before {
      content: '';
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(82,183,136,.06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(82,183,136,.06) 1px, transparent 1px);
      background-size: 24px 24px;
      pointer-events: none;
    }

    .cam-initial {
      text-align: center; color: #fff;
      position: relative; z-index: 1;
    }
    .cam-initial-icon {
      width: 92px; height: 92px;
      background: linear-gradient(135deg, var(--g3) 0%, var(--violet) 100%);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 20px;
      position: relative;
      animation: camPulse 2.5s ease-in-out infinite;
      box-shadow: 0 8px 32px rgba(82,183,136,.4);
    }
    @keyframes camPulse {
      0%,100% { box-shadow: 0 8px 32px rgba(82,183,136,.4), 0 0 0 0 rgba(82,183,136,.5); }
      50%     { box-shadow: 0 8px 32px rgba(82,183,136,.4), 0 0 0 20px rgba(82,183,136,0); }
    }
    .cam-initial-icon svg {
      width: 44px; height: 44px; stroke: #fff; fill: none; stroke-width: 1.8;
    }
    .cam-initial-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.35rem; margin-bottom: 8px;
    }
    .cam-initial-desc {
      font-size: .88rem; opacity: .75; line-height: 1.55;
      max-width: 320px; margin: 0 auto 24px;
    }
    .btn-emotion-start {
      display: inline-flex; align-items: center; gap: 10px;
      background: linear-gradient(135deg, var(--g3) 0%, var(--g2) 100%);
      color: #fff; border: none;
      padding: 14px 28px;
      border-radius: 999px;
      font-family: 'Outfit', sans-serif;
      font-size: .95rem; font-weight: 600; letter-spacing: .3px;
      cursor: pointer;
      box-shadow: 0 10px 24px rgba(82,183,136,.35);
      transition: all .3s var(--ease-spring);
      position: relative; overflow: hidden;
    }
    .btn-emotion-start::before {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(135deg, rgba(255,255,255,0) 0%, rgba(255,255,255,.15) 100%);
      opacity: 0; transition: opacity .3s;
    }
    .btn-emotion-start:hover {
      transform: translateY(-3px) scale(1.03);
      box-shadow: 0 16px 36px rgba(82,183,136,.5);
    }
    .btn-emotion-start:hover::before { opacity: 1; }
    .btn-emotion-start:active { transform: translateY(-1px) scale(1); }
    .btn-emotion-start svg { width: 18px; height: 18px; stroke-width: 2; }

    .cam-live {
      width: 100%; height: 100%;
      display: none;
      flex-direction: column; align-items: center;
      position: relative; z-index: 1;
    }
    .emotion-body.cam-active .cam-initial { display: none; }
    .emotion-body.cam-active .cam-live    { display: flex; }

    .cam-video-wrap {
      position: relative;
      width: 100%; max-width: 380px;
      aspect-ratio: 4/3;
      border-radius: 16px;
      overflow: hidden;
      background: #000;
      box-shadow: 0 8px 28px rgba(0,0,0,.4);
      margin-bottom: 18px;
    }
    .cam-video-wrap video {
      width: 100%; height: 100%;
      object-fit: cover;
      transform: scaleX(-1);
    }

    .cam-corner {
      position: absolute;
      width: 24px; height: 24px;
      border: 2px solid var(--g3);
      pointer-events: none;
      transition: all .4s var(--ease);
    }
    .cam-corner.tl { top: 8px; left: 8px; border-right: none; border-bottom: none; border-radius: 4px 0 0 0; }
    .cam-corner.tr { top: 8px; right: 8px; border-left: none; border-bottom: none; border-radius: 0 4px 0 0; }
    .cam-corner.bl { bottom: 8px; left: 8px; border-right: none; border-top: none; border-radius: 0 0 0 4px; }
    .cam-corner.br { bottom: 8px; right: 8px; border-left: none; border-top: none; border-radius: 0 0 4px 0; }

    .cam-scan-line {
      position: absolute; left: 0; right: 0; top: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent 0%, var(--g3) 50%, transparent 100%);
      box-shadow: 0 0 12px var(--g3);
      animation: scanSweep 2.2s ease-in-out infinite;
      pointer-events: none;
    }
    @keyframes scanSweep {
      0%   { top: 0; opacity: 0; }
      10%  { opacity: 1; }
      90%  { opacity: 1; }
      100% { top: 100%; opacity: 0; }
    }

    .cam-rec-badge {
      position: absolute; top: 14px; left: 14px;
      display: flex; align-items: center; gap: 6px;
      background: rgba(0,0,0,.5);
      color: #fff;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: .7rem; font-weight: 700; letter-spacing: 1px;
      backdrop-filter: blur(8px);
    }
    .cam-rec-dot {
      width: 7px; height: 7px; border-radius: 50%;
      background: #EF4444;
      animation: recPulse 1.2s ease-in-out infinite;
    }
    @keyframes recPulse {
      0%,100% { opacity: 1; transform: scale(1); }
      50%     { opacity: .3; transform: scale(.7); }
    }

    .cam-actions {
      display: flex; gap: 10px;
      flex-wrap: wrap; justify-content: center;
    }
    .btn-cam {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 11px 22px;
      border-radius: 999px;
      font-family: 'Outfit', sans-serif;
      font-size: .88rem; font-weight: 600;
      cursor: pointer;
      transition: all .25s var(--ease);
      border: none;
    }
    .btn-cam-capture {
      background: #fff; color: var(--g1);
      box-shadow: 0 6px 16px rgba(0,0,0,.3);
    }
    .btn-cam-capture:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(0,0,0,.4); }
    .btn-cam-capture svg { width: 15px; height: 15px; }
    .btn-cam-cancel {
      background: transparent; color: rgba(255,255,255,.85);
      border: 1.5px solid rgba(255,255,255,.25);
    }
    .btn-cam-cancel:hover {
      background: rgba(239,68,68,.15); border-color: rgba(239,68,68,.5);
      color: #fff;
    }
    .btn-cam-cancel svg { width: 14px; height: 14px; }

    .cam-analyzing {
      display: none;
      flex-direction: column; align-items: center;
      color: #fff; text-align: center;
      position: relative; z-index: 1;
    }
    .emotion-body.analyzing .cam-live       { display: none; }
    .emotion-body.analyzing .cam-analyzing  { display: flex; }

    .analyzing-orb {
      width: 90px; height: 90px;
      border-radius: 50%;
      background: conic-gradient(from 0deg, var(--g3), var(--violet), var(--g3));
      animation: orbSpin 1.2s linear infinite;
      position: relative;
      margin-bottom: 20px;
    }
    .analyzing-orb::after {
      content: '';
      position: absolute; inset: 6px;
      border-radius: 50%;
      background: #0f172a;
    }
    .analyzing-orb::before {
      content: '🧠';
      position: absolute; inset: 0;
      display: flex; align-items: center; justify-content: center;
      font-size: 2.2rem;
      z-index: 1;
      animation: brainPulse 1s ease-in-out infinite;
    }
    @keyframes orbSpin { to { transform: rotate(360deg); } }
    @keyframes brainPulse {
      0%,100% { transform: scale(1); }
      50%     { transform: scale(1.12); }
    }
    .analyzing-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.25rem; margin-bottom: 6px;
    }
    .analyzing-text {
      font-size: .85rem; opacity: .7;
      max-width: 280px; line-height: 1.55;
    }
    .analyzing-dots::after {
      content: '';
      animation: dots 1.4s steps(4) infinite;
    }
    @keyframes dots {
      0%   { content: ''; }
      25%  { content: '.'; }
      50%  { content: '..'; }
      75%  { content: '...'; }
    }

    .emotion-result-panel {
      background: var(--bg);
      border-radius: 22px;
      padding: 32px;
      display: none;
      flex-direction: column;
      animation: slideInR .5s var(--ease) both;
      position: relative;
      border: 1px solid var(--border);
    }
    .emotion-body.has-result .emotion-result-panel { display: flex; }
    @keyframes slideInR {
      from { opacity: 0; transform: translateX(30px); }
      to   { opacity: 1; transform: none; }
    }

    .result-hero {
      display: flex; align-items: center; gap: 18px;
      padding: 20px 22px;
      border-radius: 16px;
      margin-bottom: 20px;
      position: relative; overflow: hidden;
      transition: background-color .5s ease;
    }
    .result-hero::before {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(135deg, rgba(255,255,255,.2) 0%, transparent 100%);
      pointer-events: none;
    }

    .result-emoji {
      font-size: 3.2rem;
      line-height: 1;
      animation: emojiBounce .8s var(--ease-spring);
      filter: drop-shadow(0 4px 12px rgba(0,0,0,.15));
      flex-shrink: 0;
    }
    @keyframes emojiBounce {
      0%   { transform: scale(0) rotate(-20deg); opacity: 0; }
      60%  { transform: scale(1.15) rotate(5deg); }
      100% { transform: scale(1) rotate(0); opacity: 1; }
    }

    .result-main { flex: 1; }
    .result-label-row {
      display: flex; align-items: baseline; gap: 12px;
      margin-bottom: 4px;
      flex-wrap: wrap;
    }
    .result-french {
      font-family: 'Playfair Display', serif;
      font-size: 1.6rem; font-weight: 700;
      line-height: 1.1;
    }
    .result-score-big {
      font-size: 1.1rem; font-weight: 700;
      opacity: .85;
    }
    .result-sub {
      font-size: .8rem;
      font-weight: 600;
      text-transform: uppercase; letter-spacing: 1px;
      opacity: .7;
    }

    .result-advice {
      background: var(--white);
      border-radius: 14px;
      padding: 16px 18px;
      font-size: .87rem; line-height: 1.6;
      color: var(--text);
      margin-bottom: 18px;
      border-left: 3px solid var(--g3);
      display: flex; gap: 10px;
    }
    .result-advice-icon {
      flex-shrink: 0;
      font-size: 1rem;
      line-height: 1.4;
    }

    .result-all-title {
      font-size: .78rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 1px;
      color: var(--text-sec);
      margin-bottom: 12px;
    }
    .result-bars { display: flex; flex-direction: column; gap: 9px; }
    .result-bar {
      display: flex; align-items: center; gap: 10px;
      font-size: .82rem;
    }
    .result-bar-emoji { font-size: 1rem; width: 20px; text-align: center; flex-shrink: 0; }
    .result-bar-label { width: 74px; color: var(--text-sec); font-weight: 500; }
    .result-bar-track {
      flex: 1; height: 8px;
      background: rgba(213,220,230,.5);
      border-radius: 99px;
      overflow: hidden;
    }
    .result-bar-fill {
      height: 100%;
      border-radius: 99px;
      width: 0;
      transition: width 1s var(--ease);
      background: linear-gradient(90deg, var(--g3), var(--violet));
    }
    .result-bar-pct {
      font-weight: 600; color: var(--text);
      font-variant-numeric: tabular-nums;
      width: 42px; text-align: right; font-size: .78rem;
    }

    .result-actions {
      display: flex; gap: 10px; flex-wrap: wrap;
      margin-top: 22px;
      padding-top: 18px;
      border-top: 1px dashed var(--border);
    }
    .btn-result {
      display: inline-flex; align-items: center; gap: 7px;
      padding: 9px 18px;
      border-radius: 999px;
      font-size: .82rem; font-weight: 600;
      font-family: 'Outfit', sans-serif;
      cursor: pointer; border: none;
      transition: all .25s var(--ease);
      text-decoration: none;
    }
    .btn-result-primary {
      background: var(--grad-emerald);
      color: #fff;
      box-shadow: 0 6px 14px rgba(27,67,50,.2);
    }
    .btn-result-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 22px rgba(27,67,50,.3); }
    .btn-result-secondary {
      background: var(--white);
      color: var(--text-sec);
      border: 1.5px solid var(--border);
    }
    .btn-result-secondary:hover { border-color: var(--g3); color: var(--g1); }
    .btn-result svg { width: 13px; height: 13px; }

    .emotion-error {
      display: none;
      background: #FEF2F2;
      border: 1px solid #FECACA;
      color: #B91C1C;
      padding: 14px 18px;
      border-radius: 12px;
      font-size: .87rem; line-height: 1.5;
      margin-top: 16px;
      align-items: flex-start; gap: 10px;
    }
    .emotion-error.show { display: flex; animation: errShake .4s ease; }
    .emotion-error svg { width: 18px; height: 18px; flex-shrink: 0; margin-top: 1px; }
    @keyframes errShake {
      0%,100% { transform: translateX(0); }
      25%     { transform: translateX(-4px); }
      75%     { transform: translateX(4px); }
    }

    .emotion-features {
      display: flex; gap: 10px; flex-wrap: wrap;
      justify-content: center;
      margin-top: 18px;
    }
    .emotion-feature-badge {
      display: inline-flex; align-items: center; gap: 5px;
      background: var(--white);
      border: 1px solid var(--border);
      padding: 6px 12px;
      border-radius: 999px;
      font-size: .72rem; font-weight: 600;
      color: var(--text-sec);
    }
    .emotion-feature-badge svg { width: 12px; height: 12px; stroke: var(--g3); fill: none; stroke-width: 2.4; }

    @media (max-width: 840px) {
      .emotion-card { padding: 32px 22px; }
      .emotion-body.analyzing,
      .emotion-body.has-result { grid-template-columns: 1fr; }
      .emotion-result-panel { padding: 22px; }
      .result-french { font-size: 1.35rem; }
      .result-emoji { font-size: 2.6rem; }
    }
  </style>
</head>
<body>

{# ══ Cursor glow ══ #}
<div class="cursor-glow" id="cursorGlow"></div>

{# ══ Variables rôle ══ #}
{% set user      = app.user %}
{% set roleRaw   = user.roleUtilisateur %}
{% set roleSlug  = roleRaw|replace({'ROLE_': ''})|lower %}
{% set roleLabel = {'patient':'Patient','medecin':'Médecin','coach':'Coach','psychologue':'Psychologue','user':'Utilisateur','admin':'Admin'}[roleSlug] ?? (roleSlug|capitalize) %}
{% set roleEmoji = {'patient':'🧠','medecin':'🩺','coach':'💪','psychologue':'🧘','user':'👤','admin':'🛡️'}[roleSlug] ?? '👤' %}

{# ══ NAVBAR ══ #}
<nav class="nav" id="main-nav">
  <a href="#hero" class="nav-brand">
