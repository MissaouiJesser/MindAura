<script>
  /* ── Cursor glow ── */
  (function() {
    var glow = document.getElementById('cursorGlow');
    document.addEventListener('mousemove', function(e) {
      glow.style.left = e.clientX + 'px';
      glow.style.top  = e.clientY + 'px';
    });
  })();

  /* ── Navbar scroll ── */
  var nav = document.getElementById('main-nav');
  window.addEventListener('scroll', function() {
    nav.classList.toggle('scrolled', window.scrollY > 20);
  });

  /* ── Smooth scroll ── */
  document.querySelectorAll('a[href^="#"]').forEach(function(a) {
    a.addEventListener('click', function(e) {
      var href = a.getAttribute('href');
      if (href.length > 1) {
        var t = document.querySelector(href);
        if (t) { e.preventDefault(); t.scrollIntoView({behavior:'smooth', block:'start'}); }
      }
    });
  });

  /* ── Scroll reveal ── */
  var obs = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (e.isIntersecting) { e.target.classList.add('in'); obs.unobserve(e.target); }
    });
  }, { threshold: 0.08 });
  document.querySelectorAll('.sr, .sr-l, .sr-r').forEach(function(el) { obs.observe(el); });

  /* ── FAQ ── */
  function toggleFaq(btn) {
    var item = btn.closest('.faq-item');
    var isOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item.open').forEach(function(i) { i.classList.remove('open'); });
    if (!isOpen) item.classList.add('open');
  }

  /* ── Contact send ── */
  function sendMsg(btn) {
    btn.disabled = true;
    btn.textContent = 'Envoi en cours...';
    setTimeout(function() {
      btn.textContent = 'Message envoyé !';
      btn.style.background = 'linear-gradient(135deg,#22C55E,#16a34a)';
      showToast('Votre message a bien été envoyé !');
      setTimeout(function() {
        btn.innerHTML = '<svg viewBox="0 0 20 20" style="width:17px;height:17px;stroke:#fff;fill:none;stroke-width:1.9"><path d="M2 10l16-8-8 16v-8L2 10z" stroke-linecap="round" stroke-linejoin="round"/></svg> Envoyer le message';
        btn.style.background = '';
        btn.disabled = false;
      }, 3500);
    }, 1600);
  }

  function showToast(msg) {
    var t = document.getElementById('toast');
    document.getElementById('toast-msg').textContent = msg;
    t.classList.add('show');
    setTimeout(function() { t.classList.remove('show'); }, 4200);
  }

  /* ── User pill dropdown ── */
  (function() {
    var pillBtn  = document.getElementById('userPillBtn');
    var dropdown = document.getElementById('userDropdown');
    var wrapper  = document.getElementById('userPillWrapper');
    if (!pillBtn || !dropdown) return;
    function openDropdown()  { dropdown.classList.add('open'); pillBtn.setAttribute('aria-expanded','true'); }
    function closeDropdown() { dropdown.classList.remove('open'); pillBtn.setAttribute('aria-expanded','false'); }
    function toggleDropdown(){ dropdown.classList.contains('open') ? closeDropdown() : openDropdown(); }
    pillBtn.addEventListener('click', function(e) { e.stopPropagation(); toggleDropdown(); });
    document.addEventListener('click', function(e) { if (!wrapper.contains(e.target)) closeDropdown(); });
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeDropdown(); });
  })();

  /* ══════════════════════════════════════
     CITATIONS MOTIVATIONNELLES — ZenQuotes
  ══════════════════════════════════════ */
  (function() {
    /* ─── Pool de citations psychologiques de secours ─── */
    var fallbackQuotes = [
      { q: "La vie est ce que nos pensées en font.", a: "Marc Aurèle" },
      { q: "Nous souffrons plus en imagination qu'en réalité.", a: "Sénèque" },
      { q: "Connais-toi toi-même.", a: "Socrate" },
      { q: "Le bonheur n'est pas quelque chose de tout fait. Il vient de vos propres actions.", a: "Dalaï Lama" },
      { q: "Ce n'est pas ce qui nous arrive qui nous affecte, mais l'idée que nous nous en faisons.", a: "Épictète" },
      { q: "L'âme qui contemple la beauté est elle-même belle.", a: "Plotin" },
      { q: "La vraie sagesse consiste à ne pas s'écarter de la nature.", a: "Sénèque" },
      { q: "Prenez soin de votre corps, c'est le seul endroit où vous devez vivre.", a: "Jim Rohn" },
      { q: "Votre vie s'améliore uniquement quand vous vous améliorez.", a: "Brian Tracy" },
      { q: "La résilience, c'est accepter votre nouvelle réalité, même si elle est moins bonne que celle d'avant.", a: "Elizabeth Edwards" },
      { q: "La santé mentale n'est pas l'absence de maladie, c'est la présence de paix.", a: "Anonyme" },
      { q: "Parler de soi-même est également un moyen de se cacher.", a: "Friedrich Nietzsche" },
      { q: "L'esprit est tout. Tu deviens ce que tu penses.", a: "Bouddha" },
      { q: "Si vous ne pouvez pas voler, courez. Si vous ne pouvez pas courir, marchez. Avancez toujours.", a: "Martin Luther King Jr." },
      { q: "Osez vous connaître vous-même. C'est la leçon la plus difficile et la plus belle.", a: "Carl Gustav Jung" },
    ];

    /* ─── Couleurs de fond pour les avatars ─── */
    var avatarColors = [
      'linear-gradient(135deg,#1B4332,#52B788)',
      'linear-gradient(135deg,#7B5EA7,#a78bda)',
      'linear-gradient(135deg,#0d7377,#14a085)',
      'linear-gradient(135deg,#c77dff,#9b5de5)',
      'linear-gradient(135deg,#f77f00,#fcbf49)',
      'linear-gradient(135deg,#1B4332,#2D6A4F)',
      'linear-gradient(135deg,#e63946,#f4a261)',
    ];

    var quotes = [];
    var currentIdx = 0;
    var total = 0;

    /* ─── Éléments DOM ─── */
    var skeleton    = document.getElementById('quoteSkeleton');
    var display     = document.getElementById('quoteDisplay');
    var textEl      = document.getElementById('quoteText');
    var authorEl    = document.getElementById('quoteAuthor');
    var avatarEl    = document.getElementById('quoteAvatar');
    var dotsEl      = document.getElementById('quotesDots');
    var prevBtn     = document.getElementById('quotePrev');
    var nextBtn     = document.getElementById('quoteNext');
    var refreshBtn  = document.getElementById('quotesRefreshBtn');
    var refreshIcon = document.getElementById('refreshIcon');

    /* ─── Proxy CORS (évite les erreurs CORS depuis le navigateur) ─── */
    /* ZenQuotes est accessible directement depuis le serveur Symfony,
       mais depuis le front on passe par allorigins */
    function buildUrl() {
      return 'https://api.allorigins.win/get?url=' +
             encodeURIComponent('https://zenquotes.io/api/quotes');
    }

    /* ─── Charger les citations ─── */
    function loadQuotes(callback) {
      var xhr = new XMLHttpRequest();
      xhr.open('GET', buildUrl(), true);
      xhr.timeout = 7000;
      xhr.onreadystatechange = function() {
        if (xhr.readyState !== 4) return;
        if (xhr.status === 200) {
          try {
            var wrapper = JSON.parse(xhr.responseText);
            var raw     = JSON.parse(wrapper.contents);
            /* Filtrer: on garde les citations < 200 chars (plus lisibles) */
            var filtered = raw.filter(function(item) {
              return item.q && item.a && item.q.length < 200 && item.a !== 'zenquotes.io';
            });
            if (filtered.length > 0) {
              quotes = filtered.slice(0, 10); /* max 10 par batch */
            } else {
              quotes = fallbackQuotes;
            }
          } catch(e) {
            quotes = fallbackQuotes;
          }
        } else {
          quotes = fallbackQuotes;
        }
        if (typeof callback === 'function') callback();
      };
      xhr.ontimeout = xhr.onerror = function() {
        quotes = fallbackQuotes;
        if (typeof callback === 'function') callback();
      };
      xhr.send();
    }

    /* ─── Construire les dots ─── */
    function buildDots() {
      dotsEl.innerHTML = '';
      total = quotes.length;
      for (var i = 0; i < total; i++) {
        (function(idx) {
          var dot = document.createElement('button');
          dot.className = 'q-dot' + (idx === currentIdx ? ' active' : '');
          dot.setAttribute('aria-label', 'Citation ' + (idx + 1));
          dot.addEventListener('click', function() { goTo(idx); });
          dotsEl.appendChild(dot);
        })(i);
      }
    }

    function updateDots() {
      var dots = dotsEl.querySelectorAll('.q-dot');
      dots.forEach(function(d, i) {
        d.classList.toggle('active', i === currentIdx);
      });
    }

    /* ─── Afficher une citation ─── */
    function showQuote(idx, animate) {
      if (!quotes.length) return;
      var item   = quotes[idx];
      var text   = item.q;
      var author = item.a;
      var initials = author.split(' ').slice(0,2).map(function(w){ return w[0]||''; }).join('').toUpperCase() || '?';
      var colorIdx = idx % avatarColors.length;

      if (animate && display.style.opacity !== '0') {
        display.classList.add('animating-out');
        setTimeout(function() {
          updateContent(text, author, initials, colorIdx);
          display.classList.remove('animating-out');
          display.classList.add('animating-in');
          setTimeout(function() { display.classList.remove('animating-in'); }, 600);
        }, 300);
      } else {
        updateContent(text, author, initials, colorIdx);
        display.classList.add('animating-in');
        setTimeout(function() { display.classList.remove('animating-in'); }, 600);
      }

      updateDots();
      prevBtn.disabled = (idx === 0);
      nextBtn.disabled = (idx === quotes.length - 1);
    }

    function updateContent(text, author, initials, colorIdx) {
      textEl.textContent = '\u201c' + text + '\u201d';
      authorEl.textContent = author;
      avatarEl.textContent  = initials;
      avatarEl.style.background = avatarColors[colorIdx];
    }

    /* ─── Navigation ─── */
    function goTo(idx) {
      if (idx < 0 || idx >= quotes.length) return;
      currentIdx = idx;
      showQuote(currentIdx, true);
    }

    prevBtn.addEventListener('click', function() { goTo(currentIdx - 1); });
    nextBtn.addEventListener('click', function() { goTo(currentIdx + 1); });

    /* Raccourcis clavier */
    document.addEventListener('keydown', function(e) {
      if (e.key === 'ArrowLeft')  goTo(currentIdx - 1);
      if (e.key === 'ArrowRight') goTo(currentIdx + 1);
    });

    /* Swipe mobile */
    var touchStartX = null;
    var stage = document.getElementById('quotesStage');
    stage.addEventListener('touchstart', function(e) { touchStartX = e.touches[0].clientX; }, { passive: true });
    stage.addEventListener('touchend', function(e) {
      if (touchStartX === null) return;
      var dx = e.changedTouches[0].clientX - touchStartX;
      touchStartX = null;
      if (Math.abs(dx) > 50) { dx < 0 ? goTo(currentIdx + 1) : goTo(currentIdx - 1); }
    }, { passive: true });

    /* ─── Refresh : nouvelles citations depuis l'API ─── */
    refreshBtn.addEventListener('click', function() {
      refreshBtn.classList.add('spinning');
      refreshBtn.disabled = true;
      display.style.opacity = '0';
      skeleton.style.display = 'flex';
      currentIdx = 0;

      loadQuotes(function() {
        skeleton.style.display = 'none';
        display.style.opacity  = '1';
        buildDots();
        showQuote(0, false);
        refreshBtn.classList.remove('spinning');
        refreshBtn.disabled = false;
      });
    });

    /* ─── Auto-avance toutes les 8 s ─── */
    var autoTimer = null;
    function startAuto() {
      autoTimer = setInterval(function() {
        var next = (currentIdx + 1) % quotes.length;
        goTo(next);
      }, 8000);
    }
    /* Pause si l'utilisateur interagit */
    [prevBtn, nextBtn, refreshBtn].forEach(function(btn) {
      btn.addEventListener('click', function() {
        clearInterval(autoTimer);
        startAuto();
      });
    });
    dotsEl.addEventListener('click', function() {
      clearInterval(autoTimer);
      startAuto();
    });

    /* ─── Initialisation ─── */
    loadQuotes(function() {
      skeleton.style.display = 'none';
      display.style.opacity  = '1';
      buildDots();
      showQuote(0, false);
      startAuto();
    });

  })();

  /* ── Hero stat counter animation ── */
  (function() {
    var stats = document.querySelectorAll('.hero-stat-num');
    var started = false;
    function animateCounters() {
      if (started) return; started = true;
      stats.forEach(function(el) {
        var raw = el.textContent.trim();
        var match = raw.match(/^(\d+)(.*)$/);
        if (!match) return;
        var target = parseInt(match[1]);
        var suffix = match[2];
        var start = 0;
        var duration = 1800;
        var startTime = null;
        function step(ts) {
          if (!startTime) startTime = ts;
          var progress = Math.min((ts - startTime) / duration, 1);
          var ease = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.floor(ease * target) + suffix;
          if (progress < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      });
    }
    var heroObs = new IntersectionObserver(function(entries) {
      if (entries[0].isIntersecting) { animateCounters(); heroObs.disconnect(); }
    }, { threshold: 0.3 });
    var heroStats = document.querySelector('.hero-stats');
    if (heroStats) heroObs.observe(heroStats);
  })();

  /* ═══════════════════════════════════════════════════════════════
     ANALYSEUR D'ÉMOTIONS PAR IA (webcam + Hugging Face)
  ═══════════════════════════════════════════════════════════════ */
  (function() {
    var body       = document.getElementById('emotionBody');
    var video      = document.getElementById('camVideo');
    var canvas     = document.getElementById('camCanvas');
    var btnStart   = document.getElementById('btnEmotionStart');
    var btnCapture = document.getElementById('btnCapture');
    var btnCancel  = document.getElementById('btnCamCancel');
    var btnRetry   = document.getElementById('btnRetry');
    var errorBox   = document.getElementById('emotionError');
    var errorMsg   = document.getElementById('emotionErrorMsg');

    if (!body || !btnStart) return; // Section non présente sur cette page

    var resultHero   = document.getElementById('resultHero');
    var resultEmoji  = document.getElementById('resultEmoji');
    var resultFrench = document.getElementById('resultFrench');
    var resultScore  = document.getElementById('resultScore');
    var resultAdvice = document.getElementById('resultAdvice');
    var resultBars   = document.getElementById('resultBars');

    var stream = null;

    /* ── Ouvrir la webcam ─────────────────────────────────────── */
    function openWebcam() {
      hideError();

      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        showError('Votre navigateur ne supporte pas l\'accès à la caméra.');
        return;
      }

      navigator.mediaDevices.getUserMedia({
        video: { facingMode: 'user', width: { ideal: 640 }, height: { ideal: 480 } },
        audio: false
      }).then(function(s) {
        stream = s;
        video.srcObject = stream;
        body.classList.add('cam-active');
      }).catch(function(err) {
        console.error('Erreur webcam:', err);
        if (err.name === 'NotAllowedError' || err.name === 'PermissionDeniedError') {
          showError('Accès à la caméra refusé. Autorisez MindAura dans les paramètres de votre navigateur puis réessayez.');
        } else if (err.name === 'NotFoundError' || err.name === 'DevicesNotFoundError') {
          showError('Aucune caméra détectée sur votre appareil.');
        } else {
          showError('Impossible d\'accéder à la caméra : ' + err.message);
        }
      });
    }

    /* ── Fermer la webcam ─────────────────────────────────────── */
    function closeWebcam() {
      if (stream) {
        stream.getTracks().forEach(function(t) { t.stop(); });
        stream = null;
      }
      video.srcObject = null;
    }

    /* ── Capturer une image et l'envoyer à l'API ──────────────── */
    function captureAndAnalyze() {
      if (!stream) return;
      hideError();

      var w = video.videoWidth  || 640;
      var h = video.videoHeight || 480;
      canvas.width  = w;
      canvas.height = h;
      var ctx = canvas.getContext('2d');
      ctx.translate(w, 0);
      ctx.scale(-1, 1);
      ctx.drawImage(video, 0, 0, w, h);
      ctx.setTransform(1, 0, 0, 1, 0, 0);

      var dataUrl = canvas.toDataURL('image/jpeg', 0.85);

      closeWebcam();
      body.classList.remove('cam-active');
      body.classList.add('analyzing');

      fetch('{{ path('app_emotion_analyze') }}', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ image: dataUrl }),
        credentials: 'same-origin'
      }).then(function(response) {
        return response.json().then(function(data) {
          if (!response.ok || !data.success) {
            throw new Error(data.error || 'Erreur serveur (' + response.status + ')');
          }
          displayResults(data);
        });
      }).catch(function(err) {
        console.error('Erreur analyse:', err);
        body.classList.remove('analyzing');
        showError(err.message || 'Une erreur est survenue lors de l\'analyse.');
        // Ne pas relancer la webcam automatiquement — laisser l'utilisateur cliquer Réessayer
      });
    }

    /* ── Afficher les résultats ──────────────────────────────── */
    function displayResults(data) {
      body.classList.remove('analyzing');
      body.classList.add('has-result');

      var dom = data.dominant;

      resultEmoji.textContent   = dom.emoji;
      resultFrench.textContent  = dom.french;
      resultScore.textContent   = dom.score + '%';
      resultAdvice.textContent  = dom.advice;

      resultHero.style.background = dom.color.bg;
      resultHero.style.color      = dom.color.fg;

      resultBars.innerHTML = '';
      data.all.forEach(function(emotion, idx) {
        var row = document.createElement('div');
        row.className = 'result-bar';
        row.innerHTML =
          '<span class="result-bar-emoji">' + emotion.emoji + '</span>' +
          '<span class="result-bar-label">' + emotion.french + '</span>' +
          '<span class="result-bar-track">' +
            '<span class="result-bar-fill" style="background:linear-gradient(90deg,' + emotion.color.accent + ',' + emotion.color.accent + 'cc)"></span>' +
          '</span>' +
          '<span class="result-bar-pct">' + emotion.score + '%</span>';
        resultBars.appendChild(row);

        var fill = row.querySelector('.result-bar-fill');
        setTimeout(function() { fill.style.width = emotion.score + '%'; }, 100 + idx * 80);
      });
    }

    /* ── Réinitialiser ───────────────────────────────────────── */
    function reset() {
      closeWebcam();
      body.classList.remove('cam-active', 'analyzing', 'has-result');
      hideError();
    }

    /* ── Erreurs ─────────────────────────────────────────────── */
    function showError(msg) {
      errorMsg.textContent = msg;
      errorBox.classList.add('show');
    }
    function hideError() {
      errorBox.classList.remove('show');
    }

    /* ── Events ──────────────────────────────────────────────── */
    btnStart.addEventListener('click', openWebcam);
    btnCapture.addEventListener('click', captureAndAnalyze);
    btnCancel.addEventListener('click', function() {
      closeWebcam();
      body.classList.remove('cam-active');
    });
    btnRetry.addEventListener('click', function() {
      reset();
      openWebcam();
    });

    window.addEventListener('beforeunload', closeWebcam);
  })();
</script>
</body>
