{# ══ ANALYSE D'ÉMOTIONS PAR IA ══ #}
<section class="emotion-wrap" id="emotion-analyzer">
  <div class="emotion-card sr">

    <div class="emotion-header">
      <div class="emotion-pill">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2a9 9 0 0 0-9 9c0 3.5 2 6.5 5 8v3l4-2 4 2v-3c3-1.5 5-4.5 5-8a9 9 0 0 0-9-9z"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
        Nouvelle expérience IA
      </div>

      <h2 class="emotion-title">Analysez vos <span>sentiments</span></h2>
      <p class="emotion-subtitle">
        Notre intelligence artificielle analyse votre expression faciale en temps réel
        et vous suggère des pistes personnalisées pour mieux vivre vos émotions.
      </p>

      <div class="emotion-features">
        <span class="emotion-feature-badge">
          <svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>
          100% privé — aucune image stockée
        </span>
        <span class="emotion-feature-badge">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          Résultat en 2 à 10 secondes
        </span>
        <span class="emotion-feature-badge">
          <svg viewBox="0 0 24 24"><path d="M12 2l3 7h7l-5.5 4.5L18 21l-6-4-6 4 1.5-7.5L2 9h7z"/></svg>
          7 émotions détectées
        </span>
      </div>
    </div>

    <div class="emotion-body" id="emotionBody">

      <!-- PANEL CAMÉRA -->
      <div class="emotion-cam-panel">

        <!-- État initial : avant activation webcam -->
        <div class="cam-initial" id="camInitial">
          <div class="cam-initial-icon">
            <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <path d="M23 7l-7 5 7 5V7z"/>
              <rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
            </svg>
          </div>
          <div class="cam-initial-title">Prêt à commencer&nbsp;?</div>
          <div class="cam-initial-desc">
            Autorisez l'accès à votre caméra, regardez l'objectif, puis capturez une photo pour lancer l'analyse.
          </div>
          <button class="btn-emotion-start" id="btnEmotionStart" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="23 7 16 12 23 17 23 7"/>
              <rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
            </svg>
            Analyser mes sentiments
          </button>
        </div>

        <!-- État actif : webcam visible -->
        <div class="cam-live" id="camLive">
          <div class="cam-video-wrap">
            <video id="camVideo" autoplay playsinline muted></video>
            <span class="cam-corner tl"></span>
            <span class="cam-corner tr"></span>
            <span class="cam-corner bl"></span>
            <span class="cam-corner br"></span>
            <span class="cam-scan-line"></span>
            <div class="cam-rec-badge">
              <span class="cam-rec-dot"></span>
              EN DIRECT
            </div>
          </div>
          <div class="cam-actions">
            <button class="btn-cam btn-cam-capture" id="btnCapture" type="button">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                <circle cx="12" cy="13" r="4"/>
              </svg>
              Capturer et analyser
            </button>
            <button class="btn-cam btn-cam-cancel" id="btnCamCancel" type="button">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
              Annuler
            </button>
          </div>
        </div>

        <!-- État analyse en cours -->
        <div class="cam-analyzing" id="camAnalyzing">
          <div class="analyzing-orb"></div>
          <div class="analyzing-title">L'IA analyse votre visage<span class="analyzing-dots"></span></div>
          <div class="analyzing-text">
            Le premier lancement peut prendre jusqu'à 20 secondes
            (le modèle d'IA se réveille).
          </div>
        </div>

        <canvas id="camCanvas" style="display:none;"></canvas>
      </div>

      <!-- PANEL RÉSULTATS -->
      <div class="emotion-result-panel" id="resultPanel">

        <div class="result-hero" id="resultHero">
          <div class="result-emoji" id="resultEmoji">🤔</div>
          <div class="result-main">
            <div class="result-sub">Émotion dominante</div>
            <div class="result-label-row">
              <span class="result-french" id="resultFrench">—</span>
              <span class="result-score-big" id="resultScore">0%</span>
            </div>
          </div>
        </div>

        <div class="result-advice">
          <span class="result-advice-icon">💡</span>
          <span id="resultAdvice">—</span>
        </div>

        <div class="result-all-title">Répartition détaillée</div>
        <div class="result-bars" id="resultBars">
          {# Rempli dynamiquement par JS #}
        </div>

        <div class="result-actions">
          <button class="btn-result btn-result-primary" id="btnRetry" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
              <polyline points="23 4 23 10 17 10"/>
              <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
            </svg>
