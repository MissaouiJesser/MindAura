        <button class="quotes-refresh-btn" id="quotesRefreshBtn" title="Nouvelles citations">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" id="refreshIcon"><path d="M4 4a8 8 0 0113.6 3.4M16 16a8 8 0 01-13.6-3.4M4 17v-4h4M16 3v4h-4" stroke-linecap="round" stroke-linejoin="round"/></svg>
