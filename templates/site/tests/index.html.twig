<form method="get" id="frontListForm" action="{{ path('front_tests_index') }}" autocomplete="off">
  <div class="toolbar">
    <input type="hidden" name="page" value="{{ page }}">
    <div class="tb-search-wrap">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="8.5" cy="8.5" r="5.5"/><path d="M15 15l-3-3" stroke-linecap="round"/></svg>
      <input class="tb-search" type="search" name="q" value="{{ q }}" placeholder="Rechercher un test…" autocomplete="off" data-front-debounce>
    </div>
    <select class="tb-select front-filter-select" name="type">
      <option value="">Tous les types</option>
      <option value="personnalité" {{ type == 'personnalité' ? 'selected' }}>Personnalité</option>
      <option value="stress"       {{ type == 'stress'       ? 'selected' }}>Stress</option>
      <option value="logique"      {{ type == 'logique'      ? 'selected' }}>Logique</option>
      <option value="mémoire"      {{ type == 'mémoire'      ? 'selected' }}>Mémoire</option>
