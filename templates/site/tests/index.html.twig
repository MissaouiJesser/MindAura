{# ── Liste tests ── #}
{% if tests is empty %}
  <div class="empty-state">
    <div class="empty-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 10s3-6 8-6 8 6 8 6-3 6-8 6-8-6-8-6z" stroke-linecap="round"/><circle cx="10" cy="10" r="2.5"/></svg>
    </div>
    <div class="empty-title">Aucun test disponible</div>
    <div class="empty-sub">Aucun test ne correspond à votre recherche, ou aucun test n'est encore publié.</div>
  </div>
{% else %}
  <div class="flow-grid">
    {% for test in tests %}
      <article class="flow-card" style="animation-delay:{{ loop.index0 * 0.05 }}s">
        <div class="flow-card-top">
          {% set badgeClass = '' %}
          {% if test.typeTest|lower == 'personnalité' %}{% set badgeClass = 'type-personnalite' %}
          {% elseif test.typeTest|lower == 'stress' %}{% set badgeClass = 'type-stress' %}
          {% elseif test.typeTest|lower == 'logique' %}{% set badgeClass = 'type-logique' %}
          {% elseif test.typeTest|lower == 'mémoire' %}{% set badgeClass = 'type-memoire' %}
          {% endif %}
          <span class="flow-badge {{ badgeClass }}">{{ test.typeTest|capitalize }}</span>
          <div class="flow-title">{{ test.titreTest }}</div>
          <div class="flow-desc">{{ test.descriptionTest|slice(0, 220) }}{% if test.descriptionTest|length > 220 %}…{% endif %}</div>
        </div>
        <div class="flow-meta">
          <span>{{ test.dureeEstimee ?? '—' }} min</span>
          <span>Actif</span>
        </div>
        <div class="flow-actions">
          <a href="{{ path('front_tests_take', {'id': test.idTest}) }}" class="btn-primary">Passer le test</a>
          <a href="{{ path('front_tests_responses', {'id': test.idTest}) }}" class="btn-secondary">Mes réponses</a>
        </div>
      </article>
    {% endfor %}
  </div>

  {% if pages > 1 %}
    <div class="pagination">
      {% for p in 1..pages %}
        <a class="page-btn {{ p == page ? 'active' : '' }}"
           href="{{ path('front_tests_index', {q: q, type: type, page: p}) }}">{{ p }}</a>
      {% endfor %}
    </div>
  {% endif %}
{% endif %}

