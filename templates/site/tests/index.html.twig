    </select>
    <a class="tb-reset" href="{{ path('front_tests_index') }}">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 8a6 6 0 1012 0A6 6 0 002 8zM10 6L6 10M6 6l4 4" stroke-linecap="round"/></svg>
      Tout afficher
