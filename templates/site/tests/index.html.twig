{% block javascripts %}
{{ parent() }}
{% include '_partials/front_dynamic_list_filters.html.twig' with { form_id: 'frontListForm', skip_test_id_zero: false } %}

<script>
(function () {
  // ── Configuration ──
  const ROUTES = {
    all:           '/test-news/latest',
    psychologie:   '/test-news/psychologie',
    developpement: '/test-news/developpement',
    anxiete:       '/test-news/theme/anxiete',
    stress:        '/test-news/theme/stress',
    mindfulness:   '/test-news/theme/mindfulness',
    relations:     '/test-news/theme/relations',
    sommeil:       '/test-news/theme/sommeil',
  };

  // ── État ──
  let currentTheme = 'all';
  let currentPage  = 1;
  let totalPages   = 1;

  // ── Éléments DOM ──
  const grid       = document.getElementById('newsGrid');
  const pagination = document.getElementById('newsPagination');
  const tabs       = document.querySelectorAll('.news-tab');

  // ── Chargement des news ──
  async function loadNews(theme, page) {
    // Afficher le spinner
    grid.innerHTML = `
      <div class="news-loading" style="grid-column:1/-1">
        <div class="news-spinner"></div>
        <div class="news-loading-text">Chargement des actualités…</div>
      </div>`;
    pagination.style.display = 'none';

    try {
      const url      = ROUTES[theme] || ROUTES['all'];
      const response = await fetch(url);
      const data     = await response.json();

      if (data.error) {
        showError(data.error);
        return;
      }

      const articles = data.articles || [];
      totalPages     = Math.ceil(Math.min(data.totalResults || 0, 100) / 12);

      if (articles.length === 0) {
        showEmpty();
        return;
      }

      renderArticles(articles);
      renderPagination(page, totalPages);

    } catch (err) {
      showError('Impossible de charger les actualités.');
    }
  }

  // ── Rendu articles ──
  // ── Rendu articles ──
  function renderArticles(articles) {
    grid.innerHTML = articles.map((a, i) => {
      const date    = a.publishedAt ? formatDate(a.publishedAt) : '';
      const source  = a.source?.name || '';
      const title   = escHtml(a.title || '');
      const desc    = escHtml(a.description || '');
      const url     = escHtml(a.url || '#');
      const imgSrc  = a.urlToImage || '';

      const imgHtml = imgSrc
        ? `<img class="news-card-img" src="${escHtml(imgSrc)}" alt="${title}" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='grid'">`
        : '';

      const placeholder = `
        <div class="news-card-img-placeholder" ${imgSrc ? 'style="display:none"' : ''}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
            <path d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10l6 6v8a2 2 0 01-2 2z"/>
            <path d="M9 12h6M9 16h4"/>
          </svg>
        </div>`;

      return `
        <div class="news-card" style="animation-delay:${i * 0.05}s">
          ${imgHtml}
          ${placeholder}
          <div class="news-card-body">
            ${source ? `<div class="news-card-source"><span></span>${escHtml(source)}</div>` : ''}
            <div class="news-card-title">${title}</div>
            ${desc ? `<div class="news-card-desc">${desc}</div>` : ''}
          </div>
          <div class="news-card-footer">
            <div class="news-card-date">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6">
                <rect x="2" y="3" width="12" height="11" rx="2"/>
                <path d="M5 1v4M11 1v4M2 7h12" stroke-linecap="round"/>
              </svg>
              ${date}
            </div>
            <a class="news-card-link" href="${url}" target="_blank" rel="noopener noreferrer">
              Lire
              <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M2 6h8M6 2l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </div>`;
    }).join('');

    // ── IMPORTANT : notifier le translator que du contenu dynamique vient d'être injecté ──
    document.dispatchEvent(new CustomEvent('dynamicContentLoaded', {
      detail: { container: grid }
    }));
  }
  // ── Pagination ──
  function renderPagination(current, total) {
    if (total <= 1) { pagination.style.display = 'none'; return; }

    pagination.style.display = 'flex';
    let html = '';

    // Bouton précédent
    html += `<button class="news-page-btn" ${current === 1 ? 'disabled' : ''} data-page="${current - 1}">
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M8 2L4 6l4 4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>`;

    // Pages
    for (let p = 1; p <= total; p++) {
      if (total > 7 && p > 2 && p < total - 1 && Math.abs(p - current) > 1) {
        if (p === 3 || p === total - 2) html += `<span style="color:var(--text-sec);padding:0 4px;align-self:center">…</span>`;
        continue;
      }
      html += `<button class="news-page-btn ${p === current ? 'active' : ''}" data-page="${p}">${p}</button>`;
    }

    // Bouton suivant
    html += `<button class="news-page-btn" ${current === total ? 'disabled' : ''} data-page="${current + 1}">
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M4 2l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>`;

    pagination.innerHTML = html;

    // Événements pagination
    pagination.querySelectorAll('[data-page]').forEach(btn => {
      btn.addEventListener('click', () => {
        currentPage = parseInt(btn.dataset.page);
        loadNews(currentTheme, currentPage);
        pagination.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    });
  }

  // ── États ──
  function showEmpty() {
    grid.innerHTML = `
      <div class="news-empty">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
          <path d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10l6 6v8a2 2 0 01-2 2z"/>
        </svg>
        <div class="news-empty-title">Aucun article trouvé</div>
        <div class="news-empty-sub">Aucune actualité disponible pour ce thème pour le moment.</div>
      </div>`;
    pagination.style.display = 'none';
  }

  function showError(msg) {
    grid.innerHTML = `
      <div class="news-empty">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
          <circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/>
        </svg>
        <div class="news-empty-title">Erreur de chargement</div>
        <div class="news-empty-sub">${escHtml(msg)}</div>
      </div>`;
  }

  // ── Utilitaires ──
  function formatDate(iso) {
    try {
      return new Date(iso).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' });
    } catch { return ''; }
  }

  function escHtml(str) {
    return String(str)
      .replace(/&/g,'&amp;').replace(/</g,'&lt;')
      .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  // ── Événements tabs ──
  tabs.forEach(tab => {
    tab.addEventListener('click', e => {
      e.preventDefault();
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      currentTheme = tab.dataset.theme;
      currentPage  = 1;
      loadNews(currentTheme, currentPage);
    });
  });

  // ── Chargement initial ──
  loadNews(currentTheme, currentPage);

})();
</script>
{% endblock %}
