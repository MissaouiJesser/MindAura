{% extends 'base_frontoffice.html.twig' %}

{% block title %}Résultats — {{ test.titreTest }}{% endblock %}
{% block page_title %}Résultats & objectifs suggérés{% endblock %}

{% block content %}
<style>
  /* ── Variables locales ── */
  :root {
    --green:        #22A06B;
    --green-deep:   #0D5C3A;
    --green-mid:    #1A7A4E;
    --green-light:  #68d391;
    --green-pale:   #EAF9F2;
    --teal:         #0E9488;
    --teal-pale:    #CCFBF1;
    --violet:       #7C3AED;
    --violet-pale:  #EDE9FF;
    --rose:         #E8538A;
    --rose-pale:    #FFE8F2;
    --yellow:       #F5C842;
    --orange:       #EA580C;
    --orange-pale:  #FFF0E8;
    --border:       #E2E8F0;
    --shadow-card:  0 2px 8px rgba(0,0,0,.07);
    --text:         #1a202c;
    --text-sec:     #718096;
    --bg:           #F7FAFC;
  }

  @keyframes fadeUp    { from{opacity:0;transform:translateY(16px)} to{opacity:1;transform:none} }
  @keyframes shimmer   { 0%,100%{opacity:.5} 50%{opacity:1} }
  @keyframes countUp   { from{opacity:0;transform:scale(.7)} to{opacity:1;transform:scale(1)} }
  @keyframes scaleIn   { from{opacity:0;transform:scale(.94)} to{opacity:1;transform:scale(1)} }
  @keyframes float     { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-6px)} }

  /* ── Score hero ── */
  .result-hero {
    position:relative; overflow:hidden;
    background:linear-gradient(135deg,#0D5C3A 0%,#1A7A4E 50%,#7C3AED 100%);
    border-radius:22px; padding:36px 40px; margin-bottom:26px;
    box-shadow:0 16px 50px rgba(13,92,58,.28);
    animation:fadeUp .5s cubic-bezier(.22,1,.36,1) both;
  }
  .result-hero::before { content:''; position:absolute; width:320px; height:320px; border-radius:50%; background:rgba(255,255,255,.055); top:-90px; right:-70px; pointer-events:none; }
  .result-hero::after  { content:''; position:absolute; width:160px; height:160px; border-radius:50%; background:rgba(245,200,66,.15); bottom:-40px; left:160px; pointer-events:none; }
  .hero-dots { position:absolute; top:18px; left:36px; display:flex; gap:7px; }
  .hero-dots span { width:7px; height:7px; border-radius:50%; animation:shimmer 2s ease-in-out infinite; }
  .hero-dots span:nth-child(1){ background:#F5C842; }
  .hero-dots span:nth-child(2){ background:#E8538A; animation-delay:.3s; }
  .hero-dots span:nth-child(3){ background:#A07DF5; animation-delay:.6s; }

  .result-hero-inner { display:flex; align-items:center; gap:36px; position:relative; z-index:1; margin-top:8px; flex-wrap:wrap; }

  /* ── Score ring ── */
  .score-ring-wrap { flex-shrink:0; position:relative; width:130px; height:130px; }
  .score-ring-wrap svg { width:130px; height:130px; transform:rotate(-90deg); }
  .ring-bg    { fill:none; stroke:rgba(255,255,255,.15); stroke-width:10; }
  .ring-fill  { fill:none; stroke:url(#ringGrad); stroke-width:10; stroke-linecap:round; stroke-dasharray:var(--dash-total); stroke-dashoffset:var(--dash-total); transition:stroke-dashoffset 1.4s cubic-bezier(.22,1,.36,1); }
  .score-center { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; }
  .score-num   { font-family:'Playfair Display',serif; font-size:2.1rem; font-weight:700; color:#fff; line-height:1; animation:countUp .6s cubic-bezier(.22,1,.36,1) .8s both; }
  .score-label { font-size:.67rem; color:rgba(255,255,255,.65); font-weight:700; text-transform:uppercase; letter-spacing:.8px; margin-top:3px; }

  .result-info { flex:1; min-width:220px; }
  .result-tag  { display:inline-flex; align-items:center; gap:6px; background:rgba(255,255,255,.15); border:1px solid rgba(255,255,255,.25); border-radius:99px; padding:5px 14px; font-size:.75rem; font-weight:700; color:#fff; margin-bottom:12px; }
  .result-tag svg { width:12px; height:12px; }
  .result-title { font-family:'Playfair Display',serif; font-size:1.6rem; font-weight:700; color:#fff; margin-bottom:8px; line-height:1.25; }
  .result-sub   { font-size:.9rem; color:rgba(255,255,255,.78); line-height:1.6; }
  .result-chips { display:flex; gap:8px; margin-top:14px; flex-wrap:wrap; }
  .result-chip  { display:inline-flex; align-items:center; gap:5px; background:rgba(255,255,255,.14); border:1px solid rgba(255,255,255,.22); border-radius:99px; padding:5px 12px; font-size:.75rem; font-weight:600; color:#fff; }

  /* ── Section heading ── */
  .section-heading {
    display:flex; align-items:center; gap:12px; margin-bottom:18px;
    animation:fadeUp .4s cubic-bezier(.22,1,.36,1) .1s both;
  }
  .section-heading-icon { width:36px; height:36px; border-radius:11px; background:#EAF9F2; border:1.5px solid rgba(34,160,107,.3); display:grid; place-items:center; flex-shrink:0; }
  .section-heading-icon svg { width:17px; height:17px; color:#22A06B; }
  .section-heading-text { font-family:'Playfair Display',serif; font-size:1.2rem; font-weight:700; color:var(--text); }
  .section-heading-count { margin-left:auto; font-size:.8rem; color:var(--text-sec); font-weight:600; }

  /* ── Gemini analysis card ── */
  .gemini-card {
    background:#fff;
    border:1.5px solid #EDE9FF;
    border-top:3px solid #7C3AED;
    border-radius:18px;
    padding:24px 28px;
    margin-bottom:26px;
    box-shadow:0 4px 18px rgba(124,58,237,.08);
    animation:fadeUp .5s cubic-bezier(.22,1,.36,1) .15s both;
    position:relative;
    overflow:hidden;
  }
  .gemini-card::before {
    content:'';
    position:absolute;
    width:200px; height:200px;
    border-radius:50%;
    background:radial-gradient(circle, rgba(124,58,237,.06) 0%, transparent 70%);
    top:-60px; right:-40px;
    pointer-events:none;
  }
  .gemini-header {
    display:flex; align-items:center; gap:12px; margin-bottom:16px;
  }
  .gemini-icon {
    width:40px; height:40px; border-radius:12px;
    background:linear-gradient(135deg,#7C3AED,#A07DF5);
    display:grid; place-items:center; flex-shrink:0;
    box-shadow:0 4px 12px rgba(124,58,237,.3);
  }
  .gemini-icon svg { width:20px; height:20px; color:#fff; }
  .gemini-label {
    font-family:'Playfair Display',serif;
    font-size:1.1rem; font-weight:700; color:var(--text);
  }
  .gemini-badge {
    margin-left:auto;
    display:inline-flex; align-items:center; gap:5px;
    background:#EDE9FF; color:#7C3AED;
    font-size:.72rem; font-weight:700;
    border-radius:99px; padding:4px 12px;
  }
  .gemini-badge svg { width:10px; height:10px; }
  .gemini-text {
    font-size:.93rem; color:var(--text-sec);
    line-height:1.8;
    border-left:3px solid #EDE9FF;
    padding-left:16px;
    margin:0;
  }

  /* ── Objectives grid ── */
  .obj-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:16px; }

  .obj-card {
    background:#fff; border:1.5px solid var(--border); border-radius:18px; overflow:hidden;
    box-shadow:var(--shadow-card); display:flex; flex-direction:column;
    transition:all .25s cubic-bezier(.22,1,.36,1);
    animation:scaleIn .4s cubic-bezier(.22,1,.36,1) both;
    border-top:3px solid #22A06B;
  }
  .obj-card:hover { transform:translateY(-4px); box-shadow:0 14px 40px rgba(13,92,58,.13); border-color:#22A06B; }
  .obj-card.adopted { border-color:#0E9488; border-top-color:#0E9488; }

  .obj-accent { height:4px; background:linear-gradient(90deg,#22A06B,#68d391,#F5C842); }
  .obj-card.adopted .obj-accent { background:linear-gradient(90deg,#0E9488,#22A06B); }

  .obj-body { padding:18px 20px; flex:1; display:flex; flex-direction:column; gap:10px; }
  .obj-top  { display:flex; align-items:flex-start; justify-content:space-between; gap:8px; }
  .obj-title { font-family:'Playfair Display',serif; font-size:1rem; font-weight:700; color:var(--text); line-height:1.3; flex:1; }

  .obj-status-adopted {
    display:inline-flex; align-items:center; gap:4px;
    background:#CCFBF1; color:#0E9488;
    font-size:.7rem; font-weight:700; border-radius:99px; padding:3px 10px; white-space:nowrap; flex-shrink:0;
  }
  .obj-status-suggest {
    display:inline-flex; align-items:center; gap:4px;
    background:#EAF9F2; color:#22A06B;
    font-size:.7rem; font-weight:700; border-radius:99px; padding:3px 10px; white-space:nowrap; flex-shrink:0;
  }
  .obj-desc { font-size:.87rem; color:var(--text-sec); line-height:1.6; flex:1; }
  .obj-metas { display:flex; gap:6px; flex-wrap:wrap; }
  .obj-meta-chip { display:inline-flex; align-items:center; gap:4px; font-size:.71rem; font-weight:600; border-radius:99px; padding:3px 9px; }

  .obj-footer { padding:14px 20px; border-top:1.5px solid var(--border); background:#F7FAFC; }

  /* ── BOUTON ADOPTER ── */
  .btn-adopt {
    width:100%; display:inline-flex; align-items:center; justify-content:center; gap:8px;
    padding:10px 16px; border-radius:11px; border:none;
    background:linear-gradient(135deg, #0D5C3A, #22A06B);
    color:#fff; font-family:'Outfit',sans-serif; font-size:.86rem; font-weight:700; cursor:pointer;
    transition:all .2s; box-shadow:0 4px 12px rgba(13,92,58,.28);
    text-decoration:none;
  }
  .btn-adopt:hover { transform:translateY(-2px); box-shadow:0 8px 22px rgba(13,92,58,.38); filter:brightness(1.06); }
  .btn-adopt svg { width:14px; height:14px; }

  /* ── BOUTON ADOPTÉ ── */
  .btn-adopted {
    width:100%; display:inline-flex; align-items:center; justify-content:center; gap:8px;
    padding:10px 16px; border-radius:11px;
    border:2px solid #0E9488; background:#CCFBF1;
    color:#0E9488; font-family:'Outfit',sans-serif; font-size:.86rem; font-weight:700;
    text-decoration:none; transition:all .2s;
  }
  .btn-adopted:hover { background:#99F6E4; border-color:#0E9488; }

  /* ── Empty ── */
  .empty-state { display:flex; flex-direction:column; align-items:center; padding:50px 20px; text-align:center; gap:12px; background:#fff; border:1.5px solid var(--border); border-radius:18px; box-shadow:var(--shadow-card); }
  .empty-icon  { width:60px; height:60px; border-radius:18px; background:#FFF0E8; border:1.5px solid rgba(234,88,12,.2); display:grid; place-items:center; }
  .empty-icon svg { width:26px; height:26px; color:#EA580C; }
  .empty-title { font-family:'Playfair Display',serif; font-size:1.1rem; font-weight:700; color:var(--text); }
  .empty-sub   { font-size:.87rem; color:var(--text-sec); max-width:300px; line-height:1.6; }

  /* ── Actions bar ── */
  .actions-bar {
    display:flex; gap:10px; margin-top:24px; flex-wrap:wrap;
    animation:fadeUp .4s cubic-bezier(.22,1,.36,1) .2s both;
  }

  /* ── BOUTON MES OBJECTIFS ── */
  .btn-action-primary {
    padding:11px 22px; border-radius:12px; display:inline-flex; align-items:center; gap:8px;
    text-decoration:none;
    background:linear-gradient(135deg, #0D5C3A, #22A06B);
    color:#fff; font-family:'Outfit',sans-serif; font-size:.88rem; font-weight:700;
    box-shadow:0 4px 14px rgba(13,92,58,.28);
    border:none; cursor:pointer; transition:all .2s;
  }
  .btn-action-primary:hover { transform:translateY(-2px); box-shadow:0 8px 22px rgba(13,92,58,.38); filter:brightness(1.06); }
  .btn-action-primary svg { width:15px; height:15px; }

  /* ── Boutons secondaires ── */
  .btn-action-secondary {
    padding:11px 18px; border-radius:12px; display:inline-flex; align-items:center; gap:7px;
    text-decoration:none; border:1.5px solid var(--border);
    background:#fff; color:var(--text-sec);
    font-family:'Outfit',sans-serif; font-size:.88rem; font-weight:600;
    transition:all .2s;
  }
  .btn-action-secondary:hover { border-color:#22A06B; color:#22A06B; background:#EAF9F2; }
  .btn-action-secondary svg { width:15px; height:15px; }
</style>

{% set maxScore = 100 %}
{% if suggested_objectifs is not empty %}
  {% set maxScore = max(suggested_objectifs|map(o => o.scoreMax ?? 0)) %}
{% endif %}
{% if maxScore < 1 %}
  {% set maxScore = 100 %}
{% endif %}
{% set pct = maxScore > 0 ? ((score / maxScore) * 100)|round : 0 %}
{% set circumference = 345 %}
{% set dashOffset = circumference - (circumference * pct / 100) %}

{# ── Result hero ── #}
<div class="result-hero">
  <div class="hero-dots"><span></span><span></span><span></span></div>
  <div class="result-hero-inner">

    <div class="score-ring-wrap">
      <svg viewBox="0 0 130 130" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="ringGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%"   stop-color="#22A06B"/>
            <stop offset="50%"  stop-color="#F5C842"/>
            <stop offset="100%" stop-color="#A07DF5"/>
          </linearGradient>
        </defs>
        <circle class="ring-bg"   cx="65" cy="65" r="55"/>
        <circle class="ring-fill" cx="65" cy="65" r="55"
          style="--dash-total:{{ circumference }};--dash-offset:{{ dashOffset }};"
          id="scoreRing"/>
      </svg>
      <div class="score-center">
        <div class="score-num" id="scoreNum">0</div>
        <div class="score-label">Score</div>
      </div>
    </div>

    <div class="result-info">
      <div class="result-tag">
        <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 6l3 3 5-5" stroke-linecap="round"/></svg>
        Test terminé
      </div>
      <div class="result-title">{{ test.titreTest }}</div>
      <div class="result-sub">
        Félicitations ! Vous avez complété l'évaluation avec un score de <strong style="color:#F5C842;">{{ score }}</strong>.
        Découvrez vos objectifs personnalisés ci-dessous.
      </div>
      <div class="result-chips">
        <span class="result-chip">
          <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="6" cy="6" r="4"/><path d="M6 4v2l1 1" stroke-linecap="round"/></svg>
          {{ test.dureeEstimee }} min
        </span>
        <span class="result-chip">
          <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 1l1.5 3 3.5.5-2.5 2.5.5 3.5L6 9l-3 1.5.5-3.5L1 4.5l3.5-.5z"/></svg>
          {{ suggested_objectifs|length }} objectif{{ suggested_objectifs|length != 1 ? 's' : '' }} suggéré{{ suggested_objectifs|length != 1 ? 's' : '' }}
        </span>
      </div>
    </div>

  </div>
</div>

{# ── Analyse Groq ── #}
{% if groq_analysis is defined and groq_analysis %}
  <div class="gemini-card">
    <div class="gemini-header">
      <div class="gemini-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"
                stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div class="gemini-label">Analyse personnalisée</div>
      <span class="gemini-badge">
        <svg viewBox="0 0 10 10" fill="currentColor"><circle cx="5" cy="5" r="4"/></svg>
        Groq AI
      </span>
    </div>
    <p class="gemini-text">{{ groq_analysis }}</p>
  </div>
{% endif %}


{# ── Suggested objectives ── #}
{% if suggested_objectifs %}
  <div class="section-heading">
    <div class="section-heading-icon">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke-linecap="round"/></svg>
    </div>
    <div class="section-heading-text">Objectifs recommandés</div>
    <span class="section-heading-count">{{ suggested_objectifs|length }} objectif{{ suggested_objectifs|length != 1 ? 's' : '' }}</span>
  </div>

  <div class="obj-grid">
    {% for objectif in suggested_objectifs %}
      {% set alreadyAdopted = objectif.titre in adopted_titles %}
      <article class="obj-card {{ alreadyAdopted ? 'adopted' : '' }}" style="animation-delay:{{ loop.index0 * 0.06 }}s">
        <div class="obj-accent"></div>
        <div class="obj-body">
          <div class="obj-top">
            <div class="obj-title">{{ objectif.titre }}</div>
            {% if alreadyAdopted %}
              <span class="obj-status-adopted">
                <svg viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="2" style="width:9px;height:9px;"><path d="M2 5l2 2 4-4" stroke-linecap="round"/></svg>
                Adopté
              </span>
            {% else %}
              <span class="obj-status-suggest">
                <svg viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="2" style="width:9px;height:9px;"><path d="M5 2v6M2 5h6" stroke-linecap="round"/></svg>
                Suggéré
              </span>
            {% endif %}
          </div>
          <div class="obj-desc">{{ objectif.description }}</div>
          <div class="obj-metas">
            {% if objectif.categorie %}
              <span class="obj-meta-chip" style="background:#EDE9FF;color:#7C3AED;">{{ objectif.categorie }}</span>
            {% endif %}
            {% if objectif.difficule %}
              <span class="obj-meta-chip" style="background:#FFF0E8;color:#EA580C;">{{ objectif.difficule }}</span>
            {% endif %}
            <span class="obj-meta-chip" style="background:#EAF9F2;color:#0D5C3A;">{{ objectif.scoreMin }}–{{ objectif.scoreMax }} pts</span>
          </div>
        </div>
        <div class="obj-footer">
          {% if alreadyAdopted %}
            <a href="{{ path('front_objectifs_index') }}" class="btn-adopted">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 10l4 4 8-8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Voir mes objectifs
            </a>
          {% else %}
            <form method="post" action="{{ path('front_objectifs_adopt', {'id': objectif.idObjectif}) }}">
              <input type="hidden" name="_token" value="{{ csrf_token('adopt_' ~ objectif.idObjectif) }}">
              <button type="submit" class="btn-adopt">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 4v12M4 10h12" stroke-linecap="round"/></svg>
                Adopter cet objectif
              </button>
            </form>
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
{% else %}
  <div class="empty-state">
    <div class="empty-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke-linecap="round"/></svg>
    </div>
    <div class="empty-title">Aucun objectif suggéré</div>
    <div class="empty-sub">Aucun objectif n'est encore défini pour votre plage de score. Consultez d'autres tests.</div>
  </div>
{% endif %}

{# ── Actions bar ── #}
<div class="actions-bar">
  <a href="{{ path('front_objectifs_index') }}" class="btn-action-primary">
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke-linecap="round"/></svg>
    Mes objectifs
  </a>
  <a href="{{ path('front_tests_my_responses') }}" class="btn-action-secondary">
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="14" height="13" rx="2"/><path d="M3 8h14M7 2v4M13 2v4" stroke-linecap="round"/></svg>
    Mes réponses
  </a>
  <a href="{{ path('front_tests_index') }}" class="btn-action-secondary">
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2" stroke-linecap="round"/><rect x="9" y="3" width="6" height="4" rx="1"/></svg>
    Autres tests
  </a>
</div>

<script>
(function(){
  const ring = document.getElementById('scoreRing');
  const circumference = {{ circumference }};
  const dashOffset    = {{ dashOffset }};
  if(ring){
    setTimeout(function(){ ring.style.strokeDashoffset = dashOffset; }, 300);
  }
  const scoreEl = document.getElementById('scoreNum');
  const target  = {{ score }};
  let cur = 0;
  const step = Math.max(1, Math.ceil(target / 60));
  const interval = setInterval(function(){
    cur = Math.min(cur + step, target);
    scoreEl.textContent = cur;
    if(cur >= target) clearInterval(interval);
  }, 20);
})();
</script>
{% endblock %}
