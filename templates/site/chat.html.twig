<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Messages — MindAura</title>
  <link rel="icon" type="image/png" href="{{ asset('images/logo.png') }}"/>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet"/>
  <style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    /* Brand */
    --g1:#0d3320; --g2:#1a5c38; --g3:#2d9e6b; --g4:#4ecb94;
    --g-pale:#d0f5e6; --g-hover:#e6f9f0;
    --violet:#7c4dff; --vio-pale:#ede7ff;
    /* UI */
    --bg:#f5f5f5; --surface:#ffffff; --surface2:#fafafa;
    --text:#0a0a0a; --text-sec:#737373; --text-muted:#a3a3a3;
    --border:#e5e5e5; --border-light:#f0f0f0;
    /* Chat bubbles */
    --mine-bg:linear-gradient(145deg,#1a5c38 0%,#2d9e6b 100%);
    --mine-text:#ffffff;
    --other-bg:#efefef;
    --other-text:#0a0a0a;
    /* Shadows */
    --shadow-sm:0 1px 3px rgba(0,0,0,.08),0 1px 2px rgba(0,0,0,.05);
    --shadow-md:0 4px 16px rgba(0,0,0,.10),0 2px 6px rgba(0,0,0,.06);
    --shadow-lg:0 20px 48px rgba(0,0,0,.14),0 8px 20px rgba(0,0,0,.08);
    --shadow-glow:0 0 0 3px rgba(45,158,107,.2);
    /* Motion */
    --ease:cubic-bezier(.22,1,.36,1);
    --ease-spring:cubic-bezier(.34,1.56,.64,1);
    --ease-back:cubic-bezier(.36,.07,.19,.97);
    /* Radius */
    --r-sm:8px; --r-md:14px; --r-lg:20px; --r-xl:28px; --r-full:9999px;
  }

  html { scroll-behavior:smooth; height:100%; }

  body {
    font-family:'DM Sans',sans-serif;
    background:var(--bg); color:var(--text);
    overflow-x:hidden; line-height:1.5;
    min-height:100vh; height:100%;
    display:flex; flex-direction:column;
    -webkit-font-smoothing:antialiased;
  }

  /* ════════════════════════════════
     NAVBAR — ultra-thin Instagram style
  ════════════════════════════════ */
  .nav {
    position:sticky; top:0; z-index:999;
    background:rgba(255,255,255,.95);
    backdrop-filter:blur(20px) saturate(180%);
    border-bottom:1px solid var(--border);
    padding:0 32px;
    display:flex; align-items:center; gap:16px; height:60px;
    transition:box-shadow .3s var(--ease);
    flex-shrink:0;
  }
  .nav.scrolled { box-shadow:var(--shadow-sm); }
  .nav-brand {
    display:flex; align-items:center; gap:10px;
    text-decoration:none; flex-shrink:0;
  }
  .nav-brand-img-wrap {
    width:36px; height:36px; border-radius:10px;
    overflow:hidden; border:1.5px solid var(--border);
    display:grid; place-items:center;
    transition:transform .3s var(--ease-spring);
  }
  .nav-brand:hover .nav-brand-img-wrap { transform:scale(1.07) rotate(-4deg); }
  .nav-brand-img { width:100%; height:100%; object-fit:contain; }
  .nav-brand-name {
    font-family:'DM Serif Display',serif;
    font-size:1.15rem; color:var(--text);
    letter-spacing:-.3px;
  }
  .nav-links {
    flex:1; display:flex; align-items:center;
    gap:2px; justify-content:center;
  }
  .nav-link {
    padding:6px 14px; border-radius:var(--r-full);
    font-size:.82rem; font-weight:500;
    color:var(--text-sec); text-decoration:none;
    transition:all .2s var(--ease); position:relative;
  }
  .nav-link:hover { background:var(--bg); color:var(--text); }
  .nav-link.active {
    background:var(--g-pale); color:var(--g2); font-weight:600;
  }
  .nav-right { display:flex; align-items:center; gap:8px; }

  /* Nav pill */
  .nav-user-pill-wrapper { position:relative; }
  .nav-user-pill {
    display:flex; align-items:center; gap:8px;
    padding:4px 12px 4px 4px; border-radius:var(--r-full);
    background:var(--bg); border:1.5px solid var(--border);
    cursor:pointer; font-family:'DM Sans',sans-serif;
    transition:all .2s var(--ease);
  }
  .nav-user-pill:hover,
  .nav-user-pill[aria-expanded="true"] {
    background:var(--g-hover); border-color:var(--g3);
    box-shadow:var(--shadow-glow);
  }
  .nav-avatar {
    width:28px; height:28px; border-radius:50%;
    background:var(--g-pale); border:2px solid var(--g3);
    display:grid; place-items:center;
    font-size:.68rem; font-weight:700; color:var(--g1);
    overflow:hidden; flex-shrink:0;
  }
  .nav-avatar img { width:100%; height:100%; object-fit:cover; }
  .nav-user-name { font-size:.8rem; font-weight:600; color:var(--text); }
  .nav-role-badge {
    font-size:.65rem; color:var(--text-sec);
    background:var(--surface2); padding:1px 7px;
    border-radius:var(--r-full); font-weight:600;
    border:1px solid var(--border);
  }
  .pill-chevron {
    width:12px; height:12px; stroke:var(--text-sec);
    transition:transform .25s var(--ease);
    fill:none; stroke-width:2.5;
  }
  .nav-user-pill[aria-expanded="true"] .pill-chevron { transform:rotate(180deg); }

  /* Dropdown */
  .user-dropdown {
    position:absolute; top:calc(100% + 8px); right:0;
    width:270px; background:var(--surface);
    border:1px solid var(--border); border-radius:var(--r-lg);
    box-shadow:var(--shadow-lg);
    z-index:1000; overflow:hidden;
    opacity:0; visibility:hidden;
    transform:translateY(-6px) scale(.97);
    transform-origin:top right;
    transition:opacity .18s var(--ease),transform .18s var(--ease),visibility .18s;
  }
  .user-dropdown.open { opacity:1; visibility:visible; transform:translateY(0) scale(1); }
  .dropdown-header {
    display:flex; align-items:center; gap:11px;
    padding:14px 16px 12px;
    background:linear-gradient(135deg,var(--g-pale) 0%,rgba(255,255,255,0) 100%);
  }
  .dropdown-avatar {
    width:40px; height:40px; border-radius:50%;
    background:linear-gradient(135deg,var(--g2),var(--g3));
    border:2px solid var(--g3);
    display:grid; place-items:center;
    font-size:.88rem; font-weight:700; color:#fff; overflow:hidden; flex-shrink:0;
  }
  .dropdown-avatar img { width:100%; height:100%; object-fit:cover; }
  .dropdown-user-name { font-size:.84rem; font-weight:700; color:var(--text); }
  .dropdown-user-email { font-size:.72rem; color:var(--text-sec); margin-top:1px; }
  .dropdown-divider { height:1px; background:var(--border); }
  .dropdown-item {
    display:flex; align-items:center; gap:11px;
    padding:10px 16px; text-decoration:none; color:var(--text);
    font-size:.82rem; transition:background .15s;
  }
  .dropdown-item:hover { background:var(--bg); }
  .dropdown-item--danger:hover { background:#fef2f2; }
  .dropdown-item--danger .dropdown-item-label { color:#dc2626; }
  .dropdown-item-icon {
    width:28px; height:28px; border-radius:var(--r-sm);
    background:var(--g-pale); display:grid; place-items:center; flex-shrink:0;
  }
  .dropdown-item-icon svg { width:14px; height:14px; stroke:var(--g2); fill:none; }
  .dropdown-item-icon--violet { background:var(--vio-pale); }
  .dropdown-item-icon--violet svg { stroke:var(--violet); }
  .dropdown-item-icon--red { background:#fef2f2; }
  .dropdown-item-icon--red svg { stroke:#dc2626; }
  .dropdown-item-text { flex:1; }
  .dropdown-item-label { font-weight:600; color:var(--text); display:block; }
  .dropdown-item-sub { font-size:.7rem; color:var(--text-sec); display:block; }
  .dropdown-item-arrow { width:12px; height:12px; stroke:var(--border); fill:none; stroke-width:2; }

  /* ════════════════════════════════
     CHAT PAGE SHELL
  ════════════════════════════════ */
  .chat-page { flex:1; display:flex; flex-direction:column; background:var(--bg); }
  .chat-page-inner {
    flex:1; max-width:1360px; width:100%; margin:0 auto;
    padding:16px 16px 20px;
    display:flex; flex-direction:column;
    height:calc(100svh - 60px);
    overflow:hidden;
  }

  /* Header */
  .chat-page-header {
    display:flex; align-items:center; justify-content:space-between;
    margin-bottom:12px; flex-shrink:0;
    padding:0 4px;
  }
  .chat-page-title { display:flex; align-items:center; gap:10px; }
  .chat-page-title-icon {
    width:38px; height:38px; border-radius:12px;
    background:linear-gradient(145deg,var(--g1),var(--g3));
    display:grid; place-items:center;
    box-shadow:0 4px 12px rgba(45,158,107,.3);
  }
  .chat-page-title-icon svg { width:18px; height:18px; stroke:#fff; fill:none; stroke-width:2; }
  .chat-page-title h1 {
    font-family:'DM Serif Display',serif;
    font-size:1.3rem; color:var(--text); letter-spacing:-.3px;
  }
  .chat-page-subtitle { font-size:.75rem; color:var(--text-sec); margin-top:1px; }

  /* Main shell */
  .chat-shell {
    flex:1; display:flex; background:var(--surface);
    border-radius:var(--r-xl);
    box-shadow:0 -4px 40px rgba(0,0,0,.06),0 0 0 1px var(--border);
    overflow:hidden; min-height:0;
  }

  /* ════════════════════════════════
     SIDEBAR
  ════════════════════════════════ */
  .cs {
    width:350px; flex-shrink:0;
    background:var(--surface);
    border-right:1px solid var(--border);
    display:flex; flex-direction:column; height:100%;
  }

  .cs-head { padding:16px 16px 0; flex-shrink:0; }
  .cs-head-top {
    display:flex; align-items:center;
    justify-content:space-between; margin-bottom:12px;
  }
  .cs-title {
    font-size:1.05rem; font-weight:700;
    color:var(--text); letter-spacing:-.2px;
  }
  .cs-new-btn {
    width:30px; height:30px; border-radius:var(--r-sm);
    background:var(--g-pale); border:none; cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    color:var(--g2); transition:all .2s var(--ease-spring);
  }
  .cs-new-btn:hover { background:var(--g2); color:#fff; transform:scale(1.1); }
  .cs-new-btn svg { width:15px; height:15px; stroke:currentColor; fill:none; stroke-width:2; }

  /* Search */
  .cs-search { position:relative; margin-bottom:8px; }
  .cs-search-icon {
    position:absolute; left:10px; top:50%; transform:translateY(-50%);
    width:14px; height:14px; stroke:var(--text-muted); fill:none; pointer-events:none;
  }
  .cs-search-input {
    width:100%; padding:9px 12px 9px 32px;
    background:var(--bg); border:1.5px solid transparent;
    border-radius:var(--r-full); font-family:'DM Sans',sans-serif;
    font-size:.82rem; color:var(--text); outline:none;
    transition:all .2s var(--ease);
  }
  .cs-search-input:focus {
    border-color:var(--g3); background:var(--surface);
    box-shadow:var(--shadow-glow);
  }
  .cs-search-input::placeholder { color:var(--text-muted); }

  .cs-search-results {
    background:var(--surface); border:1px solid var(--border);
    border-radius:var(--r-md); margin-top:4px;
    max-height:200px; overflow-y:auto;
    box-shadow:var(--shadow-md); display:none;
  }
  .cs-search-item {
    display:flex; align-items:center; gap:10px;
    padding:10px 14px; cursor:pointer; transition:background .15s;
  }
  .cs-search-item:hover { background:var(--bg); }
  .cs-search-item-name { font-size:.84rem; font-weight:600; color:var(--text); }
  .cs-search-item-role { font-size:.7rem; color:var(--text-sec); }

  /* Tabs */
  .cs-tabs {
    display:flex; gap:0; padding:0 16px 10px;
    flex-shrink:0; border-bottom:1px solid var(--border);
  }
  .cs-tab {
    flex:1; padding:7px 0; border-radius:var(--r-sm);
    font-size:.78rem; font-weight:600; border:none;
    background:transparent; cursor:pointer;
    color:var(--text-sec); transition:all .2s var(--ease);
    font-family:'DM Sans',sans-serif; position:relative;
  }
  .cs-tab.active { color:var(--g2); }
  .cs-tab.active::after {
    content:''; position:absolute; bottom:-10px; left:20%; right:20%;
    height:2px; background:var(--g3); border-radius:var(--r-full);
  }
  .cs-tab:not(.active):hover { color:var(--text); }

  /* Conversation list */
  .cs-list { flex:1; overflow-y:auto; padding:6px 8px; min-height:0; }
  .cs-list::-webkit-scrollbar { width:3px; }
  .cs-list::-webkit-scrollbar-thumb { background:var(--border); border-radius:99px; }

  .cs-item {
    display:flex; align-items:center; gap:12px;
    padding:10px 10px; border-radius:var(--r-md);
    cursor:pointer; transition:all .18s var(--ease);
    position:relative; margin-bottom:2px;
  }
  .cs-item:hover { background:var(--bg); transform:translateX(2px); }
  .cs-item.active { background:var(--g-pale); }
  .cs-item.active::before {
    content:''; position:absolute; left:0; top:20%; bottom:20%;
    width:3px; border-radius:0 3px 3px 0; background:var(--g3);
  }

  /* Avatar */
  .cs-ava {
    position:relative; flex-shrink:0;
    width:46px; height:46px; border-radius:50%;
    background:var(--g-pale); border:2px solid transparent;
    overflow:hidden; display:flex; align-items:center; justify-content:center;
    font-weight:700; font-size:.88rem; color:var(--g1);
    transition:border-color .2s;
  }
  .cs-ava img { width:100%; height:100%; object-fit:cover; display:block; }
  .cs-item.active .cs-ava { border-color:var(--g3); }
  .cs-online-dot {
    position:absolute; bottom:1px; right:1px;
    width:10px; height:10px; border-radius:50%;
    background:#22c55e; border:2px solid var(--surface);
  }

  .cs-meta { flex:1; min-width:0; }
  .cs-name {
    font-size:.86rem; font-weight:700; color:var(--text);
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
    display:flex; align-items:center; gap:5px;
  }
  .cs-role-chip {
    font-size:.6rem; font-weight:700; padding:1px 6px;
    border-radius:var(--r-full); flex-shrink:0;
  }
  .cs-role-chip.patient { background:#e3f2fd; color:#1565c0; }
  .cs-role-chip.psychologue { background:var(--vio-pale); color:var(--violet); }
  .cs-role-chip.coach { background:#fff3e0; color:#e65100; }
  .cs-role-chip.admin { background:#fce4ec; color:#c62828; }
  .cs-role-chip.user { background:var(--g-pale); color:var(--g1); }
  .cs-snippet {
    font-size:.75rem; color:var(--text-sec);
    margin-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  }
  .cs-snippet-mine { color:var(--g2); font-weight:600; }
  .cs-aside { flex-shrink:0; display:flex; flex-direction:column; align-items:flex-end; gap:4px; }
  .cs-time { font-size:.68rem; color:var(--text-muted); }
  .cs-badge {
    background:var(--g3); color:#fff; font-size:.64rem; font-weight:800;
    min-width:18px; height:18px; border-radius:var(--r-full);
    display:flex; align-items:center; justify-content:center;
    padding:0 4px; animation:badgePop .35s var(--ease-spring);
  }
  @keyframes badgePop { 0%{transform:scale(0)}70%{transform:scale(1.3)}100%{transform:scale(1)} }

  .cs-empty {
    display:flex; flex-direction:column; align-items:center;
    padding:48px 20px; gap:10px; color:var(--text-sec); text-align:center;
  }
  .cs-empty svg { width:52px; height:52px; opacity:.3; }
  .cs-empty p { font-size:.88rem; font-weight:700; color:var(--text); }
  .cs-empty span { font-size:.76rem; }

  /* Me bar */
  .cs-me {
    display:flex; align-items:center; gap:10px;
    padding:12px 14px; border-top:1px solid var(--border);
    background:var(--surface2); flex-shrink:0;
  }
  .cs-me-ava {
    width:34px; height:34px; border-radius:50%;
    background:var(--g-pale); border:2px solid var(--g3);
    display:flex; align-items:center; justify-content:center;
    font-weight:700; font-size:.78rem; color:var(--g1); overflow:hidden; flex-shrink:0;
  }
  .cs-me-ava img { width:100%; height:100%; object-fit:cover; }
  .cs-me-info { flex:1; min-width:0; }
  .cs-me-name { font-size:.8rem; font-weight:700; color:var(--text); }
  .cs-me-role { font-size:.67rem; color:var(--text-sec); }
  .cs-me-dot {
    width:8px; height:8px; border-radius:50%;
    background:#22c55e; border:2px solid #fff;
    box-shadow:0 0 0 3px rgba(34,197,94,.15);
    flex-shrink:0;
  }

  /* ════════════════════════════════
     MAIN PANEL
  ════════════════════════════════ */
  .cm { flex:1; display:flex; flex-direction:column; overflow:hidden; background:var(--surface); min-height:0; }

  /* Empty state */
  .cm-empty { flex:1; display:flex; align-items:center; justify-content:center; }
  .cm-empty-inner {
    text-align:center; max-width:280px;
    display:flex; flex-direction:column; align-items:center; gap:16px;
  }
  .cm-empty-art {
    width:96px; height:96px; border-radius:50%;
    background:linear-gradient(145deg,var(--g-pale),var(--vio-pale));
    display:flex; align-items:center; justify-content:center;
    animation:emptyPulse 3s ease-in-out infinite;
  }
  @keyframes emptyPulse { 0%,100%{transform:scale(1)}50%{transform:scale(1.04)} }
  .cm-empty-art svg { width:44px; height:44px; stroke:var(--g3); fill:none; stroke-width:1.6; }
  .cm-empty-inner h2 {
    font-family:'DM Serif Display',serif;
    font-size:1.25rem; color:var(--text); letter-spacing:-.2px;
  }
  .cm-empty-inner p { font-size:.82rem; color:var(--text-sec); line-height:1.65; }
  .cm-new-btn {
    display:inline-flex; align-items:center; gap:7px;
    padding:10px 22px; border-radius:var(--r-full);
    background:linear-gradient(135deg,var(--g2),var(--g3));
    color:#fff; font-family:'DM Sans',sans-serif;
    font-size:.84rem; font-weight:600;
    border:none; cursor:pointer;
    box-shadow:0 6px 20px rgba(45,158,107,.3);
    transition:all .25s var(--ease-spring);
  }
  .cm-new-btn:hover { transform:translateY(-2px); box-shadow:0 10px 28px rgba(45,158,107,.4); }
  .cm-new-btn svg { width:14px; height:14px; stroke:currentColor; fill:none; stroke-width:2.5; }

  /* Conversation header */
  .cm-header {
    display:none; align-items:center; gap:12px;
    padding:12px 18px; border-bottom:1px solid var(--border);
    background:var(--surface); flex-shrink:0;
    animation:slideDown .25s var(--ease);
  }
  @keyframes slideDown { from{opacity:0;transform:translateY(-8px)} to{opacity:1;transform:none} }
  .cm-header.visible { display:flex; }
  .cm-header-ava {
    width:40px; height:40px; border-radius:50%;
    background:var(--g-pale); border:2px solid var(--border);
    overflow:hidden; flex-shrink:0;
    display:flex; align-items:center; justify-content:center;
    font-weight:700; font-size:.88rem; color:var(--g1);
  }
  .cm-header-ava img { width:100%; height:100%; object-fit:cover; }
  .cm-header-info { flex:1; }
  .cm-header-name { font-size:.94rem; font-weight:700; color:var(--text); }
  .cm-header-status {
    font-size:.7rem; color:var(--text-sec);
    display:flex; align-items:center; gap:4px;
  }
  .cm-header-status::before {
    content:''; width:6px; height:6px; border-radius:50%;
    background:#22c55e; display:inline-block;
    animation:statusPulse 2s ease-in-out infinite;
  }
  @keyframes statusPulse { 0%,100%{opacity:1}50%{opacity:.5} }
  .cm-header-actions { display:flex; gap:6px; }
  .cm-action-btn {
    width:32px; height:32px; border-radius:var(--r-sm);
    background:var(--bg); border:1px solid var(--border);
    display:flex; align-items:center; justify-content:center;
    cursor:pointer; transition:all .18s; color:var(--text-sec);
  }
  .cm-action-btn:hover { background:var(--g-hover); border-color:var(--g3); color:var(--g1); }
  .cm-action-btn svg { width:14px; height:14px; stroke:currentColor; fill:none; stroke-width:2; }

  /* ── Messages scroll ── */
  .cm-scroll-wrap {
    display:none; flex:1; overflow:hidden; min-height:0;
    flex-direction:column; position:relative;
  }
  .cm-scroll-wrap.visible { display:flex; }

  /* Scroll sentinel for infinite scroll */
  .cm-scroll-sentinel { height:1px; flex-shrink:0; }

  .cm-scroll {
    flex:1; overflow-y:auto; overflow-x:hidden;
    padding:16px 20px; display:flex;
    flex-direction:column; gap:1px; min-height:0;
    scroll-behavior:smooth;
  }
  .cm-scroll::-webkit-scrollbar { width:4px; }
  .cm-scroll::-webkit-scrollbar-thumb {
    background:var(--border); border-radius:99px;
    transition:background .2s;
  }
  .cm-scroll::-webkit-scrollbar-thumb:hover { background:var(--text-muted); }

  /* Loading more indicator */
  .cm-loading-more {
    display:none; align-items:center; justify-content:center;
    padding:10px; gap:6px; color:var(--text-sec); font-size:.76rem;
    font-weight:500; flex-shrink:0;
  }
  .cm-loading-more.visible { display:flex; }
  .cm-loading-more-spinner {
    width:16px; height:16px; border:2px solid var(--border);
    border-top-color:var(--g3); border-radius:50%;
    animation:spin .7s linear infinite;
  }
  @keyframes spin { to { transform:rotate(360deg); } }

  /* Date separators */
  .msg-date-sep {
    display:flex; align-items:center; gap:10px;
    margin:14px 0 8px; font-size:.68rem;
    color:var(--text-muted); font-weight:600; flex-shrink:0;
  }
  .msg-date-sep::before,.msg-date-sep::after {
    content:''; flex:1; height:1px; background:var(--border);
  }
  .msg-date-sep span {
    background:var(--surface); padding:2px 10px;
    border-radius:var(--r-full); border:1px solid var(--border);
    white-space:nowrap;
  }

  /* ════════════════════════════════
     MESSAGE ROWS — Instagram style
  ════════════════════════════════ */
  .msg-row {
    display:flex; align-items:flex-end; gap:8px;
    max-width:68%; animation:msgIn .22s var(--ease) both;
    position:relative; flex-shrink:0;
    cursor:pointer; /* Click to open context menu */
  }
  @keyframes msgIn {
    from{opacity:0;transform:translateY(10px) scale(.97)}
    to{opacity:1;transform:none}
  }
  .msg-row.mine { align-self:flex-end; flex-direction:row-reverse; }
  .msg-row.other { align-self:flex-start; }
  .msg-row.consecutive { margin-top:1px; }

  /* Avatar */
  .msg-ava {
    width:26px; height:26px; border-radius:50%;
    background:var(--g-pale); border:1.5px solid var(--border);
    flex-shrink:0; overflow:hidden;
    display:flex; align-items:center; justify-content:center;
    font-size:.62rem; font-weight:700; color:var(--g1);
    align-self:flex-end; transition:transform .2s var(--ease-spring);
  }
  .msg-ava img { width:100%; height:100%; object-fit:cover; display:block; }
  .msg-row:hover .msg-ava { transform:scale(1.08); }
  .msg-row.consecutive .msg-ava { visibility:hidden; }

  /* Message body */
  .msg-body { display:flex; flex-direction:column; gap:2px; }
  .mine .msg-body { align-items:flex-end; }
  .other .msg-body { align-items:flex-start; }

  .msg-sender-name {
    font-size:.68rem; font-weight:600; color:var(--text-sec);
    padding:0 4px; display:none;
  }
  .other:not(.consecutive) .msg-sender-name { display:block; }

  /* Bubble */
  .msg-bubble {
    padding:9px 14px; font-size:.875rem;
    line-height:1.52; word-break:break-word;
    max-width:100%; position:relative;
    transition:transform .15s var(--ease-spring), box-shadow .15s;
  }
  .mine .msg-bubble {
    background:var(--mine-bg); color:var(--mine-text);
    border-radius:20px 20px 4px 20px;
    box-shadow:0 2px 8px rgba(45,158,107,.25);
  }
  .other .msg-bubble {
    background:var(--other-bg); color:var(--other-text);
    border-radius:20px 20px 20px 4px;
    border:1px solid var(--border-light);
  }
  .mine.consecutive .msg-bubble { border-top-right-radius:4px; }
  .other.consecutive .msg-bubble { border-top-left-radius:4px; }
  .msg-row:hover .msg-bubble { transform:scale(1.01); }
  .msg-row.mine:hover .msg-bubble { box-shadow:0 4px 16px rgba(45,158,107,.35); }

  /* Tap/click feedback */
  .msg-row:active .msg-bubble { transform:scale(.98); }

  /* Time */
  .msg-time {
    font-size:.62rem; color:var(--text-muted);
    padding:0 4px; opacity:0;
    transition:opacity .2s; display:flex; align-items:center; gap:3px;
    flex-shrink:0;
  }
  .msg-row:hover .msg-time,
  .msg-row:last-child .msg-time { opacity:1; }
  .mine .msg-time { color:rgba(255,255,255,.55); }
  .msg-status svg { width:11px; height:11px; stroke:currentColor; fill:none; stroke-width:2.5; }

  /* Typing indicator */
  .msg-typing {
    display:flex; gap:4px; padding:10px 14px;
    background:var(--other-bg); border-radius:20px 20px 20px 4px;
    align-self:flex-start; margin-left:34px;
    border:1px solid var(--border-light);
    animation:msgIn .22s var(--ease);
  }
  .msg-typing span {
    width:6px; height:6px; border-radius:50%;
    background:var(--text-muted); opacity:.5;
    animation:typingBounce 1.2s ease-in-out infinite;
  }
  .msg-typing span:nth-child(2){animation-delay:.15s}
  .msg-typing span:nth-child(3){animation-delay:.3s}
  @keyframes typingBounce {
    0%,80%,100%{transform:translateY(0);opacity:.4}
    40%{transform:translateY(-5px);opacity:1}
  }

  /* Image bubble */
  .msg-image {
    max-width:260px; max-height:200px; border-radius:16px;
    display:block; cursor:pointer; object-fit:cover;
    transition:opacity .2s, transform .2s var(--ease-spring);
    box-shadow:var(--shadow-sm);
  }
  .msg-image:hover { opacity:.92; transform:scale(1.02); }

  /* Audio bubble */
  .msg-audio {
    display:flex; align-items:center; gap:8px;
    padding:10px 14px; border-radius:99px; min-width:200px;
  }
  /* Mine : fond vert gradient (comme la bulle texte) + éléments blancs */
  .mine .msg-audio {
    background:linear-gradient(145deg,#1a5c38 0%,#2d9e6b 100%);
    box-shadow:0 2px 8px rgba(45,158,107,.25);
  }
  /* Other : fond gris clair */
  .other .msg-audio { background:var(--bg); border:1px solid var(--border); }

  .msg-audio-play {
    width:32px; height:32px; border-radius:50%;
    border:none; cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    flex-shrink:0; transition:all .18s var(--ease-spring);
  }
  /* Mine : bouton play blanc semi-transparent sur fond vert */
  .mine .msg-audio-play { background:rgba(255,255,255,.25); color:#fff; }
  .mine .msg-audio-play:hover { background:rgba(255,255,255,.40); }
  /* Other : bouton play vert sur fond gris */
  .other .msg-audio-play { background:var(--g2); color:#fff; }
  .other .msg-audio-play:hover { background:var(--g1); }

  .msg-audio-play:hover { transform:scale(1.12); }
  .msg-audio-play svg { width:12px; height:12px; stroke:currentColor; fill:currentColor; stroke-width:0; }
  .msg-audio-track { flex:1; display:flex; flex-direction:column; gap:4px; }

  .msg-audio-bar {
    width:100%; height:3px; border-radius:99px;
    cursor:pointer; position:relative;
  }
  .mine .msg-audio-bar  { background:rgba(255,255,255,.30); }
  .other .msg-audio-bar { background:var(--border); }

  .msg-audio-progress {
    height:100%; border-radius:99px; width:0%;
    transition:width .1s linear; pointer-events:none;
  }
  .mine  .msg-audio-progress { background:rgba(255,255,255,.9); }
  .other .msg-audio-progress { background:var(--g3); }

  .msg-audio-dur { font-size:.67rem; opacity:.85; font-weight:500; }
  .mine  .msg-audio-dur { color:#fff; }
  .other .msg-audio-dur { color:var(--text-sec); }

  /* ════════════════════════════════
     REACTION CHIPS (on messages)
  ════════════════════════════════ */
  .msg-reactions { display:flex; gap:3px; flex-wrap:wrap; margin-top:4px; }
  .msg-reaction-chip {
    background:var(--surface); border:1.5px solid var(--border);
    border-radius:var(--r-full); padding:2px 8px;
    font-size:.76rem; cursor:pointer;
    display:flex; align-items:center; gap:3px;
    transition:all .18s var(--ease-spring);
    box-shadow:0 1px 4px rgba(0,0,0,.06);
  }
  .msg-reaction-chip:hover {
    border-color:var(--g3); background:var(--g-pale);
    transform:scale(1.1);
  }
  .msg-reaction-chip span { font-size:.68rem; font-weight:700; color:var(--text-sec); }

  /* Edit area */
  .msg-edit-area { display:none; }
  .msg-edit-area.open { display:flex; flex-direction:column; gap:6px; }
  .msg-edit-input {
    border-radius:var(--r-md); padding:8px 12px;
    font-family:'DM Sans',sans-serif; font-size:.86rem;
    color:var(--text); border:1.5px solid var(--g3); outline:none;
    resize:none; min-height:40px;
    box-shadow:var(--shadow-glow);
  }
  .msg-edit-btns { display:flex; gap:6px; }
  .msg-edit-save {
    background:var(--g2); color:#fff; border:none;
    border-radius:var(--r-sm); padding:5px 14px;
    font-family:'DM Sans',sans-serif; font-size:.76rem; font-weight:600;
    cursor:pointer; transition:background .18s;
  }
  .msg-edit-save:hover { background:var(--g1); }
  .msg-edit-cancel {
    background:var(--bg); color:var(--text-sec);
    border:1px solid var(--border); border-radius:var(--r-sm);
    padding:5px 12px; font-family:'DM Sans',sans-serif;
    font-size:.76rem; font-weight:500; cursor:pointer;
  }

  /* ════════════════════════════════
     CONTEXT MENU — Instagram style popup
  ════════════════════════════════ */
  .msg-ctx-overlay {
    display:none; position:fixed; inset:0;
    z-index:500; background:transparent;
  }
  .msg-ctx-overlay.open { display:block; }

  .msg-ctx-menu {
    position:fixed; z-index:600;
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:var(--r-lg);
    box-shadow:var(--shadow-lg);
    padding:6px; min-width:200px;
    display:none; flex-direction:column; gap:2px;
    animation:ctxIn .18s var(--ease-spring);
    transform-origin:center;
  }
  @keyframes ctxIn {
    from{opacity:0;transform:scale(.88) translateY(-6px)}
    to{opacity:1;transform:scale(1) translateY(0)}
  }
  .msg-ctx-menu.open { display:flex; }

  /* Reaction bar in ctx menu */
  .msg-reactions-bar {
    display:flex; gap:2px; padding:6px 6px 8px;
    border-bottom:1px solid var(--border); flex-wrap:nowrap;
    justify-content:space-around;
  }
  .msg-react-emoji {
    background:none; border:none; font-size:1.3rem;
    cursor:pointer; border-radius:var(--r-sm);
    padding:4px 6px; transition:all .18s var(--ease-spring);
    line-height:1;
  }
  .msg-react-emoji:hover {
    background:var(--g-pale); transform:scale(1.3) translateY(-4px);
  }

  .ctx-item {
    display:flex; align-items:center; gap:9px;
    padding:9px 11px; border-radius:var(--r-sm);
    cursor:pointer; font-size:.82rem; font-weight:500;
    color:var(--text); transition:background .15s;
    background:none; border:none; width:100%;
    font-family:'DM Sans',sans-serif;
  }
  .ctx-item:hover { background:var(--bg); }
  .ctx-item.danger { color:#dc2626; }
  .ctx-item.danger:hover { background:#fef2f2; }
  .ctx-item svg { width:14px; height:14px; stroke:currentColor; fill:none; stroke-width:2; flex-shrink:0; }
  .ctx-divider { height:1px; background:var(--border); margin:2px 0; }

  /* ════════════════════════════════
     INPUT BAR
  ════════════════════════════════ */
  .cm-input-bar {
    display:none; padding:10px 16px 14px;
    border-top:1px solid var(--border);
    background:var(--surface); flex-shrink:0;
  }
  .cm-input-bar.visible { display:flex; flex-direction:column; gap:6px; }

  .cm-file-preview {
    display:none; align-items:center; gap:9px;
    background:var(--g-pale); border:1.5px solid var(--g3);
    border-radius:var(--r-md); padding:7px 12px;
  }
  .cm-file-preview.visible { display:flex; }
  .cm-file-preview-thumb {
    width:36px; height:36px; border-radius:var(--r-sm);
    object-fit:cover; flex-shrink:0; border:1px solid var(--g3);
  }
  .cm-file-preview-name {
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
    font-size:.78rem; font-weight:700; color:var(--g1);
  }
  .cm-file-preview-size { font-size:.68rem; color:var(--text-sec); }
  .cm-file-preview-remove {
    width:22px; height:22px; border-radius:50%; border:none;
    background:rgba(27,67,50,.12); cursor:pointer; flex-shrink:0;
    display:flex; align-items:center; justify-content:center;
    color:var(--g1); transition:background .18s;
  }
  .cm-file-preview-remove:hover { background:#fee2e2; color:#dc2626; }
  .cm-file-preview-remove svg { width:11px; height:11px; stroke:currentColor; fill:none; stroke-width:2.5; }

  .cm-voice-bar {
    display:none; align-items:center; gap:10px;
    background:#fff5f5; border:1.5px solid #fca5a5;
    border-radius:var(--r-md); padding:8px 12px;
  }
  .cm-voice-bar.visible { display:flex; }
  .cm-voice-dot {
    width:8px; height:8px; border-radius:50%;
    background:#ef4444; flex-shrink:0;
    animation:vPulse 1s ease-in-out infinite;
  }
  @keyframes vPulse { 0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.3)} }
  .cm-voice-timer { font-size:.84rem; font-weight:700; color:#dc2626; min-width:38px; }
  .cm-voice-wave { flex:1; height:24px; display:flex; align-items:center; gap:2px; }
  .cm-voice-wave span {
    flex:1; background:#fca5a5; border-radius:99px;
    animation:waveBar .8s ease-in-out infinite;
  }
  .cm-voice-wave span:nth-child(2){animation-delay:.1s}
  .cm-voice-wave span:nth-child(3){animation-delay:.2s}
  .cm-voice-wave span:nth-child(4){animation-delay:.3s}
  .cm-voice-wave span:nth-child(5){animation-delay:.2s}
  .cm-voice-wave span:nth-child(6){animation-delay:.1s}
  @keyframes waveBar { 0%,100%{height:3px}50%{height:18px} }
  .cm-voice-cancel {
    background:none; border:none; cursor:pointer; color:#dc2626;
    font-size:.74rem; font-weight:700; padding:3px 8px;
    border-radius:var(--r-sm); font-family:'DM Sans',sans-serif;
  }
  .cm-voice-cancel:hover { background:#fee2e2; }
  .cm-voice-send {
    background:#ef4444; border:none; cursor:pointer; color:#fff;
    font-size:.74rem; font-weight:700; padding:5px 12px;
    border-radius:var(--r-sm); display:flex; align-items:center; gap:5px;
    font-family:'DM Sans',sans-serif;
  }
  .cm-voice-send:hover { background:#dc2626; }
  .cm-voice-send svg { width:11px; height:11px; stroke:currentColor; fill:none; stroke-width:2; }

  /* Input row */
  .cm-input-row {
    display:flex; align-items:flex-end; gap:6px;
    background:var(--bg); border:1.5px solid var(--border);
    border-radius:24px; padding:7px 7px 7px 14px;
    transition:border-color .2s, box-shadow .2s;
  }
  .cm-input-row:focus-within {
    border-color:var(--g3); box-shadow:var(--shadow-glow); background:var(--surface);
  }
  .cm-input {
    flex:1; min-height:22px; max-height:120px; overflow-y:auto; outline:none;
    font-family:'DM Sans',sans-serif; font-size:.86rem; color:var(--text);
    line-height:1.45; word-break:break-word; background:transparent;
  }
  .cm-input:empty::before { content:attr(data-placeholder); color:var(--text-muted); pointer-events:none; }
  .cm-input-actions { display:flex; align-items:center; gap:1px; flex-shrink:0; }
  .cm-tool-btn {
    width:32px; height:32px; border-radius:50%; background:transparent;
    border:none; cursor:pointer; display:flex; align-items:center;
    justify-content:center; color:var(--text-sec); font-size:.92rem;
    transition:all .18s var(--ease-spring);
  }
  .cm-tool-btn svg { width:17px; height:17px; stroke:currentColor; fill:none; stroke-width:2; }
  .cm-tool-btn:hover { background:var(--g-pale); color:var(--g2); transform:scale(1.1); }
  .cm-tool-btn.recording { color:#ef4444; background:#fee2e2; }
  .cm-send-btn {
    width:36px; height:36px; border-radius:50%;
    background:linear-gradient(135deg,var(--g2),var(--g3));
    border:none; cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    color:#fff; flex-shrink:0;
    box-shadow:0 4px 12px rgba(45,158,107,.3);
    transition:all .22s var(--ease-spring);
  }
  .cm-send-btn:disabled { opacity:.3; cursor:not-allowed; transform:none !important; box-shadow:none; }
  .cm-send-btn:not(:disabled):hover { transform:scale(1.12) rotate(-8deg); box-shadow:0 8px 20px rgba(45,158,107,.4); }
  .cm-send-btn svg { width:15px; height:15px; stroke:currentColor; fill:none; stroke-width:2.3; }

  .cm-char-count { font-size:.66rem; color:var(--text-sec); text-align:right; height:0; overflow:hidden; transition:height .2s; }
  .cm-char-count.visible { height:16px; }
  .cm-char-count.warn { color:#e65100; }
  .cm-char-count.error { color:#dc2626; font-weight:700; }

  /* Lightbox */
  .lightbox {
    display:none; position:fixed; inset:0; z-index:9998;
    background:rgba(0,0,0,.92); align-items:center; justify-content:center; cursor:zoom-out;
  }
  .lightbox.open { display:flex; animation:fadeIn .2s; }
  @keyframes fadeIn { from{opacity:0}to{opacity:1} }
  .lightbox img { max-width:90vw; max-height:90vh; border-radius:var(--r-md); object-fit:contain; }
  .lightbox-close {
    position:absolute; top:18px; right:22px; width:38px; height:38px;
    border-radius:50%; background:rgba(255,255,255,.12); border:none;
    cursor:pointer; display:flex; align-items:center; justify-content:center;
    color:#fff; font-size:1.3rem; transition:background .18s;
  }
  .lightbox-close:hover { background:rgba(255,255,255,.25); }

  /* ════════════════════════════════
     FOOTER
  ════════════════════════════════ */
  .footer {
    background:linear-gradient(160deg,#0a1f12 0%,#1B4332 60%,#131f2e 100%);
    padding:56px 48px 28px; position:relative; overflow:hidden; flex-shrink:0;
  }
  .footer::before {
    content:''; position:absolute; inset:0; pointer-events:none;
    background:
      radial-gradient(ellipse 60% 50% at 80% 110%,rgba(45,158,107,.12) 0%,transparent 60%),
      radial-gradient(ellipse 40% 30% at 10% -10%,rgba(124,77,255,.08) 0%,transparent 55%);
  }
  .footer-inner { max-width:1200px; margin:0 auto; position:relative; z-index:1; }
  .footer-top { display:grid; grid-template-columns:2fr 1fr 1fr 1fr; gap:44px; margin-bottom:44px; }
  .footer-brand-name { font-family:'DM Serif Display',serif; font-size:1.3rem; color:#fff; }
  .footer-brand-sub { font-size:.58rem; color:rgba(255,255,255,.4); letter-spacing:1.2px; text-transform:uppercase; font-weight:600; }
  .footer-tagline { font-size:.82rem; color:rgba(255,255,255,.45); line-height:1.72; margin-top:12px; max-width:260px; }
  .footer-socials { display:flex; gap:8px; margin-top:18px; }
  .f-social {
    width:34px; height:34px; border-radius:var(--r-sm);
    background:rgba(255,255,255,.07); border:1px solid rgba(255,255,255,.1);
    display:grid; place-items:center; text-decoration:none;
    transition:all .28s var(--ease-spring);
  }
  .f-social:hover { background:var(--g2); border-color:var(--g2); transform:translateY(-3px) scale(1.1); }
  .f-social svg { width:15px; height:15px; stroke:rgba(255,255,255,.55); fill:none; stroke-width:1.8; }
  .footer-col-title { font-size:.7rem; font-weight:700; letter-spacing:1.2px; text-transform:uppercase; color:rgba(255,255,255,.85); margin-bottom:14px; }
  .footer-link { display:block; font-size:.82rem; color:rgba(255,255,255,.45); text-decoration:none; padding:4px 0; transition:color .2s,transform .2s; }
  .footer-link:hover { color:#fff; transform:translateX(4px); }
  .footer-bottom { border-top:1px solid rgba(255,255,255,.07); padding-top:22px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px; }
  .footer-copy { font-size:.75rem; color:rgba(255,255,255,.28); }
  .footer-heart { font-size:.7rem; color:rgba(255,255,255,.28); }
  .footer-heart span { color:var(--g3); }

  /* ════════════════════════════════
     RESPONSIVE
  ════════════════════════════════ */
  @media(max-width:768px) {
    .chat-page-inner { padding:8px 8px 0; height:calc(100svh - 60px); }
    .cs { width:100%; position:absolute; inset:0; z-index:5; transition:transform .3s var(--ease); }
    .cm { position:absolute; inset:0; transform:translateX(100%); transition:transform .3s var(--ease); }
    .chat-shell { position:relative; overflow:hidden; border-radius:16px 16px 0 0; }
    .chat-shell.conv-open .cs { transform:translateX(-100%); }
    .chat-shell.conv-open .cm { transform:translateX(0); }
    .cm-back-btn { display:flex !important; }
    .footer-top { grid-template-columns:1fr 1fr; }
    .nav { padding:0 14px; }
    .nav-links { display:none; }
  }
  @media(max-width:480px) {
    .footer { padding:36px 20px 22px; }
    .footer-top { grid-template-columns:1fr; gap:20px; }
  }
  </style>
</head>
<body>

{% set user      = app.user %}
{% set roleRaw   = user.roleUtilisateur %}
{% set roleSlug  = roleRaw|replace({'ROLE_': ''})|lower %}
{% set roleLabel = {'patient':'Patient','medecin':'Médecin','coach':'Coach','psychologue':'Psychologue','user':'Utilisateur','admin':'Admin'}[roleSlug] ?? (roleSlug|capitalize) %}
{% set roleEmoji = {'patient':'🧠','medecin':'🩺','coach':'💪','psychologue':'🧘','user':'👤','admin':'🛡️'}[roleSlug] ?? '👤' %}

{# ══ NAVBAR ══ #}
<nav class="nav" id="main-nav">
  <a href="{{ path('app_home') }}" class="nav-brand">
    <div class="nav-brand-img-wrap">
      <img src="{{ asset('images/logo.png') }}" alt="MindAura" class="nav-brand-img"/>
    </div>
    <div class="nav-brand-name">MindAura</div>
  </a>
