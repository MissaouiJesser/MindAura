<script>
(function(){
'use strict';

/* ══ DOM ══ */
var shell        = document.getElementById('chatShell');
var csSearchIn   = document.getElementById('csSearchInput');
var csSearchRes  = document.getElementById('csSearchResults');
var csList       = document.getElementById('csList');
var csEmpty      = document.getElementById('csEmpty');
var csNewBtn     = document.getElementById('csNewBtn');
var cmEmpty      = document.getElementById('cmEmpty');
var cmNewBtn     = document.getElementById('cmNewBtn');
var cmHeader     = document.getElementById('cmHeader');
var cmHeaderAva  = document.getElementById('cmHeaderAva');
var cmHeaderName = document.getElementById('cmHeaderName');
var cmScrollWrap = document.getElementById('cmScrollWrap');
var cmScroll     = document.getElementById('cmScroll');
var cmLoadingMore= document.getElementById('cmLoadingMore');
var cmInputBar   = document.getElementById('cmInputBar');
var cmInput      = document.getElementById('cmInput');
var cmSendBtn    = document.getElementById('cmSendBtn');
var cmCharCount  = document.getElementById('cmCharCount');
var cmBackBtn    = document.getElementById('cmBackBtn');
var cmProfileBtn = document.getElementById('cmProfileBtn');
var cmEmojiBtn   = document.getElementById('cmEmojiBtn');
var emojiPicker  = document.getElementById('emojiPicker');
var cmImageBtn   = document.getElementById('cmImageBtn');
var cmImageInput = document.getElementById('cmImageInput');
var cmVoiceBtn   = document.getElementById('cmVoiceBtn');
var cmFilePreview= document.getElementById('cmFilePreview');
var cmFileThumb  = document.getElementById('cmFileThumb');
var cmFileName   = document.getElementById('cmFileName');
var cmFileSize   = document.getElementById('cmFileSize');
var cmFileRemove = document.getElementById('cmFileRemove');
var cmVoiceBar   = document.getElementById('cmVoiceBar');
var cmVoiceTimer = document.getElementById('cmVoiceTimer');
var cmVoiceCancel= document.getElementById('cmVoiceCancel');
var cmVoiceSend  = document.getElementById('cmVoiceSend');
var lightbox     = document.getElementById('lightbox');
var lightboxImg  = document.getElementById('lightboxImg');
var lightboxClose= document.getElementById('lightboxClose');
var msgCtxOverlay= document.getElementById('msgCtxOverlay');
var msgCtxMenu   = document.getElementById('msgCtxMenu');
var ctxReactBar  = document.getElementById('ctxReactionsBar');
var ctxEdit      = document.getElementById('ctxEdit');
var ctxDelete    = document.getElementById('ctxDelete');
var tabs         = document.querySelectorAll('.cs-tab');

/* ══ URLs ══ */
var URL_CONV      = '{{ path('app_chat_conversations') }}';
var URL_MSG       = '{{ path('app_chat_messages', {'userId': 0}) }}'.replace('/0', '/');
var URL_SEND      = '{{ path('app_chat_send') }}';
var URL_SEND_FILE = '{{ path('app_chat_send_file') }}';
var URL_REACT     = '{{ path('app_chat_react') }}';
var URL_DELETE    = '{{ path('app_chat_delete_msg') }}';
var URL_EDIT      = '{{ path('app_chat_edit_msg') }}';
var URL_SEARCH    = '{{ path('app_chat_users_search') }}';
var AVATAR_BASE   = '{{ asset('avatars/') }}';

/* ══ État ══ */
var currentUser  = null;
var allConvs     = [];
var filterMode   = 'all';
var lastMsgIds   = '';
var searchTimer  = null;
var MAX_LEN      = 1000;
var pendingFile  = null;
var mediaRec     = null;
var activeStream = null;
var audioChunks  = [];
var voiceTimer   = null;
var voiceSec     = 0;

/* Infinite scroll state */
var allMessages     = [];   /* all msgs from server */
var visibleStart    = 0;    /* index into allMessages of first rendered msg */
var PAGE_SIZE       = 25;   /* msgs to load per page */
var isLoadingMore   = false;

/* Context menu */
var ctxMsgId  = null;
var ctxIsMine = false;

/* ══ HELPERS ══ */
function esc(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function avatarHtml(a,n){
  var i=(n||'?').charAt(0).toUpperCase();
  if(a&&a!=='default.png'&&a!=='') return '<img src="'+AVATAR_BASE+esc(a)+'" alt="'+esc(n)+'" onerror="this.style.display=\'none\'" style="width:100%;height:100%;object-fit:cover;display:block"/>';
  return '<span>'+i+'</span>';
}
function roleFr(r){ return ({ROLE_PATIENT:'Patient',ROLE_PSYCHOLOGUE:'Psychologue',ROLE_COACH:'Coach',ROLE_ADMIN:'Admin',ROLE_USER:'Utilisateur'})[r]||(r||'').replace('ROLE_',''); }
function roleChip(r){ var s=(r||'').replace('ROLE_','').toLowerCase(); return '<span class="cs-role-chip '+esc(s)+'">'+esc(roleFr(r))+'</span>'; }
function todayStr(){ return new Date().toLocaleDateString('fr-FR',{day:'2-digit',month:'2-digit',year:'numeric'}); }
function fmtSize(b){ if(b<1024)return b+' o'; if(b<1048576)return (b/1024).toFixed(1)+' Ko'; return (b/1048576).toFixed(1)+' Mo'; }
function fmtDur(s){ s=Math.floor(s||0); return Math.floor(s/60)+':'+(s%60<10?'0':'')+s%60; }
function scrollBottom(force){
  if(force){ cmScroll.scrollTop=cmScroll.scrollHeight; return; }
  if(isAtBottom()) cmScroll.scrollTop=cmScroll.scrollHeight;
}
function isAtBottom(){ return cmScroll.scrollHeight - cmScroll.scrollTop - cmScroll.clientHeight < 100; }
function isAtTop(){ return cmScroll.scrollTop < 60; }

/* ══ NAVBAR ══ */
var nav=document.getElementById('main-nav');
if(nav) window.addEventListener('scroll',function(){ nav.classList.toggle('scrolled',window.scrollY>20); },{passive:true});
var pillBtn=document.getElementById('userPillBtn'), dropdown=document.getElementById('userDropdown');
if(pillBtn&&dropdown){
  pillBtn.addEventListener('click',function(e){ e.stopPropagation(); var o=dropdown.classList.toggle('open'); pillBtn.setAttribute('aria-expanded',o); });
  document.addEventListener('click',function(){ dropdown.classList.remove('open'); pillBtn.setAttribute('aria-expanded','false'); });
}

/* ══ CONVERSATIONS ══ */
function loadConversations(){
  fetch(URL_CONV,{credentials:'same-origin'})
    .then(function(r){return r.json();})
    .then(function(d){ allConvs=d; applyFilter(); })
    .catch(function(){});
}
function applyFilter(){
  var list=filterMode==='unread'?allConvs.filter(function(c){return c.unread>0;}):allConvs;
  renderConversations(list);
}
function renderConversations(list){
  Array.from(csList.querySelectorAll('.cs-item')).forEach(function(el){el.remove();});
  if(!list.length){csEmpty.style.display='';return;}
  csEmpty.style.display='none';
  list.forEach(function(conv){
    var el=document.createElement('div');
    el.className='cs-item'+(currentUser&&currentUser.userId===conv.userId?' active':'');
    el.dataset.userId=conv.userId;
    var snippet=conv.lastMessage;
    if(snippet&&snippet.charAt(0)==='{'){try{var p=JSON.parse(snippet);snippet=p.type==='image'?'📷 Image':p.type==='audio'?'🎤 Vocal':'📎 Fichier';}catch(e){}}
    el.innerHTML=
      '<div class="cs-ava">'+avatarHtml(conv.avatar,conv.name)+'<div class="cs-online-dot"></div></div>'+
      '<div class="cs-meta"><div class="cs-name">'+esc(conv.name)+roleChip(conv.role)+'</div>'+
      '<div class="cs-snippet">'+(conv.isMine?'<span class="cs-snippet-mine">Vous : </span>':'')+esc(snippet)+'</div></div>'+
      '<div class="cs-aside"><div class="cs-time">'+esc(conv.lastTime)+'</div>'+
      (conv.unread>0?'<div class="cs-badge">'+conv.unread+'</div>':'')+'</div>';
    el.addEventListener('click',function(){ openConv({userId:conv.userId,name:conv.name,avatar:conv.avatar,role:conv.role}); });
    csList.appendChild(el);
  });
}

/* ══ OUVRIR CONVERSATION ══ */
function openConv(user){
  currentUser=user;
  Array.from(csList.querySelectorAll('.cs-item')).forEach(function(el){ el.classList.toggle('active',parseInt(el.dataset.userId)===user.userId); });
  cmEmpty.style.display='none';
  cmHeader.classList.add('visible');
  cmScrollWrap.classList.add('visible');
  cmInputBar.classList.add('visible');
  shell.classList.add('conv-open');
  cmHeaderAva.innerHTML=avatarHtml(user.avatar,user.name);
  cmHeaderName.textContent=user.name;
  lastMsgIds='';
  allMessages=[]; visibleStart=0; isLoadingMore=false;
  loadMessages(user.userId,false);
  cmInput.focus();
  if(cmProfileBtn) cmProfileBtn.onclick=function(){ window.location.href='/utilisateurs/'+user.userId; };
}

/* ══ INFINITE SCROLL — load messages ══ */
function loadMessages(userId,silent){
  if(!silent){
    cmScroll.innerHTML='<div class="msg-typing" style="margin-left:34px"><span></span><span></span><span></span></div>';
    cmLoadingMore.classList.remove('visible');
  }
  fetch(URL_MSG+userId,{credentials:'same-origin'})
    .then(function(r){return r.json();})
    .then(function(d){
      if(!d.messages) return;
      var newIds=d.messages.map(function(m){return m.id+'|'+(m.reactions?m.reactions.length:0);}).join(',');
      if(silent && newIds===lastMsgIds) return;
      var prevIds=lastMsgIds;
      lastMsgIds=newIds;
      var wasAtBottom=isAtBottom();

      if(!silent){
        allMessages=d.messages;
        /* Show last PAGE_SIZE messages initially */
        visibleStart=Math.max(0, allMessages.length - PAGE_SIZE);
        renderMessages(allMessages.slice(visibleStart));
        scrollBottom(true);
      } else {
        /* Polling: check for new messages at end */
        var prevLen=allMessages.length;
        allMessages=d.messages;
        if(allMessages.length > prevLen){
          /* New messages arrived — append them */
          var newMsgs=allMessages.slice(prevLen);
          appendMessages(newMsgs, prevLen);
          if(wasAtBottom) scrollBottom(true);
        } else if(newIds!==prevIds){
          /* Reactions changed — full re-render of visible slice */
          renderMessages(allMessages.slice(visibleStart));
          if(wasAtBottom) scrollBottom(true);
        }
        loadConversations();
      }
    }).catch(function(){});
}

/* Load older messages when scrolling to top */
function loadOlderMessages(){
  if(isLoadingMore || visibleStart===0) return;
  isLoadingMore=true;
  cmLoadingMore.classList.add('visible');
  var prevScrollH=cmScroll.scrollHeight;

  setTimeout(function(){
    var newStart=Math.max(0, visibleStart - PAGE_SIZE);
    var olderMsgs=allMessages.slice(newStart, visibleStart);
    visibleStart=newStart;
    prependMessages(olderMsgs);
    /* Restore scroll position so user stays at same place */
    cmScroll.scrollTop=cmScroll.scrollHeight - prevScrollH;
    cmLoadingMore.classList.remove('visible');
    isLoadingMore=false;
  }, 400);
}

/* Infinite scroll trigger */
cmScroll.addEventListener('scroll',function(){
  if(isAtTop()) loadOlderMessages();
},{ passive:true });

/* ══ BUILD BUBBLE HTML ══ */
function buildBubble(msg){
  if(msg.type==='image'){
    return '<div class="msg-bubble" style="padding:4px;background:transparent;border:none;box-shadow:none"><img class="msg-image" src="'+esc(msg.fileUrl)+'" alt="image" loading="lazy"/></div>';
  }
  if(msg.type==='audio'){
    var src=msg.fileUrl||'';
    if(!src){
      return '<div class="msg-bubble"><em style="opacity:.6;font-size:.8rem">🎤 Message vocal (URL manquante)</em></div>';
    }
    return '<div class="msg-bubble" style="padding:0;background:transparent;border:none;box-shadow:none"><div class="msg-audio" data-src="'+esc(src)+'">'+
      '<button class="msg-audio-play" type="button"><svg viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg></button>'+
      '<div class="msg-audio-track"><div class="msg-audio-bar"><div class="msg-audio-progress"></div></div><div class="msg-audio-dur">0:00</div></div>'+
    '</div></div>';
  }
  return '<div class="msg-bubble">'+esc(msg.content||'')+'</div>';
}

function buildReactHtml(msg){
  if(!msg.reactions||!msg.reactions.length) return '';
  var rmap={};
  msg.reactions.forEach(function(r){ rmap[r.emoji]=(rmap[r.emoji]||0)+1; });
  var h='<div class="msg-reactions">';
  Object.keys(rmap).forEach(function(e){ h+='<div class="msg-reaction-chip" data-emoji="'+esc(e)+'">'+e+'<span>'+rmap[e]+'</span></div>'; });
  return h+'</div>';
}

function buildEditHtml(msg){
  if(msg.type!=='text') return '';
  return '<div class="msg-edit-area" id="edit_'+msg.id+'">'+
    '<textarea class="msg-edit-input" rows="2">'+esc(msg.content||'')+'</textarea>'+
    '<div class="msg-edit-btns">'+
      '<button class="msg-edit-save" data-id="'+msg.id+'">Enregistrer</button>'+
      '<button class="msg-edit-cancel" data-id="'+msg.id+'">Annuler</button>'+
    '</div></div>';
}

function createMsgRow(msg, consec, isLast){
  var row=document.createElement('div');
  row.className='msg-row '+(msg.isMine?'mine':'other')+(consec?' consecutive':'');
  row.dataset.msgId=msg.id;
  row.dataset.isMine=msg.isMine?'1':'0';
  row.dataset.type=msg.type||'text';
  row.dataset.content=msg.content||'';

  row.innerHTML=
    '<div class="msg-ava">'+avatarHtml(msg.avatar,msg.senderName)+'</div>'+
    '<div class="msg-body">'+
      '<div class="msg-sender-name">'+esc(msg.senderName)+'</div>'+
      buildBubble(msg)+
      buildEditHtml(msg)+
      buildReactHtml(msg)+
      (isLast?'<div class="msg-time">'+esc(msg.time)+(msg.isMine?'<span class="msg-status"><svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg></span>':'')+'</div>':'')+
    '</div>';

  /* Click anywhere on row → open context menu */
  row.addEventListener('click',function(e){
    if(e.target.closest('.msg-edit-area')) return; /* ignore clicks inside edit */
    if(e.target.closest('.msg-reaction-chip')){ /* react chip click = toggle */
      var chip=e.target.closest('.msg-reaction-chip');
      sendReaction(parseInt(row.dataset.msgId),chip.dataset.emoji);
      return;
    }
    if(e.target.closest('.msg-image')){ return; } /* let lightbox handle */
    if(e.target.closest('.msg-audio-play')){ return; }
    openCtxMenu(e, parseInt(row.dataset.msgId), msg.isMine, msg.type||'text');
  });

  return row;
}

/* ══ RENDER FULL LIST ══ */
function renderMessages(msgs){
  cmScroll.innerHTML='';
  if(!msgs.length){
    cmScroll.innerHTML='<div style="text-align:center;padding:56px 20px;color:var(--text-muted);font-size:.86rem">✉️ Soyez le premier à envoyer un message</div>';
    return;
  }
  var lastDate=null,lastIsMine=null,groupCount=0;
  msgs.forEach(function(msg,idx){
    var next=msgs[idx+1];
    if(msg.date!==lastDate){
      lastDate=msg.date; lastIsMine=null; groupCount=0;
      var sep=document.createElement('div'); sep.className='msg-date-sep';
      sep.innerHTML='<span>'+(msg.date===todayStr()?"Aujourd'hui":esc(msg.date))+'</span>';
      cmScroll.appendChild(sep);
    }
    var consec=(lastIsMine===msg.isMine&&groupCount<6);
    lastIsMine=msg.isMine; groupCount=consec?groupCount+1:1;
    var isLast=!next||next.isMine!==msg.isMine||next.date!==msg.date;
    cmScroll.appendChild(createMsgRow(msg,consec,isLast));
  });
  bindMediaPlayers();
  bindReactionChips();
}

/* ══ PREPEND old messages (infinite scroll up) ══ */
function prependMessages(msgs){
  if(!msgs.length) return;
  var frag=document.createDocumentFragment();
  var lastDate=null,lastIsMine=null,groupCount=0;
  msgs.forEach(function(msg,idx){
    var next=msgs[idx+1];
    if(msg.date!==lastDate){
      lastDate=msg.date; lastIsMine=null; groupCount=0;
      var sep=document.createElement('div'); sep.className='msg-date-sep';
      sep.innerHTML='<span>'+(msg.date===todayStr()?"Aujourd'hui":esc(msg.date))+'</span>';
      frag.appendChild(sep);
    }
    var consec=(lastIsMine===msg.isMine&&groupCount<6);
    lastIsMine=msg.isMine; groupCount=consec?groupCount+1:1;
    var isLast=!next||next.isMine!==msg.isMine||next.date!==msg.date;
    frag.appendChild(createMsgRow(msg,consec,isLast));
  });
  cmScroll.insertBefore(frag, cmScroll.firstChild);
  bindMediaPlayers();
  bindReactionChips();
}

/* ══ APPEND new messages at bottom ══ */
function appendMessages(msgs, startIdx){
  var lastRow=cmScroll.querySelector('.msg-row:last-child');
  var lastDate=lastRow?lastRow.querySelector('.msg-date-sep')?null:null:null;
  /* Get last visible date/isMine from DOM */
  var allRows=cmScroll.querySelectorAll('.msg-row');
  var prevMsg=allRows.length?{isMine:allRows[allRows.length-1].dataset.isMine==='1',date:null}:null;
  var prevDate=null;
  var dateSeps=cmScroll.querySelectorAll('.msg-date-sep');
  if(dateSeps.length) prevDate=dateSeps[dateSeps.length-1].textContent.trim();

  msgs.forEach(function(msg,idx){
    var next=msgs[idx+1];
    /* Add date sep if new day */
    var dateLabel=msg.date===todayStr()?"Aujourd'hui":msg.date;
    if(dateLabel!==prevDate){
      prevDate=dateLabel;
      var sep=document.createElement('div'); sep.className='msg-date-sep';
      sep.innerHTML='<span>'+esc(dateLabel)+'</span>';
      cmScroll.appendChild(sep);
    }
    var consec=prevMsg&&prevMsg.isMine===msg.isMine;
    prevMsg={isMine:msg.isMine};
    var isLast=!next||next.isMine!==msg.isMine||next.date!==msg.date;
    cmScroll.appendChild(createMsgRow(msg,consec,isLast));
  });
  bindMediaPlayers();
  bindReactionChips();
}

/* ══ MEDIA BIND ══ */
function bindMediaPlayers(){
  cmScroll.querySelectorAll('.msg-audio-play').forEach(function(btn){
    if(btn._bound) return; btn._bound=true;
    bindAudioPlayer(btn);
  });
  cmScroll.querySelectorAll('.msg-image').forEach(function(img){
    if(img._bound) return; img._bound=true;
    img.addEventListener('click',function(e){ e.stopPropagation(); openLightbox(img.src); });
  });
}
function bindReactionChips(){
  cmScroll.querySelectorAll('.msg-reaction-chip').forEach(function(chip){
    if(chip._bound) return; chip._bound=true;
    chip.addEventListener('click',function(e){
      e.stopPropagation();
      var row=chip.closest('.msg-row');
      if(row) sendReaction(parseInt(row.dataset.msgId),chip.dataset.emoji);
    });
  });
}

/* ══ AUDIO PLAYER ══ */
function bindAudioPlayer(btn){
  var wrap=btn.closest('.msg-audio'); if(!wrap) return;
  var src=wrap.dataset.src;
  var prog=wrap.querySelector('.msg-audio-progress');
  var dur=wrap.querySelector('.msg-audio-dur');
  var audio=new Audio(src);
  var playIcon='<svg viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg>';
  var pauseIcon='<svg viewBox="0 0 24 24"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>';
  audio.addEventListener('loadedmetadata',function(){ dur.textContent=fmtDur(audio.duration); });
  audio.addEventListener('timeupdate',function(){
    if(audio.duration) prog.style.width=(audio.currentTime/audio.duration*100)+'%';
    dur.textContent=fmtDur(audio.currentTime);
  });
  audio.addEventListener('ended',function(){ btn.innerHTML=playIcon; prog.style.width='0%'; if(audio.duration) dur.textContent=fmtDur(audio.duration); });
  btn.addEventListener('click',function(e){ e.stopPropagation(); if(audio.paused){audio.play();btn.innerHTML=pauseIcon;}else{audio.pause();btn.innerHTML=playIcon;} });
  wrap.querySelector('.msg-audio-bar').addEventListener('click',function(e){
    e.stopPropagation();
    if(!audio.duration) return;
    var r=this.getBoundingClientRect();
    audio.currentTime=((e.clientX-r.left)/r.width)*audio.duration;
  });
}

/* ══ LIGHTBOX ══ */
function openLightbox(src){ lightboxImg.src=src; lightbox.classList.add('open'); }
lightbox.addEventListener('click',function(){ lightbox.classList.remove('open'); });
if(lightboxClose) lightboxClose.addEventListener('click',function(){ lightbox.classList.remove('open'); });

/* ════════════════════════════════════════
   CONTEXT MENU — click on message
   Fixes: no hover tricks, pure click
════════════════════════════════════════ */
var REACT_EMOJIS=['❤️','😂','👍','😮','😢','🔥','🎉','👏'];

function openCtxMenu(e, msgId, isMine, type){
  ctxMsgId=msgId;
  ctxIsMine=isMine;

  /* Build reaction bar */
  ctxReactBar.innerHTML='';
  REACT_EMOJIS.forEach(function(em){
    var b=document.createElement('button');
    b.className='msg-react-emoji'; b.textContent=em;
    b.addEventListener('click',function(ev){
      ev.stopPropagation();
      sendReaction(ctxMsgId,em);
      closeCtx();
    });
    ctxReactBar.appendChild(b);
  });

  /* Show/hide edit & delete */
  ctxEdit.style.display=(isMine&&type==='text')?'flex':'none';
  ctxDelete.style.display=isMine?'flex':'none';

  /* Position menu near click */
  var menuW=210, menuH=180;
  var x=e.clientX, y=e.clientY;
  if(x+menuW>window.innerWidth) x=window.innerWidth-menuW-12;
  if(y+menuH>window.innerHeight) y=y-menuH-8;
  else y=y+8;

  msgCtxMenu.style.left=x+'px';
  msgCtxMenu.style.top=y+'px';
  msgCtxMenu.classList.add('open');
  msgCtxOverlay.classList.add('open');
}

function closeCtx(){
  msgCtxMenu.classList.remove('open');
  msgCtxOverlay.classList.remove('open');
}

/* Close on overlay click */
msgCtxOverlay.addEventListener('click', closeCtx);
/* Prevent menu clicks from bubbling to overlay */
msgCtxMenu.addEventListener('click',function(e){ e.stopPropagation(); });

/* ── Réaction ── */
function sendReaction(msgId,emoji){
  fetch(URL_REACT,{method:'POST',credentials:'same-origin',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({messageId:msgId,emoji:emoji})})
  .then(function(r){ return r.json(); })
  .then(function(d){
    if(d.ok && currentUser) loadMessages(currentUser.userId,true);
  })
  .catch(function(){});
}

/* ── Supprimer ── */
ctxDelete.addEventListener('click',function(){
  if(!ctxMsgId) return;
  closeCtx();
  if(!confirm('Supprimer ce message ?')) return;
  fetch(URL_DELETE,{method:'POST',credentials:'same-origin',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({messageId:ctxMsgId})})
  .then(function(){ lastMsgIds=''; loadMessages(currentUser.userId,false); loadConversations(); })
  .catch(function(){});
});

/* ── Modifier ── */
ctxEdit.addEventListener('click',function(){
  if(!ctxMsgId) return;
  closeCtx();
  var targetRow=cmScroll.querySelector('[data-msg-id="'+ctxMsgId+'"]');
  if(!targetRow) return;
  var editArea=document.getElementById('edit_'+ctxMsgId);
  if(editArea){ editArea.classList.add('open'); }
  var bubble=targetRow.querySelector('.msg-bubble');
  if(bubble) bubble.style.display='none';
  var ta=editArea?editArea.querySelector('textarea'):null;
  if(ta){ ta.focus(); ta.select(); }
});

function saveEdit(msgId){
  var editArea=document.getElementById('edit_'+msgId); if(!editArea) return;
  var ta=editArea.querySelector('textarea');
  var newContent=(ta?ta.value:'').trim();
  if(!newContent) return;
  fetch(URL_EDIT,{method:'POST',credentials:'same-origin',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({messageId:msgId,content:newContent})})
  .then(function(){ lastMsgIds=''; loadMessages(currentUser.userId,false); })
  .catch(function(){});
}
function cancelEdit(msgId){
  var editArea=document.getElementById('edit_'+msgId); if(!editArea) return;
  editArea.classList.remove('open');
  var targetRow=cmScroll.querySelector('[data-msg-id="'+msgId+'"]');
  if(targetRow){
    var bubble=targetRow.querySelector('.msg-bubble');
    if(bubble) bubble.style.display='';
  }
}

/* Event delegation for edit save/cancel */
cmScroll.addEventListener('click',function(e){
  var saveBtn=e.target.closest('.msg-edit-save');
  if(saveBtn){ saveEdit(parseInt(saveBtn.dataset.id)); return; }
  var cancelBtn=e.target.closest('.msg-edit-cancel');
  if(cancelBtn){ cancelEdit(parseInt(cancelBtn.dataset.id)); return; }
});

/* ══ ENVOI TEXTE ══ */
function sendMessage(){
  var content=cmInput.innerText.trim();
  if((!content&&!pendingFile)||!currentUser) return;
  if(content.length>MAX_LEN) return;
  if(pendingFile){sendFile();return;}
  cmInput.innerText=''; cmSendBtn.disabled=true; updateCharCount('');
  fetch(URL_SEND,{method:'POST',credentials:'same-origin',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({receiverId:currentUser.userId,content:content})})
  .then(function(r){return r.json();})
  .then(function(d){ if(d.id){ lastMsgIds=''; loadMessages(currentUser.userId,false); } })
  .catch(function(){});
}
cmSendBtn.addEventListener('click',sendMessage);
cmInput.addEventListener('input',function(){ updateCharCount(cmInput.innerText.trim()); updateSendBtn(); });
cmInput.addEventListener('keydown',function(e){ if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();sendMessage();} });
function updateSendBtn(){ cmSendBtn.disabled=(cmInput.innerText.trim()===''&&!pendingFile)||cmInput.innerText.trim().length>MAX_LEN; }
function updateCharCount(t){ var l=t.length; cmCharCount.textContent=l>800?l+'/'+MAX_LEN:''; cmCharCount.classList.toggle('visible',l>800); cmCharCount.classList.toggle('warn',l>900); cmCharCount.classList.toggle('error',l>MAX_LEN); }

/* ══ ENVOI FICHIER ══ */
function sendFile(){
  if(!pendingFile||!currentUser) return;
  var fd=new FormData();
  fd.append('receiverId',currentUser.userId);
  fd.append('file',pendingFile.file);
  var cap=cmInput.innerText.trim(); if(cap) fd.append('caption',cap);
  clearPendingFile(); cmInput.innerText=''; cmSendBtn.disabled=true;
  fetch(URL_SEND_FILE,{method:'POST',credentials:'same-origin',body:fd})
    .then(function(r){return r.json();})
    .then(function(d){ if(d.id){ lastMsgIds=''; loadMessages(currentUser.userId,false); } })
    .catch(function(){});
}
function clearPendingFile(){
  pendingFile=null; cmFilePreview.classList.remove('visible');
  cmFileThumb.style.display='none'; cmFileThumb.src='';
  cmFileName.textContent=''; cmFileSize.textContent='';
  cmImageInput.value=''; updateSendBtn();
}
cmImageBtn.addEventListener('click',function(){ cmImageInput.click(); });
cmImageInput.addEventListener('change',function(){
  var f=cmImageInput.files[0]; if(!f) return;
  pendingFile={file:f,isImage:true};
  cmFileName.textContent=f.name; cmFileSize.textContent=fmtSize(f.size);
  var reader=new FileReader();
  reader.onload=function(e){ cmFileThumb.src=e.target.result; cmFileThumb.style.display='block'; };
  reader.readAsDataURL(f);
  cmFilePreview.classList.add('visible'); updateSendBtn();
});
cmFileRemove.addEventListener('click',clearPendingFile);

/* ══ VOCAL ══ */
cmVoiceBtn.addEventListener('click',function(){
  if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia){ alert('Microphone non supporté.'); return; }
  navigator.mediaDevices.getUserMedia({audio:true})
    .then(function(stream){
      activeStream=stream; audioChunks=[]; voiceSec=0;
      var mime='audio/webm';
      if(!MediaRecorder.isTypeSupported(mime)) mime=MediaRecorder.isTypeSupported('audio/ogg')?'audio/ogg':'';
      mediaRec=mime?new MediaRecorder(stream,{mimeType:mime}):new MediaRecorder(stream);
      mediaRec.ondataavailable=function(e){ if(e.data.size>0) audioChunks.push(e.data); };
      mediaRec.onstop=function(){
        if(activeStream){activeStream.getTracks().forEach(function(t){t.stop();});activeStream=null;}
        if(!audioChunks.length) return;
        var blobMime=mime||'audio/webm';
        var ext=blobMime.includes('ogg')?'ogg':'webm';
        var blob=new Blob(audioChunks,{type:blobMime}); audioChunks=[];
        sendAudioBlob(blob,ext);
      };
      mediaRec.start(100);
      cmVoiceBar.classList.add('visible'); cmVoiceBtn.classList.add('recording'); cmVoiceTimer.textContent='0:00';
      voiceTimer=setInterval(function(){
        voiceSec++; cmVoiceTimer.textContent=fmtDur(voiceSec);
        if(voiceSec>=120) stopRec(true);
      },1000);
    })
    .catch(function(err){ alert('Microphone refusé : '+(err.message||err)); });
});
function stopRec(andSend){
  clearInterval(voiceTimer); cmVoiceBtn.classList.remove('recording'); cmVoiceBar.classList.remove('visible');
  if(!andSend) audioChunks=[];
  if(mediaRec&&mediaRec.state!=='inactive') mediaRec.stop();
  else if(activeStream){activeStream.getTracks().forEach(function(t){t.stop();});activeStream=null;}
}
cmVoiceCancel.addEventListener('click',function(){stopRec(false);});
cmVoiceSend.addEventListener('click',function(){stopRec(true);});
function sendAudioBlob(blob,ext){
  if(!currentUser||blob.size===0) return;
  ext=ext||'webm';
  var fd=new FormData();
  fd.append('receiverId',currentUser.userId);
  fd.append('file',blob,'vocal_'+Date.now()+'.'+ext);
  fd.append('isAudio','1');
  fetch(URL_SEND_FILE,{method:'POST',credentials:'same-origin',body:fd})
    .then(function(r){return r.json();})
    .then(function(d){ if(d.id){ lastMsgIds=''; loadMessages(currentUser.userId,false); } })
    .catch(function(e){console.error('[Chat] sendAudio:',e);});
}

/* ══ EMOJI ══ */
window.insertEmoji=function(e){
  cmInput.focus(); document.execCommand('insertText',false,e);
  cmInput.dispatchEvent(new Event('input')); emojiPicker.style.display='none';
};
cmEmojiBtn.addEventListener('click',function(e){
  e.stopPropagation();
  if(emojiPicker.style.display==='none'){
    var r=cmEmojiBtn.getBoundingClientRect();
    emojiPicker.style.bottom=(window.innerHeight-r.top+8)+'px';
    emojiPicker.style.right=(window.innerWidth-r.right)+'px';
    emojiPicker.style.display='block';
  } else emojiPicker.style.display='none';
});
document.addEventListener('click',function(){ emojiPicker.style.display='none'; });

/* ══ RECHERCHE ══ */
csSearchIn.addEventListener('input',function(){
  clearTimeout(searchTimer);
  var q=csSearchIn.value.trim(); if(q.length<2){csSearchRes.style.display='none';return;}
  searchTimer=setTimeout(function(){
    fetch(URL_SEARCH+'?q='+encodeURIComponent(q),{credentials:'same-origin'})
      .then(function(r){return r.json();}).then(renderSearchResults).catch(function(){});
  },280);
});
csSearchIn.addEventListener('blur',function(){setTimeout(function(){csSearchRes.style.display='none';},200);});
csSearchIn.addEventListener('focus',function(){ if(csSearchIn.value.trim().length>=2&&csSearchRes.children.length) csSearchRes.style.display='block'; });
function renderSearchResults(users){
  csSearchRes.innerHTML=''; if(!users.length){csSearchRes.style.display='none';return;}
  csSearchRes.style.display='block';
  users.forEach(function(u){
    var el=document.createElement('div'); el.className='cs-search-item';
    el.innerHTML='<div class="cs-ava" style="width:36px;height:36px;font-size:.78rem;flex-shrink:0">'+avatarHtml(u.avatar,u.name)+'</div>'+
      '<div><div class="cs-search-item-name">'+esc(u.name)+'</div><div class="cs-search-item-role">'+esc(roleFr(u.role))+'</div></div>';
    el.addEventListener('click',function(){ csSearchIn.value=''; csSearchRes.style.display='none'; openConv({userId:u.userId,name:u.name,avatar:u.avatar,role:u.role}); });
    csSearchRes.appendChild(el);
  });
}

/* ══ TABS ══ */
tabs.forEach(function(tab){
  tab.addEventListener('click',function(){
    tabs.forEach(function(t){t.classList.remove('active');}); tab.classList.add('active');
    filterMode=tab.dataset.filter||'all'; applyFilter();
  });
});

/* ══ BOUTONS ══ */
if(csNewBtn) csNewBtn.addEventListener('click',function(){csSearchIn.focus();});
if(cmNewBtn) cmNewBtn.addEventListener('click',function(){csSearchIn.focus();});
if(cmBackBtn) cmBackBtn.addEventListener('click',function(){shell.classList.remove('conv-open');});

/* ══ POLLING — 8s ══ */
setInterval(function(){
  if(!currentUser){ loadConversations(); return; }
  loadMessages(currentUser.userId,true);
},8000);

/* ══ INIT ══ */
loadConversations();
var params=new URLSearchParams(window.location.search);
var initId=params.get('userId');
if(initId){
  fetch(URL_SEARCH+'?q='+encodeURIComponent(initId),{credentials:'same-origin'})
    .then(function(r){return r.json();})
    .then(function(users){
      var f=users.find(function(u){return String(u.userId)===String(initId);});
      if(f) openConv(f);
    });
}

})();
</script>
</body>
</html>
