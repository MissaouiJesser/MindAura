{# ══ TOAST ══ #}
<div class="toast" id="toast">
  <span>&#10003;</span><span id="toast-msg">Message envoyé !</span>
</div>

<script>
  /* Navbar scroll shadow */
  const nav = document.getElementById('main-nav');
  window.addEventListener('scroll', () => {
    nav.classList.toggle('scrolled', window.scrollY > 20);
  });

  /* Smooth scroll */
  document.querySelectorAll('a[href^="#"]').forEach(function(a) {
    a.addEventListener('click', function(e) {
      var href = a.getAttribute('href');
      if (href.length > 1) {
        var t = document.querySelector(href);
        if (t) { e.preventDefault(); t.scrollIntoView({behavior:'smooth', block:'start'}); }
      }
    });
  });

  /* Scroll reveal */
  var obs = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (e.isIntersecting) { e.target.classList.add('in'); obs.unobserve(e.target); }
    });
  }, { threshold: 0.1 });
  document.querySelectorAll('.sr, .sr-l, .sr-r').forEach(function(el) { obs.observe(el); });

  /* FAQ */
  function toggleFaq(btn) {
    var item = btn.closest('.faq-item');
    var isOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item.open').forEach(function(i) { i.classList.remove('open'); });
    if (!isOpen) item.classList.add('open');
  }

  /* Contact send */
  function sendMsg(btn) {
    btn.disabled = true;
    btn.textContent = 'Envoi en cours...';
    setTimeout(function() {
      btn.textContent = 'Message envoyé !';
      btn.style.background = '#22C55E';
      showToast('Votre message a bien été envoyé !');
      setTimeout(function() {
        btn.textContent = 'Envoyer le message';
        btn.style.background = '';
        btn.disabled = false;
      }, 3500);
    }, 1600);
  }

  function showToast(msg) {
    var t = document.getElementById('toast');
    document.getElementById('toast-msg').textContent = msg;
    t.classList.add('show');
    setTimeout(function() { t.classList.remove('show'); }, 4200);
  }

  /* ── User pill dropdown ── */
  (function() {
    var pillBtn  = document.getElementById('userPillBtn');
    var dropdown = document.getElementById('userDropdown');
    var wrapper  = document.getElementById('userPillWrapper');
    if (!pillBtn || !dropdown) return;

    function openDropdown() {
      dropdown.classList.add('open');
      pillBtn.setAttribute('aria-expanded', 'true');
    }
    function closeDropdown() {
      dropdown.classList.remove('open');
      pillBtn.setAttribute('aria-expanded', 'false');
    }
    function toggleDropdown() {
      dropdown.classList.contains('open') ? closeDropdown() : openDropdown();
    }

    pillBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      toggleDropdown();
    });

    /* Fermeture au clic extérieur */
    document.addEventListener('click', function(e) {
      if (!wrapper.contains(e.target)) {
        closeDropdown();
      }
    });

    /* Fermeture avec Échap */
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeDropdown();
    });
  })();
</script>
</body>
</html>
