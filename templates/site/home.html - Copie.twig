        <span class="svc-tag">Ressources</span>
      </div>
    </div>
  </div>
</section>

{# wave #}
<div class="wave" style="background:#F0F4F8">
  <svg viewBox="0 0 1440 58" preserveAspectRatio="none" fill="white" xmlns="http://www.w3.org/2000/svg">
    <path d="M0,18 C480,58 960,0 1440,28 L1440,58 L0,58 Z"/>
  </svg>
</div>

{# ══ EQUIPE ══ #}
<section class="section section-alt" id="equipe">
  <div class="section-inner">
    <div class="sec-center sr">
      <div class="sec-label">&#128101; Les développeurs</div>
      <h2 class="sec-title">Notre <span>Équipe</span></h2>
      <p class="sec-desc">
        Des passionnés du développement web réunis pour créer une expérience
        digitale au service du bien-être mental.
      </p>
    </div>

    {# — Instagram SVG path réutilisable — #}
    {# Instagram icon path: rect arrondi + cercle + point #}

    <div class="grid-team">

      {# ── Carte 1 ── #}
      <div class="team-card sr" style="transition-delay:.05s">
        <div class="team-avatar">
          <img src="{{ asset('equipe/azer.png') }}" alt="Laifi Azer"/>
          <span class="team-avatar-dot"></span>
        </div>
        <div class="team-name">Laifi Azer</div>
        <span class="team-role">Full-Stack Dev</span>
        <div class="team-bio">Spécialisé en Symfony &amp; Java, passionné par les interfaces modernes et performantes.</div>
        <div class="team-socials">
          <a href="https://www.instagram.com/laifi_azer1/" class="social-btn instagram" title="Instagram">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke-width="1.8"/>
              <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z" stroke-width="1.8"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke-width="2.5" stroke-linecap="round"/>
            </svg>
          </a>
          <a href="https://www.facebook.com/laifiazer2/" class="social-btn facebook" title="Facebook">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" stroke-width="1.8"/>
