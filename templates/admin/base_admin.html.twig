<script>
(function () {
  'use strict';
  const STORAGE_KEY = 'mindaura_sidebar_collapsed';
  const layout      = document.querySelector('.layout');
  const toggle      = document.getElementById('sidebarToggle');
  const ICON_OPEN   = '<path d="M3 5h14M3 10h14M3 15h14" stroke-linecap="round"/>';
  const ICON_CLOSED = '<path d="M13 5l-6 5 6 5" stroke-linecap="round" stroke-linejoin="round"/>';

  function applyState(collapsed, animate) {
    if (!animate) layout.style.transition = 'none';
    layout.classList.toggle('sidebar-collapsed', collapsed);
    if (!animate) requestAnimationFrame(() => { layout.style.transition = ''; });
    const icon = toggle.querySelector('svg');
    icon.innerHTML = collapsed ? ICON_CLOSED : ICON_OPEN;
    toggle.setAttribute('title', collapsed ? 'Afficher le menu' : 'Masquer le menu');
  }

  const saved = localStorage.getItem(STORAGE_KEY) === 'true';
  applyState(saved, false);

  toggle.addEventListener('click', function () {
    const isNowCollapsed = !layout.classList.contains('sidebar-collapsed');
    applyState(isNowCollapsed, true);
    localStorage.setItem(STORAGE_KEY, isNowCollapsed);
  });

  const navGroupToggles = document.querySelectorAll('.nav-group-toggle');
  const MENU_STATE_KEY = 'mindaura_menu_states';

  function loadMenuStates() {
    const saved = localStorage.getItem(MENU_STATE_KEY);
    return saved ? JSON.parse(saved) : {};
  }
  function saveMenuStates(states) {
    localStorage.setItem(MENU_STATE_KEY, JSON.stringify(states));
  }

  const menuStates = loadMenuStates();
  navGroupToggles.forEach(toggle => {
    const menuId   = toggle.dataset.toggle;
    const navGroup = toggle.closest('.nav-group');
    const isActive = navGroup && navGroup.classList.contains('active');
    if (isActive || menuStates[menuId]) {
      navGroup.classList.add('active');
      menuStates[menuId] = true;
    } else {
      menuStates[menuId] = false;
    }
    toggle.addEventListener('click', function (e) {
      e.preventDefault();
      const isActive = navGroup.classList.toggle('active');
      menuStates[menuId] = isActive;
      saveMenuStates(menuStates);
    });
  });
})();
</script>

<script>
(function () {
  'use strict';
  const loader      = document.getElementById('pageLoader');
  const mainContent = document.getElementById('mainContent');
  const breadcrumb  = document.getElementById('breadcrumb-label');

  function showLoader() { loader.classList.add('active'); }
  function hideLoader() { loader.classList.remove('active'); }

  function setActiveLink(href) {
    document.querySelectorAll('.nav-item[data-spa]').forEach(link => {
      const isActive = link.getAttribute('href') === href ||
                       link.getAttribute('href').split('?')[0] === href.split('?')[0];
      link.classList.toggle('active', isActive);
    });
  }

  function extractContent(html) {
    const parser = new DOMParser();
    const doc    = parser.parseFromString(html, 'text/html');
    const target = doc.getElementById('mainContent');
    return target ? target.innerHTML : null;
  }

  function extractTitle(html) {
    const match = html.match(/<title[^>]*>([\s\S]*?)<\/title>/i);
    return match ? match[1].trim() : document.title;
  }

  function extractBreadcrumb(html) {
    const parser = new DOMParser();
    const doc    = parser.parseFromString(html, 'text/html');
    const el     = doc.getElementById('breadcrumb-label');
    return el ? el.textContent.trim() : '';
  }

  function rehydrateScripts(container) {
    container.querySelectorAll('script').forEach(oldScript => {
      const s = document.createElement('script');
      if (oldScript.src) { s.src = oldScript.src; s.async = false; }
      else { s.textContent = oldScript.textContent; }
      oldScript.parentNode.replaceChild(s, oldScript);
    });
  }

  function animateOut(el) {
    return new Promise(resolve => {
      el.classList.add('is-leaving');
      const timer = setTimeout(() => { el.classList.remove('is-leaving'); resolve(); }, 330);
      el.addEventListener('animationend', () => { clearTimeout(timer); el.classList.remove('is-leaving'); resolve(); }, { once: true });
    });
  }

  function animateIn(el) {
    el.classList.add('is-entering');
    const timer = setTimeout(() => { el.classList.remove('is-entering'); }, 430);
    el.addEventListener('animationend', () => { clearTimeout(timer); el.classList.remove('is-entering'); }, { once: true });
  }

  async function navigate(url, pushState = true) {
    showLoader();
    mainContent.setAttribute('aria-busy', 'true');
    try {
      const [, response] = await Promise.all([
        animateOut(mainContent),
        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
      ]);
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const html = await response.text();
      const newContent = extractContent(html);
      if (newContent === null) { window.location.href = url; return; }
      mainContent.innerHTML = newContent;
      mainContent.scrollTop = 0;
      const newTitle = extractTitle(html);
      const newLabel = extractBreadcrumb(html);
      document.title = newTitle;
      if (breadcrumb && newLabel) breadcrumb.textContent = newLabel;
      setActiveLink(url);
      if (pushState) history.pushState({ url }, newTitle, url);
      rehydrateScripts(mainContent);
      animateIn(mainContent);
    } catch (err) {
      console.error('[SPA] Erreur :', err);
      window.location.href = url;
    } finally {
      hideLoader();
      mainContent.removeAttribute('aria-busy');
    }
  }

  document.addEventListener('click', function (e) {
    const link = e.target.closest('a[data-spa]');
    if (!link) return;
    if (e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
    if (link.target === '_blank') return;
    const href = link.getAttribute('href');
    if (!href || href.startsWith('#') || href.startsWith('javascript')) return;
    if (href === window.location.pathname) { e.preventDefault(); return; }
    e.preventDefault();
    navigate(href);
  });

  window.addEventListener('popstate', function (e) {
    const url = e.state?.url || window.location.pathname;
    navigate(url, false);
  });

  history.replaceState({ url: window.location.pathname }, document.title, window.location.pathname);
})();
</script>

{% block javascripts %}{% endblock %}
</body>
</html>