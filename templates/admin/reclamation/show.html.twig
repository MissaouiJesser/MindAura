{# templates/admin/reclamation/show.html.twig
   Détail d'une réclamation + réponses — Back-office
   Design harmonisé avec admin/utilisateurs/
   Fonctionnalités AJAX préservées : édition inline, ajout de réponse #}

{% extends 'base_backoffice.html.twig' %}

{% block title %}Réclamation : {{ reclamation.sujet_reclamation }}{% endblock %}
{% block page_label %}Détail réclamation{% endblock %}

{% block content %}
{% include '_partials/_admin_design_system.html.twig' %}

<style>
  /* ── Bloc réponse ── */
  .rep-block {
    background:var(--white); border:1.5px solid var(--border); border-radius:14px;
    padding:18px 22px; margin-bottom:12px;
    animation:fadeUp .4s ease both;
    box-shadow:var(--shadow-card);
    transition:border-color .2s, box-shadow .2s;
  }
  .rep-block:hover { border-color:var(--green-light); }
  .rep-block.is-admin { border-left:4px solid var(--green-light); }

  .rep-header { display:flex; justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap; }
  .rep-author { display:flex; align-items:center; gap:10px; }
  .rep-avatar {
    width:36px; height:36px; border-radius:50%;
    background:linear-gradient(135deg, var(--green), var(--green-mid));
    display:grid; place-items:center; color:#fff; font-weight:800; font-size:.78rem;
    flex-shrink:0;
  }
  .rep-meta { font-size:.74rem; color:var(--text-sec); margin-top:2px; }
  .rep-name { font-weight:700; color:var(--text); font-size:.92rem; }
  .rep-body { margin-top:12px; line-height:1.7; color:var(--text); font-size:.9rem; white-space:pre-wrap; }

  .edit-zone { display:none; margin-top:12px; }
  .edit-zone textarea {
    width:100%; padding:10px 14px; border:1.5px solid var(--border); border-radius:10px;
    font-size:.88rem; font-family:'Outfit',sans-serif; resize:vertical; min-height:80px;
    background:var(--bg); transition:border-color .2s, box-shadow .2s;
  }
  .edit-zone textarea:focus { border-color:var(--green-light); outline:none; box-shadow:0 0 0 3px rgba(82,183,136,.1); background:var(--white); }
  .edit-actions { display:flex; gap:8px; margin-top:10px; }

  .btn-edit-inline {
    display:inline-flex; align-items:center; gap:5px;
    padding:6px 12px; background:#FEF3C7; border:1.5px solid #FDE68A;
    color:#B45309; border-radius:8px; font-size:.74rem; font-weight:700;
    cursor:pointer; transition:all .2s; font-family:'Outfit',sans-serif;
  }
  .btn-edit-inline:hover { background:#FDE68A; }
  .btn-edit-inline svg { width:12px; height:12px; }

  .add-form textarea {
    width:100%; padding:12px 16px; border:1.5px solid var(--border); border-radius:12px;
    font-size:.9rem; font-family:'Outfit',sans-serif; resize:vertical; min-height:100px;
    background:var(--bg); box-sizing:border-box;
    transition:border-color .2s, box-shadow .2s, background .2s;
  }
  .add-form textarea:focus { border-color:var(--green-light); outline:none; box-shadow:0 0 0 3px rgba(82,183,136,.1); background:var(--white); }

  .reponses-empty { text-align:center; padding:40px 20px; color:var(--text-sec); font-size:.9rem; }
</style>

{# ════ HERO ═══════════════════════════════════════════════════════════ #}
<div class="ds-hero">
  <div class="ds-hero-dots"><span></span><span></span><span></span></div>
  <div class="ds-hero-body">
    <div class="ds-hero-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
      </svg>
    </div>
    <div class="ds-hero-text">
      <div class="ds-hero-title">{{ reclamation.sujet_reclamation }}</div>
      <div class="ds-hero-sub">
        <span class="ds-hero-chip">
          <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="6" cy="6" r="4.5"/><path d="M6 3v3.5L8 8" stroke-linecap="round"/></svg>
          {{ reclamation.dateCreation_reclamation ? reclamation.dateCreation_reclamation|date('d/m/Y H:i') : '—' }}
        </span>
        {% if reclamation.statut_reclamation %}
          <span class="ds-hero-chip" style="background:rgba(255,255,255,.18)">{{ reclamation.statut_reclamation }}</span>
        {% endif %}
        <span class="ds-hero-chip">
          {{ sortedReponses|length }} réponse{{ sortedReponses|length != 1 ? 's' : '' }}
        </span>
      </div>
    </div>
    <div style="display:flex;align-items:center;gap:10px;flex-shrink:0;margin-left:auto">
      <a href="{{ path('reclamation_index') }}" class="ds-btn-primary">
        <div class="ds-btn-primary-icon">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4l-6 6 6 6"/></svg>
        </div>
        Retour
      </a>
    </div>
  </div>
</div>

<div id="flash-zone"></div>

{# ════ DÉTAIL ══════════════════════════════════════════════════════ #}
<div class="ds-detail-grid">
  <div class="ds-detail-item">
    <span class="ds-detail-label">Catégorie</span>
    {% if reclamation.categorie %}
      <span class="ds-badge ds-badge-violet" style="align-self:flex-start">{{ reclamation.categorie.nom_categorie }}</span>
    {% else %}
      <span class="ds-detail-value muted">N/A</span>
    {% endif %}
  </div>

  <div class="ds-detail-item">
    <span class="ds-detail-label">Statut</span>
    {% set statut = reclamation.statut_reclamation|lower %}
    {% if statut == 'nouvelle' or statut == 'nouveau' %}
      <span class="ds-badge ds-badge-blue" style="align-self:flex-start">{{ reclamation.statut_reclamation }}</span>
    {% elseif statut == 'en cours' or statut == 'en_cours' %}
      <span class="ds-badge ds-badge-yellow" style="align-self:flex-start">{{ reclamation.statut_reclamation }}</span>
    {% elseif statut == 'résolue' or statut == 'resolue' or statut == 'fermée' or statut == 'fermee' %}
      <span class="ds-badge ds-badge-green" style="align-self:flex-start">{{ reclamation.statut_reclamation }}</span>
    {% elseif statut == 'rejetée' or statut == 'rejetee' %}
      <span class="ds-badge ds-badge-red" style="align-self:flex-start">{{ reclamation.statut_reclamation }}</span>
    {% else %}
      <span class="ds-badge ds-badge-gray" style="align-self:flex-start">{{ reclamation.statut_reclamation }}</span>
    {% endif %}
  </div>

  <div class="ds-detail-item">
    <span class="ds-detail-label">Date de création</span>
    <span class="ds-detail-value">{{ reclamation.dateCreation_reclamation ? reclamation.dateCreation_reclamation|date('d/m/Y H:i') : '—' }}</span>
  </div>

  <div class="ds-detail-item">
    <span class="ds-detail-label">Utilisateur</span>
    <span class="ds-detail-value">#{{ reclamation.id_utilisateur }}</span>
  </div>

  <div class="ds-detail-item">
    <span class="ds-detail-label">Note</span>
    <span class="ds-detail-value">
      <span style="color:#F59E0B">★</span> {{ reclamation.rate_Reclamation|default(0) }}/5
      <span class="ds-detail-value muted" style="font-size:.78rem">({{ reclamation.rate_count|default(0) }} vote{{ reclamation.rate_count > 1 ? 's' : '' }})</span>
    </span>
  </div>
</div>

{# ════ DESCRIPTION ═══════════════════════════════════════════════════ #}
<div class="ds-detail-block">
  <div class="ds-detail-block-title">
    <svg viewBox="0 0 17 17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="3" width="11" height="11" rx="2"/>
      <line x1="6" y1="7" x2="11" y2="7"/>
      <line x1="6" y1="10" x2="11" y2="10"/>
    </svg>
    Description
  </div>
  <div class="ds-detail-text">{{ reclamation.description_reclamation|nl2br }}</div>
</div>

{# ════ RÉPONSES ═══════════════════════════════════════════════════════ #}
<div class="ds-detail-block">
  <div class="ds-detail-block-title">
    <svg viewBox="0 0 17 17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 11a2 2 0 01-2 2H5l-3 3V4a2 2 0 012-2h8a2 2 0 012 2v7z"/>
    </svg>
    Réponses ({{ sortedReponses|length }})
  </div>

  {% for rep in sortedReponses %}
    {% set isAdmin = rep.id_utilisateur in adminUserIds %}
    <div class="rep-block {{ isAdmin ? 'is-admin' : '' }}" id="rep-block-{{ rep.id_reponse }}">
      <div class="rep-header">
        <div class="rep-author">
          <div class="rep-avatar">
            {% set initial = (rep.nom_utilisateur ?: ('U' ~ rep.id_utilisateur))|first|upper %}
            {{ initial }}
          </div>
          <div>
            <div class="rep-name">
              {{ rep.nom_utilisateur ?: ('Utilisateur #' ~ rep.id_utilisateur) }}
              {% if isAdmin %}
                <span class="ds-badge ds-badge-green" style="margin-left:6px">Admin</span>
              {% endif %}
            </div>
            <div class="rep-meta">{{ rep.date_reponse ? rep.date_reponse|date('d/m/Y à H:i') : '' }}</div>
          </div>
        </div>
        {% if app.user and app.user.idUtilisateur == rep.id_utilisateur %}
          <button type="button" class="btn-edit-inline" onclick="toggleRepEdit({{ rep.id_reponse }})">
            <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 2l2 2L4 10l-2.5.5L2 8z"/>
            </svg>
            Modifier
          </button>
        {% endif %}
      </div>

      <div class="rep-body" id="rep-body-{{ rep.id_reponse }}">{{ rep.contenu_reponse }}</div>

      <div class="edit-zone" id="rep-edit-{{ rep.id_reponse }}">
        <textarea id="rep-textarea-{{ rep.id_reponse }}">{{ rep.contenu_reponse }}</textarea>
        <div class="edit-actions">
          <button type="button" class="ds-btn-submit" style="padding:8px 16px;font-size:.8rem"
                  data-id="{{ rep.id_reponse }}"
                  data-url="{{ path('reclamation_show', {id: reclamation.id_reclamation}) }}"
                  onclick="saveRepEdit(this)">
            <svg viewBox="0 0 15 15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="3 8 6 11 12 4"/>
            </svg>
            Enregistrer
          </button>
          <button type="button" class="ds-btn-cancel" style="padding:8px 16px;font-size:.8rem"
                  onclick="toggleRepEdit({{ rep.id_reponse }})">
            Annuler
          </button>
        </div>
      </div>
    </div>
  {% else %}
    <div class="reponses-empty">
      <div style="font-size:1.6rem;margin-bottom:8px">💬</div>
      Aucune réponse pour cette réclamation pour le moment.
    </div>
  {% endfor %}
</div>

{# ════ AJOUT D'UNE RÉPONSE ═══════════════════════════════════════════ #}
<div class="ds-detail-block">
  <div class="ds-detail-block-title">
    <svg viewBox="0 0 17 17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M8.5 1v15M1 8.5h15"/>
    </svg>
    Ajouter une réponse
  </div>
  <div class="add-form">
    <textarea id="new-contenu" placeholder="Votre réponse…"></textarea>
    <div style="margin-top:12px; display:flex; justify-content:flex-end">
      <button type="button" class="ds-btn-submit"
              data-url="{{ path('reclamation_show', {id: reclamation.id_reclamation}) }}"
              onclick="submitNewReponse(this)">
        <svg viewBox="0 0 15 15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="13" y1="2" x2="6" y2="9"/>
          <polygon points="13 2 9 13 6 9 2 6 13 2"/>
        </svg>
        Envoyer
      </button>
    </div>
  </div>
</div>

<script>
// ── JS d'origine — comportement préservé à 100% ──
function toggleRepEdit(id) {
  const zone = document.getElementById('rep-edit-' + id);
  const isOpen = zone.style.display === 'block';
  zone.style.display = isOpen ? 'none' : 'block';
}

function showFlash(type, message) {
  const flash = document.getElementById('flash-zone');
  const icons = {
    success: '<svg viewBox="0 0 17 17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 9 7 13 14 4"/></svg>',
    error:   '<svg viewBox="0 0 17 17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="8.5" cy="8.5" r="6.5"/><path d="M5 5l7 7M12 5l-7 7"/></svg>',
  };
  flash.innerHTML = '<div class="ds-flash ds-flash-' + type + '">' + icons[type] + message + '</div>';
  setTimeout(() => flash.innerHTML = '', 3000);
}

async function saveRepEdit(btn) {
  const id      = btn.dataset.id;
  const url     = btn.dataset.url;
  const contenu = document.getElementById('rep-textarea-' + id).value;

  const body = new URLSearchParams();
  body.append('action',          'edit_reponse');
  body.append('reponse_id',      id);
  body.append('contenu_reponse', contenu);

  try {
    const res = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
      body: body.toString(),
    });
    if (res.ok) {
      const json = await res.json();
      if (json.success) {
        document.getElementById('rep-body-' + id).textContent = contenu;
        toggleRepEdit(id);
        showFlash('success', 'Réponse modifiée avec succès.');
        return;
      }
    }
    showFlash('error', 'Erreur lors de la modification.');
  } catch (err) {
    showFlash('error', 'Erreur réseau. Réessayez.');
  }
}

async function submitNewReponse(btn) {
  const url     = btn.dataset.url;
  const contenu = document.getElementById('new-contenu').value.trim();
  if (!contenu) return;

  const body = new URLSearchParams();
  body.append('action',          'add_reponse');
  body.append('contenu_reponse', contenu);

  try {
    const res = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
      body: body.toString(),
    });
    if (res.ok) {
      const json = await res.json();
      if (json.success) {
        document.getElementById('new-contenu').value = '';
        showFlash('success', 'Réponse ajoutée.');
        setTimeout(() => location.reload(), 1200);
        return;
      }
    }
    showFlash('error', 'Erreur lors de l\'envoi.');
  } catch (err) {
    showFlash('error', 'Erreur réseau. Réessayez.');
  }
}
</script>
{% endblock %}
