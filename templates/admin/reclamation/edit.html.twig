{# templates/admin/reclamation/edit.html.twig
   Modifier réclamation — Back-office
   Design harmonisé avec admin/utilisateurs/ #}

{% extends 'base_backoffice.html.twig' %}

{% block title %}Modifier réclamation #{{ reclamation.id_reclamation }}{% endblock %}
{% block page_label %}Modifier réclamation{% endblock %}

{% block content %}
{% include '_partials/_admin_design_system.html.twig' %}

<div class="ds-form-page">

  {# ── Header ── #}
  <div class="ds-form-header">
    <div class="ds-form-header-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
        <path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
      </svg>
    </div>
    <div>
      <div class="ds-form-header-title">Modifier la réclamation #{{ reclamation.id_reclamation }}</div>
      <div class="ds-form-header-sub">Mettez à jour les informations de la réclamation</div>
    </div>
    <a href="{{ path('reclamation_index') }}" class="ds-back-link">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 4l-6 6 6 6"/>
      </svg>
      Retour à la liste
    </a>
  </div>

  {# ── Carte formulaire ── #}
  <form method="post" class="ds-form-card">

    <div class="ds-form-body">

      <div class="ds-form-section-title">
        <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 7l2.5 2.5L11 4"/></svg>
        Informations principales
      </div>

      <div class="ds-form-row">
        <div class="ds-form-group">
          <label class="ds-form-label">Catégorie <span class="required">*</span></label>
          <select name="categorie_id" class="ds-form-select" required>
            {% for categorie in categories %}
              <option value="{{ categorie.id_categorie }}"
                {% if reclamation.categorie and reclamation.categorie.id_categorie == categorie.id_categorie %}selected{% endif %}>
                {{ categorie.nom_categorie }}
              </option>
            {% endfor %}
          </select>
        </div>

        <div class="ds-form-group">
          <label class="ds-form-label">Statut</label>
          <select name="statut_reclamation" class="ds-form-select">
            {% set stat = reclamation.statut_reclamation|lower %}
            <option value="nouvelle"  {% if stat == 'nouvelle' or stat == 'nouveau' %}selected{% endif %}>Nouvelle</option>
            <option value="en cours"  {% if stat == 'en cours' or stat == 'en_cours' %}selected{% endif %}>En cours</option>
            <option value="résolue"   {% if stat == 'résolue' or stat == 'resolue' %}selected{% endif %}>Résolue</option>
            <option value="rejetée"   {% if stat == 'rejetée' or stat == 'rejetee' %}selected{% endif %}>Rejetée</option>
            {% if stat and stat not in ['nouvelle','nouveau','en cours','en_cours','résolue','resolue','rejetée','rejetee'] %}
              <option value="{{ reclamation.statut_reclamation }}" selected>{{ reclamation.statut_reclamation }}</option>
            {% endif %}
          </select>
        </div>
      </div>

      <div class="ds-form-row full">
        <div class="ds-form-group">
          <label class="ds-form-label">Sujet <span class="required">*</span></label>
          <input type="text" name="sujet_reclamation" class="ds-form-input" value="{{ reclamation.sujet_reclamation }}" required>
        </div>
      </div>

      <div class="ds-form-row full">
        <div class="ds-form-group">
          <label class="ds-form-label">Description</label>
          <textarea name="description_reclamation" class="ds-form-textarea" rows="5">{{ reclamation.description_reclamation }}</textarea>
        </div>
      </div>

      <div class="ds-form-section-title" style="margin-top:22px">
        <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="7" cy="5" r="2.2"/><path d="M2 12c0-2.8 2.2-5 5-5s5 2.2 5 5"/></svg>
        Utilisateur & Évaluation
      </div>

      <div class="ds-form-row three">
        <div class="ds-form-group">
          <label class="ds-form-label">ID utilisateur</label>
          <input type="number" name="id_utilisateur" class="ds-form-input" value="{{ reclamation.id_utilisateur }}" min="0">
        </div>
        <div class="ds-form-group">
          <label class="ds-form-label">Note</label>
          <input type="number" name="rate_Reclamation" class="ds-form-input" step="0.1" value="{{ reclamation.rate_Reclamation }}" min="0" max="5">
        </div>
        <div class="ds-form-group">
          <label class="ds-form-label">Somme des notes</label>
          <input type="number" name="rate_sum" class="ds-form-input" value="{{ reclamation.rate_sum }}" min="0">
        </div>
      </div>

      <div class="ds-form-row">
        <div class="ds-form-group">
          <label class="ds-form-label">Nombre de notes</label>
          <input type="number" name="rate_count" class="ds-form-input" value="{{ reclamation.rate_count }}" min="0">
        </div>
      </div>

    </div>

    <div class="ds-form-actions">
      <a href="{{ path('reclamation_index') }}" class="ds-btn-cancel">Annuler</a>
      <button type="submit" class="ds-btn-submit">
        <svg viewBox="0 0 15 15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="3 8 6 11 12 4"/>
        </svg>
        Enregistrer les modifications
      </button>
    </div>

  </form>
</div>
{% endblock %}
