{# templates/admin/ressources/newR.html.twig
   Nouvelle ressource — Back-office
   Design harmonisé : hero + design system + override sur le formulaire existant.
   ⚠ Toute la logique JS, le picker Pexels, le drag/drop et la validation sont préservés intacts. #}

{% extends 'base_backoffice.html.twig' %}

{% block title %}Nouvelle Ressource{% endblock %}
{% block page_label %}Nouvelle ressource{% endblock %}

{% block content %}
{% include '_partials/_admin_design_system.html.twig' %}

<style>
  /* ── Override des styles d'origine vers le design system ── */
  .form-container { max-width:1100px; margin:0 auto; }
  .form-header { margin-bottom:1.5rem; }
  .form-header h1 {
    font-size:1.4rem; font-weight:800; color:var(--text);
    margin:0 0 .3rem 0; font-family:'Playfair Display',serif;
    display:none; /* hero remplace */
  }
  .subhead { display:none; }
  .back-link { display:none; } /* géré dans le hero */

  .stepper {
    display:flex; gap:8px; margin-bottom:24px; flex-wrap:wrap;
    background:var(--white); border:1.5px solid var(--border); border-radius:14px;
    padding:14px; box-shadow:var(--shadow-card);
    animation:fadeUp .4s cubic-bezier(.22,1,.36,1) .05s both;
  }
  .step {
    display:flex; align-items:center; gap:.5rem;
    font-size:.78rem; font-weight:600; color:var(--text-sec);
    background:var(--bg); padding:7px 16px; border-radius:99px;
    border:1.5px solid var(--border); transition:all .2s;
  }
  .step.active {
    background:var(--green); color:#fff; border-color:var(--green);
  }
  .step-number {
    width:22px; height:22px; background:rgba(0,0,0,.08); border-radius:50%;
    display:inline-flex; align-items:center; justify-content:center;
    font-size:.74rem; font-weight:800;
  }
  .step.active .step-number { background:rgba(255,255,255,.25); color:#fff; }

  .form-progress {
    height:5px; background:var(--bg); border-radius:99px; overflow:hidden;
    border:1px solid var(--border);
  }
  .form-progress-bar {
    height:100%; background:linear-gradient(90deg, var(--green), var(--violet));
    width:0%; transition:width .4s ease;
  }

  .form-card {
    background:var(--white); border:1.5px solid var(--border);
    border-radius:18px; padding:24px;
    box-shadow:var(--shadow-card);
    animation:fadeUp .4s cubic-bezier(.22,1,.36,1) .1s both;
  }
  .form-section { padding:18px 0; border-bottom:1.5px solid var(--border); }
  .form-section:last-of-type { border-bottom:none; padding-bottom:0; }
  .section-title {
    font-size:1rem; font-weight:700; color:var(--text); margin-bottom:6px;
    font-family:'Playfair Display',serif;
  }
  .section-desc { font-size:.83rem; color:var(--text-sec); margin-bottom:18px; }

  .form-group { margin-bottom:16px; }
  .form-group label {
    display:block; font-size:.82rem; font-weight:600; color:var(--text);
    margin-bottom:6px;
  }
  .form-group small {
    display:block; font-size:.72rem; color:var(--text-sec); margin-top:5px;
  }
  .required-star { color:#EF4444; }

  .form-card input[type="text"],
  .form-card input[type="url"],
  .form-card input[type="email"],
  .form-card input[type="number"],
  .form-card input[type="date"],
  .form-card select,
  .form-card textarea {
    width:100%; padding:11px 14px; box-sizing:border-box;
    border:1.5px solid var(--border); border-radius:11px;
    background:var(--bg); font-family:'Outfit',sans-serif;
    font-size:.88rem; color:var(--text); outline:none;
    transition:border-color .2s, box-shadow .2s, background .2s;
  }
  .form-card textarea { resize:vertical; min-height:90px; }
  .form-card input:focus,
  .form-card select:focus,
  .form-card textarea:focus {
    border-color:var(--green-light); background:var(--white);
    box-shadow:0 0 0 3px rgba(82,183,136,.1);
  }

  .row-2 { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  .row-3 { display:grid; grid-template-columns:1fr 1fr 1fr; gap:14px; }
  @media (max-width:700px) {
    .row-2, .row-3 { grid-template-columns:1fr; }
  }

  .type-indicator {
    display:none; font-size:.8rem; padding:8px 12px; border-radius:9px;
    background:var(--green-pale); color:var(--green); margin-top:7px; font-weight:500;
  }
  .type-indicator.article,
  .type-indicator.podcast,
  .type-indicator.video,
  .type-indicator.pdf { display:block; }
  .type-indicator.podcast { background:#FEF3C7; color:#92400E; }
  .type-indicator.video { background:var(--violet-pale); color:var(--violet); }
  .type-indicator.pdf { background:#FEE2E2; color:#991B1B; }

  .dropzone {
    border:2px dashed var(--border); border-radius:14px;
    padding:28px 18px; text-align:center; cursor:pointer;
    background:var(--bg); transition:all .2s;
  }
  .dropzone:hover, .dropzone.dragover {
    border-color:var(--green-light); background:var(--green-pale);
  }
  .dz-icon { font-size:2.4rem; margin-bottom:6px; }
  .dz-text { font-size:.92rem; font-weight:600; color:var(--text); margin-bottom:4px; }
  .dz-hint { font-size:.74rem; color:var(--text-sec); }
  #image-preview {
    max-width:280px; max-height:170px; margin:14px auto 0;
    border-radius:10px; display:block;
  }
  .file-info {
    margin-top:12px; padding:9px 12px; background:var(--green-pale);
    border-radius:9px; font-size:.83rem; color:var(--green); font-weight:600;
  }

  .url-preview {
    display:none; margin-top:8px; padding:8px 12px;
    background:var(--green-pale); color:var(--green);
    border-radius:9px; font-size:.82rem; font-weight:500;
  }
  .url-preview.show { display:flex; gap:6px; align-items:center; }

  .alert {
    padding:11px 14px; border-radius:11px; margin-bottom:14px;
    font-size:.85rem; font-weight:500;
  }
  .alert-danger { background:#FEE2E2; color:#991B1B; border-left:3px solid #EF4444; }
  .alert-warning { background:#FEF3C7; color:#92400E; border-left:3px solid #F59E0B; }

  .check-label {
    display:flex; align-items:center; gap:10px; cursor:pointer;
    padding:10px 14px; background:var(--bg); border-radius:10px;
    border:1.5px solid var(--border); transition:all .2s;
  }
  .check-label:hover { border-color:var(--green-light); }
  .check-label input[type="checkbox"] { accent-color:var(--green); width:17px; height:17px; }
  .check-label span { font-size:.85rem; color:var(--text); font-weight:500; }

  .form-footer {
    display:flex; justify-content:space-between; align-items:center;
    margin-top:20px; padding-top:20px; border-top:1.5px solid var(--border);
    gap:12px; flex-wrap:wrap;
  }
  .btn-cancel {
    padding:11px 22px; border-radius:11px;
    background:var(--bg); color:var(--text); text-decoration:none;
    border:1.5px solid var(--border); font-weight:600; font-size:.87rem;
    transition:all .2s;
  }
  .btn-cancel:hover { border-color:var(--green-light); color:var(--green); }
  .btn-submit {
    padding:11px 24px; border-radius:11px;
    background:var(--green); color:#fff; border:none;
    font-family:'Outfit',sans-serif; font-size:.9rem; font-weight:700;
    cursor:pointer; transition:all .2s;
    display:inline-flex; align-items:center; gap:6px;
  }
  .btn-submit:hover { background:var(--green-mid); transform:translateY(-1px); box-shadow:0 6px 18px rgba(27,67,50,.18); }
  .btn-submit:disabled { opacity:.55; cursor:not-allowed; }

  @keyframes pexelsSpin { to { transform: rotate(360deg); } }
  .pexels-img-card {
    cursor:pointer; border-radius:10px; overflow:hidden; position:relative;
    border:3px solid transparent; transition:border-color .15s, transform .15s;
  }
  .pexels-img-card:hover { border-color:var(--violet); transform:scale(1.02); }
  .pexels-img-card.selected { border-color:var(--green); box-shadow:0 0 0 3px rgba(82,183,136,.25); }
  .pexels-img-card img { width:100%; height:110px; object-fit:cover; display:block; }
  .pexels-photographer {
    position:absolute; bottom:0; left:0; right:0;
    padding:4px 8px; background:rgba(0,0,0,.55); color:#fff;
    font-size:10px; opacity:0; transition:opacity .2s;
  }
  .pexels-img-card:hover .pexels-photographer { opacity:1; }
</style>

{# ── HERO ── #}
<div class="ds-hero">
  <div class="ds-hero-dots"><span></span><span></span><span></span></div>
  <div class="ds-hero-body">
    <div class="ds-hero-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
        <line x1="12" y1="18" x2="12" y2="12"/>
        <line x1="9" y1="15" x2="15" y2="15"/>
      </svg>
    </div>
    <div class="ds-hero-text">
      <div class="ds-hero-title">Créer une ressource</div>
      <div class="ds-hero-sub">
        Partagez du contenu inspirant pour le bien-être mental de votre communauté
      </div>
    </div>
    <div style="display:flex;align-items:center;gap:10px;flex-shrink:0;margin-left:auto;flex-wrap:wrap">
      <a href="{{ path('admin_ressources_index') }}" class="ds-btn-primary">
        <div class="ds-btn-primary-icon">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4l-6 6 6 6"/></svg>
        </div>
        Retour
      </a>
    </div>
  </div>
</div>

<div class="form-container">

    <div class="form-header">
        <a href="{{ path('admin_ressources_index') }}" class="back-link">
            ← Retour à la liste
        </a>
        <h1>✨ Créer une ressource</h1>
        <p class="subhead">Partagez du contenu inspirant pour le bien-être mental de votre communauté</p>
    </div>

    {# Stepper #}
    <div class="stepper">
        <div class="step active" id="step-1"><span class="step-number">1</span> Infos</div>
        <div class="step" id="step-2"><span class="step-number">2</span> Détails</div>
        <div class="step" id="step-3"><span class="step-number">3</span> Image</div>
        <div class="step" id="step-4"><span class="step-number">4</span> Fichier</div>
        <div class="step" id="step-5"><span class="step-number">5</span> Auteur</div>
    </div>

    {# Flash erreurs #}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">⚠️ {{ message }}</div>
    {% endfor %}

    {# Barre de progression #}
    <div class="form-progress" style="margin-bottom:1.5rem; border-radius:4px;">
        <div class="form-progress-bar" id="progressBar"></div>
    </div>

    <form
        method="post"
        action="{{ path('admin_ressources_create') }}"
        enctype="multipart/form-data"
        class="form-card"
        id="resourceForm"
        novalidate
    >

        {# ── SECTION 1 : Informations principales ── #}
        <div class="form-section">
            <div class="section-title">📝 Informations principales</div>
            <div class="section-desc">Définissez le titre, le résumé et la catégorie de votre ressource</div>

            <div class="form-group">
                <label>Titre de la ressource <span class="required-star">*</span></label>
                <input
                    type="text"
                    name="titre"
                    id="input-titre"
                    placeholder="Ex : 5 techniques pour gérer le stress au quotidien"
                    maxlength="100"
                    required
                >
                <small>Titre accrocheur et descriptif — max 100 caractères</small>
            </div>

            <div class="form-group">
                <label>Résumé <span class="required-star">*</span></label>
                <textarea
                    name="resume"
                    id="input-resume"
                    rows="4"
                    placeholder="Décrivez en quelques lignes l'objectif de cette ressource..."
                    required
                ></textarea>
            </div>

            <div class="row-2">
                <div class="form-group">
                    <label>Catégorie <span class="required-star">*</span></label>
                    <select name="categorie" id="input-categorie" required>
                        <option value="">Choisissez une catégorie...</option>
                        {% for label, value in categorieChoices %}
                            <option value="{{ value }}">{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="form-group">
                    <label>Mots-clés</label>
                    <input
                        type="text"
                        name="tags"
                        placeholder="méditation, relaxation, anxiété, bien-être"
                    >
                    <small>Séparez les mots-clés par des virgules</small>
                </div>
            </div>
        </div>

        {# ── SECTION 2 : Détails ── #}
        <div class="form-section">
            <div class="section-title">⚙️ Détails de la ressource</div>
            <div class="section-desc">Type de contenu, niveau et informations temporelles</div>

            <div class="row-3">
                <div class="form-group">
                    <label>Type de contenu <span class="required-star">*</span></label>
                    <select name="contenu" id="resource_type" required>
                        <option value="">Sélectionnez le format...</option>
                        {% for label, value in contenuChoices %}
                            <option value="{{ value }}">{{ label }}</option>
                        {% endfor %}
                    </select>
                    <small>La section Fichier s'adapte automatiquement</small>

                    <div class="type-indicator" id="indicator-article">📰 Article — un lien URL sera demandé</div>
                    <div class="type-indicator" id="indicator-podcast">🎙️ Podcast — un lien URL sera demandé</div>
                    <div class="type-indicator" id="indicator-video">🎬 Vidéo — upload de fichier requis</div>
                    <div class="type-indicator" id="indicator-pdf">📄 PDF — upload de fichier requis</div>
                </div>

                <div class="form-group">
                    <label>Niveau</label>
                    <select name="niveau">
                        {% for label, value in niveauChoices %}
                            <option value="{{ value }}"{% if value == 'DEBUTANT' %} selected{% endif %}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="form-group">
                    <label>Durée de lecture (min)</label>
                    <input
                        type="number"
                        name="duree_lecture"
                        placeholder="15"
                        step="1"
                        min="0"
                        max="600"
                    >
                </div>
            </div>

            <div class="form-group" style="max-width:280px;">
                <label>Date de publication</label>
                <input
                    type="date"
                    name="date_publication"
                    value="{{ 'now'|date('Y-m-d') }}"
                >
            </div>
        </div>

        {# ── SECTION 3 : Image de couverture ── #}
        <div class="form-section">
            <div class="section-title">🖼️ Image de couverture</div>
            <div class="section-desc">Choisissez votre image — upload local ou bibliothèque Pexels gratuite</div>

            <div style="display:flex;gap:8px;margin-bottom:1.2rem;">
                <button type="button" id="tab-upload" onclick="switchImageTab('upload')"
                    style="padding:8px 20px;border-radius:40px;font-size:0.82rem;font-weight:600;
                           border:2px solid var(--green);background:var(--green);color:white;cursor:pointer;transition:all .2s;font-family:Outfit,sans-serif;">
                    📁 Uploader une image
                </button>
                <button type="button" id="tab-pexels" onclick="switchImageTab('pexels')"
                    style="padding:8px 20px;border-radius:40px;font-size:0.82rem;font-weight:600;
                           border:2px solid var(--border);background:white;color:var(--text-sec);cursor:pointer;transition:all .2s;font-family:Outfit,sans-serif;">
                    📸 Bibliothèque Pexels
                </button>
            </div>

            <div id="panel-upload">
                <div
                    id="dropzone-image"
                    class="dropzone"
                    onclick="document.getElementById('image_file').click()"
                >
                    <div class="dz-icon">📸</div>
                    <div class="dz-text">Glissez votre image ici ou cliquez pour parcourir</div>
                    <div class="dz-hint">PNG · JPG · JPEG · Max 5 MB</div>
                    <img id="image-preview" src="#" alt="Aperçu" style="display:none;">
                </div>
                <input
                    type="file"
                    name="image_file"
                    id="image_file"
                    accept="image/png,image/jpeg,image/jpg,image/webp"
                    style="display:none;"
                >
            </div>

            <div id="panel-pexels" style="display:none;">

                <div style="display:flex;gap:8px;margin-bottom:1rem;flex-wrap:wrap;">
                    <input type="text" id="pexels-query" placeholder="Ex : méditation, confiance, motivation..."
                        style="flex:1;min-width:200px;padding:10px 14px;border:1.5px solid var(--border);
                               border-radius:11px;font-size:0.875rem;background:var(--bg);font-family:inherit;">
                    <select id="pexels-color"
                        style="padding:10px 14px;border:1.5px solid var(--border);border-radius:11px;
                               font-size:0.875rem;background:var(--bg);cursor:pointer;">
                        <option value="">🎨 Toutes couleurs</option>
                        <option value="blue">🔵 Bleu</option>
                        <option value="green">🟢 Vert</option>
                        <option value="orange">🟠 Orange</option>
                        <option value="white">⚪ Blanc</option>
                        <option value="black">⚫ Noir</option>
                        <option value="yellow">🟡 Jaune</option>
                        <option value="pink">🩷 Rose</option>
                    </select>
                    <button type="button" id="pexels-search-btn"
                        style="padding:10px 18px;background:var(--violet);color:white;border:none;
                               border-radius:11px;font-size:0.875rem;font-weight:600;cursor:pointer;font-family:Outfit,sans-serif;">
                        🔍 Rechercher
                    </button>
                    <button type="button" id="pexels-suggest-btn"
                        style="padding:10px 18px;background:var(--green-pale);color:var(--green);border:1.5px solid var(--green-light);
                               border-radius:11px;font-size:0.875rem;font-weight:600;cursor:pointer;font-family:Outfit,sans-serif;"
                        title="Suggère automatiquement des images selon la catégorie et le type choisis">
                        ✨ Auto-suggérer
                    </button>
                </div>

                <div id="pexels-loading" style="text-align:center;padding:2rem;display:none;">
                    <div style="display:inline-block;width:32px;height:32px;border:3px solid var(--border);
                                border-top-color:var(--violet);border-radius:50%;animation:pexelsSpin 0.8s linear infinite;"></div>
                    <p style="margin-top:8px;color:var(--text-sec);font-size:0.85rem;">Chargement des images Pexels...</p>
                </div>

                <div id="pexels-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:1rem;"></div>

                <div id="pexels-selected-preview" style="display:none;margin-top:1rem;">
                    <div style="display:flex;align-items:center;gap:12px;padding:12px 16px;
                                background:var(--green-pale);border:1px solid var(--green-light);border-radius:12px;">
                        <img id="pexels-selected-thumb" src="" alt=""
                             style="width:90px;height:60px;object-fit:cover;border-radius:8px;flex-shrink:0;">
                        <div style="flex:1;">
                            <strong style="font-size:0.875rem;color:var(--green);">✅ Image sélectionnée</strong>
                            <p id="pexels-selected-credit" style="margin:2px 0 0;font-size:0.75rem;color:var(--text-sec);"></p>
                        </div>
                        <button type="button" id="pexels-clear-btn"
                            style="padding:6px 12px;background:white;border:1.5px solid #ef4444;
                                   color:#ef4444;border-radius:8px;font-size:0.8rem;cursor:pointer;">
                            ✕ Retirer
                        </button>
                    </div>
                </div>

                <input type="hidden" name="pexels_image_url"    id="pexels-image-url">
                <input type="hidden" name="pexels_image_credit" id="pexels-image-credit">

                <small style="color:var(--text-sec);display:block;margin-top:8px;">
                    📸 Images libres de droits par <a href="https://www.pexels.com" target="_blank" style="color:var(--violet);">Pexels</a> — utilisation commerciale autorisée
                </small>
            </div>
        </div>

        {# ── SECTION 4 : Fichier de la ressource ── #}
        <div class="form-section">
            <div class="section-title">📁 Fichier de la ressource</div>
            <div class="section-desc">Cette section s'adapte selon le type sélectionné en Section 2</div>

            <div id="link_field" style="display:none;">
                <div class="form-group">
                    <label>URL de la ressource <span class="required-star">*</span></label>
                    <input
                        type="url"
                        name="url"
                        id="url_input"
                        placeholder="https://..."
                    >
                    <small>Collez le lien vers l'article ou le podcast</small>
                    <div class="url-preview" id="url-preview-box">
                        ✅ <span id="url-preview-text"></span>
                    </div>
                </div>
            </div>

            <div id="file_field" style="display:none;">
                <div
                    id="dropzone-file"
                    class="dropzone"
                    onclick="document.getElementById('resource_file').click()"
                >
                    <div class="dz-icon" id="file-dz-icon">📁</div>
                    <div class="dz-text">Glissez votre fichier ici ou cliquez pour parcourir</div>
                    <div class="dz-hint" id="file-dz-hint">PDF · MP4 · AVI · MOV · Max 100 MB</div>
                    <div id="file-name-display" class="file-info" style="display:none;"></div>
                </div>
                <input
                    type="file"
                    name="resource_file"
                    id="resource_file"
                    accept=".pdf,.mp4,.avi,.mov,.webm"
                    style="display:none;"
                >
            </div>

            <div id="no_type_message" class="alert alert-warning">
                ⚠️ Choisissez d'abord un type de contenu (Section 2) — la section fichier s'adaptera automatiquement.
            </div>
        </div>

        {# ── SECTION 5 : Auteur ── #}
        <div class="form-section">
            <div class="section-title">👤 Informations auteur</div>
            <div class="section-desc">Pour les notifications et la communication</div>

            <div class="form-group" style="max-width:480px;">
                <label>Adresse email de l'auteur <span class="required-star">*</span></label>
                <input
                    type="email"
                    name="email_auteur"
                    id="input-email"
                    placeholder="auteur@exemple.com"
                    required
                >
                <small>Vous recevrez une confirmation à cette adresse</small>
            </div>

            <div class="form-group">
                <label class="check-label">
                    <input type="checkbox" id="ready_check">
                    <span>✅ Je confirme que tous les champs sont corrects et prêt à publier</span>
                </label>
            </div>
        </div>

        <div class="form-footer">
            <a href="{{ path('admin_ressources_index') }}" class="btn-cancel">
                Annuler
            </a>
            <button type="submit" class="btn-submit" id="submitBtn">
                ✨ Créer la ressource
            </button>
        </div>

    </form>
</div>
{% endblock %}

{% block javascripts %}
<script>
(function () {
    'use strict';

    const typeSelect       = document.getElementById('resource_type');
    const linkDiv          = document.getElementById('link_field');
    const fileDiv          = document.getElementById('file_field');
    const noTypeDiv        = document.getElementById('no_type_message');
    const urlInput         = document.getElementById('url_input');
    const fileInput        = document.getElementById('resource_file');
    const progressBar      = document.getElementById('progressBar');

    // ── Log debug (à supprimer en prod) ──
    console.log('[DEBUG] Valeurs contenuChoices disponibles dans le select :');
    Array.from(typeSelect.options).forEach(o => {
        console.log(`  label="${o.text}" value="${o.value}"`);
    });

    // ── Toggle section fichier selon le type ──
    function toggleFields() {
        const rawValue = typeSelect.value;
        const type     = rawValue.trim().toLowerCase();

        console.log('[DEBUG] Type sélectionné :', JSON.stringify(rawValue), '→ lowercase:', type);

        // Reset visibilité
        linkDiv.style.display   = 'none';
        fileDiv.style.display   = 'none';
        noTypeDiv.style.display = 'none';

        // Reset indicateurs
        ['article','podcast','video','pdf'].forEach(t => {
            const el = document.getElementById('indicator-' + t);
            if (el) el.className = 'type-indicator';
        });

        if (!type) {
            noTypeDiv.style.display = 'block';
            return;
        }

        if (type === 'article' || type === 'podcast') {
            linkDiv.style.display = 'block';
            const ind = document.getElementById('indicator-' + type);
            if (ind) ind.classList.add(type);

        } else if (type === 'video' || type === 'pdf') {

            fileDiv.style.display = 'block';

            // Adapter l'icône et le hint selon PDF ou Vidéo
            const icon = document.getElementById('file-dz-icon');
            const hint = document.getElementById('file-dz-hint');
            if (type === 'pdf') {
                if (icon) icon.textContent = '📄';
                if (hint) hint.textContent = 'PDF uniquement · Max 100 MB';
                fileInput.accept = '.pdf';
                const ind = document.getElementById('indicator-pdf');
                if (ind) ind.classList.add('pdf');
            } else {
                if (icon) icon.textContent = '🎬';
                if (hint) hint.textContent = 'MP4 · AVI · MOV · WebM · Max 100 MB';
                fileInput.accept = '.mp4,.avi,.mov,.webm';
                const ind = document.getElementById('indicator-video');
                if (ind) ind.classList.add('video');
            }

        } else {
            noTypeDiv.style.display = 'block';
            console.warn('[DEBUG] Type non reconnu :', rawValue);
        }

        updateProgress();
    }

    typeSelect.addEventListener('change', toggleFields);
    toggleFields(); // appel initial

    // ── Aperçu URL en temps réel ──
    if (urlInput) {
        urlInput.addEventListener('input', function () {
            const box  = document.getElementById('url-preview-box');
            const text = document.getElementById('url-preview-text');
            if (this.value && this.value.startsWith('http')) {
                try {
                    const host = new URL(this.value).hostname;
                    text.textContent = host;
                    box.classList.add('visible');
                } catch {
                    box.classList.remove('visible');
                }
            } else {
                box.classList.remove('visible');
            }
        });
    }

    // ── Drag & Drop image ──
    const dropzoneImage  = document.getElementById('dropzone-image');
    const imageFileInput = document.getElementById('image_file');
    const imagePreview   = document.getElementById('image-preview');

    function preventDefaults(e) { e.preventDefault(); e.stopPropagation(); }

    if (dropzoneImage) {
        ['dragenter','dragover','dragleave','drop'].forEach(evt =>
            dropzoneImage.addEventListener(evt, preventDefaults));
        ['dragenter','dragover'].forEach(evt =>
            dropzoneImage.addEventListener(evt, () => dropzoneImage.classList.add('drag-over')));
        ['dragleave','drop'].forEach(evt =>
            dropzoneImage.addEventListener(evt, () => dropzoneImage.classList.remove('drag-over')));

        dropzoneImage.addEventListener('drop', e => {
            const file = e.dataTransfer.files[0];
            if (file && file.type.startsWith('image/')) {
                setImagePreview(file);
            }
        });
    }

    if (imageFileInput) {
        imageFileInput.addEventListener('change', () => {
            const file = imageFileInput.files[0];
            if (file) setImagePreview(file);
            else imagePreview.style.display = 'none';
        });
    }

    function setImagePreview(file) {
        const reader = new FileReader();
        reader.onload = e => {
            imagePreview.src = e.target.result;
            imagePreview.style.display = 'block';
        };
        reader.readAsDataURL(file);
    }

    // ── Drag & Drop fichier ressource ──
    const dropzoneFile    = document.getElementById('dropzone-file');
    const fileNameDisplay = document.getElementById('file-name-display');

    if (dropzoneFile) {
        ['dragenter','dragover','dragleave','drop'].forEach(evt =>
            dropzoneFile.addEventListener(evt, preventDefaults));
        ['dragenter','dragover'].forEach(evt =>
            dropzoneFile.addEventListener(evt, () => dropzoneFile.classList.add('drag-over')));
        ['dragleave','drop'].forEach(evt =>
            dropzoneFile.addEventListener(evt, () => dropzoneFile.classList.remove('drag-over')));

        dropzoneFile.addEventListener('drop', e => {
            const file = e.dataTransfer.files[0];
            if (file) {
                fileInput.files = e.dataTransfer.files;
                showFileName(file);
            }
        });
    }

    if (fileInput) {
        fileInput.addEventListener('change', () => {
            const file = fileInput.files[0];
            if (file) showFileName(file);
            else fileNameDisplay.style.display = 'none';
        });
    }

    function showFileName(file) {
        const sizeMB = (file.size / 1024 / 1024).toFixed(2);
        fileNameDisplay.innerHTML = `📄 ${file.name} <span style="opacity:.7">(${sizeMB} MB)</span>`;
        fileNameDisplay.style.display = 'inline-block';
    }

    // ── Barre de progression du formulaire ──
    function updateProgress() {
        const fields = [
            document.querySelector('[name="titre"]'),
            document.querySelector('[name="resume"]'),
            document.querySelector('[name="categorie"]'),
            document.querySelector('[name="contenu"]'),
            document.querySelector('[name="email_auteur"]'),
        ];
        const filled = fields.filter(f => f && f.value.trim() !== '').length;
        const pct    = Math.round((filled / fields.length) * 100);
        if (progressBar) progressBar.style.width = pct + '%';

        // Mettre à jour le stepper visuellement
        const steps = [
            ['input-titre', 'input-resume', 'input-categorie'],
            ['resource_type'],
            [],
            [],
            ['input-email'],
        ];
        steps.forEach((ids, idx) => {
            const el = document.getElementById('step-' + (idx + 1));
            if (!el) return;
            const done = ids.length === 0 ||
                         ids.some(id => { const f = document.getElementById(id); return f && f.value.trim(); });
            el.classList.toggle('active', done);
        });
    }

    // Écouter tous les champs pour la progression
    document.querySelectorAll('input, select, textarea').forEach(el => {
        el.addEventListener('input', updateProgress);
        el.addEventListener('change', updateProgress);
    });
    updateProgress();

    // ── Soumission ──
    document.getElementById('submitBtn')?.addEventListener('click', function (e) {
        const readyCheck = document.getElementById('ready_check');
        if (readyCheck && !readyCheck.checked) {
            if (!confirm("Vous n'avez pas coché la case de confirmation.\nVoulez-vous continuer quand même ?")) {
                e.preventDefault();
            }
        }
    });
    // ── Filtre mots interdits (feedback temps réel) ──
const BAD_WORDS = [
    'connard','connasse','salope','pute','putain','merde','enculé',
    'batard','bâtard','idiot','idiote','imbécile','imbecile','crétin',
    'cretin','abruti','débile','debile','con','conne','nique','niquer',
    'fdp','trouduc','cul','bordel',
    'fuck','fucking','shit','bitch','asshole','bastard','cunt',
    'dick','pussy','motherfucker','bullshit','whore','slut','retard'
];

function normalizeBW(str) {
    return str.toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')   // supprime accents
        .replace(/[^a-z0-9\s]/g, '')        // supprime ponctuation / *
        .trim();
}

function hasBadWord(text) {
    const norm = normalizeBW(text);
    return BAD_WORDS.some(w => {
        const escaped = normalizeBW(w).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        return new RegExp('(?<![a-z0-9])' + escaped + '(?![a-z0-9])', 'i').test(norm);
    });
}

function applyBadWordFeedback(inputEl, feedbackElId) {
    let fb = document.getElementById(feedbackElId);
    if (!fb) {
        fb = document.createElement('small');
        fb.id = feedbackElId;
        fb.style.cssText = 'color:#ef4444;font-weight:600;margin-top:4px;display:block;';
        inputEl.parentNode.appendChild(fb);
    }
    const bad = hasBadWord(inputEl.value);
    inputEl.style.borderColor = bad ? '#ef4444' : '';
    inputEl.style.boxShadow   = bad ? '0 0 0 3px rgba(239,68,68,0.15)' : '';
    fb.textContent            = bad ? '🚫 Terme inapproprié détecté — merci de reformuler.' : '';
    return !bad;
}

const titreEl  = document.getElementById('input-titre');
const resumeEl = document.getElementById('input-resume');

titreEl?.addEventListener('input',  () => applyBadWordFeedback(titreEl,  'bw-titre'));
resumeEl?.addEventListener('input', () => applyBadWordFeedback(resumeEl, 'bw-resume'));

// Bloquer la soumission du formulaire si mots interdits
const existingForm = document.getElementById('resourceForm');
if (existingForm) {
    existingForm.addEventListener('submit', function (e) {
        const titreOk  = applyBadWordFeedback(titreEl,  'bw-titre');
        const resumeOk = applyBadWordFeedback(resumeEl, 'bw-resume');
        if (!titreOk || !resumeOk) {
            e.preventDefault();
            const firstBad = titreOk ? resumeEl : titreEl;
            firstBad.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    }, true); // capture: true → s'exécute AVANT le submit handler existant
}


// ══════════════════════════════════════════════════════
// PEXELS IMAGE PICKER — logique complète
// ══════════════════════════════════════════════════════

// ── Switcher d'onglets Upload / Pexels ──
window.switchImageTab = function(tab) {
    const panelUpload = document.getElementById('panel-upload');
    const panelPexels = document.getElementById('panel-pexels');
    const btnUpload   = document.getElementById('tab-upload');
    const btnPexels   = document.getElementById('tab-pexels');

    if (tab === 'upload') {
        panelUpload.style.display = 'block';
        panelPexels.style.display = 'none';
        btnUpload.style.background = '#534AB7';
        btnUpload.style.color      = 'white';
        btnUpload.style.borderColor = '#534AB7';
        btnPexels.style.background = 'white';
        btnPexels.style.color      = '#6b7280';
        btnPexels.style.borderColor = '#e5e7eb';
        // Vider la sélection Pexels si on revient sur upload
        document.getElementById('pexels-image-url').value    = '';
        document.getElementById('pexels-image-credit').value = '';
    } else {
        panelUpload.style.display = 'none';
        panelPexels.style.display = 'block';
        btnPexels.style.background = '#534AB7';
        btnPexels.style.color      = 'white';
        btnPexels.style.borderColor = '#534AB7';
        btnUpload.style.background = 'white';
        btnUpload.style.color      = '#6b7280';
        btnUpload.style.borderColor = '#e5e7eb';
        // Auto-charger des suggestions si catégorie déjà choisie
        const categorie = document.querySelector('[name="categorie"]')?.value || '';
        if (categorie && document.getElementById('pexels-grid').children.length === 0) {
            pexelsFetchPhotos('/admin/pexels/suggest?categorie=' + encodeURIComponent(categorie) + '&count=9');
        }
    }
};

// ── Recherche Pexels ──
document.getElementById('pexels-search-btn')?.addEventListener('click', () => {
    const q     = document.getElementById('pexels-query').value.trim();
    const color = document.getElementById('pexels-color').value;
    if (!q) { document.getElementById('pexels-query').focus(); return; }
    pexelsFetchPhotos('/admin/pexels/search?q=' + encodeURIComponent(q) + '&per_page=9&color=' + color);
});

document.getElementById('pexels-query')?.addEventListener('keydown', e => {
    if (e.key === 'Enter') { e.preventDefault(); document.getElementById('pexels-search-btn').click(); }
});

// ── Auto-suggestion selon catégorie + type ──
document.getElementById('pexels-suggest-btn')?.addEventListener('click', () => {
    const categorie = document.querySelector('[name="categorie"]')?.value || '';
    const contenu   = document.querySelector('[name="contenu"]')?.value   || '';
    if (!categorie && !contenu) {
        alert('Sélectionne d\'abord une catégorie ou un type de contenu dans le formulaire.');
        return;
    }
    pexelsFetchPhotos('/admin/pexels/suggest?categorie=' + encodeURIComponent(categorie) + '&contenu=' + encodeURIComponent(contenu) + '&count=9');
});

// ── Retirer la sélection ──
document.getElementById('pexels-clear-btn')?.addEventListener('click', () => {
    document.getElementById('pexels-image-url').value    = '';
    document.getElementById('pexels-image-credit').value = '';
    document.getElementById('pexels-selected-preview').style.display = 'none';
    document.querySelectorAll('.pexels-img-card').forEach(c => c.classList.remove('selected'));
});

// ── Charger les photos via fetch ──
function pexelsFetchPhotos(url) {
    const grid    = document.getElementById('pexels-grid');
    const spinner = document.getElementById('pexels-loading');
    grid.innerHTML = '';
    spinner.style.display = 'block';

    fetch(url)
        .then(r => r.json())
        .then(data => {
            spinner.style.display = 'none';
            if (!data.photos || data.photos.length === 0) {
                grid.innerHTML = '<p style="color:#9ca3af;grid-column:span 3;text-align:center;padding:1rem;">Aucun résultat — essaie un autre mot-clé.</p>';
                return;
            }
            pexelsRenderPhotos(data.photos);
        })
        .catch(() => {
            spinner.style.display = 'none';
            grid.innerHTML = '<p style="color:#ef4444;grid-column:span 3;text-align:center;padding:1rem;">❌ Erreur de chargement — vérifie ta clé PEXELS_API_KEY.</p>';
        });
}

// ── Afficher la grille de photos ──
function pexelsRenderPhotos(photos) {
    const grid = document.getElementById('pexels-grid');
    photos.forEach(photo => {
        const card = document.createElement('div');
        card.className = 'pexels-img-card';
        card.style.position = 'relative';
        card.innerHTML = `
            <img src="${photo.url_small || photo.url_medium}" alt="${photo.alt || ''}" loading="lazy">
            <div class="pexels-photographer">📷 ${photo.photographer}</div>`;

        card.addEventListener('click', () => pexelsSelectPhoto(card, photo));
        grid.appendChild(card);
    });
}

// ── Sélectionner une photo ──
function pexelsSelectPhoto(card, photo) {
    document.querySelectorAll('.pexels-img-card').forEach(c => c.classList.remove('selected'));
    card.classList.add('selected');

    document.getElementById('pexels-image-url').value    = photo.url_medium || photo.url_large;
    document.getElementById('pexels-image-credit').value = photo.credit;

    const preview = document.getElementById('pexels-selected-preview');
    document.getElementById('pexels-selected-thumb').src  = photo.url_small || photo.url_medium;
    document.getElementById('pexels-selected-credit').textContent = photo.credit;
    preview.style.display = 'flex';
}

// ── Auto-trigger suggestion quand catégorie change et onglet Pexels actif ──
document.querySelector('[name="categorie"]')?.addEventListener('change', function() {
    const pexelsPanel = document.getElementById('panel-pexels');
    if (pexelsPanel && pexelsPanel.style.display !== 'none' && this.value) {
        pexelsFetchPhotos('/admin/pexels/suggest?categorie=' + encodeURIComponent(this.value) + '&count=9');
    }
});

})();
</script>
{% endblock %}