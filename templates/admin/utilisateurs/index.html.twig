{# ════════════════════════════════════════════════════════════════════════
   PANNEAU NOTIFICATIONS — placé hors du hero (overflow:hidden corrigé)
   Positionné en position:fixed via JS pour s'afficher devant tout
════════════════════════════════════════════════════════════════════════ #}
<div class="notif-panel" id="notifPanel" role="dialog" aria-label="Centre de notifications">
  <div class="notif-header">
    <div class="notif-header-left">
      <div class="notif-header-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/>
          <path d="M13.73 21a2 2 0 01-3.46 0"/>
        </svg>
      </div>
      <div>
        <div class="notif-header-title">Notifications</div>
        <div class="notif-header-count" id="notifHeaderCount">Aucune activité récente</div>
      </div>
    </div>
    <div class="notif-header-actions">
      <button type="button" class="notif-clear-btn" id="notifClearAll" title="Tout effacer">Tout effacer</button>
      <button type="button" class="notif-close-btn" id="notifClose" title="Fermer">
        <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M1 1l10 10M11 1L1 11"/>
