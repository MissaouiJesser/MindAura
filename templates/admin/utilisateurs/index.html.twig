                <polyline points="11 4 11 9 16 9" stroke-linecap="round"/>
                <line x1="8" y1="13" x2="12" y2="13" stroke-linecap="round"/>
                <line x1="8" y1="10.5" x2="12" y2="10.5" stroke-linecap="round"/>
              </svg>
            </div>
            Export CSV
          </a>
          <div class="export-tooltip">
            Télécharger la liste filtrée<br>au format CSV (Excel)
          </div>
        </div>

        {# Export PDF #}
        <div class="export-tooltip-wrap">
          <a href="{{ path('app_admin_utilisateurs_export_pdf',
               {search: search, role: role, statut: statut, dateDebut: dateDebut, dateFin: dateFin, sort: sort, direction: direction}) }}"
             class="btn-export btn-export-pdf">
            <div class="btn-export-icon">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M4 4h7l5 5v7a1 1 0 01-1 1H4a1 1 0 01-1-1V5a1 1 0 011-1z" stroke-linecap="round"/>
                <polyline points="11 4 11 9 16 9" stroke-linecap="round"/>
                <path d="M7 13h.5a1 1 0 000-2H7v4m4-4h1a1 1 0 110 2h-1m3-2v4" stroke-linecap="round"/>
              </svg>
