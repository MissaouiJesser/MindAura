{# templates/admin/utilisateurs/index.html.twig
   Liste des utilisateurs — Back-office
   Pagination + tri + recherche + filtres multi-attributs   #}

{% extends 'base_backoffice.html.twig' %}

{% block title %}Utilisateurs{% endblock %}
{% block page_label %}Utilisateurs{% endblock %}

{# ── Macro : URL d'un lien de tri (conserve tous les autres paramètres) ── #}
{% macro sortUrl(col, currentSort, currentDir, params) %}
  {% set newDir = (col == currentSort and currentDir == 'ASC') ? 'DESC' : 'ASC' %}
  ?search={{ params.search|url_encode }}&role={{ params.role|url_encode }}&statut={{ params.statut|url_encode }}&dateDebut={{ params.dateDebut|url_encode }}&dateFin={{ params.dateFin|url_encode }}&sort={{ col }}&direction={{ newDir }}&page=1&perPage={{ params.perPage }}
{% endmacro %}

{% macro pageUrl(p, params) -%}
    ?search={{ params.search|url_encode }}&role={{ params.role|url_encode }}&statut={{ params.statut|url_encode }}&dateDebut={{ params.dateDebut|url_encode }}&dateFin={{ params.dateFin|url_encode }}&sort={{ params.sort }}&direction={{ params.direction }}&page={{ p }}&perPage={{ params.perPage }}
{%- endmacro %}

{% import _self as self %}

{% block content %}
<style>
  /* ══ Keyframes ══════════════════════════════════════════════════════ */
  @keyframes fadeUp  { from { opacity:0; transform:translateY(14px); } to { opacity:1; transform:none; } }
  @keyframes fadeIn  { from { opacity:0; } to { opacity:1; } }
  @keyframes shimmer { 0%,100%{opacity:.55} 50%{opacity:1} }
  @keyframes rowIn   { from { opacity:0; transform:translateX(-6px); } to { opacity:1; transform:none; } }
  @keyframes spin    { to { transform:rotate(360deg); } }

  /* ══ Hero ═══════════════════════════════════════════════════════════ */
  .users-hero {
    position: relative;
    background: linear-gradient(135deg, #1B4332 0%, #2D6A4F 55%, #7B5EA7 100%);
    border-radius: 20px; padding: 30px 34px; margin-bottom: 20px;
    overflow: hidden; animation: fadeUp .4s cubic-bezier(.22,1,.36,1) both;
    box-shadow: 0 8px 32px rgba(27,67,50,.22);
  }
  .users-hero::before {
    content:''; position:absolute; width:280px; height:280px; border-radius:50%;
    background:rgba(255,255,255,.055); top:-80px; right:-60px; pointer-events:none;
  }
  .users-hero::after {
    content:''; position:absolute; width:140px; height:140px; border-radius:50%;
    background:rgba(255,255,255,.04); bottom:-40px; right:240px; pointer-events:none;
  }
  .hero-dots { position:absolute; top:16px; left:30px; display:flex; gap:6px; }
  .hero-dots span { width:7px; height:7px; border-radius:50%; background:rgba(255,255,255,.32); animation:shimmer 2s ease-in-out infinite; }
  .hero-dots span:nth-child(2){animation-delay:.3s} .hero-dots span:nth-child(3){animation-delay:.6s}

  .hero-body { display:flex; align-items:center; gap:24px; position:relative; z-index:1; margin-top:8px; }
  .hero-icon {
    width:64px; height:64px; border-radius:18px; flex-shrink:0;
    background:rgba(255,255,255,.13); border:1.5px solid rgba(255,255,255,.2);
    display:grid; place-items:center; backdrop-filter:blur(4px);
  }
  .hero-icon svg { width:28px; height:28px; color:#fff; }
  .hero-text { flex:1; }
  .hero-title { font-family:'Playfair Display',serif; font-size:1.6rem; font-weight:700; color:#fff; margin-bottom:6px; }
  .hero-sub { font-size:.84rem; color:rgba(255,255,255,.7); display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
  .hero-chip {
    display:inline-flex; align-items:center; gap:5px;
    background:rgba(255,255,255,.12); border:1px solid rgba(255,255,255,.2);
    border-radius:99px; padding:3px 10px; font-size:.73rem; font-weight:600; color:rgba(255,255,255,.9);
  }
  .hero-chip svg { width:11px; height:11px; }
  .btn-new-user {
    display:inline-flex; align-items:center; gap:9px;
    padding:12px 22px; border-radius:13px; background:#fff; color:var(--green);
    font-family:'Outfit',sans-serif; font-size:.87rem; font-weight:700;
    text-decoration:none; white-space:nowrap; flex-shrink:0;
    box-shadow:0 4px 18px rgba(0,0,0,.14);
    transition:transform .2s cubic-bezier(.22,1,.36,1), box-shadow .2s;
    position:relative; overflow:hidden;
  }
  .btn-new-user:hover { transform:translateY(-2px); box-shadow:0 8px 28px rgba(0,0,0,.22); }
  .btn-new-user-icon { width:27px; height:27px; border-radius:8px; background:var(--green-pale); display:grid; place-items:center; }
  .btn-new-user-icon svg { width:14px; height:14px; color:var(--green); }

  /* ══ Boutons export ═════════════════════════════════════════════════ */
  .export-group { display:flex; gap:8px; flex-shrink:0; }
  .btn-export {
    display:inline-flex; align-items:center; gap:8px;
    padding:10px 17px; border-radius:12px;
    font-family:'Outfit',sans-serif; font-size:.82rem; font-weight:700;
    text-decoration:none; white-space:nowrap; flex-shrink:0;
    transition:transform .2s cubic-bezier(.22,1,.36,1), box-shadow .2s, background .2s;
    border: 2px solid transparent;
  }
  .btn-export-icon { width:26px; height:26px; border-radius:8px; display:grid; place-items:center; flex-shrink:0; }
  .btn-export-icon svg { width:13px; height:13px; }
  .btn-export-csv {
    background:rgba(255,255,255,.13); border-color:rgba(255,255,255,.3);
    color:#fff; box-shadow:0 2px 10px rgba(0,0,0,.1);
  }
  .btn-export-csv .btn-export-icon { background:rgba(82,183,136,.35); }
  .btn-export-csv .btn-export-icon svg { color:#fff; }
  .btn-export-csv:hover { background:rgba(255,255,255,.22); border-color:rgba(255,255,255,.5); transform:translateY(-2px); box-shadow:0 6px 20px rgba(0,0,0,.18); }
  .btn-export-pdf {
    background:rgba(123,94,167,.25); border-color:rgba(180,150,220,.45);
    color:#fff; box-shadow:0 2px 10px rgba(0,0,0,.1);
  }
  .btn-export-pdf .btn-export-icon { background:rgba(123,94,167,.45); }
  .btn-export-pdf .btn-export-icon svg { color:#fff; }
  .btn-export-pdf:hover { background:rgba(123,94,167,.4); border-color:rgba(200,170,240,.6); transform:translateY(-2px); box-shadow:0 6px 20px rgba(123,94,167,.3); }
  .export-tooltip-wrap { position:relative; display:inline-flex; }
  .export-tooltip {
    display:none; position:absolute; bottom:calc(100% + 8px); left:50%;
    transform:translateX(-50%); background:#1A1A2E; color:#fff;
    font-size:.67rem; font-weight:500; line-height:1.4; white-space:nowrap;
    padding:5px 10px; border-radius:8px; box-shadow:0 4px 14px rgba(0,0,0,.25);
    pointer-events:none; z-index:99;
  }
  .export-tooltip::after { content:''; position:absolute; top:100%; left:50%; transform:translateX(-50%); border:5px solid transparent; border-top-color:#1A1A2E; }
  .export-tooltip-wrap:hover .export-tooltip { display:block; animation:fadeIn .15s ease; }

  /* ══ Panneau filtres ════════════════════════════════════════════════ */
  .filters-panel {
    background:var(--white); border:1.5px solid var(--border); border-radius:18px;
    padding:0; margin-bottom:16px; overflow:hidden;
    box-shadow:var(--shadow-card); animation:fadeUp .4s cubic-bezier(.22,1,.36,1) .06s both;
  }
  .filters-top {
    display:flex; align-items:center; gap:12px; padding:14px 18px;
    border-bottom:1.5px solid var(--border); flex-wrap:wrap;
  }
  .filter-search {
    flex:1; min-width:220px; display:flex; align-items:center; gap:9px;
    background:var(--bg); border:1.5px solid var(--border);
    border-radius:10px; padding:9px 14px;
    transition:border-color .2s, box-shadow .2s;
  }
  .filter-search:focus-within { border-color:var(--green-light); box-shadow:0 0 0 3px rgba(82,183,136,.1); }
  .filter-search svg { width:14px; height:14px; color:var(--text-sec); flex-shrink:0; }
  .filter-search input {
    border:none; background:none; outline:none;
    font-family:'Outfit',sans-serif; font-size:.85rem; color:var(--text); width:100%;
  }
  .filter-search input::placeholder { color:var(--text-sec); }

  .filter-select {
    padding:9px 13px; border:1.5px solid var(--border); border-radius:10px;
    background:var(--bg); font-family:'Outfit',sans-serif; font-size:.83rem; color:var(--text);
    outline:none; cursor:pointer; transition:border-color .2s; min-width:148px;
  }
  .filter-select:focus { border-color:var(--green-light); }

  .filters-advanced {
    display:none; padding:14px 18px; gap:14px; flex-wrap:wrap; align-items:flex-end;
    border-top:1.5px solid var(--border); background:#FAFBFC;
  }
  .filters-advanced.open { display:flex; }

  .filter-group { display:flex; flex-direction:column; gap:5px; }
  .filter-label { font-size:.71rem; font-weight:700; color:var(--text-sec); letter-spacing:.5px; text-transform:uppercase; }
  .filter-date { padding:8px 12px; border:1.5px solid var(--border); border-radius:10px; background:var(--bg); font-family:'Outfit',sans-serif; font-size:.83rem; color:var(--text); outline:none; transition:border-color .2s; }
  .filter-date:focus { border-color:var(--green-light); }

  .filters-footer {
    display:flex; align-items:center; gap:10px; padding:10px 18px;
    border-top:1.5px solid var(--border);
    justify-content:space-between; flex-wrap:wrap;
  }
  .filter-info { font-size:.8rem; color:var(--text-sec); }
  .filter-info strong { color:var(--text); font-weight:700; }
  .filter-info .active-filters { display:inline-flex; gap:6px; flex-wrap:wrap; margin-left:8px; }
  .filter-tag {
    display:inline-flex; align-items:center; gap:4px;
    background:var(--green-pale); color:var(--green);
    font-size:.69rem; font-weight:700; border-radius:99px; padding:2px 8px;
  }
  .filter-tag button { background:none; border:none; cursor:pointer; color:inherit; font-size:.75rem; line-height:1; padding:0 0 0 2px; }

  .btn-filter-toggle {
    display:inline-flex; align-items:center; gap:6px;
    padding:8px 14px; border-radius:9px; border:1.5px solid var(--border);
    background:var(--white); font-family:'Outfit',sans-serif; font-size:.82rem; font-weight:600;
    color:var(--text-sec); cursor:pointer; transition:all .2s; white-space:nowrap;
  }
  .btn-filter-toggle svg { width:14px; height:14px; }
  .btn-filter-toggle:hover { border-color:var(--green-light); color:var(--green); }
  .btn-filter-toggle.active { background:var(--green-pale); border-color:var(--green-light); color:var(--green); }
  .btn-filter-toggle .badge-count { background:var(--green); color:#fff; font-size:.6rem; border-radius:99px; padding:1px 6px; font-weight:700; }

  .btn-reset {
    display:inline-flex; align-items:center; gap:5px;
    padding:8px 12px; border-radius:9px; border:1.5px solid #FCA5A5;
    background:#FEF2F2; font-family:'Outfit',sans-serif; font-size:.82rem; font-weight:600;
    color:#DC2626; cursor:pointer; transition:all .2s; text-decoration:none;
  }
  .btn-reset:hover { background:#FEE2E2; }
  .btn-reset svg { width:13px; height:13px; }

  /* ══ Tableau ════════════════════════════════════════════════════════ */
  .table-card {
    background:var(--white); border:1.5px solid var(--border); border-radius:18px;
    overflow:hidden; box-shadow:var(--shadow-card);
    animation:fadeUp .4s cubic-bezier(.22,1,.36,1) .12s both;
  }
  table { width:100%; border-collapse:collapse; }
  thead { background:var(--bg); }
  thead th {
    padding:12px 16px; text-align:left;
    font-size:.69rem; font-weight:700; color:var(--text-sec);
    text-transform:uppercase; letter-spacing:.9px;
    border-bottom:1.5px solid var(--border); white-space:nowrap; user-select:none;
  }
  th.sortable { cursor:pointer; transition:color .18s; }
  th.sortable:hover { color:var(--green); }
  .sort-icon { display:inline-flex; flex-direction:column; gap:1px; margin-left:5px; vertical-align:middle; }
  .sort-icon span { width:0; height:0; border-left:4px solid transparent; border-right:4px solid transparent; opacity:.3; }
  .sort-icon .up   { border-bottom:4px solid currentColor; }
  .sort-icon .down { border-top:4px solid currentColor; }
  th.sort-asc  .sort-icon .up   { opacity:1; }
  th.sort-desc .sort-icon .down { opacity:1; }

  tbody tr {
    border-bottom:1px solid var(--border); transition:background .15s;
    animation:rowIn .28s ease both;
  }
  tbody tr:last-child { border-bottom:none; }
  tbody tr:hover { background:var(--green-hover); }
  td { padding:13px 16px; vertical-align:middle; font-size:.845rem; }

  .user-cell { display:flex; align-items:center; gap:11px; }
  .user-avatar {
    width:36px; height:36px; border-radius:50%; flex-shrink:0;
    display:grid; place-items:center; font-size:.76rem; font-weight:800; color:#fff;
    overflow:hidden; border:2px solid rgba(255,255,255,.6); box-shadow:0 2px 8px rgba(0,0,0,.1);
  }
  .user-avatar img { width:100%; height:100%; object-fit:cover; }
  .user-name  { font-weight:700; color:var(--text); font-size:.85rem; }
  .user-email { font-size:.73rem; color:var(--text-sec); margin-top:1px; }

  .role-badge {
    display:inline-flex; align-items:center; gap:5px;
    font-size:.68rem; font-weight:700; border-radius:99px; padding:4px 10px; letter-spacing:.3px;
  }
  .role-badge::before { content:''; width:5px; height:5px; border-radius:50%; }
  .role-PATIENT     { background:#EDE9F6; color:#7B5EA7; } .role-PATIENT::before     { background:#7B5EA7; }
  .role-PSYCHOLOGUE { background:#E0F2F1; color:#00897B; } .role-PSYCHOLOGUE::before { background:#00897B; }
  .role-COACH       { background:#FFF3E0; color:#E65100; } .role-COACH::before       { background:#E65100; }
  .role-ADMIN       { background:#D8F3DC; color:#1B4332; } .role-ADMIN::before       { background:#1B4332; }
  .role-USER        { background:#E3F2FD; color:#1565C0; } .role-USER::before        { background:#1565C0; }

  .status-badge {
    display:inline-flex; align-items:center; gap:5px;
    font-size:.71rem; font-weight:600; border-radius:99px; padding:4px 10px;
  }
  .status-badge::before { content:''; width:5px; height:5px; border-radius:50%; }
  .status-active   { background:#D8F3DC; color:#1B4332; } .status-active::before   { background:#1B4332; }
  .status-inactive { background:#FEE2E2; color:#991B1B; } .status-inactive::before { background:#991B1B; }

  /* ══ Boutons d'action ══════════════════════════════════════════════ */
  .actions-cell { display:flex; align-items:center; gap:5px; justify-content:center; }
  .action-btn {
    width:30px; height:30px; border-radius:8px; border:1.5px solid var(--border);
    background:var(--white); display:grid; place-items:center;
    cursor:pointer; transition:all .17s; text-decoration:none; flex-shrink:0;
  }
  .action-btn svg { width:13px; height:13px; }

  /* Voir le profil */
  .action-btn.view  { color:var(--violet); }
  .action-btn.view:hover  { background:var(--violet-pale); border-color:var(--violet); }

  /* Modifier */
  .action-btn.edit  { color:var(--green); }
  .action-btn.edit:hover  { background:var(--green-pale); border-color:var(--green-light); }

  /* Toggle statut — Activer */
  .action-btn.activate { color:#059669; }
  .action-btn.activate:hover { background:#D1FAE5; border-color:#6EE7B7; }

  /* Toggle statut — Désactiver */
  .action-btn.deactivate { color:#F59E0B; }
  .action-btn.deactivate:hover { background:#FEF3C7; border-color:#FCD34D; }

  /* Supprimer */
  .action-btn.del   { color:#EF4444; }
  .action-btn.del:hover   { background:#FEF2F2; border-color:#FCA5A5; }

  /* Tooltip natif amélioré */
  .action-btn[title] { position:relative; }

  /* ══ Empty state ════════════════════════════════════════════════════ */
  .empty-state { text-align:center; padding:56px 20px; animation:fadeIn .4s ease both; }
  .empty-icon  { width:60px; height:60px; border-radius:16px; background:var(--green-pale); display:grid; place-items:center; margin:0 auto 16px; font-size:1.5rem; }
  .empty-title { font-size:1rem; font-weight:700; color:var(--text); margin-bottom:6px; }
  .empty-sub   { font-size:.82rem; color:var(--text-sec); }

  /* ══ Pagination ═════════════════════════════════════════════════════ */
  .pagination-bar {
    display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;
    padding:14px 18px; border-top:1.5px solid var(--border); background:#FAFBFC;
  }
  .pag-info { font-size:.8rem; color:var(--text-sec); }
  .pag-info strong { color:var(--text); font-weight:700; }

  .pag-pages { display:flex; align-items:center; gap:5px; }
  .pag-btn {
    min-width:32px; height:32px; border-radius:8px; border:1.5px solid var(--border);
    background:var(--white); font-family:'Outfit',sans-serif; font-size:.82rem; font-weight:600;
    color:var(--text-sec); cursor:pointer; transition:all .17s;
    display:inline-flex; align-items:center; justify-content:center; padding:0 8px;
    text-decoration:none; user-select:none;
  }
  .pag-btn:hover:not(.disabled):not(.active) { border-color:var(--green-light); color:var(--green); background:var(--green-hover); }
  .pag-btn.active { background:var(--green); border-color:var(--green); color:#fff; font-weight:700; pointer-events:none; }
  .pag-btn.disabled { opacity:.38; pointer-events:none; }
  .pag-btn svg { width:13px; height:13px; }

  .pag-perpage { display:flex; align-items:center; gap:8px; font-size:.8rem; color:var(--text-sec); }
  .pag-perpage select {
    padding:5px 10px; border:1.5px solid var(--border); border-radius:8px;
    background:var(--white); font-family:'Outfit',sans-serif; font-size:.8rem; color:var(--text);
    outline:none; cursor:pointer;
  }

  /* ══ Modale suppression ═════════════════════════════════════════════ */
  .modal-overlay {
    position:fixed; inset:0; z-index:1000;
    background:rgba(0,0,0,.42); backdrop-filter:blur(3px);
    display:none; align-items:center; justify-content:center;
  }
  .modal-overlay.open { display:flex; animation:fadeIn .18s ease both; }
  .modal-box {
    background:var(--white); border-radius:20px; padding:30px;
    max-width:390px; width:90%; text-align:center;
    box-shadow:0 24px 64px rgba(0,0,0,.22);
    animation:fadeUp .28s cubic-bezier(.22,1,.36,1) both;
  }
  .modal-icon { width:52px; height:52px; border-radius:14px; display:grid; place-items:center; margin:0 auto 14px; }
  .modal-icon.danger  { background:#FEF2F2; }
  .modal-icon.danger svg { width:24px; height:24px; color:#EF4444; }
  .modal-icon.warning { background:#FEF3C7; }
  .modal-icon.warning svg { width:24px; height:24px; color:#D97706; }
  .modal-icon.success { background:#D1FAE5; }
  .modal-icon.success svg { width:24px; height:24px; color:#059669; }
  .modal-title { font-size:1rem; font-weight:800; color:var(--text); margin-bottom:7px; }
  .modal-sub   { font-size:.82rem; color:var(--text-sec); margin-bottom:20px; line-height:1.6; }
  .modal-actions { display:flex; gap:10px; justify-content:center; }
  .modal-cancel  { padding:9px 20px; border-radius:9px; border:1.5px solid var(--border); background:var(--white); font-family:'Outfit',sans-serif; font-size:.875rem; font-weight:600; cursor:pointer; color:var(--text-sec); transition:all .2s; }
  .modal-cancel:hover { border-color:var(--text-sec); }
  .modal-confirm-del    { padding:9px 20px; border-radius:9px; border:none; background:#EF4444; color:#fff; font-family:'Outfit',sans-serif; font-size:.875rem; font-weight:700; cursor:pointer; transition:background .2s; }
  .modal-confirm-del:hover { background:#DC2626; }
  .modal-confirm-toggle { padding:9px 20px; border-radius:9px; border:none; color:#fff; font-family:'Outfit',sans-serif; font-size:.875rem; font-weight:700; cursor:pointer; transition:background .2s; }
  .modal-confirm-toggle.activate   { background:#059669; }
  .modal-confirm-toggle.activate:hover { background:#047857; }
  .modal-confirm-toggle.deactivate { background:#D97706; }
  .modal-confirm-toggle.deactivate:hover { background:#B45309; }

  /* Spinner recherche */
  .search-spinner { display:none; }
  .search-spinner.active { display:block; animation:spin .7s linear infinite; }

  /* ══════════════════════════════════════════════════════════════════
     SYSTÈME DE NOTIFICATIONS
  ══════════════════════════════════════════════════════════════════ */
  @keyframes notifSlideIn {
    from { opacity:0; transform:translateY(-10px) scale(.97); }
    to   { opacity:1; transform:none; }
  }
  @keyframes notifItemIn {
    from { opacity:0; transform:translateX(10px); }
    to   { opacity:1; transform:none; }
  }
  @keyframes badgePop {
    0%   { transform:scale(1); }
    40%  { transform:scale(1.45); }
    70%  { transform:scale(.88); }
    100% { transform:scale(1); }
  }
  @keyframes ringShake {
    0%,100%{ transform:rotate(0); }
    20%    { transform:rotate(14deg); }
    40%    { transform:rotate(-10deg); }
    60%    { transform:rotate(8deg); }
    80%    { transform:rotate(-5deg); }
  }

  /* ── Bouton cloche ── */
  .notif-btn-wrap { position:relative; display:inline-flex; flex-shrink:0; }
  .notif-btn {
    width:44px; height:44px; border-radius:13px;
    background:rgba(255,255,255,.15); border:1.5px solid rgba(255,255,255,.28);
    display:grid; place-items:center; cursor:pointer;
    transition:background .2s, border-color .2s, transform .2s cubic-bezier(.22,1,.36,1);
    position:relative; backdrop-filter:blur(4px);
  }
  .notif-btn:hover { background:rgba(255,255,255,.24); border-color:rgba(255,255,255,.48); transform:translateY(-1px); }
  .notif-btn.active { background:rgba(255,255,255,.26); border-color:rgba(255,255,255,.55); }
  .notif-btn svg { width:20px; height:20px; color:#fff; transition:transform .3s; }
  .notif-btn:hover svg, .notif-btn.ringing svg { animation:ringShake .45s ease both; }

  /* Badge compteur */
  .notif-badge {
    position:absolute; top:-6px; right:-6px;
    min-width:18px; height:18px; border-radius:99px;
    background:linear-gradient(135deg, #FF6B6B, #EF4444);
    color:#fff; font-size:.6rem; font-weight:800;
    display:none; align-items:center; justify-content:center;
    padding:0 4px; border:2px solid rgba(27,67,50,1);
    box-shadow:0 2px 8px rgba(239,68,68,.5);
    font-family:'Outfit',sans-serif; letter-spacing:.3px;
  }
  .notif-badge.visible { display:flex; animation:badgePop .35s cubic-bezier(.22,1,.36,1) both; }

  /* ── Panneau déroulant — FIXED pour déborder du hero ── */
  .notif-panel {
    position: fixed;
    width: 380px;
    border-radius: 18px;
    background: #fff;
    border: 1.5px solid rgba(0,0,0,.08);
    box-shadow: 0 24px 70px rgba(0,0,0,.2), 0 4px 20px rgba(0,0,0,.1);
    z-index: 99999;
    display: none;
    flex-direction: column;
    overflow: hidden;
    animation: notifSlideIn .22s cubic-bezier(.22,1,.36,1) both;
    /* top/right positionnés dynamiquement par JS */
  }
  .notif-panel.open { display: flex; }

  /* En-tête du panneau */
  .notif-header {
    display:flex; align-items:center; justify-content:space-between;
    padding:16px 18px 12px; border-bottom:1.5px solid #F0F0F0;
    background:linear-gradient(135deg, #1B4332 0%, #2D6A4F 60%, #7B5EA7 100%);
  }
  .notif-header-left { display:flex; align-items:center; gap:10px; }
  .notif-header-icon {
    width:34px; height:34px; border-radius:10px;
    background:rgba(255,255,255,.15); display:grid; place-items:center;
  }
  .notif-header-icon svg { width:16px; height:16px; color:#fff; }
  .notif-header-title { font-family:'Outfit',sans-serif; font-size:.92rem; font-weight:700; color:#fff; }
  .notif-header-count {
    font-size:.68rem; color:rgba(255,255,255,.7); font-weight:500; margin-top:1px;
  }
  .notif-header-actions { display:flex; align-items:center; gap:6px; }
  .notif-clear-btn {
    padding:5px 10px; border-radius:7px; border:1.5px solid rgba(255,255,255,.3);
    background:rgba(255,255,255,.1); color:rgba(255,255,255,.85);
    font-family:'Outfit',sans-serif; font-size:.68rem; font-weight:600;
    cursor:pointer; transition:all .18s; white-space:nowrap;
  }
  .notif-clear-btn:hover { background:rgba(255,255,255,.22); border-color:rgba(255,255,255,.55); }
  .notif-close-btn {
    width:28px; height:28px; border-radius:7px; border:1.5px solid rgba(255,255,255,.25);
    background:rgba(255,255,255,.1); color:rgba(255,255,255,.8);
    display:grid; place-items:center; cursor:pointer; transition:all .18s;
  }
  .notif-close-btn:hover { background:rgba(255,255,255,.22); }
  .notif-close-btn svg { width:12px; height:12px; }

  /* Corps — liste */
  .notif-body { max-height:370px; overflow-y:auto; flex:1; }
  .notif-body::-webkit-scrollbar { width:4px; }
  .notif-body::-webkit-scrollbar-track { background:transparent; }
  .notif-body::-webkit-scrollbar-thumb { background:#D4D4D4; border-radius:99px; }

  /* Item de notification */
  .notif-item {
    display:flex; align-items:flex-start; gap:12px;
    padding:13px 17px; border-bottom:1px solid #F5F5F5;
    transition:background .15s; cursor:default;
    animation:notifItemIn .2s ease both;
  }
  .notif-item:last-child { border-bottom:none; }
  .notif-item:hover { background:#FAFAFA; }
  .notif-item.unread { background:#F0FDF4; }
  .notif-item.unread:hover { background:#DCFCE7; }

  .notif-item-icon {
    width:36px; height:36px; border-radius:10px; flex-shrink:0;
    display:grid; place-items:center; margin-top:1px;
  }
  .notif-item-icon svg { width:16px; height:16px; }

  /* Couleurs par type */
  .notif-icon-add      { background:#D8F3DC; } .notif-icon-add svg      { color:#1B4332; }
  .notif-icon-edit     { background:#E0F2FE; } .notif-icon-edit svg     { color:#0369A1; }
  .notif-icon-delete   { background:#FEE2E2; } .notif-icon-delete svg   { color:#DC2626; }
  .notif-icon-activate { background:#D1FAE5; } .notif-icon-activate svg { color:#059669; }
  .notif-icon-deactivate { background:#FEF3C7; } .notif-icon-deactivate svg { color:#D97706; }
  .notif-icon-export   { background:#EDE9F6; } .notif-icon-export svg   { color:#7B5EA7; }

  .notif-item-body { flex:1; min-width:0; }
  .notif-item-title { font-family:'Outfit',sans-serif; font-size:.815rem; font-weight:700; color:#1A1A2E; line-height:1.35; }
  .notif-item-desc  { font-size:.75rem; color:#6B7280; margin-top:2px; line-height:1.4; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .notif-item-time  { font-size:.67rem; color:#9CA3AF; margin-top:4px; display:flex; align-items:center; gap:4px; }
  .notif-item-time svg { width:10px; height:10px; }

  /* Unread dot */
  .notif-unread-dot {
    width:7px; height:7px; border-radius:50%;
    background:linear-gradient(135deg,#52B788,#1B4332);
    flex-shrink:0; margin-top:6px;
    box-shadow:0 0 0 2px rgba(82,183,136,.2);
  }

  /* Empty state */
  .notif-empty {
    display:flex; flex-direction:column; align-items:center;
    padding:44px 20px; text-align:center;
  }
  .notif-empty-icon { font-size:2.2rem; margin-bottom:10px; }
  .notif-empty-title { font-family:'Outfit',sans-serif; font-size:.9rem; font-weight:700; color:#374151; margin-bottom:4px; }
  .notif-empty-sub   { font-size:.77rem; color:#9CA3AF; }

  /* Footer du panneau */
  .notif-footer {
    padding:10px 17px; border-top:1.5px solid #F0F0F0;
    display:flex; align-items:center; justify-content:space-between;
    background:#FAFBFC;
  }
  .notif-footer-info { font-size:.72rem; color:#9CA3AF; }
  .notif-mark-all {
    font-size:.72rem; font-weight:700; color:#2D6A4F; cursor:pointer;
    background:none; border:none; font-family:'Outfit',sans-serif;
    padding:0; transition:color .15s;
  }
  .notif-mark-all:hover { color:#1B4332; text-decoration:underline; }
</style>

{# ── Paramètres transmis aux macros ─────────────────────────────────────── #}
{% set p = {
  search:    search,
  role:      role,
  statut:    statut,
  dateDebut: dateDebut,
  dateFin:   dateFin,
  sort:      sort,
  direction: direction,
  perPage:   perPage,
} %}

{# Compte des filtres avancés actifs #}
{% set advancedCount = (statut != '' ? 1 : 0) + (dateDebut != '' ? 1 : 0) + (dateFin != '' ? 1 : 0) %}

