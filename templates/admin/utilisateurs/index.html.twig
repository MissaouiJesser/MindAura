</div>

{# ════════════════════════════════════════════════════════════════════════
   PANNEAU FILTRES
════════════════════════════════════════════════════════════════════════ #}
<form method="GET" action="{{ path('app_admin_utilisateurs') }}" class="filters-panel" id="filterForm" autocomplete="off">

  {# Champs cachés : tri et pagination conservés #}
  <input type="hidden" name="sort"      value="{{ sort }}"/>
  <input type="hidden" name="direction" value="{{ direction }}"/>
  <input type="hidden" name="page"      value="1"/>
  <input type="hidden" name="perPage"   value="{{ perPage }}"/>

  {# ── Ligne principale ── #}
  <div class="filters-top">

    {# Recherche textuelle #}
    <div class="filter-search">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="9" cy="9" r="5.5"/><path d="M16 16l-3-3" stroke-linecap="round"/></svg>
      <input type="text" name="search" id="searchInput"
             placeholder="Nom, prénom, email, téléphone…"
             value="{{ search }}"/>
      <svg class="search-spinner" id="searchSpinner" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M10 3a7 7 0 017 7" stroke-linecap="round"/>
      </svg>
    </div>

    {# Filtre rôle #}
    <select name="role" class="filter-select" id="roleSelect">
      <option value="">Tous les rôles</option>
      <option value="ROLE_PATIENT"     {{ role == 'ROLE_PATIENT'     ? 'selected' }}>👤 Patients</option>
      <option value="ROLE_PSYCHOLOGUE" {{ role == 'ROLE_PSYCHOLOGUE' ? 'selected' }}>🧠 Psychologues</option>
      <option value="ROLE_COACH"       {{ role == 'ROLE_COACH'       ? 'selected' }}>💪 Coachs</option>
      <option value="ROLE_ADMIN"       {{ role == 'ROLE_ADMIN'       ? 'selected' }}>🛡 Administrateurs</option>
      <option value="ROLE_USER"        {{ role == 'ROLE_USER'        ? 'selected' }}>🔵 Utilisateurs</option>
    </select>

    {# Bouton filtres avancés #}
    <button type="button" class="btn-filter-toggle {{ advancedCount > 0 ? 'active' : '' }}" id="toggleAdvanced">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 6h12M7 10h6M9 14h2" stroke-linecap="round"/></svg>
      Filtres avancés
      {% if advancedCount > 0 %}
        <span class="badge-count">{{ advancedCount }}</span>
      {% endif %}
    </button>

    {# Réinitialiser (visible si au moins un filtre actif) #}
    {% if search or role or statut or dateDebut or dateFin %}
      <a href="{{ path('app_admin_utilisateurs') }}" class="btn-reset">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4l12 12M16 4L4 16" stroke-linecap="round"/></svg>
        Réinitialiser
      </a>
    {% endif %}

  </div>

  {# ── Filtres avancés (statut + dates) ── #}
  <div class="filters-advanced {{ advancedCount > 0 ? 'open' : '' }}" id="advancedPanel">

    <div class="filter-group">
      <span class="filter-label">Statut du compte</span>
      <select name="statut" class="filter-select">
        <option value="">Tous</option>
        <option value="1" {{ statut == '1' ? 'selected' }}>✅ Actif</option>
        <option value="0" {{ statut == '0' ? 'selected' }}>🔴 Inactif</option>
      </select>
    </div>

    <div class="filter-group">
      <span class="filter-label">Inscrit après le</span>
      <input type="date" name="dateDebut" class="filter-date" value="{{ dateDebut }}"/>
    </div>

    <div class="filter-group">
      <span class="filter-label">Inscrit avant le</span>
      <input type="date" name="dateFin"   class="filter-date" value="{{ dateFin }}"/>
    </div>

    <div class="filter-group" style="justify-content:flex-end">
      <button type="submit" style="padding:9px 18px;border-radius:10px;background:var(--green);color:#fff;border:none;font-family:'Outfit',sans-serif;font-size:.84rem;font-weight:700;cursor:pointer;transition:background .2s">
        Appliquer
      </button>
    </div>

  </div>

  {# ── Pied : résumé des filtres actifs ── #}
  <div class="filters-footer">
    <div class="filter-info">
      <strong>{{ utilisateurs|length }}</strong> sur <strong>{{ total }}</strong> utilisateurs
      {% if search or role or statut or dateDebut or dateFin %}
        <span class="active-filters">
          {% if search %}
            <span class="filter-tag">
              🔍 "{{ search }}"
              <button type="button" onclick="clearField('search')">×</button>
            </span>
          {% endif %}
          {% if role %}
            {% set roleLabels = {'ROLE_PATIENT':'Patient','ROLE_PSYCHOLOGUE':'Psychologue','ROLE_COACH':'Coach','ROLE_ADMIN':'Admin','ROLE_USER':'Utilisateur'} %}
            <span class="filter-tag">
              {{ roleLabels[role] ?? role }}
              <button type="button" onclick="clearField('role')">×</button>
            </span>
          {% endif %}
          {% if statut != '' %}
            <span class="filter-tag">
              {{ statut == '1' ? 'Actif' : 'Inactif' }}
              <button type="button" onclick="clearField('statut')">×</button>
            </span>
          {% endif %}
          {% if dateDebut %}
            <span class="filter-tag">
              Après {{ dateDebut }}
              <button type="button" onclick="clearField('dateDebut')">×</button>
            </span>
          {% endif %}
          {% if dateFin %}
            <span class="filter-tag">
              Avant {{ dateFin }}
              <button type="button" onclick="clearField('dateFin')">×</button>
            </span>
          {% endif %}
        </span>
      {% endif %}
    </div>
  </div>

</form>

{# ════════════════════════════════════════════════════════════════════════
   TABLEAU
════════════════════════════════════════════════════════════════════════ #}
<div class="table-card">
  {% if utilisateurs is empty %}
    <div class="empty-state">
      <div class="empty-icon">🔍</div>
      <div class="empty-title">Aucun utilisateur trouvé</div>
      <div class="empty-sub">
        {% if search or role or statut or dateDebut or dateFin %}
          Essayez d'élargir vos critères de recherche.
        {% else %}
          Aucun utilisateur n'a encore été créé.
        {% endif %}
      </div>
    </div>
  {% else %}

    <table>
      <thead>
        <tr>

          {# ── Macro locale : en-tête de colonne triable ── #}
          {% macro th(label, col, currentSort, currentDir, p) %}
            {% set isActive = (col == currentSort) %}
            {% set newDir = (isActive and currentDir == 'ASC') ? 'DESC' : 'ASC' %}
            {% set url = '?search=' ~ p.search|url_encode
              ~ '&role='      ~ p.role|url_encode
              ~ '&statut='    ~ p.statut|url_encode
              ~ '&dateDebut=' ~ p.dateDebut|url_encode
              ~ '&dateFin='   ~ p.dateFin|url_encode
              ~ '&sort='      ~ col
              ~ '&direction=' ~ newDir
              ~ '&page=1&perPage=' ~ p.perPage %}
            <th class="sortable {{ isActive ? (currentDir == 'ASC' ? 'sort-asc' : 'sort-desc') : '' }}"
                onclick="window.location='{{ url }}'">
              {{ label }}
              <span class="sort-icon">
                <span class="up"></span>
                <span class="down"></span>
              </span>
            </th>
          {% endmacro %}

          {% import _self as m %}
          {{ m.th('Utilisateur', 'nom',         sort, direction, p) }}
          {{ m.th('Téléphone',   'telephone',    sort, direction, p) }}
          {{ m.th('Rôle',        'role',         sort, direction, p) }}
          {{ m.th('Naissance',   'naissance',    sort, direction, p) }}
          {{ m.th('Inscription', 'inscription',  sort, direction, p) }}
          {{ m.th('Statut',      'statut',       sort, direction, p) }}
          <th style="text-align:center">Actions</th>
        </tr>
      </thead>

      <tbody id="tableBody">
        {% set avatarColors = {
          'PATIENT':     '#7B5EA7',
          'PSYCHOLOGUE': '#00897B',
          'COACH':       '#E65100',
          'ADMIN':       '#1B4332',
          'USER':        '#1565C0',
        } %}
        {% set roleLabels = {
          'PATIENT':     'Patient',
          'PSYCHOLOGUE': 'Psychologue',
          'COACH':       'Coach',
          'ADMIN':       'Administrateur',
          'USER':        'Utilisateur',
        } %}

        {% for u in utilisateurs %}
          {% set roleKey = u.roleUtilisateur|replace({'ROLE_': ''}) %}
          {% set avatarBg = avatarColors[roleKey] ?? '#5A6475' %}

          <tr style="animation-delay:{{ loop.index0 * 0.03 }}s">

            {# Utilisateur #}
            <td>
              <div class="user-cell">
                <div class="user-avatar" style="background:{{ avatarBg }}">
                  {% if u.photoProfilUtilisateur != 'default.png' %}
                    <img src="{{ asset('avatars/' ~ u.photoProfilUtilisateur) }}" alt="avatar"/>
                  {% else %}
                    {{ u.prenomUtilisateur|first|upper }}{{ u.nomUtilisateur|first|upper }}
                  {% endif %}
                </div>
                <div>
                  <div class="user-name">{{ u.prenomUtilisateur }} {{ u.nomUtilisateur }}</div>
                  <div class="user-email">{{ u.emailUtilisateur }}</div>
                </div>
              </div>
            </td>

            {# Téléphone #}
            <td style="color:var(--text-sec)">{{ u.telephoneUtilisateur }}</td>

            {# Rôle #}
            <td>
              <span class="role-badge role-{{ roleKey }}">
                {{ roleLabels[roleKey] ?? roleKey }}
              </span>
            </td>

            {# Date de naissance #}
            <td style="color:var(--text-sec); font-size:.79rem">
              {{ u.dateNaissanceUtilisateur ? u.dateNaissanceUtilisateur|date('d/m/Y') : '—' }}
            </td>

            {# Date d'inscription #}
            <td style="color:var(--text-sec); font-size:.79rem">
              {{ u.dateInscriptionUtilisateur|date('d/m/Y') }}
            </td>

            {# Statut #}
            <td>
              <span class="status-badge {{ u.estActifUtilisateur ? 'status-active' : 'status-inactive' }}">
                {{ u.estActifUtilisateur ? 'Actif' : 'Inactif' }}
              </span>
            </td>

            {# Actions #}
            <td>
              <div class="actions-cell">

                {# ── Voir le profil ── #}
                <a href="{{ path('app_admin_utilisateurs_show', {id: u.idUtilisateur}) }}"
                   class="action-btn view" title="Voir le profil" data-spa>
                  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
                    <path d="M2 10s3-6 8-6 8 6 8 6-3 6-8 6-8-6-8-6z" stroke-linecap="round" stroke-linejoin="round"/>
                    <circle cx="10" cy="10" r="2.5"/>
                  </svg>
                </a>

                {# ── Modifier ── #}
                <a href="{{ path('app_admin_utilisateurs_edit', {id: u.idUtilisateur}) }}"
                   class="action-btn edit" title="Modifier" data-spa>
                  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
                    <path d="M14.5 2.5a2.12 2.12 0 013 3L6 17H3v-3L14.5 2.5z" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>

                {# ── Toggle statut ── #}
                {% if u.estActifUtilisateur %}
                  <button type="button"
                          class="action-btn deactivate"
                          title="Désactiver le compte"
                          onclick="openToggleModal({{ u.idUtilisateur }}, '{{ u.prenomUtilisateur|e('html_attr') }} {{ u.nomUtilisateur|e('html_attr') }}', false)">
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
                      <path d="M10 3v5M10 12v5M3 10h5m4 0h5" stroke-linecap="round"/>
                      <circle cx="10" cy="10" r="7"/>
                    </svg>
                  </button>
                {% else %}
                  <button type="button"
                          class="action-btn activate"
                          title="Activer le compte"
                          onclick="openToggleModal({{ u.idUtilisateur }}, '{{ u.prenomUtilisateur|e('html_attr') }} {{ u.nomUtilisateur|e('html_attr') }}', true)">
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
                      <path d="M7 10l2.5 2.5L14 7" stroke-linecap="round" stroke-linejoin="round"/>
                      <circle cx="10" cy="10" r="7"/>
                    </svg>
                  </button>
                {% endif %}

                {# ── Supprimer ── #}
                <button type="button" class="action-btn del" title="Supprimer"
                        onclick="openDeleteModal({{ u.idUtilisateur }}, '{{ u.prenomUtilisateur|e('html_attr') }} {{ u.nomUtilisateur|e('html_attr') }}')">
                  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
                    <path d="M4 5h12M8 5V3h4v2M6 5l1 11h6l1-11" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>

              </div>
            </td>

          </tr>
        {% endfor %}
      </tbody>
    </table>

    {# ════════════════════════════════════════════════════════════════
       BARRE DE PAGINATION
    ════════════════════════════════════════════════════════════════ #}
    {% if pages > 1 or utilisateurs|length > 0 %}
    <div class="pagination-bar">

      {# Info résultats #}
      <div class="pag-info">
        {% set from = ((page - 1) * perPage) + 1 %}
        {% set to   = min(page * perPage, total) %}
        <strong>{{ from }}–{{ to }}</strong> sur <strong>{{ total }}</strong>
      </div>

      {# Numéros de page #}
      <div class="pag-pages">

        {# Précédent #}
        {% if page > 1 %}
          <a class="pag-btn" href="{{ path('app_admin_utilisateurs') ~ self.pageUrl(page - 1, p) }}" data-spa>
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 5l-5 5 5 5" stroke-linecap="round"/></svg>
          </a>
        {% else %}
          <span class="pag-btn disabled">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 5l-5 5 5 5" stroke-linecap="round"/></svg>
          </span>
        {% endif %}

        {# Numéros — fenêtre glissante ±2 autour de la page courante #}
        {% set winStart = max(1, page - 2) %}
        {% set winEnd   = min(pages, page + 2) %}

        {% if winStart > 1 %}
          <a class="pag-btn" href="{{ path('app_admin_utilisateurs') ~ self.pageUrl(1, p) }}" data-spa>1</a>
          {% if winStart > 2 %}<span class="pag-btn disabled" style="border:none;background:none">…</span>{% endif %}
        {% endif %}

        {% for i in winStart..winEnd %}
          <a class="pag-btn {{ i == page ? 'active' : '' }}"
             href="{{ path('app_admin_utilisateurs') ~ self.pageUrl(i, p) }}"
             data-spa>{{ i }}</a>
        {% endfor %}

        {% if winEnd < pages %}
          {% if winEnd < pages - 1 %}<span class="pag-btn disabled" style="border:none;background:none">…</span>{% endif %}
          <a class="pag-btn" href="{{ path('app_admin_utilisateurs') ~ self.pageUrl(pages, p) }}" data-spa>{{ pages }}</a>
        {% endif %}

        {# Suivant #}
        {% if page < pages %}
          <a class="pag-btn" href="{{ path('app_admin_utilisateurs') ~ self.pageUrl(page + 1, p) }}" data-spa>
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 5l5 5-5 5" stroke-linecap="round"/></svg>
          </a>
        {% else %}
          <span class="pag-btn disabled">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 5l5 5-5 5" stroke-linecap="round"/></svg>
          </span>
        {% endif %}

      </div>

      {# Résultats par page #}
      <div class="pag-perpage">
        <span>Par page</span>
        <select onchange="changePerPage(this.value)">
          {% for n in [5, 10, 25, 50] %}
            <option value="{{ n }}" {{ perPage == n ? 'selected' }}>{{ n }}</option>
          {% endfor %}
        </select>
      </div>

    </div>
    {% endif %}

  {% endif %}
</div>

{# ════════════════════════════════════════════════════════════════════════
   TOKENS CSRF (générés côté serveur, utilisés par le JS)
════════════════════════════════════════════════════════════════════════ #}
<script>
const CSRF_DELETE = {
  {% for u in utilisateurs %}
    {{ u.idUtilisateur }}: '{{ csrf_token('delete_user_' ~ u.idUtilisateur) }}'{{ not loop.last ? ',' }}
  {% endfor %}
};
const CSRF_TOGGLE = {
  {% for u in utilisateurs %}
    {{ u.idUtilisateur }}: '{{ csrf_token('toggle_user_' ~ u.idUtilisateur) }}'{{ not loop.last ? ',' }}
  {% endfor %}
};
</script>

{# ════════════════════════════════════════════════════════════════════════
   MODALE SUPPRESSION
════════════════════════════════════════════════════════════════════════ #}
<div class="modal-overlay" id="deleteModal">
  <div class="modal-box">
    <div class="modal-icon danger">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
        <path d="M4 5h12M8 5V3h4v2M6 5l1 11h6l1-11" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <div class="modal-title">Supprimer l'utilisateur ?</div>
    <div class="modal-sub" id="deleteModalSub">Cette action est irréversible.</div>
    <div class="modal-actions">
      <button type="button" class="modal-cancel" onclick="closeDeleteModal()">Annuler</button>
      <form id="deleteForm" method="POST" style="display:contents">
        <input type="hidden" name="_token"   id="deleteToken"/>
        <input type="hidden" name="_referer" id="deleteReferer"/>
        <button type="submit" class="modal-confirm-del">Supprimer</button>
      </form>
    </div>
  </div>
</div>

{# ════════════════════════════════════════════════════════════════════════
   MODALE TOGGLE STATUT
════════════════════════════════════════════════════════════════════════ #}
<div class="modal-overlay" id="toggleModal">
  <div class="modal-box">
    <div class="modal-icon" id="toggleModalIcon">
      {# L'icône est injectée dynamiquement par JS #}
    </div>
    <div class="modal-title" id="toggleModalTitle">Modifier le statut ?</div>
    <div class="modal-sub"   id="toggleModalSub">Confirmer cette action.</div>
    <div class="modal-actions">
      <button type="button" class="modal-cancel" onclick="closeToggleModal()">Annuler</button>
      <form id="toggleForm" method="POST" style="display:contents">
        <input type="hidden" name="_token"   id="toggleToken"/>
        <input type="hidden" name="_referer" id="toggleReferer"/>
        <button type="submit" class="modal-confirm-toggle" id="toggleConfirmBtn">Confirmer</button>
      </form>
    </div>
  </div>
</div>

{% endblock %}

{% block javascripts %}
<script>
// ══════════════════════════════════════════════════════════════════════
//  MODALE SUPPRESSION
// ══════════════════════════════════════════════════════════════════════
function openDeleteModal(id, name) {
  document.getElementById('deleteForm').action    = `/admin/utilisateurs/${id}/delete`;
  document.getElementById('deleteToken').value    = CSRF_DELETE[id] ?? '';
  document.getElementById('deleteReferer').value  = window.location.href;
  document.getElementById('deleteModalSub').textContent =
    `Vous allez supprimer « ${name} ». Cette action est irréversible.`;
  document.getElementById('deleteModal').classList.add('open');
}
function closeDeleteModal() {
  document.getElementById('deleteModal').classList.remove('open');
}
document.getElementById('deleteModal').addEventListener('click', e => {
  if (e.target === e.currentTarget) closeDeleteModal();
});

// ══════════════════════════════════════════════════════════════════════
//  MODALE TOGGLE STATUT
// ══════════════════════════════════════════════════════════════════════
function openToggleModal(id, name, willActivate) {
  const icon    = document.getElementById('toggleModalIcon');
  const title   = document.getElementById('toggleModalTitle');
  const sub     = document.getElementById('toggleModalSub');
  const btn     = document.getElementById('toggleConfirmBtn');

  document.getElementById('toggleForm').action   = `/admin/utilisateurs/${id}/toggle`;
  document.getElementById('toggleToken').value   = CSRF_TOGGLE[id] ?? '';
  document.getElementById('toggleReferer').value = window.location.href;

  if (willActivate) {
    icon.className  = 'modal-icon success';
    icon.innerHTML  = `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
                         <path d="M7 10l2.5 2.5L14 7" stroke-linecap="round" stroke-linejoin="round"/>
                         <circle cx="10" cy="10" r="7"/>
                       </svg>`;
    title.textContent = 'Activer le compte ?';
    sub.textContent   = `Le compte de « ${name} » sera réactivé et l'utilisateur pourra se connecter à nouveau.`;
    btn.className     = 'modal-confirm-toggle activate';
    btn.textContent   = 'Activer';
  } else {
    icon.className  = 'modal-icon warning';
    icon.innerHTML  = `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
                         <path d="M10 6v5M10 14v.5" stroke-linecap="round"/>
                         <circle cx="10" cy="10" r="7"/>
                       </svg>`;
    title.textContent = 'Désactiver le compte ?';
    sub.textContent   = `Le compte de « ${name} » sera suspendu. L'utilisateur ne pourra plus se connecter.`;
    btn.className     = 'modal-confirm-toggle deactivate';
    btn.textContent   = 'Désactiver';
  }

  document.getElementById('toggleModal').classList.add('open');
}
function closeToggleModal() {
  document.getElementById('toggleModal').classList.remove('open');
}
document.getElementById('toggleModal').addEventListener('click', e => {
  if (e.target === e.currentTarget) closeToggleModal();
});

// Fermer les deux modales avec Echap
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') { closeDeleteModal(); closeToggleModal(); }
});

// ══════════════════════════════════════════════════════════════════════
//  FILTRES AVANCÉS (toggle)
// ══════════════════════════════════════════════════════════════════════
const toggleBtn     = document.getElementById('toggleAdvanced');
const advancedPanel = document.getElementById('advancedPanel');
toggleBtn?.addEventListener('click', () => {
  const isOpen = advancedPanel.classList.toggle('open');
  toggleBtn.classList.toggle('active', isOpen);
});

// ══════════════════════════════════════════════════════════════════════
//  RECHERCHE LIVE (debounce 420 ms)
// ══════════════════════════════════════════════════════════════════════
let searchTimer;
const searchInput   = document.getElementById('searchInput');
const searchSpinner = document.getElementById('searchSpinner');
const filterForm    = document.getElementById('filterForm');

searchInput?.addEventListener('input', () => {
  clearTimeout(searchTimer);
  searchSpinner.classList.add('active');
  searchTimer = setTimeout(() => {
    filterForm.submit();
  }, 420);
});

// Auto-submit sur changement du select rôle
document.getElementById('roleSelect')?.addEventListener('change', () => {
  filterForm.submit();
});

// ══════════════════════════════════════════════════════════════════════
//  CLEAR D'UN FILTRE INDIVIDUEL (tag ×)
// ══════════════════════════════════════════════════════════════════════
function clearField(name) {
  const el = filterForm.querySelector(`[name="${name}"]`);
  if (el) { el.value = ''; }
  filterForm.submit();
}

// ══════════════════════════════════════════════════════════════════════
//  CHANGEMENT DU NB DE RÉSULTATS PAR PAGE
// ══════════════════════════════════════════════════════════════════════
function changePerPage(val) {
  const perPageInput = filterForm.querySelector('[name="perPage"]');
  const pageInput    = filterForm.querySelector('[name="page"]');
  if (perPageInput) perPageInput.value = val;
  if (pageInput)    pageInput.value    = 1;
  filterForm.submit();
}

// ══════════════════════════════════════════════════════════════════════
//  ANIMATION EN CASCADE des lignes du tableau
// ══════════════════════════════════════════════════════════════════════
document.querySelectorAll('#tableBody tr').forEach((tr, i) => {
  tr.style.opacity  = '0';
  tr.style.transform = 'translateX(-6px)';
  setTimeout(() => {
    tr.style.transition = 'opacity .25s ease, transform .25s cubic-bezier(.22,1,.36,1)';
    tr.style.opacity    = '1';
    tr.style.transform  = 'none';
  }, 60 + i * 35);
});

// ══════════════════════════════════════════════════════════════════════
//  SYSTÈME DE NOTIFICATIONS
//  Stockage : localStorage (clé 'mindaura_admin_notifs')
//  Format   : [{ id, type, title, desc, time, read }]
// ══════════════════════════════════════════════════════════════════════
const NOTIF_KEY = 'mindaura_admin_notifs';
const MAX_NOTIFS = 50;

// ── Icônes SVG par type ──────────────────────────────────────────────
const NOTIF_ICONS = {
  add: `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M10 4v12M4 10h12"/></svg>`,
  edit: `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M14.3 5.3a1 1 0 011.4 1.4l-8 8L5 15l.3-2.7 8-7z"/></svg>`,
  delete: `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 6h10M8 6V4h4v2M7 6l.7 9h4.6L13 6"/></svg>`,
  activate: `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M7 10l2.5 2.5L14 7"/><circle cx="10" cy="10" r="7"/></svg>`,
  deactivate: `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M10 6v5M10 14v.5"/><circle cx="10" cy="10" r="7"/></svg>`,
  export: `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M10 3v10M6 9l4 4 4-4M4 16h12"/></svg>`,
};

// ── Helpers stockage ────────────────────────────────────────────────
function notifLoad() {
  try { return JSON.parse(localStorage.getItem(NOTIF_KEY) || '[]'); }
  catch { return []; }
}
function notifSave(list) {
  try { localStorage.setItem(NOTIF_KEY, JSON.stringify(list.slice(0, MAX_NOTIFS))); }
  catch {}
}

// ── Formater l'heure relative ────────────────────────────────────────
function notifTimeAgo(isoString) {
  const diff = Math.floor((Date.now() - new Date(isoString)) / 1000);
  if (diff < 60)   return "À l'instant";
  if (diff < 3600) return `Il y a ${Math.floor(diff / 60)} min`;
  if (diff < 86400) return `Il y a ${Math.floor(diff / 3600)} h`;
  return `Il y a ${Math.floor(diff / 86400)} j`;
}

// ── Ajouter une notification ────────────────────────────────────────
function notifAdd(type, title, desc) {
  const list = notifLoad();
  list.unshift({
    id:   Date.now() + Math.random().toString(36).slice(2),
    type, title, desc,
    time: new Date().toISOString(),
    read: false,
  });
  notifSave(list);
  notifRender();
  // Animation cloche
  const btn = document.getElementById('notifToggle');
  btn.classList.add('ringing');
  setTimeout(() => btn.classList.remove('ringing'), 500);
}

// ── Rendre la liste dans le panneau ────────────────────────────────
function notifRender() {
  const list   = notifLoad();
  const body   = document.getElementById('notifBody');
  const badge  = document.getElementById('notifBadge');
  const hcount = document.getElementById('notifHeaderCount');
  const finfo  = document.getElementById('notifFooterInfo');
  const empty  = document.getElementById('notifEmpty');

  const unread = list.filter(n => !n.read).length;

  // Badge
  if (unread > 0) {
    badge.textContent = unread > 99 ? '99+' : unread;
    badge.classList.add('visible');
  } else {
    badge.classList.remove('visible');
  }

  // Header count
  hcount.textContent = list.length === 0
    ? 'Aucune activité récente'
    : `${list.length} action${list.length > 1 ? 's' : ''} • ${unread} non lue${unread > 1 ? 's' : ''}`;

  // Footer info
  finfo.textContent = list.length > 0
    ? `${list.length} notification${list.length > 1 ? 's' : ''} conservée${list.length > 1 ? 's' : ''}`
    : 'Session en cours';

  // Empty state
  if (list.length === 0) {
    body.innerHTML = `
      <div class="notif-empty" id="notifEmpty">
        <div class="notif-empty-icon">🔔</div>
        <div class="notif-empty-title">Aucune notification</div>
        <div class="notif-empty-sub">Les actions de gestion apparaîtront ici</div>
      </div>`;
    return;
  }

  // Construire les items
  body.innerHTML = list.map(n => `
    <div class="notif-item ${n.read ? '' : 'unread'}" data-id="${n.id}">
      <div class="notif-item-icon notif-icon-${n.type}">${NOTIF_ICONS[n.type] || NOTIF_ICONS.add}</div>
      <div class="notif-item-body">
        <div class="notif-item-title">${escHtml(n.title)}</div>
        <div class="notif-item-desc">${escHtml(n.desc)}</div>
        <div class="notif-item-time">
          <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="6" cy="6" r="4.5"/><path d="M6 3.5v2.8l1.5 1" stroke-linecap="round"/></svg>
          ${notifTimeAgo(n.time)}
        </div>
      </div>
      ${!n.read ? '<div class="notif-unread-dot"></div>' : ''}
    </div>
  `).join('');

  // Clic sur un item → marquer comme lu
  body.querySelectorAll('.notif-item').forEach(el => {
    el.addEventListener('click', () => {
      const id = el.dataset.id;
      const lst = notifLoad();
      const idx = lst.findIndex(n => n.id === id);
      if (idx !== -1 && !lst[idx].read) {
        lst[idx].read = true;
        notifSave(lst);
        notifRender();
      }
    });
  });
}

function escHtml(str) {
  return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// ── Positionner le panneau sous le bouton ────────────────────────────
function notifPositionPanel() {
  const btn    = document.getElementById('notifToggle');
  const panel  = document.getElementById('notifPanel');
  if (!btn || !panel) return;
  const rect   = btn.getBoundingClientRect();
  const panelW = 380;
  let   left   = rect.right - panelW;
  // Eviter de sortir à gauche de l'écran
  if (left < 8) left = 8;
  // Eviter de sortir à droite
  if (left + panelW > window.innerWidth - 8) left = window.innerWidth - panelW - 8;
  panel.style.top  = (rect.bottom + 10) + 'px';
  panel.style.left = left + 'px';
}

// ── Toggle du panneau ────────────────────────────────────────────────
const notifToggle = document.getElementById('notifToggle');
const notifPanel  = document.getElementById('notifPanel');

notifToggle?.addEventListener('click', (e) => {
  e.stopPropagation();
  const isOpen = notifPanel.classList.toggle('open');
  notifToggle.classList.toggle('active', isOpen);
  if (isOpen) {
    notifPositionPanel();
    notifRender();
  }
});

// Repositionner si la fenêtre est redimensionnée
window.addEventListener('resize', () => {
  if (notifPanel.classList.contains('open')) notifPositionPanel();
});

document.getElementById('notifClose')?.addEventListener('click', () => {
  notifPanel.classList.remove('open');
  notifToggle.classList.remove('active');
});

// Fermer si clic en dehors
document.addEventListener('click', (e) => {
  const wrap  = document.getElementById('notifWrap');
  const panel = document.getElementById('notifPanel');
  if (!wrap?.contains(e.target) && !panel?.contains(e.target)) {
    panel?.classList.remove('open');
    notifToggle?.classList.remove('active');
  }
});

// Fermer avec Échap
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') {
    notifPanel.classList.remove('open');
    notifToggle?.classList.remove('active');
  }
});

// ── Tout effacer ────────────────────────────────────────────────────
document.getElementById('notifClearAll')?.addEventListener('click', (e) => {
  e.stopPropagation();
  notifSave([]);
  notifRender();
});

// ── Tout marquer comme lu ────────────────────────────────────────────
document.getElementById('notifMarkAll')?.addEventListener('click', (e) => {
  e.stopPropagation();
  const lst = notifLoad().map(n => ({ ...n, read: true }));
  notifSave(lst);
  notifRender();
});

// ── Intercepter les actions existantes ──────────────────────────────
// 1. Export CSV
document.querySelectorAll('a[href*="export/csv"]').forEach(link => {
  link.addEventListener('click', () => {
    notifAdd('export', 'Export CSV lancé', 'Téléchargement de la liste des utilisateurs au format CSV');
  });
});

// 2. Export PDF
document.querySelectorAll('a[href*="export/pdf"]').forEach(link => {
  link.addEventListener('click', () => {
    notifAdd('export', 'Export PDF lancé', 'Génération du rapport PDF des utilisateurs');
  });
});

// 3. Création : on injecte dans openDeleteModal / openToggleModal et les formulaires
// Pour l'ajout d'un utilisateur, on surveille le bouton "Nouvel utilisateur"
document.querySelector('.btn-new-user')?.addEventListener('click', () => {
  notifAdd('add', 'Création d\'un utilisateur', 'Ouverture du formulaire de création de compte');
});

// 4. Surcharger openDeleteModal pour enregistrer avant confirmation
const _origOpenDeleteModal = window.openDeleteModal;
window.openDeleteModal = function(id, name) {
  // On ne loggue pas encore — on attend la confirmation (submit)
  _origOpenDeleteModal(id, name);
};

// Écouter le submit du formulaire de suppression
document.getElementById('deleteForm')?.addEventListener('submit', () => {
  const name = document.getElementById('deleteModalSub')?.textContent?.match(/«\s*(.+?)\s*»/)?.[1] || 'Utilisateur';
  notifAdd('delete', 'Compte supprimé', `Le compte de « ${name} » a été supprimé définitivement`);
});

// 5. Toggle statut — écouter le submit du formulaire toggle
document.getElementById('toggleForm')?.addEventListener('submit', () => {
  const title = document.getElementById('toggleModalTitle')?.textContent || '';
  const sub   = document.getElementById('toggleModalSub')?.textContent || '';
  const isActivate = title.toLowerCase().includes('activer') && !title.toLowerCase().includes('désactiver');
  const name  = sub.match(/«\s*(.+?)\s*»/)?.[1] || 'Utilisateur';
  if (isActivate) {
    notifAdd('activate', 'Compte activé', `Le compte de « ${name} » a été réactivé`);
  } else {
    notifAdd('deactivate', 'Compte désactivé', `Le compte de « ${name} » a été suspendu`);
  }
});

// 6. Édition — détecter les liens "Modifier" dans le tableau
document.querySelectorAll('.action-btn.edit').forEach(link => {
  link.addEventListener('click', (e) => {
    const row   = link.closest('tr');
    const name  = row?.querySelector('.user-name')?.textContent?.trim() || 'Utilisateur';
    notifAdd('edit', 'Modification d\'un compte', `Ouverture de l\'édition de « ${name} »`);
  });
});

// ── Vérification des flash Symfony (actions déjà réalisées au chargement) ──
// Détecte les messages flash de succès dans le DOM pour retrouver les actions passées
(function detectFlashActions() {
  const flashes = document.querySelectorAll('.flash-success, .alert-success, [data-flash="success"]');
  flashes.forEach(el => {
    const msg = el.textContent?.trim() || '';
    if (!msg) return;

    if (/créé/i.test(msg)) {
      notifAdd('add', 'Utilisateur créé', msg);
    } else if (/mis à jour|modifié/i.test(msg)) {
      notifAdd('edit', 'Profil modifié', msg);
    } else if (/supprimé/i.test(msg)) {
      notifAdd('delete', 'Compte supprimé', msg);
    } else if (/activé/i.test(msg)) {
      notifAdd('activate', 'Compte activé', msg);
    } else if (/désactivé/i.test(msg)) {
      notifAdd('deactivate', 'Compte désactivé', msg);
    }
  });
})();

// ── Rendu initial ────────────────────────────────────────────────────
notifRender();
</script>
{% endblock %}
