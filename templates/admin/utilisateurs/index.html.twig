          <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="6" cy="4" r="2.2"/><path d="M1 11c0-2.8 2.2-5 5-5s5 2.2 5 5" stroke-linecap="round"/></svg>
