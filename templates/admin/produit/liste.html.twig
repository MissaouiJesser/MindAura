{# templates/admin/produit/liste.html.twig  (vue utilisateur boutique) #}

{% extends 'base_user.html.twig' %}

{% block title %}Boutique MindAura{% endblock %}

{% block body %}
<div class="container py-4">

    <div class="d-flex gap-2 mb-4">
        <a href="{{ path('evenement_liste') }}" class="btn btn-outline-secondary">📅 Événements</a>
        <a href="{{ path('produit_liste') }}" class="btn btn-primary">🛍️ Produits</a>
    </div>

    <div class="row g-3" id="produit-grid">
        {% for produit in produits %}
        <div class="col-6 col-md-4 col-lg-3">
            <div class="card h-100 shadow-sm">
                {% if produit.image %}
                <img src="{{ asset('uploads/produits/' ~ produit.image) }}"
                     class="card-img-top" style="height:140px;object-fit:cover" alt="{{ produit.nom }}">
                {% else %}
                <div class="bg-light d-flex align-items-center justify-content-center" style="height:140px;font-size:2rem;">🛍️</div>
                {% endif %}
                <div class="card-body p-2">
                    <p class="fw-semibold mb-1" style="font-size:0.9rem;">{{ produit.nom }}</p>
                    {# ✅ CORRECTION 1 : Monnaie TND (et non USD $) #}
                    <p class="text-primary fw-bold mb-1">{{ produit.prix }} TND</p>
                    {% if produit.stock is not null %}
                    <span style="font-size:.72rem; color:#9ca3af;">Stock : {{ produit.stock }}</span>
                    {% endif %}
                    {% if not produit.isDisponible() %}
                    <span class="badge bg-danger mb-1">❌ Rupture de stock</span>
                    <div class="alerte-stock-box mt-1" data-produit-id="{{ produit.id }}">
                        <small class="text-muted d-block mb-1" style="font-size:.75rem;">📧 Être alerté par email quand disponible</small>
                        <div class="input-group input-group-sm">
                            {# ✅ CORRECTION 2 : Placeholder adapté au format tunisien 8 chiffres #}
                            <input type="email" class="form-control form-control-sm email-input"
                                   placeholder="votre@email.com"
                                   maxlength="180"
                                   style="border-radius:6px 0 0 6px;font-size:.75rem;">
                            <button class="btn btn-sm btn-warning btn-alerte"
                                    style="font-size:.75rem;border-radius:0 6px 6px 0;">
                                M'alerter
                            </button>
                        </div>
                        <small class="alerte-feedback d-block mt-1" style="font-size:.72rem;min-height:1rem;"></small>
                    </div>
                    {% else %}
                    <button class="btn btn-sm btn-outline-primary w-100 mt-1 btn-ajouter-panier"
                            data-id="{{ produit.id }}"
                            data-nom="{{ produit.nom }}"
                            data-prix="{{ produit.prix }}"
                            data-stock="{{ produit.stock is null ? -1 : produit.stock }}">
                        + Ajouter au panier
                    </button>
                    {% endif %}

                    {# ── Bouton description IA ── #}
                    <button class="btn btn-sm w-100 mt-1 btn-desc-ia"
                            data-id="{{ produit.id }}"
                            data-nom="{{ produit.nom }}"
                            data-prix="{{ produit.prix }}"
                            data-desc="{{ produit.description|default('')|e('html_attr') }}"
                            style="background:#f3eaff;color:#8e44ad;border:1px solid #d1bfff;font-size:.78rem;">
                        ✨ Description
                    </button>
                </div>
            </div>
        </div>
        {% else %}
        <div class="col-12 text-center text-muted py-5">Aucun produit disponible.</div>
        {% endfor %}
    </div>
</div>

{# ── Modal Description IA ── #}
<div id="overlay-desc-ia" onclick="fermerDescIa()" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:11000;"></div>
<div id="modal-desc-ia" style="display:none;position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);z-index:11001;background:white;border-radius:18px;box-shadow:0 8px 40px rgba(142,68,173,.25);width:90%;max-width:520px;padding:28px;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
        <div>
            <span style="font-size:1.5rem;">✨</span>
            <strong id="desc-ia-nom" style="font-size:1.1rem;color:#8e44ad;margin-left:8px;"></strong>
        </div>
        <button onclick="fermerDescIa()" style="background:none;border:none;font-size:1.4rem;cursor:pointer;color:#888;">✕</button>
    </div>
    <div id="desc-ia-body" style="background:#f8f5ff;border:1px solid #d1bfff;border-radius:10px;padding:16px;font-size:.95rem;line-height:1.7;color:#333;min-height:80px;">
        <div id="desc-ia-loading" class="text-center py-3" style="color:#8e44ad;">
            <div class="spinner-border spinner-border-sm me-2" role="status"></div>
            Génération en cours…
        </div>
        <span id="desc-ia-text" style="display:none;"></span>
    </div>
    <div id="desc-ia-error" class="alert alert-danger py-2 px-3 mt-2 d-none small"></div>
    <div class="mt-3 text-end">
        <button onclick="fermerDescIa()" class="btn btn-sm btn-outline-secondary">Fermer</button>
    </div>
</div>

{# Toast notification #}
<div id="toast-panier" style="position:fixed;top:20px;right:20px;z-index:9999;min-width:280px;background:#198754;color:white;padding:14px 20px;border-radius:10px;box-shadow:0 4px 20px rgba(0,0,0,.25);display:none;align-items:center;gap:12px;font-size:.95rem;">
    <span style="font-size:1.3rem;">✅</span>
    <div><strong id="toast-nom">Produit</strong> ajouté au panier !<br><small style="opacity:.85;">Cliquez sur 🛒 pour commander</small></div>
</div>

{# Bouton panier flottant #}
<button id="btn-panier-flottant" onclick="ouvrirModal()" style="position:fixed;bottom:30px;right:30px;z-index:9998;background:#0d6efd;color:white;border:none;border-radius:50px;padding:14px 22px;font-size:1rem;font-weight:600;box-shadow:0 6px 20px rgba(13,110,253,.45);cursor:pointer;display:none;align-items:center;gap:8px;transition:transform .2s;">
    🛒 Commander &nbsp;<span id="badge-flottant" style="background:white;color:#0d6efd;border-radius:50px;padding:2px 9px;font-size:.85rem;font-weight:700;">0</span>
</button>

{# Overlay #}
<div id="overlay-panier" onclick="fermerModal()" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:10000;"></div>

{# Modal panier #}
<div id="modal-panier" style="display:none;position:fixed;bottom:0;right:0;width:100%;max-width:480px;background:white;border-radius:20px 20px 0 0;box-shadow:0 -8px 40px rgba(0,0,0,.2);z-index:10001;padding:24px;max-height:90vh;overflow-y:auto;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
        <h5 style="margin:0;font-weight:700;">🛒 Mon Panier</h5>
        <button onclick="fermerModal()" style="background:none;border:none;font-size:1.4rem;cursor:pointer;color:#666;">✕</button>
    </div>

    <ul id="panier-list" style="list-style:none;padding:0;margin:0 0 16px;"></ul>

    <div style="border-top:2px solid #f0f0f0;padding-top:14px;margin-bottom:20px;">
        <div style="display:flex;justify-content:space-between;font-size:1.1rem;font-weight:700;">
            <span>Total</span>
            {# ✅ CORRECTION 1 (suite) : Monnaie TND dans le total initial #}
            <span id="panier-total" style="color:#0d6efd;">0.00 TND</span>
        </div>
    </div>

    <input type="email" id="user-email" class="form-control mb-3" placeholder="📧 Votre email pour la commande" style="border-radius:10px;">

    <button id="btn-payer" onclick="payerCommande()" class="btn btn-primary w-100 mb-2" style="border-radius:10px;padding:12px;font-weight:600;font-size:1rem;">
        💳 Payer avec Stripe
    </button>
    <button onclick="fermerModal()" class="btn btn-outline-secondary w-100" style="border-radius:10px;padding:12px;font-weight:600;">
        🛍️ Continuer les achats
    </button>
</div>

<style>
@keyframes slideInRight { from{opacity:0;transform:translateX(60px)} to{opacity:1;transform:translateX(0)} }
#toast-panier { animation: slideInRight .3s ease; }
#btn-panier-flottant:hover { transform: scale(1.05); }
</style>

<script>
const panier = {};
let toastTimer = null;

document.querySelectorAll('.btn-ajouter-panier').forEach(btn => {
    btn.addEventListener('click', () => {
        const id    = btn.dataset.id;
        const nom   = btn.dataset.nom;
        const prix  = parseFloat(btn.dataset.prix);
        const stock = parseInt(btn.dataset.stock); // -1 = illimité

        const quantiteActuelle = panier[id] ? panier[id].quantite : 0;
        const stockMax = stock === -1 ? Infinity : stock;

        if (quantiteActuelle >= stockMax) {
            btn.textContent = '⚠️ Stock max atteint';
            btn.classList.replace('btn-outline-primary', 'btn-warning');
            setTimeout(() => {
                btn.textContent = '+ Ajouter au panier';
                btn.classList.replace('btn-warning', 'btn-outline-primary');
            }, 1500);
            return;
        }

        if (panier[id]) panier[id].quantite++;
        else panier[id] = { nom, prix, quantite: 1, stock: stockMax };

        btn.classList.replace('btn-outline-primary', 'btn-success');
        setTimeout(() => {
            btn.textContent = '+ Ajouter au panier';
            btn.classList.replace('btn-success', 'btn-outline-primary');
        }, 1200);

        afficherToast(nom);
        mettreAJourFlottant();
    });
});

function afficherToast(nom) {
    const t = document.getElementById('toast-panier');
    document.getElementById('toast-nom').textContent = nom;
    t.style.display = 'flex';
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => { t.style.display = 'none'; }, 2800);
}

function mettreAJourFlottant() {
    const total = Object.values(panier).reduce((s,i) => s + i.quantite, 0);
    const btn = document.getElementById('btn-panier-flottant');
    document.getElementById('badge-flottant').textContent = total;
    btn.style.display = total > 0 ? 'flex' : 'none';
}

function renderPanier() {
    const list = document.getElementById('panier-list');
    const total = Object.values(panier).reduce((s,i) => s + i.prix * i.quantite, 0);
    if (Object.keys(panier).length === 0) {
        list.innerHTML = '<li style="text-align:center;color:#999;padding:30px 0;">🛒 Votre panier est vide.</li>';
    } else {
        list.innerHTML = Object.entries(panier).map(([id, i]) => `
            <li style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid #f0f0f0;">
                <div>
                    <div style="font-weight:600;font-size:.9rem;">${i.nom}</div>
                    {# ✅ CORRECTION 1 (suite) : TND dans items du panier #}
                    <div style="color:#666;font-size:.8rem;">${i.prix.toFixed(2)} TND × ${i.quantite}</div>
                </div>
                <div style="display:flex;align-items:center;gap:8px;">
                    <span style="font-weight:700;color:#0d6efd;">${(i.prix * i.quantite).toFixed(2)} TND</span>
                    <button onclick="retirerItem('${id}')" style="background:none;border:none;cursor:pointer;color:#dc3545;font-size:1.1rem;">✕</button>
                </div>
            </li>`).join('');
    }
    {# ✅ CORRECTION 1 (suite) : TND dans le total rendu #}
    document.getElementById('panier-total').textContent = total.toFixed(2) + ' TND';
}

function retirerItem(id) { delete panier[id]; renderPanier(); mettreAJourFlottant(); }

function ouvrirModal() {
    renderPanier();
    document.getElementById('overlay-panier').style.display = 'block';
    document.getElementById('modal-panier').style.display = 'block';
    document.body.style.overflow = 'hidden';
}

function fermerModal() {
    document.getElementById('overlay-panier').style.display = 'none';
    document.getElementById('modal-panier').style.display = 'none';
    document.body.style.overflow = '';
}

async function payerCommande() {
    const email = document.getElementById('user-email').value.trim();
    if (!email) { alert('Veuillez saisir votre email.'); return; }
    if (Object.keys(panier).length === 0) { alert('Panier vide.'); return; }

    const btn = document.getElementById('btn-payer');
    btn.disabled = true; btn.textContent = '⏳ Traitement en cours...';

    const body = { email, panier: Object.entries(panier).map(([produit_id, i]) => ({ produit_id: parseInt(produit_id), quantite: i.quantite })) };

    try {
        const res = await fetch('/paiement/checkout', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
        const text = await res.text();
        let data;
        try { data = JSON.parse(text); } catch(e) { alert('Erreur serveur : ' + text.substring(0, 200)); btn.disabled=false; btn.textContent='💳 Payer avec Stripe'; return; }
        if (data.checkout_url) { window.location.href = data.checkout_url; }
        else { alert('Erreur Stripe : ' + (data.error || data.message || JSON.stringify(data))); btn.disabled=false; btn.textContent='💳 Payer avec Stripe'; }
    } catch (err) { alert('Erreur réseau : ' + err.message); btn.disabled=false; btn.textContent='💳 Payer avec Stripe'; }
}

// ─── Alerte stock par EMAIL ──────────────────────────────────
document.querySelectorAll('.alerte-stock-box').forEach(box => {
    const produitId = box.dataset.produitId;
    const btn       = box.querySelector('.btn-alerte');
    const input     = box.querySelector('.email-input');
    const feedback  = box.querySelector('.alerte-feedback');

    btn.addEventListener('click', async () => {
        const email = input.value.trim();
        if (!email) {
            feedback.textContent = '⚠️ Entrez votre adresse email.';
            feedback.style.color = '#f59e0b';
            return;
        }

        // Validation basique de l'email côté client
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(email)) {
            feedback.textContent = '⚠️ Email invalide. Exemple : votre@email.com';
            feedback.style.color = '#f59e0b';
            return;
        }

        btn.disabled = true;
        btn.textContent = '⏳...';
        feedback.textContent = '';

        try {
            const res = await fetch(`/produits/${produitId}/alerte-email`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email })
            });

            const data = await res.json();

            if (data.success) {
                feedback.textContent = '✅ ' + data.message;
                feedback.style.color = '#16a34a';
                input.value = '';
                btn.textContent = '✓ Enregistré';
                btn.classList.replace('btn-warning', 'btn-success');
            } else {
                feedback.textContent = '❌ ' + (data.error || 'Erreur inconnue.');
                feedback.style.color = '#dc2626';
                btn.disabled = false;
                btn.textContent = "M'alerter";
            }
        } catch (err) {
            feedback.textContent = '❌ Erreur réseau. Réessayez.';
            feedback.style.color = '#dc2626';
            btn.disabled = false;
            btn.textContent = "M'alerter";
        }
    });

    // Valider avec Entrée
    input.addEventListener('keydown', e => {
        if (e.key === 'Enter') btn.click();
    });
});

// ── Description IA ────────────────────────────────────────────────
const descIaCache = {};  // cache par produit id

function ouvrirDescIa(id, nom, prix, descExistante) {
    document.getElementById('overlay-desc-ia').style.display = 'block';
    document.getElementById('modal-desc-ia').style.display   = 'block';
    document.getElementById('desc-ia-nom').textContent = nom;

    const loading = document.getElementById('desc-ia-loading');
    const text    = document.getElementById('desc-ia-text');
    const errBox  = document.getElementById('desc-ia-error');
    errBox.classList.add('d-none');

    // Si description déjà en cache ou déjà dans le DOM
    if (descIaCache[id]) {
        loading.style.display = 'none';
        text.style.display    = '';
        text.textContent      = descIaCache[id];
        return;
    }

    // Si description déjà stockée en base (data-desc)
    if (descExistante && descExistante.trim().length > 10) {
        descIaCache[id] = descExistante;
        loading.style.display = 'none';
        text.style.display    = '';
        text.textContent      = descExistante;
        return;
    }

    // Sinon appel IA
    loading.style.display = 'block';
    text.style.display    = 'none';
    text.textContent      = '';

    fetch('/admin/produit/ia/description', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ nom, prix }),
    })
    .then(r => r.json())
    .then(data => {
        if (data.error) throw new Error(data.error);
        descIaCache[id] = data.description;
        loading.style.display = 'none';
        text.style.display    = '';
        text.textContent      = data.description;
    })
    .catch(err => {
        loading.style.display = 'none';
        errBox.textContent = '❌ ' + err.message;
        errBox.classList.remove('d-none');
    });
}

function fermerDescIa() {
    document.getElementById('overlay-desc-ia').style.display = 'none';
    document.getElementById('modal-desc-ia').style.display   = 'none';
}

document.querySelectorAll('.btn-desc-ia').forEach(btn => {
    btn.addEventListener('click', () => {
        ouvrirDescIa(
            btn.dataset.id,
            btn.dataset.nom,
            btn.dataset.prix,
            btn.dataset.desc
        );
    });
});
// ───────────────────────────────────────────────────────────────────

</script>
{% endblock %}
