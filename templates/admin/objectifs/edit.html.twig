{% extends 'base_backoffice.html.twig' %}

{% block title %}Modifier un objectif{% endblock %}
{% block page_label %}Modifier l'objectif{% endblock %}

{% block content %}
{% include '_partials/_admin_design_system.html.twig' %}

{# Hero #}
<div class="ds-hero">
  <div class="ds-hero-dots"></div>
  <div class="ds-hero-body">
    <div class="ds-hero-icon">✏️</div>
    <div class="ds-hero-text">
      <h1 class="ds-hero-title">Modifier l'objectif</h1>
      <p class="ds-hero-sub">Mettez à jour les informations de cet objectif.</p>
      <span class="ds-hero-chip">✏️ Édition</span>
    </div>
    <a href="{{ path('admin_objectif_index') }}" class="ds-back-link" data-spa>← Retour</a>
  </div>
</div>

<div class="ds-form-page">
  {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'ds-form-card', 'style': 'max-width: 980px; margin: 0 auto;'}}) }}

    {# Section 1 — Informations de base #}
    <div class="ds-form-body">
      <h3 class="ds-form-section-title">📋 Informations de base</h3>
      <div class="ds-form-row ds-form-row--full">
        <div class="ds-form-group">{{ form_row(form.titre) }}</div>
      </div>
      <div class="ds-form-row ds-form-row--full">
        <div class="ds-form-group">{{ form_row(form.description) }}</div>
      </div>
    </div>

    {# Section 2 — Configuration #}
    <div class="ds-form-body" style="border-top: 1.5px solid var(--border, #D5DCE6);">
      <h3 class="ds-form-section-title">⚙️ Configuration de l'objectif</h3>
      <div class="ds-form-row">
        <div class="ds-form-group">{{ form_row(form.type_test) }}</div>
        <div class="ds-form-group">{{ form_row(form.niveau_recommande) }}</div>
      </div>
    </div>

    {# Section 3 — Évaluation #}
    <div class="ds-form-body" style="border-top: 1.5px solid var(--border, #D5DCE6);">
      <h3 class="ds-form-section-title">📊 Paramètres d'évaluation</h3>
      <div class="ds-form-row ds-form-row--three">
        <div class="ds-form-group">{{ form_row(form.score_min) }}</div>
        <div class="ds-form-group">{{ form_row(form.score_max) }}</div>
        <div class="ds-form-group">{{ form_row(form.categorie) }}</div>
      </div>
    </div>

    {# Section 4 — Délai & difficulté #}
    <div class="ds-form-body" style="border-top: 1.5px solid var(--border, #D5DCE6);">
      <h3 class="ds-form-section-title">⏱️ Délai et difficulté</h3>
      <div class="ds-form-row ds-form-row--three">
        <div class="ds-form-group">{{ form_row(form.duree_estimee) }}</div>
        <div class="ds-form-group">{{ form_row(form.difficule) }}</div>
        <div class="ds-form-group">{{ form_row(form.date_echeance) }}</div>
      </div>
    </div>

    {# Section 5 — Statut & visibilité #}
    <div class="ds-form-body" style="border-top: 1.5px solid var(--border, #D5DCE6);">
      <h3 class="ds-form-section-title">👁 Statut et visibilité</h3>
      <div class="ds-form-row">
        <div class="ds-form-group">{{ form_row(form.statut) }}</div>
        <div class="ds-form-group" style="display: flex; align-items: center;">
          <label style="display: flex; align-items: center; gap: 10px; padding: 11px 16px; background: var(--green-pale, #D8F3DC); border-radius: 12px; cursor: pointer; width: 100%;">
            {{ form_widget(form.est_public, {'attr': {'style': 'width: 18px; height: 18px; accent-color: var(--green, #1B4332);'}}) }}
            <span style="font-weight: 600; color: var(--green, #1B4332); font-size: 13px;">Objectif public (visible aux utilisateurs)</span>
          </label>
        </div>
      </div>
    </div>

    <div class="ds-form-actions">
      <a href="{{ path('admin_objectif_index') }}" class="ds-btn-cancel" data-spa>← Annuler</a>
      <button type="submit" class="ds-btn-submit">💾 Enregistrer les modifications</button>
    </div>

  {{ form_end(form) }}
</div>

<style>
  /* Patch léger pour styler les widgets Symfony rendus par form_row */
  .ds-form-page .ds-form-card input[type="text"],
  .ds-form-page .ds-form-card input[type="number"],
  .ds-form-page .ds-form-card input[type="date"],
  .ds-form-page .ds-form-card input[type="email"],
  .ds-form-page .ds-form-card select,
  .ds-form-page .ds-form-card textarea {
    width: 100%;
    padding: 10px 14px;
    border: 1.5px solid var(--border, #D5DCE6);
    border-radius: 12px;
    font-family: 'Outfit', sans-serif;
    font-size: 14px;
    background: #fff;
    color: #1f2937;
    transition: border-color .2s ease, box-shadow .2s ease;
    box-sizing: border-box;
  }
  .ds-form-page .ds-form-card input:focus,
  .ds-form-page .ds-form-card select:focus,
  .ds-form-page .ds-form-card textarea:focus {
    outline: none;
    border-color: var(--green-light, #52B788);
    box-shadow: 0 0 0 4px rgba(82,183,136,.15);
  }
  .ds-form-page .ds-form-card textarea { resize: vertical; min-height: 100px; }
  .ds-form-page .ds-form-card label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: var(--green, #1B4332);
    text-transform: uppercase;
    letter-spacing: .5px;
    margin-bottom: 7px;
  }
</style>
{% endblock %}
