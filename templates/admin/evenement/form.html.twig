{# templates/admin/evenement/form.html.twig
   Formulaire création/édition d'événement — Back-office
   Design harmonisé avec admin/utilisateurs/ #}

{% extends 'base_backoffice.html.twig' %}

{% block title %}{{ title }}{% endblock %}
{% block page_label %}{{ title }}{% endblock %}

{% block content %}
{% include '_partials/_admin_design_system.html.twig' %}

<style>
  .ds-form-card input[type="text"],
  .ds-form-card input[type="number"],
  .ds-form-card input[type="date"],
  .ds-form-card input[type="datetime-local"],
  .ds-form-card input[type="email"],
  .ds-form-card input[type="time"],
  .ds-form-card select,
  .ds-form-card textarea {
    padding:10px 14px; border:1.5px solid var(--border); border-radius:10px;
    background:var(--bg); font-family:'Outfit',sans-serif; font-size:.88rem;
    color:var(--text); outline:none;
    transition:border-color .2s, box-shadow .2s, background .2s;
    width:100%; box-sizing:border-box;
  }
  .ds-form-card textarea { resize:vertical; min-height:90px; }
  .ds-form-card input:focus,
  .ds-form-card select:focus,
  .ds-form-card textarea:focus {
    border-color:var(--green-light); background:var(--white);
    box-shadow:0 0 0 3px rgba(82,183,136,.1);
  }
  .ds-form-card label {
    font-size:.78rem !important; font-weight:600 !important; color:var(--text) !important;
    display:block !important; margin-bottom:6px !important;
  }
  .form-err { color:#DC2626; font-size:.75rem; margin-top:4px; }
  .form-err:empty { display:none; }
  .form-hint { color:var(--text-sec); font-size:.72rem; margin-top:4px; }
  .current-image-preview {
    margin-top:12px; padding:10px; background:var(--bg);
    border:1.5px dashed var(--border); border-radius:10px;
    display:flex; align-items:center; gap:14px;
  }
  .current-image-preview img { max-height:90px; border-radius:10px; }
  .ds-form-card input[type="file"] { padding:9px; cursor:pointer; }
</style>

<div class="ds-form-page">

  <div class="ds-form-header">
    <div class="ds-form-header-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
        <line x1="16" y1="2" x2="16" y2="6"/>
        <line x1="8" y1="2" x2="8" y2="6"/>
        <line x1="3" y1="10" x2="21" y2="10"/>
      </svg>
    </div>
    <div>
      <div class="ds-form-header-title">{{ title }}</div>
      <div class="ds-form-header-sub">Remplissez les informations ci-dessous</div>
    </div>
    <a href="{{ path('evenement_index') }}" class="ds-back-link">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 4l-6 6 6 6"/>
      </svg>
      Retour à la liste
    </a>
  </div>

  {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'enctype': 'multipart/form-data', 'class': 'ds-form-card'}}) }}

    <div class="ds-form-body">

      <div class="ds-form-section-title">
        <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="10" height="10" rx="1.5"/>
          <line x1="4" y1="5" x2="10" y2="5"/>
          <line x1="4" y1="8" x2="8" y2="8"/>
        </svg>
        Informations générales
      </div>

      <div class="ds-form-row">
        <div class="ds-form-group">
          {{ form_label(form.identifiantEvenemnt, 'Identifiant') }}
          {{ form_widget(form.identifiantEvenemnt) }}
          <div class="form-err">{{ form_errors(form.identifiantEvenemnt) }}</div>
        </div>
        <div class="ds-form-group">
          {{ form_label(form.titreEvenement, 'Titre') }}
          {{ form_widget(form.titreEvenement) }}
          <div class="form-err">{{ form_errors(form.titreEvenement) }}</div>
        </div>
      </div>

      <div class="ds-form-row full">
        <div class="ds-form-group">
          {{ form_label(form.descriptionEvenement, 'Description') }}
          {{ form_widget(form.descriptionEvenement) }}
          <div class="form-err">{{ form_errors(form.descriptionEvenement) }}</div>
        </div>
      </div>

      <div class="ds-form-section-title" style="margin-top:18px">
        <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="3" width="10" height="9" rx="1.5"/>
          <line x1="9" y1="1.5" x2="9" y2="4"/>
          <line x1="5" y1="1.5" x2="5" y2="4"/>
          <line x1="2" y1="6" x2="12" y2="6"/>
        </svg>
        Dates & Lieu
      </div>

      <div class="ds-form-row">
        <div class="ds-form-group">
          {{ form_label(form.datedebutEvenemnt, 'Date début') }}
          {{ form_widget(form.datedebutEvenemnt) }}
          <div class="form-err">{{ form_errors(form.datedebutEvenemnt) }}</div>
        </div>
        <div class="ds-form-group">
          {{ form_label(form.datefinEvenemnt, 'Date fin') }}
          {{ form_widget(form.datefinEvenemnt) }}
          <div class="form-err">{{ form_errors(form.datefinEvenemnt) }}</div>
        </div>
      </div>

      <div class="ds-form-row">
        <div class="ds-form-group">
          {{ form_label(form.lieuEvenement, 'Lieu') }}
          {{ form_widget(form.lieuEvenement) }}
          <div class="form-err">{{ form_errors(form.lieuEvenement) }}</div>
        </div>
        <div class="ds-form-group">
          {{ form_label(form.capaciteEvenement, 'Capacité') }}
          {{ form_widget(form.capaciteEvenement) }}
          <div class="form-err">{{ form_errors(form.capaciteEvenement) }}</div>
        </div>
      </div>

      <div class="ds-form-section-title" style="margin-top:18px">
        <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="3" width="10" height="8" rx="1.5"/>
          <path d="M5 3v-1h4v1"/>
        </svg>
        Type & Média
      </div>

      <div class="ds-form-row full">
        <div class="ds-form-group">
          {{ form_label(form.typeEvenement, "Type d'événement") }}
          {{ form_widget(form.typeEvenement) }}
          <div class="form-err">{{ form_errors(form.typeEvenement) }}</div>
        </div>
      </div>

      <div class="ds-form-row full">
        <div class="ds-form-group">
          {{ form_label(form.imageFile, 'Image') }}
          {{ form_widget(form.imageFile) }}
          <div class="form-hint">JPG, PNG ou WebP · max 2 Mo</div>
          <div class="form-err">{{ form_errors(form.imageFile) }}</div>
          {% if evenement is defined and evenement and evenement.image %}
            <div class="current-image-preview">
              <img src="{{ asset('uploads/images/' ~ evenement.image) }}" alt="Image actuelle">
              <div style="font-size:.78rem;color:var(--text-sec)">
                <strong style="color:var(--text)">Image actuelle</strong><br>
                Importez un nouveau fichier pour la remplacer.
              </div>
            </div>
          {% endif %}
        </div>
      </div>

    </div>

    <div class="ds-form-actions">
      <a href="{{ path('evenement_index') }}" class="ds-btn-cancel">Annuler</a>
      {{ form_widget(form.save, {'attr': {'class': 'ds-btn-submit', 'style': 'padding:11px 24px; border-radius:11px; background:var(--green); color:#fff; border:none; font-family:Outfit,sans-serif; font-size:.88rem; font-weight:700; cursor:pointer;'}}) }}
    </div>

  {{ form_end(form) }}

</div>
{% endblock %}
