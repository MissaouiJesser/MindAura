{# templates/admin/evenement/index.html.twig
   Liste des événements — Back-office
   Design harmonisé avec admin/utilisateurs/ #}

{% extends 'base_backoffice.html.twig' %}

{% block title %}Événements{% endblock %}
{% block page_label %}Événements{% endblock %}

{% block content %}
{% include '_partials/_admin_design_system.html.twig' %}

<style>
  .ev-stats { display:grid; grid-template-columns:repeat(auto-fit, minmax(150px, 1fr)); gap:14px; margin-bottom:18px; }
  .ev-stat {
    background:var(--white); border:1.5px solid var(--border); border-radius:16px;
    padding:16px 18px; display:flex; flex-direction:column; gap:4px;
    box-shadow:var(--shadow-card);
    animation:fadeUp .4s cubic-bezier(.22,1,.36,1) both;
    transition:transform .2s, box-shadow .2s, border-color .2s;
  }
  .ev-stat:hover { transform:translateY(-3px); box-shadow:var(--shadow-hover); border-color:var(--green-light); }
  .ev-stat-icon { font-size:1.3rem; margin-bottom:2px; }
  .ev-stat-val { font-family:'Playfair Display', serif; font-weight:700; font-size:1.7rem; color:var(--green); line-height:1; }
  .ev-stat-lbl { font-size:.72rem; color:var(--text-sec); font-weight:600; text-transform:uppercase; letter-spacing:.5px; margin-top:4px; }

  .ev-cell { display:flex; align-items:center; gap:12px; }
  .ev-thumb {
    width:48px; height:48px; border-radius:12px; flex-shrink:0;
    background:linear-gradient(135deg, var(--green-pale), var(--violet-pale));
    display:grid; place-items:center; font-size:1.2rem;
    overflow:hidden; border:1.5px solid var(--border);
  }
  .ev-thumb img { width:100%; height:100%; object-fit:cover; }
  .ev-title { font-weight:700; color:var(--text); font-size:.9rem; }
  .ev-lieu { font-size:.74rem; color:var(--text-sec); margin-top:2px; }
</style>

<div class="ds-hero">
  <div class="ds-hero-dots"><span></span><span></span><span></span></div>
  <div class="ds-hero-body">
    <div class="ds-hero-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
        <line x1="16" y1="2" x2="16" y2="6"/>
        <line x1="8" y1="2" x2="8" y2="6"/>
        <line x1="3" y1="10" x2="21" y2="10"/>
      </svg>
    </div>
    <div class="ds-hero-text">
      <div class="ds-hero-title">Gestion des Événements</div>
      <div class="ds-hero-sub">
        <span class="ds-hero-chip">
          <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="6" cy="6" r="4.5"/></svg>
          {{ evenements|length }} événement{{ evenements|length != 1 ? 's' : '' }}
        </span>
      </div>
    </div>
    <div style="display:flex;align-items:center;gap:10px;flex-shrink:0;margin-left:auto;flex-wrap:wrap">
      <a href="{{ path('evenement_export_pdf', app.request.query.all) }}" class="ds-btn-primary" style="background:rgba(255,255,255,.13);color:#fff;border:1.5px solid rgba(255,255,255,.3)">
        <div class="ds-btn-primary-icon" style="background:rgba(255,255,255,.2)">
          <svg viewBox="0 0 20 20" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 16v1a1 1 0 001 1h10a1 1 0 001-1v-1M7 10l3 3 3-3M10 13V3"/>
          </svg>
        </div>
        Export PDF
      </a>
      <a href="{{ path('evenement_new') }}" class="ds-btn-primary">
        <div class="ds-btn-primary-icon">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 4v12M4 10h12" stroke-linecap="round"/></svg>
        </div>
        Nouvel événement
      </a>
    </div>
  </div>
</div>

<div class="ev-stats">
  <div class="ev-stat" style="animation-delay:.05s">
    <div class="ev-stat-icon">📅</div>
    <div class="ev-stat-val">{{ evenements|length }}</div>
    <div class="ev-stat-lbl">Total</div>
  </div>
  <div class="ev-stat" style="animation-delay:.1s">
    <div class="ev-stat-icon">🎁</div>
    <div class="ev-stat-val">{{ evenements|filter(e => e.typeEvenement and e.typeEvenement.estGratuit)|length }}</div>
    <div class="ev-stat-lbl">Gratuits</div>
  </div>
  <div class="ev-stat" style="animation-delay:.15s">
    <div class="ev-stat-icon">💳</div>
    <div class="ev-stat-val">{{ evenements|filter(e => e.typeEvenement and not e.typeEvenement.estGratuit)|length }}</div>
    <div class="ev-stat-lbl">Payants</div>
  </div>
  <div class="ev-stat" style="animation-delay:.2s">
    <div class="ev-stat-icon">🖥️</div>
    <div class="ev-stat-val">{{ evenements|filter(e => e.typeEvenement and e.typeEvenement.modalite == 'en ligne')|length }}</div>
    <div class="ev-stat-lbl">En ligne</div>
  </div>
</div>

{% if searchForm is defined %}
<div class="ds-filters-panel">
  <form method="get">
    <div class="ds-filters-top" style="display:grid;grid-template-columns:2fr 1fr 1fr 1fr auto;gap:10px;align-items:end">
      <div class="ds-form-group">
        <label class="ds-form-label" style="font-size:.7rem">Recherche</label>
        {{ form_widget(searchForm.query, {attr: {class: 'ds-form-input', placeholder: 'Titre, lieu…'}}) }}
      </div>
      <div class="ds-form-group">
        <label class="ds-form-label" style="font-size:.7rem">Statut</label>
        {{ form_widget(searchForm.statut, {attr: {class: 'ds-form-select'}}) }}
      </div>
      <div class="ds-form-group">
        <label class="ds-form-label" style="font-size:.7rem">Type</label>
        {{ form_widget(searchForm.typeEvenement, {attr: {class: 'ds-form-select'}}) }}
      </div>
      <div class="ds-form-group">
        <label class="ds-form-label" style="font-size:.7rem">Gratuit</label>
        {{ form_widget(searchForm.gratuit, {attr: {class: 'ds-form-select'}}) }}
      </div>
      <button type="submit" class="ds-btn-submit" style="padding:10px 18px;height:42px">
        <svg viewBox="0 0 15 15" fill="none" stroke="currentColor" stroke-width="2"><circle cx="7" cy="7" r="4.5"/><path d="M11 11l3 3" stroke-linecap="round"/></svg>
        Filtrer
      </button>
      {{ form_rest(searchForm) }}
    </div>
  </form>
</div>
{% endif %}

<div class="ds-table-card">
  <table class="ds-table">
    <thead>
      <tr>
        <th>Événement</th>
        <th>Type</th>
        <th>Modalité</th>
        <th>Tarif</th>
        <th style="text-align:center">Actions</th>
      </tr>
    </thead>
    <tbody>
      {% for evenement in evenements %}
        <tr>
          <td>
            <div class="ev-cell">
              <div class="ev-thumb">
                {% if evenement.image is defined and evenement.image %}
                  <img src="{{ asset('uploads/evenements/' ~ evenement.image) }}" alt="{{ evenement.titreEvenement }}">
                {% else %}
                  🎪
                {% endif %}
              </div>
              <div>
                <div class="ev-title">{{ evenement.titreEvenement }}</div>
                {% if evenement.lieuEvenement is defined and evenement.lieuEvenement %}
                  <div class="ev-lieu">📍 {{ evenement.lieuEvenement }}</div>
                {% endif %}
              </div>
            </div>
          </td>
          <td>
            {% if evenement.typeEvenement %}
              <span class="ds-badge ds-badge-violet">{{ evenement.typeEvenement.libelle }}</span>
            {% else %}
              <span class="ds-badge ds-badge-gray">—</span>
            {% endif %}
          </td>
          <td>
            {% set modalite = evenement.typeEvenement.modalite ?? '' %}
            {% if modalite == 'en ligne' %}
              <span class="ds-badge ds-badge-blue">🖥️ En ligne</span>
            {% elseif modalite %}
              <span class="ds-badge ds-badge-teal">🏢 {{ modalite|capitalize }}</span>
            {% else %}
              <span class="ds-badge ds-badge-gray">—</span>
            {% endif %}
          </td>
          <td>
            {% if evenement.typeEvenement and evenement.typeEvenement.estGratuit %}
              <span class="ds-badge ds-badge-green">🎁 Gratuit</span>
            {% else %}
              <span class="ds-badge ds-badge-orange">💳 Payant</span>
            {% endif %}
          </td>
          <td>
            <div class="ds-actions">
              <a href="{{ path('evenement_show', {id: evenement.id}) }}" class="ds-action-btn view" title="Voir le détail">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M1 10s3-7 9-7 9 7 9 7-3 7-9 7-9-7-9-7z" stroke-linecap="round" stroke-linejoin="round"/>
                  <circle cx="10" cy="10" r="2.5"/>
                </svg>
              </a>
              <a href="{{ path('evenement_edit', {id: evenement.id}) }}" class="ds-action-btn edit" title="Modifier">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M13.5 3.5l3 3L8 15l-4 1 1-4z"/>
                </svg>
              </a>
              <form method="post"
                    action="{{ path('evenement_delete', {id: evenement.id}) }}"
                    style="display:inline;margin:0;padding:0;"
                    data-title="{{ evenement.titreEvenement }}"
                    onsubmit="return confirmDeleteEv(event, this);">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evenement.id) }}">
                <button type="submit" class="ds-action-btn del" title="Supprimer">
                  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="3 6 5 6 17 6"/>
                    <path d="M8 6V3h4v3M6 6l1 11h6l1-11"/>
                  </svg>
                </button>
              </form>
            </div>
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="5" style="padding:0">
            <div class="ds-empty">
              <div class="ds-empty-icon">📭</div>
              <div class="ds-empty-title">Aucun événement</div>
              <div class="ds-empty-sub">Commencez par créer votre premier événement.</div>
            </div>
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

<div class="ds-modal-overlay" id="deleteModalEv">
  <div class="ds-modal-box">
    <div class="ds-modal-icon danger">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="3 6 5 6 21 6"/>
        <path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/>
      </svg>
    </div>
    <div class="ds-modal-title">Supprimer cet événement ?</div>
    <div class="ds-modal-sub" id="deleteModalEvSub">Cette action est irréversible.</div>
    <div class="ds-modal-actions">
      <button type="button" class="ds-modal-cancel" id="cancelDeleteEv">Annuler</button>
      <button type="button" class="ds-modal-confirm-del" id="confirmDeleteEv">Supprimer</button>
    </div>
  </div>
</div>

<script>
  let pendingDeleteEv = null;
  function confirmDeleteEv(e, form) {
    e.preventDefault();
    pendingDeleteEv = form;
    const title = form.dataset.title || 'cet événement';
    document.getElementById('deleteModalEvSub').textContent = '« ' + title + ' » sera définitivement supprimé. Cette action est irréversible.';
    document.getElementById('deleteModalEv').classList.add('open');
    return false;
  }
  document.getElementById('cancelDeleteEv').addEventListener('click', () => {
    document.getElementById('deleteModalEv').classList.remove('open');
    pendingDeleteEv = null;
  });
  document.getElementById('confirmDeleteEv').addEventListener('click', () => {
    if (pendingDeleteEv) pendingDeleteEv.submit();
  });
  document.getElementById('deleteModalEv').addEventListener('click', e => {
    if (e.target.id === 'deleteModalEv') {
      document.getElementById('deleteModalEv').classList.remove('open');
      pendingDeleteEv = null;
    }
  });
</script>
{% endblock %}
