{% extends 'base_backoffice.html.twig' %}

{% block title %}Questions — Backoffice{% endblock %}
{% block page_label %}Questions / réponses{% endblock %}

{% set typeLabels = {
  'texte_libre': 'Texte libre',
  'choix_unique': 'Choix unique',
  'choix_multiple': 'Choix multiple',
  'vrai_faux': 'Vrai / faux',
  'echelle': 'Échelle',
} %}

{% block content %}
{% include '_partials/_admin_design_system.html.twig' %}

{# Hero #}
<div class="ds-hero">
  <div class="ds-hero-dots"></div>
  <div class="ds-hero-body">
    <div class="ds-hero-icon">❓</div>
    <div class="ds-hero-text">
      <h1 class="ds-hero-title">Questions / réponses</h1>
      <p class="ds-hero-sub">Liste globale des questions — recherche et filtres en direct.</p>
      <span class="ds-hero-chip">{{ total }} question{{ total != 1 ? 's' : '' }}</span>
    </div>
    <a href="{{ path('admin_question_new') }}" class="ds-btn-primary" data-spa>+ Nouvelle question</a>
  </div>
</div>

{# Filtres #}
<form method="get" id="adminListForm" class="ds-filters-panel" action="{{ path('admin_question_index') }}">
  <input type="hidden" name="page" value="{{ page }}">
  <div style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center; flex: 1;">
    <div class="ds-filter-search" style="flex: 1; min-width: 220px;">
      <input type="text" name="q" value="{{ q }}" placeholder="🔍 Rechercher (texte, test…)" autocomplete="off">
    </div>
    <select class="ds-filter-select" name="testId">
      <option value="0">Tous les tests</option>
      {% for t in tests %}
        <option value="{{ t.idTest }}" {{ testId == t.idTest ? 'selected' }}>{{ t.titreTest }}</option>
      {% endfor %}
    </select>
    <select class="ds-filter-select" name="type">
      <option value="">Tous les types</option>
      <option value="texte_libre" {{ type == 'texte_libre' ? 'selected' }}>Texte libre</option>
      <option value="choix_unique" {{ type == 'choix_unique' ? 'selected' }}>Choix unique</option>
      <option value="choix_multiple" {{ type == 'choix_multiple' ? 'selected' }}>Choix multiple</option>
      <option value="vrai_faux" {{ type == 'vrai_faux' ? 'selected' }}>Vrai / faux</option>
      <option value="echelle" {{ type == 'echelle' ? 'selected' }}>Échelle</option>
    </select>
    <select class="ds-filter-select" name="oblig">
      <option value="">Obligatoire (tous)</option>
      <option value="oui" {{ oblig == 'oui' ? 'selected' }}>Oui</option>
      <option value="non" {{ oblig == 'non' ? 'selected' }}>Non</option>
    </select>
    <button type="submit" class="ds-btn-primary" style="padding: 9px 18px;">Appliquer</button>
    <a href="{{ path('admin_question_index') }}" class="ds-btn-reset" data-spa>Réinitialiser</a>
  </div>
</form>

{# Table #}
<div class="ds-table-card">
  <table class="ds-table">
    <thead>
      <tr>
        <th>Test</th>
        <th>Question</th>
        <th>Type</th>
        <th style="text-align: center;">Ordre</th>
        <th style="text-align: center;">Obligatoire</th>
        <th style="text-align: right;">Actions</th>
      </tr>
    </thead>
    <tbody>
      {% for question in questions %}
        <tr>
          <td>
            <span style="font-weight: 600; color: var(--green, #1B4332);">
              {{ question.testPsychologique ? question.testPsychologique.titreTest : '—' }}
            </span>
          </td>
          <td style="max-width: 380px;">
            <span style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
              {{ question.texteQuestion }}
            </span>
          </td>
          <td>
            <span class="ds-badge ds-badge--violet">{{ typeLabels[question.typeQuestion] ?? question.typeQuestion }}</span>
          </td>
          <td style="text-align: center; color: #6b7280; font-weight: 600;">{{ question.ordreQuestion ?? '—' }}</td>
          <td style="text-align: center;">
            {% if question.estObligatoire %}
              <span class="ds-badge ds-badge--green">Oui</span>
            {% else %}
              <span class="ds-badge ds-badge--gray">Non</span>
            {% endif %}
          </td>
          <td>
            <div class="ds-actions">
              <a class="ds-action-btn ds-action-btn--view" href="{{ path('admin_question_show', {'id': question.idQuestionReponse}) }}" data-spa title="Voir">👁</a>
              <a class="ds-action-btn ds-action-btn--edit" href="{{ path('admin_question_edit', {'id': question.idQuestionReponse}) }}" data-spa title="Modifier">✏️</a>
              <form method="post" action="{{ path('admin_question_delete', {'id': question.idQuestionReponse}) }}" style="display:inline;" onsubmit="return confirm('Supprimer cette question ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_question_' ~ question.idQuestionReponse) }}">
                <button class="ds-action-btn ds-action-btn--del" type="submit" title="Supprimer">🗑</button>
              </form>
            </div>
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="6">
            <div class="ds-empty">
              <div style="font-size: 48px; margin-bottom: 12px;">❓</div>
              <p style="font-weight: 600; color: var(--green, #1B4332);">Aucune question</p>
              <p style="font-size: 13px; color: #6b7280; margin-top: 6px;">Affinez les filtres ou créez une question.</p>
              <a class="ds-btn-primary" href="{{ path('admin_question_new') }}" style="margin-top: 14px;" data-spa>+ Nouvelle question</a>
            </div>
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
  {% if questions|length > 0 %}
    <div style="padding: 12px 22px; background: #fafbfc; border-top: 1px solid var(--border, #D5DCE6); font-size: 12.5px; color: #6b7280; font-weight: 500;">
      {{ total }} question{{ total != 1 ? 's' : '' }} au total
    </div>
  {% endif %}
</div>

{% if pages > 1 %}
  <div style="display: flex; gap: 6px; justify-content: center; margin-top: 22px; flex-wrap: wrap;">
    {% for p in 1..pages %}
      <a class="ds-action-btn {{ p == page ? 'ds-action-btn--view' : 'ds-action-btn--edit' }}"
         style="width: auto; padding: 0 14px; font-weight: 600;"
         href="{{ path('admin_question_index', {q: q, testId: testId, type: type, oblig: oblig, page: p}) }}" data-spa>{{ p }}</a>
    {% endfor %}
  </div>
{% endif %}
{% endblock %}

{% block javascripts %}
{{ parent() }}
{% endblock %}
