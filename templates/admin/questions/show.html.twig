{% extends 'base_backoffice.html.twig' %}

{% block title %}Détails de la question{% endblock %}
{% block page_label %}Détail question{% endblock %}

{% block content %}
{% include '_partials/_admin_design_system.html.twig' %}

{# Hero #}
<div class="ds-hero">
  <div class="ds-hero-dots"></div>
  <div class="ds-hero-body">
    <div class="ds-hero-icon">👁</div>
    <div class="ds-hero-text">
      <h1 class="ds-hero-title">Détails de la question</h1>
      <p class="ds-hero-sub">{{ question.texte_question|default('Question')|slice(0, 80) }}{% if (question.texte_question|default(''))|length > 80 %}…{% endif %}</p>
    </div>
    <div style="display: flex; gap: 10px;">
      <a href="{{ app.request.headers.get('referer') ?: path('admin_question_index') }}" class="ds-back-link">← Retour</a>
      <a href="{{ path('admin_question_edit', {'id': question.idQuestionReponse}) }}" class="ds-btn-primary">✏️ Modifier</a>
    </div>
  </div>
</div>

<div class="ds-form-page" style="max-width: 900px; margin: 0 auto;">
  <div class="ds-form-card">
    <div class="ds-form-body">
      <h3 class="ds-form-section-title">Informations</h3>

      <div class="ds-detail-grid">
        <div class="ds-detail-item">
          <div class="ds-detail-label">Test associé</div>
          <div class="ds-detail-value">{{ question.id_test ?: '—' }}</div>
        </div>
        <div class="ds-detail-item">
          <div class="ds-detail-label">Type de question</div>
          <div class="ds-detail-value">
            <span class="ds-badge ds-badge--violet">{{ question.type_question ?: '—' }}</span>
          </div>
        </div>
        <div class="ds-detail-item">
          <div class="ds-detail-label">Ordre</div>
          <div class="ds-detail-value">{{ question.ordre_question ?: '—' }}</div>
        </div>
        <div class="ds-detail-item">
          <div class="ds-detail-label">Obligatoire</div>
          <div class="ds-detail-value">
            {% if question.est_obligatoire %}
              <span class="ds-badge ds-badge--green">Oui</span>
            {% else %}
              <span class="ds-badge ds-badge--gray">Non</span>
            {% endif %}
          </div>
        </div>
      </div>

      <div class="ds-detail-block" style="margin-top: 22px;">
        <div class="ds-detail-label">Énoncé</div>
        <div style="background: #fafbfc; padding: 16px 18px; border-radius: 12px; border-left: 3px solid var(--green, #1B4332); margin-top: 8px; color: #1f2937; line-height: 1.6;">
          {{ question.texte_question }}
        </div>
      </div>
    </div>

    <div class="ds-form-body" style="border-top: 1.5px solid var(--border, #D5DCE6);">
      <h3 class="ds-form-section-title">Options & scores</h3>

      <table class="ds-table" style="margin-top: 8px;">
        <thead>
          <tr>
            <th>Option</th>
            <th style="text-align: right;">Score</th>
          </tr>
        </thead>
        <tbody>
          {% set hasAny = false %}
          {% for label, value in {
              'Option 1': question.option1,
              'Score 1': question.score1,
              'Option 2': question.option2,
              'Score 2': question.score2,
              'Option 3': question.option3,
              'Score 3': question.score3,
              'Option 4': question.option4,
              'Score 4': question.score4,
              'Option 5': question.option5,
              'Score 5': question.score5
          } %}
            {% if value is not empty %}
              {% set hasAny = true %}
              <tr>
                <td><strong style="color: var(--green, #1B4332);">{{ label }}</strong></td>
                <td style="text-align: right; font-weight: 600;">{{ value }}</td>
              </tr>
            {% endif %}
          {% endfor %}
          {% if not hasAny %}
            <tr>
              <td colspan="2">
                <div class="ds-empty" style="padding: 24px 12px;">Aucune option définie</div>
              </td>
            </tr>
          {% endif %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}
