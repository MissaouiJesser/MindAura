{# templates/admin/activity_logs/index.html.twig #}
{% extends 'base_backoffice.html.twig' %}

{% block title %}Journal d'activité{% endblock %}
{% block page_label %}Journal d'activité{% endblock %}

{% block content %}
{% include '_partials/_admin_design_system.html.twig' %}

<style>
  .alp-grid {
    display: grid;
    grid-template-columns: 290px 1fr;
    gap: 22px;
    align-items: start;
  }

  .alp-sidebar {
    background: #fff;
    border: 1.5px solid var(--border, #D5DCE6);
    border-radius: 20px;
    padding: 22px;
    position: sticky;
    top: 90px;
    box-shadow: 0 6px 18px -10px rgba(27,67,50,.18);
    animation: fadeUp .55s ease both;
  }
  .alp-sidebar-title {
    font-family: 'Playfair Display', serif;
    font-size: 15px;
    font-weight: 700;
    color: var(--green, #1B4332);
    margin-bottom: 16px;
    padding-bottom: 10px;
    border-bottom: 1.5px solid var(--green-pale, #D8F3DC);
  }
  .alp-field { margin-bottom: 14px; }
  .alp-label {
    display: block;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--green, #1B4332);
    margin-bottom: 6px;
    letter-spacing: .5px;
    text-transform: uppercase;
  }
  .alp-input, .alp-select {
    width: 100%;
    padding: 10px 13px;
    border-radius: 11px;
    border: 1.5px solid var(--border, #D5DCE6);
    font-size: 13px;
    background: #fff;
    color: #1f2937;
    transition: border-color .2s ease, box-shadow .2s ease;
    font-family: 'Outfit', sans-serif;
  }
  .alp-input:focus, .alp-select:focus {
    outline: none;
    border-color: var(--green-light, #52B788);
    box-shadow: 0 0 0 4px rgba(82,183,136,.15);
  }
  .alp-sep { height: 1px; background: var(--border, #D5DCE6); margin: 18px 0; }

  .alp-stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-bottom: 18px;
  }
  .alp-stat-card {
    background: #fff;
    border: 1.5px solid var(--border, #D5DCE6);
    border-radius: 16px;
    padding: 16px 18px;
    box-shadow: 0 4px 12px -6px rgba(27,67,50,.15);
    transition: transform .25s ease, box-shadow .25s ease;
    animation: fadeUp .55s ease both;
  }
  .alp-stat-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 22px -10px rgba(27,67,50,.28);
  }
  .alp-stat-val {
    font-family: 'Playfair Display', serif;
    font-size: 26px;
    font-weight: 700;
    color: var(--green, #1B4332);
    line-height: 1;
  }
  .alp-stat-lbl {
    font-size: 11.5px;
    color: #6b7280;
    font-weight: 500;
    margin-top: 5px;
    text-transform: uppercase;
    letter-spacing: .4px;
  }

  .alp-user-cell { display: flex; align-items: center; gap: 12px; }
  .alp-avatar {
    width: 36px; height: 36px;
    border-radius: 11px;
    display: grid; place-items: center;
    font-size: 12px;
    font-weight: 700;
    color: #fff;
    flex-shrink: 0;
    overflow: hidden;
    position: relative;
    font-family: 'Playfair Display', serif;
  }
  .alp-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .alp-badge-icon {
    position: absolute;
    bottom: -3px; right: -3px;
    width: 16px; height: 16px;
    border-radius: 6px;
    font-size: 9px;
    display: grid; place-items: center;
    border: 2px solid #fff;
  }
  .alp-user-name { font-size: 13px; font-weight: 600; color: var(--green, #1B4332); }
  .alp-user-email { font-size: 11.5px; color: #6b7280; }

  .alp-action-badge {
    display: inline-flex; align-items: center; gap: 6px;
    border-radius: 999px; padding: 4px 12px;
    font-size: 11.5px; font-weight: 600;
  }

  .alp-pag-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    height: 32px;
    padding: 0 10px;
    border-radius: 8px;
    border: 1.5px solid var(--border, #D5DCE6);
    background: #fff;
    color: #475569;
    font-size: 12.5px;
    font-weight: 600;
    text-decoration: none;
    transition: background .2s ease, color .2s ease, border-color .2s ease;
  }
  .alp-pag-btn:hover {
    background: var(--green-pale, #D8F3DC);
    color: var(--green, #1B4332);
    border-color: var(--green-light, #52B788);
  }
  .alp-pag-btn.current {
    background: var(--green, #1B4332);
    color: #fff;
    border-color: var(--green, #1B4332);
  }

  .purge-btn {
    width: 100%;
    padding: 9px;
    border-radius: 11px;
    background: #FEF2F2;
    color: #B91C1C;
    font-weight: 700;
    font-size: 12px;
    border: 1.5px solid #FECACA;
    cursor: pointer;
    transition: background .2s ease, color .2s ease;
  }
  .purge-btn:hover { background: #B91C1C; color: #fff; }

  @media (max-width: 900px) {
    .alp-grid { grid-template-columns: 1fr; }
    .alp-sidebar { position: static; }
    .alp-stats-row { grid-template-columns: repeat(2, 1fr); }
  }
</style>

{% set roleColors = {
  'ROLE_PATIENT':     '#7B5EA7',
  'ROLE_PSYCHOLOGUE': '#00897B',
  'ROLE_COACH':       '#E65100',
  'ROLE_ADMIN':       '#1B4332',
  'ROLE_USER':        '#1565C0',
} %}
{% set roleLabels = {
  'ROLE_PATIENT':     'Patient',
  'ROLE_PSYCHOLOGUE': 'Psychologue',
  'ROLE_COACH':       'Coach',
  'ROLE_ADMIN':       'Admin',
  'ROLE_USER':        'Utilisateur',
} %}
{% set actionLabels = {
  'user.login':          'Connexion',
  'user.logout':         'Déconnexion',
  'user.register':       'Inscription',
  'user.email_verified': 'Email vérifié',
  'user.2fa_setup':      '2FA activée',
  'user.oauth_login':    'OAuth',
  'user.password_reset': 'Reset mdp',
  'user.created':        'Compte créé',
  'user.updated':        'Compte modifié',
  'user.deleted':        'Compte supprimé',
  'user.toggled':        'Statut modifié',
  'profil.updated':      'Profil mis à jour',
  'profil.avatar':       'Avatar modifié',
  'profil.bio':          'Bio sauvegardée',
  'admin.view':          'Consultation',
  'export.csv':          'Export CSV',
  'export.pdf':          'Export PDF',
} %}

{# Hero #}
<div class="ds-hero">
  <div class="ds-hero-dots"></div>
  <div class="ds-hero-body">
    <div class="ds-hero-icon">📋</div>
    <div class="ds-hero-text">
      <h1 class="ds-hero-title">Journal d'activité</h1>
      <p class="ds-hero-sub">Audit complet des actions utilisateurs sur le back-office et le front-office.</p>
      <span class="ds-hero-chip">{{ total }} enregistrement{{ total != 1 ? 's' : '' }}</span>
    </div>
  </div>
</div>

{# Flashes #}
{% for type, messages in app.flashes %}
  {% for msg in messages %}
    <div class="ds-flash ds-flash--{{ type == 'success' ? 'success' : 'error' }}">{{ msg }}</div>
  {% endfor %}
{% endfor %}

<div class="alp-grid">

  {# ════ Sidebar filtres ════ #}
  <aside class="alp-sidebar">
    <div class="alp-sidebar-title">🔍 Filtres</div>

    <form method="get" action="{{ path('app_admin_activity_logs') }}">
      <div class="alp-field">
        <label class="alp-label">Recherche</label>
        <input type="text" name="search" class="alp-input"
               placeholder="Nom, email, action…"
               value="{{ search }}">
      </div>

      <div class="alp-field">
        <label class="alp-label">Type d'action</label>
        <select name="action" class="alp-select">
          <option value="">— Toutes —</option>
          {% for act in availableActions %}
            {% set meta = icons[act] ?? icons['default'] %}
            <option value="{{ act }}" {{ action == act ? 'selected' : '' }}>
              {{ meta.icon }} {{ actionLabels[act] ?? act }}
            </option>
          {% endfor %}
        </select>
      </div>

      <div class="alp-field">
        <label class="alp-label">Office</label>
        <select name="context" class="alp-select">
          <option value="">— Tous —</option>
          <option value="backoffice"  {{ context == 'backoffice'  ? 'selected' : '' }}>🛡️ Back-office</option>
          <option value="frontoffice" {{ context == 'frontoffice' ? 'selected' : '' }}>🌿 Front-office</option>
        </select>
      </div>

      <button type="submit" class="ds-btn-primary" style="width: 100%; justify-content: center; padding: 11px 16px; margin-top: 4px;">Appliquer</button>
      <a href="{{ path('app_admin_activity_logs') }}" class="ds-btn-cancel" style="width: 100%; justify-content: center; margin-top: 8px; display: flex;">
        Réinitialiser
      </a>
    </form>

    <div class="alp-sep"></div>

    <div class="alp-sidebar-title" style="font-size: 13px; border-bottom: none; padding-bottom: 4px; margin-bottom: 8px;">🗑️ Maintenance</div>
    <form method="post" action="{{ path('app_admin_activity_logs_purge') }}"
          onsubmit="return confirm('Supprimer tous les logs de plus de 30 jours ?');">
      <input type="hidden" name="_token" value="{{ csrf_token('purge_logs') }}">
      <button type="submit" class="purge-btn">
        Purger les logs &gt; 30 jours
      </button>
    </form>
    <div style="font-size: 11px; color: #6b7280; margin-top: 8px;">
      Total actuel : <strong style="color: var(--green, #1B4332);">{{ total }}</strong> enregistrement{{ total != 1 ? 's' : '' }}
    </div>
  </aside>

  {# ════ Contenu principal ════ #}
  <div>

    {# Stats rapides #}
    <div class="alp-stats-row">
      <div class="alp-stat-card">
        <div class="alp-stat-val">{{ total }}</div>
        <div class="alp-stat-lbl">Total affiché</div>
      </div>
      <div class="alp-stat-card">
        <div class="alp-stat-val" style="color: var(--green, #1B4332);">
          {{ logs|filter(l => l.context == 'backoffice')|length }}
        </div>
        <div class="alp-stat-lbl">Back-office</div>
      </div>
      <div class="alp-stat-card">
        <div class="alp-stat-val" style="color: var(--violet, #7B5EA7);">
          {{ logs|filter(l => l.context == 'frontoffice')|length }}
        </div>
        <div class="alp-stat-lbl">Front-office</div>
      </div>
      <div class="alp-stat-card">
        <div class="alp-stat-val" style="color: #E65100;">
          {{ logs|filter(l => l.action starts with 'user.login' or l.action == 'user.oauth_login')|length }}
        </div>
        <div class="alp-stat-lbl">Connexions</div>
      </div>
    </div>

    {# Table #}
    <div class="ds-table-card">
      {% if logs is empty %}
        <div class="ds-empty">
          <div style="font-size: 48px; margin-bottom: 12px;">📋</div>
          <p style="font-weight: 600; color: var(--green, #1B4332);">Aucun log ne correspond aux filtres</p>
        </div>
      {% else %}
        <table class="ds-table">
          <thead>
            <tr>
              <th>Utilisateur</th>
              <th>Action</th>
              <th>Office</th>
              <th>Route / IP</th>
              <th>Date & heure</th>
            </tr>
          </thead>
          <tbody>
            {% for log in logs %}
              {% set meta = log.iconMeta %}
              {% set avatarColor = roleColors[log.userRole] ?? '#5A6475' %}
              <tr>
                <td>
                  <div class="alp-user-cell">
                    <div class="alp-avatar" style="background: {{ avatarColor }};">
                      {% if log.userAvatar and log.userAvatar != 'default.png' %}
                        <img src="{{ asset('avatars/' ~ log.userAvatar) }}" alt="">
                      {% else %}
                        {% if log.userName %}
                          {{ log.userName|split(' ')|first|first|upper }}{{ log.userName|split(' ')|last|first|upper }}
                        {% else %}?{% endif %}
                      {% endif %}
                      <div class="alp-badge-icon" style="background: {{ meta.bg }}; color: {{ meta.color }};">
                        {{ meta.icon }}
                      </div>
                    </div>
                    <div>
                      <div class="alp-user-name">{{ log.userName ?? '—' }}</div>
                      <div class="alp-user-email">{{ log.userEmail ?? '' }}</div>
                    </div>
                  </div>
                </td>
                <td>
                  <span class="alp-action-badge"
                        style="background: {{ meta.bg }}; color: {{ meta.color }};">
                    {{ meta.icon }} {{ log.label }}
                  </span>
                </td>
                <td>
                  {% if log.context == 'backoffice' %}
                    <span class="ds-badge ds-badge--violet">🛡️ Back</span>
                  {% else %}
                    <span class="ds-badge ds-badge--green">🌿 Front</span>
                  {% endif %}
                </td>
                <td style="font-size: 12px; color: #6b7280;">
                  {% if log.route %}<div style="font-weight: 600; color: #475569;">{{ log.route }}</div>{% endif %}
                  {% if log.ip %}<div style="opacity: .8;">{{ log.ip }}</div>{% endif %}
                </td>
                <td style="font-size: 12.5px; white-space: nowrap;">
                  <div style="font-weight: 600; color: var(--green, #1B4332);">{{ log.createdAt|date('d/m/Y') }}</div>
                  <div style="color: #9ca3af; font-size: 11.5px;">{{ log.createdAt|date('H:i:s') }}</div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>

        {# Pagination #}
        {% if pages > 1 %}
          <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 22px; border-top: 1.5px solid var(--border, #D5DCE6); background: #fafbfc; flex-wrap: wrap; gap: 10px;">
            <div style="font-size: 12.5px; color: #6b7280;">
              Page <strong style="color: var(--green, #1B4332);">{{ page }}</strong> / {{ pages }} — {{ total }} résultat{{ total != 1 ? 's' : '' }}
            </div>
            <div style="display: flex; gap: 4px;">
              {% if page > 1 %}
                <a href="{{ path('app_admin_activity_logs', app.request.query.all|merge({page: page - 1})) }}" class="alp-pag-btn">‹ Préc.</a>
              {% endif %}
              {% for p in max(1, page - 2)..min(pages, page + 2) %}
                <a href="{{ path('app_admin_activity_logs', app.request.query.all|merge({page: p})) }}"
                   class="alp-pag-btn {{ p == page ? 'current' : '' }}">{{ p }}</a>
              {% endfor %}
              {% if page < pages %}
                <a href="{{ path('app_admin_activity_logs', app.request.query.all|merge({page: page + 1})) }}" class="alp-pag-btn">Suiv. ›</a>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endif %}
    </div>

  </div>
</div>
{% endblock %}
