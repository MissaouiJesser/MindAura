{% extends 'base_backoffice.html.twig' %}

{% block title %}Réponses utilisateurs — Backoffice{% endblock %}
{% block page_label %}Réponses utilisateurs{% endblock %}

{% block content %}
{% include '_partials/_admin_design_system.html.twig' %}

{# Hero #}
<div class="ds-hero">
  <div class="ds-hero-dots"></div>
  <div class="ds-hero-body">
    <div class="ds-hero-icon">📝</div>
    <div class="ds-hero-text">
      <h1 class="ds-hero-title">Réponses utilisateurs</h1>
      <p class="ds-hero-sub">Réponses aux tests psychologiques — export PDF ou Excel selon les filtres actifs.</p>
      <span class="ds-hero-chip">{{ total }} réponse{{ total != 1 ? 's' : '' }}</span>
    </div>
    <div style="display: flex; gap: 10px;">
      <a class="ds-btn-primary" style="background: rgba(255,255,255,.18); border: 1.5px solid rgba(255,255,255,.3);" href="{{ path('admin_reponses_export_pdf', exportQuery) }}">📄 Export PDF</a>
      <a class="ds-btn-primary" style="background: rgba(255,255,255,.18); border: 1.5px solid rgba(255,255,255,.3);" href="{{ path('admin_reponses_export_excel', exportQuery) }}">📊 Export Excel</a>
    </div>
  </div>
</div>

{# Filtres #}
<form method="get" id="adminListForm" class="ds-filters-panel" action="{{ path('admin_reponses_index') }}">
  <input type="hidden" name="page" value="{{ page }}">
  <div style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center; flex: 1;">
    <div class="ds-filter-search" style="flex: 1; min-width: 240px;">
      <input type="text" name="q" value="{{ q }}" placeholder="🔍 Recherche ou ID utilisateur…" autocomplete="off">
    </div>
    <select class="ds-filter-select" name="testId">
      <option value="0">Tous les tests</option>
      {% for t in tests %}
        <option value="{{ t.idTest }}" {{ testId == t.idTest ? 'selected' }}>{{ t.titreTest }}</option>
      {% endfor %}
    </select>
    <button type="submit" class="ds-btn-primary" style="padding: 9px 18px;">Appliquer</button>
    <a class="ds-btn-reset" href="{{ path('admin_reponses_index') }}" data-spa>Réinitialiser</a>
  </div>
</form>

{# Table #}
<div class="ds-table-card">
  <table class="ds-table">
    <thead>
      <tr>
        <th>Utilisateur</th>
        <th>Test</th>
        <th>Question</th>
        <th>Réponse</th>
        <th style="text-align: center;">Score</th>
        <th>Date</th>
      </tr>
    </thead>
    <tbody>
      {% for r in reponses %}
        <tr>
          <td>
            <span class="ds-badge ds-badge--blue">#{{ r.idUtilisateur ?? '—' }}</span>
          </td>
          <td>
            <span style="font-weight: 600; color: var(--green, #1B4332);">
              {{ r.testPsychologique ? r.testPsychologique.titreTest : '—' }}
            </span>
          </td>
          <td style="color: #475569; font-size: 13px; max-width: 280px;">
            <span style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
              {{ r.questionReponse ? r.questionReponse.texteQuestion : '—' }}
            </span>
          </td>
          <td style="color: #475569; font-size: 13px; max-width: 220px;">
            <span style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
              {{ r.reponseTexteLibre ?: (r.optionChoisie ?? '—') }}
            </span>
          </td>
          <td style="text-align: center;">
            {% if r.scoreObtenu is not null %}
              <span class="ds-badge ds-badge--violet">{{ r.scoreObtenu }}</span>
            {% else %}
              <span style="color: #9ca3af;">—</span>
            {% endif %}
          </td>
          <td style="color: #6b7280; font-size: 12.5px; white-space: nowrap;">
            {{ r.dateReponse ? r.dateReponse|date('d/m/Y H:i') : '—' }}
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="6">
            <div class="ds-empty">
              <div style="font-size: 48px; margin-bottom: 12px;">📝</div>
              <p style="font-weight: 600; color: var(--green, #1B4332);">Aucune réponse pour ces critères</p>
            </div>
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
  {% if reponses|length > 0 %}
    <div style="padding: 12px 22px; background: #fafbfc; border-top: 1px solid var(--border, #D5DCE6); font-size: 12.5px; color: #6b7280; font-weight: 500;">
      {{ total }} réponse{{ total != 1 ? 's' : '' }} au total
    </div>
  {% endif %}
</div>

{% if pages > 1 %}
  <div style="display: flex; gap: 6px; justify-content: center; margin-top: 22px; flex-wrap: wrap;">
    {% for p in 1..pages %}
      <a class="ds-action-btn {{ p == page ? 'ds-action-btn--view' : 'ds-action-btn--edit' }}"
         style="width: auto; padding: 0 14px; font-weight: 600;"
         href="{{ path('admin_reponses_index', {q: q, testId: testId, page: p}) }}" data-spa>{{ p }}</a>
    {% endfor %}
  </div>
{% endif %}
{% endblock %}

{% block javascripts %}
{{ parent() }}
{% endblock %}
