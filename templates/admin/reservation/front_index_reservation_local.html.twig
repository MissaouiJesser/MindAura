{# ══ FLASH MESSAGES ══ #}
<div class="flash-zone">
  {% for msg in app.flashes('success') %}
    <div class="flash flash-success">✅ {{ msg }}</div>
  {% endfor %}
  {% for msg in app.flashes('error') %}
    <div class="flash flash-danger">❌ {{ msg }}</div>
  {% endfor %}
</div>

{# ══ Compteurs ══ #}
{% set confirmedCount = 0 %}
{% set pendingCount   = 0 %}
{% set cancelledCount = 0 %}
{% set totalAmount    = 0 %}
{% for res in reservations %}
  {% if res.statusReservation == 'Confirmée' %}    {% set confirmedCount = confirmedCount + 1 %} {% endif %}
  {% if res.statusReservation == 'En attente' %}   {% set pendingCount   = pendingCount   + 1 %} {% endif %}
  {% if res.statusReservation == 'Annulée' %}      {% set cancelledCount = cancelledCount + 1 %} {% endif %}
  {% if res.prixReservation is not null and res.prixReservation != '' %}
    {% set totalAmount = totalAmount + res.prixReservation %}
  {% endif %}
{% endfor %}

{# ══ PAGE HERO ══ #}
<div class="page-hero">
  <div class="hero-inner">
    <div class="hero-left">
      <h1>📋 Mes réservations</h1>
      <p>Retrouvez toutes vos demandes de réservation, suivez leur statut en temps réel et gérez-les facilement depuis cette interface.</p>
      <div class="hero-stats-row">
        <div class="hstat">
          <div class="hstat-num">{{ reservations|length }}</div>
          <div class="hstat-label">Total</div>
        </div>
        <div class="hstat">
          <div class="hstat-num">{{ confirmedCount }}</div>
          <div class="hstat-label">Confirmées</div>
        </div>
        <div class="hstat">
          <div class="hstat-num">{{ pendingCount }}</div>
          <div class="hstat-label">En attente</div>
        </div>
        <div class="hstat">
          <div class="hstat-num">{{ totalAmount }} TND</div>
          <div class="hstat-label">Total estimé</div>
        </div>
      </div>
    </div>
    <a href="{{ path('reservation_local_front_new') }}" class="hero-cta">
      <svg viewBox="0 0 20 20"><path d="M10 4v12M4 10h12" stroke-linecap="round"/></svg>
      Nouvelle réservation
    </a>
  </div>
</div>

{# ══ MAIN ══ #}
<main class="main">

  {# ── Barre de filtres ── #}
  <div class="controls-bar">
    <div class="search-wrap">
      <span class="search-ico">
        <svg viewBox="0 0 20 20"><circle cx="9" cy="9" r="5.5"/><path d="M14 14l3.5 3.5" stroke-linecap="round"/></svg>
      </span>
      <input type="text" id="searchInput" placeholder="Rechercher un local, une salle, un statut…">
    </div>
    <select class="filter-select" id="statusFilter">
      <option value="">Tous les statuts</option>
      <option value="Confirmée">Confirmée</option>
      <option value="En attente">En attente</option>
      <option value="Annulée">Annulée</option>
    </select>
    <select class="filter-select" id="typeFilter">
      <option value="">Local &amp; Salle</option>
      <option value="local">Local uniquement</option>
      <option value="salle">Salle uniquement</option>
    </select>
  </div>

  <div class="results-info">
    <span>Affichage de <strong id="countVisible">{{ reservations|length }}</strong> réservation(s)</span>
  </div>

  {# ── Table des réservations ── #}
  <div class="table-card">
    {% if reservations is empty %}
      <div class="empty-state">
        <div class="empty-icon">📭</div>
        <h3>Aucune réservation trouvée</h3>
        <p>Vous n'avez pas encore effectué de réservation. Parcourez nos locaux et salles disponibles pour planifier votre prochaine séance.</p>
        <a href="{{ path('reservation_local_front_new') }}" class="btn-new">
          <svg viewBox="0 0 20 20"><path d="M10 4v12M4 10h12" stroke-linecap="round"/></svg>
          Créer une réservation
        </a>
      </div>

    {% else %}
      <div class="table-wrap">
        <table id="reservationsTable">
          <thead>
            <tr>
              <th>Local</th>
              <th>Salle</th>
              <th>Date</th>
              <th>Horaires</th>
              <th>Prix</th>
              <th>Statut</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {% for res in reservations %}
              <tr class="res-row"
                  data-local="{{ res.local ? res.local.nomLocal|lower : '' }}"
                  data-salle="{{ res.salle ? res.salle.nomSalle|lower : '' }}"
                  data-status="{{ res.statusReservation|lower }}"
                  data-type="{{ res.local ? 'local' : '' }}{{ res.salle ? 'salle' : '' }}">

                {# Local #}
                <td>
                  {% if res.local %}
                    <span class="badge-local">🏥 {{ res.local.nomLocal }}</span>
                  {% else %}
                    <span class="badge-none">—</span>
                  {% endif %}
                </td>

                {# Salle #}
                <td>
                  {% if res.salle %}
                    <span class="badge-salle">🚪 {{ res.salle.nomSalle }}</span>
                  {% else %}
                    <span class="badge-none">—</span>
                  {% endif %}
                </td>

                {# Date #}
                <td>
                  <div class="cell-date">{{ res.dateReservation ? res.dateReservation|date('d/m/Y') : '—' }}</div>
                </td>

                {# Horaires #}
                <td>
                  <div class="cell-date">
                    {{ res.heureDebutReservation ? res.heureDebutReservation|date('H:i') : '—' }}
                    →
                    {{ res.heureFinReservation ? res.heureFinReservation|date('H:i') : '—' }}
                  </div>
                </td>

                {# Prix #}
                <td>
                  <span class="cell-prix">{{ res.prixReservation ? res.prixReservation ~ ' TND' : '—' }}</span>
                </td>

                {# Statut #}
                <td>
                  {% if res.statusReservation == 'Confirmée' %}
                    <span class="status-chip status-confirmed"><span class="status-dot"></span>Confirmée</span>
                  {% elseif res.statusReservation == 'En attente' %}
                    <span class="status-chip status-pending"><span class="status-dot"></span>En attente</span>
                  {% elseif res.statusReservation == 'Annulée' %}
                    <span class="status-chip status-cancelled"><span class="status-dot"></span>Annulée</span>
                  {% else %}
                    <span class="status-chip status-other">{{ res.statusReservation }}</span>
                  {% endif %}
                </td>

                {# Actions : Modifier + Supprimer #}
                <td>
                  <div class="cell-actions">

                    {# Bouton Modifier #}
                    <a href="{{ path('reservation_local_edit', {id: res.idReservation}) }}" class="btn-edit">
                      <svg viewBox="0 0 20 20"><path d="M13.586 3.586a2 2 0 112.828 2.828l-8.5 8.5L4 16l1.086-3.914 8.5-8.5z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      Modifier
                    </a>

                    {# Bouton Supprimer — ouvre le modal de confirmation #}
                    <button type="button" class="btn-delete"
                            onclick="openDeleteModal(
                              '{{ path('reservation_local_delete', {id: res.idReservation}) }}',
                              '{{ csrf_token('delete' ~ res.idReservation) }}',
                              '{{ res.local ? res.local.nomLocal : (res.salle ? res.salle.nomSalle : 'cette réservation') }}'
                            )">
                      <svg viewBox="0 0 20 20"><polyline points="3 6 5 6 17 6"/><path d="M8 6V4h4v2M19 6l-1 12a2 2 0 01-2 2H6a2 2 0 01-2-2L3 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      Supprimer
                    </button>

                  </div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </div>

</main>

{# ══ MODAL CONFIRMATION SUPPRESSION ══ #}
<div class="modal-overlay" id="deleteModal">
  <div class="modal-box">
    <div class="modal-icon-wrap">
      <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M8 6V4h8v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
    </div>
    <div class="modal-title">Confirmer la suppression</div>
    <p class="modal-msg">Vous êtes sur le point de supprimer la réservation pour <strong id="modalTargetName"></strong>. Cette action est irréversible.</p>
    <div class="modal-actions">
      <button class="modal-cancel" onclick="closeDeleteModal()">Annuler</button>
      <form id="deleteForm" method="post" style="flex:1;display:contents;">
        <input type="hidden" name="_method" value="DELETE">
        <input type="hidden" name="_token" id="modalCsrfToken" value="">
