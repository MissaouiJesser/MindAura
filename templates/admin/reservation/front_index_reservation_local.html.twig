{# ══ TOAST ══ #}
<div class="toast" id="toast">
  <span>&#10003;</span><span id="toast-msg">Action effectuée !</span>
</div>

<script>
/* ── Navbar scroll shadow ── */
const nav = document.getElementById('main-nav');
window.addEventListener('scroll', () => nav.classList.toggle('scrolled', window.scrollY > 20));

/* ── User pill dropdown ── */
(function () {
  var pillBtn  = document.getElementById('userPillBtn');
  var dropdown = document.getElementById('userDropdown');
  var wrapper  = document.getElementById('userPillWrapper');
  if (!pillBtn || !dropdown) return;

  pillBtn.addEventListener('click', function (e) {
    e.stopPropagation();
    var open = dropdown.classList.toggle('open');
    pillBtn.setAttribute('aria-expanded', open);
  });
  document.addEventListener('click', function (e) {
    if (!wrapper.contains(e.target)) {
      dropdown.classList.remove('open');
      pillBtn.setAttribute('aria-expanded', 'false');
    }
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      dropdown.classList.remove('open');
      pillBtn.setAttribute('aria-expanded', 'false');
    }
  });
})();

/* ── Filtres ── */
function applyFilters() {
  var q      = document.getElementById('searchInput').value.toLowerCase();
  var status = document.getElementById('statusFilter').value.toLowerCase();
  var type   = document.getElementById('typeFilter').value.toLowerCase();
  var count  = 0;

  document.querySelectorAll('.res-row').forEach(function (row) {
    var local  = row.dataset.local  || '';
    var salle  = row.dataset.salle  || '';
    var rowSt  = row.dataset.status || '';
    var rowTy  = row.dataset.type   || '';

    var matchQ  = !q      || local.includes(q) || salle.includes(q) || rowSt.includes(q);
    var matchSt = !status || rowSt.includes(status);
    var matchTy = !type   || rowTy.includes(type);

    var show = matchQ && matchSt && matchTy;
    row.style.display = show ? '' : 'none';
    if (show) count++;
  });
  document.getElementById('countVisible').textContent = count;
}

document.getElementById('searchInput').addEventListener('input', applyFilters);
document.getElementById('statusFilter').addEventListener('change', applyFilters);
document.getElementById('typeFilter').addEventListener('change', applyFilters);

/* ── Modal suppression ── */
function openDeleteModal(action, token, name) {
  document.getElementById('deleteForm').action = action;
  document.getElementById('modalCsrfToken').value = token;
  document.getElementById('modalTargetName').textContent = name;
  document.getElementById('deleteModal').classList.add('open');
}
function closeDeleteModal() {
  document.getElementById('deleteModal').classList.remove('open');
}
// Fermeture clic extérieur
document.getElementById('deleteModal').addEventListener('click', function (e) {
  if (e.target === this) closeDeleteModal();
});
document.addEventListener('keydown', function (e) {
  if (e.key === 'Escape') closeDeleteModal();
});

/* ── Toast ── */
function showToast(msg) {
  var t = document.getElementById('toast');
  document.getElementById('toast-msg').textContent = msg;
  t.classList.add('show');
  setTimeout(function () { t.classList.remove('show'); }, 4000);
}

/* Afficher un toast si flash success présent */
{% for msg in app.flashes('success') %}
  showToast('{{ msg }}');
{% endfor %}
</script>
</body>
</html>
