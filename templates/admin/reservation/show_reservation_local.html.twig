{# templates/admin/reservation/show_reservation_local.html.twig
   Détail d'une réservation — Back-office
   Design harmonisé avec admin/utilisateurs/ #}

{% extends 'base_backoffice.html.twig' %}

{% block title %}Réservation #{{ reservation.idReservation }}{% endblock %}
{% block page_label %}Détail Réservation{% endblock %}

{% block content %}
{% include '_partials/_admin_design_system.html.twig' %}

<style>
  .res-show-layout { display:grid; grid-template-columns:1fr 320px; gap:20px; align-items:start; }
  @media (max-width: 900px) { .res-show-layout { grid-template-columns:1fr; } }

  .res-info-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  @media (max-width: 600px) { .res-info-grid { grid-template-columns:1fr; } }

  .res-info-cell { padding:14px 16px; border-radius:14px; }
  .res-info-cell .lbl {
    font-size:.7rem; font-weight:700; opacity:.75;
    text-transform:uppercase; letter-spacing:.6px; margin-bottom:5px;
  }
  .res-info-cell .val { font-size:.92rem; font-weight:700; }
  .res-info-cell .val a { text-decoration:none; color:inherit; display:inline-flex; align-items:center; gap:5px; }

  .cell-violet { background:var(--violet-pale); color:var(--violet); }
  .cell-green  { background:var(--green-pale); color:var(--green); }
  .cell-teal   { background:#E0F2F1; color:#00897B; }
  .cell-orange { background:#FFF3E0; color:#E65100; }
  .cell-gray   { background:var(--bg); }

  .horaire-block {
    display:flex; align-items:center; gap:18px;
    padding:14px 16px; border-radius:14px; background:var(--bg);
  }
  .horaire-side .sub { font-size:.7rem; color:var(--text-sec); margin-bottom:2px; }
  .horaire-side .hr  { font-size:1.1rem; font-weight:800; color:var(--text); }
  .horaire-arrow { width:24px; height:24px; color:var(--text-sec); }

  .status-card {
    padding:14px; border-radius:14px;
    display:flex; align-items:center; gap:10px;
    font-weight:700; font-size:.92rem;
  }
  .status-dot { width:10px; height:10px; border-radius:50%; flex-shrink:0; }
  .status-confirmee { background:#D8F3DC; color:#1B4332; }
  .status-confirmee .status-dot { background:#52B788; }
  .status-attente   { background:#FFF3E0; color:#D97706; }
  .status-attente .status-dot { background:#F59E0B; }
  .status-annulee   { background:#FEF2F2; color:#991B1B; }
  .status-annulee .status-dot { background:#EF4444; }
  .status-terminee  { background:#E3F2FD; color:#1565C0; }
  .status-terminee .status-dot { background:#1976D2; }
  .status-other     { background:var(--bg); color:var(--text-sec); }
  .status-other .status-dot { background:#9CA3AF; }

  .btn-delete-side {
    width:100%; padding:10px; border-radius:12px;
    background:#FEF2F2; color:#EF4444;
    font-family:'Outfit',sans-serif; font-size:.87rem; font-weight:700;
    border:1.5px solid #FECACA; cursor:pointer; transition:all .2s;
  }
  .btn-delete-side:hover { background:#EF4444; color:#fff; border-color:#EF4444; }
</style>

<div class="ds-hero">
  <div class="ds-hero-dots"><span></span><span></span><span></span></div>
  <div class="ds-hero-body">
    <div class="ds-hero-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="8" r="4"/>
        <path d="M4 22c0-4.4 3.6-8 8-8s8 3.6 8 8"/>
      </svg>
    </div>
    <div class="ds-hero-text">
      <div class="ds-hero-title">{{ reservation.prenomCl }} {{ reservation.nomCl }}</div>
      <div class="ds-hero-sub">
        <span class="ds-hero-chip">Réservation #{{ reservation.idReservation }}</span>
        {% if reservation.local %}
          <span class="ds-hero-chip">
            <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 10V5l4-3 4 3v5H2z"/></svg>
            {{ reservation.local.nomLocal }}
          </span>
        {% endif %}
        {% if reservation.salle %}
          <span class="ds-hero-chip">
            <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="8" height="8" rx="1"/></svg>
            {{ reservation.salle.nomSalle }}
          </span>
        {% endif %}
      </div>
    </div>
    <div style="display:flex;align-items:center;gap:10px;flex-shrink:0;margin-left:auto;flex-wrap:wrap">
      <a href="{{ path('reservation_local_edit', {id: reservation.idReservation}) }}" class="ds-btn-primary">
        <div class="ds-btn-primary-icon">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M13.5 3.5l3 3L8 15l-4 1 1-4z"/>
          </svg>
        </div>
        Modifier
      </a>
      <a href="{{ path('reservation_local_index') }}" class="ds-btn-cancel" style="background:rgba(255,255,255,.13);color:#fff;border-color:rgba(255,255,255,.3)">
        <svg viewBox="0 0 15 15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3l-5 5 5 5"/></svg>
        Retour
      </a>
    </div>
  </div>
</div>

<div class="res-show-layout">

  <div>
    <div class="ds-detail-block">
      <div class="ds-detail-block-title">
        <svg viewBox="0 0 17 17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="11" height="11" rx="2"/>
          <line x1="6" y1="7" x2="11" y2="7"/>
          <line x1="6" y1="10" x2="11" y2="10"/>
        </svg>
        Informations
      </div>

      <div class="res-info-grid">
        <div class="res-info-cell cell-violet">
          <div class="lbl">Nom client</div>
          <div class="val">{{ reservation.prenomCl }} {{ reservation.nomCl }}</div>
        </div>

        <div class="res-info-cell cell-green">
          <div class="lbl">Local</div>
          <div class="val">
            {% if reservation.local %}
              <a href="{{ path('locaux_psychiatrie_show', {id: reservation.local.idLocal}) }}">
                <svg style="width:13px;height:13px" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12V6l5-4 5 4v6H2z"/></svg>
                {{ reservation.local.nomLocal }}
              </a>
            {% else %}—{% endif %}
          </div>
        </div>

        <div class="res-info-cell cell-teal">
          <div class="lbl">Date</div>
          <div class="val">{{ reservation.dateReservation ? reservation.dateReservation|date('d/m/Y') : '—' }}</div>
        </div>

        <div class="res-info-cell cell-orange">
          <div class="lbl">Prix</div>
          <div class="val">{{ reservation.prixReservation ? reservation.prixReservation ~ ' DT' : '—' }}</div>
        </div>

        {% if reservation.salle %}
        <div class="res-info-cell cell-violet">
          <div class="lbl">Salle</div>
          <div class="val">{{ reservation.salle.nomSalle }}</div>
        </div>
        {% endif %}

        <div style="grid-column:1/-1" class="horaire-block">
          <div class="horaire-side">
            <div class="sub">Début</div>
            <div class="hr">{{ reservation.heureDebutReservation ? reservation.heureDebutReservation|date('H:i') : '—' }}</div>
          </div>
          <svg class="horaire-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M5 12h14M14 7l5 5-5 5"/></svg>
          <div class="horaire-side">
            <div class="sub">Fin</div>
            <div class="hr">{{ reservation.heureFinReservation ? reservation.heureFinReservation|date('H:i') : '—' }}</div>
          </div>
        </div>

        {% if reservation.motifReservation %}
        <div style="grid-column:1/-1" class="res-info-cell cell-gray">
          <div class="lbl" style="color:var(--text-sec)">Motif</div>
          <div style="font-size:.88rem;line-height:1.65;color:var(--text);font-weight:500;margin-top:4px">{{ reservation.motifReservation|nl2br }}</div>
        </div>
        {% endif %}
      </div>
    </div>
  </div>

  <div>
    <div class="ds-detail-block">
      <div class="ds-detail-block-title">
        <svg viewBox="0 0 17 17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="8.5" cy="8.5" r="6.5"/><path d="M6 9l2 2 4-4"/></svg>
        Statut
      </div>
      {% if reservation.statusReservation == 'Confirmée' %}
        <div class="status-card status-confirmee"><span class="status-dot"></span>Confirmée</div>
      {% elseif reservation.statusReservation == 'En attente' %}
        <div class="status-card status-attente"><span class="status-dot"></span>En attente</div>
      {% elseif reservation.statusReservation == 'Annulée' %}
        <div class="status-card status-annulee"><span class="status-dot"></span>Annulée</div>
      {% elseif reservation.statusReservation == 'Terminée' %}
        <div class="status-card status-terminee"><span class="status-dot"></span>Terminée</div>
      {% else %}
        <div class="status-card status-other"><span class="status-dot"></span>{{ reservation.statusReservation }}</div>
      {% endif %}
    </div>

    <div class="ds-detail-block">
      <div class="ds-detail-block-title">
        <svg viewBox="0 0 17 17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="8.5" cy="8.5" r="2"/>
          <path d="M13 6.5l1.5-1.5M13 10.5l1.5 1.5M4 6.5L2.5 5M4 10.5L2.5 12M8.5 4V2M8.5 13v2"/>
        </svg>
        Actions
      </div>
      <div style="display:flex;flex-direction:column;gap:10px">
        <a href="{{ path('reservation_local_edit', {id: reservation.idReservation}) }}" class="ds-btn-submit" style="text-decoration:none;justify-content:center">
          <svg viewBox="0 0 15 15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 2l3 3L5 13l-3 1 1-3 7-9z"/>
          </svg>
          Modifier
        </a>
        <a href="{{ path('reservation_local_index') }}" class="ds-btn-cancel" style="justify-content:center;text-align:center">
          Retour à la liste
        </a>
        <div style="border-top:1px solid var(--border);padding-top:10px;margin-top:2px">
          <button type="button" class="btn-delete-side" onclick="openDeleteResShowModal()">
            🗑 Supprimer
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<form id="deleteResaShowForm" method="post" action="{{ path('reservation_local_delete', {id: reservation.idReservation}) }}" style="display:none">
  <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reservation.idReservation) }}">
</form>

<div class="ds-modal-overlay" id="deleteModalResShow">
  <div class="ds-modal-box">
    <div class="ds-modal-icon danger">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="3 6 5 6 21 6"/>
        <path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/>
      </svg>
    </div>
    <div class="ds-modal-title">Supprimer cette réservation ?</div>
    <div class="ds-modal-sub">La réservation de <strong>{{ reservation.prenomCl }} {{ reservation.nomCl }}</strong> sera définitivement supprimée. Cette action est irréversible.</div>
    <div class="ds-modal-actions">
      <button type="button" class="ds-modal-cancel" onclick="closeDeleteResShowModal()">Annuler</button>
      <button type="button" class="ds-modal-confirm-del" onclick="document.getElementById('deleteResaShowForm').submit();">Supprimer</button>
    </div>
  </div>
</div>

<script>
function openDeleteResShowModal()  { document.getElementById('deleteModalResShow').classList.add('open'); }
function closeDeleteResShowModal() { document.getElementById('deleteModalResShow').classList.remove('open'); }
document.getElementById('deleteModalResShow').addEventListener('click', e => {
  if (e.target.id === 'deleteModalResShow') closeDeleteResShowModal();
});
</script>
{% endblock %}
