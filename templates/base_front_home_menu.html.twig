<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{% block title %}Mon espace{% endblock %} - MindAura</title>
  <link rel="icon" type="image/png" href="{{ asset('images/logo.png') }}"/>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;1,400&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --g1:#1B4332; --g2:#2D6A4F; --g3:#52B788; --g-pale:#D8F3DC; --g-hover:#E8F5EE;
      --violet:#7B5EA7; --vio-pale:#EDE9F6; --bg:#F0F4F8; --white:#fff;
      --text:#1A1A2E; --text-sec:#5A6475; --border:#D5DCE6;
      --shadow-card:0 2px 14px rgba(27,67,50,.07), 0 0 0 1px rgba(213,220,230,.5);
      --shadow-hover:0 14px 38px rgba(27,67,50,.13);
    }
    body { font-family:'Outfit',sans-serif; background:var(--bg); color:var(--text); }
    .nav {
      position: sticky; top: 0; z-index: 999;
      background: rgba(255,255,255,.93);
      backdrop-filter: blur(18px) saturate(150%);
      border-bottom: 1px solid rgba(27,67,50,.09);
      padding: 0 48px;
      display: flex; align-items: center; gap: 20px;
      height: 68px;
      transition: box-shadow .3s;
    }
    .nav.scrolled { box-shadow: 0 4px 24px rgba(27,67,50,.11); }
    .nav-brand { display: flex; align-items: center; gap: 11px; text-decoration: none; flex-shrink: 0; }
    .nav-brand-icon {
      width: 42px; height: 42px; border-radius: 12px; background: var(--g1);
      display: grid; place-items: center;
      box-shadow: 0 4px 14px rgba(27,67,50,.28);
      transition: transform .3s ease;
    }
    .nav-brand:hover .nav-brand-icon { transform: rotate(-6deg) scale(1.05); }
    .nav-brand-name { font-family: 'Playfair Display', serif; font-size: 1.22rem; font-weight: 700; color: var(--text); line-height: 1.1; }
    .nav-brand-sub  { font-size: .59rem; color: var(--text-sec); letter-spacing: 1.2px; text-transform: uppercase; font-weight: 600; }
    .nav-links { flex: 1; display: flex; align-items: center; gap: 2px; justify-content: center; }
    .nav-link {
      padding: 7px 17px; border-radius: 99px;
      font-size: .87rem; font-weight: 500; color: var(--text-sec);
      text-decoration: none; transition: all .25s ease;
    }
    .nav-link:hover { background: var(--g-hover); color: var(--g1); }
    .nav-right { display: flex; align-items: center; gap: 10px; }
    .nav-user-pill-wrapper { position: relative; }
    .nav-user-pill {
      display: flex; align-items: center; gap: 9px;
      padding: 5px 14px 5px 5px; border-radius: 99px;
      background: var(--bg); border: 1.5px solid rgba(27,67,50,.13);
      cursor: pointer; font-family: 'Outfit', sans-serif;
      transition: all .25s ease;
    }
    .nav-user-pill:hover,
    .nav-user-pill[aria-expanded="true"] {
      background: var(--g-hover);
      border-color: var(--g3);
      box-shadow: 0 0 0 3px rgba(82,183,136,.12);
    }
    .nav-avatar {
      width: 32px; height: 32px; border-radius: 50%;
      background: var(--g-pale); border: 2px solid var(--g3);
      display: grid; place-items: center;
      font-size: .77rem; font-weight: 700; color: var(--g1);
      overflow: hidden; flex-shrink: 0;
    }
    .nav-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .nav-user-name { font-size: .83rem; font-weight: 600; color: var(--text); }
    .nav-role-badge { font-size: .7rem; color: var(--text-sec); background: var(--g-pale); padding: 2px 8px; border-radius: 99px; font-weight: 600; }
    .pill-chevron { width: 14px; height: 14px; stroke: var(--text-sec); transition: transform .3s ease; margin-left: 2px; fill: none; stroke-width: 2; }
    .nav-user-pill[aria-expanded="true"] .pill-chevron { transform: rotate(180deg); }
    .user-dropdown {
      position: absolute; top: calc(100% + 10px); right: 0; width: 290px;
      background: var(--white); border: 1.5px solid var(--border); border-radius: 14px;
      box-shadow: 0 20px 48px rgba(27,67,50,.14), 0 4px 12px rgba(27,67,50,.07);
      z-index: 1000; opacity: 0; visibility: hidden;
      transform: translateY(-8px) scale(.97); transform-origin: top right;
      transition: opacity .22s ease, transform .22s ease, visibility .22s;
      overflow: hidden;
    }
    .user-dropdown.open { opacity: 1; visibility: visible; transform: translateY(0) scale(1); }
    .dropdown-header { display: flex; align-items: center; gap: 12px; padding: 16px 18px 14px; background: linear-gradient(135deg, var(--g-pale) 0%, rgba(255,255,255,0) 100%); }
    .dropdown-avatar {
      width: 44px; height: 44px; border-radius: 50%;
      background: linear-gradient(135deg, var(--g2), var(--g3)); border: 2.5px solid var(--g3);
      display: grid; place-items: center; font-size: .9rem; font-weight: 700; color: #fff;
      overflow: hidden; flex-shrink: 0; box-shadow: 0 3px 10px rgba(27,67,50,.2);
    }
    .dropdown-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .dropdown-user-name { font-size: .9rem; font-weight: 700; color: var(--text); line-height: 1.2; }
    .dropdown-user-email { font-size: .74rem; color: var(--text-sec); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 180px; }
    .dropdown-divider { height: 1px; background: var(--border); margin: 4px 0; }
    .dropdown-item { display: flex; align-items: center; gap: 12px; padding: 11px 18px; text-decoration: none; color: var(--text); transition: background .18s ease; }
    .dropdown-item:hover { background: var(--g-hover); }
    .dropdown-item-icon { width: 36px; height: 36px; border-radius: 10px; flex-shrink: 0; background: var(--g-pale); display: grid; place-items: center; transition: transform .2s ease; }
    .dropdown-item-icon svg { width: 17px; height: 17px; stroke: var(--g1); fill: none; stroke-width: 1.8; }
    .dropdown-item:hover .dropdown-item-icon { transform: scale(1.08); }
    .dropdown-item-icon--violet { background: var(--vio-pale); }
    .dropdown-item-icon--violet svg { stroke: var(--violet); }
    .dropdown-item-icon--red { background: #FEF2F2; }
    .dropdown-item-icon--red svg { stroke: #DC2626; }
    .dropdown-item-text { flex: 1; display: flex; flex-direction: column; gap: 1px; }
    .dropdown-item-label { font-size: .87rem; font-weight: 600; }
    .dropdown-item-sub { font-size: .73rem; color: var(--text-sec); }
    .dropdown-item-arrow { width: 14px; height: 14px; fill: none; stroke: var(--border); stroke-width: 2; transition: stroke .2s, transform .2s ease; }
    .dropdown-item:hover .dropdown-item-arrow { stroke: var(--g3); transform: translateX(3px); }
    .dropdown-item--danger .dropdown-item-label { color: #DC2626; }
    .dropdown-item--danger:hover { background: #FEF2F2; }
    .btn-primary {
      display:inline-flex; align-items:center; gap:6px; text-decoration:none; cursor:pointer;
      padding:9px 16px; border-radius:10px; border:1px solid var(--g1); background:var(--g1); color:#fff;
      font-size:.84rem; font-weight:600;
    }
    .btn-primary:hover { background:var(--g2); border-color:var(--g2); }
    .btn-secondary {
      display:inline-flex; align-items:center; gap:6px; text-decoration:none; cursor:pointer;
      padding:9px 16px; border-radius:10px; border:1px solid var(--border); background:#fff; color:var(--text-sec);
      font-size:.84rem; font-weight:600;
    }
    .btn-secondary:hover { background:var(--g-hover); color:var(--g1); border-color:var(--g3); }
    .section-title { font-size:.75rem; color:var(--text-sec); text-transform:uppercase; letter-spacing:1px; font-weight:700; }
    .page-shell { max-width: 1180px; margin: 24px auto; padding: 0 18px 24px; }
    .page-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; gap:12px; }
    .page-title { font-family:'Playfair Display',serif; font-size:1.55rem; color:var(--g1); }
    .flash { padding: 12px 16px; border-radius: 10px; margin-bottom: 12px; font-size: .88rem; }
    .flash-success { background: var(--g-pale); color: var(--g1); }
    .flash-danger, .flash-error { background: #FEE2E2; color: #B91C1C; }
    .flash-warning { background: #FFF3E0; color: #E65100; }
  </style>
  {% block stylesheets %}{% endblock %}
</head>
<body>
  {% set user      = app.user %}
  {% set roleRaw   = user.roleUtilisateur %}
  {% set roleSlug  = roleRaw|replace({'ROLE_': ''})|lower %}
  {% set roleLabel = {'patient':'Patient','medecin':'Médecin','coach':'Coach','psychologue':'Psychologue','user':'Utilisateur','admin':'Admin'}[roleSlug] ?? (roleSlug|capitalize) %}
  {% set roleEmoji = {'patient':'🧠','medecin':'🩺','coach':'💪','psychologue':'🧘','user':'👤','admin':'🛡️'}[roleSlug] ?? '👤' %}

  <nav class="nav" id="main-nav">
    <a href="{{ path('app_home') }}#hero" class="nav-brand">
      <div class="nav-brand-icon">
        <img src="{{ asset('images/logo.png') }}" alt="MindAura Logo" style="width: 100%; height: 100%; object-fit: contain; border-radius: 12px;">
      </div>
      <div>
        <div class="nav-brand-name">MindAura</div>
        <div class="nav-brand-sub">Bien-être &amp; Sérénité</div>
      </div>
    </a>

    <div class="nav-links">
      <a href="{{ path('app_home') }}#services" class="nav-link">Services</a>
      <a href="{{ path('app_home') }}#equipe" class="nav-link">Équipe</a>
      <a href="{{ path('app_home') }}#faq" class="nav-link">FAQ</a>
      <a href="{{ path('app_home') }}#map" class="nav-link">Localisation</a>
      <a href="{{ path('app_home') }}#contact" class="nav-link">Contact</a>
    </div>

    <div class="nav-right">
      <div class="nav-user-pill-wrapper" id="userPillWrapper">
        <button class="nav-user-pill" id="userPillBtn" type="button" aria-haspopup="true" aria-expanded="false">
          <div class="nav-avatar">
            {% if user.photoProfilUtilisateur is defined and user.photoProfilUtilisateur != 'default.png' %}
              <img src="{{ asset('avatars/' ~ user.photoProfilUtilisateur) }}" alt="avatar"/>
            {% else %}
              {{ user.prenomUtilisateur|first|upper }}{{ user.nomUtilisateur|first|upper }}
            {% endif %}
          </div>
          <span class="nav-user-name">{{ user.prenomUtilisateur }}</span>
          <span class="nav-role-badge">{{ roleEmoji }} {{ roleLabel }}</span>
          <svg class="pill-chevron" viewBox="0 0 16 16">
            <path d="M4 6l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div class="user-dropdown" id="userDropdown" role="menu">
          <div class="dropdown-header">
            <div class="dropdown-avatar">
              {% if user.photoProfilUtilisateur is defined and user.photoProfilUtilisateur != 'default.png' %}
                <img src="{{ asset('avatars/' ~ user.photoProfilUtilisateur) }}" alt="avatar"/>
              {% else %}
                {{ user.prenomUtilisateur|first|upper }}{{ user.nomUtilisateur|first|upper }}
              {% endif %}
            </div>
            <div>
              <div class="dropdown-user-name">{{ user.prenomUtilisateur }} {{ user.nomUtilisateur }}</div>
              <div class="dropdown-user-email">{{ user.emailUtilisateur }}</div>
            </div>
          </div>
          <div class="dropdown-divider"></div>
          <a href="{{ path('app_profil') }}" class="dropdown-item" role="menuitem">
            <span class="dropdown-item-icon">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="10" cy="7" r="3.5"/>
                <path d="M3 18c0-3.9 3.1-7 7-7s7 3.1 7 7" stroke-linecap="round"/>
              </svg>
            </span>
            <span class="dropdown-item-text">
              <span class="dropdown-item-label">Voir mon profil</span>
              <span class="dropdown-item-sub">Consulter mes informations</span>
            </span>
            <svg class="dropdown-item-arrow" viewBox="0 0 16 16"><path d="M6 4l4 4-4 4" stroke-linecap="round"/></svg>
          </a>
          <a href="{{ path('app_profil_edit') }}" class="dropdown-item" role="menuitem">
            <span class="dropdown-item-icon dropdown-item-icon--violet">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M13.586 3.586a2 2 0 112.828 2.828l-8.5 8.5L4 16l1.086-3.914 8.5-8.5z" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="dropdown-item-text">
              <span class="dropdown-item-label">Modifier mon profil</span>
              <span class="dropdown-item-sub">Mettre à jour vos informations</span>
            </span>
            <svg class="dropdown-item-arrow" viewBox="0 0 16 16"><path d="M6 4l4 4-4 4" stroke-linecap="round"/></svg>
          </a>
          <div class="dropdown-divider"></div>
          <a href="{{ path('app_logout') }}" class="dropdown-item dropdown-item--danger" role="menuitem">
            <span class="dropdown-item-icon dropdown-item-icon--red">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M13 3h4v14h-4M9 14l4-4-4-4M13 10H3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="dropdown-item-text">
              <span class="dropdown-item-label">Déconnexion</span>
              <span class="dropdown-item-sub">Quitter votre session</span>
            </span>
            <svg class="dropdown-item-arrow" viewBox="0 0 16 16"><path d="M6 4l4 4-4 4" stroke-linecap="round"/></svg>
          </a>
        </div>
      </div>
    </div>
  </nav>

  <main class="page-shell">
    <div class="page-head">
      <h1 class="page-title">{% block page_title %}Mon espace{% endblock %}</h1>
      {% block header_actions %}{% endblock %}
    </div>
    {% for type, messages in app.flashes %}
      {% for message in messages %}
        <div class="flash flash-{{ type }}">{{ message }}</div>
      {% endfor %}
    {% endfor %}
    {% block content %}{% endblock %}
  </main>
  <script>
    const nav = document.getElementById('main-nav');
    window.addEventListener('scroll', () => {
      nav.classList.toggle('scrolled', window.scrollY > 20);
    });
    (function() {
      var pillBtn  = document.getElementById('userPillBtn');
      var dropdown = document.getElementById('userDropdown');
      var wrapper  = document.getElementById('userPillWrapper');
      if (!pillBtn || !dropdown) return;
      function openDropdown() {
        dropdown.classList.add('open');
        pillBtn.setAttribute('aria-expanded', 'true');
      }
      function closeDropdown() {
        dropdown.classList.remove('open');
        pillBtn.setAttribute('aria-expanded', 'false');
      }
      function toggleDropdown() {
        dropdown.classList.contains('open') ? closeDropdown() : openDropdown();
      }
      pillBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        toggleDropdown();
      });
      document.addEventListener('click', function(e) {
        if (!wrapper.contains(e.target)) closeDropdown();
      });
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeDropdown();
      });
    })();
  </script>
  {% block javascripts %}{% endblock %}
</body>
</html>

