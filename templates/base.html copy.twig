{# templates/base.html.twig - Front-office ressources MindAura #}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{% block title %}Ressources{% endblock %} — MindAura</title>
  <link rel="icon" type="image/png" href="{{ asset('images/logo.png') }}"/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Lora:ital,wght@0,500;0,700;1,400&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --primary:       #534AB7;
      --primary-dark:  #3d3590;
      --primary-light: #EEEDFC;
      --green:         #1B4332;
      --green-mid:     #2D6A4F;
      --green-light:   #52B788;
      --green-pale:    #D8F3DC;
      --green-hover:   #E8F5EE;
      --bg:            #F4F6FB;
      --bg-body:       #F4F6FB;
      --white:         #FFFFFF;
      --text:          #1A1A2E;
      --text-dark:     #1A1A2E;
      --text-sec:      #5A6475;
      --text-muted:    #8A93A6;
      --border:        #D5DCE6;
      --border-light:  #E8ECF4;
      --shadow-sm:     0 2px 8px rgba(83,74,183,.07);
      --shadow-md:     0 6px 24px rgba(83,74,183,.12);
      --shadow-lg:     0 14px 40px rgba(83,74,183,.16);
      --radius-sm:     8px;
      --radius-md:     12px;
      --radius-lg:     18px;
      --transition:    all .22s ease;
      --sidebar-w:     260px;
      --header-h:      64px;
    }

    html, body { height: 100%; font-family: 'Plus Jakarta Sans', sans-serif; background: var(--bg); color: var(--text); overflow: hidden; }

    /* ══ LAYOUT ══ */
    .layout { display: flex; height: 100vh; gap: 0; }

    /* ══ SIDEBAR ══ */
    .sidebar {
      width: var(--sidebar-w); flex-shrink: 0;
      background: var(--white);
      border-right: 1.5px solid var(--border-light);
      display: flex; flex-direction: column;
      box-shadow: 2px 0 16px rgba(83,74,183,.06);
      z-index: 10; overflow: hidden;
    }

    .sidebar-brand {
      display: flex; align-items: center; gap: 12px;
      padding: 22px 20px 18px;
      border-bottom: 1.5px solid var(--border-light);
    }
    .brand-mark {
      width: 44px; height: 44px; border-radius: 12px;
      background: var(--primary-light);
      display: grid; place-items: center; flex-shrink: 0;
      overflow: hidden;
    }
    .brand-mark img { width: 100%; height: 100%; object-fit: contain; }
    .brand-info .brand-name { font-family: 'Lora', serif; font-size: 1.1rem; font-weight: 700; color: var(--text); }
    .brand-info .brand-sub  { font-size: .62rem; color: var(--text-muted); letter-spacing: 1px; text-transform: uppercase; font-weight: 600; margin-top: 2px; }

    .sidebar-nav { flex: 1; padding: 16px 12px; overflow-y: auto; scrollbar-width: none; }
    .sidebar-nav::-webkit-scrollbar { display: none; }

    .nav-section {
      font-size: .6rem; font-weight: 700; color: var(--text-muted);
      letter-spacing: 1.4px; text-transform: uppercase;
      padding: 14px 10px 6px; display: block;
    }
    .nav-item {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 12px; border-radius: var(--radius-md);
      color: var(--text-sec); font-size: .86rem; font-weight: 500;
      text-decoration: none; transition: var(--transition);
      margin-bottom: 2px; position: relative;
    }
    .nav-item-icon {
      width: 32px; height: 32px; border-radius: 8px;
      background: var(--bg); display: grid; place-items: center; flex-shrink: 0;
      transition: var(--transition);
    }
    .nav-item-icon svg { width: 16px; height: 16px; stroke: var(--text-muted); }
    .nav-item-label { flex: 1; }
    .nav-item:hover { background: var(--primary-light); color: var(--primary); }
    .nav-item:hover .nav-item-icon { background: var(--primary-light); }
    .nav-item:hover .nav-item-icon svg { stroke: var(--primary); }
    .nav-item.active { background: var(--primary-light); color: var(--primary); font-weight: 700; }
    .nav-item.active::before {
      content: ''; position: absolute; left: 0; top: 20%; bottom: 20%;
      width: 3px; border-radius: 0 3px 3px 0; background: var(--primary);
    }
    .nav-item.active .nav-item-icon { background: var(--primary); }
    .nav-item.active .nav-item-icon svg { stroke: #fff; }

    .sidebar-bottom {
      padding: 12px;
      border-top: 1.5px solid var(--border-light);
    }
    .sidebar-user {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 12px; border-radius: var(--radius-md);
      cursor: default; transition: background .2s;
    }
    .sidebar-user:hover { background: var(--bg); }
    .sidebar-avatar {
      width: 36px; height: 36px; border-radius: 50%;
      background: var(--primary-light); border: 2px solid var(--primary);
      display: grid; place-items: center;
      font-size: .8rem; font-weight: 700; color: var(--primary);
      flex-shrink: 0; overflow: hidden;
    }
    .sidebar-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .sidebar-user-name { font-size: .84rem; font-weight: 700; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sidebar-user-role { font-size: .67rem; color: var(--text-muted); margin-top: 1px; }

    /* ══ MAIN ══ */
    .main { flex: 1; display: flex; flex-direction: column; overflow: hidden; min-width: 0; }

    /* ── HEADER ── */
    .header {
      height: var(--header-h); flex-shrink: 0;
      background: var(--white);
      border-bottom: 1.5px solid var(--border-light);
      display: flex; align-items: center; gap: 14px; padding: 0 28px;
      box-shadow: 0 2px 10px rgba(83,74,183,.06);
      position: relative; z-index: 5;
    }
    .header-title { font-family: 'Lora', serif; font-size: 1.2rem; font-weight: 700; color: var(--text); flex: 1; }
    .header-spacer { flex: 1; }
    .header-actions { display: flex; align-items: center; gap: 10px; }
    .icon-btn {
      width: 38px; height: 38px; border-radius: var(--radius-md);
      background: var(--bg); border: 1.5px solid var(--border-light);
      display: grid; place-items: center; cursor: pointer; transition: var(--transition);
    }
    .icon-btn svg { width: 17px; height: 17px; stroke: var(--text-sec); fill: none; }
    .icon-btn:hover { background: var(--primary-light); border-color: var(--primary); }
    .icon-btn:hover svg { stroke: var(--primary); }
    .header-user { display: flex; align-items: center; gap: 8px; cursor: pointer; }
    .header-avatar {
      width: 34px; height: 34px; border-radius: 50%;
      background: var(--primary-light); border: 2px solid var(--primary);
      display: grid; place-items: center;
      font-size: .75rem; font-weight: 700; color: var(--primary);
    }
    .header-user-name { font-size: .84rem; font-weight: 600; color: var(--text); }

    /* ── CONTENT ── */
    .content {
      flex: 1; overflow-y: auto; padding: 28px 32px;
    }
    .content::-webkit-scrollbar { width: 6px; }
    .content::-webkit-scrollbar-thumb { background: var(--border); border-radius: 99px; }
    .content::-webkit-scrollbar-track { background: transparent; }

    /* ── FLASH ── */
    .flash { padding: 12px 16px; border-radius: var(--radius-md); margin-bottom: 14px; font-size: .88rem; font-weight: 500; }
    .flash-success { background: var(--green-pale); color: var(--green); border-left: 3px solid var(--green-light); }
    .flash-error, .flash-danger { background: #FEE2E2; color: #B91C1C; border-left: 3px solid #EF4444; }
    .flash-warning { background: #FFFBEB; color: #92400E; border-left: 3px solid #F59E0B; }

    /* ══ FILTER PANEL ══ */
    .filter-panel {
      background: var(--white);
      border-radius: var(--radius-lg);
      padding: 20px;
      margin-bottom: 24px;
      border: 1.5px solid var(--border-light);
      box-shadow: var(--shadow-sm);
    }
    .filter-row { display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap; }
    .search-wrap { flex: 1; min-width: 200px; position: relative; }
    .search-wrap svg { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); width: 16px; height: 16px; stroke: #aaa; fill: none; }
    .search-wrap input {
      width: 100%; padding: 10px 12px 10px 38px;
      border: 1.5px solid var(--border-light); border-radius: var(--radius-md);
      font-size: 13px; font-family: inherit; background: var(--bg);
      outline: none; transition: var(--transition);
    }
    .search-wrap input:focus { border-color: var(--primary); background: var(--white); box-shadow: 0 0 0 3px rgba(83,74,183,.08); }
    .filter-group { display: flex; flex-direction: column; gap: 4px; min-width: 140px; }
    .filter-label { font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: .5px; }
    .filter-select {
      padding: 9px 12px; border: 1.5px solid var(--border-light); border-radius: var(--radius-md);
      font-size: 13px; font-family: inherit; background: var(--bg); outline: none; cursor: pointer; transition: var(--transition);
    }
    .filter-select:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(83,74,183,.08); }
    .btn-sage {
      padding: 9px 18px; border-radius: var(--radius-md);
      background: var(--primary); color: white;
      border: none; font-size: 13px; font-weight: 600; font-family: inherit;
      cursor: pointer; transition: var(--transition); text-decoration: none;
      display: inline-flex; align-items: center; gap: 6px;
    }
    .btn-sage:hover { background: var(--primary-dark); transform: translateY(-1px); box-shadow: var(--shadow-md); }

    /* ══ RESOURCE GRID ══ */
    .resources-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 20px;
    }
    .resource-card {
      background: var(--white);
      border-radius: var(--radius-lg);
      border: 1.5px solid var(--border-light);
      overflow: hidden; transition: var(--transition);
      display: flex; flex-direction: column;
      box-shadow: var(--shadow-sm);
    }
    .resource-card:hover { box-shadow: var(--shadow-lg); transform: translateY(-3px); border-color: var(--primary); }

    .resource-card-thumb { position: relative; height: 170px; background: var(--primary-light); overflow: hidden; }
    .resource-card-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
    .resource-card:hover .resource-card-thumb img { transform: scale(1.05); }
    .resource-card-thumb-placeholder {
      width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
      font-size: 3.5rem;
      background: linear-gradient(135deg, var(--primary-light), #f0eeff);
    }
    .resource-card-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,.25), transparent); }
    .resource-card-badges { position: absolute; top: 10px; left: 10px; display: flex; gap: 6px; }
    .badge { padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; }
    .badge-sage { background: var(--primary); color: white; }
    .badge-pebble { background: rgba(255,255,255,.92); color: var(--text); }

    .resource-card-body { padding: 16px; flex: 1; }
    .resource-card-title {
      font-size: 15px; font-weight: 700; color: var(--text-dark); margin-bottom: 6px; line-height: 1.4;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
    .resource-card-excerpt {
      font-size: 13px; color: var(--text-muted); line-height: 1.5;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
    .resource-card-meta { display: flex; gap: 12px; margin-top: 10px; }
    .rc-stat { font-size: 12px; color: var(--text-muted); }

    .resource-card-footer {
      padding: 12px 16px; border-top: 1.5px solid var(--border-light);
      display: flex; justify-content: space-between; align-items: center;
      background: var(--bg);
    }

    /* Buttons */
    .btn-primary {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 8px 14px; border-radius: var(--radius-md);
      background: var(--primary); color: white;
      font-size: 13px; font-weight: 600; font-family: inherit;
      border: none; cursor: pointer; transition: var(--transition); text-decoration: none;
    }
    .btn-primary:hover { background: var(--primary-dark); color: white; }

    .like-btn {
      display: inline-flex; align-items: center; gap: 5px;
      padding: 7px 13px; border-radius: var(--radius-md);
      background: transparent; border: 1.5px solid var(--border-light);
      color: var(--text-muted); font-size: 13px; font-weight: 600; font-family: inherit;
      cursor: pointer; transition: var(--transition);
    }
    .like-btn:hover { background: #FEE2E2; border-color: #fca5a5; color: #e11d48; }
    .like-btn:disabled { opacity: .6; cursor: wait; }

    /* ══ EMPTY STATE ══ */
    .empty-state { text-align: center; padding: 60px 20px; color: var(--text-muted); grid-column: 1 / -1; }
    .empty-icon { font-size: 3rem; margin-bottom: 12px; }
    .empty-title { font-size: 18px; font-weight: 700; color: var(--text-dark); margin-bottom: 6px; }
    .empty-sub { font-size: 14px; }

    /* ══ RESPONSIVE ══ */
    @media (max-width: 768px) {
      .sidebar { display: none; }
      .content { padding: 16px; }
      .filter-row { flex-direction: column; }
      .filter-group { min-width: 100%; }
      .resources-grid { grid-template-columns: 1fr; }
    }
  </style>
  {% block stylesheets %}{% endblock %}
</head>
<body>

{% if app.user %}
  {% set user = app.user %}
  {% set roleRaw   = user.roleUtilisateur ?? 'ROLE_USER' %}
  {% set roleSlug  = roleRaw|replace({'ROLE_': ''})|lower %}
  {% set roleLabel = {'patient':'Patient','medecin':'Médecin','coach':'Coach','psychologue':'Psychologue','user':'Utilisateur','admin':'Admin'}[roleSlug] ?? (roleSlug|capitalize) %}
  {% set roleEmoji = {'patient':'🧠','medecin':'🩺','coach':'💪','psychologue':'🧘','user':'👤','admin':'🛡️'}[roleSlug] ?? '👤' %}
{% else %}
  {% set user = null %}
  {% set roleSlug  = 'visiteur' %}
  {% set roleLabel = 'Invité' %}
  {% set roleEmoji = '👤' %}
{% endif %}

<div class="layout">

  <!-- ══ SIDEBAR ══ -->
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">
        <img src="{{ asset('images/logo.png') }}" alt="MindAura" onerror="this.style.display='none'">
      </div>
      <div class="brand-info">
        <div class="brand-name">MindAura</div>
        <div class="brand-sub">Mon espace</div>
      </div>
    </div>

    <nav class="sidebar-nav">
      <span class="nav-section">Principal</span>

      <a href="{{ path('app_home') }}" class="nav-item">
        <span class="nav-item-icon">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M3 9.5L10 3l7 6.5V17a1 1 0 01-1 1H4a1 1 0 01-1-1V9.5z" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="nav-item-label">Accueil</span>
      </a>

      <span class="nav-section">Ressources</span>

      <a href="{{ path('ressources_index') }}"
         class="nav-item {% if app.request.attributes.get('_route') starts with 'ressources' %}active{% endif %}">
        <span class="nav-item-icon">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M4 4h12v12H4z M4 8h12M8 8v8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="nav-item-label">Toutes les ressources</span>
      </a>

      <a href="{{ path('ressources_index', {type: 'PDF'}) }}" class="nav-item">
        <span class="nav-item-icon">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M5 2h7l4 4v12a1 1 0 01-1 1H5a1 1 0 01-1-1V3a1 1 0 011-1z" stroke-linecap="round"/>
            <path d="M12 2v4h4" stroke-linecap="round"/>
          </svg>
        </span>
        <span class="nav-item-label">PDF</span>
      </a>

      <a href="{{ path('ressources_index', {type: 'Video'}) }}" class="nav-item">
        <span class="nav-item-icon">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
            <rect x="2" y="5" width="13" height="11" rx="2"/>
            <path d="M15 8l4-3v9l-4-3V8z" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="nav-item-label">Vidéos</span>
      </a>

      <a href="{{ path('ressources_index', {type: 'Podcast'}) }}" class="nav-item">
        <span class="nav-item-icon">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
            <circle cx="10" cy="8" r="3"/>
            <path d="M5 8a5 5 0 0010 0M10 13v4M7 17h6" stroke-linecap="round"/>
          </svg>
        </span>
        <span class="nav-item-label">Podcasts</span>
      </a>

      <a href="{{ path('ressources_index', {type: 'Article'}) }}" class="nav-item">
        <span class="nav-item-icon">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M4 4h12v12H4z" stroke-linecap="round"/>
            <path d="M7 8h6M7 11h6M7 14h4" stroke-linecap="round"/>
          </svg>
        </span>
        <span class="nav-item-label">Articles</span>
      </a>

      {% block extra_nav %}{% endblock %}
    </nav>

    <div class="sidebar-bottom">
      {% if user %}
        <div class="sidebar-user">
          <div class="sidebar-avatar">
            {% if user.photoProfilUtilisateur is defined and user.photoProfilUtilisateur != 'default.png' %}
              <img src="{{ asset('avatars/' ~ user.photoProfilUtilisateur) }}" alt="avatar"/>
            {% else %}
              {{ user.prenomUtilisateur|first|upper }}{{ user.nomUtilisateur|first|upper }}
            {% endif %}
          </div>
          <div class="sidebar-user-info">
            <div class="sidebar-user-name">{{ user.prenomUtilisateur }} {{ user.nomUtilisateur }}</div>
            <div class="sidebar-user-role">{{ roleEmoji }} {{ roleLabel }}</div>
          </div>
        </div>
      {% else %}
        <div class="sidebar-user">
          <div class="sidebar-avatar">👤</div>
          <div class="sidebar-user-info">
            <div class="sidebar-user-name">Invité</div>
            <div class="sidebar-user-role">👤 Visiteur</div>
          </div>
        </div>
      {% endif %}
    </div>
  </aside>

  <!-- ══ MAIN ══ -->
  <div class="main">

    <header class="header">
      <span class="header-title">{% block page_title %}Ressources{% endblock %}</span>
      <div class="header-spacer"></div>
      <div class="header-actions">
        <button class="icon-btn" title="Notifications">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M10 2a6 6 0 00-6 6v3l-2 3h16l-2-3V8a6 6 0 00-6-6zM8 17a2 2 0 004 0" stroke-linecap="round"/>
          </svg>
        </button>
        {% block header_actions %}{% endblock %}
        {% if user %}
          <div class="header-user">
            <div class="header-avatar">{{ user.prenomUtilisateur|first|upper }}{{ user.nomUtilisateur|first|upper }}</div>
            <span class="header-user-name">{{ user.prenomUtilisateur }}</span>
          </div>
        {% else %}
          <div class="header-user">
            <div class="header-avatar">👤</div>
            <span class="header-user-name">Invité</span>
          </div>
        {% endif %}
      </div>
    </header>

    <main class="content">
      {% for type, messages in app.flashes %}
        {% for message in messages %}
          <div class="flash flash-{{ type }}">{{ message }}</div>
        {% endfor %}
      {% endfor %}
      {% block content %}{% endblock %}
    </main>

  </div>
</div>

{% block javascripts %}{% endblock %}
</body>
</html>
