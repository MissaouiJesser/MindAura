{% extends 'base.html.twig' %}

{% block title %}Mes objectifs{% endblock %}

{% block body %}
<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Mes objectifs</h1>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('danger') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    {% if objectifs is empty %}
        <div class="alert alert-info">
            Vous n'avez pas encore d'objectifs. Contactez-nous .
        </div>
        
    {% else %}
        <div class="row">
            {% for objectif in objectifs %}
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">

                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">{{ objectif.titre }}</h5>
                            <span class="badge bg-{{ objectif.statut == 'actif' ? 'success' : 'secondary' }}">
                                {{ objectif.statut }}
                            </span>
                        </div>

                        <p class="card-text">{{ objectif.description }}</p>

                        <ul class="list-unstyled small text-muted mb-3">
                            <li><strong>Type :</strong> {{ objectif.typeObjectif }}</li>
                            <li><strong>Catégorie :</strong> {{ objectif.categorie }}</li>
                            <li><strong>Difficulté :</strong> {{ objectif.difficule }}</li>
                            <li><strong>Durée estimée :</strong> {{ objectif.dureeEstimee }} jours</li>
                            <li><strong>Échéance :</strong> {{ objectif.dateEcheance|date('d/m/Y') }}</li>
                        </ul>

                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    {% endif %}

    <a href="{{ path('front_tests_index') }}" class="btn btn-secondary mt-2">
        ← Retour aux tests
    </a>
</div>
{% endblock %}
