{% extends 'base.html.twig' %}

{% block title %}Résultats du test{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1>Résultats de {{ test.titreTest }}</h1>
    <p>Votre score total : <strong class="fs-4 text-primary">{{ score }}</strong></p>

    {% if suggested_objectifs %}
    <h2 class="mt-4">Objectifs suggérés</h2>
    <div class="row">
        {% for objectif in suggested_objectifs %}
        <div class="col-md-6 mb-4">
            <div class="card h-100 border-primary">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="card-title mb-0">{{ objectif.titre }}</h5>
                        <span class="badge bg-secondary ms-2">Admin</span>
                    </div>
                    <p class="card-text">{{ objectif.description }}</p>
                    <p><strong>Type :</strong> {{ objectif.typeObjectif }}</p>
                    <p><strong>Catégorie :</strong> {{ objectif.categorie }}</p>
                    <p><strong>Difficulté :</strong> {{ objectif.difficule }}</p>
                    <p><strong>Score requis :</strong> {{ objectif.scoreMin }} – {{ objectif.scoreMax }}</p>

                    <div class="mt-auto">
                        <form method="post"
                              action="{{ path('front_objectifs_adopt', {'id': objectif.idObjectif}) }}">
                            <input type="hidden" name="_token"
                                   value="{{ csrf_token('adopt_' ~ objectif.idObjectif) }}">
                            <button type="submit" class="btn btn-success w-100">
                                ✅ Adopter cet objectif
                            </button>
                        </form>
                    </div>

                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% else %}
        <div class="alert alert-warning mt-4">
            Aucun objectif suggéré pour ce score.
        </div>
    {% endif %}

    <div class="d-flex gap-3 mt-4">
        <a href="{{ path('front_objectifs_index') }}" class="btn btn-outline-secondary">
            📋 Voir mes objectifs
        </a>
        <a href="{{ path('front_tests_index') }}" class="btn btn-secondary">
            ← Retour aux tests
        </a>
    </div>
</div>
{% endblock %}
