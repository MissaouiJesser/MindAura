{% extends 'base.html.twig' %}

{% block title %}Réponses — {{ test.titreTest }}{% endblock %}

{% block body %}
<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Réponses au test : <em>{{ test.titreTest }}</em></h1>
        <a href="{{ path('front_tests_index') }}" class="btn btn-secondary">
            ← Retour aux tests
        </a>
    </div>

    {% if reponses is empty %}
        <div class="alert alert-info">
            Aucune réponse enregistrée pour ce test pour le moment.
        </div>
    {% else %}
        {# ── Regroupement par passage (date_reponse arrondie à la minute) ── #}
        {% set passages = {} %}
        {% for reponse in reponses %}
            {% set cle = reponse.dateReponse|date('d/m/Y H:i') ~ '_' ~ reponse.idReponseClient %}
            {# On regroupe simplement par date pour simuler un passage #}
            {% set dateKey = reponse.dateReponse|date('d/m/Y H:i') %}
            {% if passages[dateKey] is not defined %}
                {% set passages = passages|merge({(dateKey): []}) %}
            {% endif %}
            {% set passages = passages|merge({(dateKey): passages[dateKey]|merge([reponse])}) %}
        {% endfor %}

        <p class="text-muted mb-4">
            {{ reponses|length }} réponse(s) enregistrée(s) —
            {{ passages|length }} passage(s) au total.
        </p>

        {% for dateKey, groupe in passages %}
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <span>
                    <i class="bi bi-clock"></i>
                    Passage du <strong>{{ dateKey }}</strong>
                </span>
                <span class="badge bg-primary">
                    Score total :
                    {% set total = 0 %}
                    {% for r in groupe %}{% set total = total + r.scoreObtenu %}{% endfor %}
                    {{ total }} pts
                </span>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Question</th>
                            <th>Réponse choisie</th>
                            <th class="text-center">Score</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for i, reponse in groupe %}
                        <tr>
                            <td class="text-muted">{{ i + 1 }}</td>
                            <td>{{ reponse.questionReponse.texteQuestion }}</td>
                            <td>
                                <span class="badge bg-info text-dark">
                                    {{ reponse.optionChoisie }}
                                </span>
                            </td>
                            <td class="text-center">
                                <strong>{{ reponse.scoreObtenu }}</strong>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        {% endfor %}

    {% endif %}

</div>
{% endblock %}
