{# templates/favori/liste.html.twig #}
{% extends 'base_user.html.twig' %}

{% block title %}Mes Favoris — MindAura{% endblock %}

{% block stylesheets %}
<style>
    :root { --ink:#1a1a2e; --cream:#f5f0e8; --rust:#c0392b; --sage:#27ae60; --purple:#8e44ad; }

    .fav-hero {
        background: linear-gradient(135deg, var(--ink) 0%, #2c1654 100%);
        color: white; padding: 3rem 2rem 2rem; text-align: center;
    }
    .fav-hero h1 { font-size: clamp(1.6rem, 3vw, 2.4rem); font-weight: 800; margin-bottom: .4rem; }
    .fav-hero p  { opacity: .65; font-size: .95rem; }

    .fav-search-box {
        background: white; border-radius: 16px; padding: 1.5rem 2rem;
        box-shadow: 0 4px 24px rgba(0,0,0,.09); max-width: 520px;
        margin: -1.5rem auto 2rem; position: relative;
    }
    .fav-search-box input {
        border-radius: 10px 0 0 10px; border: 2px solid #e5e7eb; padding: .65rem 1rem;
        font-size: .9rem; outline: none; transition: border .2s;
    }
    .fav-search-box input:focus { border-color: var(--purple); }
    .fav-search-box button {
        border-radius: 0 10px 10px 0; background: var(--purple); color: white;
        border: none; padding: .65rem 1.2rem; font-weight: 700; cursor: pointer;
        transition: background .2s;
    }
    .fav-search-box button:hover { background: #732d91; }

    .fav-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px,1fr)); gap: 1.25rem; }

    .fav-card {
        background: white; border-radius: 14px; overflow: hidden;
        box-shadow: 0 3px 16px rgba(0,0,0,.07); display: flex; flex-direction: column;
        transition: transform .25s, box-shadow .25s;
        animation: fadeUp .35s ease both;
    }
    .fav-card:hover { transform: translateY(-4px); box-shadow: 0 10px 30px rgba(0,0,0,.12); }
    @keyframes fadeUp { from{opacity:0;transform:translateY(14px)} to{opacity:1;transform:translateY(0)} }

    .fav-card-img { height: 160px; background: linear-gradient(135deg, #1a1a2e, #2c3e50); overflow: hidden; }
    .fav-card-img img { width:100%; height:100%; object-fit:cover; }
    .fav-card-img .placeholder { width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:3rem;color:rgba(255,255,255,.18); }

    .fav-card-body { padding: 1rem 1.15rem 1.15rem; flex: 1; display:flex;flex-direction:column; }
    .fav-card-body .badge-type { font-size: .65rem; font-weight:700; color: #9ca3af; text-transform:uppercase; letter-spacing:.5px; margin-bottom:.3rem; }
    .fav-card-body h3 { font-size: .95rem; font-weight:700; color:var(--ink); margin-bottom:.5rem; line-height:1.3; }
    .fav-card-meta { font-size:.78rem; color:#6b7280; display:flex; flex-direction:column; gap:.25rem; margin-bottom:.85rem; }
    .fav-card-meta span { display:flex; align-items:center; gap:.4rem; }

    .btn-retirer {
        margin-top: auto; display:inline-flex; align-items:center; justify-content:center; gap:.4rem;
        background: #fff0f0; color: #dc2626; border: 1.5px solid #fca5a5;
        border-radius: 8px; padding: .5rem 1rem; font-size: .82rem; font-weight:600;
        cursor:pointer; transition: all .2s; text-decoration:none;
    }
    .btn-retirer:hover { background: #dc2626; color: white; border-color: #dc2626; }

    .btn-voir-detail {
        display:inline-flex; align-items:center; gap:.4rem;
        background: var(--ink); color: white;
        border-radius: 8px; padding: .5rem 1rem; font-size: .82rem; font-weight:600;
        text-decoration:none; transition: background .2s; margin-right: .5rem;
    }
    .btn-voir-detail:hover { background: var(--purple); color:white; }

    .empty-state { text-align:center; padding: 4rem 2rem; color: #9ca3af; }
    .empty-state .icon { font-size: 4rem; margin-bottom: 1rem; }
    .empty-state h3 { font-size: 1.2rem; color: #6b7280; margin-bottom: .5rem; }

    .fav-date-added { font-size:.68rem; color:#c4b5fd; background:#f5f3ff; border-radius:6px; padding:.15rem .5rem; display:inline-block; margin-top:.5rem; }
</style>
{% endblock %}

{% block body %}

{# ── Hero ── #}
<div class="fav-hero">
    <div class="fav-hero-inner">
        <h1>❤️ Mes Événements Favoris</h1>
        <p>Retrouvez tous les événements que vous avez enregistrés</p>
    </div>
</div>

<div class="container" style="padding-top:2rem; padding-bottom:4rem;">

    {# ── Formulaire de recherche par email ── #}
    <div class="fav-search-box">
        <p style="font-size:.87rem; color:#6b7280; margin-bottom:.85rem; text-align:center;">
            Entrez votre adresse email pour voir vos favoris enregistrés
        </p>
        <form method="post" action="{{ path('favori_liste') }}">
            <div class="d-flex">
                <input type="email" name="email" class="form-control" required
                       placeholder="votre@email.com"
                       value="{{ email ?? '' }}"
                       style="border-radius:10px 0 0 10px; border:2px solid #e5e7eb; padding:.65rem 1rem;">
                <button type="submit" style="border-radius:0 10px 10px 0; background:#8e44ad; color:white; border:none; padding:.65rem 1.2rem; font-weight:700; cursor:pointer;">
                    🔍 Voir mes favoris
                </button>
            </div>
        </form>
    </div>

    {# ── Messages flash ── #}
    {% for msg in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible mb-3" role="alert">
            ✅ {{ msg }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {# ── Résultats ── #}
    {% if email is not null %}
        {% if favoris is empty %}
            <div class="empty-state">
                <div class="icon">💔</div>
                <h3>Aucun favori trouvé</h3>
                <p style="font-size:.88rem;">Aucun événement favori pour <strong>{{ email }}</strong>.<br>
                Parcourez les événements et cliquez sur ❤️ pour les ajouter !</p>
                <a href="{{ path('evenement_liste') }}" class="btn btn-outline-primary mt-3">
                    📅 Voir les événements
                </a>
            </div>
        {% else %}
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 style="color:#1a1a2e; font-weight:700; margin:0;">
                    {{ favoris|length }} favori{{ favoris|length > 1 ? 's' : '' }} pour <em style="color:#8e44ad;">{{ email }}</em>
                </h5>
                <a href="{{ path('evenement_liste') }}" class="btn btn-sm btn-outline-primary">
                    + Ajouter des événements
                </a>
            </div>

            <div class="fav-grid">
                {% for favori in favoris %}
                {% set ev = favori.evenement %}
                <div class="fav-card">

                    {# Image #}
                    <div class="fav-card-img">
                        {% if ev.image %}
                            <img src="{{ asset('uploads/evenements/' ~ ev.image) }}" alt="{{ ev.titreEvenement }}">
                        {% else %}
                            <div class="placeholder">📅</div>
                        {% endif %}
                    </div>

                    <div class="fav-card-body">
                        <div class="badge-type">
                            📌 {{ ev.typeEvenement.nomType ?? 'Événement' }}
                        </div>
                        <h3>{{ ev.titreEvenement }}</h3>

                        <div class="fav-card-meta">
                            {% if ev.datedebutEvenemnt %}
                            <span>📅 {{ ev.datedebutEvenemnt|date('d/m/Y') }}
                                {% if ev.datefinEvenemnt %} → {{ ev.datefinEvenemnt|date('d/m/Y') }}{% endif %}
                            </span>
                            {% endif %}
                            <span>📍 {{ ev.lieuEvenement }}</span>
                            {% if ev.statutEvenemnt %}
                            <span>
                                {% if ev.statutEvenemnt == 'a_venir' %}🔵 À venir
                                {% elseif ev.statutEvenemnt == 'en_cours' %}🟢 En cours
                                {% elseif ev.statutEvenemnt == 'termine' %}⚫ Terminé
                                {% else %}🔴 Annulé{% endif %}
                            </span>
                            {% endif %}
                        </div>

                        <div class="fav-date-added">
                            ❤️ Ajouté le {{ favori.dateAjout|date('d/m/Y à H:i') }}
                        </div>

                        <div class="mt-3 d-flex flex-wrap gap-2">
                            {# Bouton retirer #}
                            <form method="post" action="{{ path('favori_supprimer', {id: favori.id}) }}" style="display:inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_favori' ~ favori.id) }}">
                                <input type="hidden" name="email" value="{{ email }}">
                                <button type="submit" class="btn-retirer"
                                        onclick="return confirm('Retirer cet événement de vos favoris ?')">
                                    🗑️ Retirer
                                </button>
                            </form>

                            {# Lien participer #}
                            {% if ev.hasPlacesDisponibles() and ev.statutEvenemnt != 'termine' and ev.statutEvenemnt != 'annule' %}
                                <a href="{{ path('evenement_participer', {id: ev.id}) }}" class="btn-voir-detail">
                                    ✅ Participer
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        {% endif %}
    {% endif %}

</div>
{% endblock %}
