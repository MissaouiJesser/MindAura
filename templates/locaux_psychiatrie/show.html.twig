{# templates/locaux_psychiatrie/show.html.twig #}
{% extends 'base_backoffice.html.twig' %}

{% block title %}{{ local.nomLocal }}{% endblock %}
{% block page_label %}Détail Local{% endblock %}

{% block header_actions %}
  <a href="{{ path('locaux_psychiatrie_edit', {id: local.idLocal}) }}" class="btn-primary">
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14.7 4.3a1 1 0 011.4 1.4L6.4 15.4 3 16.7l1.3-3.4 10-10z" stroke-linecap="round"/></svg>
    Modifier
  </a>
{% endblock %}

{% block content %}

<div class="page-header">
  <div style="display:flex;align-items:center;gap:14px">
    <a href="{{ path('locaux_psychiatrie_index') }}" style="width:36px;height:36px;border-radius:10px;background:#fff;border:1.5px solid var(--border);display:grid;place-items:center;text-decoration:none;transition:all .2s;flex-shrink:0"
       onmouseover="this.style.borderColor='var(--green-light)'" onmouseout="this.style.borderColor='var(--border)'">
      <svg style="width:16px;height:16px;color:var(--text-sec)" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M13 5l-6 5 6 5" stroke-linecap="round"/></svg>
    </a>
    <div>
      <div class="page-title">{{ local.nomLocal }}</div>
      <div class="page-sub">{{ local.adresseLocal }}, {{ local.villeLocal }}</div>
    </div>
  </div>
  <div class="page-actions">
    <a href="{{ path('locaux_psychiatrie_edit', {id: local.idLocal}) }}" class="btn-primary">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14.7 4.3a1 1 0 011.4 1.4L6.4 15.4 3 16.7l1.3-3.4 10-10z" stroke-linecap="round"/></svg>
      Modifier
    </a>
  </div>
</div>

<div style="display:grid;grid-template-columns:1fr 320px;gap:20px;align-items:start">

  {# ── Colonne principale ── #}
  <div style="display:flex;flex-direction:column;gap:16px">

    {# Image hero #}
    {% if local.imageURL %}
    <div style="border-radius:16px;overflow:hidden;height:260px;box-shadow:var(--shadow-card);position:relative;animation:fadeUp .4s both">
      <img src="{{ asset('uploads/locaux/' ~ local.imageURL) }}" alt="{{ local.nomLocal }}" style="width:100%;height:100%;object-fit:cover">
      <div style="position:absolute;inset:0;background:linear-gradient(to top, rgba(27,67,50,.55) 0%, transparent 60%)"></div>
      <div style="position:absolute;bottom:20px;left:24px;color:#fff">
        <div style="font-size:1.2rem;font-weight:800;font-family:'Playfair Display',serif">{{ local.nomLocal }}</div>
        <div style="font-size:.82rem;opacity:.85;margin-top:3px">📍 {{ local.adresseLocal }}, {{ local.villeLocal }}</div>
      </div>
    </div>
    {% endif %}

    {# Infos principales en grille #}
    <div style="background:#fff;border-radius:16px;padding:24px;box-shadow:var(--shadow-card);animation:fadeUp .4s cubic-bezier(.22,1,.36,1) .07s both">
      <div style="font-size:.78rem;font-weight:700;color:var(--text-sec);text-transform:uppercase;letter-spacing:.9px;margin-bottom:18px">Informations générales</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">

        {% for info in [
          {label: 'Type', value: local.typeLocal, bg: 'var(--violet-pale)', color: 'var(--violet)'},
          {label: 'Ville', value: local.villeLocal, bg: 'var(--green-pale)', color: 'var(--green)'},
          {label: 'Capacité totale', value: local.capaciteLocal ~ ' personnes', bg: '#E0F2F1', color: '#00897B'},
          {label: 'Téléphone', value: local.telephoneLocal, bg: '#FFF3E0', color: '#E65100'},
        ] %}
        <div style="padding:14px 16px;border-radius:12px;background:{{ info.bg }}">
          <div style="font-size:.73rem;font-weight:600;color:{{ info.color }};opacity:.75;margin-bottom:4px;text-transform:uppercase;letter-spacing:.6px">{{ info.label }}</div>
          <div style="font-size:.92rem;font-weight:700;color:{{ info.color }}">{{ info.value }}</div>
        </div>
        {% endfor %}

        <div style="grid-column:1/-1;padding:14px 16px;border-radius:12px;background:var(--bg)">
          <div style="font-size:.73rem;font-weight:600;color:var(--text-sec);margin-bottom:4px;text-transform:uppercase;letter-spacing:.6px">Adresse complète</div>
          <div style="font-size:.88rem;font-weight:600;color:var(--text)">{{ local.adresseLocal }}, {{ local.villeLocal }}</div>
        </div>

        {% if local.emailLocal %}
        <div style="grid-column:1/-1;padding:14px 16px;border-radius:12px;background:var(--bg)">
          <div style="font-size:.73rem;font-weight:600;color:var(--text-sec);margin-bottom:4px;text-transform:uppercase;letter-spacing:.6px">Email</div>
          <a href="mailto:{{ local.emailLocal }}" style="font-size:.88rem;font-weight:600;color:var(--green);text-decoration:none">{{ local.emailLocal }}</a>
        </div>
        {% endif %}

      </div>
    </div>

    {% if local.descriptionLocal %}
    <div style="background:#fff;border-radius:16px;padding:24px;box-shadow:var(--shadow-card);animation:fadeUp .4s cubic-bezier(.22,1,.36,1) .13s both">
      <div style="font-size:.78rem;font-weight:700;color:var(--text-sec);text-transform:uppercase;letter-spacing:.9px;margin-bottom:14px">Description</div>
      <p style="font-size:.88rem;line-height:1.65;color:var(--text);margin:0">{{ local.descriptionLocal }}</p>
    </div>
    {% endif %}

  </div>

  {# ── Panneau latéral ── #}
  <div style="display:flex;flex-direction:column;gap:16px">

    {# Statut #}
    <div style="background:#fff;border-radius:16px;padding:20px;box-shadow:var(--shadow-card);animation:fadeUp .4s cubic-bezier(.22,1,.36,1) .05s both">
      <div style="font-size:.78rem;font-weight:700;color:var(--text-sec);text-transform:uppercase;letter-spacing:.9px;margin-bottom:14px">Statut</div>
      {% if local.disponibiliteLocal == 'Disponible' %}
        <div style="padding:14px;border-radius:12px;background:#D8F3DC;display:flex;align-items:center;gap:10px">
          <div style="width:10px;height:10px;border-radius:50%;background:#52B788;flex-shrink:0"></div>
          <div>
            <div style="font-size:.9rem;font-weight:700;color:#1B4332">Disponible</div>
            <div style="font-size:.73rem;color:#2D6A4F;margin-top:1px">Ce local est disponible à la réservation</div>
          </div>
        </div>
      {% else %}
        <div style="padding:14px;border-radius:12px;background:#FEF2F2;display:flex;align-items:center;gap:10px">
          <div style="width:10px;height:10px;border-radius:50%;background:#EF4444;flex-shrink:0"></div>
          <div>
            <div style="font-size:.9rem;font-weight:700;color:#991B1B">Indisponible</div>
            <div style="font-size:.73rem;color:#B91C1C;margin-top:1px">Ce local n'est pas disponible</div>
          </div>
        </div>
      {% endif %}
    </div>

    {# Actions #}
    <div style="background:#fff;border-radius:16px;padding:20px;box-shadow:var(--shadow-card);display:flex;flex-direction:column;gap:10px;animation:fadeUp .4s cubic-bezier(.22,1,.36,1) .1s both">
      <div style="font-size:.78rem;font-weight:700;color:var(--text-sec);text-transform:uppercase;letter-spacing:.9px;margin-bottom:4px">Actions</div>
      <a href="{{ path('locaux_psychiatrie_edit', {id: local.idLocal}) }}"
         style="display:flex;align-items:center;justify-content:center;gap:8px;padding:10px;border-radius:12px;background:var(--green);color:#fff;font-family:Outfit,sans-serif;font-size:.87rem;font-weight:600;text-decoration:none;transition:all .2s"
         onmouseover="this.style.background='var(--green-mid)'" onmouseout="this.style.background='var(--green)'">
        <svg style="width:15px;height:15px" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14.7 4.3a1 1 0 011.4 1.4L6.4 15.4 3 16.7l1.3-3.4 10-10z" stroke-linecap="round"/></svg>
        Modifier ce local
      </a>
      <a href="{{ path('locaux_psychiatrie_index') }}"
         style="display:flex;align-items:center;justify-content:center;gap:8px;padding:10px;border-radius:12px;background:var(--bg);color:var(--text-sec);font-family:Outfit,sans-serif;font-size:.87rem;font-weight:600;text-decoration:none;border:1.5px solid var(--border);transition:all .2s"
         onmouseover="this.style.borderColor='var(--green-light)';this.style.color='var(--green)'"
         onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--text-sec)'">
        Retour à la liste
      </a>
      <div style="border-top:1px solid var(--border);padding-top:10px;margin-top:2px">
        <form method="post" action="{{ path('locaux_psychiatrie_delete', {id: local.idLocal}) }}" onsubmit="return confirm('Supprimer définitivement ce local ?')">
          <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ local.idLocal) }}">
          <button type="submit" style="width:100%;padding:10px;border-radius:12px;background:#FEF2F2;color:#EF4444;font-family:Outfit,sans-serif;font-size:.87rem;font-weight:600;border:1.5px solid #FECACA;cursor:pointer;transition:all .2s"
            onmouseover="this.style.background='#EF4444';this.style.color='#fff'"
            onmouseout="this.style.background='#FEF2F2';this.style.color='#EF4444'">
            Supprimer ce local
          </button>
        </form>
      </div>
    </div>

  </div>

</div>

{% endblock %}
