{# ══ HERO ══ #}
{% set availableCount = 0 %}
{% for local in locaux %}
  {% if local.disponibiliteLocal|lower != 'indisponible' %}
    {% set availableCount = availableCount + 1 %}
  {% endif %}
{% endfor %}

<div class="page-hero">
  <div class="hero-inner">
    <div class="hero-left">
      <h1>🏥 Locaux Psychiatriques</h1>
      <p>Découvrez nos espaces thérapeutiques dédiés à votre bien-être mental. Des lieux conçus pour offrir sérénité et professionnalisme.</p>
      <div class="hero-stats-row">
        <div class="hstat">
          <div class="hstat-num">{{ locaux|length }}</div>
          <div class="hstat-label">Total</div>
        </div>
        <div class="hstat">
          <div class="hstat-num">{{ availableCount }}</div>
          <div class="hstat-label">Disponibles</div>
        </div>
        <div class="hstat">
          <div class="hstat-num">{{ locaux|length - availableCount }}</div>
          <div class="hstat-label">Indisponibles</div>
        </div>
      </div>
    </div>
  </div>
</div>

{# ══ MAIN ══ #}
<main class="main">

  {# ── Barre de filtres ── #}
  <div class="controls-bar">
    <div class="search-wrap">
      <span class="search-ico">
        <svg viewBox="0 0 20 20"><circle cx="9" cy="9" r="5.5"/><path d="M16 16l-3.5-3.5" stroke-linecap="round"/></svg>
      </span>
      <input type="text" id="searchInput" placeholder="Rechercher un local…">
    </div>
    <select id="statusFilter" class="filter-select">
      <option value="">Tous les statuts</option>
      <option value="disponible">Disponible</option>
      <option value="indisponible">Indisponible</option>
    </select>
    <select id="typeFilter" class="filter-select">
      <option value="">Tous les types</option>
      <option value="Clinique">Clinique</option>
      <option value="Cabinet">Cabinet</option>
      <option value="Centre">Centre</option>
    </select>
  </div>

  <div class="results-info">
    <div><strong id="countVisible">{{ locaux|length }}</strong> local(aux) trouvé(s)</div>
  </div>

  {# ── Grille ── #}
  <div class="locaux-grid" id="locauxGrid">
    {% if locaux is empty %}
      <div class="empty-state">
        <div class="empty-icon">🏥</div>
        <div class="empty-title">Aucun local disponible</div>
        <p class="empty-sub">Aucun local n'a encore été ajouté.</p>
      </div>
    {% else %}
      {% for local in locaux %}
        <div class="local-card"
             data-name="{{ local.nomLocal|lower }}"
             data-status="{{ local.disponibiliteLocal|lower|default('disponible') }}"
             data-type="{{ local.typeLocal|lower|default('') }}">

          <div class="card-img">
            {% if local.imageURL %}
              <img src="{{ asset('uploads/locaux/' ~ local.imageURL) }}" alt="{{ local.nomLocal }}">
            {% else %}
              <span class="card-img-icon">🏥</span>
            {% endif %}

            {% if local.disponibiliteLocal|lower == 'indisponible' %}
              <div class="card-badge badge-no"><span class="dot"></span> Indisponible</div>
            {% else %}
              <div class="card-badge badge-ok"><span class="dot"></span> Disponible</div>
            {% endif %}

            {% if local.typeLocal %}
              <div class="card-type-tag">{{ local.typeLocal }}</div>
            {% endif %}
          </div>

          <div class="card-body">
            <div class="card-name">{{ local.nomLocal }}</div>
            {% if local.descriptionLocal %}
              <p class="card-desc">{{ local.descriptionLocal }}</p>
            {% else %}
              <p class="card-desc">Local psychiatrique professionnel, conçu pour accueillir des séances thérapeutiques dans les meilleures conditions.</p>
            {% endif %}

            <div class="card-meta-row">
              {% if local.adresseLocal %}
                <div class="meta-chip">
                  <svg viewBox="0 0 20 20"><path d="M10 2a5.5 5.5 0 00-5.5 5.5C4.5 11 10 18 10 18s5.5-7 5.5-10.5A5.5 5.5 0 0010 2z" stroke-linecap="round"/><circle cx="10" cy="7.5" r="1.8"/></svg>
                  {{ local.adresseLocal }}
                </div>
              {% endif %}
              {% if local.capaciteLocal %}
                <div class="meta-chip">
                  <svg viewBox="0 0 20 20"><path d="M3 17V5a2 2 0 012-2h10a2 2 0 012 2v12" stroke-linecap="round"/><path d="M7 17v-5h6v5" stroke-linecap="round"/></svg>
                  {{ local.capaciteLocal }} salle{{ local.capaciteLocal > 1 ? 's' : '' }}
                </div>
              {% endif %}
            </div>
          </div>

          <div class="card-footer-btn">
            <a href="{{ path('locaux_psychiatrie_front_locaux_show', {id: local.idLocal}) }}" class="btn-voir">
              Voir le local
              <svg viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>

        </div>
      {% endfor %}
    {% endif %}
  </div>


  {# ══ SECTION CARTE OPENSTREETMAP / LEAFLET ══ #}
  <div class="map-section" id="mapSection">

    {# ── En-tête ── #}
    <div class="map-section-header">
      <div class="map-modal-icon">
        <svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" stroke-linecap="round"/><circle cx="12" cy="9" r="2.5"/></svg>
      </div>
      <div class="map-modal-title">
        <h2>Carte des Locaux Psychiatriques</h2>
        <p>{{ locaux|length }} local(aux) — Localisez et explorez nos espaces thérapeutiques</p>
      </div>
    </div>

    {# ── Barre de filtres ── #}
    <div class="map-filter-bar">
      <button class="map-filter-btn active" data-map-filter="all" type="button">🏥 Tous</button>
      <button class="map-filter-btn filter-dispo" data-map-filter="disponible" type="button">✅ Disponibles</button>
      <button class="map-filter-btn filter-indispo" data-map-filter="indisponible" type="button">❌ Indisponibles</button>
      <span class="map-filter-count"><strong id="mapVisibleCount">{{ locaux|length }}</strong> local(aux) affiché(s)</span>
    </div>

    {# ── Corps ── #}
    <div class="map-section-body">

      {# Sidebar avec liste des locaux #}
      <div class="map-sidebar" id="mapSidebar">
        {% for local in locaux %}
          <div class="map-local-item"
               data-local-id="{{ local.idLocal }}"
               data-dispo="{{ local.disponibiliteLocal|lower|default('disponible') }}"
               data-lat=""
               data-lng=""
               onclick="flyToLocal({{ local.idLocal }})">
            <div class="map-item-thumb">
              {% if local.imageURL %}
                <img src="{{ asset('uploads/locaux/' ~ local.imageURL) }}" alt="{{ local.nomLocal }}"/>
              {% else %}
                🏥
              {% endif %}
            </div>
            <div class="map-item-info">
              <div class="map-item-name">{{ local.nomLocal }}</div>
              <div class="map-item-addr">{{ local.adresseLocal }}, {{ local.villeLocal }}</div>
              {% if local.disponibiliteLocal|lower == 'indisponible' %}
                <span class="map-item-badge badge-indispo">Indisponible</span>
              {% else %}
                <span class="map-item-badge badge-dispo">Disponible</span>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>

      {# Carte Leaflet #}
      <div class="map-container">
        <div class="map-loading" id="mapLoading">
          <div class="map-loading-spinner"></div>
          <p>Localisation des locaux en cours…</p>
          <p style="font-size:.78rem;color:var(--text-sec);margin-top:-6px;">(~1 sec par local — API OpenStreetMap)</p>
        </div>
        <div id="leaflet-map"></div>
      </div>

    </div>
  </div>

</main>

