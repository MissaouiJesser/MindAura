<script>
/* ── Navbar scroll shadow ── */
const nav = document.getElementById('main-nav');
window.addEventListener('scroll', () => nav.classList.toggle('scrolled', window.scrollY > 20));

/* ── User pill dropdown ── */
(function () {
  var pillBtn  = document.getElementById('userPillBtn');
  var dropdown = document.getElementById('userDropdown');
  var wrapper  = document.getElementById('userPillWrapper');
  if (!pillBtn || !dropdown) return;
  pillBtn.addEventListener('click', function (e) {
    e.stopPropagation();
    var open = dropdown.classList.toggle('open');
    pillBtn.setAttribute('aria-expanded', open);
  });
  document.addEventListener('click', function (e) {
    if (!wrapper.contains(e.target)) {
      dropdown.classList.remove('open');
      pillBtn.setAttribute('aria-expanded', 'false');
    }
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      dropdown.classList.remove('open');
      pillBtn.setAttribute('aria-expanded', 'false');
    }
  });
})();

/* ── Filtres ── */
function applyFilters() {
  var q      = document.getElementById('searchInput').value.toLowerCase();
  var status = document.getElementById('statusFilter').value.toLowerCase();
  var type   = document.getElementById('typeFilter').value.toLowerCase();
  var count  = 0;

  document.querySelectorAll('.local-card').forEach(function (card) {
    var name    = card.dataset.name   || '';
    var cardSt  = card.dataset.status || '';
    var cardTy  = card.dataset.type   || '';

    var matchQ  = !q      || name.includes(q);
    var matchSt = !status || cardSt.includes(status);
    var matchTy = !type   || cardTy.includes(type);

    var show = matchQ && matchSt && matchTy;
    card.style.display = show ? '' : 'none';
    if (show) count++;
  });
  document.getElementById('countVisible').textContent = count;
}

document.getElementById('searchInput').addEventListener('input', applyFilters);
document.getElementById('statusFilter').addEventListener('change', applyFilters);
document.getElementById('typeFilter').addEventListener('change', applyFilters);

/* ── Chatbot MindAura AI ── */
(function () {
    'use strict';

    const trigger      = document.getElementById('chatbot-trigger');
    const panel        = document.getElementById('chatbot-panel');
    const overlay      = document.getElementById('chatbot-overlay');
    const messagesZone = document.getElementById('chatbot-messages');
    const textarea     = document.getElementById('chatbot-input');
    const sendBtn      = document.getElementById('chatbot-send');
    const clearBtn     = document.getElementById('chatbot-clear');
    const closeBtn     = document.getElementById('chatbot-close');
    const typingInd    = document.getElementById('typing-indicator');
    const charCount    = document.getElementById('char-count');
    const quickReplies = document.getElementById('quick-replies');
    const micBtn       = document.getElementById('chatbot-mic');
    const micBadge     = document.getElementById('mic-listening-badge');
    const ttsToggleBtn = document.getElementById('chatbot-tts-toggle');
    const ttsStopBtn   = document.getElementById('chatbot-tts-stop');
    const ttsIconOn    = document.getElementById('tts-icon-on');
    const ttsIconOff   = document.getElementById('tts-icon-off');

    let isOpen       = false;
    let isWaiting    = false;
    let conversation = [];

    /* ══ TEXT-TO-SPEECH (synthèse vocale) ══════════════════════════ */
    let ttsEnabled  = true;   // activé par défaut
    let ttsSpeaking = false;
    const synth     = window.speechSynthesis;

    // Sélectionne la meilleure voix française disponible
    function getBestFrenchVoice() {
        const voices = synth.getVoices();
        // Priorité : voix locale française, puis toute voix fr
        return (
            voices.find(v => v.lang === 'fr-FR' && v.localService) ||
            voices.find(v => v.lang.startsWith('fr') && v.localService) ||
            voices.find(v => v.lang === 'fr-FR') ||
            voices.find(v => v.lang.startsWith('fr')) ||
            null
        );
    }

    // Supprime les balises Markdown avant de lire à voix haute
    function stripMarkdown(text) {
        return text
            .replace(/\*\*(.*?)\*\*/g, '$1')   // gras
            .replace(/\*(.*?)\*/g, '$1')        // italique
            .replace(/#{1,6}\s/g, '')           // titres
            .replace(/`{1,3}[^`]*`{1,3}/g, '')  // code
            .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1') // liens
            .replace(/[-•]\s/g, '')             // listes
            .replace(/\n{2,}/g, '. ')           // doubles sauts de ligne → pause
            .replace(/\n/g, ' ')
            .trim();
    }

    function speakText(text) {
        if (!synth || !ttsEnabled) return;
        // Annule toute lecture en cours avant d'en lancer une nouvelle
        synth.cancel();
        const clean = stripMarkdown(text);
        if (!clean) return;

        const utter = new SpeechSynthesisUtterance(clean);
        utter.lang  = 'fr-FR';
        utter.rate  = 1.0;
        utter.pitch = 1.05;
        utter.volume = 1;

        // Essaie d'utiliser une voix française
        const voice = getBestFrenchVoice();
        if (voice) utter.voice = voice;

        utter.onstart = () => {
            ttsSpeaking = true;
            ttsStopBtn.style.display = 'flex';
        };
        utter.onend = () => {
            ttsSpeaking = false;
            ttsStopBtn.style.display = 'none';
        };
        utter.onerror = () => {
            ttsSpeaking = false;
            ttsStopBtn.style.display = 'none';
        };

        synth.speak(utter);
    }

    function updateTtsUI() {
        if (ttsEnabled) {
            ttsToggleBtn.classList.add('tts-active');
            ttsIconOn.style.display  = 'block';
            ttsIconOff.style.display = 'none';
            ttsToggleBtn.title = 'Lecture vocale activée — cliquer pour désactiver';
        } else {
            ttsToggleBtn.classList.remove('tts-active');
            ttsIconOn.style.display  = 'none';
            ttsIconOff.style.display = 'block';
            ttsToggleBtn.title = 'Lecture vocale désactivée — cliquer pour activer';
            synth.cancel();
            ttsStopBtn.style.display = 'none';
        }
    }

    ttsToggleBtn.addEventListener('click', () => {
        ttsEnabled = !ttsEnabled;
        updateTtsUI();
    });

    ttsStopBtn.addEventListener('click', () => {
        synth.cancel();
        ttsSpeaking = false;
        ttsStopBtn.style.display = 'none';
    });

    // Les voix peuvent charger de manière asynchrone
    if (synth && synth.onvoiceschanged !== undefined) {
        synth.onvoiceschanged = () => { /* prêt */ };
    }

    // Initialise l'UI TTS au démarrage
    updateTtsUI();

    /* ── Web Speech API (reconnaissance vocale) ── */
    let recognition      = null;
    let isRecording      = false;
    let finalTranscript  = '';   // accumule uniquement les segments définitivement reconnus

    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;

    if (!SpeechRecognition) {
        micBtn.classList.add('unsupported');
        micBtn.title = 'Votre navigateur ne supporte pas la reconnaissance vocale';
        micBtn.disabled = true;
    } else {
        recognition = new SpeechRecognition();
        recognition.lang           = 'fr-FR';
        recognition.continuous     = true;   // continue à écouter jusqu'au clic stop
        recognition.interimResults = true;   // affiche la transcription en temps réel

        recognition.onstart = () => {
            isRecording     = true;
            finalTranscript = '';            // reset à chaque nouvelle session
            micBtn.classList.add('recording');
            micBadge.classList.add('visible');
            textarea.placeholder = 'Parlez maintenant…';
        };

        recognition.onresult = (event) => {
            let interimTranscript = '';

            // Parcourt uniquement les nouveaux résultats depuis event.resultIndex
            for (let i = event.resultIndex; i < event.results.length; i++) {
                const transcript = event.results[i][0].transcript;
                if (event.results[i].isFinal) {
                    // Segment définitivement reconnu → on l'ajoute au final
                    finalTranscript += transcript + ' ';
                } else {
                    // Segment encore en cours de reconnaissance → affichage temporaire
                    interimTranscript += transcript;
                }
            }

            // Affiche : texte final confirmé + texte en cours (sans doublons)
            textarea.value = (finalTranscript + interimTranscript).trim();
            textarea.dispatchEvent(new Event('input'));
        };

        recognition.onerror = (e) => {
            if (e.error === 'not-allowed') {
                addBotMessage('⚠️ Accès au microphone refusé. Veuillez autoriser le microphone dans les paramètres de votre navigateur.');
                stopRecording();
            } else if (e.error === 'no-speech') {
                // Silence trop long → on arrête proprement sans relancer indéfiniment
                isRecording = false;
                try { recognition.stop(); } catch(_) {}
            } else if (e.error === 'network') {
                // La Web Speech API nécessite HTTPS (ou localhost) et une connexion active
                const isLocalhost = location.hostname === 'localhost' || location.hostname === '127.0.0.1';
                const isHttps     = location.protocol === 'https:';
                if (!isHttps && !isLocalhost) {
                    addBotMessage('⚠️ La dictée vocale nécessite une connexion sécurisée (HTTPS). Veuillez accéder à l\'application via HTTPS ou en localhost.');
                } else {
                    addBotMessage('⚠️ Erreur réseau lors de la reconnaissance vocale. Vérifiez votre connexion internet et réessayez.');
                }
                stopRecording();
            } else {
                addBotMessage('⚠️ Erreur microphone : ' + e.error);
                stopRecording();
            }
        };

        recognition.onend = () => {
            // Si l'utilisateur n'a pas cliqué stop, on relance pour continuer l'écoute
            if (isRecording) {
                try { recognition.start(); } catch(_) {}
            } else {
                stopRecording(true); // true = envoyer automatiquement si du texte a été dicté
            }
        };

        micBtn.addEventListener('click', () => {
            if (isRecording) {
                // Arrêt manuel : on coupe proprement
                isRecording = false;        // flag AVANT stop() pour ne pas relancer dans onend
                recognition.stop();
            } else {
                finalTranscript  = '';
                textarea.value   = '';
                textarea.dispatchEvent(new Event('input'));
                try { recognition.start(); }
                catch(e) { /* déjà démarré */ }
            }
        });
    }

    function stopRecording(autoSend = false) {
        isRecording = false;
        micBtn.classList.remove('recording');
        micBadge.classList.remove('visible');
        textarea.placeholder = 'Écrivez votre message…';

        const transcribedText = textarea.value.trim();

        if (autoSend && transcribedText && !isWaiting) {
            // Envoie automatiquement le message vocal dès l'arrêt du micro
            sendMessage();
        } else {
            // Sinon, positionne simplement le curseur à la fin pour que l'utilisateur puisse compléter
            textarea.setSelectionRange(transcribedText.length, transcribedText.length);
            textarea.focus();
        }
    }

    const getTime = () => new Date().toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });

    function openPanel() {
        isOpen = true;
        panel.classList.add('is-open');
        panel.setAttribute('aria-hidden', 'false');
        overlay.classList.add('is-visible');
        trigger.classList.add('is-open');
        textarea.focus();
        scrollBottom();
    }

    function closePanel() {
        isOpen = false;
        panel.classList.remove('is-open');
        panel.setAttribute('aria-hidden', 'true');
        overlay.classList.remove('is-visible');
        trigger.classList.remove('is-open');
        // Arrête la lecture vocale si le panel se ferme
        if (synth) synth.cancel();
        ttsStopBtn.style.display = 'none';
    }

    trigger.addEventListener('click', () => isOpen ? closePanel() : openPanel());
    closeBtn.addEventListener('click', closePanel);
    overlay.addEventListener('click', closePanel);

    clearBtn.addEventListener('click', () => {
        if (!confirm('Effacer toute la conversation ?')) return;
        conversation = [];
        messagesZone.innerHTML = '';
        addBotMessage('Conversation réinitialisée. Comment puis-je vous aider ?');
    });

    function scrollBottom() {
        setTimeout(() => { messagesZone.scrollTop = messagesZone.scrollHeight; }, 50);
    }

    function addUserMessage(text) {
        if (quickReplies) quickReplies.style.display = 'none';
        const group = document.createElement('div');
        group.className = 'message-group user-group';
        group.innerHTML = `
            <div class="message">${escapeHtml(text).replace(/\n/g, '<br>')}</div>
            <span class="message-time">${getTime()}</span>
        `;
        messagesZone.appendChild(group);
        scrollBottom();
    }

    function addBotMessage(text, isMarkdown = true) {
        const group = document.createElement('div');
        group.className = 'message-group bot-group';
        const formatted = isMarkdown ? formatMarkdown(text) : escapeHtml(text);
        group.innerHTML = `
            <div class="message">${formatted}</div>
            <span class="message-time">${getTime()}</span>
        `;
        messagesZone.appendChild(group);
        scrollBottom();
        // Lecture vocale automatique si activée
        speakText(text);
    }

    function formatMarkdown(text) {
        return text
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
            .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
            .replace(/\*(.*?)\*/g, '<em>$1</em>')
            .replace(/\n\n/g, '</p><p>')
            .replace(/\n/g, '<br>')
            .replace(/^/, '<p>').replace(/$/, '</p>')
            .replace(/<p><\/p>/g, '');
    }

    function escapeHtml(str) {
        return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    function showTyping() { typingInd.classList.add('is-visible');    scrollBottom(); }
    function hideTyping() { typingInd.classList.remove('is-visible'); }

    textarea.addEventListener('input', () => {
        textarea.style.height = 'auto';
        textarea.style.height = Math.min(textarea.scrollHeight, 100) + 'px';
        const len = textarea.value.length;
        charCount.textContent = len + '/1000';
        sendBtn.disabled = len === 0 || isWaiting;
    });

    textarea.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            if (!sendBtn.disabled) sendMessage();
        }
    });

    sendBtn.addEventListener('click', sendMessage);

    document.querySelectorAll('.quick-reply-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            textarea.value = btn.getAttribute('data-message');
            sendMessage();
        });
    });

    async function sendMessage() {
        const text = textarea.value.trim();
        if (!text || isWaiting) return;

        textarea.value = '';
        textarea.style.height = 'auto';
        charCount.textContent = '0/1000';
        sendBtn.disabled = true;

        addUserMessage(text);
        conversation.push({ role: 'user', content: text });

        isWaiting = true;
        showTyping();

        try {
            const response = await callClaudeAPI(conversation);
            hideTyping();
            addBotMessage(response);
            conversation.push({ role: 'assistant', content: response });
        } catch (err) {
            hideTyping();
            addBotMessage('Désolé, une erreur est survenue. Veuillez réessayer dans quelques instants.');
            console.error('Chatbot error:', err);
        } finally {
            isWaiting = false;
        }
    }

    async function callClaudeAPI(messages) {
        const response = await fetch('/api/chatbot/message', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ messages })
        });

        if (!response.ok) {
            const err = await response.json().catch(() => ({}));
            throw new Error(err.error || `Erreur serveur ${response.status}`);
        }

        const data = await response.json();
        return data.response || 'Je n\'ai pas pu générer une réponse. Veuillez réessayer.';
    }
})();
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script>
/* ══════════════════════════════════════════════════════════════
   CARTE OPENSTREETMAP / LEAFLET — Locaux Psychiatriques
   ══════════════════════════════════════════════════════════════ */
(function () {
  'use strict';

  /* ── Données des locaux (injectées par Twig) ── */
  const LOCAUX_DATA = [
    {% for local in locaux %}
    {
      id:      {{ local.idLocal }},
      nom:     {{ local.nomLocal|json_encode|raw }},
      adresse: {{ local.adresseLocal|json_encode|raw }},
      ville:   {{ local.villeLocal|json_encode|raw }},
      type:    {{ local.typeLocal|default('')|json_encode|raw }},
      dispo:   {{ local.disponibiliteLocal|lower|default('disponible')|json_encode|raw }},
      image:   {% if local.imageURL %}"{{ asset('uploads/locaux/' ~ local.imageURL) }}"{% else %}null{% endif %},
      url:     "{{ path('locaux_psychiatrie_front_locaux_show', {id: local.idLocal}) }}",
      query:   {{ (local.adresseLocal ~ ', ' ~ local.villeLocal ~ ', Tunisia')|json_encode|raw }}
    }{{ not loop.last ? ',' : '' }}
    {% endfor %}
  ];

  /* ── Éléments DOM ── */
  const loadingEl   = document.getElementById('mapLoading');
  const countEl     = document.getElementById('mapVisibleCount');
  const filterBtns  = document.querySelectorAll('[data-map-filter]');

  let leafletMap   = null;
  let markersLayer = null;
  let currentFilter = 'all';

  /* ── Initialisation automatique au chargement de la page ── */
  initMap();

  /* ── Filtres ── */
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentFilter = btn.dataset.mapFilter;
      applyMapFilter();
    });
  });

  function applyMapFilter() {
    if (!markersLayer) return;
    let count = 0;
    markersLayer.eachLayer(layer => {
      const d = layer.options.localData;
      const show = currentFilter === 'all' || d.dispo === currentFilter;
      if (show) {
        if (!leafletMap.hasLayer(layer)) leafletMap.addLayer(layer);
        count++;
      } else {
        if (leafletMap.hasLayer(layer)) leafletMap.removeLayer(layer);
      }
    });

    /* Sidebar sync */
    document.querySelectorAll('.map-local-item').forEach(item => {
      const dispo = item.dataset.dispo || 'disponible';
      const show  = currentFilter === 'all' || dispo === currentFilter;
      item.style.display = show ? '' : 'none';
    });

    countEl.textContent = count;

    /* Recentrer sur les marqueurs visibles */
    const visibleBounds = [];
    markersLayer.eachLayer(layer => {
      if (leafletMap.hasLayer(layer)) visibleBounds.push(layer.getLatLng());
    });
    if (visibleBounds.length > 0) {
      try { leafletMap.fitBounds(L.latLngBounds(visibleBounds), { padding: [40, 40], maxZoom: 14 }); } catch(e) {}
    }
  }

  /* ── Initialisation de la carte ── */
  async function initMap() {

    /* Carte centrée sur la Tunisie */
    leafletMap = L.map('leaflet-map', {
      center: [33.8869, 9.5375],
      zoom: 6,
      zoomControl: true,
      attributionControl: true,
    });

    /* Tuiles OpenStreetMap */
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      maxZoom: 19,
    }).addTo(leafletMap);

    markersLayer = L.layerGroup().addTo(leafletMap);

    /* Géocoder chaque local séquentiellement (1 req/sec — limite Nominatim) */
    const allCoords = [];
    const total = LOCAUX_DATA.length;
    const loadingP = loadingEl.querySelector('p');

    for (let i = 0; i < LOCAUX_DATA.length; i++) {
      const local = LOCAUX_DATA[i];
      if (loadingP) loadingP.textContent = `Localisation ${i + 1} / ${total} — ${local.nom}…`;
      const coords = await geocode(local);
      if (coords) {
        allCoords.push(coords);
        addMarker(local, coords);
        /* Mettre à jour le data-lat/lng dans la sidebar */
        const sideItem = document.querySelector(`[data-local-id="${local.id}"]`);
        if (sideItem) {
          sideItem.dataset.lat = coords.lat;
          sideItem.dataset.lng = coords.lng;
        }
      }
    }

    loadingEl.style.display = 'none';

    /* Forcer Leaflet à recalculer la taille après rendu */
    setTimeout(() => leafletMap.invalidateSize(), 200);

    if (allCoords.length > 0) {
      try { leafletMap.fitBounds(L.latLngBounds(allCoords), { padding: [50, 50], maxZoom: 14 }); } catch(e) {}
    }
  }

  /* ── Délai pour respecter la limite Nominatim (1 req/sec) ── */
  function sleep(ms) { return new Promise(resolve => setTimeout(resolve, ms)); }

  /* ── Géocodage Nominatim avec délai obligatoire + fallback ville ── */
  async function geocode(local) {
    /* Essai 1 : adresse complète */
    try {
      const url = `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(local.query)}&format=json&limit=1&countrycodes=tn`;
      const res  = await fetch(url, { headers: { 'Accept-Language': 'fr', 'User-Agent': 'MindAura/1.0' } });
      const data = await res.json();
      await sleep(1100);
      if (data && data.length > 0) {
        return { lat: parseFloat(data[0].lat), lng: parseFloat(data[0].lon) };
      }
    } catch (e) { await sleep(1100); }

    /* Essai 2 : ville seule (plus permissif) */
    try {
      const fallbackQuery = local.ville + ', Tunisia';
      const url2 = `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(fallbackQuery)}&format=json&limit=1&countrycodes=tn`;
      const res2  = await fetch(url2, { headers: { 'Accept-Language': 'fr', 'User-Agent': 'MindAura/1.0' } });
      const data2 = await res2.json();
      await sleep(1100);
      if (data2 && data2.length > 0) {
        return { lat: parseFloat(data2[0].lat), lng: parseFloat(data2[0].lon) };
      }
    } catch (e) { await sleep(1100); }

    return null;
  }

  /* ── Créer un marqueur stylisé ── */
  function addMarker(local, coords) {
    const isDispo    = local.dispo !== 'indisponible';
    const color      = isDispo ? '#1B4332' : '#DC2626';
    const colorLight = isDispo ? '#52B788' : '#FCA5A5';

    /* Icône SVG inline */
    const svgIcon = `
      <svg xmlns="http://www.w3.org/2000/svg" width="36" height="46" viewBox="0 0 36 46">
        <filter id="shadow" x="-30%" y="-10%" width="160%" height="160%">
          <feDropShadow dx="0" dy="3" stdDeviation="3" flood-color="rgba(0,0,0,0.3)"/>
        </filter>
        <g filter="url(#shadow)">
          <path d="M18 2C10.27 2 4 8.27 4 16c0 10 14 28 14 28S32 26 32 16C32 8.27 25.73 2 18 2z"
                fill="${color}" stroke="white" stroke-width="2"/>
          <circle cx="18" cy="16" r="7" fill="white" opacity="0.95"/>
          <text x="18" y="20" text-anchor="middle" font-size="10" font-family="Outfit,sans-serif" fill="${color}" font-weight="bold">
            🏥
          </text>
        </g>
      </svg>`;

    const icon = L.divIcon({
      html: svgIcon,
      className: '',
      iconSize: [36, 46],
      iconAnchor: [18, 46],
      popupAnchor: [0, -50],
    });

    /* Contenu du popup */
    const imgHtml = local.image
      ? `<div class="map-popup-img"><img src="${local.image}" alt="${local.nom}"/></div>`
      : `<div class="map-popup-img" style="background:linear-gradient(135deg,#D8F3DC,#B2DFDB);">🏥</div>`;

    const dispoTag = isDispo
      ? `<span class="map-popup-tag dispo">✅ Disponible</span>`
      : `<span class="map-popup-tag indispo">❌ Indisponible</span>`;

    const typeTag = local.type
      ? `<span class="map-popup-tag type">${local.type}</span>`
      : '';

    const popupContent = `
      <div class="map-popup">
        ${imgHtml}
        <div class="map-popup-body">
          <div class="map-popup-name">${local.nom}</div>
          <div class="map-popup-addr">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#5A6475" stroke-width="2"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
            ${local.adresse}, ${local.ville}
          </div>
          <div class="map-popup-tags">${dispoTag}${typeTag}</div>
          <a href="${local.url}" class="map-popup-btn">
            Voir le local
            <svg viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>`;

    const marker = L.marker([coords.lat, coords.lng], {
      icon,
      localData: local,
    });

    marker.bindPopup(popupContent, { maxWidth: 260, minWidth: 240 });

    /* Highlight sidebar item au click */
    marker.on('click', () => {
      document.querySelectorAll('.map-local-item').forEach(el => el.classList.remove('active'));
      const sideItem = document.querySelector(`[data-local-id="${local.id}"]`);
      if (sideItem) {
        sideItem.classList.add('active');
        sideItem.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });

    markersLayer.addLayer(marker);
  }

  /* ── Voler vers un local depuis la sidebar ── */
  window.flyToLocal = function (id) {
    document.querySelectorAll('.map-local-item').forEach(el => el.classList.remove('active'));
    const sideItem = document.querySelector(`[data-local-id="${id}"]`);
    if (sideItem) sideItem.classList.add('active');

    if (!leafletMap || !markersLayer) return;
    markersLayer.eachLayer(layer => {
      if (layer.options.localData && layer.options.localData.id === id) {
        const latlng = layer.getLatLng();
        leafletMap.flyTo(latlng, 15, { animate: true, duration: 1.2 });
        setTimeout(() => layer.openPopup(), 1300);
      }
    });
  };

})();
</script>
</body>
</html>
