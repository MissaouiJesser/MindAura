{% extends 'base_frontoffice.html.twig' %}

{% block title %}Réclamations{% endblock %}
{% block page_title %}Espace réclamations{% endblock %}

{% block header_actions %}
  <div class="page-head-actions">
    <a href="{{ path('front_reclamation_new') }}" class="btn-primary">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" width="16" height="16"><path d="M10 4v12M4 10h12" stroke-linecap="round"/></svg>
      Nouvelle réclamation
    </a>
  </div>
{% endblock %}

{% block content %}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Outfit:wght@400;600;700&display=swap');
  @keyframes fadeUp { from { opacity:0; transform: translateY(16px); } to { opacity:1; transform: none; } }
  @keyframes shimmer { 0%,100%{opacity:.45} 50%{opacity:1} }
  :root {
    --green-deep:#0D5C3A; --green-mid:#1A7A4E; --green-bright:#22A06B; --green-pale:#EAF9F2;
    --violet:#1A3A5C; --vio-pale:#E8EEF6;
    --yellow:#F5C842;
  }
  .rec-hero {
    position:relative; overflow:hidden;
    background:linear-gradient(135deg, #1B4332 0%, #1A3A5C 52%, #0F2447 100%);
    border-radius:22px; padding:28px 32px; margin-bottom:20px;
    box-shadow:0 14px 44px rgba(13,92,58,.32);
    animation:fadeUp .45s cubic-bezier(.22,1,.36,1) both;
  }
  .rec-hero::before { content:''; position:absolute; width:300px; height:300px; border-radius:50%; background:rgba(255,255,255,.06); top:-90px; right:-70px; pointer-events:none; }
  .rec-hero::after { content:''; position:absolute; width:120px; height:120px; border-radius:50%; background:rgba(15,36,71,.25); bottom:-40px; left:24px; pointer-events:none; }
  .rec-hero-row { display:flex; align-items:center; gap:20px; flex-wrap:wrap; position:relative; z-index:1; }
  .rec-hero-icon {
    width:56px; height:56px; border-radius:16px; background:rgba(255,255,255,.14); border:1.5px solid rgba(255,255,255,.22);
    display:grid; place-items:center; flex-shrink:0;
  }
  .rec-hero-icon svg { width:26px; height:26px; color:#fff; }
  .rec-hero-title { font-family:'Playfair Display',serif; font-size:1.45rem; font-weight:700; color:#fff; margin:0 0 6px; text-shadow:0 2px 12px rgba(0,0,0,.15); }
  .rec-hero-sub { font-size:.88rem; color:rgba(255,255,255,.78); max-width:520px; line-height:1.5; margin:0; }
  .rec-stats { display:flex; gap:10px; flex-wrap:wrap; margin-left:auto; }
  .rec-stat { background:rgba(255,255,255,.12); border:1px solid rgba(255,255,255,.2); border-radius:12px; padding:10px 16px; text-align:center; min-width:72px; }
  .rec-stat-val { font-family:'Playfair Display',serif; font-size:1.25rem; font-weight:700; color:var(--yellow); }
  .rec-stat-lbl { font-size:.65rem; color:rgba(255,255,255,.65); font-weight:700; text-transform:uppercase; letter-spacing:.6px; margin-top:2px; }

  .scope-chips { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:16px; }
  .scope-chip {
    display:inline-flex; align-items:center; gap:6px; padding:8px 16px; border-radius:99px;
    font-size:.82rem; font-weight:600; text-decoration:none; transition:.2s;
    border:1.5px solid var(--border); background:#fff; color:var(--text-sec);
  }
  .scope-chip:hover { border-color:var(--g3); color:var(--g1); background:var(--g-hover); }
  .scope-chip.active { background:var(--g1); color:#fff; border-color:var(--g1); }

  .toolbar-card {
    background:#fff; border:1.5px solid var(--border); border-radius:18px; padding:18px 20px;
    margin-bottom:20px; box-shadow:var(--shadow-card);
  }
  .toolbar-grid {
    display:grid; grid-template-columns: 1fr repeat(auto-fit, minmax(140px, 1fr)) auto auto;
    gap:12px; align-items:end;
  }
  @media (max-width: 900px) { .toolbar-grid { grid-template-columns: 1fr 1fr; } }
  .tb-wrap { position:relative; }
  .tb-wrap svg { position:absolute; left:12px; top:50%; transform:translateY(-50%); width:18px; height:18px; stroke:var(--text-sec); pointer-events:none; }
  .tb-search {
    width:100%; padding:11px 14px 11px 40px; border:1.5px solid var(--border); border-radius:12px;
    font-size:.9rem; font-family:'Outfit',sans-serif;
  }
  .tb-search:focus { outline:none; border-color:var(--g3); box-shadow:0 0 0 3px rgba(82,183,136,.15); }
  .tb-label { font-size:.72rem; font-weight:700; color:var(--text-sec); text-transform:uppercase; letter-spacing:.5px; margin-bottom:4px; display:block; }
  .tb-select, .tb-date {
    width:100%; padding:10px 12px; border:1.5px solid var(--border); border-radius:12px; font-size:.88rem; font-family:'Outfit',sans-serif;
  }
  .tb-reset {
    display:inline-flex; align-items:center; gap:6px; padding:10px 14px; border-radius:12px;
    border:1.5px dashed var(--border); background:var(--bg); color:var(--text-sec); font-size:.85rem; font-weight:600; text-decoration:none; white-space:nowrap;
  }
  .tb-reset:hover { border-color:var(--g3); color:var(--g1); }

  .rec-grid { display:grid; gap:16px; }
  @media (min-width: 720px) { .rec-grid { grid-template-columns: repeat(2, 1fr); } }
  .rec-card {
    background:#fff; border:1.5px solid var(--border); border-radius:18px; padding:20px 22px;
    box-shadow:var(--shadow-card); transition:.22s var(--ease, ease);
    display:flex; flex-direction:column; gap:12px; animation:fadeUp .4s cubic-bezier(.22,1,.36,1) both;
  }
  .rec-card:hover { box-shadow:var(--shadow-hover); border-color:rgba(82,183,136,.35); }
  .rec-card-top { display:flex; justify-content:space-between; align-items:flex-start; gap:10px; }
  .rec-badge { font-size:.72rem; font-weight:700; padding:4px 10px; border-radius:8px; text-transform:uppercase; letter-spacing:.4px; }
  .rec-badge.cat { background:var(--vio-pale); color:var(--violet); }
  .rec-status { font-size:.75rem; font-weight:700; padding:4px 10px; border-radius:8px; }
  .st-wait { background:#FEF3C7; color:#B45309; }
  .st-prog { background:#DBEAFE; color:#1565C0; }
  .st-done { background:#DCFCE7; color:#15803D; }
  .st-rej { background:#FEE2E2; color:#DC2626; }
  .rec-card-title { font-family:'Playfair Display',serif; font-size:1.12rem; font-weight:700; color:var(--g1); line-height:1.3; margin:0; }
  .rec-excerpt { font-size:.86rem; color:var(--text-sec); line-height:1.55; display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; }
  .rec-meta { display:flex; flex-wrap:wrap; gap:12px; font-size:.78rem; color:var(--text-sec); }
  .rec-meta strong { color:var(--text); font-weight:600; }
  .rec-card-actions { display:flex; gap:8px; margin-top:auto; padding-top:4px; }
  .rec-card-actions a { flex:1; text-align:center; }

  .empty-state { text-align:center; padding:48px 24px; background:#fff; border:1.5px dashed var(--border); border-radius:18px; }
  .empty-state .empty-icon { width:56px; height:56px; margin:0 auto 14px; border-radius:14px; background:var(--g-pale); display:grid; place-items:center; }
  .empty-state .empty-icon svg { width:26px; height:26px; stroke:var(--g2); }
  .empty-title { font-family:'Playfair Display',serif; font-size:1.2rem; color:var(--g1); margin-bottom:6px; }
  .empty-sub { font-size:.88rem; color:var(--text-sec); }

  .pagination { display:flex; justify-content:center; flex-wrap:wrap; gap:8px; margin-top:22px; }
  .page-btn {
    min-width:38px; height:38px; display:inline-flex; align-items:center; justify-content:center;
    border-radius:10px; border:1.5px solid var(--border); background:#fff; color:var(--text); text-decoration:none; font-weight:600; font-size:.85rem;
  }
  .page-btn:hover { border-color:var(--g3); color:var(--g1); }
  .page-btn.active { background:var(--g1); color:#fff; border-color:var(--g1); }
</style>

{% set filter_base = {
  search: search,
  statut: statut,
  categorie: categorie_filter,
  date_from: date_from,
  date_to: date_to,
  sort: sort,
  direction: direction,
  page: 1
} %}
{% set list_query = filter_base|merge({mine: mine ? '1' : '0'}) %}

<div class="rec-hero">
  <div class="rec-hero-row">
    <div class="rec-hero-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
        <path d="M12 3l1.8 5.4H19l-4.4 3.2 1.7 5.2L12 15.8l-4.3 3.1 1.7-5.2L5 8.4h5.2L12 3z"/>
      </svg>
    </div>
    <div>
      <h2 class="rec-hero-title">Suivi &amp; échanges</h2>
      <p class="rec-hero-sub">Par défaut, retrouvez <strong>vos</strong> réclamations ; basculez vers « Toutes » pour voir l’ensemble. Votre nom de session apparaît sur vos messages.</p>
    </div>
    <div class="rec-stats">
      <div class="rec-stat">
        <div class="rec-stat-val">{{ total }}</div>
        <div class="rec-stat-lbl">Total</div>
      </div>
      <div class="rec-stat">
        <div class="rec-stat-val">{{ reclamations|length }}</div>
        <div class="rec-stat-lbl">Page</div>
      </div>
    </div>
  </div>
</div>

<div class="scope-chips">
  <a href="{{ path('front_reclamation_index', filter_base|merge({mine: '1'})) }}" class="scope-chip {{ mine ? 'active' : '' }}">Mes réclamations</a>
  <a href="{{ path('front_reclamation_index', filter_base|merge({mine: '0'})) }}" class="scope-chip {{ not mine ? 'active' : '' }}">Toutes les réclamations</a>
</div>

<form method="get" id="frontReclamationForm" action="{{ path('front_reclamation_index') }}" autocomplete="off">
  <input type="hidden" name="page" value="{{ page }}">
  <input type="hidden" name="mine" value="{{ mine ? '1' : '0' }}">

  <div class="toolbar-card">
    <div class="toolbar-grid">
      <div>
        <span class="tb-label">Recherche</span>
        <div class="tb-wrap">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="8.5" cy="8.5" r="5.5"/><path d="M15 15l-3-3" stroke-linecap="round"/></svg>
          <input class="tb-search" type="search" name="search" value="{{ search }}" placeholder="Sujet ou description…" data-front-debounce>
        </div>
      </div>
      <div>
        <span class="tb-label">Statut</span>
        <select class="tb-select front-filter-select" name="statut">
          <option value="">Tous</option>
          <option value="En attente" {{ statut == 'En attente' ? 'selected' }}>En attente</option>
          <option value="En cours de traitement" {{ statut == 'En cours de traitement' ? 'selected' }}>En cours de traitement</option>
          <option value="Résolu" {{ statut == 'Résolu' ? 'selected' }}>Résolu</option>
          <option value="Rejeté" {{ statut == 'Rejeté' ? 'selected' }}>Rejeté</option>
        </select>
      </div>
      <div>
        <span class="tb-label">Catégorie</span>
        <select class="tb-select front-filter-select" name="categorie">
          <option value="">Toutes</option>
          {% for cat in categories %}
            <option value="{{ cat.id_categorie }}" {{ categorie_filter == cat.id_categorie ? 'selected' }}>{{ cat.nom_categorie }}</option>
          {% endfor %}
        </select>
      </div>
      <div>
        <span class="tb-label">Du</span>
        <input class="tb-date" type="date" name="date_from" value="{{ date_from }}" onchange="this.form.requestSubmit()">
      </div>
      <div>
        <span class="tb-label">Au</span>
        <input class="tb-date" type="date" name="date_to" value="{{ date_to }}" onchange="this.form.requestSubmit()">
      </div>
      <div style="align-self:end">
        <a class="tb-reset" href="{{ path('front_reclamation_index', {mine: mine ? '1' : '0'}) }}">
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 8a6 6 0 1012 0A6 6 0 002 8zM10 6L6 10M6 6l4 4" stroke-linecap="round"/></svg>
          Réinitialiser
        </a>
      </div>
    </div>
  </div>
</form>

{% if reclamations is empty %}
  <div class="empty-state">
    <div class="empty-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 12h6m-6 4h6M5 7h14a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9a2 2 0 012-2z"/></svg>
    </div>
    <div class="empty-title">Aucune réclamation</div>
    <div class="empty-sub">Affinez les filtres ou créez une nouvelle réclamation.</div>
    <div style="margin-top:18px;">
      <a href="{{ path('front_reclamation_new') }}" class="btn-primary" style="text-decoration:none;">Créer une réclamation</a>
    </div>
  </div>
{% else %}
  <div class="rec-grid">
    {% for reclamation in reclamations %}
      <article class="rec-card" style="animation-delay:{{ loop.index0 * 0.04 }}s">
        <div class="rec-card-top">
          <span class="rec-badge cat">{{ reclamation.categorie ? reclamation.categorie.nom_categorie : 'Catégorie' }}</span>
          <span class="rec-status {% if reclamation.statut_reclamation == 'En attente' %}st-wait{% elseif reclamation.statut_reclamation == 'En cours de traitement' %}st-prog{% elseif reclamation.statut_reclamation == 'Résolu' %}st-done{% else %}st-rej{% endif %}">{{ reclamation.statut_reclamation }}</span>
        </div>
        <h3 class="rec-card-title">{{ reclamation.sujet_reclamation }}</h3>
        <p class="rec-excerpt">{{ reclamation.description_reclamation }}</p>
        <div class="rec-meta">
          <span><strong>Auteur</strong> · {{ authorMap[reclamation.id_utilisateur] ?? 'Membre' }}</span>
          <span>{{ reclamation.dateCreation_reclamation|date('d/m/Y H:i') }}</span>
          {% if currentUserId and reclamation.id_utilisateur == currentUserId %}
            <span style="color:var(--g2);font-weight:700;">Votre réclamation</span>
          {% endif %}
        </div>
        <div class="rec-card-actions">
          <a href="{{ path('front_reclamation_show', {id: reclamation.id_reclamation}) }}" class="btn-primary" style="text-decoration:none;font-size:.84rem;padding:10px 14px;">Ouvrir</a>
          {% if currentUserId and reclamation.id_utilisateur == currentUserId %}
            <a href="{{ path('front_reclamation_edit', {id: reclamation.id_reclamation}) }}" class="btn-secondary" style="text-decoration:none;font-size:.84rem;padding:10px 14px;">Modifier</a>
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>

  {% if pages > 1 %}
    <div class="pagination">
      {% for p in 1..pages %}
        {% set pq = list_query|merge({page: p}) %}
        <a class="page-btn {{ p == page ? 'active' : '' }}" href="{{ path('front_reclamation_index', pq) }}">{{ p }}</a>
      {% endfor %}
    </div>
  {% endif %}
{% endif %}
{% endblock %}

{% block javascripts %}
{{ parent() }}
{% include '_partials/front_dynamic_list_filters.html.twig' with { form_id: 'frontReclamationForm', skip_test_id_zero: false } %}
{% endblock %}
