{% extends 'base_backoffice.html.twig' %}

{% block title %}Réclamation {{ reclamation.sujet_reclamation }}{% endblock %}
{% block page_label %}Réclamation{% endblock %}

{% block content %}
<style>
  .page-container { max-width:1000px; margin:0 auto; padding:24px; }
  .hero-section { background:linear-gradient(135deg, #1B4332 0%, #1A3A5C 50%, #0F2447 100%); border-radius:20px; padding:32px; margin-bottom:24px; position:relative; overflow:hidden; box-shadow:0 8px 32px rgba(27,67,50,.22); }
  .hero-section::before { content:''; position:absolute; width:300px; height:300px; border-radius:50%; background:rgba(255,255,255,.05); top:-100px; right:-80px; pointer-events:none; }
  .hero-content { display:flex; justify-content:space-between; align-items:flex-start; gap:20px; position:relative; z-index:1; flex-wrap:wrap; }
  .hero-text { flex:1; }
  .hero-title { font-family:'Playfair Display',serif; font-size:2rem; font-weight:700; color:#fff; margin-bottom:8px; }
  .hero-meta { font-size:.9rem; color:rgba(255,255,255,.8); display:flex; align-items:center; gap:16px; flex-wrap:wrap; }
  .hero-meta-item { display:flex; align-items:center; gap:6px; }
  .hero-meta-item svg { width:16px; height:16px; }
  .hero-actions { display:flex; gap:12px; flex-wrap:wrap; }
  .btn-reply { display:inline-flex; align-items:center; gap:8px; padding:14px 20px; border-radius:14px; background:#52B788; color:#fff; text-decoration:none; font-weight:700; font-size:.9rem; box-shadow:0 4px 16px rgba(82,183,136,.3); transition:all .2s; }
  .btn-reply:hover { background:#40916C; box-shadow:0 6px 20px rgba(82,183,136,.4); transform:translateY(-2px); }
  .btn-reply svg { width:18px; height:18px; }

  .details-card { background:#fff; border:1.5px solid #E2E8F0; border-radius:20px; padding:28px; margin-bottom:24px; box-shadow:0 4px 20px rgba(27,67,50,.08); }
  .details-header { display:flex; align-items:center; gap:12px; margin-bottom:20px; }
  .details-icon { width:48px; height:48px; border-radius:12px; background:linear-gradient(135deg, #52B788, #1A3A5C); display:grid; place-items:center; }
  .details-icon svg { width:24px; height:24px; color:#fff; }
  .details-title { font-size:1.2rem; font-weight:700; color:#1B4332; margin:0; }
  .details-description { font-size:1rem; line-height:1.7; color:#374151; margin:16px 0; }
  .details-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:20px; margin-top:24px; }
  .detail-item { background:#F8FAFC; border:1px solid #E2E8F0; border-radius:16px; padding:20px; }
  .detail-label { font-weight:700; color:#1B4332; font-size:.9rem; margin-bottom:8px; }
  .detail-value { font-size:1rem; color:#374151; margin:0; }

  .status-update { background:#F0F9FF; border:1px solid #BAE6FD; border-radius:16px; padding:20px; margin-bottom:24px; }
  .status-form { display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
  .status-label { font-weight:600; color:#0369A1; }
  .status-select { padding:8px 12px; border:1px solid #BAE6FD; border-radius:8px; background:#fff; color:#0369A1; font-size:.9rem; }
  .status-btn { padding:8px 16px; border-radius:8px; background:#0369A1; color:#fff; border:none; font-weight:600; cursor:pointer; transition:background .2s; }
  .status-btn:hover { background:#0284C7; }

  .discussion-section { margin-bottom:24px; }
  .discussion-header { display:flex; align-items:center; gap:12px; margin-bottom:20px; }
  .discussion-icon { width:48px; height:48px; border-radius:12px; background:linear-gradient(135deg, #1A3A5C, #52B788); display:grid; place-items:center; }
  .discussion-icon svg { width:24px; height:24px; color:#fff; }
  .discussion-title { font-size:1.2rem; font-weight:700; color:#1B4332; margin:0; }

  .response-form { background:#fff; border:1px solid #E2E8F0; border-radius:18px; padding:24px; margin-bottom:20px; box-shadow:0 4px 16px rgba(27,67,50,.06); }
  .response-form-header { display:flex; align-items:center; gap:10px; margin-bottom:16px; }
  .response-form-title { font-size:1.1rem; font-weight:700; color:#1B4332; margin:0; }
  .response-form textarea { width:100%; min-height:120px; padding:14px; border:1px solid #D1D5DB; border-radius:10px; font-size:.95rem; color:#374151; resize:vertical; }
  .response-form-actions { display:flex; gap:10px; justify-content:flex-end; margin-top:16px; }
  .btn-submit { padding:10px 18px; border-radius:10px; background:#52B788; color:#fff; border:none; font-weight:600; cursor:pointer; transition:background .2s; }
  .btn-submit:hover { background:#40916C; }
  .btn-cancel { padding:10px 18px; border-radius:10px; background:#F3F4F6; color:#374151; border:1px solid #D1D5DB; cursor:pointer; transition:background .2s; }
  .btn-cancel:hover { background:#E5E7EB; }

  .responses-list { display:grid; gap:16px; }
  .response-item { background:#fff; border:1px solid #E2E8F0; border-radius:18px; padding:20px; box-shadow:0 2px 12px rgba(27,67,50,.04); }
  .response-header { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:12px; }
  .response-author { font-weight:700; color:#1B4332; font-size:1rem; }
  .response-author.admin-author { color:#B91C1C; }
  .admin-badge {
    display:inline-flex; align-items:center; margin-left:8px; padding:2px 8px;
    border-radius:999px; background:#FEE2E2; color:#B91C1C; font-size:.68rem; font-weight:700; text-transform:uppercase;
  }
  .response-date { color:#6B7280; font-size:.85rem; }
  .response-content { line-height:1.7; color:#374151; margin:0; }

  .response-inline-edit { margin-top:12px; display:grid; gap:10px; }
  .response-inline-edit textarea { width:100%; min-height:100px; padding:12px; border:1px solid #D1D5DB; border-radius:10px; font-size:.92rem; resize:vertical; }
  .response-inline-actions { display:flex; flex-wrap:wrap; gap:8px; align-items:center; }
  .btn-del-inline {
    padding:8px 14px; border-radius:10px; border:1px solid #FECACA; background:#FEF2F2; color:#B91C1C; font-size:.82rem; font-weight:600; cursor:pointer; font-family:'Outfit',sans-serif;
  }
  .btn-save-inline {
    padding:8px 16px; border-radius:10px; border:none; background:#52B788; color:#fff; font-size:.82rem; font-weight:600; cursor:pointer; font-family:'Outfit',sans-serif;
  }

  .empty-responses { background:#F8FAFC; border:1px dashed #CBD5E1; border-radius:18px; padding:32px; text-align:center; color:#6B7280; }
  .empty-icon { width:48px; height:48px; border-radius:12px; background:#E2E8F0; display:grid; place-items:center; margin:0 auto 12px; }
  .btn-translate {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border-radius: 8px;
    background: #52B788;
    color: #fff;
    border: none;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }
  .btn-translate:hover {
    background: #40916C;
    transform: translateY(-1px);
  }
  .btn-translate.loading {
    background: #6B7280;
    cursor: not-allowed;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
</style>

<div class="page-container">
  {% for message in app.flashes('success') %}
    <div style="background:#DCFCE7; color:#166534; padding:12px 16px; border-radius:12px; margin-bottom:16px; border:1px solid #BBF7D0;">{{ message }}</div>
  {% endfor %}
  {% for message in app.flashes('error') %}
    <div style="background:#FEE2E2; color:#B91C1C; padding:12px 16px; border-radius:12px; margin-bottom:16px; border:1px solid #FECACA;">{{ message }}</div>
  {% endfor %}
  <div class="hero-section">
    <div class="hero-content">
      <div class="hero-text">
        <h1 class="hero-title">{{ reclamation.sujet_reclamation }}</h1>
        <div class="hero-meta">
          <div class="hero-meta-item">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
            {{ reclamation.categorie ? reclamation.categorie.nom_categorie : 'N/A' }}
          </div>
          <div class="hero-meta-item">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="10" cy="10" r="8"/>
              <path d="M10 6v4l2 2"/>
            </svg>
            {{ reclamation.dateCreation_reclamation ? reclamation.dateCreation_reclamation|date('d/m/Y H:i') : '' }}
          </div>
          <div class="hero-meta-item">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Statut: <span style="font-weight:600;">{{ reclamation.statut_reclamation }}</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="status-update">
    <form method="post" action="{{ path('reclamation_update_status', {id: reclamation.id_reclamation}) }}" class="status-form">
      <label for="statut_reclamation" class="status-label">Changer le statut :</label>
      <select name="statut_reclamation" id="statut_reclamation" class="status-select" required>
        <option value="EN_ATTENTE" {% if reclamation.statut_reclamation == 'En attente' %}selected{% endif %}>En attente</option>
        <option value="EN_COURS" {% if reclamation.statut_reclamation == 'En cours de traitement' %}selected{% endif %}>En cours</option>
        <option value="TRAITEE" {% if reclamation.statut_reclamation == 'Résolu' %}selected{% endif %}>Traitée</option>
      </select>
      <button type="submit" class="status-btn">Mettre à jour</button>
    </form>
  </div>

  <div class="details-card">
    <div class="details-header">
      <div class="details-icon">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
      </div>
      <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
        <h2 class="details-title">Détails de la réclamation</h2>
        <button type="button" id="translate-reclamation-btn" class="btn-translate" title="Traduire la description">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16">
            <circle cx="10" cy="10" r="7"/>
            <path d="M10 3c-2 2.5-3 4.8-3 7s1 4.5 3 7M10 3c2 2.5 3 4.8 3 7s-1 4.5-3 7M3 10h14" stroke-linecap="round"/>
          </svg>
          Traduire
        </button>
      </div>
    </div>
    <p class="details-description" id="reclamation-description">{{ reclamation.description_reclamation }}</p>
    <div class="details-grid">
      <div class="detail-item">
        <div class="detail-label">Date de création</div>
        <div class="detail-value">{{ reclamation.dateCreation_reclamation ? reclamation.dateCreation_reclamation|date('d/m/Y H:i') : '' }}</div>
      </div>
      <div class="detail-item">
        <div class="detail-label">Note moyenne</div>
        <div class="detail-value">{{ reclamation.rate_Reclamation|number_format(1, ',', ' ') }}/5</div>
      </div>
      <div class="detail-item">
        <div class="detail-label">Nombre de réponses</div>
        <div class="detail-value">{{ reclamation.reponses|length }}</div>
      </div>
    </div>
  </div>

  <div class="discussion-section">
    <div class="discussion-header">
      <div class="discussion-icon">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M8 12h.01M12 12h.01M16 16v-4a4 4 0 00-4-4H6a4 4 0 00-4 4v4a2 2 0 002 2h12a2 2 0 002-2z"/>
        </svg>
      </div>
      <h2 class="discussion-title">Discussion</h2>
    </div>

    <div id="response-form" class="response-form">
      <div class="response-form-header">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" style="width:20px; height:20px; color:#52B788;">
          <path d="M3 10h10M3 14h7M3 6h14"/>
          <path d="M17 8l-4-4m0 0l-4 4m4-4v12"/>
        </svg>
        <h3 class="response-form-title">Ajouter une réponse</h3>
      </div>
      {% if app.user %}
      <form method="post" action="{{ path('reponse_new') }}">
        <input type="hidden" name="reponse[reclamation]" value="{{ reclamation.id_reclamation }}">
        <input type="hidden" name="reponse[id_utilisateur]" value="{{ app.user.idUtilisateur }}">
        <input type="hidden" name="reponse[rate_reponse]" value="0">
        <input type="hidden" name="reponse[_token]" value="{{ csrf_token('reponse') }}">
        <textarea name="reponse[contenu_reponse]" placeholder="Écrivez votre réponse..." required minlength="5" maxlength="5000"></textarea>
        <div class="response-form-actions">
  <button type="submit" class="btn-submit">Envoyer</button>
  <button type="button" class="btn-cancel" id="cancel-reply">Annuler</button>
  <button type="button" class="btn-cancel" style="background:#EFF6FF; border-color:#BFDBFE; color:#1565C0;"
          onclick="suggestReponse({{ reclamation.id_reclamation }})">
    ✨ Suggérer une réponse
  </button>

</div>
      </form>
      {% endif %}
    </div>

    {% if sortedReponses|length > 0 %}
      <div class="responses-list">
        {% for reponse in sortedReponses %}
          <article class="response-item fade-in">
            <div class="response-header">
              <div class="response-author {% if reponse.id_utilisateur in adminUserIds %}admin-author{% endif %}">
                {{ reponse.nom_utilisateur ?: 'Membre' }}
                {% if reponse.id_utilisateur in adminUserIds %}
                  <span class="admin-badge">Admin</span>
                {% endif %}
              </div>
              <div class="response-date">{{ reponse.date_reponse ? reponse.date_reponse|date('d/m/Y H:i') : '' }}</div>
            </div>
            {% if app.user and reponse.id_utilisateur == app.user.idUtilisateur %}
              <div style="margin-top:10px;padding:14px;border-radius:14px;background:#F8FAFC;border:1px solid #E2E8F0;">
                {# Texte affiché par défaut #}
                <p class="response-content" id="rep-text-{{ reponse.id_reponse }}">{{ reponse.contenu_reponse }}</p>

                {# Formulaire caché par défaut #}
                <form method="post" action="{{ path('reponse_edit', {id: reponse.id_reponse}) }}" class="response-inline-edit" id="rep-form-{{ reponse.id_reponse }}" style="display:none; margin-top:0;">
                  <input type="hidden" name="_token" value="{{ csrf_token('reponse_edit_' ~ reponse.id_reponse) }}">
                  <input type="hidden" name="reclamation_id" value="{{ reclamation.id_reclamation }}">
                  <input type="hidden" name="rate_reponse" value="{{ reponse.rate_reponse }}">
                  <input type="hidden" name="rate_sum" value="{{ reponse.rate_sum }}">
                  <input type="hidden" name="rate_count" value="{{ reponse.rate_count }}">
                  <textarea name="contenu_reponse" required minlength="5">{{ reponse.contenu_reponse }}</textarea>
                  <div class="response-inline-actions">
                    <button type="submit" class="btn-save-inline">Enregistrer</button>
                  </div>
                </form>

                <div style="display:flex; gap:8px; margin-top:10px;">
                  <button type="button" class="btn-save-inline" id="rep-btn-{{ reponse.id_reponse }}" onclick="toggleEdit({{ reponse.id_reponse }})">Modifier</button>
                  <form method="post" action="{{ path('reponse_delete', {id: reponse.id_reponse}) }}" style="display:inline;" onsubmit="return confirm('Supprimer cette réponse ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_reponse_' ~ reponse.id_reponse) }}">
                    <button type="submit" class="btn-del-inline">Supprimer</button>
                  </form>
                </div>
              </div>
                </form>
                <form method="post" action="{{ path('reponse_delete', {id: reponse.id_reponse}) }}" style="margin-top:8px;" onsubmit="return confirm('Supprimer cette réponse ?');">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete_reponse_' ~ reponse.id_reponse) }}">
                  
                </form>
              </div>
            {% else %}
              <p class="response-content">{{ reponse.contenu_reponse }}</p>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="empty-responses">
        <div class="empty-icon">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M8 12h.01M12 12h.01M16 16v-4a4 4 0 00-4-4H6a4 4 0 00-4 4v4a2 2 0 002 2h12a2 2 0 002-2z"/>
          </svg>
        </div>
        <p class="empty-text">Aucune réponse n'a encore été ajoutée à cette réclamation.</p>
      </div>
    {% endif %}
  </div>
</div>

<script>
async function suggestReponse(reclamationId) {
  const btn = event.target;
  btn.textContent = '⏳ Génération...';
  btn.disabled = true;

  try {
    const res = await fetch(`/reclamation/${reclamationId}/suggest-reponse`, {
      method: 'POST',
      headers: { 'X-Requested-With': 'XMLHttpRequest' },
    });
    const json = await res.json();
    if (json.suggestion) {
      document.querySelector('textarea[name="reponse[contenu_reponse]"]').value = json.suggestion;
    }
  } catch (e) {
    alert('Erreur lors de la génération.');
  } finally {
    btn.textContent = '✨ Suggérer une réponse';
    btn.disabled = false;
  }
}

async function getPriority(reclamationId) {
  const btn = event.target;
  const originalText = btn.textContent;
  btn.textContent = '⏳ Analyse...';
  btn.disabled = true;

  try {
    const res = await fetch(`/reclamation/${reclamationId}/priority`, {
      method: 'GET',
      headers: { 'X-Requested-With': 'XMLHttpRequest' },
    });
    const json = await res.json();
    if (json.success && json.priority) {
      alert(`Priorité analysée : ${json.priority}`);
    } else {
      alert('Erreur lors de l\'analyse de priorité.');
    }
  } catch (e) {
    alert('Erreur lors de l\'analyse de priorité.');
  } finally {
    btn.textContent = originalText;
    btn.disabled = false;
  }
}
function toggleEdit(id) {
  const form = document.getElementById('rep-form-' + id);
  const text = document.getElementById('rep-text-' + id);
  const btn  = document.getElementById('rep-btn-'  + id);
  const isOpen = form.style.display === 'block';
  form.style.display = isOpen ? 'none' : 'block';
  text.style.display = isOpen ? 'block' : 'none';
  btn.textContent    = isOpen ? 'Modifier' : 'Annuler';
}

document.addEventListener('submit', function(e) {
  const form = e.target;
  if (!form.id.startsWith('rep-form-')) return;

  e.preventDefault();
  const id = form.id.replace('rep-form-', '');
  const data = new FormData(form);

  fetch(form.action, {
    method: 'POST',
    headers: { 'X-Requested-With': 'XMLHttpRequest' },
    body: new URLSearchParams(data),
  })
  .then(res => res.json())
  .then(json => {
    if (json.success) {
      const newContenu = data.get('contenu_reponse');
      document.getElementById('rep-text-' + id).textContent = newContenu;
      toggleEdit(id);
    }
  })
  .catch(() => alert('Erreur lors de la sauvegarde.'));
});

// ── Traduction de la réclamation ──────────────────────────────────────────
document.getElementById('translate-reclamation-btn').addEventListener('click', async function() {
  const btn = this;
  const descriptionEl = document.getElementById('reclamation-description');
  const originalText = descriptionEl.dataset.original || descriptionEl.textContent;

  // Sauvegarder le texte original
  if (!descriptionEl.dataset.original) {
    descriptionEl.dataset.original = originalText;
  }

  btn.classList.add('loading');
  btn.innerHTML = '<span class="spinner" style="width:12px;height:12px;border:2px solid #fff;border-top:2px solid transparent;border-radius:50%;animation:spin 1s linear infinite;display:inline-block;margin-right:6px;"></span>Traduction...';

  try {
    const response = await fetch('/api/translate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        text: originalText,
        target: 'en',
        source: 'fr'
      })
    });

    if (!response.ok) {
      throw new Error('Erreur HTTP: ' + response.status);
    }

    const data = await response.json();
    const translatedText = data.translated || data;

    descriptionEl.textContent = translatedText;
    btn.innerHTML = '🔄 Original';
    btn.onclick = function() {
      descriptionEl.textContent = originalText;
      btn.innerHTML = '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16"><circle cx="10" cy="10" r="7"/><path d="M10 3c-2 2.5-3 4.8-3 7s1 4.5 3 7M10 3c2 2.5 3 4.8 3 7s-1 4.5-3 7M3 10h14" stroke-linecap="round"/></svg>Traduire';
      btn.onclick = arguments.callee.caller;
    };

  } catch (error) {
    console.error('Erreur de traduction:', error);
    alert('Erreur lors de la traduction. Vérifiez votre connexion et réessayez.');
    btn.innerHTML = '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16"><circle cx="10" cy="10" r="7"/><path d="M10 3c-2 2.5-3 4.8-3 7s1 4.5 3 7M10 3c2 2.5 3 4.8 3 7s-1 4.5-3 7M3 10h14" stroke-linecap="round"/></svg>Traduire';
  } finally {
    btn.classList.remove('loading');
  }
});

</script>
{% endblock %}
