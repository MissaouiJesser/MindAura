<script>
(function () {
  'use strict';

  const STORAGE_KEY = 'mindaura_sidebar_collapsed';
  const layout      = document.querySelector('.layout');
  const toggle      = document.getElementById('sidebarToggle');

  const ICON_OPEN   = '<path d="M3 5h14M3 10h14M3 15h14" stroke-linecap="round"/>';
  const ICON_CLOSED = '<path d="M13 5l-6 5 6 5" stroke-linecap="round" stroke-linejoin="round"/>';

  function applyState(collapsed, animate) {
    if (!animate) layout.style.transition = 'none';
    layout.classList.toggle('sidebar-collapsed', collapsed);
    if (!animate) requestAnimationFrame(() => { layout.style.transition = ''; });

    const icon = toggle.querySelector('svg');
    icon.innerHTML = collapsed ? ICON_CLOSED : ICON_OPEN;
    toggle.setAttribute('title', collapsed ? 'Afficher le menu' : 'Masquer le menu');
  }

  const saved = localStorage.getItem(STORAGE_KEY) === 'true';
  applyState(saved, false);

  toggle.addEventListener('click', function () {
    const isNowCollapsed = !layout.classList.contains('sidebar-collapsed');
    applyState(isNowCollapsed, true);
    localStorage.setItem(STORAGE_KEY, isNowCollapsed);
  });

  const navGroupToggles = document.querySelectorAll('.nav-group-toggle');
  const MENU_STATE_KEY = 'mindaura_menu_states';

  function loadMenuStates() {
    const saved = localStorage.getItem(MENU_STATE_KEY);
    return saved ? JSON.parse(saved) : {};
  }

  function saveMenuStates(states) {
    localStorage.setItem(MENU_STATE_KEY, JSON.stringify(states));
  }

  const menuStates = loadMenuStates();

  navGroupToggles.forEach(toggle => {
    const menuId = toggle.dataset.toggle;
    const navGroup = toggle.closest('.nav-group');
    const isActive = navGroup && navGroup.classList.contains('active');

    if (isActive || menuStates[menuId]) {
      navGroup.classList.add('active');
      menuStates[menuId] = true;
    } else {
      menuStates[menuId] = false;
    }

    toggle.addEventListener('click', function (e) {
      e.preventDefault();
      const isActive = navGroup.classList.toggle('active');
      menuStates[menuId] = isActive;
      saveMenuStates(menuStates);
    });
  });
})();
</script>

{# ══════════════════════════════════════════════════════════════════
   NAVIGATION — Rechargement standard avec barre de progression
   Fonctionnalites :
     - Barre de progression affichee au clic sur un lien
     - Animation d'entree du contenu a chaque chargement
     - Lien actif gere cote serveur par Twig (toujours fiable)
     - Toggle sidebar persiste en localStorage
   ══════════════════════════════════════════════════════════════════ #}
<script>
(function () {
  'use strict';

  const loader        = document.getElementById('pageLoader');
  const mainContent   = document.getElementById('mainContent');
  const breadcrumb    = document.getElementById('breadcrumb-label');

  function showLoader() { loader.classList.add('active'); }
  function hideLoader() { loader.classList.remove('active'); }

  function setActiveLink(href) {
    document.querySelectorAll('.nav-item[data-spa], .nav-submenu-item[data-spa]').forEach(link => {
      const linkHref = link.getAttribute('href');
      if (linkHref) {
        const isActive = linkHref === href || linkHref.split('?')[0] === href.split('?')[0];
        link.classList.toggle('active', isActive);
      }
    });
  }

  function extractContent(html) {
    const parser = new DOMParser();
    const doc    = parser.parseFromString(html, 'text/html');
    const target = doc.getElementById('mainContent');
    return target ? target.innerHTML : null;
  }

  function extractTitle(html) {
    const match = html.match(/<title[^>]*>([\s\S]*?)<\/title>/i);
    return match ? match[1].trim() : document.title;
  }

  function extractBreadcrumb(html) {
    const parser = new DOMParser();
    const doc    = parser.parseFromString(html, 'text/html');
    const el     = doc.getElementById('breadcrumb-label');
    return el ? el.textContent.trim() : '';
  }

  function rehydrateScripts(container) {
    container.querySelectorAll('script').forEach(oldScript => {
      const s = document.createElement('script');
      if (oldScript.src) {
        s.src  = oldScript.src;
        s.async = false;
      } else {
        s.textContent = oldScript.textContent;
      }
      oldScript.parentNode.replaceChild(s, oldScript);
    });
  }

  function animateOut(el) {
    return new Promise(resolve => {
      el.classList.add('is-leaving');
      const ANIM_DURATION = 280 + 50;
      const timer = setTimeout(() => {
        el.classList.remove('is-leaving');
        resolve();
      }, ANIM_DURATION);

      el.addEventListener('animationend', () => {
        clearTimeout(timer);
        el.classList.remove('is-leaving');
        resolve();
      }, { once: true });
    });
  }

  function animateIn(el) {
    el.classList.add('is-entering');
    const ANIM_DURATION = 380 + 50;
    const timer = setTimeout(() => {
      el.classList.remove('is-entering');
    }, ANIM_DURATION);

    el.addEventListener('animationend', () => {
      clearTimeout(timer);
      el.classList.remove('is-entering');
    }, { once: true });
  }

  async function navigate(url, pushState = true) {
    showLoader();
    mainContent.setAttribute('aria-busy', 'true');

    try {
      const [outDone, response] = await Promise.all([
        animateOut(mainContent),
        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
      ]);

      if (!response.ok) throw new Error(`HTTP ${response.status}`);

      const html = await response.text();
      const newContent = extractContent(html);
      if (newContent === null) {
        window.location.href = url;
        return;
      }

      mainContent.innerHTML = newContent;
      mainContent.scrollTop = 0;

      const newTitle = extractTitle(html);
      const newLabel = extractBreadcrumb(html);
      document.title = newTitle;
      if (breadcrumb && newLabel) breadcrumb.textContent = newLabel;

      setActiveLink(url);

      if (pushState) {
        history.pushState({ url }, newTitle, url);
      }

      rehydrateScripts(mainContent);
      animateIn(mainContent);

    } catch (err) {
      console.error('[SPA] Erreur de navigation :', err);
      window.location.href = url;
    } finally {
      hideLoader();
      mainContent.removeAttribute('aria-busy');
    }
  }

  // Afficher la barre de progression au clic sur n'importe quel lien interne
  document.addEventListener('click', function (e) {
    var link = e.target.closest('a');
    if (!link) return;
    if (e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
    if (link.target === '_blank') return;
    var href = link.getAttribute('href') || '';
    if (!href || href.charAt(0) === '#') return;
    if (href.indexOf('javascript') === 0) return;
    if (href.indexOf('mailto') === 0 || href.indexOf('tel') === 0) return;
    // Exports CSV / PDF = telechargements, pas de barre
    if (href.indexOf('/export/') !== -1) return;
    if (loader) loader.classList.add('active');
  });

  // Masquer la barre quand la page revient du cache (bouton Precedent/Suivant)
  window.addEventListener('pageshow', function () {
    if (loader) loader.classList.remove('active');
  });

  // Animation d'entree du contenu principal a chaque chargement
  if (mainContent) {
    mainContent.classList.add('is-entering');
  }

})();
</script>

<script>
(function () {
  'use strict';

  /* ── Config ─────────────────────────────────────────── */
  const API_LIST      = '{{ path('reservation_local_notifications_list') }}';
  const API_MARK_READ = '{{ path('reservation_local_notifications_mark_read') }}';
  const POLL_INTERVAL = 30_000; // 30 s

  /* ── Éléments DOM ───────────────────────────────────── */
  const bellBtn    = document.getElementById('notifBellBtn');
  const badge      = document.getElementById('notifBadge');
  const dropdown   = document.getElementById('notifDropdown');
  const list       = document.getElementById('notifList');
  const unreadSpan = document.getElementById('notifUnreadCount');
  const markBtn    = document.getElementById('notifMarkRead');
  const clearBtn   = document.getElementById('notifClearAll');

  /* La cloche n'est présente que sur la page index des réservations */
  if (!bellBtn) return;

  /* ── Icônes SVG par type ────────────────────────────── */
  const ICONS = {
    plus:  '<path d="M10 4v12M4 10h12" stroke-linecap="round" stroke-width="2.2"/>',
    edit:  '<path d="M14.7 4.3a1 1 0 011.4 1.4L6.4 15.4 3 16.7l1.3-3.4 10-10z" stroke-linecap="round"/>',
    trash: '<path d="M5 6h10M8 6V4h4v2M7 6v9a1 1 0 001 1h4a1 1 0 001-1V6" stroke-linecap="round"/>',
    bell:  '<path d="M10 2a6 6 0 00-6 6c0 3.5-1.5 5-1.5 5h15s-1.5-1.5-1.5-5a6 6 0 00-6-6z" stroke-linecap="round"/><path d="M11.73 17a2 2 0 01-3.46 0" stroke-linecap="round"/>',
    info:  '<circle cx="10" cy="10" r="7"/><path d="M10 10v4M10 7h.01" stroke-linecap="round"/>',
  };

  /* ── Couleurs par type d'icône ──────────────────────── */
  const TYPE_COLORS = {
    trash: { color: '#7B5EA7', bg: 'rgba(123,94,167,.12)', label: 'Réservation supprimée' },
    plus:  { color: '#F97316', bg: 'rgba(249,115,22,.12)',  label: 'Réservation ajoutée'   },
    edit:  { color: '#38BDF8', bg: 'rgba(56,189,248,.12)',  label: 'Réservation modifiée'  },
    bell:  { color: '#52B788', bg: 'rgba(82,183,136,.12)',  label: 'Alerte système'         },
    info:  { color: '#94A3B8', bg: 'rgba(148,163,184,.12)', label: 'Information'            },
  };

  /* ── Rendre un item (carte) ─────────────────────────── */
  function renderItem(n) {
    const href       = n.lien ? `href="${n.lien}"` : '';
    const tag        = n.lien ? 'a' : 'div';
    const unreadCls  = !n.estLue ? 'unread' : '';
    const icon       = ICONS[n.icone] || ICONS.info;
    const tc         = TYPE_COLORS[n.icone] || TYPE_COLORS.info;
    const dotCls     = !n.estLue ? 'unread-dot' : '';
    const dotLabel   = !n.estLue ? '● Non lue' : '● Lu';

    return `
      <${tag} class="notif-item ${unreadCls}" ${href} data-id="${n.id}" style="position:relative;">
        <div class="notif-item-stripe" style="background:${tc.color};"></div>
        <div class="notif-item-inner">
          <div class="notif-icon" style="background:${tc.bg};">
            <svg viewBox="0 0 20 20" fill="none" stroke="${tc.color}" stroke-width="1.9">${icon}</svg>
          </div>
          <div class="notif-content">
            <div class="notif-top-row">
              <span class="notif-label" style="color:${tc.color};">${n.label || tc.label}</span>
              <span class="notif-time-inline">${n.temps}</span>
            </div>
            <div class="notif-message" title="${n.message}">${n.message}</div>
          </div>
        </div>
        <div class="notif-item-footer">
          <span class="notif-status-dot ${dotCls}">${dotLabel}</span>
          ${!n.estLue ? `
            <button class="notif-btn notif-btn-read" data-mark="${n.id}" onclick="event.preventDefault();event.stopPropagation();markOneRead(this)">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M4 10l4 4 8-8" stroke-linecap="round"/>
              </svg>
              ✓ Lu
            </button>` : ''}
          <button class="notif-btn notif-btn-dismiss" data-dismiss="${n.id}" onclick="event.preventDefault();event.stopPropagation();dismissItem(this)" title="Supprimer">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 5l10 10M15 5L5 15" stroke-linecap="round"/>
            </svg>
          </button>
        </div>
      </${tag}>
    `;
  }

  /* ── Mettre à jour le badge ─────────────────────────── */
  function updateBadge(count) {
    if (count > 0) {
      badge.textContent = count > 99 ? '99+' : count;
      badge.classList.remove('hidden');
      unreadSpan.textContent = count + ' non lue' + (count > 1 ? 's' : '');
      unreadSpan.style.display = '';
    } else {
      badge.classList.add('hidden');
      unreadSpan.style.display = 'none';
    }
  }

  /* ── Marquer un seul item comme lu ─────────────────── */
  window.markOneRead = function(btn) {
    const id   = btn.dataset.mark;
    const card = btn.closest('.notif-item');
    if (!card) return;
    card.classList.remove('unread');
    const dot = card.querySelector('.notif-status-dot');
    if (dot) { dot.className = 'notif-status-dot'; dot.textContent = '● Lu'; }
    btn.remove();
  };

  /* ── Retirer un item visuellement ───────────────────── */
  window.dismissItem = function(btn) {
    const card = btn.closest('.notif-item');
    if (!card) return;
    card.style.transition = 'opacity .25s, transform .25s';
    card.style.opacity = '0';
    card.style.transform = 'translateX(20px)';
    setTimeout(() => card.remove(), 260);
  };

  /* ── Charger et afficher les notifications ──────────── */
  async function loadNotifications() {
    try {
      const r    = await fetch(API_LIST, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
      const data = await r.json();

      updateBadge(data.unread);

      if (!data.notifications.length) {
        list.innerHTML = `
          <div class="notif-empty">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.2">
              <path d="M10 2a6 6 0 00-6 6c0 3.5-1.5 5-1.5 5h15s-1.5-1.5-1.5-5a6 6 0 00-6-6z" stroke-linecap="round"/>
              <path d="M11.73 17a2 2 0 01-3.46 0" stroke-linecap="round"/>
            </svg>
            <strong>Tout est à jour !</strong>
            Aucune notification pour le moment
          </div>`;
        return;
      }

      list.innerHTML = data.notifications.map(renderItem).join('');

    } catch (e) {
      console.error('[Notif] Erreur chargement :', e);
    }
  }

  /* ── Toggle dropdown ────────────────────────────────── */
  bellBtn.addEventListener('click', function (e) {
    e.stopPropagation();
    const isOpen = !dropdown.classList.contains('hidden');
    dropdown.classList.toggle('hidden', isOpen);
    if (!isOpen) loadNotifications();
  });

  /* ── Fermer en cliquant ailleurs ────────────────────── */
  document.addEventListener('click', function (e) {
    if (!dropdown.contains(e.target) && e.target !== bellBtn) {
      dropdown.classList.add('hidden');
    }
  });

  /* ── Marquer tout comme lu ──────────────────────────── */
  markBtn.addEventListener('click', async function () {
    try {
      await fetch(API_MARK_READ, {
        method: 'POST',
        headers: {
          'X-Requested-With': 'XMLHttpRequest',
          'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]')?.content || '',
        },
      });
      updateBadge(0);
      document.querySelectorAll('.notif-item.unread').forEach(card => {
        card.classList.remove('unread');
        const dot = card.querySelector('.notif-status-dot');
        if (dot) { dot.className = 'notif-status-dot'; dot.textContent = '● Lu'; }
        const readBtn = card.querySelector('.notif-btn-read');
        if (readBtn) readBtn.remove();
      });
    } catch (e) {
      console.error('[Notif] Erreur mark-read :', e);
    }
  });

  /* ── Tout effacer visuellement ───────────────────────── */
  if (clearBtn) {
    clearBtn.addEventListener('click', function () {
      document.querySelectorAll('.notif-item').forEach((card, i) => {
        setTimeout(() => {
          card.style.transition = 'opacity .2s, transform .2s';
          card.style.opacity = '0';
          card.style.transform = 'translateX(20px)';
          setTimeout(() => card.remove(), 220);
        }, i * 40);
      });
      updateBadge(0);
    });
  }

  /* ── Toast : afficher les flash messages comme toasts ── */
  function showToast(type, message) {
    const config = {
      success: { color: '#52B788', bg: 'rgba(82,183,136,.1)',   label: 'Succès',    icon: ICONS.plus  },
      error:   { color: '#EF4444', bg: 'rgba(239,68,68,.1)',    label: 'Erreur',    icon: ICONS.info  },
      warning: { color: '#F59E0B', bg: 'rgba(245,158,11,.1)',   label: 'Attention', icon: ICONS.bell  },
    };
    const c = config[type] || config.success;

    const toast = document.createElement('div');
    toast.className = `toast-notif toast-${type}`;
    toast.innerHTML = `
      <div class="toast-icon" style="background:${c.bg};">
        <svg viewBox="0 0 20 20" fill="none" stroke="${c.color}" stroke-width="1.9">${c.icon}</svg>
      </div>
      <div class="toast-body">
        <div class="toast-label" style="color:${c.color}">${c.label}</div>
        <div class="toast-msg">${message}</div>
      </div>
      <button class="toast-close" onclick="dismissToast(this.closest('.toast-notif'))">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 5l10 10M15 5L5 15" stroke-linecap="round"/></svg>
      </button>`;

    document.body.appendChild(toast);

    // Disparaître après 5 s
    setTimeout(() => dismissToast(toast), 5000);
  }

  window.dismissToast = function(toast) {
    if (!toast) return;
    toast.classList.add('out');
    setTimeout(() => toast.remove(), 350);
  };

  /* ── Convertir les flash .flash en toasts ───────────── */
  document.querySelectorAll('.flash').forEach(el => {
    const classes = [...el.classList];
    const type = classes.includes('flash-success') ? 'success'
               : classes.includes('flash-error')   ? 'error'
               : 'warning';
    showToast(type, el.textContent.trim());
    el.style.display = 'none'; // cacher le flash original
  });

  /* ── Polling toutes les 30 s ─────────────────────────── */
  loadNotifications(); // premier chargement
  setInterval(loadNotifications, POLL_INTERVAL);

})();
</script>

{% block javascripts %}{% endblock %}
</body>
</html>
