{# templates/emails/evenement_modifie.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modification d'événement</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            margin: 0; padding: 0;
        }
        .wrapper {
            max-width: 600px;
            margin: 30px auto;
            background: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        }
        .header {
            background: linear-gradient(135deg, #f6a623 0%, #e67e22 100%);
            padding: 40px 30px;
            text-align: center;
            color: #fff;
        }
        .header h1 { margin: 0; font-size: 26px; }
        .header p  { margin: 8px 0 0; opacity: 0.9; font-size: 15px; }
        .body { padding: 35px 30px; color: #333; }
        .body h2 { font-size: 20px; color: #444; margin-bottom: 6px; }
        .info-box {
            background: #fff8f0;
            border-left: 4px solid #e67e22;
            padding: 18px 20px;
            border-radius: 6px;
            margin: 24px 0;
        }
        .info-box p { margin: 6px 0; font-size: 14px; }
        .info-box strong { color: #555; }
        .badge {
            display: inline-block;
            background: #fff3e0;
            color: #e65100;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: bold;
        }
        .footer {
            background: #f8f8f8;
            text-align: center;
            padding: 20px;
            font-size: 12px;
            color: #999;
            border-top: 1px solid #eee;
        }
    </style>
</head>
<body>
<div class="wrapper">

    <div class="header">
        <h1>⚠️ Événement modifié</h1>
        <p>Des informations ont été mises à jour</p>
    </div>

    <div class="body">
        <h2>Bonjour {{ participation.prenom }} {{ participation.nom }},</h2>
        <p>
            Nous vous informons que l'événement auquel vous êtes inscrit(e),
            <strong>« {{ evenement.titreEvenement }} »</strong>,
            a été <strong>modifié</strong>.
        </p>

        <span class="badge">⚠️ Événement mis à jour</span>

        <div class="info-box">
            <p><strong>📅 Nouvelle date de début :</strong>
               {{ evenement.datedebutEvenemnt|date('d/m/Y') }}</p>
            <p><strong>📅 Nouvelle date de fin :</strong>
               {{ evenement.datefinEvenemnt|date('d/m/Y') }}</p>
            <p><strong>📍 Lieu :</strong>
               {{ evenement.lieuEvenement }}</p>
            <p><strong>🏷️ Type :</strong>
               {{ evenement.typeEvenement.libelle }}
               ({{ evenement.typeEvenement.modalite }})</p>
            <p><strong>📧 Votre email :</strong>
               {{ participation.email }}</p>
        </div>

        <p style="font-size:14px; color:#666;">
            Votre inscription reste valide. Si vous avez des questions, n'hésitez pas à nous contacter.
        </p>

        <p style="font-size:14px; color:#666;">
            À bientôt sur MindAura ! 🚀
        </p>
    </div>

    <div class="footer">
        © {{ "now"|date("Y") }} MindAura · Cet email a été envoyé automatiquement, merci de ne pas y répondre.
    </div>

</div>
</body>
</html>
