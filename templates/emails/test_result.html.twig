<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Resultats du test</title>
</head>
<body style="margin:0;padding:0;background:#f4f6fb;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f4f6fb;padding:24px 12px;">
    <tr>
      <td align="center">
        <table role="presentation" width="680" cellspacing="0" cellpadding="0" style="max-width:680px;width:100%;background:#ffffff;border-radius:16px;overflow:hidden;border:1px solid #e5e7eb;">
          <tr>
            <td style="padding:24px 28px;background:linear-gradient(135deg,#1b4332 0%,#2d6a4f 60%,#7b5ea7 100%);color:#ffffff;">
              <h1 style="margin:0;font-size:22px;line-height:1.3;">Vos resultats de test sont prets</h1>
              <p style="margin:8px 0 0;font-size:14px;opacity:.92;">Bonjour {{ user.prenomUtilisateur ?: user.userIdentifier }}, voici le recapitulatif de votre passage.</p>
            </td>
          </tr>

          <tr>
            <td style="padding:24px 28px 10px;">
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:separate;border-spacing:0 10px;">
                <tr>
                  <td style="font-size:13px;color:#6b7280;">Test</td>
                  <td style="font-size:14px;font-weight:700;text-align:right;">{{ test.titreTest }}</td>
                </tr>
                <tr>
                  <td style="font-size:13px;color:#6b7280;">Type</td>
                  <td style="font-size:14px;text-align:right;">{{ test.typeTest ?: 'Non precise' }}</td>
                </tr>
                <tr>
                  <td style="font-size:13px;color:#6b7280;">Score</td>
                  <td style="font-size:18px;font-weight:700;color:#1b4332;text-align:right;">{{ score }}</td>
                </tr>
                <tr>
                  <td style="font-size:13px;color:#6b7280;">Questions repondues</td>
                  <td style="font-size:14px;text-align:right;">{{ answered_count }}/{{ total_questions }}</td>
                </tr>
                <tr>
                  <td style="font-size:13px;color:#6b7280;">Date</td>
                  <td style="font-size:14px;text-align:right;">{{ sent_at|date('d/m/Y H:i') }}</td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding:10px 28px 8px;">
              <h2 style="margin:0 0 10px;font-size:16px;color:#111827;">Objectifs suggeres</h2>
              {% if suggested_objectifs is not empty %}
                <ul style="margin:0;padding:0 0 0 18px;color:#374151;font-size:14px;line-height:1.6;">
                  {% for objectif in suggested_objectifs|slice(0, 5) %}
                    <li style="margin-bottom:6px;">{{ objectif.titre ?: 'Objectif personnalise' }}</li>
                  {% endfor %}
                </ul>
              {% else %}
                <p style="margin:0;color:#6b7280;font-size:14px;">Aucun objectif n'a ete suggere automatiquement pour ce score.</p>
              {% endif %}
            </td>
          </tr>

          <tr>
            <td style="padding:24px 28px 30px;">
              <a href="{{ results_url }}" style="display:inline-block;padding:12px 18px;background:#1b4332;color:#ffffff;text-decoration:none;border-radius:10px;font-size:14px;font-weight:700;">
                Voir les resultats dans MindAura
              </a>
            </td>
          </tr>

          <tr>
            <td style="padding:14px 28px;background:#f9fafb;border-top:1px solid #e5e7eb;">
              <p style="margin:0;font-size:12px;color:#6b7280;">
                Email automatique MindAura. Merci de ne pas repondre a ce message.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
