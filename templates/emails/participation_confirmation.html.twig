{# templates/emails/participation_confirmation.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirmation de participation</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            margin: 0; padding: 0;
        }
        .wrapper {
            max-width: 600px;
            margin: 30px auto;
            background: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        }
        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 40px 30px;
            text-align: center;
            color: #fff;
        }
        .header h1 { margin: 0; font-size: 26px; }
        .header p  { margin: 8px 0 0; opacity: 0.85; font-size: 15px; }
        .body { padding: 35px 30px; color: #333; }
        .body h2 { font-size: 20px; color: #444; margin-bottom: 6px; }
        .info-box {
            background: #f8f9ff;
            border-left: 4px solid #667eea;
            padding: 18px 20px;
            border-radius: 6px;
            margin: 24px 0;
        }
        .info-box p { margin: 6px 0; font-size: 14px; }
        .info-box strong { color: #555; }
        .qr-section { text-align: center; margin: 30px 0; }
        .qr-section p { color: #666; font-size: 14px; margin-bottom: 10px; }
        .badge {
            display: inline-block;
            background: #e8f5e9;
            color: #2e7d32;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: bold;
        }
        .footer {
            background: #f8f8f8;
            text-align: center;
            padding: 20px;
            font-size: 12px;
            color: #999;
            border-top: 1px solid #eee;
        }
    </style>
</head>
<body>
<div class="wrapper">

    <div class="header">
        <h1>🎉 Inscription confirmée !</h1>
        <p>Merci pour votre participation</p>
    </div>

    <div class="body">
        <h2>Bonjour {{ participation.prenom }} {{ participation.nom }},</h2>
        <p>
            Votre inscription à l'événement
            <strong>« {{ participation.evenement.titreEvenement }} »</strong>
            a bien été enregistrée.
        </p>

        <span class="badge">✅ Statut : Confirmée</span>

        <div class="info-box">
            <p><strong>📅 Date de début :</strong>
               {{ participation.evenement.datedebutEvenemnt|date('d/m/Y') }}</p>
            <p><strong>📅 Date de fin :</strong>
               {{ participation.evenement.datefinEvenemnt|date('d/m/Y') }}</p>
            <p><strong>📍 Lieu :</strong>
               {{ participation.evenement.lieuEvenement }}</p>
            <p><strong>🏷️ Type :</strong>
               {{ participation.evenement.typeEvenement.libelle }}
               ({{ participation.evenement.typeEvenement.modalite }})</p>
            <p><strong>📧 Email inscrit :</strong>
               {{ participation.email }}</p>
            <p><strong>🕐 Date d'inscription :</strong>
               {{ participation.dateInscription|date('d/m/Y à H:i') }}</p>
        </div>

        <div class="qr-section">
            <p>
                <strong>Votre QR code d'accès est joint à cet email.</strong><br>
                Présentez-le à l'entrée de l'événement.
            </p>
            <p style="color:#999; font-size:13px;">
                Si vous ne pouvez plus participer, veuillez nous contacter.
            </p>
        </div>

        <p style="font-size:14px; color:#666;">
            À bientôt sur MindAura ! 🚀
        </p>
    </div>

    <div class="footer">
        © {{ "now"|date("Y") }} MindAura · Cet email a été envoyé automatiquement, merci de ne pas y répondre.
    </div>

</div>
</body>
</html>
