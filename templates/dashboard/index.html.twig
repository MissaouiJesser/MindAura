    <div class="kpi-lbl">Prix moyen</div>
  </div>
  <div class="kpi-card">
    <div class="kpi-icon" style="background:rgba(16,185,129,.12)">🏪</div>
    <div class="kpi-val">{{ valeurStock }} <span style="font-size:1rem;color:var(--text-sec)">TND</span></div>
    <div class="kpi-lbl">Valeur du stock</div>
  </div>
</div>

<div class="charts-2" style="grid-template-columns:1fr 1.6fr;">
