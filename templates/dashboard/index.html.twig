  </div>
  <div class="chart-box">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px"><div style="font-weight:700;font-size:.9rem">❤️ Les plus likées</div><a href="{{ path('admin_ressources_index') }}" style="font-size:.72rem;color:var(--green);font-weight:600;text-decoration:none">Voir tout →</a></div>
    {% for res in ressourcesStats.topLikes %}<div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--bg)"><span style="font-size:.8rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:70%">{{ res.titre|slice(0,40) }}{% if res.titre|length>40 %}…{% endif %}</span><span style="background:var(--green-pale);color:var(--green);padding:2px 8px;border-radius:20px;font-size:.7rem;font-weight:600">{{ res.likes }} likes</span></div>{% else %}<div style="text-align:center;padding:16px;color:var(--text-sec);font-size:.85rem">Aucune ressource</div>{% endfor %}
