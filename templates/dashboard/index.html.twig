{# templates/dashboard/index.html.twig — Vue d'ensemble Admin #}
{% extends 'base_backoffice.html.twig' %}

{% block title %}Vue d'ensemble{% endblock %}
{% block page_label %}Vue d'ensemble{% endblock %}

{% block content %}

<script>
  const DASH = {
    totalUsers:    {{ stats.totalUsers }},
    countPatients: {{ stats.countPatients }},
    countPsychos:  {{ stats.countPsychos }},
    countCoachs:   {{ stats.countCoachs }},
    countAdmins:   {{ stats.countAdmins }},
    countActifs:   {{ stats.countActifs }},
    countInactifs: {{ stats.countInactifs }},
    newThisMonth:  {{ stats.newThisMonth }},
    newThisWeek:   {{ stats.newThisWeek }},
    pctPatients:   {{ stats.pctPatients }},
    pctPsychos:    {{ stats.pctPsychos }},
    pctCoachs:     {{ stats.pctCoachs }},
    pctAdmins:     {{ stats.pctAdmins }},
    registrationsByDay: {{ stats.registrationsByDay|json_encode|raw }}
  };
</script>

<style>
@keyframes db-up   { from { opacity:0; transform:translateY(22px); } to { opacity:1; transform:none; } }
@keyframes pulse-dot { 0%,100%{transform:scale(1);opacity:1} 50%{transform:scale(1.6);opacity:.5} }
@keyframes bar-grow { from { transform:scaleX(0); } to { transform:scaleX(1); } }
@keyframes fade-row { from { opacity:0; transform:translateX(-10px); } to { opacity:1; transform:none; } }
@keyframes al-slide-in { to { opacity: 1; transform: none; } }

/* ── Layout ── */
.db-grid { display:grid; grid-template-columns:repeat(12,1fr); gap:14px; }
.db-card { background:var(--white); border:1.5px solid var(--border); border-radius:18px; box-shadow:0 2px 14px rgba(27,67,50,.06); overflow:hidden; position:relative; }

/* ── Section title ── */
.section-title {
  display:flex; align-items:center; gap:14px;
  margin:28px 0 20px;
  animation:db-up .45s cubic-bezier(.22,1,.36,1) both;
}
.section-bar { width:4px; height:28px; border-radius:99px; flex-shrink:0; }
.section-title-text { font-size:1rem; font-weight:700; color:var(--text); }
.section-title-sub  { font-size:.75rem; color:var(--text-sec); margin-top:1px; }
.section-title-line { flex:1; height:1px; }
.section-title-actions { display:flex; gap:8px; flex-wrap:wrap; }
.section-btn {
  font-size:.75rem; font-weight:600; text-decoration:none;
  padding:6px 14px; border-radius:8px; transition:background .2s; white-space:nowrap;
}

/* ── KPI card ── */
.kpi-grid { display:grid; gap:16px; margin-bottom:24px; }
.kpi-grid-4 { grid-template-columns:repeat(4,1fr); }
.kpi-grid-3 { grid-template-columns:repeat(3,1fr); }
.kpi-grid-auto { grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); }

.kpi-card {
  background:#fff; border-radius:16px; padding:22px;
  box-shadow:var(--shadow-card); text-decoration:none; display:block;
  transition:transform .22s, box-shadow .22s;
  animation:db-up .45s cubic-bezier(.22,1,.36,1) both;
}
.kpi-card:hover { transform:translateY(-3px); box-shadow:var(--shadow-hover); }
.kpi-icon { width:42px; height:42px; border-radius:12px; display:grid; place-items:center; font-size:1.2rem; margin-bottom:14px; }
.kpi-val  { font-size:1.9rem; font-weight:800; color:var(--text); line-height:1; margin-bottom:4px; }
.kpi-lbl  { font-size:.77rem; color:var(--text-sec); font-weight:500; margin-bottom:8px; }
.kpi-delta{ font-size:.7rem; font-weight:600; }

/* ── Chart wrapper ── */
.chart-box { background:#fff; border-radius:16px; padding:20px; box-shadow:var(--shadow-card); }
.chart-box-title { font-size:.9rem; font-weight:700; margin-bottom:12px; }
.chart-wrap { position:relative; }
.chart-wrap-200 { height:200px; }
.chart-wrap-220 { height:220px; }
.chart-wrap-240 { height:240px; }
.chart-wrap-180 { height:180px; }

/* ── 2-col / 3-col chart grids ── */
.charts-3 { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-bottom:28px; }
.charts-2 { display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:28px; }

/* ══ HERO ══ */
.db-hero {
  grid-column:1/-1; border-radius:20px; padding:28px 32px;
  display:flex; align-items:center; gap:28px; position:relative; overflow:hidden;
  background:linear-gradient(135deg,#0d2b1f 0%,#1B4332 40%,#2D6A4F 75%,#7B5EA7 100%);
  animation:db-up .5s cubic-bezier(.22,1,.36,1) both; border:none;
}
.db-hero::after { content:''; position:absolute; width:340px; height:340px; border-radius:50%; background:radial-gradient(circle,rgba(82,183,136,.18) 0%,transparent 70%); right:-60px; top:-100px; pointer-events:none; }
.db-hero-avatar { width:62px; height:62px; border-radius:18px; flex-shrink:0; background:rgba(255,255,255,.13); border:1.5px solid rgba(255,255,255,.22); display:grid; place-items:center; backdrop-filter:blur(6px); position:relative; z-index:1; overflow:hidden; }
.db-hero-avatar img { width:100%; height:100%; object-fit:cover; border-radius:16px; }
.db-hero-avatar-fallback { font-size:1.3rem; font-weight:800; color:#fff; font-family:'Playfair Display',serif; }
.db-hero-text { flex:1; position:relative; z-index:1; }
.db-hero-greeting { font-size:.75rem; font-weight:700; color:rgba(255,255,255,.55); letter-spacing:1.8px; text-transform:uppercase; margin-bottom:4px; }
.db-hero-name { font-family:'Playfair Display',serif; font-size:1.65rem; font-weight:700; color:#fff; line-height:1.1; margin-bottom:6px; }
.db-hero-chips { display:flex; gap:8px; flex-wrap:wrap; }
.db-hero-chip { display:inline-flex; align-items:center; gap:5px; background:rgba(255,255,255,.1); border:1px solid rgba(255,255,255,.18); border-radius:99px; padding:4px 11px; font-size:.71rem; font-weight:600; color:rgba(255,255,255,.85); }
.db-hero-chip .dot { width:6px; height:6px; border-radius:50%; background:#52B788; animation:pulse-dot 1.8s ease-in-out infinite; flex-shrink:0; }
.db-hero-stats { display:flex; gap:2px; position:relative; z-index:1; flex-shrink:0; }
.db-hero-stat { text-align:center; padding:10px 20px; border-left:1px solid rgba(255,255,255,.1); }
.db-hero-stat:first-child { border-left:none; }
.db-hero-stat-val { font-family:'Playfair Display',serif; font-size:1.8rem; font-weight:700; color:#fff; line-height:1; margin-bottom:3px; }
.db-hero-stat-lbl { font-size:.67rem; font-weight:600; color:rgba(255,255,255,.5); letter-spacing:.8px; text-transform:uppercase; }

/* ══ KPI CARDS (top) ══ */
.db-kpi { grid-column:span 3; animation:db-up .5s cubic-bezier(.22,1,.36,1) both; }
.db-kpi-inner { padding:22px 22px 18px; height:100%; display:flex; flex-direction:column; gap:10px; }
.db-kpi-top { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; }
.db-kpi-icon { width:46px; height:46px; border-radius:14px; flex-shrink:0; display:grid; place-items:center; }
.db-kpi-icon svg { width:22px; height:22px; }
.db-kpi-badge { display:inline-flex; align-items:center; gap:4px; font-size:.69rem; font-weight:700; border-radius:99px; padding:3px 9px; }
.db-kpi-body { flex:1; }
.db-kpi-val { font-family:'Playfair Display',serif; font-size:2.2rem; font-weight:700; line-height:1; color:var(--text); margin-bottom:2px; }
.db-kpi-lbl { font-size:.78rem; color:var(--text-sec); font-weight:500; }
.db-kpi-bar { height:3px; border-radius:99px; background:var(--border); overflow:hidden; margin-top:6px; }
.db-kpi-bar-fill { height:100%; border-radius:99px; transform-origin:left; animation:bar-grow .9s cubic-bezier(.22,1,.36,1) .4s both; }
.kpi-green  .db-kpi-icon { background:#D8F3DC; } .kpi-green  .db-kpi-icon svg { stroke:#1B4332; fill:none; stroke-width:1.7; } .kpi-green  .db-kpi-badge { background:#D8F3DC; color:#1B4332; } .kpi-green  .db-kpi-bar-fill { background:linear-gradient(90deg,#52B788,#1B4332); }
.kpi-violet .db-kpi-icon { background:#EDE9F6; } .kpi-violet .db-kpi-icon svg { stroke:#7B5EA7; fill:none; stroke-width:1.7; } .kpi-violet .db-kpi-badge { background:#EDE9F6; color:#7B5EA7; } .kpi-violet .db-kpi-bar-fill { background:linear-gradient(90deg,#b39ddb,#7B5EA7); }
.kpi-amber  .db-kpi-icon { background:#FFF3E0; } .kpi-amber  .db-kpi-icon svg { stroke:#E65100; fill:none; stroke-width:1.7; } .kpi-amber  .db-kpi-badge { background:#FFF3E0; color:#E65100; } .kpi-amber  .db-kpi-bar-fill { background:linear-gradient(90deg,#ffb74d,#E65100); }

/* ══ CHART CARD (courbe) ══ */
.db-chart-card { grid-column:span 8; animation:db-up .5s cubic-bezier(.22,1,.36,1) .08s both; }
.db-chart-head { display:flex; align-items:center; justify-content:space-between; padding:20px 24px 0; }
.db-chart-title { font-size:.95rem; font-weight:700; color:var(--text); }
.db-chart-sub   { font-size:.74rem; color:var(--text-sec); margin-top:2px; }
.db-chart-legend { display:flex; align-items:center; gap:6px; font-size:.72rem; font-weight:600; color:var(--text-sec); }
.db-chart-legend-dot { width:8px; height:8px; border-radius:50%; background:var(--green-light); }
.db-chart-wrap { padding:8px 16px 16px; position:relative; height:220px; }
#registrationsChart { width:100%; height:100%; display:block; }
.chart-tooltip { position:absolute; background:#1A1A2E; color:#fff; font-size:.72rem; font-weight:600; border-radius:10px; padding:6px 11px; pointer-events:none; white-space:nowrap; box-shadow:0 6px 20px rgba(0,0,0,.25); z-index:50; opacity:0; transition:opacity .15s; }
.chart-tooltip.visible { opacity:1; }

/* ══ ROLES CARD ══ */
.db-roles-card { grid-column:span 4; animation:db-up .5s cubic-bezier(.22,1,.36,1) .1s both; }
.db-roles-head { padding:20px 22px 0; }
.db-roles-title { font-size:.95rem; font-weight:700; color:var(--text); }
.db-roles-sub   { font-size:.74rem; color:var(--text-sec); margin-top:2px; }
.db-donut-wrap  { display:flex; align-items:center; justify-content:center; padding:16px 22px 8px; gap:18px; }
.db-role-bars   { padding:0 22px 18px; display:flex; flex-direction:column; gap:9px; }
.db-role-top    { display:flex; justify-content:space-between; align-items:center; margin-bottom:4px; }
.db-role-name   { font-size:.75rem; font-weight:600; color:var(--text); display:flex; align-items:center; gap:6px; }
.db-role-dot    { width:7px; height:7px; border-radius:50%; flex-shrink:0; }
.db-role-count  { font-size:.73rem; font-weight:700; color:var(--text-sec); }
.db-role-track  { height:5px; border-radius:99px; background:var(--border); overflow:hidden; }
.db-role-fill   { height:100%; border-radius:99px; transform-origin:left; animation:bar-grow .8s cubic-bezier(.22,1,.36,1) .5s both; }

/* ══ ACTIVITY RING ══ */
.db-activity-card { grid-column:span 4; animation:db-up .5s cubic-bezier(.22,1,.36,1) .14s both; }
.db-activity-head { padding:20px 22px 12px; }
.db-activity-title { font-size:.95rem; font-weight:700; color:var(--text); }
.db-activity-sub   { font-size:.74rem; color:var(--text-sec); margin-top:2px; }
.db-ring-wrap  { display:flex; align-items:center; justify-content:center; padding:4px 0 8px; gap:20px; }
.db-ring-legend{ display:flex; flex-direction:column; gap:10px; }
.db-ring-item  { display:flex; align-items:center; gap:9px; }
.db-ring-swatch{ width:10px; height:10px; border-radius:50%; flex-shrink:0; }
.db-ring-item-val { font-size:1.05rem; font-weight:800; color:var(--text); line-height:1; }
.db-ring-item-lbl { font-size:.69rem; color:var(--text-sec); font-weight:500; }

/* ══ NEW USERS ══ */
.db-new-card { grid-column:span 4; animation:db-up .5s cubic-bezier(.22,1,.36,1) .16s both; }
.db-new-head { padding:20px 22px 12px; }
.db-new-title { font-size:.95rem; font-weight:700; color:var(--text); }
.db-new-sub   { font-size:.74rem; color:var(--text-sec); margin-top:2px; }
.db-new-body  { padding:0 22px 20px; display:flex; flex-direction:column; gap:12px; }
.db-new-stat  { display:flex; align-items:center; gap:14px; padding:14px 16px; border-radius:14px; border:1.5px solid var(--border); background:var(--bg); }
.db-new-stat-icon { width:40px; height:40px; border-radius:12px; display:grid; place-items:center; flex-shrink:0; }
.db-new-stat-icon svg { width:19px; height:19px; fill:none; stroke-width:1.7; }
.db-new-stat-val { font-family:'Playfair Display',serif; font-size:1.55rem; font-weight:700; color:var(--text); line-height:1; }
.db-new-stat-lbl { font-size:.72rem; color:var(--text-sec); font-weight:500; margin-top:2px; }

/* ══ RECENT USERS ══ */
.db-recent-card { grid-column:span 8; animation:db-up .5s cubic-bezier(.22,1,.36,1) .18s both; }
.db-recent-head { display:flex; align-items:center; justify-content:space-between; padding:20px 24px 0; }
.db-recent-title { font-size:.95rem; font-weight:700; color:var(--text); }
.db-recent-sub   { font-size:.74rem; color:var(--text-sec); margin-top:2px; }
.db-recent-link  { font-size:.78rem; font-weight:700; color:var(--green-light); text-decoration:none; display:flex; align-items:center; gap:4px; }
.db-recent-link:hover { color:var(--green); }
.db-recent-table { width:100%; border-collapse:collapse; margin-top:14px; }
.db-recent-table th { padding:9px 16px; text-align:left; font-size:.65rem; font-weight:700; color:var(--text-sec); text-transform:uppercase; letter-spacing:.9px; border-bottom:1.5px solid var(--border); background:var(--bg); }
.db-recent-table td { padding:11px 16px; vertical-align:middle; border-bottom:1px solid var(--border); font-size:.83rem; }
.db-recent-table tr:last-child td { border-bottom:none; }
.db-recent-table tbody tr { transition:background .14s; opacity:0; animation:fade-row .3s ease both; }
.db-recent-table tbody tr:hover { background:var(--green-hover); }
.db-user-cell { display:flex; align-items:center; gap:10px; }
.db-user-av { width:32px; height:32px; border-radius:50%; flex-shrink:0; display:grid; place-items:center; font-size:.7rem; font-weight:800; color:#fff; overflow:hidden; }
.db-user-av img { width:100%; height:100%; object-fit:cover; }
.db-user-name  { font-weight:700; color:var(--text); font-size:.82rem; line-height:1.2; }
.db-user-email { font-size:.7rem; color:var(--text-sec); }
.db-role-badge { display:inline-flex; align-items:center; gap:4px; font-size:.66rem; font-weight:700; border-radius:99px; padding:3px 9px; }
.db-role-badge::before { content:''; width:5px; height:5px; border-radius:50%; }
.rb-PATIENT     { background:#EDE9F6; color:#7B5EA7; } .rb-PATIENT::before     { background:#7B5EA7; }
.rb-PSYCHOLOGUE { background:#E0F2F1; color:#00897B; } .rb-PSYCHOLOGUE::before { background:#00897B; }
.rb-COACH       { background:#FFF3E0; color:#E65100; } .rb-COACH::before       { background:#E65100; }
.rb-ADMIN       { background:#D8F3DC; color:#1B4332; } .rb-ADMIN::before       { background:#1B4332; }
.rb-USER        { background:#E3F2FD; color:#1565C0; } .rb-USER::before        { background:#1565C0; }
.db-status-dot { display:inline-flex; align-items:center; gap:5px; font-size:.72rem; font-weight:600; }
.db-status-dot::before { content:''; width:6px; height:6px; border-radius:50%; flex-shrink:0; }
.dot-active   { color:#1B4332; } .dot-active::before   { background:#52B788; }
.dot-inactive { color:#991B1B; } .dot-inactive::before { background:#EF4444; }

/* ══ ACTIVITY LOG ══ */
.al-section { margin-top:14px; }
.al-card { background:var(--white); border:1.5px solid var(--border); border-radius:20px; box-shadow:0 2px 18px rgba(27,67,50,.07); overflow:hidden; animation:db-up .5s cubic-bezier(.22,1,.36,1) .22s both; }
.al-head { display:flex; align-items:center; justify-content:space-between; padding:22px 28px 0; gap:16px; }
.al-head-left { display:flex; align-items:center; gap:14px; }
.al-head-icon { width:42px; height:42px; border-radius:13px; background:linear-gradient(135deg,#1B4332,#2D6A4F); display:grid; place-items:center; flex-shrink:0; }
.al-head-icon svg { width:20px; height:20px; stroke:#fff; fill:none; stroke-width:1.7; }
.al-head-title { font-size:1rem; font-weight:700; color:var(--text); }
.al-head-sub   { font-size:.74rem; color:var(--text-sec); margin-top:2px; }
.al-filters { display:flex; gap:6px; flex-wrap:wrap; }
.al-filter-btn { display:inline-flex; align-items:center; gap:5px; padding:5px 13px; border-radius:99px; font-size:.71rem; font-weight:700; border:1.5px solid var(--border); background:var(--bg); color:var(--text-sec); cursor:pointer; transition:all .18s; }
.al-filter-btn:hover, .al-filter-btn.active { background:#1B4332; color:#fff; border-color:#1B4332; }
.al-filter-btn .dot { width:6px; height:6px; border-radius:50%; background:currentColor; }
.al-timeline { padding:20px 28px 8px; display:flex; flex-direction:column; gap:0; max-height:560px; overflow-y:auto; scrollbar-width:thin; scrollbar-color:var(--border) transparent; }
.al-date-group { margin-bottom:4px; }
.al-date-label { display:inline-flex; align-items:center; gap:7px; font-size:.65rem; font-weight:800; letter-spacing:1.2px; text-transform:uppercase; color:var(--text-sec); margin-bottom:10px; }
.al-date-label::after { content:''; flex:1; min-width:60px; height:1px; background:var(--border); margin-left:8px; }
.al-item { display:flex; align-items:flex-start; gap:14px; padding:12px 0; border-bottom:1px solid var(--border); position:relative; opacity:0; transform:translateX(-12px); animation:al-slide-in .38s cubic-bezier(.22,1,.36,1) forwards; }
.al-item:last-child { border-bottom:none; }
.al-rail { position:absolute; left:19px; top:46px; bottom:-1px; width:2px; background:linear-gradient(to bottom,var(--border),transparent); border-radius:99px; z-index:0; }
.al-item:last-child .al-rail { display:none; }
.al-avatar { width:38px; height:38px; border-radius:12px; flex-shrink:0; display:grid; place-items:center; font-size:.8rem; font-weight:800; color:#fff; position:relative; z-index:1; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,.12); }
.al-avatar img { width:100%; height:100%; object-fit:cover; }
.al-action-badge { position:absolute; bottom:-3px; right:-3px; width:18px; height:18px; border-radius:6px; display:grid; place-items:center; font-size:.65rem; border:2px solid var(--white); z-index:2; }
.al-body { flex:1; min-width:0; }
.al-body-top { display:flex; align-items:baseline; gap:8px; flex-wrap:wrap; }
.al-user-name { font-size:.84rem; font-weight:700; color:var(--text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.al-user-role { font-size:.63rem; font-weight:700; border-radius:99px; padding:2px 8px; flex-shrink:0; }
.al-label { font-size:.79rem; color:var(--text-sec); margin-top:3px; display:flex; align-items:center; gap:6px; }
.al-label-icon { display:inline-flex; align-items:center; justify-content:center; width:20px; height:20px; border-radius:6px; font-size:.7rem; flex-shrink:0; }
.al-meta { display:flex; flex-direction:column; align-items:flex-end; gap:4px; flex-shrink:0; min-width:90px; }
.al-time { font-size:.7rem; color:var(--text-sec); font-weight:600; white-space:nowrap; }
.al-context-badge { display:inline-flex; align-items:center; gap:4px; font-size:.62rem; font-weight:700; border-radius:99px; padding:2px 9px; white-space:nowrap; }
.al-context-back  { background:#EDE9F6; color:#7B5EA7; }
.al-context-front { background:#D8F3DC; color:#1B4332; }
.al-role-patient     { background:#EDE9F6; color:#7B5EA7; }
.al-role-psychologue { background:#E0F2F1; color:#00897B; }
.al-role-coach       { background:#FFF3E0; color:#E65100; }
.al-role-admin       { background:#E8F5E9; color:#1B4332; }
.al-role-user        { background:#E3F2FD; color:#1565C0; }
.al-footer { display:flex; align-items:center; justify-content:center; padding:14px 28px 20px; border-top:1.5px solid var(--border); margin-top:4px; }
.al-footer-link { display:inline-flex; align-items:center; gap:6px; font-size:.78rem; font-weight:700; color:var(--green); text-decoration:none; transition:gap .2s; }
.al-footer-link:hover { gap:10px; }
.al-footer-link svg { width:14px; height:14px; }
.al-empty { display:flex; flex-direction:column; align-items:center; justify-content:center; padding:48px 28px; gap:10px; }
.al-empty-icon { font-size:2.4rem; opacity:.4; }
.al-empty-text { font-size:.84rem; color:var(--text-sec); font-weight:500; }
.al-live-dot { width:7px; height:7px; border-radius:50%; background:#52B788; display:inline-block; animation:pulse-dot 1.8s ease-in-out infinite; }
.progress-fill { height:100%; border-radius:99px; transition:width 1.2s cubic-bezier(.22,1,.36,1); }

@media (max-width:900px) {
  .kpi-grid-4 { grid-template-columns:repeat(2,1fr); }
  .charts-3 { grid-template-columns:1fr; }
  .charts-2 { grid-template-columns:1fr; }
}
@media (max-width:600px) {
  .kpi-grid-4 { grid-template-columns:1fr; }
}
</style>

{# ════════════════════════════════════════════════════════
   SECTION 1 — HERO + KPI UTILISATEURS
════════════════════════════════════════════════════════ #}
<div class="db-grid">

  <div class="db-hero db-card">
    <div class="db-hero-avatar">
      {% if adminUser.photoProfilUtilisateur is defined and adminUser.photoProfilUtilisateur != 'default.png' %}
        <img src="{{ asset('avatars/' ~ adminUser.photoProfilUtilisateur) }}" alt="avatar"/>
      {% else %}
        <div class="db-hero-avatar-fallback">{{ adminUser.prenomUtilisateur|first|upper }}{{ adminUser.nomUtilisateur|first|upper }}</div>
      {% endif %}
    </div>
    <div class="db-hero-text">
      <div class="db-hero-greeting">Tableau de bord</div>
      <div class="db-hero-name">Bonjour, {{ adminUser.prenomUtilisateur }} 👋</div>
      <div class="db-hero-chips">
        <span class="db-hero-chip"><span class="dot"></span>Système opérationnel</span>
        <span class="db-hero-chip">
          <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" style="width:11px;height:11px"><rect x="1" y="3" width="10" height="8" rx="1.5"/><path d="M4 3V2a2 2 0 014 0v1" stroke-linecap="round"/></svg>
          Administrateur
        </span>
        <span class="db-hero-chip">
          <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" style="width:11px;height:11px"><circle cx="6" cy="6" r="4.5"/><path d="M6 3.5v2.7l1.5 1.5" stroke-linecap="round"/></svg>
          {{ "now"|date("d/m/Y") }}
        </span>
      </div>
    </div>
    <div class="db-hero-stats">
      <div class="db-hero-stat"><div class="db-hero-stat-val">{{ stats.totalUsers }}</div><div class="db-hero-stat-lbl">Utilisateurs</div></div>
      <div class="db-hero-stat"><div class="db-hero-stat-val">{{ stats.countActifs }}</div><div class="db-hero-stat-lbl">Actifs</div></div>
      <div class="db-hero-stat"><div class="db-hero-stat-val">{{ stats.newThisMonth }}</div><div class="db-hero-stat-lbl">Ce mois</div></div>
    </div>
  </div>

  {# KPI #}
  <div class="db-card db-kpi kpi-green" style="animation-delay:.04s">
    <div class="db-kpi-inner">
      <div class="db-kpi-top">
        <div class="db-kpi-icon"><svg viewBox="0 0 20 20"><circle cx="10" cy="7" r="3.5"/><path d="M3 18c0-3.9 3.1-7 7-7s7 3.1 7 7" stroke-linecap="round"/></svg></div>
        <span class="db-kpi-badge">Total</span>
      </div>
      <div class="db-kpi-body">
        <div class="db-kpi-val" data-target="{{ stats.totalUsers }}">{{ stats.totalUsers }}</div>
        <div class="db-kpi-lbl">Comptes enregistrés</div>
      </div>
      <div class="db-kpi-bar"><div class="db-kpi-bar-fill" style="width:100%"></div></div>
    </div>
  </div>

  <div class="db-card db-kpi kpi-violet" style="animation-delay:.08s">
    <div class="db-kpi-inner">
      <div class="db-kpi-top">
        <div class="db-kpi-icon"><svg viewBox="0 0 20 20"><path d="M10 2a4 4 0 100 8 4 4 0 000-8zM4 14s-2 0-2 2v1h16v-1c0-2-2-2-2-2s-1.5 2-6 2-6-2-6-2z" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        <span class="db-kpi-badge">{{ stats.pctPatients }}%</span>
      </div>
      <div class="db-kpi-body">
        <div class="db-kpi-val" data-target="{{ stats.countPatients }}">{{ stats.countPatients }}</div>
        <div class="db-kpi-lbl">Patients</div>
      </div>
      <div class="db-kpi-bar"><div class="db-kpi-bar-fill" style="width:{{ stats.pctPatients }}%"></div></div>
    </div>
  </div>

  <div class="db-card db-kpi kpi-green" style="animation-delay:.12s">
    <div class="db-kpi-inner">
      <div class="db-kpi-top">
        <div class="db-kpi-icon"><svg viewBox="0 0 20 20"><path d="M9 3a5 5 0 100 10A5 5 0 009 3zM18 18l-4-4" stroke-linecap="round"/><path d="M9 7v4M7 9h4" stroke-linecap="round"/></svg></div>
        <span class="db-kpi-badge">{{ stats.pctPsychos }}%</span>
      </div>
      <div class="db-kpi-body">
        <div class="db-kpi-val" data-target="{{ stats.countPsychos }}">{{ stats.countPsychos }}</div>
        <div class="db-kpi-lbl">Psychologues</div>
      </div>
      <div class="db-kpi-bar"><div class="db-kpi-bar-fill" style="width:{{ stats.pctPsychos }}%"></div></div>
    </div>
  </div>

  <div class="db-card db-kpi kpi-amber" style="animation-delay:.16s">
    <div class="db-kpi-inner">
      <div class="db-kpi-top">
        <div class="db-kpi-icon"><svg viewBox="0 0 20 20"><circle cx="10" cy="7" r="3"/><path d="M4 18c0-3 2.7-5.5 6-5.5s6 2.5 6 5.5" stroke-linecap="round"/><path d="M15 4l1.5 1.5L14 8" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        <span class="db-kpi-badge">{{ stats.pctCoachs }}%</span>
      </div>
      <div class="db-kpi-body">
        <div class="db-kpi-val" data-target="{{ stats.countCoachs }}">{{ stats.countCoachs }}</div>
        <div class="db-kpi-lbl">Coachs</div>
      </div>
      <div class="db-kpi-bar"><div class="db-kpi-bar-fill" style="width:{{ stats.pctCoachs }}%"></div></div>
    </div>
  </div>

  {# Courbe inscriptions #}
  <div class="db-card db-chart-card" style="position:relative;">
    <div class="db-chart-head">
      <div>
        <div class="db-chart-title">Inscriptions — 7 derniers jours</div>
        <div class="db-chart-sub">Évolution quotidienne des nouveaux comptes</div>
      </div>
      <div class="db-chart-legend"><div class="db-chart-legend-dot"></div>Nouveaux inscrits</div>
    </div>
    <div class="db-chart-wrap">
      <canvas id="registrationsChart"></canvas>
      <div class="chart-tooltip" id="chartTooltip"></div>
    </div>
  </div>

  {# Répartition rôles #}
  <div class="db-card db-roles-card">
    <div class="db-roles-head">
      <div class="db-roles-title">Répartition des rôles</div>
      <div class="db-roles-sub">Distribution par type de compte</div>
    </div>
    <div class="db-donut-wrap">
      <svg width="110" height="110" viewBox="0 0 110 110" id="donutChart">
        <circle cx="55" cy="55" r="40" fill="none" stroke="var(--border)" stroke-width="14"/>
        <text x="55" y="50" text-anchor="middle" dominant-baseline="middle" font-family="Playfair Display,serif" font-size="18" font-weight="700" fill="var(--text)">{{ stats.totalUsers }}</text>
        <text x="55" y="67" text-anchor="middle" dominant-baseline="middle" font-family="Outfit,sans-serif" font-size="8" font-weight="600" fill="var(--text-sec)">TOTAL</text>
      </svg>
    </div>
    <div class="db-role-bars">
      {% for role in [
        {label:'Patients',      count:stats.countPatients, pct:stats.pctPatients, color:'#7B5EA7', grad:'linear-gradient(90deg,#b39ddb,#7B5EA7)'},
        {label:'Psychologues',  count:stats.countPsychos,  pct:stats.pctPsychos,  color:'#00897B', grad:'linear-gradient(90deg,#4db6ac,#00897B)'},
        {label:'Coachs',        count:stats.countCoachs,   pct:stats.pctCoachs,   color:'#E65100', grad:'linear-gradient(90deg,#ffb74d,#E65100)'},
        {label:'Admins',        count:stats.countAdmins,   pct:stats.pctAdmins,   color:'#1B4332', grad:'linear-gradient(90deg,#52B788,#1B4332)'},
      ] %}
      <div class="db-role-row">
        <div class="db-role-top">
          <span class="db-role-name"><span class="db-role-dot" style="background:{{ role.color }}"></span>{{ role.label }}</span>
          <span class="db-role-count">{{ role.count }}</span>
        </div>
        <div class="db-role-track"><div class="db-role-fill" style="width:{{ role.pct }}%;background:{{ role.grad }}"></div></div>
      </div>
      {% endfor %}
    </div>
  </div>

  {# Anneau actifs/inactifs #}
  <div class="db-card db-activity-card">
    <div class="db-activity-head">
      <div class="db-activity-title">Activité des comptes</div>
      <div class="db-activity-sub">Actifs vs inactifs</div>
    </div>
    <div class="db-ring-wrap">
      <svg width="120" height="120" viewBox="0 0 120 120">
        <circle cx="60" cy="60" r="45" fill="none" stroke="var(--border)" stroke-width="12"/>
        <circle id="ring-actifs" cx="60" cy="60" r="45" fill="none" stroke="url(#ring-grad-g)" stroke-width="12" stroke-linecap="round" stroke-dasharray="283" stroke-dashoffset="283" transform="rotate(-90 60 60)" style="transition:stroke-dashoffset 1.1s cubic-bezier(.22,1,.36,1) .3s"/>
        <defs>
          <linearGradient id="ring-grad-g" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="#52B788"/><stop offset="100%" stop-color="#1B4332"/></linearGradient>
        </defs>
        <text x="60" y="55" text-anchor="middle" dominant-baseline="middle" font-family="Playfair Display,serif" font-size="16" font-weight="700" fill="var(--text)" id="ring-pct">—</text>
        <text x="60" y="71" text-anchor="middle" dominant-baseline="middle" font-family="Outfit,sans-serif" font-size="7.5" font-weight="600" fill="var(--text-sec)">ACTIFS</text>
      </svg>
      <div class="db-ring-legend">
        <div class="db-ring-item">
          <div class="db-ring-swatch" style="background:linear-gradient(135deg,#52B788,#1B4332)"></div>
          <div><div class="db-ring-item-val">{{ stats.countActifs }}</div><div class="db-ring-item-lbl">Actifs</div></div>
        </div>
        <div class="db-ring-item">
          <div class="db-ring-swatch" style="background:#EF4444"></div>
          <div><div class="db-ring-item-val">{{ stats.countInactifs }}</div><div class="db-ring-item-lbl">Inactifs</div></div>
        </div>
      </div>
    </div>
  </div>

  {# Nouveaux inscrits #}
  <div class="db-card db-new-card">
    <div class="db-new-head"><div class="db-new-title">Nouvelles inscriptions</div><div class="db-new-sub">Tendances d'acquisition</div></div>
    <div class="db-new-body">
      <div class="db-new-stat">
        <div class="db-new-stat-icon" style="background:#D8F3DC"><svg viewBox="0 0 20 20" stroke="#1B4332"><rect x="3" y="4" width="14" height="13" rx="2"/><path d="M3 8h14M7 2v4M13 2v4" stroke-linecap="round"/></svg></div>
        <div><div class="db-new-stat-val">{{ stats.newThisMonth }}</div><div class="db-new-stat-lbl">Ce mois-ci</div></div>
      </div>
      <div class="db-new-stat">
        <div class="db-new-stat-icon" style="background:#EDE9F6"><svg viewBox="0 0 20 20" stroke="#7B5EA7"><circle cx="10" cy="10" r="7"/><path d="M10 6v4l2.5 2.5" stroke-linecap="round"/></svg></div>
        <div><div class="db-new-stat-val">{{ stats.newThisWeek }}</div><div class="db-new-stat-lbl">Cette semaine</div></div>
      </div>
    </div>
  </div>

  {# Derniers inscrits #}
  <div class="db-card db-recent-card">
    <div class="db-recent-head">
      <div><div class="db-recent-title">Derniers inscrits</div><div class="db-recent-sub">5 comptes les plus récents</div></div>
      <a href="{{ path('app_admin_utilisateurs') }}" class="db-recent-link">Voir tous <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7h8M7 3l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
    </div>
    <table class="db-recent-table">
      <thead><tr><th>Utilisateur</th><th>Rôle</th><th>Inscription</th><th>Statut</th></tr></thead>
      <tbody>
        {% set avatarColors = {'PATIENT':'#7B5EA7','PSYCHOLOGUE':'#00897B','COACH':'#E65100','ADMIN':'#1B4332','USER':'#1565C0'} %}
        {% set roleLabels   = {'PATIENT':'Patient','PSYCHOLOGUE':'Psychologue','COACH':'Coach','ADMIN':'Admin','USER':'Utilisateur'} %}
        {% for u in recentUsers %}
          {% set rk = u.roleUtilisateur|replace({'ROLE_': ''}) %}
          <tr style="animation-delay:{{ loop.index0 * 0.07 }}s">
            <td>
              <div class="db-user-cell">
                <div class="db-user-av" style="background:{{ avatarColors[rk] ?? '#5A6475' }}">
                  {% if u.photoProfilUtilisateur != 'default.png' %}<img src="{{ asset('avatars/' ~ u.photoProfilUtilisateur) }}" alt="av"/>
                  {% else %}{{ u.prenomUtilisateur|first|upper }}{{ u.nomUtilisateur|first|upper }}{% endif %}
                </div>
                <div><div class="db-user-name">{{ u.prenomUtilisateur }} {{ u.nomUtilisateur }}</div><div class="db-user-email">{{ u.emailUtilisateur }}</div></div>
              </div>
            </td>
            <td><span class="db-role-badge rb-{{ rk }}">{{ roleLabels[rk] ?? rk }}</span></td>
            <td style="color:var(--text-sec);font-size:.78rem;">{{ u.dateInscriptionUtilisateur|date('d/m/Y') }}</td>
            <td><span class="db-status-dot {{ u.estActifUtilisateur ? 'dot-active' : 'dot-inactive' }}">{{ u.estActifUtilisateur ? 'Actif' : 'Inactif' }}</span></td>
          </tr>
        {% else %}
          <tr><td colspan="4" style="text-align:center;color:var(--text-sec);padding:24px">Aucun utilisateur</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

</div>{# /db-grid #}

{# ════════════════════════════════════════════════════════
   SECTION 2 — JOURNAL D'ACTIVITÉ
════════════════════════════════════════════════════════ #}
<div class="al-section">
  <div class="al-card">
    <div class="al-head">
      <div class="al-head-left">
        <div class="al-head-icon"><svg viewBox="0 0 24 24"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        <div>
          <div class="al-head-title">Journal d'activité <span class="al-live-dot" style="margin-left:6px;"></span></div>
          <div class="al-head-sub">{{ activityLogs|length }} action{{ activityLogs|length != 1 ? 's' : '' }} récente{{ activityLogs|length != 1 ? 's' : '' }}</div>
        </div>
      </div>
      <div class="al-filters">
        <button class="al-filter-btn active" data-filter="all"><span class="dot"></span> Tout</button>
        <button class="al-filter-btn" data-filter="backoffice">🛡️ Back-office</button>
        <button class="al-filter-btn" data-filter="frontoffice">🌿 Front-office</button>
        <button class="al-filter-btn" data-filter="user.login">🔑 Connexions</button>
        <button class="al-filter-btn" data-filter="user.register">✨ Inscriptions</button>
      </div>
    </div>
    <div class="al-timeline" id="alTimeline">
      {% if activityLogs is empty %}
        <div class="al-empty"><div class="al-empty-icon">📋</div><div class="al-empty-text">Aucune activité enregistrée.</div></div>
      {% else %}
        {% set currentDate = null %}
        {% set roleColors  = {'ROLE_PATIENT':'#7B5EA7','ROLE_PSYCHOLOGUE':'#00897B','ROLE_COACH':'#E65100','ROLE_ADMIN':'#1B4332','ROLE_USER':'#1565C0'} %}
        {% set roleSlugs   = {'ROLE_PATIENT':'patient','ROLE_PSYCHOLOGUE':'psychologue','ROLE_COACH':'coach','ROLE_ADMIN':'admin','ROLE_USER':'user'} %}
        {% set roleLabels  = {'ROLE_PATIENT':'Patient','ROLE_PSYCHOLOGUE':'Psychologue','ROLE_COACH':'Coach','ROLE_ADMIN':'Admin','ROLE_USER':'Utilisateur'} %}
        {% for log in activityLogs %}
          {% set logDate = log.createdAt|date('d/m/Y') %}
          {% if logDate != currentDate %}
            {% if currentDate is not null %}</div>{% endif %}
            {% set currentDate = logDate %}
            <div class="al-date-group" data-date="{{ logDate }}">
              <div class="al-date-label">
                {% if logDate == 'now'|date('d/m/Y') %}Aujourd'hui
                {% elseif logDate == '-1 day'|date('d/m/Y') %}Hier
                {% else %}{{ log.createdAt|date('d/m/Y') }}{% endif %}
              </div>
          {% endif %}
          {% set meta = log.iconMeta %}
          <div class="al-item" data-action="{{ log.action.value }}" data-context="{{ log.context }}" style="animation-delay:{{ loop.index0 * 0.045 }}s">
            <div class="al-rail"></div>
            <div class="al-avatar" style="background:{{ roleColors[log.userRole] ?? '#5A6475' }}">
              {% if log.userAvatar and log.userAvatar != 'default.png' %}<img src="{{ asset('avatars/' ~ log.userAvatar) }}" alt="av"/>
              {% else %}{{ log.userName ? (log.userName|split(' ')|first|first|upper ~ log.userName|split(' ')|last|first|upper) : '?' }}{% endif %}
              <div class="al-action-badge" style="background:{{ meta.bg }}">{{ meta.icon }}</div>
            </div>
            <div class="al-body">
              <div class="al-body-top">
                <span class="al-user-name">{{ log.userName ?? 'Utilisateur inconnu' }}</span>
                <span class="al-user-role al-role-{{ roleSlugs[log.userRole] ?? 'user' }}">{{ roleLabels[log.userRole] ?? 'Utilisateur' }}</span>
              </div>
              <div class="al-label">
                <span class="al-label-icon" style="background:{{ meta.bg }};color:{{ meta.color }}">{{ meta.icon }}</span>
                <span style="color:{{ meta.color }};font-weight:600;">{{ log.label }}</span>
              </div>
              {% if log.userEmail %}<div style="font-size:.69rem;color:var(--text-sec);margin-top:2px;opacity:.75;">{{ log.userEmail }}</div>{% endif %}
            </div>
            <div class="al-meta">
              <span class="al-time">{{ log.createdAt|date('H:i:s') }}</span>
              <span class="al-context-badge {{ log.context == 'backoffice' ? 'al-context-back' : 'al-context-front' }}">{{ log.context == 'backoffice' ? '🛡️ Back-office' : '🌿 Front-office' }}</span>
              {% if log.ip %}<span style="font-size:.62rem;color:var(--text-sec);opacity:.65;">{{ log.ip }}</span>{% endif %}
            </div>
          </div>
        {% endfor %}
        {% if currentDate is not null %}</div>{% endif %}
      {% endif %}
    </div>
    {% if activityLogs|length > 0 %}
    <div class="al-footer">
      <a href="{{ path('app_admin_activity_logs') }}" class="al-footer-link">Voir tout le journal <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7h8M7 3l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
    </div>
    {% endif %}
  </div>
</div>

{# ════════════════════════════════════════════════════════
   SECTION 3 — ÉVÉNEMENTS & PARTICIPATIONS
════════════════════════════════════════════════════════ #}
<div class="section-title">
  <div class="section-bar" style="background:linear-gradient(180deg,#4a8f3f,#7ed56f)"></div>
  <div><div class="section-title-text">Événements &amp; Participations</div><div class="section-title-sub">Statistiques et accès rapides aux CRUDs</div></div>
  <div class="section-title-line" style="background:linear-gradient(90deg,rgba(74,143,63,.15),transparent)"></div>
  <div class="section-title-actions">
    <a href="{{ path('evenement_index') }}" class="section-btn" style="color:#4a8f3f;background:#D8F3DC;">📅 Événements</a>
    <a href="{{ path('type_evenement_index') }}" class="section-btn" style="color:#1B4332;background:#D8F3DC;">🏷️ Types</a>
    <a href="{{ path('admin_participation_index') }}" class="section-btn" style="color:#3b82f6;background:#EFF6FF;">👥 Participations</a>
  </div>
</div>

<div class="kpi-grid kpi-grid-4">
  {% set eventKpis = [
    {label:'Total événements', value:stats.totalEvenements, icon:'📅', color:'#4a8f3f', bg:'#D8F3DC', delta:stats.totalTypes~' type(s)', link:path('evenement_index')},
    {label:'À venir',          value:stats.evenementsAVenir, icon:'⏳', color:'#3498db', bg:'#E3F2FD', delta:stats.evenementsEnCours~' en cours', link:path('evenement_index')},
    {label:'Gratuits',         value:stats.totalGratuits, icon:'🎁', color:'#27ae60', bg:'#D5F5E3', delta:stats.totalPayants~' payant(s)', link:path('evenement_index')},
    {label:'Capacité moy.',    value:stats.capaciteMoyenne, icon:'👥', color:'#e67e22', bg:'#FEF5E7', delta:stats.capaciteTotale~' total', link:path('admin_participation_index')},
  ] %}
  {% for k in eventKpis %}
    <a href="{{ k.link }}" class="kpi-card" style="animation-delay:{{ 0.05 * loop.index }}s">
      <div class="kpi-icon" style="background:{{ k.bg }}">{{ k.icon }}</div>
      <div class="kpi-val">{{ k.value }}</div>
      <div class="kpi-lbl">{{ k.label }}</div>
      <div class="kpi-delta" style="color:{{ k.color }}">{{ k.delta }}</div>
    </a>
  {% endfor %}
</div>

<div style="background:#fff;border-radius:16px;padding:14px 20px;box-shadow:var(--shadow-card);margin-bottom:24px;display:flex;flex-wrap:wrap;gap:10px;align-items:center">
  <span style="font-weight:600;color:var(--text-sec);">Statuts :</span>
  <span style="background:#3498db;color:#fff;padding:5px 13px;border-radius:99px;font-size:.75rem;font-weight:600;">⏳ À venir : {{ stats.evenementsAVenir }}</span>
  <span style="background:#27ae60;color:#fff;padding:5px 13px;border-radius:99px;font-size:.75rem;font-weight:600;">▶️ En cours : {{ stats.evenementsEnCours }}</span>
  <span style="background:#95a5a6;color:#fff;padding:5px 13px;border-radius:99px;font-size:.75rem;font-weight:600;">✅ Terminés : {{ stats.evenementsTermines }}</span>
  <span style="background:#e74c3c;color:#fff;padding:5px 13px;border-radius:99px;font-size:.75rem;font-weight:600;">🚫 Annulés : {{ stats.evenementsAnnules }}</span>
  <a href="{{ path('type_evenement_index') }}" style="margin-left:auto;font-size:.73rem;font-weight:600;color:#1B4332;text-decoration:none;background:#D8F3DC;padding:5px 12px;border-radius:8px">Gérer les types →</a>
</div>

<div class="charts-3">
  <div class="chart-box"><div class="chart-box-title">📊 Par catégorie</div><div class="chart-wrap chart-wrap-200"><canvas id="eventCategorieChart"></canvas></div></div>
  <div class="chart-box"><div class="chart-box-title">📍 Par modalité</div><div class="chart-wrap chart-wrap-200"><canvas id="eventModaliteChart"></canvas></div></div>
