    <div style="margin-top:10px;display:flex;gap:16px;font-size:.8rem">
      <span><span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:#8e44ad;margin-right:4px"></span>Actifs ({{ produitStatut.actif }})</span>
      <span><span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:#d1bfff;margin-right:4px"></span>Inactifs ({{ produitStatut.inactif }})</span>
    </div>
  </div>
  <div class="chart-box">
    <div class="chart-box-title">📈 Nouveaux produits / mois (12 mois)</div>
    <div class="chart-wrap chart-wrap-180"><canvas id="produitMoisChart"></canvas></div>
  </div>
</div>

<div class="charts-2" style="margin-bottom:28px;">
  <div class="chart-box">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
      <div style="font-weight:700;font-size:.9rem">🏆 Top 5 produits (prix)</div>
      <a href="{{ path('admin_produit_index') }}" style="font-size:.72rem;color:#8e44ad;font-weight:600;text-decoration:none">Voir tout →</a>
    </div>
    {% if top5Produits is empty %}
      <div style="text-align:center;padding:24px;color:var(--text-sec);font-size:.85rem">Aucun produit.</div>
    {% else %}
      {% for p in top5Produits %}
        <a href="{{ path('admin_produit_index') }}" style="display:flex;justify-content:space-between;align-items:center;padding:9px 0;border-bottom:1px solid var(--bg);text-decoration:none">
          <span style="font-size:.83rem;font-weight:600;color:var(--text)">{{ p.nom }}</span>
          <span style="background:#8e44ad;color:#fff;border-radius:99px;padding:3px 10px;font-size:.8rem;font-weight:700">{{ p.prix }} TND</span>
        </a>
      {% endfor %}
    {% endif %}
  </div>
  <div class="chart-box">
    <div style="font-weight:700;font-size:.9rem;margin-bottom:16px">📊 Santé du catalogue</div>
    {% set pct_actif   = totalProduits > 0 ? ((produitsActifs / totalProduits) * 100)|round : 0 %}
    {% set pct_rupture = totalProduits > 0 ? ((ruptureStock / totalProduits) * 100)|round : 0 %}
    {% set pct_num     = totalProduits > 0 ? ((produitsNumeriques / totalProduits) * 100)|round : 0 %}
    {% for item in [
      {label:'Produits actifs', val:produitsActifs~' / '~totalProduits, pct:pct_actif,   color:'#8e44ad'},
      {label:'En rupture',      val:ruptureStock,                        pct:pct_rupture, color:'#ef4444'},
      {label:'Numériques (∞)',  val:produitsNumeriques,                  pct:pct_num,     color:'#6366f1'},
    ] %}
    <div style="margin-bottom:14px">
      <div style="display:flex;justify-content:space-between;font-size:.8rem;margin-bottom:5px"><span>{{ item.label }}</span><strong style="color:{{ item.color }}">{{ item.val }}</strong></div>
      <div style="height:8px;background:#f3f4f6;border-radius:99px"><div style="width:{{ item.pct }}%;height:100%;border-radius:99px;background:{{ item.color }}"></div></div>
    </div>
    {% endfor %}
    <div style="background:#f8f5ff;border:1px solid #e0d0ff;border-radius:12px;padding:12px;margin-top:8px">
      <div style="display:grid;grid-template-columns:repeat(3,1fr);text-align:center;gap:8px">
        <div><div style="font-weight:800;font-size:1.1rem;color:#8e44ad">{{ prixMoyen }} TND</div><div style="font-size:.68rem;color:var(--text-sec)">Prix moyen</div></div>
        <div style="border-left:1px solid #e0d0ff"><div style="font-weight:800;font-size:1.1rem;color:#059669">{{ valeurStock }} TND</div><div style="font-size:.68rem;color:var(--text-sec)">Valeur stock</div></div>
        <div style="border-left:1px solid #e0d0ff"><div style="font-weight:800;font-size:1.1rem;color:#dc2626">{{ ruptureStock }}</div><div style="font-size:.68rem;color:var(--text-sec)">Ruptures</div></div>
      </div>
    </div>
  </div>
</div>

