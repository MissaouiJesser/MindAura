{% if prochainsEvenements is defined and prochainsEvenements|length > 0 %}
<div class="chart-box" style="margin-bottom:28px;">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
    <div style="font-weight:700;font-size:.9rem">🚀 Prochains événements</div>
    <a href="{{ path('evenement_index') }}" style="font-size:.72rem;color:#4a8f3f;text-decoration:none;font-weight:600">Voir tout →</a>
  </div>
  <div style="overflow-x:auto">
    <table style="width:100%;border-collapse:collapse">
      <thead><tr style="border-bottom:1px solid var(--border);text-align:left">
        <th style="padding:10px 8px;font-size:.72rem;color:var(--text-sec);font-weight:600">Titre</th>
        <th style="padding:10px 8px;font-size:.72rem;color:var(--text-sec);font-weight:600">Type</th>
        <th style="padding:10px 8px;font-size:.72rem;color:var(--text-sec);font-weight:600">Date début</th>
        <th style="padding:10px 8px;font-size:.72rem;color:var(--text-sec);font-weight:600">Lieu</th>
        <th style="padding:10px 8px;font-size:.72rem;color:var(--text-sec);font-weight:600">Capacité</th>
        <th style="padding:10px 8px;font-size:.72rem;color:var(--text-sec);font-weight:600">Tarif</th>
        <th style="padding:10px 8px;"></th>
      </tr></thead>
      <tbody>
        {% for e in prochainsEvenements %}
        <tr style="border-bottom:1px solid var(--border)">
          <td style="padding:10px 8px;font-size:.8rem;font-weight:500">{{ e.titreEvenement }}</td>
          <td style="padding:10px 8px;font-size:.75rem">{% if e.typeEvenement %}<span style="background:#f0f0f0;padding:3px 10px;border-radius:12px">{{ e.typeEvenement.libelle }}</span>{% else %}—{% endif %}</td>
          <td style="padding:10px 8px;font-size:.75rem;color:var(--text-sec)">{{ e.datedebutEvenemnt ? e.datedebutEvenemnt|date('d/m/Y') : '—' }}</td>
          <td style="padding:10px 8px;font-size:.75rem;color:var(--text-sec)">{{ e.lieuEvenement|default('—') }}</td>
          <td style="padding:10px 8px;font-size:.75rem">{{ e.capaciteEvenement|default('—') }}</td>
          <td style="padding:10px 8px">{% if e.typeEvenement %}<span style="padding:3px 10px;border-radius:12px;font-size:.7rem;font-weight:600;background:{{ e.typeEvenement.estGratuit ? '#D5F5E3' : '#FEF5E7' }};color:{{ e.typeEvenement.estGratuit ? '#27ae60' : '#e67e22' }}">{{ e.typeEvenement.estGratuit ? 'Gratuit' : 'Payant' }}</span>{% endif %}</td>
          <td style="padding:10px 8px"><a href="{{ path('evenement_show', {id: e.id}) }}" style="color:#4a8f3f;text-decoration:none;font-weight:600">Voir</a></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endif %}

