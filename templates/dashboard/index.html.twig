{% block javascripts %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
const CHART_LABELS = {{ stats.registrationsByDay|map(r => r['day'])|json_encode|raw }};
const CHART_TOTALS = {{ stats.registrationsByDay|map(r => r['total'])|json_encode|raw }};
const RECL_STATUS_LABELS = {{ stats.reclamationStatusLabels|json_encode|raw }};
const RECL_STATUS_DATA   = {{ stats.reclamationStatusCounts|json_encode|raw }};
const RECL_MONTH_LABELS  = {{ stats.reclamationMonthlyLabels|json_encode|raw }};
const RECL_MONTH_VALUES  = {{ stats.reclamationMonthlyValues|json_encode|raw }};
const RESP_TYPE_LABELS   = {{ stats.reponsesTypeLabels|json_encode|raw }};
const RESP_TYPE_COUNTS   = {{ stats.reponsesTypeCounts|json_encode|raw }};
const RESP_MONTH_LABELS  = {{ stats.reponsesMonthlyLabels|json_encode|raw }};
const RESP_MONTH_VALUES  = {{ stats.reponsesMonthlyValues|json_encode|raw }};
const OBJ_SRC_LABELS = ['Catalogue admin','Espace patient'];
const OBJ_SRC_DATA   = {{ [stats.objectifBySource['admin']|default(0), stats.objectifBySource['patient']|default(0)]|json_encode|raw }};
const OBJ_ST_LABELS  = ['Actifs','Inactifs'];
const OBJ_ST_DATA    = {{ [stats.objectifByStatut['actif']|default(0), stats.objectifByStatut['inactif']|default(0)]|json_encode|raw }};
const EVENT_CAT_LABELS  = {{ stats.parCategorieLabels|json_encode|raw }};
const EVENT_CAT_DATA    = {{ stats.parCategorieCounts|json_encode|raw }};
const EVENT_MOD_LABELS  = {{ stats.parModaliteLabels|json_encode|raw }};
const EVENT_MOD_DATA    = {{ stats.parModaliteCounts|json_encode|raw }};
const EVENT_MOIS_LABELS = {{ stats.parMoisLabels|json_encode|raw }};
const EVENT_MOIS_DATA   = {{ stats.parMoisValues|json_encode|raw }};
const RES_TYPE_LABELS = {{ ressourcesStats.byType|map(r => r.type is defined ? r.type : (r.contenu is defined ? r.contenu : 'Autre'))|json_encode|raw }};
const RES_TYPE_COUNTS = {{ ressourcesStats.byType|map(r => r.total)|json_encode|raw }};
const RES_CAT_LABELS  = {{ ressourcesStats.byCategorie|map(r => r.categorie ?? 'Autre')|json_encode|raw }};
const RES_CAT_COUNTS  = {{ ressourcesStats.byCategorie|map(r => r.total)|json_encode|raw }};
const RES_NIV_LABELS  = {{ ressourcesStats.byNiveau|map(r => r.niveau ?? 'Autre')|json_encode|raw }};
const RES_NIV_COUNTS  = {{ ressourcesStats.byNiveau|map(r => r.total)|json_encode|raw }};
const PRODUIT_PAR_MOIS = {{ produitParMois|json_encode|raw }};
const PRODUIT_PAR_MOIS_LABELS = Object.keys(PRODUIT_PAR_MOIS);
const PRODUIT_PAR_MOIS_VALUES = Object.values(PRODUIT_PAR_MOIS);
const EVENT_GREEN = ['#4a8f3f','#7ed56f','#2d5a27','#a8e6a0','#1a3d16'];
const RES_PALETTE = ['#1B4332','#52B788','#E65100','#7B5EA7','#0D47A1'];

/* ══ Courbe inscriptions ══ */
(function() {
  var canvas = document.getElementById('registrationsChart');
  if (!canvas || !CHART_LABELS.length) return;
  var ctx = canvas.getContext('2d');
  var labels = CHART_LABELS, values = CHART_TOTALS;
  var maxVal = Math.max.apply(null, values.concat([1]));
  var dpr = window.devicePixelRatio || 1;
  var padL=36,padR=16,padT=18,padB=36;
  function resize() { var W=canvas.offsetWidth,H=canvas.offsetHeight; if(!W||!H) return false; canvas.width=W*dpr; canvas.height=H*dpr; ctx.setTransform(dpr,0,0,dpr,0,0); return true; }
  function getW(){return canvas.offsetWidth;} function getH(){return canvas.offsetHeight;}
  function getX(i){return padL+(i/Math.max(values.length-1,1))*(getW()-padL-padR);}
  function getY(v){return padT+(1-v/maxVal)*(getH()-padT-padB);}
  function draw() {
    if (!resize()) return;
    var W=getW(),H=getH(),chartH=H-padT-padB,n=values.length;
    ctx.clearRect(0,0,W,H);
    ctx.save(); ctx.strokeStyle='rgba(213,220,230,.5)'; ctx.lineWidth=1; ctx.setLineDash([4,4]);
    for(var s=0;s<=4;s++){var yy=padT+(s/4)*chartH; ctx.beginPath(); ctx.moveTo(padL,yy); ctx.lineTo(W-padR,yy); ctx.stroke(); ctx.fillStyle='#5A6475'; ctx.font='9px Outfit,sans-serif'; ctx.textAlign='right'; ctx.fillText(Math.round(maxVal*(1-s/4)),padL-6,yy+3);}
    ctx.restore();
    var pts=values.map(function(v,i){return{x:getX(i),y:getY(v)};});
    if(pts.length>=2){
      var grad=ctx.createLinearGradient(0,padT,0,padT+chartH); grad.addColorStop(0,'rgba(82,183,136,.22)'); grad.addColorStop(1,'rgba(82,183,136,0)');
      ctx.beginPath(); ctx.moveTo(pts[0].x,padT+chartH); ctx.lineTo(pts[0].x,pts[0].y);
      for(var j=1;j<pts.length;j++){var cpx=(pts[j-1].x+pts[j].x)/2; ctx.bezierCurveTo(cpx,pts[j-1].y,cpx,pts[j].y,pts[j].x,pts[j].y);}
      ctx.lineTo(pts[pts.length-1].x,padT+chartH); ctx.closePath(); ctx.fillStyle=grad; ctx.fill();
      ctx.save(); ctx.strokeStyle='#52B788'; ctx.lineWidth=2.5; ctx.lineJoin='round'; ctx.lineCap='round'; ctx.setLineDash([]); ctx.shadowColor='rgba(82,183,136,.4)'; ctx.shadowBlur=8;
      ctx.beginPath(); ctx.moveTo(pts[0].x,pts[0].y);
      for(var k=1;k<pts.length;k++){var cpxL=(pts[k-1].x+pts[k].x)/2; ctx.bezierCurveTo(cpxL,pts[k-1].y,cpxL,pts[k].y,pts[k].x,pts[k].y);}
      ctx.stroke(); ctx.restore();
    }
    for(var d=0;d<pts.length;d++){ctx.beginPath(); ctx.arc(pts[d].x,pts[d].y,4,0,Math.PI*2); ctx.fillStyle='#fff'; ctx.strokeStyle='#52B788'; ctx.lineWidth=2; ctx.setLineDash([]); ctx.fill(); ctx.stroke();}
    ctx.fillStyle='#5A6475'; ctx.font='9px Outfit,sans-serif'; ctx.textAlign='center';
    for(var l=0;l<n;l++) ctx.fillText(labels[l],getX(l),H-6);
  }
  requestAnimationFrame(function(){requestAnimationFrame(draw);});
  var rt; window.addEventListener('resize',function(){clearTimeout(rt);rt=setTimeout(draw,100);});
  var tooltip=document.getElementById('chartTooltip');
  canvas.addEventListener('mousemove',function(e){
    if(!tooltip)return;
    var rect=canvas.getBoundingClientRect(),mx=e.clientX-rect.left,best=-1,bestDist=Infinity;
    for(var i=0;i<values.length;i++){var dist=Math.abs(mx-getX(i));if(dist<bestDist){bestDist=dist;best=i;}}
    if(best>=0&&bestDist<40){tooltip.textContent=labels[best]+' : '+values[best]+' inscription'+(values[best]>1?'s':''); tooltip.classList.add('visible'); tooltip.style.left=(getX(best)+8)+'px'; tooltip.style.top=(getY(values[best])-36)+'px';}
    else tooltip.classList.remove('visible');
  });
  canvas.addEventListener('mouseleave',function(){if(tooltip)tooltip.classList.remove('visible');});
})();

/* ══ Donut SVG rôles ══ */
(function(){
  var svg=document.getElementById('donutChart'); if(!svg)return;
  var cx=55,cy=55,r=40,sw=14,circ=2*Math.PI*r;
  var roles=[{val:DASH.countPatients,color:'#7B5EA7'},{val:DASH.countPsychos,color:'#00897B'},{val:DASH.countCoachs,color:'#E65100'},{val:DASH.countAdmins,color:'#1B4332'}];
  var total=DASH.totalUsers||1,offset=0;
  roles.forEach(function(role,idx){
    if(role.val<=0)return;
    var pct=role.val/total,dash=pct*circ,gap=circ-dash,rotDeg=-90+(offset/total)*360;
    var circle=document.createElementNS('http://www.w3.org/2000/svg','circle');
    circle.setAttribute('cx',cx);circle.setAttribute('cy',cy);circle.setAttribute('r',r);circle.setAttribute('fill','none');circle.setAttribute('stroke',role.color);circle.setAttribute('stroke-width',sw);circle.setAttribute('stroke-linecap','round');circle.setAttribute('stroke-dasharray',dash+' '+gap);circle.setAttribute('stroke-dashoffset',circ);circle.setAttribute('transform','rotate('+rotDeg+' '+cx+' '+cy+')');
    circle.style.transition='stroke-dashoffset 0.9s cubic-bezier(.22,1,.36,1) '+(0.3+idx*0.12)+'s';
    svg.insertBefore(circle,svg.querySelector('text'));
    requestAnimationFrame(function(){requestAnimationFrame(function(){circle.setAttribute('stroke-dashoffset',0);});});
    offset+=role.val;
  });
})();

/* ══ Anneau actifs ══ */
(function(){
  var total=DASH.totalUsers||1,pctA=DASH.countActifs/total,CIRC=2*Math.PI*45;
  var ringA=document.getElementById('ring-actifs'),pctEl=document.getElementById('ring-pct');
  if(!ringA)return;
  requestAnimationFrame(function(){requestAnimationFrame(function(){ringA.style.strokeDashoffset=CIRC*(1-pctA);});});
  if(pctEl)pctEl.textContent=Math.round(pctA*100)+'%';
})();

/* ══ Compteur animé ══ */
document.querySelectorAll('.db-kpi-val[data-target]').forEach(function(el){
  var target=parseInt(el.getAttribute('data-target'),10),dur=900,start=performance.now();
  function step(now){var elapsed=now-start,progress=Math.min(elapsed/dur,1),eased=1-Math.pow(1-progress,3); el.textContent=Math.round(eased*target); if(progress<1)requestAnimationFrame(step);}
  requestAnimationFrame(step);
});

/* ══ Journal filtres ══ */
(function(){
  var btns=document.querySelectorAll('.al-filter-btn'),timeline=document.getElementById('alTimeline');
  if(!timeline)return;
  btns.forEach(function(btn){
    btn.addEventListener('click',function(){
      btns.forEach(function(b){b.classList.remove('active');}); btn.classList.add('active');
      var filter=btn.getAttribute('data-filter')||'all';
      timeline.querySelectorAll('.al-item').forEach(function(item){
        var visible=filter==='all'||item.getAttribute('data-action')===filter||item.getAttribute('data-context')===filter;
        item.style.display=visible?'':'none';
      });
      timeline.querySelectorAll('.al-date-group').forEach(function(g){
        g.style.display=g.querySelectorAll('.al-item:not([style*="display: none"])').length===0?'none':'';
      });
    });
  });
})();

/* ══ Chart.js ══ */
document.addEventListener('DOMContentLoaded', function() {
  if (typeof Chart === 'undefined') { console.error('Chart.js not loaded'); return; }
  Chart.defaults.font.family = 'Outfit, sans-serif';
  Chart.defaults.color = '#5A6475';

  var DONUT = { responsive:true, maintainAspectRatio:false, cutout:'60%', plugins:{ legend:{ position:'bottom', labels:{ font:{size:11}, boxWidth:12, padding:12 } }, tooltip:{ backgroundColor:'#1A1A2E', titleColor:'#fff', bodyColor:'#E2E8F0', padding:10, cornerRadius:8 } } };
  var BAR_Y = { responsive:true, maintainAspectRatio:false, plugins:{ legend:{display:false} }, scales:{ x:{ beginAtZero:true, ticks:{stepSize:1,precision:0}, grid:{color:'rgba(213,220,230,.5)'} }, y:{ grid:{display:false} } } };
  function noData(c,m){ if(c)c.parentElement.innerHTML='<p style="text-align:center;color:var(--text-sec);font-size:.82rem;padding:32px 8px">'+(m||'Aucune donnée')+'</p>'; }
  function mkChart(id,cfg){ var el=document.getElementById(id); if(!el)return null; return new Chart(el,cfg); }

  /* Événements */
  if(EVENT_CAT_DATA.some(function(n){return n>0;})) mkChart('eventCategorieChart',{type:'doughnut',data:{labels:EVENT_CAT_LABELS,datasets:[{data:EVENT_CAT_DATA,backgroundColor:EVENT_GREEN,borderWidth:0}]},options:DONUT});
  else noData(document.getElementById('eventCategorieChart'));
  if(EVENT_MOD_DATA.some(function(n){return n>0;})) mkChart('eventModaliteChart',{type:'pie',data:{labels:EVENT_MOD_LABELS,datasets:[{data:EVENT_MOD_DATA,backgroundColor:EVENT_GREEN,borderWidth:0}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{font:{size:11},boxWidth:12,padding:12}}}}});
  else noData(document.getElementById('eventModaliteChart'));
  mkChart('eventMoisChart',{type:'bar',data:{labels:EVENT_MOIS_LABELS,datasets:[{label:'Événements',data:EVENT_MOIS_DATA,backgroundColor:'#4a8f3f',borderRadius:6}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{beginAtZero:true,ticks:{stepSize:1,precision:0}}}}});

  /* Produits */
  mkChart('produitStatutChart',{type:'doughnut',data:{labels:['Actifs','Inactifs'],datasets:[{data:[{{ produitStatut.actif }},{{ produitStatut.inactif }}],backgroundColor:['#8e44ad','#d1bfff'],borderWidth:2}]},options:Object.assign({},DONUT,{plugins:Object.assign({},DONUT.plugins,{legend:{display:false}})})});
  mkChart('produitMoisChart',{type:'line',data:{labels:PRODUIT_PAR_MOIS_LABELS,datasets:[{label:'Nouveaux produits',data:PRODUIT_PAR_MOIS_VALUES,borderColor:'#8e44ad',backgroundColor:'rgba(142,68,173,.12)',borderWidth:2,fill:true,tension:0.4,pointBackgroundColor:'#8e44ad',pointRadius:4}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{beginAtZero:true,ticks:{precision:0}}}}});

  /* Réclamations */
  if(RECL_STATUS_DATA.some(function(n){return n>0;})) mkChart('reclamationStatusChart',{type:'doughnut',data:{labels:RECL_STATUS_LABELS,datasets:[{data:RECL_STATUS_DATA,backgroundColor:['#F59E0B','#3B82F6','#22C55E','#EF4444'],borderWidth:0}]},options:DONUT});
  else noData(document.getElementById('reclamationStatusChart'),'Aucune réclamation.');
  mkChart('reclamationTrendChart',{type:'bar',data:{labels:RECL_MONTH_LABELS,datasets:[{label:'Réclamations',data:RECL_MONTH_VALUES,backgroundColor:'rgba(27,67,50,.25)',borderRadius:8,hoverBackgroundColor:'#1B4332'}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{grid:{display:false}},y:{beginAtZero:true,ticks:{stepSize:1,precision:0},grid:{color:'rgba(213,220,230,.5)'}}}}});

  /* Tests & Objectifs */
  mkChart('testTypeResponsesChart',{type:'bar',data:{labels:RESP_TYPE_LABELS,datasets:[{label:'Réponses',data:RESP_TYPE_COUNTS,backgroundColor:['#7B5EA7','#E11D48','#0D9488','#CA8A04','#64748B'],borderRadius:6}]},options:BAR_Y});
  if(OBJ_SRC_DATA[0]>0||OBJ_SRC_DATA[1]>0) mkChart('objectifSourceChart',{type:'doughnut',data:{labels:OBJ_SRC_LABELS,datasets:[{data:OBJ_SRC_DATA,backgroundColor:['#7B5EA7','#52B788'],borderWidth:0}]},options:DONUT});
  else noData(document.getElementById('objectifSourceChart'),'Aucun objectif.');
  if(OBJ_ST_DATA[0]>0||OBJ_ST_DATA[1]>0) mkChart('objectifStatutChart',{type:'doughnut',data:{labels:OBJ_ST_LABELS,datasets:[{data:OBJ_ST_DATA,backgroundColor:['#0D9488','#94A3B8'],borderWidth:0}]},options:DONUT});
  else noData(document.getElementById('objectifStatutChart'),'Aucun objectif.');
  (function(){ var el=document.getElementById('reponsesTrendChart'); if(!el)return; var c=el.getContext('2d'),g=c.createLinearGradient(0,0,0,220); g.addColorStop(0,'rgba(123,94,167,.35)'); g.addColorStop(1,'rgba(123,94,167,.02)'); new Chart(c,{type:'line',data:{labels:RESP_MONTH_LABELS,datasets:[{label:'Réponses',data:RESP_MONTH_VALUES,fill:true,backgroundColor:g,borderColor:'#7B5EA7',tension:0.35,pointRadius:4,pointBackgroundColor:'#7B5EA7'}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},sets:{x:{grid:{display:false}},y:{beginAtZero:true,ticks:{stepSize:1,precision:0},grid:{color:'rgba(213,220,230,.5)'}}}}}); })();

  /* Ressources */
  if(RES_TYPE_COUNTS.some(function(n){return n>0;})) mkChart('typeChart',{type:'doughnut',data:{labels:RES_TYPE_LABELS,datasets:[{data:RES_TYPE_COUNTS,backgroundColor:RES_PALETTE,borderWidth:0}]},options:DONUT});
  else noData(document.getElementById('typeChart'));
  if(RES_CAT_COUNTS.some(function(n){return n>0;})) mkChart('categorieChart',{type:'bar',data:{labels:RES_CAT_LABELS,datasets:[{data:RES_CAT_COUNTS,backgroundColor:'#1B4332',borderRadius:6}]},options:BAR_Y});
  else noData(document.getElementById('categorieChart'));
  if(RES_NIV_COUNTS.some(function(n){return n>0;})) mkChart('niveauChart',{type:'pie',data:{labels:RES_NIV_LABELS,datasets:[{data:RES_NIV_COUNTS,backgroundColor:RES_PALETTE,borderWidth:0}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{font:{size:11},boxWidth:12,padding:12}}}}});
  else noData(document.getElementById('niveauChart'));

  /* Barres de progression infra */
  document.querySelectorAll('.progress-fill[data-width]').forEach(function(el){
    var w=el.getAttribute('data-width')+'%'; el.style.width='0';
    requestAnimationFrame(function(){el.style.transition='width 1.2s cubic-bezier(.22,1,.36,1)'; el.style.width=w;});
  });
});
</script>
{% endblock %}