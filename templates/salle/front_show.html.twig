{# templates/salle/front_show.html.twig
   ─ FRONT OFFICE : Détail d'une salle de consultation
   ─ Route : salle_front_salles_show
#}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{{ salle.nomSalle }} — MindAura</title>
  <link rel="icon" type="image/png" href="{{ asset('images/logo.png') }}"/>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;1,400&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --g1: #1B4332; --g2: #2D6A4F; --g3: #52B788; --g-pale: #D8F3DC; --g-hover: #E8F5EE;
      --bg: #F0F4F8; --white: #FFFFFF;
      --text: #1A1A2E; --text-sec: #5A6475; --border: #D5DCE6;
      --radius-xl: 20px; --radius-lg: 14px; --radius-md: 10px;
      --ease: cubic-bezier(.22,1,.36,1);
      --shadow: 0 2px 12px rgba(27,67,50,.08), 0 0 0 1px rgba(213,220,230,.5);
    }
    html { scroll-behavior: smooth; }
    body { font-family: 'Outfit', sans-serif; background: var(--bg); color: var(--text); }

    .nav { position:sticky; top:0; z-index:999; background:rgba(255,255,255,.95); backdrop-filter:blur(20px); border-bottom:1px solid rgba(0,137,123,.1); padding:0 40px; height:66px; display:flex; align-items:center; gap:24px; }
    .nav-brand { display:flex; align-items:center; gap:10px; text-decoration:none; }
    .nav-logo  { width:36px; height:36px; border-radius:9px; background:var(--g1); display:grid; place-items:center; }
    .nav-logo span { font-size:1rem; }
    .nav-brand-name { font-family:'Playfair Display',serif; font-size:1.12rem; font-weight:700; color:var(--text); }
    .nav-links { flex:1; display:flex; gap:4px; }
    .nav-link  { padding:7px 16px; border-radius:99px; font-size:.87rem; font-weight:500; color:var(--text-sec); text-decoration:none; transition:all .2s; }
    .nav-link:hover, .nav-link.active { background:var(--g-pale); color:var(--g1); font-weight:700; }
    .nav-cta   { background:var(--g1); color:white; padding:8px 18px; border-radius:99px; font-size:.85rem; font-weight:600; text-decoration:none; transition:all .25s; }
    .nav-cta:hover { background:var(--g2); transform:translateY(-1px); }

    .hero-img { width:100%; height:400px; position:relative; overflow:hidden; background:linear-gradient(135deg,var(--g-pale),#B2DFDB); display:flex; align-items:center; justify-content:center; }
    .hero-img img { width:100%; height:100%; object-fit:cover; }
    .hero-img-icon { font-size:5rem; opacity:.3; }
    .hero-overlay { position:absolute; bottom:0; left:0; right:0; background:linear-gradient(to top, rgba(27,67,50,.85) 0%, transparent 100%); padding:40px 60px 32px; }
    .hero-breadcrumb { display:flex; gap:8px; font-size:.8rem; color:rgba(255,255,255,.65); margin-bottom:10px; }
    .hero-breadcrumb a { color:rgba(255,255,255,.75); text-decoration:none; }
    .hero-breadcrumb a:hover { color:white; }
    .hero-title { font-family:'Playfair Display',serif; font-size:2.6rem; color:white; line-height:1.15; }
    .hero-badge { display:inline-flex; align-items:center; gap:6px; padding:6px 14px; border-radius:99px; font-size:.78rem; font-weight:700; margin-top:12px; }
    .badge-ok { background:rgba(46,125,50,.9); color:white; }
    .badge-no { background:rgba(211,47,47,.85); color:white; }
    .dot { width:6px; height:6px; border-radius:50%; background:currentColor; animation:pulse 1.8s infinite; }
    @keyframes pulse { 0%,100%{opacity:1}50%{opacity:.4} }

    .wrapper { max-width:1100px; margin:0 auto; padding:48px 40px 80px; display:grid; grid-template-columns:1fr 340px; gap:32px; }
    @media(max-width:860px) { .wrapper { grid-template-columns:1fr; } }

    .content-card { background:var(--white); border-radius:var(--radius-xl); box-shadow:var(--shadow); padding:36px; margin-bottom:24px; }
    .section-title { font-family:'Playfair Display',serif; font-size:1.3rem; color:var(--teal); margin-bottom:18px; padding-bottom:12px; border-bottom:2px solid var(--teal-pale); display:flex; align-items:center; gap:10px; }
    .desc-text { line-height:1.85; color:var(--text-sec); font-size:.95rem; }

    .info-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:28px; }
    .info-item { background:var(--bg); border-radius:var(--radius-md); padding:16px; display:flex; align-items:center; gap:12px; }
    .info-icon { width:40px; height:40px; border-radius:10px; background:var(--g-pale); display:grid; place-items:center; flex-shrink:0; }
    .info-icon svg { width:18px; height:18px; stroke:var(--teal); fill:none; stroke-width:1.8; }
    .info-label { font-size:.75rem; color:var(--text-sec); font-weight:600; margin-bottom:2px; }
    .info-value { font-size:.95rem; font-weight:700; color:var(--text); }

    .features { display:grid; grid-template-columns:repeat(auto-fit, minmax(140px, 1fr)); gap:12px; }
    .feature { background:var(--teal-pale); border-radius:var(--radius-md); padding:14px 16px; text-align:center; color:var(--teal-dark); font-weight:600; font-size:.87rem; }

    .sidebar { display:flex; flex-direction:column; gap:20px; }
    .sticky-card { background:var(--white); border-radius:var(--radius-xl); box-shadow:var(--shadow); padding:28px; position:sticky; top:86px; }
    .sticky-title { font-family:'Playfair Display',serif; font-size:1.22rem; color:var(--text); margin-bottom:20px; }
    .contact-item { display:flex; gap:12px; margin-bottom:16px; align-items:flex-start; }
    .contact-ico { width:36px; height:36px; border-radius:9px; background:var(--teal-pale); display:grid; place-items:center; flex-shrink:0; }
    .contact-ico svg { width:16px; height:16px; stroke:var(--teal); fill:none; stroke-width:1.8; }
    .contact-label { font-size:.75rem; color:var(--text-sec); font-weight:600; }
    .contact-val   { font-size:.9rem; font-weight:600; color:var(--text); margin-top:2px; }

    .btn-reserve-big { display:block; width:100%; text-align:center; background:var(--g1); color:white; padding:14px 20px; border-radius:var(--radius-md); font-weight:700; font-size:1rem; text-decoration:none; transition:all .25s var(--ease); margin-top:22px; }
    .btn-reserve-big:hover { background:var(--g2); transform:translateY(-2px); box-shadow:0 8px 24px rgba(27,67,50,.3); }
    .btn-back { display:inline-flex; align-items:center; justify-content:center; gap:7px; color:var(--g1); font-weight:600; font-size:.88rem; padding:8px 14px; border:2px solid var(--g-pale); border-radius:var(--radius-md); text-decoration:none; transition:all .2s; width:100%; margin-top:12px; }
    .btn-back:hover { background:var(--g-pale); }

    .local-card { display:flex; align-items:center; gap:14px; text-decoration:none; color:var(--text); background:var(--bg); border-radius:var(--radius-md); padding:14px; margin-top:16px; transition:all .2s; }
    .local-card:hover { background:var(--teal-pale); }
    .local-icon { font-size:1.6rem; }
    .local-name  { font-weight:700; font-size:.92rem; }
    .local-addr  { font-size:.78rem; color:var(--text-sec); margin-top:2px; }

    footer { background:#004D40; color:rgba(255,255,255,.7); text-align:center; padding:28px; font-size:.85rem; }
    footer a { color:#80CBC4; text-decoration:none; }
  </style>
</head>
<body>

<nav class="nav">
  <a href="{{ path('app_home') }}" class="nav-brand">
    <div class="nav-logo"><span>🧠</span></div>
    <span class="nav-brand-name">MindAura</span>
  </a>
  <div class="nav-links">
    <a href="{{ path('app_home') }}" class="nav-link">Accueil</a>
    <a href="{{ path('locaux_psychiatrie_front_locaux_index') }}" class="nav-link">Locaux</a>
    <a href="{{ path('salle_front_salles_index') }}" class="nav-link active">Salles</a>
  </div>
  {% if salle.disponibiliteSalle|lower != 'indisponible' %}
    <a href="{{ path('reservation_local_front_new', {salle: salle.idSalle}) }}" class="nav-cta">+ Réserver</a>
  {% endif %}
</nav>

<div class="hero-img">
  {% if salle.imageURL %}
    <img src="{{ asset('uploads/salles/' ~ salle.imageURL) }}" alt="{{ salle.nomSalle }}">
  {% else %}
    <span class="hero-img-icon">🚪</span>
  {% endif %}
  <div class="hero-overlay">
    <div class="hero-breadcrumb">
      <a href="{{ path('app_home') }}">Accueil</a> ›
      <a href="{{ path('salle_front_salles_index') }}">Salles</a> ›
      <span>{{ salle.nomSalle }}</span>
    </div>
    <h1 class="hero-title">{{ salle.nomSalle }}</h1>
    {% if salle.disponibiliteSalle|lower == 'indisponible' %}
      <div class="hero-badge badge-no"><span class="dot"></span> Indisponible</div>
    {% else %}
      <div class="hero-badge badge-ok"><span class="dot"></span> Disponible</div>
    {% endif %}
  </div>
</div>

<div class="wrapper">
  <div>
    {% if salle.equipements %}
      <div class="content-card">
        <div class="section-title"><span>📖</span> À propos de cette salle</div>
        <p class="desc-text">{{ salle.equipements }}</p>
      </div>
    {% endif %}

    <div class="content-card">
      <div class="section-title"><span>ℹ️</span> Informations</div>
      <div class="info-grid">
        {% if salle.typeSalle %}
          <div class="info-item">
            <div class="info-icon"><svg viewBox="0 0 20 20"><path d="M3 17V5a2 2 0 012-2h10a2 2 0 012 2v12" stroke-linecap="round" stroke-linejoin="round"/><path d="M7 17v-5h6v5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
            <div><div class="info-label">Type de salle</div><div class="info-value">{{ salle.typeSalle }}</div></div>
          </div>
        {% endif %}
        {% if salle.capaciteSalle %}
          <div class="info-item">
            <div class="info-icon"><svg viewBox="0 0 20 20"><circle cx="10" cy="7" r="3.5"/><path d="M3 18c0-3.9 3.1-7 7-7s7 3.1 7 7" stroke-linecap="round"/></svg></div>
            <div><div class="info-label">Capacité</div><div class="info-value">{{ salle.capaciteSalle }} personnes</div></div>
          </div>
        {% endif %}
        <div class="info-item">
          <div class="info-icon"><svg viewBox="0 0 20 20"><rect x="3" y="4" width="14" height="13" rx="2"/><path d="M3 8h14M7 2v4M13 2v4" stroke-linecap="round"/></svg></div>
          <div><div class="info-label">Disponibilité</div><div class="info-value">Lun–Ven 8h–18h</div></div>
        </div>
        <div class="info-item">
          <div class="info-icon"><svg viewBox="0 0 20 20"><path d="M10 2L3 6v5c0 4 3.1 7.7 7 9 3.9-1.3 7-5 7-9V6L10 2z" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
          <div><div class="info-label">Sécurité</div><div class="info-value">Niveau élevé</div></div>
        </div>
      </div>

      <div class="section-title" style="margin-top:8px"><span>✨</span> Équipements</div>
      <div class="features">
        <div class="feature">💺 Sièges ergonomiques</div>
        <div class="feature">📶 WiFi haut débit</div>
        <div class="feature">🌡️ Climatisation</div>
        <div class="feature">🔒 Confidentialité</div>
        <div class="feature">💧 Eau fraîche</div>
        <div class="feature">📋 Tableau blanc</div>
      </div>
    </div>

    {% if salle.local is defined and salle.local %}
      <div class="content-card">
        <div class="section-title"><span>🏥</span> Local rattaché</div>
        <a href="{{ path('locaux_psychiatrie_front_locaux_show', {id: salle.local.idLocal}) }}" class="local-card">
          <div class="local-icon">🏥</div>
          <div>
            <div class="local-name">{{ salle.local.nomLocal }}</div>
            {% if salle.local.adresseLocal is defined and salle.local.adresseLocal %}<div class="local-addr">📍 {{ salle.local.adresseLocal }}</div>{% endif %}
          </div>
          <svg style="margin-left:auto;width:16px;height:16px" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    {% endif %}
  </div>

  <div class="sidebar">
    <div class="sticky-card">
      <div class="sticky-title">📅 Réserver cette salle</div>
      <div class="contact-item">
        <div class="contact-ico"><svg viewBox="0 0 20 20"><circle cx="10" cy="7" r="3.5"/><path d="M3 18c0-3.9 3.1-7 7-7s7 3.1 7 7" stroke-linecap="round"/></svg></div>
        <div><div class="contact-label">Capacité</div><div class="contact-val">{{ salle.capaciteSalle|default('—') }} personnes max.</div></div>
      </div>
      <div class="contact-item">
        <div class="contact-ico"><svg viewBox="0 0 20 20"><path d="M3 17V5a2 2 0 012-2h10a2 2 0 012 2v12" stroke-linecap="round"/><path d="M7 17v-5h6v5" stroke-linecap="round"/></svg></div>
        <div><div class="contact-label">Type</div><div class="contact-val">{{ salle.typeSalle|default('Consultation') }}</div></div>
      </div>
      <div class="contact-item">
        <div class="contact-ico"><svg viewBox="0 0 20 20"><rect x="3" y="4" width="14" height="13" rx="2"/><path d="M3 8h14M7 2v4M13 2v4" stroke-linecap="round"/></svg></div>
        <div><div class="contact-label">Horaires</div><div class="contact-val">Lun–Ven · 8h00–18h00</div></div>
      </div>

      {% if salle.disponibiliteSalle|lower != 'indisponible' %}
        <a href="{{ path('reservation_local_front_new', {salle: salle.idSalle}) }}" class="btn-reserve-big">📅 Réserver maintenant</a>
      {% else %}
        <div style="text-align:center;padding:14px;background:var(--bg);border-radius:var(--radius-md);color:var(--text-sec);font-size:.88rem;margin-top:18px;">
          Cette salle est actuellement indisponible.
        </div>
      {% endif %}

      <a href="{{ path('salle_front_salles_index') }}" class="btn-back">← Retour aux salles</a>
    </div>
  </div>
</div>

<footer>
  <p>&copy; 2026 MindAura — <a href="{{ path('app_home') }}">Accueil</a> · <a href="{{ path('salle_front_salles_index') }}">Salles</a></p>
</footer>
</body>
</html>
