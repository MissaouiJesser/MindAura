                                                   -fx-background-radius: 12; -fx-padding: 14 20;
                                                   -fx-cursor: hand; -fx-font-size: 13px;"/>
                                </HBox>
                            </VBox>
                            <HBox fx:id="urlArticleFeedbackBox" spacing="12" alignment="CENTER_LEFT"
                                  visible="false" managed="false"
                                  style="-fx-background-color: #F0FDF4; -fx-background-radius: 12;
                                         -fx-border-color: #86EFAC; -fx-border-radius: 12;
                                         -fx-border-width: 1; -fx-padding: 14 20;">
                                <Label fx:id="urlArticleFeedbackIcon" text="" style="-fx-font-size: 20px;"/>
                                <VBox spacing="3">
