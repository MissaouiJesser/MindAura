                <!-- ===== BOUTONS ===== -->
                <HBox spacing="18" alignment="CENTER" style="-fx-padding: 8 0 15 0;">
                    <Button fx:id="annulerBtn" text="← Annuler" onAction="#annuler" prefWidth="200"
                            style="-fx-background-color: white; -fx-text-fill: #5A7A6A;
                                   -fx-border-color: #C8DFCF; -fx-border-width: 2;
                                   -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 16 35;
                                   -fx-background-radius: 50; -fx-border-radius: 50; -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0, 0, 3);">
