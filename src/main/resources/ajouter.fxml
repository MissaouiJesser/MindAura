                                          -fx-padding: 12 14; -fx-font-size: 16px;"/>
                            <TextField fx:id="Emailtx" promptText="auteur@exemple.com"
                                       HBox.hgrow="ALWAYS"
                                       style="-fx-background-color: #FAFCFB; -fx-border-color: #D0E8D8;
                                              -fx-border-width: 1.8; -fx-border-radius: 12; -fx-background-radius: 12;
                                              -fx-padding: 14 18; -fx-font-size: 14px; -fx-text-fill: #1A2E25;
                                              -fx-prompt-text-fill: #B0BDB5;">
                                <font><Font size="14"/></font>
                            </TextField>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- ===== RÉSUMÉ ===== -->
                <VBox spacing="12"
                      style="-fx-background-color: linear-gradient(to right, #0F2D1F, #1B4332);
