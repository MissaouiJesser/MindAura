                                </HBox>
                                <Label text="Collez ici le lien vers l'article en ligne"
                                       style="-fx-text-fill: #9AA89F; -fx-font-size: 11.5px;"/>
                                <HBox spacing="10" alignment="CENTER_LEFT">
