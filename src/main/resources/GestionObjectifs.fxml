<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@style22.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.GestionObjectifsController">

    <center>
        <BorderPane>

            <!-- Header -->
            <top>
                <HBox alignment="CENTER_LEFT" spacing="20"
                      style="-fx-padding: 20 30 20 30; -fx-background-color: white;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                    <Label style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
            </top>

            <!-- Content -->
            <center>
                <VBox spacing="20" style="-fx-padding: 25; -fx-background-color: #F0F4F8;">

                    <!-- Barre d'outils -->
                    <HBox spacing="15" alignment="CENTER_LEFT"
                          style="-fx-padding: 15; -fx-background-color: white;
                                 -fx-background-radius: 10;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);">

                        <!-- ✅ Seul "Nouvel Objectif" reste ici ; Modifier/Supprimer sont dans chaque cellule -->
                        <Button text="+ Nouvel Objectif" onAction="#ajouterObjectif" styleClass="btn-success"/>

                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="🔄 Actualiser" onAction="#actualiser" styleClass="btn-neutral"/>
                    </HBox>

                    <!-- ListView -->
                    <ListView fx:id="listViewObjectifs" VBox.vgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 10;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);"/>

                    <!-- Pagination -->
                    <HBox fx:id="paginationContainer" alignment="CENTER"
                          style="-fx-padding: 8 0 0 0;"/>

                </VBox>
            </center>
        </BorderPane>
    </center>

</BorderPane>
