<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<!-- ═════════════════════════════════════════════════════════════════════════════
     REFACTORED: AfficherLocal.fxml - NO SIDEBAR (Managed by Dashboard.fxml)
     
     This file contains ONLY the central content area.
     Navigation is handled by Dashboard.fxml's shared sidebar.
     
     Architecture:
     • VBox (root) - stretches to fill contentArea
     • StackPane - swaps between list view and form view
     • No duplicate navigation buttons
     • No duplicate logo/branding
     ════════════════════════════════════════════════════════════════════════════ -->

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.AfficherLocalController"
      stylesheets="@style.css"
      style="-fx-background-color: #F0F4F8;"
      spacing="0">

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- ZONE DE CONTENU DYNAMIQUE (Swap list/form views)                      -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->

    <StackPane VBox.vgrow="ALWAYS">

        <!-- ───────────────────────────── VUE LISTE (défaut visible) ──────── -->
        <VBox fx:id="vueListe" spacing="0" style="-fx-background-color: #F0F4F8;">

            <!-- Header -->
            <HBox spacing="15" alignment="CENTER_LEFT"
                  style="-fx-padding: 20px 30px; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 2);">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                </VBox>
                <HBox spacing="0" alignment="CENTER_LEFT"
                      style="-fx-background-color: #F8FAFC; -fx-border-color: #D8E9E4; -fx-border-width: 1.5px; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 0 15px; -fx-pref-width: 280px; -fx-pref-height: 40px;">
                    <Label text="🔍 " style="-fx-text-fill: #9CA3AF; -fx-font-size: 14px;"/>
                    <TextField fx:id="searchField" promptText="Rechercher un local..."
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 12px; -fx-prompt-text-fill: #9CA3AF; -fx-text-fill: #1A1A2E;"/>
                </HBox>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <VBox spacing="5">
                        <Label text="Type" style="-fx-text-fill: #5A6475; -fx-font-weight: bold; -fx-font-size: 9px; -fx-font-family: 'Inter';"/>
                        <ComboBox fx:id="filterTypeComboBox" prefWidth="140"
                                  style="-fx-font-size: 11px; -fx-background-color: white; -fx-border-color: #D8E9E4; -fx-border-width: 1.5px; -fx-border-radius: 10px; -fx-background-radius: 10px;"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Ville" style="-fx-text-fill: #5A6475; -fx-font-weight: bold; -fx-font-size: 9px; -fx-font-family: 'Inter';"/>
                        <ComboBox fx:id="filterVilleComboBox" prefWidth="120"
                                  style="-fx-font-size: 11px; -fx-background-color: white; -fx-border-color: #D8E9E4; -fx-border-width: 1.5px; -fx-border-radius: 10px; -fx-background-radius: 10px;"/>
                    </VBox>
                </HBox>
                <HBox spacing="10">
                    <Button fx:id="btnRafraichir" text="🔄" onAction="#handleRafraichir"
                            style="-fx-font-size: 15px; -fx-padding: 10px 14px; -fx-background-color: white; -fx-border-color: #D8E9E4; -fx-border-width: 1.5px; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-cursor: hand;"/>
                    <!-- QR Code Button -->
                    <StackPane>
                        <Button fx:id="btnQRCode" onAction="#handleQRCode"
                                style="-fx-background-color: linear-gradient(to bottom right, #FF8C00, #E65C00);
                                       -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: 800;
                                       -fx-background-radius: 10px; -fx-cursor: hand;
                                       -fx-padding: 10px 18px;
                                       -fx-border-color: rgba(255,255,255,0.25); -fx-border-width: 1.5px;
                                       -fx-border-radius: 10px;
                                       -fx-effect: dropshadow(gaussian, rgba(230,92,0,0.55), 14, 0, 0, 4);">
                            <graphic>
                                <HBox spacing="7" alignment="CENTER">
                                    <StackPane style="-fx-background-color: rgba(255,255,255,0.22);
                                                      -fx-background-radius: 6px;
                                                      -fx-pref-width: 26px; -fx-pref-height: 26px;">
                                        <Label text="▦" style="-fx-font-size: 14px; -fx-text-fill: white; -fx-font-weight: 900;"/>
                                    </StackPane>
                                    <VBox spacing="1" alignment="CENTER_LEFT">
                                        <Label text="QR Code" style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: 800;"/>
                                        <Label text="Locaux dispo" style="-fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 8px; -fx-font-weight: 600;"/>
                                    </VBox>
                                </HBox>
                            </graphic>
                        </Button>
                    </StackPane>
                    <Button fx:id="btnAjouter" text="➕ Nouveau Local" onAction="#handleAjouterLocal"
                            style="-fx-font-size: 12px; -fx-padding: 10px 18px; -fx-background-color: linear-gradient(to right, #1B4332, #2D6A4F); -fx-text-fill: white; -fx-font-weight: 700; -fx-background-radius: 10px; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(27,67,50,0.3), 12, 0, 0, 3);"/>
                    <ComboBox fx:id="comboLangue" prefWidth="145"
                              style="-fx-background-color: white; -fx-border-color: #D8E9E4; -fx-border-width: 1.5px; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-font-size: 11px; -fx-cursor: hand;"/>
                </HBox>
            </HBox>

            <!-- KPI Cards -->
            <VBox spacing="20" VBox.vgrow="ALWAYS" style="-fx-padding: 25px 30px;">
                <HBox spacing="15">
                    <VBox spacing="12" HBox.hgrow="ALWAYS" style="-fx-padding: 20px; -fx-background-color: white; -fx-background-radius: 16px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <StackPane style="-fx-pref-width: 52px; -fx-pref-height: 52px; -fx-background-color: linear-gradient(to bottom right, rgba(255,140,0,0.15), rgba(255,107,53,0.1)); -fx-background-radius: 12px;">
                                <Label text="🏥" style="-fx-font-size: 26px;"/>
                            </StackPane>
                            <VBox spacing="4">
                                <Label fx:id="totalLocauxLabel" text="0" style="-fx-font-size: 24px; -fx-text-fill: #1A1A2E; -fx-font-weight: 900;"/>
                                <Label text="Locaux Enregistrés" style="-fx-font-size: 11px; -fx-text-fill: #5A6475; -fx-font-weight: 600;"/>
                            </VBox>
                        </HBox>
                    </VBox>
                    <VBox spacing="12" HBox.hgrow="ALWAYS" style="-fx-padding: 20px; -fx-background-color: white; -fx-background-radius: 16px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <StackPane style="-fx-pref-width: 52px; -fx-pref-height: 52px; -fx-background-color: rgba(45,106,79,0.15); -fx-background-radius: 12px;">
                                <Label text="✓" style="-fx-font-size: 26px; -fx-text-fill: #2D6A4F;"/>
                            </StackPane>
                            <VBox spacing="4">
                                <Label fx:id="totalDisponiblesLabel" text="0" style="-fx-font-size: 24px; -fx-text-fill: #1A1A2E; -fx-font-weight: 900;"/>
                                <Label text="Disponibles" style="-fx-font-size: 11px; -fx-text-fill: #5A6475; -fx-font-weight: 600;"/>
                            </VBox>
                        </HBox>
                    </VBox>
                    <VBox spacing="12" HBox.hgrow="ALWAYS" style="-fx-padding: 20px; -fx-background-color: white; -fx-background-radius: 16px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <StackPane style="-fx-pref-width: 52px; -fx-pref-height: 52px; -fx-background-color: linear-gradient(to bottom right, rgba(255,140,0,0.15), rgba(255,107,53,0.1)); -fx-background-radius: 12px;">
                                <Label text="📅" style="-fx-font-size: 26px;"/>
                            </StackPane>
                            <VBox spacing="4">
                                <Label fx:id="totalReservationsLabel" text="0" style="-fx-font-size: 24px; -fx-text-fill: #1A1A2E; -fx-font-weight: 900;"/>
                                <Label text="Réservations" style="-fx-font-size: 11px; -fx-text-fill: #5A6475; -fx-font-weight: 600;"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Table -->
                <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 16px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
                    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 18px 22px; -fx-border-color: #F0F4F8; -fx-border-width: 0 0 2 0;">
                        <StackPane style="-fx-background-color: rgba(255,140,0,0.1); -fx-background-radius: 10px; -fx-pref-width: 40px; -fx-pref-height: 40px;">
                            <Label text="📋" style="-fx-font-size: 20px;"/>
                        </StackPane>
                        <Label text="Liste des Locaux Psychiatriques" style="-fx-font-size: 15px; -fx-text-fill: #1A1A2E; -fx-font-weight: 700;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Mise à jour: Aujourd'hui" style="-fx-text-fill: #5A6475; -fx-font-size: 10px; -fx-font-weight: 500;"/>
                    </HBox>
                    <TableView fx:id="tableLocal" VBox.vgrow="ALWAYS" styleClass="modern-table">
                        <columns>
                            <TableColumn fx:id="colImageURL"      text="Image"           prefWidth="90"/>
                            <TableColumn fx:id="colNom"           text="Nom du Local"   prefWidth="140"/>
                            <TableColumn fx:id="colAdresse"       text="Adresse"         prefWidth="155"/>
                            <TableColumn fx:id="colVille"         text="Ville"           prefWidth="95"/>
                            <TableColumn fx:id="colType"          text="Type"            prefWidth="140"/>
                            <TableColumn fx:id="colTelephone"     text="Téléphone"       prefWidth="80"/>
                            <TableColumn fx:id="colEmail"         text="Email"           prefWidth="140"/>
                            <TableColumn fx:id="colCapacite"      text="Capacité"        prefWidth="70"/>
                            <TableColumn fx:id="colDisponibilite" text="Disponibilité"   prefWidth="100"/>
                            <TableColumn fx:id="colActions"       text="Actions"         prefWidth="200"/>
                        </columns>
                    </TableView>
                    <HBox alignment="CENTER" spacing="10"
                          style="-fx-padding: 12px 22px; -fx-border-color: #F0F4F8; -fx-border-width: 2 0 0 0; -fx-background-color: #FAFBFC; -fx-background-radius: 0 0 16px 16px;">
                        <Label fx:id="paginationInfoLabel" text="Page 1 / 1  •  0 locaux"
                               style="-fx-text-fill: #5A6475; -fx-font-size: 11px; -fx-font-family: 'Inter';"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnPremierePage"   text="⟨⟨" onAction="#handlePremierePage"   style="-fx-font-size: 12px; -fx-padding: 7px 12px; -fx-background-color: white; -fx-border-color: #D8E9E4; -fx-border-width: 1.5px; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-cursor: hand; -fx-text-fill: #1B4332; -fx-font-weight: 700;"/>
                        <Button fx:id="btnPagePrecedente" text="‹ Précédent" onAction="#handlePagePrecedente" style="-fx-font-size: 12px; -fx-padding: 7px 14px; -fx-background-color: white; -fx-border-color: #D8E9E4; -fx-border-width: 1.5px; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-cursor: hand; -fx-text-fill: #1B4332; -fx-font-weight: 600;"/>
                        <Label fx:id="currentPageLabel" text="1"
                               style="-fx-background-color: #1B4332; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 700; -fx-padding: 7px 14px; -fx-background-radius: 8px; -fx-min-width: 36px; -fx-alignment: CENTER;"/>
                        <Button fx:id="btnPageSuivante"  text="Suivant ›" onAction="#handlePageSuivante"  style="-fx-font-size: 12px; -fx-padding: 7px 14px; -fx-background-color: white; -fx-border-color: #D8E9E4; -fx-border-width: 1.5px; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-cursor: hand; -fx-text-fill: #1B4332; -fx-font-weight: 600;"/>
                        <Button fx:id="btnDernierePage"  text="⟩⟩" onAction="#handleDernierePage"  style="-fx-font-size: 12px; -fx-padding: 7px 12px; -fx-background-color: white; -fx-border-color: #D8E9E4; -fx-border-width: 1.5px; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-cursor: hand; -fx-text-fill: #1B4332; -fx-font-weight: 700;"/>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>

        <!-- ───────────────────────── VUE FORMULAIRE (caché par défaut) ──── -->
        <VBox fx:id="vueFormulaire" spacing="0"
              visible="false" managed="false"
              style="-fx-background-color: #F0F4F8;">

            <!-- Header formulaire -->
            <HBox spacing="15" alignment="CENTER_LEFT"
                  style="-fx-padding: 18px 30px; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 2);">
                <Button text="← Retour" onAction="#handleRetourListe"
                        style="-fx-background-color: transparent; -fx-border-color: #D8E9E4; -fx-border-width: 1.5px; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-text-fill: #5A6475; -fx-font-size: 12px; -fx-font-weight: 600; -fx-padding: 8px 18px; -fx-cursor: hand;"/>
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label fx:id="lblTitreFormulaire" text="➕ Nouveau Local"
                           style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #1A1A2E; -fx-font-family: 'Poppins';"/>
                    <Label fx:id="lblSousTitreFormulaire" text="Remplissez les informations du local psychiatrique"
                           style="-fx-font-size: 11px; -fx-text-fill: #5A6475; -fx-font-family: 'Inter';"/>
                </VBox>
                <Button text="✖ Annuler" onAction="#handleRetourListe"
                        style="-fx-background-color: transparent; -fx-border-color: #B91C1C; -fx-border-width: 1.5px; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-text-fill: #B91C1C; -fx-font-size: 12px; -fx-font-weight: 600; -fx-padding: 8px 18px; -fx-cursor: hand;"/>
            </HBox>

            <!-- Corps scrollable -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox spacing="20" style="-fx-padding: 25px 30px;">

                    <!-- Infos de base -->
                    <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 16px; -fx-padding: 25px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 15, 0, 0, 3);">
                        <Label text="📋 Informations de Base" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1A1A2E;"/>
                        <Separator style="-fx-background-color: #D8E9E4;"/>
                        <GridPane hgap="20" vgap="15">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50"/>
                                <ColumnConstraints percentWidth="50"/>
                            </columnConstraints>
                            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Nom du Local *" style="-fx-font-weight: bold; -fx-text-fill: #1A1A2E; -fx-font-size: 12px;"/>
                                <TextField fx:id="txtNom" promptText="Ex: Clinique Ibn Sina"
                                           style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px; -fx-padding: 12px; -fx-border-color: #D8E9E4; -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                            </VBox>
                            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Type de Local *" style="-fx-font-weight: bold; -fx-text-fill: #1A1A2E; -fx-font-size: 12px;"/>
                                <ComboBox fx:id="comboType" maxWidth="Infinity"
                                          style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px; -fx-border-color: #D8E9E4; -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                            </VBox>
                            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="Ville *" style="-fx-font-weight: bold; -fx-text-fill: #1A1A2E; -fx-font-size: 12px;"/>
                                <TextField fx:id="txtVille" promptText="Ex: Tunis"
                                           style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px; -fx-padding: 12px; -fx-border-color: #D8E9E4; -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                            </VBox>
                            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="Capacité *" style="-fx-font-weight: bold; -fx-text-fill: #1A1A2E; -fx-font-size: 12px;"/>
                                <TextField fx:id="txtCapacite" promptText="Ex: 50"
                                           style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px; -fx-padding: 12px; -fx-border-color: #D8E9E4; -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                            </VBox>
                            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
                                <Label text="Adresse *" style="-fx-font-weight: bold; -fx-text-fill: #1A1A2E; -fx-font-size: 12px;"/>
                                <TextField fx:id="txtAdresse" promptText="Ex: 15 Avenue Habib Bourguiba"
                                           style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px; -fx-padding: 12px; -fx-border-color: #D8E9E4; -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                            </VBox>
                            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2">
                                <Label text="Description" style="-fx-font-weight: bold; -fx-text-fill: #1A1A2E; -fx-font-size: 12px;"/>
                                <TextArea fx:id="txtDescription" promptText="Description détaillée..." prefRowCount="3" wrapText="true"
                                          style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px; -fx-padding: 12px; -fx-border-color: #D8E9E4; -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                            </VBox>
                        </GridPane>
                    </VBox>

                    <!-- Contact -->
                    <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 16px; -fx-padding: 25px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 15, 0, 0, 3);">
                        <Label text="📞 Informations de Contact" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1A1A2E;"/>
                        <Separator style="-fx-background-color: #D8E9E4;"/>
                        <GridPane hgap="20" vgap="15">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50"/>
                                <ColumnConstraints percentWidth="50"/>
                            </columnConstraints>
                            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Téléphone *" style="-fx-font-weight: bold; -fx-text-fill: #1A1A2E; -fx-font-size: 12px;"/>
                                <TextField fx:id="txtTelephone" promptText="Ex: 12345678"
                                           style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px; -fx-padding: 12px; -fx-border-color: #D8E9E4; -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                            </VBox>
                            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Email *" style="-fx-font-weight: bold; -fx-text-fill: #1A1A2E; -fx-font-size: 12px;"/>
                                <TextField fx:id="txtEmail" promptText="Ex: contact@centre.tn"
                                           style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px; -fx-padding: 12px; -fx-border-color: #D8E9E4; -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                            </VBox>
                        </GridPane>
                    </VBox>

                    <!-- Paramètres -->
                    <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 16px; -fx-padding: 25px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 15, 0, 0, 3);">
                        <Label text="⚙️ Paramètres Additionnels" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1A1A2E;"/>
                        <Separator style="-fx-background-color: #D8E9E4;"/>
                        <GridPane hgap="20" vgap="15">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50"/>
                                <ColumnConstraints percentWidth="50"/>
                            </columnConstraints>
                            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Disponibilité *" style="-fx-font-weight: bold; -fx-text-fill: #1A1A2E; -fx-font-size: 12px;"/>
                                <ComboBox fx:id="comboDisponibilite" maxWidth="Infinity"
                                          style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px; -fx-border-color: #D8E9E4; -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                            </VBox>
                            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Image du Local" style="-fx-font-weight: bold; -fx-text-fill: #1A1A2E; -fx-font-size: 12px;"/>
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <TextField fx:id="txtImageURL" promptText="Sélectionner une image..."
                                               HBox.hgrow="ALWAYS"
                                               style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px; -fx-padding: 12px; -fx-border-color: #D8E9E4; -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                                    <Button fx:id="btnParcourir" text="📂 Parcourir" onAction="#handleParcourir"
                                            style="-fx-background-color: transparent; -fx-border-color: #2D6A4F; -fx-border-width: 2px; -fx-border-radius: 10px; -fx-text-fill: #1B4332; -fx-font-weight: 700; -fx-background-radius: 10px; -fx-padding: 10px 16px; -fx-cursor: hand;"/>
                                </HBox>
                            </VBox>
                            <VBox spacing="8" alignment="CENTER" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2"
                                  style="-fx-background-color: #F0F4F8; -fx-padding: 15px; -fx-background-radius: 10px; -fx-border-color: #D8E9E4; -fx-border-width: 1.5px; -fx-border-radius: 10px; -fx-border-style: dashed;">
                                <Label text="📷 Aperçu de l'image" style="-fx-font-size: 12px; -fx-text-fill: #5A6475; -fx-font-weight: 600;"/>
                                <ImageView fx:id="imgPreview" fitWidth="200" fitHeight="150" preserveRatio="true" smooth="true"/>
                            </VBox>
                        </GridPane>
                    </VBox>

                    <!-- Message -->
                    <Label fx:id="lblMessage" text="" wrapText="true"
                           style="-fx-font-size: 14px; -fx-padding: 12px 20px; -fx-background-radius: 10px;"/>

                </VBox>
            </ScrollPane>

            <!-- Boutons bas -->
            <HBox spacing="15" alignment="CENTER"
                  style="-fx-background-color: white; -fx-padding: 20px 30px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, -2);">
                <Button text="✖ Annuler" onAction="#handleRetourListe" prefWidth="160"
                        style="-fx-background-color: transparent; -fx-border-color: #5A6475; -fx-border-width: 2px; -fx-border-radius: 10px; -fx-text-fill: #5A6475; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10px; -fx-padding: 14px 28px; -fx-cursor: hand;"/>
                <Button fx:id="btnSauvegarder" text="✓ Enregistrer" onAction="#handleSauvegarder" prefWidth="220"
                        style="-fx-background-color: linear-gradient(to right, #1B4332, #2D6A4F); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10px; -fx-padding: 14px 28px; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(27,67,50,0.3), 12, 0, 0, 3);"/>
            </HBox>
        </VBox>

    </StackPane>

</VBox>
