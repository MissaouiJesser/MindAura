<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.controllers.CarteGeographiqueController"
            stylesheets="@style.css"
            prefWidth="1200" prefHeight="800">

    <!--
        Le logo + titre ont été supprimés car UserHome fournit déjà la navbar principale.
        Les statistiques (Locaux / Disponibles / Villes) et le bouton Retour sont conservés
        dans la barre secondaire ci-dessous, affichée sous la navbar de UserHome.
    -->

    <!-- ══════════════════════ BARRE DE NAVIGATION SECONDAIRE ══════════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: linear-gradient(to right, #0D2B1F 0%, #1B4332 60%, #2D6A4F 100%);
                     -fx-padding: 12px 30px;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 18, 0, 0, 4);">

            <!-- Titre section -->
            <Label text="🗺️  Carte des Locaux"
                   style="-fx-font-size: 17px; -fx-font-weight: 900; -fx-text-fill: white;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Statistiques rapides -->
            <HBox spacing="12" alignment="CENTER">

                <VBox alignment="CENTER" spacing="2"
                      style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 10px;
                             -fx-padding: 6px 16px;">
                    <Label fx:id="lblNbLocaux" text="0"
                           style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: #52B788;"/>
                    <Label text="Locaux"
                           style="-fx-font-size: 10px; -fx-text-fill: #B7E4C7; -fx-font-weight: 600;"/>
                </VBox>

                <VBox alignment="CENTER" spacing="2"
                      style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 10px;
                             -fx-padding: 6px 16px;">
                    <Label fx:id="lblNbDisponibles" text="0"
                           style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: #6EE7B7;"/>
                    <Label text="Disponibles"
                           style="-fx-font-size: 10px; -fx-text-fill: #B7E4C7; -fx-font-weight: 600;"/>
                </VBox>

                <VBox alignment="CENTER" spacing="2"
                      style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 10px;
                             -fx-padding: 6px 16px;">
                    <Label fx:id="lblNbVilles" text="0"
                           style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: #93C5FD;"/>
                    <Label text="Villes"
                           style="-fx-font-size: 10px; -fx-text-fill: #B7E4C7; -fx-font-weight: 600;"/>
                </VBox>
            </HBox>

            <!-- Bouton retour -->
            <Button fx:id="btnRetour" text="← Retour" onAction="#handleRetour"
                    style="-fx-background-color: rgba(255,255,255,0.15);
                           -fx-text-fill: white; -fx-font-weight: 700; -fx-font-size: 12px;
                           -fx-background-radius: 10px; -fx-padding: 10px 20px; -fx-cursor: hand;
                           -fx-border-color: rgba(255,255,255,0.3); -fx-border-width: 1px;
                           -fx-border-radius: 10px;"/>
        </HBox>
    </top>

    <!-- ══════════════════════ CONTENU ══════════════════════ -->
    <center>
        <HBox spacing="0" VBox.vgrow="ALWAYS">

            <!-- ════════ PANNEAU GAUCHE ════════ -->
            <VBox spacing="0" prefWidth="300" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: #F8FAFC;
                         -fx-border-color: #E2E8F0; -fx-border-width: 0 1 0 0;">

                <!-- Titre panneau -->
                <HBox alignment="CENTER_LEFT" spacing="10"
                      style="-fx-background-color: white; -fx-padding: 16px 20px;
                             -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">
                    <Label text="🔎" style="-fx-font-size: 16px;"/>
                    <Label text="Filtres &amp; Recherche"
                           style="-fx-font-size: 14px; -fx-font-weight: 800; -fx-text-fill: #1E293B;"/>
                </HBox>

                <!-- Corps du panneau — scrollable -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background-color: transparent; -fx-background: transparent;
                                   -fx-border-color: transparent;">
                    <VBox spacing="14" style="-fx-padding: 18px 18px;">

                        <!-- ── Barre de recherche ── -->
                        <VBox spacing="6">
                            <Label text="Recherche rapide"
                                   style="-fx-font-size: 11px; -fx-font-weight: 700;
                                          -fx-text-fill: #64748B; -fx-padding: 0 0 0 2px;"/>
                            <HBox spacing="0"
                                  style="-fx-background-color: white;
                                         -fx-border-color: #CBD5E1; -fx-border-width: 1.5px;
                                         -fx-border-radius: 10px; -fx-background-radius: 10px;
                                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 0, 1);">
                                <Label text="🔍" style="-fx-padding: 0 8px 0 12px; -fx-text-fill: #94A3B8;"/>
                                <TextField fx:id="txtRecherche"
                                           promptText="Nom, ville, adresse..."
                                           HBox.hgrow="ALWAYS"
                                           onAction="#handleRechercher"
                                           style="-fx-background-color: transparent;
                                                  -fx-border-color: transparent;
                                                  -fx-font-size: 13px; -fx-text-fill: #1E293B;
                                                  -fx-prompt-text-fill: #94A3B8;
                                                  -fx-padding: 10px 4px;"/>
                                <Button fx:id="btnRechercher" text="→" onAction="#handleRechercher"
                                        style="-fx-background-color: #1B4332; -fx-text-fill: white;
                                               -fx-background-radius: 0 8px 8px 0;
                                               -fx-padding: 10px 14px; -fx-cursor: hand;
                                               -fx-font-weight: 800; -fx-font-size: 14px;"/>
                            </HBox>
                        </VBox>

                        <!-- ── Filtre ville ── -->
                        <VBox spacing="6">
                            <Label text="Ville"
                                   style="-fx-font-size: 11px; -fx-font-weight: 700;
                                          -fx-text-fill: #64748B; -fx-padding: 0 0 0 2px;"/>
                            <ComboBox fx:id="comboVille" prefWidth="Infinity"
                                      style="-fx-font-size: 13px; -fx-pref-height: 40px;"/>
                        </VBox>

                        <!-- ── Filtre type ── -->
                        <VBox spacing="6">
                            <Label text="Type d'établissement"
                                   style="-fx-font-size: 11px; -fx-font-weight: 700;
                                          -fx-text-fill: #64748B; -fx-padding: 0 0 0 2px;"/>
                            <ComboBox fx:id="comboType" prefWidth="Infinity"
                                      style="-fx-font-size: 13px; -fx-pref-height: 40px;"/>
                        </VBox>

                        <!-- ── Boutons action ── -->
                        <VBox spacing="8">
                            <Button text="📍 Ma position" onAction="#handleGeolocaliser"
                                    prefWidth="Infinity"
                                    style="-fx-background-color: linear-gradient(to right, #2563EB, #1D4ED8);
                                           -fx-text-fill: white; -fx-font-weight: 700; -fx-font-size: 12px;
                                           -fx-background-radius: 10px; -fx-padding: 11px;
                                           -fx-cursor: hand;
                                           -fx-effect: dropshadow(gaussian, rgba(37,99,235,0.4), 10, 0, 0, 2);"/>

                            <Button fx:id="btnReinitialiser" text="🔄 Réinitialiser"
                                    onAction="#handleReinitialiser" prefWidth="Infinity"
                                    style="-fx-background-color: white; -fx-text-fill: #475569;
                                           -fx-font-weight: 700; -fx-font-size: 12px;
                                           -fx-background-radius: 10px; -fx-padding: 11px;
                                           -fx-cursor: hand;
                                           -fx-border-color: #CBD5E1; -fx-border-width: 1.5px;
                                           -fx-border-radius: 10px;"/>
                        </VBox>

                        <!-- ── Séparateur ── -->
                        <Region prefHeight="4"/>

                        <!-- ── Légende ── -->
                        <VBox spacing="10"
                              style="-fx-background-color: white; -fx-background-radius: 14px;
                                     -fx-padding: 14px 16px;
                                     -fx-border-color: #E2E8F0; -fx-border-width: 1px;
                                     -fx-border-radius: 14px;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 8, 0, 0, 2);">

                            <Label text="Légende des types"
                                   style="-fx-font-size: 12px; -fx-font-weight: 800;
                                          -fx-text-fill: #1E293B; -fx-padding: 0 0 4px 0;"/>

                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <StackPane style="-fx-background-color: #EF4444; -fx-background-radius: 50px;
                                                  -fx-min-width: 14px; -fx-min-height: 14px;
                                                  -fx-max-width: 14px; -fx-max-height: 14px;"/>
                                <Label text="Hôpital" style="-fx-font-size: 12px; -fx-text-fill: #374151;"/>
                            </HBox>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <StackPane style="-fx-background-color: #7C3AED; -fx-background-radius: 50px;
                                                  -fx-min-width: 14px; -fx-min-height: 14px;
                                                  -fx-max-width: 14px; -fx-max-height: 14px;"/>
                                <Label text="Cabinet privé" style="-fx-font-size: 12px; -fx-text-fill: #374151;"/>
                            </HBox>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <StackPane style="-fx-background-color: #3B82F6; -fx-background-radius: 50px;
                                                  -fx-min-width: 14px; -fx-min-height: 14px;
                                                  -fx-max-width: 14px; -fx-max-height: 14px;"/>
                                <Label text="Clinique psychiatrique" style="-fx-font-size: 12px; -fx-text-fill: #374151;"/>
                            </HBox>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <StackPane style="-fx-background-color: #10B981; -fx-background-radius: 50px;
                                                  -fx-min-width: 14px; -fx-min-height: 14px;
                                                  -fx-max-width: 14px; -fx-max-height: 14px;"/>
                                <Label text="Centre de santé mentale" style="-fx-font-size: 12px; -fx-text-fill: #374151;"/>
                            </HBox>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <StackPane style="-fx-background-color: #F59E0B; -fx-background-radius: 50px;
                                                  -fx-min-width: 14px; -fx-min-height: 14px;
                                                  -fx-max-width: 14px; -fx-max-height: 14px;"/>
                                <Label text="Centre de bien-être" style="-fx-font-size: 12px; -fx-text-fill: #374151;"/>
                            </HBox>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <StackPane style="-fx-background-color: #EC4899; -fx-background-radius: 50px;
                                                  -fx-min-width: 14px; -fx-min-height: 14px;
                                                  -fx-max-width: 14px; -fx-max-height: 14px;"/>
                                <Label text="Espace de thérapie" style="-fx-font-size: 12px; -fx-text-fill: #374151;"/>
                            </HBox>
                        </VBox>

                        <!-- ── Astuce ── -->
                        <VBox spacing="6"
                              style="-fx-background-color: #EFF6FF; -fx-background-radius: 12px;
                                     -fx-padding: 12px 14px;
                                     -fx-border-color: #BFDBFE; -fx-border-width: 1px;
                                     -fx-border-radius: 12px;">
                            <Label text="💡 Astuce"
                                   style="-fx-font-size: 11px; -fx-font-weight: 800; -fx-text-fill: #1D4ED8;"/>
                            <Label text="Cliquez sur un marqueur pour voir les détails et réserver directement depuis la carte."
                                   wrapText="true"
                                   style="-fx-font-size: 11px; -fx-text-fill: #3B82F6; -fx-line-spacing: 2px;"/>
                        </VBox>

                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- ════════ CARTE WebView ════════ -->
            <StackPane HBox.hgrow="ALWAYS"
                       style="-fx-background-color: #e8e0d8;">
                <WebView fx:id="carteWebView"
                         StackPane.alignment="CENTER"/>

                <!-- Indicateur de chargement -->
                <VBox fx:id="loadingOverlay" alignment="CENTER" spacing="12"
                      style="-fx-background-color: rgba(255,255,255,0.92);">
                    <Label text="🗺️" style="-fx-font-size: 48px;"/>
                    <Label text="Chargement de la carte..."
                           style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #1B4332;"/>
                    <Label text="Connexion aux tuiles OpenStreetMap..."
                           style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"/>
                    <ProgressBar prefWidth="200" style="-fx-accent: #2D6A4F;"/>
                </VBox>
            </StackPane>

        </HBox>
    </center>

</BorderPane>
