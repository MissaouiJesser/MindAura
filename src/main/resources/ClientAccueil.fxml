<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>

<VBox spacing="0" style="-fx-background-color: #1b4332;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.ClientAccueilController">

    <stylesheets><String fx:value="/app.css" /></stylesheets>

    <!-- EN-TETE AVEC TITRE ET BOUTON ACCUEIL TOP-RIGHT -->
    <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background: linear-gradient(to bottom, #2D6A4F, #1B4332); -fx-padding: 16 24;">
        <VBox spacing="8">
            <Label style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;" text="Reclamations et Reponses" />
            <Label style="-fx-text-fill: #B8E6D5; -fx-font-size: 13;" text="Espace Client" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnRetourAccueil" style="-fx-background-color: #5A6475; -fx-text-fill: white; -fx-padding: 10 16; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-size: 12;" text="Accueil" />
    </HBox>

    <!-- CONTENU PRINCIPAL AVEC ONGLETS (RÉCLAMATIONS + CHATBOT) -->
    <HBox spacing="0" VBox.vgrow="ALWAYS">

        <!-- NAVBAR GAUCHE -->
        <VBox prefWidth="250" style="-fx-background-color: #1B4332; -fx-padding: 24; -fx-spacing: 16; -fx-min-width: 250; -fx-border-color: #0A3420; -fx-border-width: 0 1 0 0;">

            <!-- Logo -->
            <VBox alignment="TOP_CENTER" spacing="12" style="-fx-padding: 0 0 20 0; -fx-border-color: #2D6A4F; -fx-border-width: 0 0 1 0;">
                <ImageView fx:id="imgLogo" fitHeight="60" fitWidth="60" style="-fx-alignment: center;" />
                <Label style="-fx-text-fill: #B8E6D5; -fx-font-size: 11; -fx-text-alignment: center;" text="Reclamations" />
            </VBox>

            <!-- Bouton Mes Reclamations : ouvre la vue qui affiche uniquement les réclamations de l'utilisateur -->
            <Button fx:id="btnMesReclamations" style="-fx-background-color: #2D6A4F; -fx-text-fill: white; -fx-padding: 12 16; -fx-background-radius: 6; -fx-font-size: 12; -fx-cursor: hand;">
                <text>Mes Reclamations</text>
            </Button>

            <!-- Bouton Nouvelle Reclamation -->
            <Button fx:id="btnNouvelleReclamation" style="-fx-background-color: transparent; -fx-text-fill: #B8E6D5; -fx-padding: 12 16; -fx-background-radius: 6; -fx-font-size: 12; -fx-cursor: hand; -fx-border-color: #2D6A4F; -fx-border-width: 1; -fx-border-radius: 6;">
                <text>Nouvelle Reclamation</text>
            </Button>

            <!-- Formulaire Ajout Reclamation -->
            <VBox fx:id="formAjoutReclamation" spacing="12" style="-fx-padding: 16; -fx-background-color: #2D6A4F; -fx-background-radius: 6; -fx-border-color: #0A3420; -fx-border-width: 1;" visible="false">
                <Label style="-fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: bold;" text="Nouvelle Reclamation" />

                <VBox spacing="4">
                    <Label style="-fx-text-fill: #B8E6D5; -fx-font-size: 10;" text="Sujet" />
                    <TextField fx:id="tfSujet" promptText="Titre..." style="-fx-padding: 8; -fx-font-size: 11; -fx-background-radius: 4;" />
                </VBox>

                <VBox spacing="4">
                    <Label style="-fx-text-fill: #B8E6D5; -fx-font-size: 10;" text="Description" />
                    <TextArea fx:id="taDescription" prefRowCount="3" promptText="Detailles..." style="-fx-padding: 8; -fx-font-size: 11; -fx-background-radius: 4; -fx-control-inner-background: white;" wrapText="true" />
                </VBox>

                <VBox spacing="4">
                    <Label style="-fx-text-fill: #B8E6D5; -fx-font-size: 10;" text="Categorie" />
                    <ComboBox fx:id="cbCategorie" style="-fx-padding: 8; -fx-font-size: 11; -fx-background-radius: 4;" />
                </VBox>

                <HBox spacing="8">
                    <Button fx:id="btnValiderAjout" style="-fx-background-color: #1B4332; -fx-text-fill: white; -fx-padding: 8 16; -fx-background-radius: 4; -fx-font-size: 11; -fx-cursor: hand;" text="Valider" HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnAnnulerAjout" style="-fx-background-color: #5A6475; -fx-text-fill: white; -fx-padding: 8 16; -fx-background-radius: 4; -fx-font-size: 11; -fx-cursor: hand;" text="Annuler" HBox.hgrow="ALWAYS" />
                </HBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

        </VBox>

        <!-- ✅ NOUVEAU: ONGLETS (RÉCLAMATIONS + CHATBOT) À DROITE -->
        <TabPane VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS"
                 style="-fx-background-color: #F0F4F8; -fx-padding: 0;">

            <!-- ONGLET 1: MES RÉCLAMATIONS -->
            <Tab text="📋 Mes Réclamations" closable="false">
                <VBox spacing="12" style="-fx-padding: 20; -fx-background-color: #F0F4F8;">

                    <!-- Barre de recherche ET FILTRE -->
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #1A1A2E; -fx-font-size: 11; -fx-font-weight: bold;" text="Rechercher" />
                            <TextField fx:id="tfRecherche" promptText="Entrez au moins 3 caracteres..." style="-fx-padding: 10; -fx-font-size: 12; -fx-background-radius: 6; -fx-border-color: #2D6A4F; -fx-border-width: 1; -fx-font-family: Segoe UI;" />
                        </VBox>
                        <VBox spacing="6" style="-fx-min-width: 180;">
                            <Label style="-fx-text-fill: #1A1A2E; -fx-font-size: 11; -fx-font-weight: bold;" text="Categorie" />
                            <ComboBox fx:id="cbFiltreRecherche" prefWidth="160" style="-fx-padding: 10; -fx-font-size: 11; -fx-background-radius: 4; -fx-border-color: #2D6A4F; -fx-border-width: 1; -fx-text-fill: #1A1A2E; -fx-font-family: Segoe UI; -fx-max-height: 38;" />
                        </VBox>
                        <VBox spacing="6" style="-fx-min-width: 180;">
                            <Label style="-fx-text-fill: #1A1A2E; -fx-font-size: 11; -fx-font-weight: bold;" text="Statut" />
                            <ComboBox fx:id="cbFiltreStatut" prefWidth="160" style="-fx-padding: 10; -fx-font-size: 11; -fx-background-radius: 4; -fx-border-color: #2D6A4F; -fx-border-width: 1; -fx-text-fill: #1A1A2E; -fx-font-family: Segoe UI; -fx-max-height: 38;" />
                        </VBox>
                    </HBox>

                    <!-- En-tete du contenu -->
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label style="-fx-text-fill: #1A1A2E; -fx-font-size: 16; -fx-font-weight: bold;" text="Vos Reclamations" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblMessage" style="-fx-text-fill: #5A6475; -fx-font-size: 11;" text="" />
                    </HBox>

                    <!-- Pagination -->
                    <HBox alignment="CENTER_RIGHT" spacing="8">
                        <Label fx:id="lblPage" style="-fx-text-fill: #5A6475; -fx-font-size: 11;" text="Page 1/1" />
                        <Button fx:id="btnPrevPage" text="◀" style="-fx-background-color: #E2E8F0; -fx-text-fill: #1A1A2E; -fx-padding: 4 10; -fx-background-radius: 4;" />
                        <Button fx:id="btnNextPage" text="▶" style="-fx-background-color: #E2E8F0; -fx-text-fill: #1A1A2E; -fx-padding: 4 10; -fx-background-radius: 4;" />
                    </HBox>

                    <!-- ListView avec cartes dynamiques -->
                    <ListView fx:id="listReclamations" style="-fx-background-color: #F0F4F8; -fx-border-color: transparent; -fx-padding: 0;" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" />
                </VBox>
            </Tab>

            <!-- ✅ NOUVEAU: ONGLET 2: CHATBOT IA -->
            <Tab text="🤖 Assistant IA" closable="false">
                <fx:include source="ClientChatbot.fxml" />
            </Tab>

        </TabPane>

    </HBox>

</VBox>
