                <VBox style="-fx-padding: 12px 16px 16px 16px; -fx-min-height: 280px;">
                    <BarChart fx:id="rBarChartVues" legendVisible="false" prefHeight="260" VBox.vgrow="ALWAYS">
                        <xAxis><CategoryAxis label="Ressource" side="BOTTOM" /></xAxis>
                        <yAxis><NumberAxis label="Vues" side="LEFT" /></yAxis>
                    </BarChart>
                </VBox>
            </VBox>
            <VBox spacing="0" style="-fx-background-color: white; -fx-background-radius: 16px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 14, 0, 0, 3);" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 16px 20px; -fx-border-color: #F0F4F8; -fx-border-width: 0 0 2 0;">
