                    <StackPane styleClass="stat-icon-bg-purple">
                        <FontIcon iconLiteral="fas-calendar-alt" iconSize="22" iconColor="white" />
                    </StackPane>
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="evPlanifiesLabel" styleClass="stat-value" text="0" />
                        <Label styleClass="stat-label" text="Planifiés" />
                    </VBox>
                </HBox>
            </VBox>
        </HBox>

        <!-- KPI Participations -->
