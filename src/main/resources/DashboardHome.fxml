                    </StackPane>
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="evPlacesDispoLabel" styleClass="stat-value" text="0" />
                        <Label styleClass="stat-label" text="Places disponibles" />
                    </VBox>
                </HBox>
