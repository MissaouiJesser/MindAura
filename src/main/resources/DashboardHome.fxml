            <VBox spacing="6" style="-fx-padding: 18px 22px; -fx-background-color: white; -fx-background-radius: 14px; -fx-border-color: #EDE9FE; -fx-border-width: 0 0 0 4; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 10, 0, 0, 2);" HBox.hgrow="ALWAYS">
