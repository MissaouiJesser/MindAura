                </HBox>
            </VBox>
            <VBox spacing="10" styleClass="stat-card stat-card-green" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <StackPane styleClass="stat-icon-bg-green">
                        <FontIcon iconLiteral="fas-check-circle" iconSize="22" iconColor="white" />
