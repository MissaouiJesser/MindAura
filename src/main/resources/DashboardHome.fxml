                    </VBox>
                </HBox>
                <VBox style="-fx-padding: 12px 16px 16px 16px; -fx-min-height: 260px;">
                    <PieChart fx:id="rPieChartTypes" legendVisible="true" prefHeight="240" VBox.vgrow="ALWAYS" />
                </VBox>
            </VBox>
            <VBox spacing="0" style="-fx-background-color: white; -fx-background-radius: 16px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 14, 0, 0, 3);" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 16px 20px; -fx-border-color: #F0F4F8; -fx-border-width: 0 0 2 0;">
                    <StackPane style="-fx-background-color: rgba(3,105,161,0.1); -fx-background-radius: 9px; -fx-pref-width: 36px; -fx-pref-height: 36px;">
                        <FontIcon iconLiteral="fas-chart-pie" iconSize="18" iconColor="#0369A1" />
