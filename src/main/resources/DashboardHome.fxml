                <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 16px 20px; -fx-border-color: #F0F4F8; -fx-border-width: 0 0 2 0;">
                    <StackPane style="-fx-background-color: rgba(79,110,247,0.1); -fx-background-radius: 9px; -fx-pref-width: 36px; -fx-pref-height: 36px;">
                        <FontIcon iconLiteral="fas-chart-bar" iconSize="18" iconColor="#4F6EF7" />
                    </StackPane>
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #1A1A2E;" text="Participations par type d'événement" />
                        <Label style="-fx-font-size: 9px; -fx-text-fill: #5A6475;" text="Nombre d'inscrits selon la catégorie de l'événement" />
