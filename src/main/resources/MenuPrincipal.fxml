<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.MenuPrincipalController"
            style="-fx-background-color: linear-gradient(to bottom, #1B4332 0%, #2D6A4F 100%);">

    <center>
        <VBox alignment="CENTER" spacing="40" style="-fx-padding: 50;">

            <!-- Titre -->
            <VBox alignment="CENTER" spacing="10">
                <ImageView fitHeight="170" fitWidth="170" preserveRatio="true">
                    <image>
                        <Image url="/Images/logo.png" />
                    </image>
                </ImageView>
                <Label text="Gestion des Tests Psychologiques" textFill="white">
                    <font>
                        <Font name="System Bold" size="32"/>
                    </font>
                </Label>
                <Label text="Choisissez votre profil" textFill="white" style="-fx-font-size: 18; -fx-opacity: 0.9;"/>
            </VBox>

            <!-- Cartes de choix -->
            <HBox spacing="40" alignment="CENTER">

                <!-- Carte Patient -->
                <VBox alignment="CENTER" spacing="20"
                      style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 20, 0, 0, 5);"
                      prefWidth="300" prefHeight="350">

                    <Label text="👤" style="-fx-font-size: 80;"/>

                    <Label text="Patient" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1B4332;"/>

                    <Label text="Passer des tests psychologiques et consulter vos résultats"
                           wrapText="true" textAlignment="CENTER"
                           style="-fx-text-fill: #5A6475; -fx-font-size: 14;"
                           prefWidth="250"/>

                    <Region VBox.vgrow="ALWAYS"/>

                    <Button text="Accéder" onAction="#accederPatient"
                            style="-fx-background-color: #1B4332; -fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold; -fx-padding: 15 50; -fx-background-radius: 25; -fx-cursor: hand;"
                            prefWidth="200"/>

                </VBox>

                <!-- Carte Admin -->
                <VBox alignment="CENTER" spacing="20"
                      style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 20, 0, 0, 5);"
                      prefWidth="300" prefHeight="350">

                    <Label text="⚙️" style="-fx-font-size: 80;"/>

                    <Label text="Administrateur" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #7B5EA7;"/>

                    <Label text="Gérer les tests, questions et consulter les statistiques"
                           wrapText="true" textAlignment="CENTER"
                           style="-fx-text-fill: #5A6475; -fx-font-size: 14;"
                           prefWidth="250"/>

                    <Region VBox.vgrow="ALWAYS"/>

                    <Button text="Accéder" onAction="#accederAdmin"
                            style="-fx-background-color: #7B5EA7; -fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold; -fx-padding: 15 50; -fx-background-radius: 25; -fx-cursor: hand;"
                            prefWidth="200"/>

                </VBox>

            </HBox>

            <!-- Footer -->
            <Label text="Module Psychologie et Développement Personnel"
                   textFill="white" style="-fx-font-size: 12; -fx-opacity: 0.7;"/>

        </VBox>
    </center>

</BorderPane>