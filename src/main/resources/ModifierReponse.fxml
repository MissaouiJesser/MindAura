<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.ModifierReponse"
      spacing="20" style="-fx-background-color: #f5f5f5; -fx-padding: 20;">

    <HBox spacing="20">
        <Label text="Modifier une Réponse"
               style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #333;"/>
        <Label fx:id="lblId" text="ID: -"
               style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2196F3;"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox spacing="15" style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-padding: 20; -fx-border-width: 1;">

            <VBox spacing="5">
                <Label text="Contenu du commentaire (min 5 caractères) :" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                <TextArea fx:id="taContenu" promptText="Contenu"
                          wrapText="true" prefRowCount="5"
                          style="-fx-padding: 8; -fx-font-size: 12;"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Note (0-5) :" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                <Spinner fx:id="spRate" editable="true"
                         style="-fx-padding: 8; -fx-font-size: 12;"/>
            </VBox>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="btnValider" text="✓ Valider"
                        style="-fx-padding: 10 30; -fx-font-size: 12; -fx-font-weight: bold;
                               -fx-background-color: #4CAF50; -fx-text-fill: white;"/>

                <Button fx:id="btnAnnuler" text="✗ Annuler"
                        style="-fx-padding: 10 30; -fx-font-size: 12; -fx-font-weight: bold;
                               -fx-background-color: #f44336; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </ScrollPane>

    <Label fx:id="lblMessage" text="" style="-fx-text-fill: #4CAF50; -fx-font-size: 12;"/>

</VBox>
