<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<ScrollPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.EventFormController"
            fitToWidth="true"
            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            style="-fx-background: #F0F4F8; -fx-background-color: #F0F4F8; -fx-border-color: transparent;">
    <content>
        <VBox spacing="0" style="-fx-background-color: #F0F4F8; -fx-padding: 28 36 40 36;">

            <!-- ══ EN-TÊTE DE PAGE (intégré dans le dashboard, sans bannière) ══ -->
            <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding: 0 0 6 0;">

                <!-- Icône ronde -->
                <StackPane alignment="CENTER"
                           style="-fx-background-color: linear-gradient(to bottom right, #2D6A4F, #1B4332);
                          -fx-background-radius: 14;
                          -fx-min-width: 52; -fx-min-height: 52;
                          -fx-max-width: 52; -fx-max-height: 52;
                          -fx-effect: dropshadow(gaussian, rgba(27,67,50,0.35), 14, 0, 0, 4);">
                    <Label fx:id="formIcon" text="&#10022;"
                           style="-fx-font-size: 20px; -fx-text-fill: #74D3A8;"/>
                </StackPane>

                <!-- Titre + breadcrumb -->
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Label text="Événements"
                               style="-fx-font-size: 11px; -fx-text-fill: #5A6475; -fx-font-weight: 600;"/>
                        <Label text="›" style="-fx-text-fill: #A0AEC0; -fx-font-size: 11px;"/>
                        <Label fx:id="formBreadcrumb" text="Nouveau"
                               style="-fx-font-size: 11px; -fx-text-fill: #2D6A4F; -fx-font-weight: 700;"/>
                    </HBox>
                    <Label fx:id="formTitle" text="Créer un Événement"
                           style="-fx-font-size: 22px; -fx-font-weight: 900; -fx-text-fill: #1A1A2E;"/>
                    <Label fx:id="formSubtitle" text="Organisez et partagez un événement inspirant"
                           style="-fx-font-size: 12.5px; -fx-text-fill: #5A6475;"/>
                </VBox>

                <!-- Tags -->
                <HBox spacing="8" alignment="CENTER">
                    <Label text="&#127807; Bien-être"
                           style="-fx-background-color: #E8F5EE; -fx-text-fill: #1B4332;
                          -fx-background-radius: 20; -fx-padding: 5 12; -fx-font-size: 11px; -fx-font-weight: 700;
                          -fx-border-color: #C6E6D8; -fx-border-width: 1; -fx-border-radius: 20;"/>
                    <Label text="&#129464; Mindfulness"
                           style="-fx-background-color: #F0ECF8; -fx-text-fill: #7B5EA7;
                          -fx-background-radius: 20; -fx-padding: 5 12; -fx-font-size: 11px; -fx-font-weight: 700;
                          -fx-border-color: #D6CAF0; -fx-border-width: 1; -fx-border-radius: 20;"/>
                </HBox>
            </HBox>

            <!-- Séparateur dégradé -->
            <Region style="-fx-background-color: linear-gradient(to right, #2D6A4F, #7B5EA7, rgba(240,244,248,0));
                   -fx-pref-height: 3; -fx-max-height: 3; -fx-background-radius: 2;"/>
            <Region style="-fx-pref-height: 22;"/>

            <!-- ══ CARTE FORMULAIRE ══ -->
            <VBox spacing="0"
                  style="-fx-background-color: #FFFFFF;
                 -fx-background-radius: 18; -fx-border-color: #E2E8F0;
                 -fx-border-width: 1.5; -fx-border-radius: 18;
                 -fx-effect: dropshadow(gaussian, rgba(27,67,50,0.09), 18, 0, 0, 5);">

                <!-- ── Section 1 : Informations principales ── -->
                <HBox alignment="CENTER_LEFT" spacing="10"
                      style="-fx-padding: 18 28 14 28;
                     -fx-background-color: linear-gradient(to right, #E8F5EE 0%, #FFFFFF 60%);
                     -fx-background-radius: 18 18 0 0;
                     -fx-border-color: transparent transparent #E2E8F0 transparent; -fx-border-width: 0 0 1.5 0;">
                    <StackPane alignment="CENTER"
                               style="-fx-background-color: #E8F5EE; -fx-background-radius: 8;
                              -fx-min-width: 32; -fx-min-height: 32; -fx-max-width: 32; -fx-max-height: 32;">
                        <Label text="📋" style="-fx-font-size: 14px;"/>
                    </StackPane>
                    <Label text="Informations principales"
                           style="-fx-font-size: 14px; -fx-font-weight: 800; -fx-text-fill: #1A1A2E;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="* Champs obligatoires"
                           style="-fx-font-size: 11px; -fx-text-fill: #A0AEC0;"/>
                </HBox>

                <VBox style="-fx-padding: 24 28 28 28;" spacing="20">

                    <!-- Bannière erreur -->
                    <HBox fx:id="errorBanner"
                          style="-fx-background-color: #FEF2F2; -fx-border-color: #FECACA;
                         -fx-border-radius: 10; -fx-border-width: 1.5; -fx-background-radius: 10;
                         -fx-padding: 12 18;"
                          alignment="CENTER_LEFT" spacing="10" visible="false" managed="false">
                        <Label text="&#9888;" style="-fx-font-size: 14px; -fx-text-fill: #EF4444;"/>
                        <Label fx:id="errorMessage"
                               style="-fx-text-fill: #DC2626; -fx-font-size: 13px; -fx-font-weight: 600;"
                               wrapText="true" HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <!-- Titre -->
                    <VBox spacing="5">
                        <Label text="Titre de l'événement *"
                               style="-fx-font-size: 12.5px; -fx-font-weight: 700; -fx-text-fill: #374151;"/>
                        <Label text="Donnez un titre accrocheur et mémorable"
                               style="-fx-font-size: 11.5px; -fx-text-fill: #9CA3AF;"/>
                        <TextField fx:id="titreField" promptText="Ex: Atelier Pleine Conscience — Tunis 2025"
                                   style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0;
                                  -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10;
                                  -fx-font-size: 13.5px; -fx-text-fill: #1A1A2E; -fx-prompt-text-fill: #A0AEC0;
                                  -fx-padding: 11 14; -fx-pref-height: 42;"/>
                    </VBox>

                    <!-- Description -->
                    <VBox spacing="5">
                        <Label text="Description *"
                               style="-fx-font-size: 12.5px; -fx-font-weight: 700; -fx-text-fill: #374151;"/>
                        <Label text="Décrivez l'objectif, le programme et le public cible"
                               style="-fx-font-size: 11.5px; -fx-text-fill: #9CA3AF;"/>
                        <TextArea fx:id="descriptionField" promptText="Décrivez votre événement en détail…"
                                  prefRowCount="4" wrapText="true"
                                  style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0;
                                 -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10;
                                 -fx-font-size: 13px; -fx-text-fill: #1A1A2E; -fx-prompt-text-fill: #A0AEC0;
                                 -fx-padding: 10 14;"/>
                    </VBox>

                    <!-- Dates -->
                    <GridPane hgap="16" vgap="0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                        </columnConstraints>
                        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Date de début *"
                                   style="-fx-font-size: 12.5px; -fx-font-weight: 700; -fx-text-fill: #374151;"/>
                            <DatePicker fx:id="datedebutPicker" promptText="Sélectionner"
                                        maxWidth="Infinity" onAction="#onDateDebutChanged"
                                        style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0;
                                       -fx-border-width: 1.5; -fx-border-radius: 10;
                                       -fx-background-radius: 10; -fx-font-size: 13px; -fx-pref-height: 42;"/>
                        </VBox>
                        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Date de fin *"
                                   style="-fx-font-size: 12.5px; -fx-font-weight: 700; -fx-text-fill: #374151;"/>
                            <DatePicker fx:id="datefinPicker" promptText="Sélectionner" maxWidth="Infinity"
                                        style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0;
                                       -fx-border-width: 1.5; -fx-border-radius: 10;
                                       -fx-background-radius: 10; -fx-font-size: 13px; -fx-pref-height: 42;"/>
                            <Label fx:id="dateFinError"
                                   text="&#9888;  La date de fin doit être après la date de début"
                                   style="-fx-text-fill: #EF4444; -fx-font-size: 11px; -fx-font-weight: 600;"
                                   visible="false" managed="false"/>
                        </VBox>
                    </GridPane>

                    <!-- Lieu + Capacité -->
                    <GridPane hgap="16" vgap="0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="62"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="38"/>
                        </columnConstraints>
                        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Lieu *"
                                   style="-fx-font-size: 12.5px; -fx-font-weight: 700; -fx-text-fill: #374151;"/>
                            <TextField fx:id="lieuField" promptText="Ex: Centre de Bien-Être, Tunis"
                                       style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0;
                                      -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10;
                                      -fx-font-size: 13.5px; -fx-text-fill: #1A1A2E; -fx-prompt-text-fill: #A0AEC0;
                                      -fx-padding: 11 14; -fx-pref-height: 42;"/>
                        </VBox>
                        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Capacité (places) *"
                                   style="-fx-font-size: 12.5px; -fx-font-weight: 700; -fx-text-fill: #374151;"/>
                            <TextField fx:id="capaciteField" promptText="Ex: 50"
                                       style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0;
                                      -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10;
                                      -fx-font-size: 13.5px; -fx-text-fill: #1A1A2E; -fx-prompt-text-fill: #A0AEC0;
                                      -fx-padding: 11 14; -fx-pref-height: 42;"/>
                        </VBox>
                    </GridPane>
                </VBox>

                <!-- ── Section 2 : Catégorisation ── -->
                <HBox alignment="CENTER_LEFT" spacing="10"
                      style="-fx-padding: 18 28 14 28;
                     -fx-background-color: linear-gradient(to right, #F0ECF8 0%, #FFFFFF 60%);
                     -fx-border-color: #E2E8F0 transparent #E2E8F0 transparent; -fx-border-width: 1.5 0;">
                    <StackPane alignment="CENTER"
                               style="-fx-background-color: #F0ECF8; -fx-background-radius: 8;
                              -fx-min-width: 32; -fx-min-height: 32; -fx-max-width: 32; -fx-max-height: 32;">
                        <Label text="🏷" style="-fx-font-size: 14px;"/>
                    </StackPane>
                    <Label text="Catégorisation"
                           style="-fx-font-size: 14px; -fx-font-weight: 800; -fx-text-fill: #1A1A2E;"/>
                </HBox>
                <VBox style="-fx-padding: 24 28 28 28;">
                    <GridPane hgap="16" vgap="0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                        </columnConstraints>
                        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Statut"
                                   style="-fx-font-size: 12.5px; -fx-font-weight: 700; -fx-text-fill: #374151;"/>
                            <ComboBox fx:id="statutCombo" maxWidth="Infinity" promptText="Choisissez un statut"
                                      style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0;
                                     -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10;
                                     -fx-font-size: 13px; -fx-cursor: hand; -fx-pref-height: 42;"/>
                        </VBox>
                        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Type d'événement"
                                   style="-fx-font-size: 12.5px; -fx-font-weight: 700; -fx-text-fill: #374151;"/>
                            <ComboBox fx:id="typeCombo" maxWidth="Infinity" promptText="Choisissez un type"
                                      style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0;
                                     -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10;
                                     -fx-font-size: 13px; -fx-cursor: hand; -fx-pref-height: 42;"/>
                        </VBox>
                    </GridPane>
                </VBox>

                <!-- ── Section 3 : Image de couverture ── -->
                <HBox alignment="CENTER_LEFT" spacing="10"
                      style="-fx-padding: 18 28 14 28;
                     -fx-background-color: linear-gradient(to right, #EBF8FF 0%, #FFFFFF 60%);
                     -fx-border-color: #E2E8F0 transparent #E2E8F0 transparent; -fx-border-width: 1.5 0;">
                    <StackPane alignment="CENTER"
                               style="-fx-background-color: #E0F2FE; -fx-background-radius: 8;
                              -fx-min-width: 32; -fx-min-height: 32; -fx-max-width: 32; -fx-max-height: 32;">
                        <Label text="🖼" style="-fx-font-size: 14px;"/>
                    </StackPane>
                    <Label text="Image de couverture"
                           style="-fx-font-size: 14px; -fx-font-weight: 800; -fx-text-fill: #1A1A2E;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Optionnel"
                           style="-fx-font-size: 11px; -fx-text-fill: #A0AEC0;
                          -fx-background-color: #F1F5F9; -fx-background-radius: 10; -fx-padding: 3 10;"/>
                </HBox>
                <VBox style="-fx-padding: 24 28 28 28;" spacing="12">
                    <Label text="Une belle image augmente l'attractivité de votre événement"
                           style="-fx-font-size: 11.5px; -fx-text-fill: #9CA3AF;"/>
                    <HBox spacing="12" alignment="CENTER_LEFT"
                          style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1;
                         -fx-border-width: 1.5; -fx-border-radius: 12; -fx-background-radius: 12;
                         -fx-padding: 14 18;">
                        <Label text="📁" style="-fx-font-size: 20px;"/>
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="Cliquez pour sélectionner une image"
                                   style="-fx-font-size: 12.5px; -fx-font-weight: 700; -fx-text-fill: #374151;"/>
                            <Label text="PNG, JPG, GIF, WEBP jusqu'à 10 Mo"
                                   style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
                        </VBox>
                        <Button fx:id="uploadImageButton" text="Parcourir" onAction="#uploadImage"
                                style="-fx-background-color: linear-gradient(to bottom, #2D6A4F, #1B4332);
                               -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: 700;
                               -fx-background-radius: 9; -fx-cursor: hand; -fx-padding: 8 16;
                               -fx-effect: dropshadow(gaussian, rgba(27,67,50,0.30), 8, 0, 0, 3);"/>
                    </HBox>
                    <Label fx:id="imagePathLabel" text="Aucune image sélectionnée"
                           style="-fx-text-fill: #9CA3AF; -fx-font-size: 12px;"/>
                    <StackPane fx:id="imagePreviewPane"
                               style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0;
                              -fx-border-radius: 12; -fx-background-radius: 12; -fx-border-width: 1.5;
                              -fx-effect: dropshadow(gaussian, rgba(27,67,50,0.06), 8, 0, 0, 2);"
                               minHeight="180" maxHeight="240" managed="false" visible="false">
                        <ImageView fx:id="imagePreview" fitWidth="9999" fitHeight="220"
                                   preserveRatio="false" smooth="true"/>
                        <Label fx:id="imagePreviewPlaceholder" text="Aperçu de l'image"
                               style="-fx-text-fill: #A0AEC0; -fx-font-size: 13px; -fx-font-style: italic;"/>
                    </StackPane>
                </VBox>

                <!-- ── Barre d'actions ── -->
                <HBox style="-fx-padding: 18 28 22 28; -fx-background-color: #F8FAFC;
                     -fx-border-color: #E2E8F0 transparent transparent transparent;
                     -fx-border-width: 1.5 0 0 0; -fx-background-radius: 0 0 18 18;"
                      spacing="12" alignment="CENTER_RIGHT">
                    <HBox spacing="8" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                        <HBox spacing="5" alignment="CENTER_LEFT"
                              style="-fx-background-color: #E8F5EE; -fx-background-radius: 8; -fx-padding: 5 10;">
                            <Label text="📧" style="-fx-font-size: 12px;"/>
                            <Label text="E-mail auto"
                                   style="-fx-font-size: 11px; -fx-font-weight: 600; -fx-text-fill: #1B4332;"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT"
                              style="-fx-background-color: #F0ECF8; -fx-background-radius: 8; -fx-padding: 5 10;">
                            <Label text="🔲" style="-fx-font-size: 12px;"/>
                            <Label text="QR Ticket auto"
                                   style="-fx-font-size: 11px; -fx-font-weight: 600; -fx-text-fill: #7B5EA7;"/>
                        </HBox>
                    </HBox>
                    <Button text="Annuler" onAction="#cancel"
                            style="-fx-background-color: #FFFFFF; -fx-text-fill: #5A6475;
                           -fx-font-size: 13px; -fx-font-weight: 600; -fx-background-radius: 10;
                           -fx-cursor: hand; -fx-padding: 10 22;
                           -fx-border-color: #CBD5E1; -fx-border-width: 1.5; -fx-border-radius: 10;"/>
                    <Button fx:id="saveBtn" text="✓  Enregistrer l'événement" onAction="#saveEvent"
                            style="-fx-background-color: linear-gradient(to bottom, #2D6A4F, #1B4332);
                           -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 700;
                           -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 10 24;
                           -fx-effect: dropshadow(gaussian, rgba(27,67,50,0.40), 14, 0, 0, 4);"/>
                </HBox>

            </VBox>

        </VBox>
    </content>
</ScrollPane>
