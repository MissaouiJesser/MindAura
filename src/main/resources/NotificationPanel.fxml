<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  Panneau de notifications — chargé dynamiquement dans le notifPanelContainer (HBox)
  Ouverture depuis la GAUCHE, intégré dans le layout (pas un overlay flottant).
  Controller : tn.esprit.controllers.NotificationPanelController
-->
<VBox fx:id="panelRoot"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.NotificationPanelController"
      prefWidth="370" maxWidth="370"
      style="-fx-background-color: white;
             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.22), 30, 0, 6, 0);
             -fx-background-radius: 0 16 16 0;"
      VBox.vgrow="ALWAYS">

    <!-- ─── HEADER ─────────────────────────────────────────────────────────── -->
    <VBox style="-fx-background-color: linear-gradient(to right, #1B4332, #2D6A4F);
                 -fx-padding: 22px 20px 16px 20px;
                 -fx-background-radius: 0 16 0 0;">

        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="🔔" style="-fx-font-size: 26px;"/>
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Notifications"
                       style="-fx-text-fill: white; -fx-font-size: 18px;
                              -fx-font-weight: 900; -fx-font-family: 'Poppins';"/>
                <Label fx:id="lblNonLues" text="0 non lue"
                       style="-fx-font-size: 11px; -fx-text-fill: #FF8C00; -fx-font-weight: 700;"/>
            </VBox>
            <Button fx:id="btnFermer" text="✕" onAction="#handleFermer"
                    style="-fx-background-color: rgba(255,255,255,0.18); -fx-text-fill: white;
                           -fx-font-size: 14px; -fx-font-weight: 900; -fx-padding: 6px 13px;
                           -fx-background-radius: 8px; -fx-cursor: hand;"/>
        </HBox>

        <HBox spacing="10" style="-fx-padding: 14px 0 0 0;">
            <Button text="✓ Tout marquer lu" onAction="#handleToutLu"
                    style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                           -fx-font-size: 10px; -fx-font-weight: 600; -fx-padding: 6px 14px;
                           -fx-background-radius: 8px; -fx-cursor: hand;"/>
            <Button text="🗑 Tout effacer" onAction="#handleToutEffacer"
                    style="-fx-background-color: rgba(255,140,0,0.22); -fx-text-fill: #FFB84D;
                           -fx-font-size: 10px; -fx-font-weight: 600; -fx-padding: 6px 14px;
                           -fx-background-radius: 8px; -fx-cursor: hand;"/>
        </HBox>
    </VBox>

    <!-- ─── LISTE ──────────────────────────────────────────────────────────── -->
    <ScrollPane fx:id="scroll" fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: #F9FAFB; -fx-background: #F9FAFB;
                      -fx-border-color: transparent;">
        <VBox fx:id="listeBox" spacing="10"
              style="-fx-padding: 16px 14px 24px 14px; -fx-background-color: #F9FAFB;"/>
    </ScrollPane>

</VBox>
