<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@style22.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.MesObjectifsController">

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--   NAVBAR — même style que MesResultats                            -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 18px 40px; -fx-background-color: linear-gradient(to bottom right, #1B4332 0%, #0D2B1F 100%);">

                <Region HBox.hgrow="ALWAYS" />

                <!-- Passer un Test -->
                <Button onAction="#handleNavigateToChoisirTest" style="-fx-background-color: linear-gradient(to bottom right, #059669, #047857);                                -fx-text-fill: white; -fx-font-weight: 700; -fx-font-size: 12px;                                -fx-background-radius: 12px; -fx-padding: 11px 18px; -fx-cursor: hand;                                -fx-effect: dropshadow(gaussian, rgba(5,150,105,0.5), 10, 0, 0, 3);" text="📋  Passer un Test" />

                <!-- Mes Résultats -->
                <Button onAction="#handleNavigateToMesResultats" style="-fx-background-color: linear-gradient(to bottom right, #2563EB, #1D4ED8);                                -fx-text-fill: white; -fx-font-weight: 700; -fx-font-size: 12px;                                -fx-background-radius: 12px; -fx-padding: 11px 18px; -fx-cursor: hand;                                -fx-effect: dropshadow(gaussian, rgba(37,99,235,0.5), 10, 0, 0, 3);" text="📊  Mes Résultats" />

                <!-- Mes Objectifs — actif (surligné) -->
                <Button fx:id="btnMesObjectifs" style="-fx-background-color: linear-gradient(to bottom right, #9333EA, #7C3AED);                                -fx-text-fill: white; -fx-font-weight: 700; -fx-font-size: 12px;                                -fx-background-radius: 12px; -fx-padding: 11px 18px; -fx-cursor: hand;                                -fx-effect: dropshadow(gaussian, rgba(147,51,234,0.5), 10, 0, 0, 3);                                -fx-border-color: white; -fx-border-width: 2; -fx-border-radius: 12px;" text="🎯  Mes Objectifs" />

                <Region HBox.hgrow="ALWAYS" />

            </HBox>
        </VBox>
    </top>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--   CONTENU                                                         -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #F0F4F8; -fx-background: #F0F4F8;">
            <VBox spacing="20" style="-fx-padding: 25; -fx-background-color: #F0F4F8;">



                <!-- Lecture audio -->
                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 10; -fx-background-color: white; -fx-background-radius: 10;">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #1B4332;" text="🔊 Lecture Audio" />
                    <Button onAction="#lireDescription" style="-fx-background-color: #1B4332; -fx-text-fill: white;                                    -fx-padding: 8 16; -fx-background-radius: 8; -fx-cursor: hand;" text="▶ Lire la description" />
                    <Button onAction="#arreterLecture" style="-fx-background-color: #e74c3c; -fx-text-fill: white;                                    -fx-padding: 8 16; -fx-background-radius: 8; -fx-cursor: hand;" text="⏹ Arrêter" />
                </HBox>

                <!-- Titre liste -->
                <Label style="-fx-font-size: 16; -fx-font-weight: bold;                               -fx-text-fill: #2d3748; -fx-padding: 10 0 0 5;" text="Liste de vos objectifs adoptés" />

                <!-- ListView -->
                <ListView fx:id="listViewObjectifs" prefHeight="280" style="-fx-font-size: 14; -fx-background-color: white;                                  -fx-background-radius: 10;                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);" />
                <HBox fx:id="paginationContainer" alignment="CENTER" style="-fx-padding: 8 0 0 0;" />

                <!-- ═══════════════════════════════════════════ -->
                <!--   CHATBOT IA                               -->
                <!-- ═══════════════════════════════════════════ -->
                <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 12;                              -fx-border-color: #1B4332; -fx-border-width: 1.5;                              -fx-border-radius: 12;                              -fx-effect: dropshadow(gaussian, rgba(27,67,50,0.15), 12, 0, 0, 3);                              -fx-padding: 18;">

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1B4332;" text="💬 Assistant IA — Développement Personnel" />
                        <Region HBox.hgrow="ALWAYS" />
                        <ProgressIndicator fx:id="chatLoading" prefHeight="25" prefWidth="25" visible="false" />
                    </HBox>

                    <Label style="-fx-text-fill: #888; -fx-font-size: 12; -fx-wrap-text: true;" text="Posez une question sur vos objectifs ou votre développement personnel." />

                    <TextArea fx:id="chatArea" editable="false" prefHeight="200" promptText="La conversation apparaîtra ici..." style="-fx-font-size: 13; -fx-background-color: #F0FAF4;                                      -fx-border-color: #b7e4c7; -fx-border-radius: 8;                                      -fx-background-radius: 8;" wrapText="true" />

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <TextField fx:id="chatInput" onKeyPressed="#handleKeyPress" promptText="Écrivez votre message ici..." style="-fx-padding: 10; -fx-border-color: #b7e4c7;                                           -fx-border-radius: 8; -fx-background-radius: 8;                                           -fx-font-size: 13;" HBox.hgrow="ALWAYS" />
                        <Button onAction="#envoyerMessage" style="-fx-background-color: #1B4332; -fx-text-fill: white;                                        -fx-font-weight: bold; -fx-padding: 10 18;                                        -fx-background-radius: 8; -fx-cursor: hand;                                        -fx-font-size: 13;" text="Envoyer ➤" />
                    </HBox>

                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
