<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<!-- ═══════════════════════════════════════════════════════════════════════════
     AjouterSalle.fxml — Design aligné sur AjouterLocal
     Tous les fx:id correspondent exactement à AjouterSalleController.java :
       txtNom, txtType, txtCapacite, txtEquipements, comboDisponibilite,
       txtEtage, txtImageURL, comboStatut, comboLocal,
       btnParcourir, btnEnregistrer, btnAnnuler,
       lblMessage, imgPreview, lblTitre
     ════════════════════════════════════════════════════════════════════════ -->

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.AjouterSalleController"
      style="-fx-background-color: #F0F4F8;"
      spacing="0">

    <!-- ══════════════════════════ HEADER ══════════════════════════════════ -->
    <HBox spacing="15" alignment="CENTER_LEFT"
          style="-fx-padding: 18px 30px;
                 -fx-background-color: white;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 2);">

        <!-- Bouton retour — déclenche handleAnnuler (ferme la fenêtre modale) -->
        <Button text="← Retour" onAction="#handleAnnuler"
                style="-fx-background-color: transparent;
                       -fx-border-color: #D8E9E4; -fx-border-width: 1.5px;
                       -fx-border-radius: 10px; -fx-background-radius: 10px;
                       -fx-text-fill: #5A6475; -fx-font-size: 12px; -fx-font-weight: 600;
                       -fx-padding: 8px 18px; -fx-cursor: hand;"/>

        <!-- Titre — fx:id="lblTitre" modifié par setSalleToEdit() -->
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label fx:id="lblTitre" text="➕ Nouvelle Salle de Jeux"
                   style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #1A1A2E;"/>
            <Label text="Remplissez les informations de la salle"
                   style="-fx-font-size: 11px; -fx-text-fill: #5A6475;"/>
        </VBox>

        <!-- Annuler — fx:id="btnAnnuler" utilisé dans handleAnnuler() -->
        <Button fx:id="btnAnnuler" text="✖ Annuler" onAction="#handleAnnuler"
                style="-fx-background-color: transparent;
                       -fx-border-color: #B91C1C; -fx-border-width: 1.5px;
                       -fx-border-radius: 10px; -fx-background-radius: 10px;
                       -fx-text-fill: #B91C1C; -fx-font-size: 12px; -fx-font-weight: 600;
                       -fx-padding: 8px 18px; -fx-cursor: hand;"/>
    </HBox>

    <!-- ══════════════════════════ CORPS (ScrollPane) ══════════════════════ -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox spacing="20" style="-fx-padding: 25px 30px;">

            <!-- ── Section 1 : Informations de Base ─────────────────────── -->
            <VBox spacing="15"
                  style="-fx-background-color: white; -fx-background-radius: 16px;
                         -fx-padding: 25px;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 15, 0, 0, 3);">
                <Label text="📋 Informations de Base"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1A1A2E;"/>
                <Separator style="-fx-background-color: #D8E9E4;"/>
                <GridPane hgap="20" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>

                    <!-- Nom — fx:id="txtNom" -->
                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Nom de la salle *"
                               style="-fx-font-weight: bold; -fx-text-fill: #1A1A2E; -fx-font-size: 12px;"/>
                        <TextField fx:id="txtNom" promptText="Ex: Salle Ibn Rushd"
                                   style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px;
                                          -fx-padding: 12px; -fx-border-color: #D8E9E4;
                                          -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                    </VBox>

                    <!-- Type — fx:id="txtType" -->
                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Type *"
                               style="-fx-font-weight: bold; -fx-text-fill: #1A1A2E; -fx-font-size: 12px;"/>
                        <TextField fx:id="txtType" promptText="Ex: Consultation, Thérapie de groupe..."
                                   style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px;
                                          -fx-padding: 12px; -fx-border-color: #D8E9E4;
                                          -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                    </VBox>

                    <!-- Capacité — fx:id="txtCapacite" -->
                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Capacité *"
                               style="-fx-font-weight: bold; -fx-text-fill: #1A1A2E; -fx-font-size: 12px;"/>
                        <TextField fx:id="txtCapacite" promptText="Ex: 10"
                                   style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px;
                                          -fx-padding: 12px; -fx-border-color: #D8E9E4;
                                          -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                    </VBox>

                    <!-- Étage — fx:id="txtEtage" (TextField car stocke du texte) -->
                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Étage"
                               style="-fx-font-weight: bold; -fx-text-fill: #1A1A2E; -fx-font-size: 12px;"/>
                        <TextField fx:id="txtEtage" promptText="Ex: RDC, 1er étage, 2ème étage..."
                                   style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px;
                                          -fx-padding: 12px; -fx-border-color: #D8E9E4;
                                          -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                    </VBox>

                    <!-- Équipements — fx:id="txtEquipements" (pleine largeur) -->
                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
                        <Label text="Équipements"
                               style="-fx-font-weight: bold; -fx-text-fill: #1A1A2E; -fx-font-size: 12px;"/>
                        <TextArea fx:id="txtEquipements"
                                  promptText="Ex: Tableau, projecteur, climatiseur..."
                                  prefRowCount="3" wrapText="true"
                                  style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px;
                                         -fx-padding: 12px; -fx-border-color: #D8E9E4;
                                         -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                    </VBox>
                </GridPane>
            </VBox>

            <!-- ── Section 2 : Paramètres ───────────────────────────────── -->
            <VBox spacing="15"
                  style="-fx-background-color: white; -fx-background-radius: 16px;
                         -fx-padding: 25px;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 15, 0, 0, 3);">
                <Label text="⚙️ Paramètres de la Salle"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1A1A2E;"/>
                <Separator style="-fx-background-color: #D8E9E4;"/>
                <GridPane hgap="20" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>

                    <!-- Disponibilité — fx:id="comboDisponibilite" peuplé dans initialize() -->
                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Disponibilité *"
                               style="-fx-font-weight: bold; -fx-text-fill: #1A1A2E; -fx-font-size: 12px;"/>
                        <ComboBox fx:id="comboDisponibilite" maxWidth="Infinity"
                                  style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px;
                                         -fx-border-color: #D8E9E4; -fx-border-radius: 10px;
                                         -fx-border-width: 1.5px;"/>
                    </VBox>

                    <!-- Statut — fx:id="comboStatut" peuplé dans initialize() -->
                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Statut"
                               style="-fx-font-weight: bold; -fx-text-fill: #1A1A2E; -fx-font-size: 12px;"/>
                        <ComboBox fx:id="comboStatut" maxWidth="Infinity"
                                  style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px;
                                         -fx-border-color: #D8E9E4; -fx-border-radius: 10px;
                                         -fx-border-width: 1.5px;"/>
                    </VBox>

                    <!-- Local parent — fx:id="comboLocal" peuplé par chargerLocaux() -->
                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                        <Label text="Local *"
                               style="-fx-font-weight: bold; -fx-text-fill: #1A1A2E; -fx-font-size: 12px;"/>
                        <ComboBox fx:id="comboLocal" maxWidth="Infinity"
                                  style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px;
                                         -fx-border-color: #D8E9E4; -fx-border-radius: 10px;
                                         -fx-border-width: 1.5px;"/>
                    </VBox>
                </GridPane>
            </VBox>

            <!-- ── Section 3 : Image ────────────────────────────────────── -->
            <VBox spacing="15"
                  style="-fx-background-color: white; -fx-background-radius: 16px;
                         -fx-padding: 25px;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 15, 0, 0, 3);">
                <Label text="🖼 Image de la Salle"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1A1A2E;"/>
                <Separator style="-fx-background-color: #D8E9E4;"/>
                <GridPane hgap="20" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="60"/>
                        <ColumnConstraints percentWidth="40"/>
                    </columnConstraints>

                    <!-- Sélection fichier -->
                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Chemin de l'image"
                               style="-fx-font-weight: bold; -fx-text-fill: #1A1A2E; -fx-font-size: 12px;"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <!-- fx:id="txtImageURL" + editable=false comme dans l'original -->
                            <TextField fx:id="txtImageURL"
                                       promptText="Sélectionner une image..."
                                       HBox.hgrow="ALWAYS" editable="false"
                                       style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px;
                                              -fx-padding: 12px; -fx-border-color: #D8E9E4;
                                              -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                            <!-- fx:id="btnParcourir" onAction="#handleParcourir" -->
                            <Button fx:id="btnParcourir" text="📂 Parcourir" onAction="#handleParcourir"
                                    style="-fx-background-color: transparent;
                                           -fx-border-color: #2D6A4F; -fx-border-width: 2px;
                                           -fx-border-radius: 10px; -fx-text-fill: #1B4332;
                                           -fx-font-weight: 700; -fx-background-radius: 10px;
                                           -fx-padding: 10px 16px; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>

                    <!-- Aperçu image — fx:id="imgPreview" mis à jour par handleParcourir() -->
                    <VBox spacing="8" alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="0"
                          style="-fx-background-color: #F0F4F8; -fx-padding: 15px;
                                 -fx-background-radius: 10px;
                                 -fx-border-color: #D8E9E4; -fx-border-width: 1.5px;
                                 -fx-border-radius: 10px; -fx-border-style: dashed;">
                        <Label text="📷 Aperçu"
                               style="-fx-font-size: 12px; -fx-text-fill: #5A6475; -fx-font-weight: 600;"/>
                        <ImageView fx:id="imgPreview" fitWidth="160" fitHeight="110" preserveRatio="true"/>
                    </VBox>
                </GridPane>
            </VBox>

            <!-- Message feedback — fx:id="lblMessage" mis à jour par showMessage() -->
            <Label fx:id="lblMessage" text="" wrapText="true"
                   style="-fx-font-size: 14px; -fx-padding: 12px 20px; -fx-background-radius: 10px;"/>

        </VBox>
    </ScrollPane>

    <!-- ══════════════════════════ BARRE BOUTONS BAS ═══════════════════════ -->
    <HBox spacing="15" alignment="CENTER"
          style="-fx-background-color: white; -fx-padding: 20px 30px;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, -2);">
        <!-- btnAnnuler — référencé dans handleAnnuler() via btnAnnuler.getScene() -->
        <Button fx:id="btnAnnuler" text="✖ Annuler" onAction="#handleAnnuler" prefWidth="160"
                style="-fx-background-color: transparent;
                       -fx-border-color: #5A6475; -fx-border-width: 2px;
                       -fx-border-radius: 10px; -fx-text-fill: #5A6475;
                       -fx-font-size: 14px; -fx-font-weight: bold;
                       -fx-background-radius: 10px; -fx-padding: 14px 28px; -fx-cursor: hand;"/>
        <!-- btnEnregistrer — référencé dans handleEnregistrer() -->
        <Button fx:id="btnEnregistrer" text="✓ Enregistrer la Salle" onAction="#handleEnregistrer" prefWidth="240"
                style="-fx-background-color: linear-gradient(to right, #1B4332, #2D6A4F);
                       -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;
                       -fx-background-radius: 10px; -fx-padding: 14px 28px; -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian, rgba(27,67,50,0.3), 12, 0, 0, 3);"/>
    </HBox>

</VBox>
