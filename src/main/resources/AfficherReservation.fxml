<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.shape.Circle?>

<!-- ═════════════════════════════════════════════════════════════════════════════
     AfficherReservation.fxml — DRAWER NOTIFICATIONS GAUCHE

     Architecture :
     • VBox (root)
       └── HBox (contentWrapper)
             ├── VBox (notifPanelContainer) ← panneau notifications injecté ici
             └── StackPane                  ← contenu principal (liste / formulaire)
     ════════════════════════════════════════════════════════════════════════════ -->

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.AfficherReservationController"
      stylesheets="@style.css"
      style="-fx-background-color: #F0F4F8;"
      spacing="0">

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- WRAPPER PRINCIPAL : drawer à gauche + contenu à droite                 -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <HBox VBox.vgrow="ALWAYS" spacing="0">

        <!-- ── CONTENEUR DU PANNEAU NOTIFICATIONS (caché par défaut, largeur 0) ── -->
        <VBox fx:id="notifPanelContainer"
              prefWidth="0" minWidth="0" maxWidth="0"
              style="-fx-background-color: transparent;"
              VBox.vgrow="ALWAYS"/>

        <!-- ── CONTENU PRINCIPAL ────────────────────────────────────────────── -->
        <StackPane HBox.hgrow="ALWAYS">

            <!-- ─────────────────────── VUE LISTE (défaut visible) ─────────── -->
            <VBox fx:id="vueListe" spacing="0" style="-fx-background-color: #F0F4F8;">

                <!-- Header -->
                <HBox spacing="15" alignment="CENTER_LEFT"
                      style="-fx-padding: 20px 30px; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 2);">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                    </VBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button fx:id="btnExportPDF" text="📄 PDF" onAction="#handleExportPDF"
                                style="-fx-font-size: 12px; -fx-padding: 10px 18px; -fx-background-color: white; -fx-border-color: #D8E9E4; -fx-border-width: 1.5px; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-cursor: hand; -fx-text-fill: #1B4332; -fx-font-weight: 600;"/>
                        <Button fx:id="btnRafraichir" text="🔄" onAction="#handleRafraichir"
                                style="-fx-font-size: 15px; -fx-padding: 10px 14px; -fx-background-color: white; -fx-border-color: #D8E9E4; -fx-border-width: 1.5px; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-cursor: hand;"/>
                        <!-- Notification bell -->
                        <StackPane onMouseClicked="#handleToggleNotifications" style="-fx-cursor: hand;">
                            <Button fx:id="btnNotification" text="🔔"
                                    style="-fx-background-color: linear-gradient(to bottom right, #1B4332, #2D6A4F); -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 10px 14px; -fx-background-radius: 10px; -fx-cursor: hand;"/>
                            <Label fx:id="badgeNotification" text="0"
                                   StackPane.alignment="TOP_RIGHT"
                                   translateX="6" translateY="-6"
                                   visible="false" managed="false"
                                   style="-fx-background-color: #E53E3E; -fx-text-fill: white; -fx-font-size: 9px; -fx-font-weight: 900; -fx-padding: 2px 6px; -fx-background-radius: 10px; -fx-min-width: 18px;"/>
                        </StackPane>
                        <Button fx:id="btnAjouter" text="➕ Nouvelle Réservation" onAction="#handleAjouterReservation"
                                style="-fx-font-size: 12px; -fx-padding: 10px 18px; -fx-background-color: linear-gradient(to right, #1B4332, #2D6A4F); -fx-text-fill: white; -fx-font-weight: 700; -fx-background-radius: 10px; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(27,67,50,0.3), 12, 0, 0, 3);"/>
                    </HBox>
                </HBox>

                <!-- KPI Statistics -->
                <HBox spacing="15" style="-fx-padding: 20px 30px 10px 30px;">
                    <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-padding: 18px; -fx-background-color: white; -fx-background-radius: 14px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 12, 0, 0, 3);">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <StackPane style="-fx-background-color: rgba(27,67,50,0.12); -fx-background-radius: 10px; -fx-pref-width: 44px; -fx-pref-height: 44px;">
                                <Label text="📊" style="-fx-font-size: 22px;"/>
                            </StackPane>
                            <VBox spacing="3">
                                <Label fx:id="totalReservationsLabel" text="0" style="-fx-font-size: 22px; -fx-text-fill: #1A1A2E; -fx-font-weight: 900;"/>
                                <Label text="Total Réservations" style="-fx-font-size: 11px; -fx-text-fill: #5A6475; -fx-font-weight: 600;"/>
                            </VBox>
                        </HBox>
                    </VBox>
                    <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-padding: 18px; -fx-background-color: white; -fx-background-radius: 14px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 12, 0, 0, 3);">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <StackPane style="-fx-background-color: rgba(45,106,79,0.15); -fx-background-radius: 10px; -fx-pref-width: 44px; -fx-pref-height: 44px;">
                                <Label text="✓" style="-fx-font-size: 22px; -fx-text-fill: #2D6A4F; -fx-font-weight: bold;"/>
                            </StackPane>
                            <VBox spacing="3">
                                <Label fx:id="totalConfirmeesLabel" text="0" style="-fx-font-size: 22px; -fx-text-fill: #1B4332; -fx-font-weight: 900;"/>
                                <Label text="Confirmées" style="-fx-font-size: 11px; -fx-text-fill: #5A6475; -fx-font-weight: 600;"/>
                            </VBox>
                        </HBox>
                    </VBox>
                    <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-padding: 18px; -fx-background-color: white; -fx-background-radius: 14px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 12, 0, 0, 3);">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <StackPane style="-fx-background-color: rgba(255,140,0,0.12); -fx-background-radius: 10px; -fx-pref-width: 44px; -fx-pref-height: 44px;">
                                <Label text="⏳" style="-fx-font-size: 22px;"/>
                            </StackPane>
                            <VBox spacing="3">
                                <Label fx:id="totalEnAttenteLabel" text="0" style="-fx-font-size: 22px; -fx-text-fill: #7B5EA7; -fx-font-weight: 900;"/>
                                <Label text="En Attente" style="-fx-font-size: 11px; -fx-text-fill: #5A6475; -fx-font-weight: 600;"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Search & Filters -->
                <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 10px 30px;">
                    <TextField fx:id="searchField" promptText="🔍 Rechercher par nom, prénom..."
                               HBox.hgrow="ALWAYS"
                               style="-fx-font-size: 12px; -fx-padding: 10px 15px; -fx-background-color: white; -fx-border-color: #D8E9E4; -fx-border-width: 1.5px; -fx-border-radius: 10px; -fx-background-radius: 10px;"/>
                    <ComboBox fx:id="filterStatutComboBox" promptText="Statut" prefWidth="160"
                              style="-fx-font-size: 12px; -fx-background-color: white; -fx-border-color: #D8E9E4; -fx-border-width: 1.5px; -fx-border-radius: 10px; -fx-background-radius: 10px;"/>
                    <ComboBox fx:id="filterMotifComboBox" promptText="Motif" prefWidth="210"
                              style="-fx-font-size: 12px; -fx-background-color: white; -fx-border-color: #D8E9E4; -fx-border-width: 1.5px; -fx-border-radius: 10px; -fx-background-radius: 10px;"/>
                </HBox>

                <!-- Table -->
                <VBox VBox.vgrow="ALWAYS" style="-fx-padding: 10px 30px 25px 30px;">
                    <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 16px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
                        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 16px 22px; -fx-border-color: #F0F4F8; -fx-border-width: 0 0 2 0;">
                            <StackPane style="-fx-background-color: rgba(255,140,0,0.1); -fx-background-radius: 10px; -fx-pref-width: 38px; -fx-pref-height: 38px;">
                                <Label text="📋" style="-fx-font-size: 18px;"/>
                            </StackPane>
                            <Label text="Liste des Réservations" style="-fx-font-size: 14px; -fx-text-fill: #1A1A2E; -fx-font-weight: 700;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <TableView fx:id="tableReservation" VBox.vgrow="ALWAYS" styleClass="modern-table">
                            <columns>
                                <TableColumn fx:id="colNomClient"       text="Nom Client"    prefWidth="120" minWidth="100"/>
                                <TableColumn fx:id="colPrenomClient"    text="Prénom Client" prefWidth="120" minWidth="100"/>
                                <TableColumn fx:id="colDateReservation" text="Date"          prefWidth="110" minWidth="90"/>
                                <TableColumn fx:id="colHeureDebut"      text="Heure Début"   prefWidth="100" minWidth="90"/>
                                <TableColumn fx:id="colHeureFin"        text="Heure Fin"     prefWidth="100" minWidth="90"/>
                                <TableColumn fx:id="colStatut"          text="Statut"        prefWidth="130" minWidth="110"/>
                                <TableColumn fx:id="colMotif"           text="Motif"         prefWidth="190" minWidth="150"/>
                                <TableColumn fx:id="colSalle"           text="Salle"         prefWidth="120" minWidth="100"/>
                                <TableColumn fx:id="colPrix"            text="Prix (DT)"     prefWidth="90"  minWidth="80"/>
                                <TableColumn fx:id="colActions"         text="Actions"       prefWidth="250" minWidth="220"/>
                            </columns>
                            <placeholder>
                                <VBox alignment="CENTER" spacing="12" style="-fx-padding: 40px;">
                                    <Label text="📭" style="-fx-font-size: 48px;"/>
                                    <Label text="Aucune réservation trouvée" style="-fx-font-family: 'Poppins'; -fx-font-size: 15px; -fx-font-weight: 600; -fx-text-fill: #5A6475;"/>
                                    <Label text="Ajoutez une nouvelle réservation avec le bouton ci-dessus" style="-fx-font-size: 12px; -fx-text-fill: #9CA3AF;"/>
                                </VBox>
                            </placeholder>
                        </TableView>
                    </VBox>
                </VBox>

            </VBox>
            <!-- ──────────────────────────────── FIN VUE LISTE ── -->

            <!-- ─────────────────────── VUE FORMULAIRE (caché par défaut) ─── -->
            <VBox fx:id="vueFormulaire" spacing="0"
                  visible="false" managed="false"
                  style="-fx-background-color: #F0F4F8;">

                <!-- Header formulaire -->
                <HBox spacing="15" alignment="CENTER_LEFT"
                      style="-fx-padding: 18px 30px; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 2);">
                    <Button text="← Retour" onAction="#handleRetourListe"
                            style="-fx-background-color: transparent; -fx-border-color: #D8E9E4; -fx-border-width: 1.5px; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-text-fill: #5A6475; -fx-font-size: 12px; -fx-font-weight: 600; -fx-padding: 8px 18px; -fx-cursor: hand;"/>
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label fx:id="lblTitreFormulaire" text="➕ Nouvelle Réservation"
                               style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #1A1A2E; -fx-font-family: 'Poppins';"/>
                        <Label fx:id="lblSousTitreFormulaire" text="Remplissez les informations de la réservation"
                               style="-fx-font-size: 11px; -fx-text-fill: #5A6475; -fx-font-family: 'Inter';"/>
                    </VBox>
                    <Button text="✖ Annuler" onAction="#handleRetourListe"
                            style="-fx-background-color: transparent; -fx-border-color: #B91C1C; -fx-border-width: 1.5px; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-text-fill: #B91C1C; -fx-font-size: 12px; -fx-font-weight: 600; -fx-padding: 8px 18px; -fx-cursor: hand;"/>
                </HBox>

                <!-- Corps scrollable -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background-color: transparent; -fx-background: transparent;">
                    <VBox spacing="20" style="-fx-padding: 25px 30px;">

                        <!-- Infos client -->
                        <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 16px; -fx-padding: 25px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 15, 0, 0, 3);">
                            <Label text="👤 Informations du Client" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1A1A2E;"/>
                            <Separator style="-fx-background-color: #D8E9E4;"/>
                            <GridPane hgap="20" vgap="15">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50"/>
                                    <ColumnConstraints percentWidth="50"/>
                                </columnConstraints>
                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="Nom *" style="-fx-font-weight: bold; -fx-text-fill: #1A1A2E; -fx-font-size: 12px;"/>
                                    <TextField fx:id="txtNomClient" promptText="Ex: Ben Ali"
                                               style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px; -fx-padding: 12px; -fx-border-color: #D8E9E4; -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                                </VBox>
                                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="Prénom *" style="-fx-font-weight: bold; -fx-text-fill: #1A1A2E; -fx-font-size: 12px;"/>
                                    <TextField fx:id="txtPrenomClient" promptText="Ex: Ahmed"
                                               style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px; -fx-padding: 12px; -fx-border-color: #D8E9E4; -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                                </VBox>
                            </GridPane>
                        </VBox>

                        <!-- Détails réservation -->
                        <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 16px; -fx-padding: 25px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 15, 0, 0, 3);">
                            <Label text="📋 Détails de la Réservation" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1A1A2E;"/>
                            <Separator style="-fx-background-color: #D8E9E4;"/>
                            <GridPane hgap="20" vgap="15">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50"/>
                                    <ColumnConstraints percentWidth="50"/>
                                </columnConstraints>
                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="Local *" style="-fx-font-weight: bold; -fx-text-fill: #1A1A2E; -fx-font-size: 12px;"/>
                                    <ComboBox fx:id="comboLocal" maxWidth="Infinity"
                                              style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px; -fx-border-color: #D8E9E4; -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                                </VBox>
                                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="Salle (optionnelle)" style="-fx-font-weight: bold; -fx-text-fill: #1A1A2E; -fx-font-size: 12px;"/>
                                    <ComboBox fx:id="comboSalle" maxWidth="Infinity"
                                              style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px; -fx-border-color: #D8E9E4; -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                                </VBox>
                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <Label text="Date de Réservation *" style="-fx-font-weight: bold; -fx-text-fill: #1A1A2E; -fx-font-size: 12px;"/>
                                    <DatePicker fx:id="dateReservation" maxWidth="Infinity"
                                                style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px; -fx-border-color: #D8E9E4; -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                                </VBox>

                                <!-- Heure début -->
                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                    <Label text="Heure de Début" style="-fx-font-weight: bold; -fx-text-fill: #1A1A2E; -fx-font-size: 12px;"/>
                                    <HBox spacing="8" alignment="CENTER_LEFT">
                                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                                            <Label text="Heure" style="-fx-font-size: 10px; -fx-text-fill: #5A6475;"/>
                                            <Spinner fx:id="spinnerHeureDebut" editable="true" maxWidth="Infinity"
                                                     style="-fx-background-color: #F8FAFC;"/>
                                        </VBox>
                                        <Label text=":" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1A1A2E; -fx-padding: 15px 0 0 0;"/>
                                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                                            <Label text="Min" style="-fx-font-size: 10px; -fx-text-fill: #5A6475;"/>
                                            <Spinner fx:id="spinnerMinuteDebut" editable="true" maxWidth="Infinity"
                                                     style="-fx-background-color: #F8FAFC;"/>
                                        </VBox>
                                    </HBox>
                                </VBox>

                                <!-- Heure fin -->
                                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                    <Label text="Heure de Fin" style="-fx-font-weight: bold; -fx-text-fill: #1A1A2E; -fx-font-size: 12px;"/>
                                    <HBox spacing="8" alignment="CENTER_LEFT">
                                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                                            <Label text="Heure" style="-fx-font-size: 10px; -fx-text-fill: #5A6475;"/>
                                            <Spinner fx:id="spinnerHeureFin" editable="true" maxWidth="Infinity"
                                                     style="-fx-background-color: #F8FAFC;"/>
                                        </VBox>
                                        <Label text=":" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1A1A2E; -fx-padding: 15px 0 0 0;"/>
                                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                                            <Label text="Min" style="-fx-font-size: 10px; -fx-text-fill: #5A6475;"/>
                                            <Spinner fx:id="spinnerMinuteFin" editable="true" maxWidth="Infinity"
                                                     style="-fx-background-color: #F8FAFC;"/>
                                        </VBox>
                                    </HBox>
                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="3">
                                    <Label text="Motif *" style="-fx-font-weight: bold; -fx-text-fill: #1A1A2E; -fx-font-size: 12px;"/>
                                    <ComboBox fx:id="comboMotif" maxWidth="Infinity"
                                              style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px; -fx-border-color: #D8E9E4; -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                                </VBox>
                                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                    <Label text="Statut *" style="-fx-font-weight: bold; -fx-text-fill: #1A1A2E; -fx-font-size: 12px;"/>
                                    <ComboBox fx:id="comboStatut" maxWidth="Infinity"
                                              style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px; -fx-border-color: #D8E9E4; -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                                </VBox>
                            </GridPane>
                        </VBox>

                        <!-- Prix calculé -->
                        <VBox spacing="10" alignment="CENTER"
                              style="-fx-background-color: linear-gradient(to right, #1B4332, #2D6A4F); -fx-background-radius: 16px; -fx-padding: 20px;">
                            <Label text="💰 Prix Calculé Automatiquement"
                                   style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.85); -fx-font-weight: 600;"/>
                            <Label fx:id="lblPrixCalcule" text="0 DT"
                                   style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                            <Label text="(basé sur les heures de début et de fin)"
                                   style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.65);"/>
                        </VBox>

                        <!-- Message -->
                        <Label fx:id="lblMessage" text="" wrapText="true"
                               style="-fx-font-size: 13px; -fx-padding: 12px 20px; -fx-background-radius: 10px;"/>

                    </VBox>
                </ScrollPane>

                <!-- Boutons bas -->
                <HBox spacing="15" alignment="CENTER"
                      style="-fx-background-color: white; -fx-padding: 18px 30px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, -2);">
                    <Button text="✖ Annuler" onAction="#handleRetourListe" prefWidth="160"
                            style="-fx-background-color: transparent; -fx-border-color: #5A6475; -fx-border-width: 2px; -fx-border-radius: 10px; -fx-text-fill: #5A6475; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10px; -fx-padding: 14px 28px; -fx-cursor: hand;"/>
                    <Button fx:id="btnSauvegarder" text="✓ Enregistrer" onAction="#handleSauvegarderRes" prefWidth="220"
                            style="-fx-background-color: linear-gradient(to right, #1B4332, #2D6A4F); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10px; -fx-padding: 14px 28px; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(27,67,50,0.3), 12, 0, 0, 3);"/>
                </HBox>
            </VBox>
            <!-- ──────────────────────────────── FIN VUE FORMULAIRE ── -->

        </StackPane>
        <!-- ── FIN CONTENU PRINCIPAL ── -->

    </HBox>

</VBox>
