<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.FrontOfficeController"
            prefWidth="1920" prefHeight="1080"
            style="-fx-background-color: #F2F5F9;">

    <!-- ========== HEADER ========== -->
    <top>
        <VBox spacing="0">

            <!-- BARRE PRINCIPALE -->
            <HBox alignment="CENTER_LEFT" spacing="20"
                  style="-fx-background-color: linear-gradient(to right, #0D2B1E 0%, #1B4332 55%, #2D6A4F 100%);
                         -fx-padding: 18 44 18 44;
                         -fx-effect: dropshadow(gaussian, rgba(13,43,30,0.55), 25, 0, 0, 8);">

                <!-- Bouton retour -->
                <Button onAction="#retourAccueil"
                        style="-fx-background-color: rgba(255,255,255,0.12);
                               -fx-background-radius: 50; -fx-cursor: hand;
                               -fx-border-color: rgba(255,255,255,0.25); -fx-border-width: 1.5;
                               -fx-border-radius: 50; -fx-padding: 9 15;">
                    <graphic>
                        <Label text="←" style="-fx-font-size: 16px; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    </graphic>
                </Button>

                <Rectangle fill="rgba(255,255,255,0.2)" width="1.5" height="40" arcWidth="2" arcHeight="2"/>

                <!-- Logo + titre -->


                <Region HBox.hgrow="ALWAYS"/>

                <!-- Barre de recherche -->
                <HBox spacing="0" alignment="CENTER_LEFT"
                      style="-fx-background-color: white; -fx-background-radius: 28;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 10, 0, 0, 3);">
                    <Label text="🔍" style="-fx-font-size: 13px; -fx-padding: 0 4 0 14; -fx-opacity: 0.5;"/>
                    <TextField fx:id="searchFieldFront"
                               promptText="Rechercher des ressources..."
                               prefWidth="290"
                               style="-fx-background-color: transparent; -fx-border-color: transparent;
                                      -fx-padding: 12 8; -fx-font-size: 13px;
                                      -fx-text-fill: #1A2E25; -fx-prompt-text-fill: #9AA89F;"/>
                    <Button text="Rechercher"
                            onAction="#rechercherRessourcesFront"
                            style="-fx-background-color: #1B4332; -fx-text-fill: white;
                                   -fx-background-radius: 0 26 26 0; -fx-padding: 12 20;
                                   -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;"/>
                </HBox>

                <!-- Recommandations -->
                <Button onAction="#allerRecommandations"
                        style="-fx-background-color: rgba(167,243,208,0.15);
                               -fx-text-fill: #A7F3D0;
                               -fx-background-radius: 22;
                               -fx-border-color: rgba(167,243,208,0.35);
                               -fx-border-width: 1.5; -fx-border-radius: 22;
                               -fx-padding: 10 18; -fx-font-size: 12px;
                               -fx-cursor: hand; -fx-font-weight: bold;">
                    <graphic>
                        <HBox spacing="6" alignment="CENTER">
                            <Label text="✨" style="-fx-font-size: 13px;"/>
                            <Label text="Recommandations"
                                   style="-fx-text-fill: #A7F3D0; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                        </HBox>
                    </graphic>
                </Button>

                <!-- Favoris -->
                <Button fx:id="btnFavoris" onAction="#afficherFavoris"
                        style="-fx-background-color: rgba(255,255,255,0.12); -fx-text-fill: white;
                               -fx-background-radius: 22;
                               -fx-border-color: rgba(255,255,255,0.25); -fx-border-width: 1.5;
                               -fx-border-radius: 22; -fx-padding: 10 18;
                               -fx-font-size: 13px; -fx-cursor: hand; -fx-font-weight: bold;">
                    <graphic>
                        <HBox spacing="6" alignment="CENTER">
                            <Label text="☆" style="-fx-font-size: 14px; -fx-text-fill: white;"/>
                            <Label text="Mes favoris"
                                   style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        </HBox>
                    </graphic>
                </Button>


            </HBox>

            <!-- BARRE FILTRES + TRI -->
            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-background-color: linear-gradient(to bottom, #163B2A, #1B4332);
                         -fx-padding: 13 44 13 44;
                         -fx-border-color: transparent transparent rgba(255,255,255,0.08) transparent;
                         -fx-border-width: 0 0 1 0;">

                <!-- Tri -->
                <HBox spacing="8" alignment="CENTER"
                      style="-fx-background-color: rgba(255,255,255,0.10);
                             -fx-background-radius: 20; -fx-padding: 6 14;
                             -fx-border-color: rgba(255,255,255,0.15); -fx-border-width: 1;
                             -fx-border-radius: 20;">
                    <Label text="↕" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 14px;"/>
                    <Label text="Trier" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13px;"/>
                    <ComboBox fx:id="sortComboBox" promptText="Trier par..." prefWidth="140"
                              style="-fx-background-color: transparent; -fx-border-color: transparent;
                                     -fx-text-fill: white; -fx-font-size: 13px;"/>
                </HBox>

                <Rectangle fill="rgba(255,255,255,0.15)" width="1" height="28"/>

                <!-- Boutons de filtres -->
                <HBox fx:id="filterBoxFront" spacing="8" alignment="CENTER_LEFT">

                    <Button fx:id="btnFiltrerTous" text="TOUS" onAction="#filtrerTous"
                            style="-fx-background-color: white; -fx-text-fill: #1B4332;
                                   -fx-background-radius: 20; -fx-padding: 8 20;
                                   -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 6, 0, 0, 2);"/>

                    <Button fx:id="btnFiltrerVideo" onAction="#filtrerVideo"
                            style="-fx-background-color: rgba(255,255,255,0.12);
                                   -fx-text-fill: rgba(255,255,255,0.85);
                                   -fx-background-radius: 20; -fx-padding: 8 20;
                                   -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;
                                   -fx-border-color: rgba(255,255,255,0.20); -fx-border-width: 1;
                                   -fx-border-radius: 20;">
                        <graphic>
                            <HBox spacing="6" alignment="CENTER">
                                <Label text="🎬" style="-fx-font-size: 12px;"/>
                                <Label text="Vidéos"
                                       style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 13px;"/>
                            </HBox>
                        </graphic>
                    </Button>

                    <Button fx:id="btnFiltrerPDF" onAction="#filtrerPDF"
                            style="-fx-background-color: rgba(255,255,255,0.12);
                                   -fx-text-fill: rgba(255,255,255,0.85);
                                   -fx-background-radius: 20; -fx-padding: 8 20;
                                   -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;
                                   -fx-border-color: rgba(255,255,255,0.20); -fx-border-width: 1;
                                   -fx-border-radius: 20;">
                        <graphic>
                            <HBox spacing="6" alignment="CENTER">
                                <Label text="📄" style="-fx-font-size: 12px;"/>
                                <Label text="PDF"
                                       style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 13px;"/>
                            </HBox>
                        </graphic>
                    </Button>

                    <Button fx:id="btnFiltrerPodcast" onAction="#filtrerPodcast"
                            style="-fx-background-color: rgba(255,255,255,0.12);
                                   -fx-text-fill: rgba(255,255,255,0.85);
                                   -fx-background-radius: 20; -fx-padding: 8 20;
                                   -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;
                                   -fx-border-color: rgba(255,255,255,0.20); -fx-border-width: 1;
                                   -fx-border-radius: 20;">
                        <graphic>
                            <HBox spacing="6" alignment="CENTER">
                                <Label text="🎧" style="-fx-font-size: 12px;"/>
                                <Label text="Podcasts"
                                       style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 13px;"/>
                            </HBox>
                        </graphic>
                    </Button>

                    <Button fx:id="btnFiltrerText" onAction="#filtrerText"
                            style="-fx-background-color: rgba(255,255,255,0.12);
                                   -fx-text-fill: rgba(255,255,255,0.85);
                                   -fx-background-radius: 20; -fx-padding: 8 20;
                                   -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;
                                   -fx-border-color: rgba(255,255,255,0.20); -fx-border-width: 1;
                                   -fx-border-radius: 20;">
                        <graphic>
                            <HBox spacing="6" alignment="CENTER">
                                <Label text="📰" style="-fx-font-size: 12px;"/>
                                <Label text="Articles"
                                       style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 13px;"/>
                            </HBox>
                        </graphic>
                    </Button>

                </HBox>

            </HBox>

        </VBox>
    </top>

    <!-- ========== CONTENU PRINCIPAL ========== -->
    <center>
        <VBox spacing="0" style="-fx-background-color: #F2F5F9;">

            <!-- Bandeau résultats -->
            <HBox alignment="CENTER_LEFT" spacing="14"
                  style="-fx-background-color: white; -fx-padding: 16 44;
                         -fx-border-color: transparent transparent #E8EDEA transparent;
                         -fx-border-width: 0 0 1 0;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 8, 0, 0, 3);">

                <Label fx:id="resultatsLabel"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0D2B1E;"/>
                <Label fx:id="nombreLabel"
                       style="-fx-font-size: 12.5px; -fx-text-fill: #2D6A4F; -fx-font-weight: bold;
                              -fx-background-color: #E0F2EB; -fx-background-radius: 20; -fx-padding: 4 12;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="Prenez soin de vous ✨"
                       style="-fx-text-fill: #7A8B7F; -fx-font-size: 12px; -fx-font-style: italic;"/>
            </HBox>

            <!--
                ✅ ScrollPane → VBox padding → FlowPane racine (contentFlowFront)
                Le contrôleur insère dans contentFlowFront UN SEUL VBox (mainContainer) qui contient :
                  • VBox podcastsSection   → podcasts empilés verticalement (pleine largeur)
                  • FlowPane grilleVideos  → cartes 300px en grille
                  • FlowPane grillePDF     → cartes 300px en grille
                  • FlowPane grilleArticles→ cartes 300px en grille
                Ainsi chaque type s'affiche proprement dans son ordre, sans mélange.
            -->
            <ScrollPane fx:id="scrollPaneFront"
                        fitToWidth="true" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER"
                        style="-fx-background-color: transparent; -fx-background: #F2F5F9;
                               -fx-border-color: transparent;"
                        VBox.vgrow="ALWAYS">
                <content>
                    <VBox style="-fx-background-color: #F2F5F9;">
                        <!--
                            padding géré via setPadding() dans initialize()
                            prefWrapLength très large pour éviter tout retour à la ligne au niveau racine
                        -->
                        <FlowPane fx:id="contentFlowFront"
                                  hgap="0" vgap="0"
                                  alignment="TOP_LEFT"
                                  prefWrapLength="1800"
                                  style="-fx-background-color: transparent;"/>
                    </VBox>
                </content>
            </ScrollPane>

        </VBox>
    </center>



</BorderPane>
