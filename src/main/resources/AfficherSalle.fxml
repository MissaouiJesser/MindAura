                                    <Label fx:id="detailStatut" text="" GridPane.columnIndex="1" GridPane.rowIndex="3"
                                           style="-fx-text-fill: #1A1A2E; -fx-font-weight: 700; -fx-font-size: 12px;"/>

                                    <Label text="Local :" GridPane.rowIndex="4"
                                           style="-fx-text-fill: #5A6475; -fx-font-weight: 600; -fx-font-size: 12px;"/>
                                    <Label fx:id="detailLocal" text="" GridPane.columnIndex="1" GridPane.rowIndex="4"
                                           style="-fx-text-fill: #1B4332; -fx-font-weight: 700; -fx-font-size: 12px;"/>
                                </GridPane>
                            </VBox>

                            <!-- Équipements -->
                            <VBox spacing="10"
                                  style="-fx-background-color: white; -fx-background-radius: 16px;
