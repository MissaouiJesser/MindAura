<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.AfficherSalleController"
      style="-fx-background-color: #F0F4F8;" spacing="0">

    <StackPane VBox.vgrow="ALWAYS">

        <!-- ═══════════════════════════════════════════════════════
             VUE LISTE
             ═══════════════════════════════════════════════════════ -->
        <VBox fx:id="vueListe" spacing="0" style="-fx-background-color: #F0F4F8;">

            <!-- HEADER -->
            <HBox spacing="15" alignment="CENTER_LEFT"
                  style="-fx-padding: 20px 30px; -fx-background-color: white;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 2);">

                <HBox spacing="0" alignment="CENTER_LEFT"
                      style="-fx-background-color: #F8FAFC; -fx-border-color: #D8E9E4;
                             -fx-border-width: 1.5px; -fx-border-radius: 12px;
                             -fx-background-radius: 12px; -fx-padding: 0 15px;
                             -fx-pref-width: 300px; -fx-pref-height: 42px;">
                    <Label text="🔍 " style="-fx-text-fill: #9CA3AF; -fx-font-size: 14px;"/>
                    <TextField fx:id="txtRecherche" promptText="Rechercher une salle..."
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color: transparent; -fx-border-color: transparent;
                                      -fx-font-size: 12px; -fx-prompt-text-fill: #9CA3AF;"/>
                </HBox>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <VBox spacing="5">
                        <Label text="TYPE" style="-fx-text-fill: #5A6475; -fx-font-weight: bold; -fx-font-size: 9px;"/>
                        <ComboBox fx:id="filterTypeComboBox" prefWidth="140"
                                  style="-fx-font-size: 11px; -fx-background-color: white;
                                         -fx-border-color: #D8E9E4; -fx-border-width: 1.5px;
                                         -fx-border-radius: 10px; -fx-background-radius: 10px;"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label text="STATUT" style="-fx-text-fill: #5A6475; -fx-font-weight: bold; -fx-font-size: 9px;"/>
                        <ComboBox fx:id="filterStatutComboBox" prefWidth="130"
                                  style="-fx-font-size: 11px; -fx-background-color: white;
                                         -fx-border-color: #D8E9E4; -fx-border-width: 1.5px;
                                         -fx-border-radius: 10px; -fx-background-radius: 10px;"/>
                    </VBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox spacing="10" alignment="CENTER">
                    <Button fx:id="btnRafraichir" text="🔄" onAction="#handleRafraichir"
                            style="-fx-font-size: 15px; -fx-padding: 10px 14px;
                                   -fx-background-color: white; -fx-border-color: #D8E9E4;
                                   -fx-border-width: 1.5px; -fx-border-radius: 10px;
                                   -fx-background-radius: 10px; -fx-cursor: hand;"/>
                    <Button fx:id="btnAjouter" text="➕ Nouvelle Salle" onAction="#handleAjouterSalle"
                            style="-fx-font-size: 12px; -fx-padding: 10px 18px;
                                   -fx-background-color: linear-gradient(to right, #1B4332, #2D6A4F);
                                   -fx-text-fill: white; -fx-font-weight: 700;
                                   -fx-background-radius: 10px; -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(27,67,50,0.3), 12, 0, 0, 3);"/>
                </HBox>
            </HBox>

            <!-- KPI + TABLE -->
            <VBox spacing="20" VBox.vgrow="ALWAYS" style="-fx-padding: 25px 30px;">

                <!-- KPI Cards -->
                <HBox spacing="15">
                    <VBox spacing="12" HBox.hgrow="ALWAYS"
                          style="-fx-padding: 20px; -fx-background-color: white;
                                 -fx-background-radius: 16px;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <StackPane style="-fx-pref-width: 52px; -fx-pref-height: 52px;
                                              -fx-background-color: rgba(107,70,193,0.12);
                                              -fx-background-radius: 12px;">
                                <Label text="🏠" style="-fx-font-size: 26px;"/>
                            </StackPane>
                            <VBox spacing="4">
                                <Label fx:id="lblTotal" text="0"
                                       style="-fx-font-size: 24px; -fx-text-fill: #1A1A2E; -fx-font-weight: 900;"/>
                                <Label text="Salles Enregistrées"
                                       style="-fx-font-size: 11px; -fx-text-fill: #5A6475; -fx-font-weight: 600;"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox spacing="12" HBox.hgrow="ALWAYS"
                          style="-fx-padding: 20px; -fx-background-color: white;
                                 -fx-background-radius: 16px;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <StackPane style="-fx-pref-width: 52px; -fx-pref-height: 52px;
                                              -fx-background-color: rgba(45,106,79,0.15);
                                              -fx-background-radius: 12px;">
                                <Label text="✓" style="-fx-font-size: 26px; -fx-text-fill: #2D6A4F;"/>
                            </StackPane>
                            <VBox spacing="4">
                                <Label fx:id="lblDisponibles" text="0"
                                       style="-fx-font-size: 24px; -fx-text-fill: #1A1A2E; -fx-font-weight: 900;"/>
                                <Label text="Disponibles"
                                       style="-fx-font-size: 11px; -fx-text-fill: #5A6475; -fx-font-weight: 600;"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox spacing="12" HBox.hgrow="ALWAYS"
                          style="-fx-padding: 20px; -fx-background-color: white;
                                 -fx-background-radius: 16px;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <StackPane style="-fx-pref-width: 52px; -fx-pref-height: 52px;
                                              -fx-background-color: rgba(185,28,28,0.12);
                                              -fx-background-radius: 12px;">
                                <Label text="🔒" style="-fx-font-size: 26px;"/>
                            </StackPane>
                            <VBox spacing="4">
                                <Label fx:id="lblOccupees" text="0"
                                       style="-fx-font-size: 24px; -fx-text-fill: #1A1A2E; -fx-font-weight: 900;"/>
                                <Label text="Hors service / Maintenance"
                                       style="-fx-font-size: 11px; -fx-text-fill: #5A6475; -fx-font-weight: 600;"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Table Card -->
                <VBox VBox.vgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 16px;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">

                    <HBox alignment="CENTER_LEFT" spacing="12"
                          style="-fx-padding: 18px 22px; -fx-border-color: #F0F4F8; -fx-border-width: 0 0 2 0;">
                        <StackPane style="-fx-background-color: rgba(45,106,79,0.1);
                                          -fx-background-radius: 10px;
                                          -fx-pref-width: 40px; -fx-pref-height: 40px;">
                            <Label text="🏠" style="-fx-font-size: 20px;"/>
                        </StackPane>
                        <Label text="Liste des Salles"
                               style="-fx-font-size: 15px; -fx-text-fill: #1A1A2E; -fx-font-weight: 700;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblFooter" text=""
                               style="-fx-text-fill: #5A6475; -fx-font-size: 10px;"/>
                    </HBox>

                    <TableView fx:id="tableSalles" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colImage"        text="Photo"         prefWidth="75"/>
                            <TableColumn fx:id="colNom"          text="Nom"           prefWidth="130"/>
                            <TableColumn fx:id="colType"         text="Type"          prefWidth="115"/>
                            <TableColumn fx:id="colCapacite"     text="Capacité"      prefWidth="75"/>
                            <TableColumn fx:id="colEquipements"  text="Équipements"   prefWidth="140"/>
                            <TableColumn fx:id="colDisponibilite" text="Disponibilité" prefWidth="110"/>
                            <TableColumn fx:id="colEtage"        text="Étage"         prefWidth="65"/>
                            <TableColumn fx:id="colStatut"       text="Statut"        prefWidth="100"/>
                            <TableColumn fx:id="colNomLocal"     text="Local"         prefWidth="120"/>
                            <TableColumn fx:id="colActions"      text="Actions"       prefWidth="210"/>
                        </columns>
                        <placeholder>
                            <Label text="Aucune salle trouvée."
                                   style="-fx-font-size: 14px; -fx-text-fill: #9CA3AF;"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </VBox>
        </VBox>

        <!-- ═══════════════════════════════════════════════════════
             VUE FORMULAIRE
             ═══════════════════════════════════════════════════════ -->
        <VBox fx:id="vueFormulaire" spacing="0"
              visible="false" managed="false"
              style="-fx-background-color: #F0F4F8;">

            <!-- Header -->
            <HBox spacing="15" alignment="CENTER_LEFT"
                  style="-fx-padding: 18px 30px; -fx-background-color: white;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 2);">
                <Button text="← Retour" onAction="#handleRetourListe"
                        style="-fx-background-color: transparent; -fx-border-color: #D8E9E4;
                               -fx-border-width: 1.5px; -fx-border-radius: 10px;
                               -fx-background-radius: 10px; -fx-text-fill: #5A6475;
                               -fx-font-size: 12px; -fx-font-weight: 600;
                               -fx-padding: 8px 18px; -fx-cursor: hand;"/>
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label fx:id="lblTitreFormulaire" text="➕ Nouvelle Salle"
                           style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #1A1A2E;"/>
                    <Label fx:id="lblSousTitreFormulaire" text=""
                           style="-fx-font-size: 11px; -fx-text-fill: #5A6475;"/>
                </VBox>
                <Button text="✖ Annuler" onAction="#handleRetourListe"
                        style="-fx-background-color: transparent; -fx-border-color: #B91C1C;
                               -fx-border-width: 1.5px; -fx-border-radius: 10px;
                               -fx-background-radius: 10px; -fx-text-fill: #B91C1C;
                               -fx-font-size: 12px; -fx-font-weight: 600;
                               -fx-padding: 8px 18px; -fx-cursor: hand;"/>
            </HBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox spacing="20" style="-fx-padding: 25px 30px;">

                    <!-- Section Infos de base -->
                    <VBox spacing="15"
                          style="-fx-background-color: white; -fx-background-radius: 16px;
                                 -fx-padding: 25px;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 15, 0, 0, 3);">
                        <Label text="📋 Informations de Base"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1A1A2E;"/>
                        <Separator/>
                        <GridPane hgap="20" vgap="15">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50"/>
                                <ColumnConstraints percentWidth="50"/>
                            </columnConstraints>
                            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Nom de la Salle *" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                                <TextField fx:id="txtNom" promptText="Ex: Salle de consultation A"
                                           style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px;
                                                  -fx-padding: 12px; -fx-border-color: #D8E9E4;
                                                  -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                            </VBox>
                            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Type de Salle *" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                                <TextField fx:id="txtType" promptText="Ex: Consultation, Thérapie..."
                                           style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px;
                                                  -fx-padding: 12px; -fx-border-color: #D8E9E4;
                                                  -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                            </VBox>
                            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="Capacité *" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                                <TextField fx:id="txtCapacite" promptText="Ex: 10"
                                           style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px;
                                                  -fx-padding: 12px; -fx-border-color: #D8E9E4;
                                                  -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                            </VBox>
                            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="Étage" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                                <TextField fx:id="txtEtage" promptText="Ex: RDC, 1er étage..."
                                           style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px;
                                                  -fx-padding: 12px; -fx-border-color: #D8E9E4;
                                                  -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                            </VBox>
                            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2"
                                  GridPane.columnSpan="2">
                                <Label text="Équipements" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                                <TextArea fx:id="txtEquipements"
                                          promptText="Ex: Climatiseur, projecteur, tableau blanc..."
                                          prefRowCount="3" wrapText="true"
                                          style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px;
                                                 -fx-padding: 12px; -fx-border-color: #D8E9E4;
                                                 -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                            </VBox>
                        </GridPane>
                    </VBox>

                    <!-- Section Paramètres -->
                    <VBox spacing="15"
                          style="-fx-background-color: white; -fx-background-radius: 16px;
                                 -fx-padding: 25px;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 15, 0, 0, 3);">
                        <Label text="⚙️ Paramètres"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1A1A2E;"/>
                        <Separator/>
                        <GridPane hgap="20" vgap="15">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50"/>
                                <ColumnConstraints percentWidth="50"/>
                            </columnConstraints>
                            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Disponibilité *" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                                <ComboBox fx:id="comboDisponibilite" maxWidth="Infinity"
                                          style="-fx-background-color: #F8FAFC; -fx-border-color: #D8E9E4;
                                                 -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                            </VBox>
                            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Statut *" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                                <ComboBox fx:id="comboStatut" maxWidth="Infinity"
                                          style="-fx-background-color: #F8FAFC; -fx-border-color: #D8E9E4;
                                                 -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                            </VBox>
                            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="Local Associé *" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                                <ComboBox fx:id="comboLocal" maxWidth="Infinity"
                                          style="-fx-background-color: #F8FAFC; -fx-border-color: #D8E9E4;
                                                 -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                            </VBox>
                            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="Image" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <TextField fx:id="txtImage_url" promptText="Sélectionner une image..."
                                               HBox.hgrow="ALWAYS"
                                               style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px;
                                                      -fx-padding: 12px; -fx-border-color: #D8E9E4;
                                                      -fx-border-radius: 10px; -fx-border-width: 1.5px;"/>
                                    <Button fx:id="btnParcourir" text="📂" onAction="#handleParcourir"
                                            style="-fx-background-color: transparent; -fx-border-color: #2D6A4F;
                                                   -fx-border-width: 2px; -fx-border-radius: 10px;
                                                   -fx-text-fill: #1B4332; -fx-font-weight: 700;
                                                   -fx-background-radius: 10px; -fx-padding: 10px 14px;
                                                   -fx-cursor: hand;"/>
                                </HBox>
                            </VBox>
                        </GridPane>
                    </VBox>

                    <Label fx:id="lblMessage" text="" wrapText="true"
                           style="-fx-font-size: 13px; -fx-padding: 10px 18px; -fx-background-radius: 10px;"/>
                </VBox>
            </ScrollPane>

            <HBox spacing="15" alignment="CENTER"
                  style="-fx-background-color: white; -fx-padding: 20px 30px;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, -2);">
                <Button text="✖ Annuler" onAction="#handleRetourListe" prefWidth="160"
                        style="-fx-background-color: transparent; -fx-border-color: #5A6475;
                               -fx-border-width: 2px; -fx-border-radius: 10px;
                               -fx-text-fill: #5A6475; -fx-font-size: 14px; -fx-font-weight: bold;
                               -fx-background-radius: 10px; -fx-padding: 14px 28px; -fx-cursor: hand;"/>
                <Button fx:id="btnSauvegarder" text="✓ Enregistrer" onAction="#handleSauvegarder"
                        prefWidth="220"
                        style="-fx-background-color: linear-gradient(to right, #1B4332, #2D6A4F);
                               -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;
                               -fx-background-radius: 10px; -fx-padding: 14px 28px; -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(27,67,50,0.3), 12, 0, 0, 3);"/>
            </HBox>
        </VBox>

        <!-- ═══════════════════════════════════════════════════════
             VUE DÉTAILS
             ═══════════════════════════════════════════════════════ -->
        <VBox fx:id="vueDetails" spacing="0"
              visible="false" managed="false"
              style="-fx-background-color: #F0F4F8;">

            <!-- Header détails -->
            <HBox spacing="15" alignment="CENTER_LEFT"
                  style="-fx-padding: 18px 30px; -fx-background-color: white;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 2);">
                <Button text="← Retour" onAction="#handleRetourDepuisDetails"
                        style="-fx-background-color: transparent; -fx-border-color: #D8E9E4;
                               -fx-border-width: 1.5px; -fx-border-radius: 10px;
                               -fx-background-radius: 10px; -fx-text-fill: #5A6475;
                               -fx-font-size: 12px; -fx-font-weight: 600;
                               -fx-padding: 8px 18px; -fx-cursor: hand;"/>
                <VBox spacing="3">
                    <Label text="🔎 Détails de la Salle"
                           style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #1A1A2E;"/>
                    <Label text="Informations complètes"
                           style="-fx-font-size: 11px; -fx-text-fill: #5A6475;"/>
                </VBox>
            </HBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox spacing="20" style="-fx-padding: 25px 30px;">

                    <!-- Carte principale -->
                    <HBox spacing="25" alignment="TOP_LEFT">

                        <!-- Image de la salle -->
                        <VBox spacing="10" alignment="CENTER"
                              style="-fx-background-color: white; -fx-background-radius: 16px;
                                     -fx-padding: 20px; -fx-pref-width: 340px;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
                            <StackPane style="-fx-background-color: #F0F4F8; -fx-background-radius: 12px;
                                              -fx-pref-width: 300px; -fx-pref-height: 220px;">
                                <ImageView fx:id="detailImage" fitWidth="300" fitHeight="220"
                                           preserveRatio="true"/>
                                <Label text="🏠" style="-fx-font-size: 60px; -fx-text-fill: #D8E9E4;"/>
                            </StackPane>
                            <Label fx:id="detailNom" text=""
                                   style="-fx-font-size: 16px; -fx-font-weight: 900; -fx-text-fill: #1A1A2E;
                                          -fx-wrap-text: true; -fx-text-alignment: center;"/>
                            <Label fx:id="detailDisponibilite" text=""
                                   style="-fx-font-size: 12px; -fx-font-weight: 700;
                                          -fx-background-radius: 20px; -fx-padding: 4px 16px;"/>
                        </VBox>

                        <!-- Infos détaillées -->
                        <VBox spacing="15" HBox.hgrow="ALWAYS">

                            <!-- Infos principales -->
                            <VBox spacing="12"
                                  style="-fx-background-color: white; -fx-background-radius: 16px;
                                         -fx-padding: 22px;
                                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 15, 0, 0, 3);">
                                <Label text="📋 Informations Générales"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1A1A2E;"/>
                                <Separator/>
                                <GridPane hgap="15" vgap="12">
                                    <columnConstraints>
                                        <ColumnConstraints prefWidth="130"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                    </columnConstraints>

                                    <Label text="Type :" GridPane.rowIndex="0"
                                           style="-fx-text-fill: #5A6475; -fx-font-weight: 600; -fx-font-size: 12px;"/>
                                    <Label fx:id="detailType" text="" GridPane.columnIndex="1" GridPane.rowIndex="0"
                                           style="-fx-text-fill: #1A1A2E; -fx-font-weight: 700; -fx-font-size: 12px;"/>

                                    <Label text="Capacité :" GridPane.rowIndex="1"
                                           style="-fx-text-fill: #5A6475; -fx-font-weight: 600; -fx-font-size: 12px;"/>
                                    <Label fx:id="detailCapacite" text="" GridPane.columnIndex="1" GridPane.rowIndex="1"
                                           style="-fx-text-fill: #1A1A2E; -fx-font-weight: 700; -fx-font-size: 12px;"/>

                                    <Label text="Étage :" GridPane.rowIndex="2"
                                           style="-fx-text-fill: #5A6475; -fx-font-weight: 600; -fx-font-size: 12px;"/>
                                    <Label fx:id="detailEtage" text="" GridPane.columnIndex="1" GridPane.rowIndex="2"
                                           style="-fx-text-fill: #1A1A2E; -fx-font-weight: 700; -fx-font-size: 12px;"/>

                                    <Label text="Statut :" GridPane.rowIndex="3"
