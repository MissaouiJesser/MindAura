<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@style22.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.AfficherTestController">

    <!-- Main Content Area -->
    <center>
        <BorderPane>



            <!-- Content -->
            <center>
                <VBox spacing="20" style="-fx-padding: 25; -fx-background-color: #F0F4F8;">

                    <!-- Barre d'outils -->
                    <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);">
                        <Button onAction="#ajouterTest" styleClass="btn-success" text="+ Nouveau Test" />
                        <Button onAction="#gererQuestions" styleClass="btn-primary" text="📝 Questions" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#actualiser" styleClass="btn-neutral" text="🔄 Actualiser" />
                    </HBox>

                    <!-- Barre de recherche et filtres -->
                    <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);">

                        <Label style="-fx-font-weight: bold; -fx-font-size: 14;" text="🔍 Rechercher:" />
                        <TextField fx:id="txtRecherche" prefWidth="350" promptText="Rechercher par titre ou description..." styleClass="text-field-search" />

                        <Separator orientation="VERTICAL" prefHeight="30" />

                        <Label text="📋 Filtrer par type:" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                        <ComboBox fx:id="cmbRechercheType" prefWidth="200" onAction="#rechercherParType">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Tous"/>
                                    <String fx:value="Anxiété"/>
                                    <String fx:value="Dépression"/>
                                    <String fx:value="Stress"/>
                                    <String fx:value="Personnalité"/>
                                    <String fx:value="Intelligence émotionnelle"/>
                                    <String fx:value="Confiance en soi"/>
                                    <String fx:value="Autre"/>
                                </FXCollections>
                            </items>
                        </ComboBox>

                        <Separator orientation="VERTICAL" prefHeight="30"/>

                        <Label text="📊 Statut:" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                        <ComboBox fx:id="cmbRechercheStatut" prefWidth="130" onAction="#rechercherParType">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Tous"/>
                                    <String fx:value="Actif"/>
                                    <String fx:value="Inactif"/>
                                </FXCollections>
                            </items>
                        </ComboBox>

                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblNbResultats" style="-fx-font-size: 13; -fx-text-fill: #5A6475; -fx-font-weight: bold;" text="0 test(s) trouvé(s)" />
                    </HBox>

                    <!-- TableView -->
                    <TableView fx:id="tableViewTests" style="-fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colTitre"             prefWidth="200" text="Titre" />
                            <TableColumn fx:id="colType"              prefWidth="130" text="Type" />
                            <TableColumn fx:id="colDescription"       prefWidth="250" text="Description" />
                            <TableColumn fx:id="colDuree"             prefWidth="90"  text="Durée (min)" />
                            <TableColumn fx:id="colDateCreation"      prefWidth="130" text="Date de Création" />
                            <TableColumn fx:id="colDateModification"  prefWidth="130" text="Dernière Modification" />
                            <TableColumn fx:id="colStatut"            prefWidth="90"  text="Statut" />
                            <!-- ✅ Nouvelle colonne Actions -->
                            <TableColumn fx:id="colActions"           prefWidth="160" text="Actions" />
                        </columns>

                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>

                    <!-- Pagination -->
                    <HBox fx:id="paginationContainer" alignment="CENTER" style="-fx-padding: 8 0 0 0;"/>

                </VBox>
            </center>
        </BorderPane>
    </center>

</BorderPane>
