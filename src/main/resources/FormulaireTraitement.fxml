<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.FormulaireTraitementController"
      spacing="16"
      style="-fx-background-color: #FFFFFF; -fx-padding: 24 28 20 28; -fx-pref-width: 540;">

    <!-- Titre -->
    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label text="💊" style="-fx-font-size:20px;"/>
        <Label fx:id="formTitle" text="Nouveau traitement"
               style="-fx-text-fill:#1A2E3D; -fx-font-size:16px; -fx-font-weight:bold;"/>
    </HBox>

    <Separator/>

    <!-- Rangée 1 : Type + Objectif -->
    <HBox spacing="14">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Type de traitement *" styleClass="form-label"/>
            <ComboBox fx:id="fieldType" styleClass="form-combo" promptText="Sélectionner..."/>
            <Label fx:id="errType" text="" styleClass="error-label"/>
        </VBox>
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Objectif *" styleClass="form-label"/>
            <ComboBox fx:id="fieldObjectif" styleClass="form-combo" promptText="Sélectionner..."/>
            <Label fx:id="errObjectif" text="" styleClass="error-label"/>
        </VBox>
    </HBox>

    <!-- Rangée 2 : État -->
    <VBox spacing="5">
        <Label text="État *" styleClass="form-label"/>
        <ComboBox fx:id="fieldEtat" styleClass="form-combo" promptText="Sélectionner l'état..."/>
        <Label fx:id="errEtat" text="" styleClass="error-label"/>
    </VBox>

    <!-- Rangée 3 : Date début + Date fin -->
    <HBox spacing="14">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Date de début *" styleClass="form-label"/>
            <DatePicker fx:id="fieldDateDebut" promptText="jj/mm/aaaa"
                        styleClass="date-picker"/>
            <Label fx:id="errDateDebut" text="" styleClass="error-label"/>
        </VBox>
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Date de fin" styleClass="form-label"/>
            <DatePicker fx:id="fieldDateFin" promptText="jj/mm/aaaa (optionnel)"
                        styleClass="date-picker"/>
        </VBox>
    </HBox>

    <!-- Rangée 4 : Utilisateur (par email/nom) + Coach (par email/nom) -->
    <HBox spacing="14">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Patient (email)" styleClass="form-label"/>
            <ComboBox fx:id="fieldUtilisateur" styleClass="form-combo"
                      promptText="Sélectionner le patient..."/>
        </VBox>
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Coach (email)" styleClass="form-label"/>
            <ComboBox fx:id="fieldCoach" styleClass="form-combo"
                      promptText="Sélectionner le coach..."/>
        </VBox>
    </HBox>

    <!-- Description -->
    <VBox spacing="5">
        <Label text="Description" styleClass="form-label"/>
        <TextArea fx:id="fieldDescription"
                  promptText="Décrivez le programme thérapeutique..."
                  styleClass="form-textarea"
                  prefHeight="90"
                  wrapText="true"/>
    </VBox>

    <!-- Erreur globale -->
    <Label fx:id="errGlobal" text="" styleClass="error-label"
           style="-fx-font-weight:bold;"/>

</VBox>
