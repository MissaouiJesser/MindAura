<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.DetailsLocalController"
            prefHeight="750" prefWidth="800"
            style="-fx-background-color: #F9FAFB;"
            stylesheets="@style.css">

    <top>
        <VBox spacing="15" styleClass="header-gradient">
            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 35px 40px;">
                <VBox alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.15); -fx-padding: 12px; -fx-background-radius: 12px;">
                    <Label text="📄" style="-fx-font-size: 36px;"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Détails du Local Psychiatrique" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold; -fx-font-family: 'Poppins';"/>
                    <Label text="Informations complètes et détaillées" style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 13px;"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="20" style="-fx-padding: 30px;">
                <VBox spacing="12" alignment="CENTER" styleClass="card">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="🖼️" style="-fx-font-size: 20px;"/>
                        <Label text="Image du Local" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    </HBox>
                    <Separator/>
                    <VBox alignment="CENTER" style="-fx-background-color: #F9FAFB; -fx-padding: 15px; -fx-background-radius: 12px; -fx-border-color: #E5E7EB; -fx-border-width: 2px; -fx-border-radius: 12px;">
                        <ImageView fx:id="imgLocal" fitHeight="280" fitWidth="500" preserveRatio="true"/>
                    </VBox>
                </VBox>

                <VBox spacing="18" styleClass="card">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="🏥" style="-fx-font-size: 22px;"/>
                        <Label text="Informations Principales" styleClass="section-title"/>
                    </HBox>
                    <Separator/>
                    <GridPane hgap="20" vgap="16" style="-fx-padding: 10px 0 0 0;">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="35"/>
                            <ColumnConstraints percentWidth="65"/>
                        </columnConstraints>
                        <HBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="🔢" style="-fx-font-size: 16px;"/>
                            <Label text="ID:" styleClass="field-label"/>
                        </HBox>
                        <Label fx:id="lblId" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-text-fill: #2563EB; -fx-font-weight: bold;"/>

                        <HBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="🏢" style="-fx-font-size: 16px;"/>
                            <Label text="Nom:" styleClass="field-label"/>
                        </HBox>
                        <Label fx:id="lblNom" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>

                        <HBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="2">
                            <Label text="📋" style="-fx-font-size: 16px;"/>
                            <Label text="Type:" styleClass="field-label"/>
                        </HBox>
                        <Label fx:id="lblType" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="badge" style="-fx-background-color: #DBEAFE; -fx-text-fill: #1E40AF;"/>

                        <HBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="3">
                            <Label text="📍" style="-fx-font-size: 16px;"/>
                            <Label text="Ville:" styleClass="field-label"/>
                        </HBox>
                        <Label fx:id="lblVille" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                        <HBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="4">
                            <Label text="🗺️" style="-fx-font-size: 16px;"/>
                            <Label text="Adresse:" styleClass="field-label"/>
                        </HBox>
                        <Label fx:id="lblAdresse" GridPane.columnIndex="1" GridPane.rowIndex="4" wrapText="true"/>

                        <HBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="5">
                            <Label text="👥" style="-fx-font-size: 16px;"/>
                            <Label text="Capacité:" styleClass="field-label"/>
                        </HBox>
                        <Label fx:id="lblCapacite" GridPane.columnIndex="1" GridPane.rowIndex="5" style="-fx-font-weight: bold;"/>

                        <HBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="6">
                            <Label text="⏰" style="-fx-font-size: 16px;"/>
                            <Label text="Disponibilité:" styleClass="field-label"/>
                        </HBox>
                        <Label fx:id="lblDisponibilite" GridPane.columnIndex="1" GridPane.rowIndex="6" styleClass="badge"/>
                    </GridPane>
                </VBox>

                <VBox spacing="18" styleClass="card">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📞" style="-fx-font-size: 22px;"/>
                        <Label text="Informations de Contact" styleClass="section-title"/>
                    </HBox>
                    <Separator/>
                    <GridPane hgap="20" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="35"/>
                            <ColumnConstraints percentWidth="65"/>
                        </columnConstraints>
                        <HBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="☎️" style="-fx-font-size: 16px;"/>
                            <Label text="Téléphone:" styleClass="field-label"/>
                        </HBox>
                        <Label fx:id="lblTelephone" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-text-fill: #2563EB; -fx-font-weight: bold;"/>

                        <HBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="✉️" style="-fx-font-size: 16px;"/>
                            <Label text="Email:" styleClass="field-label"/>
                        </HBox>
                        <Label fx:id="lblEmail" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-text-fill: #2563EB;"/>
                    </GridPane>
                </VBox>

                <VBox spacing="18" styleClass="card">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📝" style="-fx-font-size: 22px;"/>
                        <Label text="Description" styleClass="section-title"/>
                    </HBox>
                    <Separator/>
                    <VBox style="-fx-background-color: #F9FAFB; -fx-padding: 20px; -fx-background-radius: 10px;">
                        <Label fx:id="lblDescription" wrapText="true" style="-fx-text-fill: #374151;"/>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" styleClass="footer-bar">
            <Button fx:id="btnFermer" text="✖ Fermer" onAction="#handleFermer" prefWidth="180" styleClass="btn-annuler"/>
        </HBox>
    </bottom>
</BorderPane>
