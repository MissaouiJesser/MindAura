<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.ChatbotController"
            prefWidth="900" prefHeight="700"
            style="-fx-background-color: #F0F4F8;">

    <!--
        Le header avec logo + titre a été supprimé car UserHome fournit la navbar principale.
        Le bouton Fermer (= Retour) et le bouton Nouvelle conversation sont conservés
        dans la barre secondaire ci-dessous, affichée sous la navbar de UserHome.
    -->

    <!-- ======= BARRE DE NAVIGATION SECONDAIRE ======= -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15"
              style="-fx-background-color: linear-gradient(to right, #1B4332 0%, #0F2920 100%);
                     -fx-padding: 14px 30px;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 15, 0, 0, 3);">

            <!-- Titre + statut -->
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="MindAura — Assistant Psychologique"
                       style="-fx-font-size: 16px; -fx-font-weight: 900; -fx-text-fill: white; -fx-font-family: 'Poppins';"/>
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Circle fx:id="statusDot" radius="5" style="-fx-fill: #52B788;"/>
                    <Label fx:id="statusLabel" text="En ligne · Soutien de premier niveau"
                           style="-fx-font-size: 11px; -fx-text-fill: #D8F3DC; -fx-font-weight: 500;"/>
                </HBox>
            </VBox>

            <!-- Bouton Nouvelle conversation -->
            <Button text="🔄 Nouvelle conversation" onAction="#handleNouvelleConversation"
                    style="-fx-background-color: rgba(255,255,255,0.12);
                           -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: 600;
                           -fx-background-radius: 10px; -fx-padding: 9px 16px; -fx-cursor: hand;
                           -fx-border-color: rgba(255,255,255,0.3); -fx-border-width: 1px; -fx-border-radius: 10px;"/>

            <!-- Bouton Fermer / Retour -->
            <Button text="✕ Fermer" onAction="#handleFermer"
                    style="-fx-background-color: rgba(240,100,100,0.2);
                           -fx-text-fill: #FFB3B3; -fx-font-size: 11px; -fx-font-weight: 600;
                           -fx-background-radius: 10px; -fx-padding: 9px 16px; -fx-cursor: hand;
                           -fx-border-color: rgba(240,100,100,0.4); -fx-border-width: 1px; -fx-border-radius: 10px;"/>
        </HBox>
    </top>

    <!-- ======= ZONE CENTRALE : messages + sidebar ======= -->
    <center>
        <HBox spacing="0">

            <VBox HBox.hgrow="ALWAYS" spacing="0"
                  style="-fx-background-color: #F0F4F8;">

                <!-- Bandeau d'information -->
                <HBox alignment="CENTER" spacing="10"
                      style="-fx-background-color: #FFF8E7;
                             -fx-padding: 10px 20px;
                             -fx-border-color: #FFD166; -fx-border-width: 0 0 1 0;">
                    <Label text="⚠️" style="-fx-font-size: 14px;"/>
                    <Label text="Cet assistant fournit un soutien de premier niveau uniquement. En cas de crise, contactez immédiatement le 71 391 111 (urgences psychiatriques)."
                           style="-fx-font-size: 11px; -fx-text-fill: #7B5800; -fx-font-weight: 500;
                                  -fx-wrap-text: true;"
                           wrapText="true"/>
                </HBox>

                <!-- Zone de messages (scrollable) -->
                <ScrollPane fx:id="scrollPane" fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background-color: #F0F4F8; -fx-background: #F0F4F8;
                                   -fx-border-color: transparent;">
                    <VBox fx:id="messagesContainer" spacing="16"
                          style="-fx-background-color: #F0F4F8; -fx-padding: 25px 30px;">
                        <!-- Les messages sont injectés dynamiquement -->
                    </VBox>
                </ScrollPane>

                <!-- Indicateur de frappe -->
                <HBox fx:id="typingIndicator" alignment="CENTER_LEFT" spacing="10"
                      managed="false" visible="false"
                      style="-fx-padding: 8px 30px;">
                    <StackPane style="-fx-background-color: #2D6A4F; -fx-background-radius: 50px;
                                      -fx-pref-width: 32px; -fx-pref-height: 32px;">
                        <ImageView fitWidth="22" fitHeight="22" preserveRatio="true">
                            <image>
                                <Image url="@/images/mindaura_logo.png"/>
                            </image>
                        </ImageView>
                    </StackPane>
                    <HBox spacing="4" alignment="CENTER"
                          style="-fx-background-color: white; -fx-background-radius: 12px;
                                 -fx-padding: 10px 16px;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 8, 0, 0, 2);">
                        <Label text="●" style="-fx-text-fill: #2D6A4F; -fx-font-size: 10px;"/>
                        <Label text="●" style="-fx-text-fill: #52B788; -fx-font-size: 10px;"/>
                        <Label text="●" style="-fx-text-fill: #B7E4C7; -fx-font-size: 10px;"/>
                        <Label text="L'assistant rédige une réponse..."
                               style="-fx-font-size: 11px; -fx-text-fill: #5A6475; -fx-font-style: italic;"/>
                    </HBox>
                </HBox>

                <VBox spacing="0"
                      style="-fx-background-color: white;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, -2);
                             -fx-border-color: #E8F0EC; -fx-border-width: 1 0 0 0;">

                    <!-- Suggestions rapides -->
                    <HBox fx:id="suggestionsBox" spacing="8" alignment="CENTER_LEFT"
                          style="-fx-padding: 12px 20px 8px 20px;">
                        <Label text="Suggestions :" style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF; -fx-font-weight: 600;"/>
                        <Button text="😰 Je me sens anxieux" onAction="#handleSuggestion"
                                style="-fx-background-color: #F0FFF4; -fx-text-fill: #1B4332; -fx-font-size: 10px;
                                       -fx-background-radius: 20px; -fx-padding: 5px 12px; -fx-cursor: hand;
                                       -fx-border-color: #D8F3DC; -fx-border-width: 1px; -fx-border-radius: 20px;"/>
                        <Button text="😔 Je me sens déprimé" onAction="#handleSuggestion"
                                style="-fx-background-color: #F0FFF4; -fx-text-fill: #1B4332; -fx-font-size: 10px;
                                       -fx-background-radius: 20px; -fx-padding: 5px 12px; -fx-cursor: hand;
                                       -fx-border-color: #D8F3DC; -fx-border-width: 1px; -fx-border-radius: 20px;"/>
                        <Button text="😴 Je dors mal" onAction="#handleSuggestion"
                                style="-fx-background-color: #F0FFF4; -fx-text-fill: #1B4332; -fx-font-size: 10px;
                                       -fx-background-radius: 20px; -fx-padding: 5px 12px; -fx-cursor: hand;
                                       -fx-border-color: #D8F3DC; -fx-border-width: 1px; -fx-border-radius: 20px;"/>
                        <Button text="😤 Je suis stressé" onAction="#handleSuggestion"
                                style="-fx-background-color: #F0FFF4; -fx-text-fill: #1B4332; -fx-font-size: 10px;
                                       -fx-background-radius: 20px; -fx-padding: 5px 12px; -fx-cursor: hand;
                                       -fx-border-color: #D8F3DC; -fx-border-width: 1px; -fx-border-radius: 20px;"/>
                    </HBox>

                    <!-- Champ de saisie -->
                    <HBox spacing="12" alignment="CENTER"
                          style="-fx-padding: 8px 20px 16px 20px;">
                        <TextArea fx:id="inputField"
                                  promptText="Partagez ce que vous ressentez… je suis là pour vous écouter."
                                  HBox.hgrow="ALWAYS"
                                  prefRowCount="2"
                                  wrapText="true"
                                  style="-fx-background-color: #F8FAFC;
                                         -fx-background-radius: 14px;
                                         -fx-border-color: #D8E9E4; -fx-border-width: 1.5px; -fx-border-radius: 14px;
                                         -fx-font-size: 13px; -fx-text-fill: #1A1A2E;
                                         -fx-prompt-text-fill: #9CA3AF;
                                         -fx-padding: 12px 16px;"/>
                        <VBox spacing="8" alignment="CENTER">
                            <Button fx:id="btnEnvoyer" text="Envoyer ›" onAction="#handleEnvoyer"
                                    defaultButton="true"
                                    style="-fx-background-color: linear-gradient(to bottom, #2D6A4F, #1B4332);
                                           -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 700;
                                           -fx-background-radius: 12px; -fx-padding: 12px 22px; -fx-cursor: hand;
                                           -fx-effect: dropshadow(gaussian, rgba(27,67,50,0.35), 10, 0, 0, 3);
                                           -fx-pref-width: 120px;"/>
                            <Label text="Entrée pour envoyer"
                                   style="-fx-font-size: 9px; -fx-text-fill: #9CA3AF; -fx-alignment: CENTER;"/>
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Sidebar ressources -->
            <VBox prefWidth="230" spacing="0"
                  style="-fx-background-color: white;
                         -fx-border-color: #E8F0EC; -fx-border-width: 0 0 0 1;">

                <Label text="📚 Ressources"
                       style="-fx-font-size: 13px; -fx-font-weight: 800; -fx-text-fill: #1B4332;
                              -fx-padding: 18px 18px 10px 18px; -fx-font-family: 'Inter';"/>

                <Separator style="-fx-background-color: #E8F0EC;"/>

                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                    <VBox spacing="10" style="-fx-padding: 14px 14px;">

                        <!-- Urgence -->
                        <VBox spacing="6"
                              style="-fx-background-color: #FFF5F5; -fx-background-radius: 12px;
                                     -fx-padding: 14px; -fx-border-color: #FFB3B3;
                                     -fx-border-width: 1px; -fx-border-radius: 12px;">
                            <Label text="🚨 Urgence psychologique"
                                   style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #C0392B;"/>
                            <Label text="Ligne urgences psychiatriques :"
                                   style="-fx-font-size: 10px; -fx-text-fill: #5A6475;" wrapText="true"/>
                            <Label text="📞 71 391 111"
                                   style="-fx-font-size: 14px; -fx-font-weight: 900; -fx-text-fill: #C0392B;"/>
                            <Label text="Disponible 24h/24 — 7j/7"
                                   style="-fx-font-size: 9px; -fx-text-fill: #9CA3AF;"/>
                        </VBox>

                        <!-- Techniques -->
                        <VBox spacing="8"
                              style="-fx-background-color: #F0FFF4; -fx-background-radius: 12px;
                                     -fx-padding: 14px; -fx-border-color: #D8F3DC;
                                     -fx-border-width: 1px; -fx-border-radius: 12px;">
                            <Label text="💡 Techniques immédiates"
                                   style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #1B4332;"/>
                            <VBox spacing="5">
                                <Label text="🌬️ Respiration 4-7-8"
                                       style="-fx-font-size: 10px; -fx-text-fill: #2D6A4F; -fx-font-weight: 600;"/>
                                <Label text="Inspirez 4s, retenez 7s, expirez 8s"
                                       style="-fx-font-size: 9px; -fx-text-fill: #5A6475;" wrapText="true"/>
                            </VBox>
                            <VBox spacing="5">
                                <Label text="🖐️ Règle du 5-4-3-2-1"
                                       style="-fx-font-size: 10px; -fx-text-fill: #2D6A4F; -fx-font-weight: 600;"/>
                                <Label text="Nommez 5 choses vues, 4 touchées, 3 entendues…"
                                       style="-fx-font-size: 9px; -fx-text-fill: #5A6475;" wrapText="true"/>
                            </VBox>
                        </VBox>

                        <!-- Sujets fréquents -->
                        <VBox spacing="8"
                              style="-fx-background-color: #F8F4FF; -fx-background-radius: 12px;
                                     -fx-padding: 14px; -fx-border-color: #D8C8FF;
                                     -fx-border-width: 1px; -fx-border-radius: 12px;">
                            <Label text="💬 Sujets fréquents"
                                   style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #5A3A7B;"/>
                            <Label text="• Anxiété et attaques de panique&#10;• Dépression et tristesse&#10;• Troubles du sommeil&#10;• Stress et burn-out&#10;• Relations et solitude&#10;• Gestion des émotions"
                                   style="-fx-font-size: 10px; -fx-text-fill: #5A6475;" wrapText="true"/>
                        </VBox>

                        <!-- Disclaimer -->
                        <VBox spacing="6"
                              style="-fx-background-color: #F8FAFC; -fx-background-radius: 12px;
                                     -fx-padding: 12px; -fx-border-color: #E2E8F0;
                                     -fx-border-width: 1px; -fx-border-radius: 12px;">
                            <Label text="ℹ️ À savoir"
                                   style="-fx-font-size: 10px; -fx-font-weight: 700; -fx-text-fill: #5A6475;"/>
                            <Label text="Cet assistant IA ne remplace pas un professionnel de santé. Il est conçu pour offrir un soutien préliminaire et vous orienter."
                                   style="-fx-font-size: 9px; -fx-text-fill: #9CA3AF;" wrapText="true"/>
                        </VBox>

                    </VBox>
                </ScrollPane>
            </VBox>

        </HBox>
    </center>

</BorderPane>
